  function renderVisualCronGrids() {
    // Minute Grid
    const minGrid = document.getElementById('cron-minute-grid');
    if (minGrid) {
      let mHtml = '';
      for (let m = 0; m < 60; m++) {
        const isSel = visualMinutes.has(m);
        const pad = m < 10 ? '0' + m : String(m);
        mHtml += `<button type="button" data-cron-m="${m}" class="cron-chip py-1 px-0.5 rounded text-[11px] font-mono font-medium transition-all ${isSel ? 'bg-primary text-primary-foreground font-bold shadow-xs' : 'bg-muted/60 text-muted-foreground hover:bg-muted hover:text-foreground'}">${pad}</button>`;
      }
      minGrid.innerHTML = mHtml;
    }

    // Hour Grid
    const hrGrid = document.getElementById('cron-hour-grid');
    if (hrGrid) {
      let hHtml = '';
      for (let h = 0; h < 24; h++) {
        const isSel = visualHours.has(h);
        const pad = h < 10 ? '0' + h : String(h);
        hHtml += `<button type="button" data-cron-h="${h}" class="cron-chip py-1 px-1 rounded text-[11px] font-mono font-medium transition-all ${isSel ? 'bg-primary text-primary-foreground font-bold shadow-xs' : 'bg-muted/60 text-muted-foreground hover:bg-muted hover:text-foreground'}">${pad}</button>`;
      }
      hrGrid.innerHTML = hHtml;
    }

    // Weekday Grid
    const dowGrid = document.getElementById('cron-dow-grid');
    if (dowGrid) {
      const days = [
        { num: 1, label: 'Mon' }, { num: 2, label: 'Tue' }, { num: 3, label: 'Wed' },
        { num: 4, label: 'Thu' }, { num: 5, label: 'Fri' }, { num: 6, label: 'Sat' }, { num: 0, label: 'Sun' }
      ];
      let dHtml = '';
      for (const d of days) {
        const isSel = visualWeekdays.has(d.num);
        dHtml += `<button type="button" data-cron-dow="${d.num}" class="cron-chip py-1.5 px-2 rounded-lg text-xs font-semibold transition-all ${isSel ? 'bg-primary text-primary-foreground font-bold shadow-xs' : 'bg-muted/60 text-muted-foreground hover:bg-muted hover:text-foreground'}">${d.label}</button>`;
      }
      dowGrid.innerHTML = dHtml;
    }
