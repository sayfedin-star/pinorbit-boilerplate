<script>
  import { requireAuth } from '../../lib/auth';
  import {
    getAccountDetails,
    getAccountPinStats,
    getAccountPins,
    getAccountBoards,
    getAccountRecentLogs,
    getAccountWebhookSummary,
    getAccountWebhooks,
    createAccountWebhook,
    updateAccountWebhook,
    toggleAccountWebhookActive,
    deleteAccountWebhook,
    setPrimaryWebhook,
    updateAccountSchedule,
    updateAccountScheduling,
    updateAccountDailyLimit,
    toggleAccountActive,
    rescheduleAccountPendingPins,
  } from '../../lib/supabase';
  import { renderStatusBadge, formatDate, formatTime, renderEmptyStateHTML, escapeHtml } from '../../lib/ui-helpers';
  import type { Account, AccountPinStats, Pin, Log, AccountWebhook, Board } from '../../lib/types';

  let currentAccount: Account | null = null;
  let currentStats: AccountPinStats | null = null;
  let accountId: string = '';
  let activeAccountWebhooks: AccountWebhook[] = [];
  let accountBoards: Board[] = [];

  // ── Shared Helpers ──────────────────────────────────────────────────────────

  /** Parse Postgres TEXT[] or JS string[] into a clean JS string array */
  function parseActiveDays(raw: string | string[] | null | undefined): string[] {
    const all = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    if (!raw) return all;
    if (Array.isArray(raw)) return raw;
    return (raw as string).replace(/[{}"']/g, '').split(',').map((d) => d.trim()).filter(Boolean);
  }

  /** Compute posting window duration in minutes (handles overnight wrap-around) */
  function calcWindowMins(start: string, end: string): number {
    const [sH, sM] = (start || '09:00').slice(0, 5).split(':').map(Number);
    const [eH, eM] = (end   || '21:00').slice(0, 5).split(':').map(Number);
    let mins = (eH * 60 + eM) - (sH * 60 + sM);
    if (mins <= 0) mins += 1440;
    return mins;
  }

  // Filter State
  let filterStatus = 'all';
  let filterBoard = 'all';
  let filterSearch = '';
  let filterDateFrom = '';
  let filterDateTo = '';
  let searchDebounceTimer: any = null;

  async function init() {
    const isAuth = await requireAuth();
    if (!isAuth) return;

    // Extract Account ID from URL query string or path
    const urlParams = new URLSearchParams(window.location.search);
    const queryId = urlParams.get('id');
    let pathId = '';
    const matches = window.location.pathname.match(/\/accounts\/([^/]+)/);
    if (matches && matches[1] && matches[1] !== 'pins' && matches[1] !== 'details') {
      pathId = matches[1];
    }

    accountId = queryId || pathId || 'acc-1';

    const displayElem = document.getElementById('display-account-id');
    if (displayElem) displayElem.textContent = accountId || '---';

    const runNowBtn = document.getElementById('account-details-run-now');
    if (runNowBtn && accountId) {
      runNowBtn.dataset.payload = JSON.stringify({ account_id: accountId });
    }

    if (!accountId) return;

    // Update "View all pins" link to dedicated route
    const viewAllLink = document.getElementById('view-all-pins-link') as HTMLAnchorElement;
    if (viewAllLink && accountId) {
      viewAllLink.href = `/accounts/pins?id=${accountId}`;
    }

    const kitLink = document.getElementById('btn-board-pipeline-kit') as HTMLAnchorElement;
    if (kitLink && accountId) {
      kitLink.href = `/accounts/board-pipeline?id=${encodeURIComponent(accountId)}`;
    }

    // Read initial filters from URL params
    filterStatus = urlParams.get('status') || 'all';
    filterBoard = urlParams.get('board') || 'all';
    filterSearch = urlParams.get('q') || '';
    filterDateFrom = urlParams.get('from') || '';
    filterDateTo = urlParams.get('to') || '';

    // Initialize UI inputs from state
    initFilterInputs();
    setupFilterListeners();
    setupModalListeners();
    setupBoardChannelListener();

    await loadAllData();
  }

  function initFilterInputs() {
    const statusSelect = document.getElementById('pin-status-select') as HTMLSelectElement;
    const searchInput = document.getElementById('pin-search-input') as HTMLInputElement;
    const dateFromInput = document.getElementById('pin-date-from') as HTMLInputElement;
    const dateToInput = document.getElementById('pin-date-to') as HTMLInputElement;

    if (statusSelect) statusSelect.value = filterStatus;
    if (searchInput) searchInput.value = filterSearch;
    if (dateFromInput) dateFromInput.value = filterDateFrom;
    if (dateToInput) dateToInput.value = filterDateTo;
  }

  function setupFilterListeners() {
    const statusSelect = document.getElementById('pin-status-select');
    const boardSelect = document.getElementById('pin-board-select');
    const searchInput = document.getElementById('pin-search-input');
    const dateFromInput = document.getElementById('pin-date-from');
    const dateToInput = document.getElementById('pin-date-to');
    const clearBtn = document.getElementById('pin-clear-filters-btn');

    statusSelect?.addEventListener('change', (e) => {
      filterStatus = (e.target as HTMLSelectElement).value;
      onFilterChange();
    });

    boardSelect?.addEventListener('change', (e) => {
      filterBoard = (e.target as HTMLSelectElement).value;
      onFilterChange();
    });

    searchInput?.addEventListener('input', (e) => {
      filterSearch = (e.target as HTMLInputElement).value;
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        onFilterChange();
      }, 300);
    });

    dateFromInput?.addEventListener('change', (e) => {
      filterDateFrom = (e.target as HTMLInputElement).value;
      onFilterChange();
    });

    dateToInput?.addEventListener('change', (e) => {
      filterDateTo = (e.target as HTMLInputElement).value;
      onFilterChange();
    });

    clearBtn?.addEventListener('click', () => {
      filterStatus = 'all';
      filterBoard = 'all';
      filterSearch = '';
      filterDateFrom = '';
      filterDateTo = '';
      initFilterInputs();
      const boardSel = document.getElementById('pin-board-select') as HTMLSelectElement;
      if (boardSel) boardSel.value = 'all';
      onFilterChange();
    });
  }

  function syncFilterStateToURL() {
    const url = new URL(window.location.href);
    if (filterStatus && filterStatus !== 'all') url.searchParams.set('status', filterStatus);
    else url.searchParams.delete('status');

    if (filterBoard && filterBoard !== 'all') url.searchParams.set('board', filterBoard);
    else url.searchParams.delete('board');

    if (filterSearch && filterSearch.trim() !== '') url.searchParams.set('q', filterSearch.trim());
    else url.searchParams.delete('q');

    if (filterDateFrom) url.searchParams.set('from', filterDateFrom);
    else url.searchParams.delete('from');

    if (filterDateTo) url.searchParams.set('to', filterDateTo);
    else url.searchParams.delete('to');

    window.history.replaceState({}, '', url.toString());

    // Toggle clear filters button visibility
    const clearBtn = document.getElementById('pin-clear-filters-btn');
    const isFiltered = filterStatus !== 'all' || filterBoard !== 'all' || filterSearch !== '' || filterDateFrom !== '' || filterDateTo !== '';
    if (clearBtn) {
      if (isFiltered) clearBtn.classList.remove('hidden');
      else clearBtn.classList.add('hidden');
    }
  }

  async function onFilterChange() {
    syncFilterStateToURL();
    await loadRecentPins();
  }

  async function loadAllData() {
    try {
      const [acc, stats, boards, logs, whSummary] = await Promise.all([
        getAccountDetails(accountId),
        getAccountPinStats(accountId),
        getAccountBoards(accountId),
        getAccountRecentLogs(accountId, 10),
        getAccountWebhookSummary(accountId),
      ]);

      const tableRows = document.getElementById('webhook-orchestration-rows');
      if (tableRows) {
        tableRows.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-muted-foreground animate-pulse">Loading webhook channels...</td></tr>';
      }

      try {
        const whs = await getAccountWebhooks(accountId);
        activeAccountWebhooks = whs || [];
        renderWebhookCards();
      } catch (whErr: any) {
        activeAccountWebhooks = [];
        if (tableRows) {
          tableRows.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-rose-500 font-semibold">Failed to load webhooks: ${escapeHtml(whErr.message || 'Unknown error')}</td></tr>`;
        }
      }

      setupSchedulesListeners();
      await loadTokens();
      await loadSchedules();

      if (!acc) {
        document.getElementById('account-header-info')!.innerHTML = renderEmptyStateHTML(
          'Account Not Found',
          `Could not locate Pinterest account matching ID "${escapeHtml(accountId)}".`,
          'alert-circle'
        );
        return;
      }

      // Fresh DB data wins; preserve local-only fields that DB may not return
      currentAccount = {
        ...(currentAccount || {}),
        ...acc,
      };
      currentStats = stats;
      accountBoards = boards;

      populateBoardDropdown(boards);
      renderHeader(currentAccount);
      renderKPIs(stats, currentAccount);
      renderScheduling(currentAccount);
      renderRecentLogs(logs);

      // Auto-reschedule pending pins to pre-computed pacing slots
      await rescheduleAccountPendingPins(accountId);

      await loadRecentPins();
    } catch (err: any) {
      console.error('Error loading account details:', err);
      showFeedbackBanner(err.message || 'Database error loading account details', 'error');
      const headerInfo = document.getElementById('account-header-info');
      if (headerInfo) {
        headerInfo.innerHTML = renderEmptyStateHTML(
          'Error Loading Account',
          `Database error: ${escapeHtml(err.message || 'Failed to query account details.')}`,
          'alert-circle'
        );
      }
    }
  }

  function populateBoardDropdown(boards: Board[]) {
    const boardSelect = document.getElementById('pin-board-select') as HTMLSelectElement;
    if (!boardSelect) return;

    boardSelect.innerHTML = `<option value="all">All Boards</option>` +
      boards.map((b) => `<option value="${escapeHtml(b.board_name)}">${escapeHtml(b.board_name)}</option>`).join('');

    if (filterBoard) {
      boardSelect.value = filterBoard;
    }
