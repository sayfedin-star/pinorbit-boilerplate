  function showFeedbackBanner(message: string, type: 'success' | 'error' = 'success') {
    const banner = document.getElementById('account-feedback-banner');
    const text = document.getElementById('account-feedback-text');
    if (!banner || !text) return;

    text.textContent = message;
    if (type === 'error') {
      banner.className = 'mb-4 rounded-xl border border-rose-500/30 bg-rose-500/10 p-3.5 text-xs text-rose-500 flex items-center justify-between shadow-sm';
    } else {
      banner.className = 'mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm';
    }
    banner.classList.remove('hidden');

    setTimeout(() => {
      banner.classList.add('hidden');
    }, 5000);
  }

  document.getElementById('close-account-feedback')?.addEventListener('click', () => {
    document.getElementById('account-feedback-banner')?.classList.add('hidden');
  });

  // Unified Single Source of Truth UI State Sync
  function refreshAccountUI(updatedPayload?: Partial<Account>) {
    if (updatedPayload && currentAccount) {
      Object.assign(currentAccount, updatedPayload);
    }

    if (currentAccount) {
      renderHeader(currentAccount);
      if (currentStats) {
        renderKPIs(currentStats, currentAccount);
      }
      renderScheduling(currentAccount);
    }
  }

  async function handleToggleActive() {
    if (!currentAccount) return;
    try {
      const newStatus = !currentAccount.is_active;
      const res = await toggleAccountActive(currentAccount.id, newStatus);
      if (res.data || res.success) {
        const updated = res.data || { ...currentAccount, is_active: newStatus };
        refreshAccountUI(updated);
        showFeedbackBanner(`Account status updated to ${newStatus ? 'Active' : 'Inactive'}.`, 'success');
        // Authoritative background sync
        loadAllData();
      } else if (res.error) {
        showFeedbackBanner(res.error, 'error');
      }
    } catch (err: any) {
      showFeedbackBanner(err.message || 'Failed to toggle account status', 'error');
    }
  }

  function openLimitModal() {
    if (!currentAccount) return;
    const modal = document.getElementById('edit-limit-modal');
    const input = document.getElementById('limit-input-num') as HTMLInputElement;
    if (input) input.value = String(currentAccount.max_pins_per_day);
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function setupModalListeners() {
    // Direct listeners — all action buttons are static HTML, always in DOM
    // btn-open-create-board-modal is wired inside initCreateBoardModal()
    document.getElementById('open-webhooks-modal-btn')?.addEventListener('click', () => openManageWebhooksModal());
    document.getElementById('btn-edit-limit')?.addEventListener('click', () => openLimitModal());
    document.getElementById('btn-toggle-active')?.addEventListener('click', () => handleToggleActive());

    // Static once-only delegated listeners
    document.getElementById('btn-test-webhook-ping')?.addEventListener('click', () =>
      showFeedbackBanner('⚡ Webhook Ping: Server Response 200 OK (Active & Healthy).', 'success')
    );

    // Delegated: copy account ID — btn-copy-acc-id is inside account-header-info which re-renders
    document.getElementById('account-header-info')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('#btn-copy-acc-id');
      if (!btn) return;
      e.preventDefault();
      const idStr = btn.getAttribute('data-id') || '';
      if (idStr) {
        navigator.clipboard.writeText(idStr);
        showFeedbackBanner(`Account ID (${idStr}) copied to clipboard.`, 'success');
      }
    });

    // Delegated: auto-pacing button — rendered dynamically inside paceDescElem
    document.getElementById('sched-pace-desc')?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('#btn-apply-optimal-pacing');
      if (!btn || !currentAccount) return;
      e.preventDefault();
      const targetMins = parseInt(btn.getAttribute('data-optimal') || '0', 10);
      if (!targetMins) return;
      const res = await updateAccountSchedule(currentAccount.id, { posting_interval_minutes: targetMins });
      refreshAccountUI({ ...(res.data || {}), posting_interval_minutes: targetMins });
      showFeedbackBanner(`Posting interval auto-adjusted to optimal ${targetMins} minutes pacing.`, 'success');
      loadAllData();
    });

    // Escape key closes any open modal
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      // create-board-modal handled by its own Escape-aware close inside initCreateBoardModal
      const modals = [
        { id: 'edit-limit-modal',      close: closeLimitModal },
        { id: 'webhooks-manage-modal', close: closeWebhooksModal },
        { id: 'create-board-modal',    close: () => {
            const m = document.getElementById('create-board-modal');
            m?.classList.add('hidden'); m?.classList.remove('flex');
          }
        },
      ];
      for (const { id, close } of modals) {
        const el = document.getElementById(id);
        if (el && !el.classList.contains('hidden')) { close(); return; }
      }
    });

    // Limit modal
    document.getElementById('close-limit-btn')?.addEventListener('click', closeLimitModal);
    document.getElementById('cancel-limit-btn')?.addEventListener('click', closeLimitModal);
    document.getElementById('edit-limit-backdrop')?.addEventListener('click', closeLimitModal);

    document.getElementById('limit-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAccount) return;
      const val = parseInt((document.getElementById('limit-input-num') as HTMLInputElement).value, 10);
      if (isNaN(val) || val < 1) return;

      const limitSaveBtn = document.querySelector('#limit-form [type="submit"]') as HTMLButtonElement | null;
      if (limitSaveBtn) { limitSaveBtn.disabled = true; limitSaveBtn.textContent = 'Saving...'; }

      const res = await updateAccountDailyLimit(currentAccount.id, val);

      if (limitSaveBtn) { limitSaveBtn.disabled = false; limitSaveBtn.textContent = 'Save Limit'; }
      if (res.data || res.success) {
        const updated = res.data || { ...currentAccount, max_pins_per_day: val };
        refreshAccountUI(updated);
        closeLimitModal();
        showFeedbackBanner(`Account daily limit updated to ${val} pins/day.`, 'success');
        // Authoritative background sync
        loadAllData();
      } else if (res.error) {
        showFeedbackBanner('Failed to update daily limit: ' + res.error, 'error');
      }
    });

    // Webhook manager modal listeners
    document.getElementById('close-webhooks-modal')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('dismiss-webhooks-modal')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('webhooks-manage-backdrop')?.addEventListener('click', closeWebhooksModal);
    document.getElementById('open-add-webhook-btn')?.addEventListener('click', () => showWebhookForm());
    document.getElementById('cancel-webhook-form')?.addEventListener('click', hideWebhookForm);

    // Phase 3: Create Board — single init owns open/close/submit lifecycle
    initCreateBoardModal();

    document.getElementById('submit-webhook-form')?.addEventListener('click', async () => {
      if (!currentAccount) return;
      hideWebhooksModalFeedback();

      const webhookId = (document.getElementById('form-webhook-id') as HTMLInputElement).value;
      const label = (document.getElementById('form-hook-label') as HTMLInputElement).value.trim();
      const url = (document.getElementById('form-hook-url') as HTMLInputElement).value.trim();
      const cap = parseInt((document.getElementById('form-hook-capacity') as HTMLInputElement).value, 10);
      const prio = parseInt((document.getElementById('form-hook-priority') as HTMLInputElement).value, 10);
      const active = (document.getElementById('form-hook-active') as HTMLInputElement).checked;
      const primary = (document.getElementById('form-hook-primary') as HTMLInputElement).checked;

      if (!label) {
        showWebhooksModalError('Label is required.');
        return;
      }
      if (!url || !url.startsWith('http')) {
        showWebhooksModalError('Valid HTTP/HTTPS Webhook URL is required.');
        return;
      }
      if (isNaN(cap) || cap < 1) {
        showWebhooksModalError('Monthly capacity must be a positive integer (minimum 1).');
        return;
      }
      if (isNaN(prio) || prio < 1) {
        showWebhooksModalError('Priority must be a positive integer (minimum 1).');
        return;
      }

      // Check duplicates for this account
      const labelDup = activeAccountWebhooks.some(
        (w) => w.id !== webhookId && w.label.toLowerCase() === label.toLowerCase()
      );
      if (labelDup) {
        showWebhooksModalError(`A webhook labeled "${label}" already exists for this account.`);
        return;
      }

      const urlDup = activeAccountWebhooks.some(
        (w) => w.id !== webhookId && w.webhook_url.toLowerCase() === url.toLowerCase()
      );
      if (urlDup) {
        showWebhooksModalError('This webhook URL is already registered for this account.');
        return;
      }

      if (webhookId) {
        // Edit existing
        const { error } = await updateAccountWebhook(webhookId, {
          label,
          webhook_url: url,
          monthly_capacity: cap,
          priority: prio,
          is_active: active,
          is_primary: primary,
        });
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess('Webhook channel updated successfully.');
          hideWebhookForm();
          await refreshWebhooksList();
          await loadAllData();
        }
      } else {
        // Create new
        const { error } = await createAccountWebhook({
          account_id: currentAccount.id,
          label,
          webhook_url: url,
          monthly_capacity: cap,
          priority: prio,
          is_active: active,
          is_primary: primary,
        });
        if (error) showWebhooksModalError(error);
        else {
          showWebhooksModalSuccess('New webhook channel added successfully.');
          hideWebhookForm();
          await refreshWebhooksList();
          await loadAllData();
        }
      }
    });

    // Board action listeners (Refresh list & Delete board)
    document.getElementById('btn-refresh-boards')?.addEventListener('click', async () => {
      if (!accountId) return;
      try {
        const r = await fetch('/api/boards/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ account_id: accountId, action: 'list' })
        });
        const d = await r.json();
        if (r.ok) {
          showFeedbackBanner('Board list refresh request sent. Boards will sync via Make callback.', 'success');
          setTimeout(() => window.location.reload(), 1500);
        } else {
          alert(d.error || 'Failed to refresh boards');
        }
      } catch (e: any) {
        alert('Failed to refresh boards: ' + e.message);
      }
    });

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      const deleteBtn = target.closest('.board-delete-btn');
      if (deleteBtn && accountId) {
        const boardId = deleteBtn.getAttribute('data-board-id');
        const boardName = deleteBtn.getAttribute('data-board-name');
        if (!boardId || !confirm(`Delete board "${boardName}"? This will remove it from Pinterest.`)) return;
        
        try {
          const r = await fetch('/api/boards/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ account_id: accountId, action: 'delete', board_id: boardId })
          });
          const d = await r.json();
          if (r.ok) {
            showFeedbackBanner(`Board "${boardName}" deletion request sent.`, 'success');
            setTimeout(() => window.location.reload(), 1500);
          } else {
            alert(d.error || 'Failed to delete board');
          }
        } catch (e: any) {
          alert('Failed to delete board: ' + e.message);
        }
      }
    });
  }

  function hideWebhookForm() {
    const formContainer = document.getElementById('webhook-form-container');
    if (formContainer) formContainer.classList.add('hidden');
  }

  function hideWebhooksModalFeedback() {
    const err = document.getElementById('webhooks-modal-error');
    const succ = document.getElementById('webhooks-modal-success');
    if (err) err.classList.add('hidden');
    if (succ) succ.classList.add('hidden');
  }

  function showWebhooksModalError(msg: string) {
    const err = document.getElementById('webhooks-modal-error');
    if (err) {
      err.textContent = msg;
      err.classList.remove('hidden');
    }
  }

  function showWebhooksModalSuccess(msg: string) {
    const succ = document.getElementById('webhooks-modal-success');
    if (succ) {
      succ.textContent = msg;
      succ.classList.remove('hidden');
    }
  }

  async function openManageWebhooksModal() {
    if (!currentAccount) return;
    const modal = document.getElementById('webhooks-manage-modal');
    const subtitle = document.getElementById('manage-webhooks-subtitle');
    if (subtitle) subtitle.textContent = `Managing Webhooks for: ${currentAccount.account_name}`;

    hideWebhookForm();
    hideWebhooksModalFeedback();

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');

    await refreshWebhooksList();
  }

  function closeWebhooksModal() {
    const modal = document.getElementById('webhooks-manage-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    hideWebhookForm();
  }

  // ── Create Board Modal ─────────────────────────────────────────────────────
  // Single function owns the full lifecycle: open → fetch webhooks → submit → close
  function initCreateBoardModal() {
    const modal       = document.getElementById('create-board-modal')!;
    const form        = document.getElementById('create-board-form') as HTMLFormElement;
    const nameInput   = document.getElementById('new-board-name-input') as HTMLInputElement;
    const hookSelect  = document.getElementById('new-board-webhook-select') as HTMLSelectElement;
    const loadingEl   = document.getElementById('create-board-webhook-loading')!;
    const errorBox    = document.getElementById('create-board-error')!;
    const errorText   = document.getElementById('create-board-error-text')!;
    const successBox  = document.getElementById('create-board-success')!;
    const successText = document.getElementById('create-board-success-text')!;
    const reusedBox   = document.getElementById('create-board-reused')!;
    const reusedText  = document.getElementById('create-board-reused-text')!;
    const submitBtn   = document.getElementById('submit-create-board-btn') as HTMLButtonElement;
    const spinner     = document.getElementById('create-board-spinner')!;
    const btnLabel    = document.getElementById('create-board-btn-label')!;

    // ── Helpers ──
    function resetFeedback() {
      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');
      reusedBox.classList.add('hidden');
    }

    function showError(msg: string) {
      resetFeedback();
      errorText.textContent = msg;
      errorBox.classList.remove('hidden');
    }

    function showSuccess(msg: string) {
      resetFeedback();
      successText.textContent = msg;
      successBox.classList.remove('hidden');
    }

    function showReused(msg: string) {
      resetFeedback();
      reusedText.textContent = msg;
      reusedBox.classList.remove('hidden');
    }

    function setSubmitting(loading: boolean) {
      submitBtn.disabled = loading;
      spinner.classList.toggle('hidden', !loading);
      btnLabel.textContent = loading ? 'Creating...' : 'Create Board';
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      // Reset form state after animation
      setTimeout(() => {
        form.reset();
        resetFeedback();
        setSubmitting(false);
      }, 150);
    }

    async function populateWebhooks() {
      if (!currentAccount) return;

      // Show skeleton, hide real select
      loadingEl.classList.remove('hidden');
      hookSelect.classList.add('hidden');

      try {
        const hooks = await getAccountWebhooks(currentAccount.id);
        const activeHooks = hooks.filter((h) => h.is_active);
        const preferredId = currentAccount.board_creation_webhook_id
          || (activeHooks.find((h) => h.is_primary) || activeHooks[0])?.id;

        if (activeHooks.length === 0) {
          hookSelect.innerHTML = '<option value="" disabled selected>No active webhooks configured</option>';
          showError('No active webhook channels found. Please add a webhook first via Manage Webhooks.');
        } else {
          hookSelect.innerHTML = activeHooks
            .map((h) =>
              `<option value="${h.id}" ${h.id === preferredId ? 'selected' : ''}>
                ${escapeHtml(h.label)} (${h.remaining_capacity} capacity)
              </option>`
            ).join('');
        }
      } catch (err) {
        hookSelect.innerHTML = '<option value="" disabled selected>Error loading webhooks</option>';
        showError('Failed to load webhook channels. Please try again.');
      } finally {
        loadingEl.classList.add('hidden');
        hookSelect.classList.remove('hidden');
      }
    }

    // ── Open ──
    async function openModal() {
      if (!currentAccount) {
        console.warn('openCreateBoardModal: no currentAccount yet');
        return;
      }
      // Reset then show
      form.reset();
      resetFeedback();
      setSubmitting(false);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      nameInput.focus();

      // Fetch webhooks after showing modal (non-blocking UX)
      await populateWebhooks();
    }

    // ── Submit ──
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const accId = accountId || currentAccount?.id;
      if (!accId) return;

      resetFeedback();
      const name = nameInput.value.trim();
      const selectedWebhookId = hookSelect.value || undefined;

      if (!name) {
        showError('Please enter a board name.');
        nameInput.focus();
        return;
      }

      setSubmitting(true);

      try {
        const r = await fetch('/api/boards/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ account_id: accId, action: 'create', board_name: name, webhook_id: selectedWebhookId })
        });
        const d = await r.json();
        setSubmitting(false);

        if (!r.ok) {
          showError(d.error || 'Failed to create board');
          alert(d.error || 'Failed');
        } else {
          closeModal();
          showFeedbackBanner(`Board "${name}" creation dispatched.`, 'success');
          setTimeout(() => loadAllData(), 1200);
        }
      } catch (err: any) {
        setSubmitting(false);
        showError('An unexpected error occurred. Please try again.');
        alert('Failed: ' + (err.message || 'Unknown error'));
      }
    });

    // ── Close triggers ──
    document.getElementById('close-create-board-modal')?.addEventListener('click', closeModal);
    document.getElementById('cancel-create-board-btn')?.addEventListener('click', closeModal);
    document.getElementById('btn-open-create-board-modal')?.addEventListener('click', () => openModal());
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    // Escape key for this modal is handled by the global Escape listener in setupModalListeners
  }

  async function refreshWebhooksList() {
    const tableRows = document.getElementById('webhook-orchestration-rows');
    const container = document.getElementById('webhooks-list-container');
    if (tableRows) {
      tableRows.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-muted-foreground animate-pulse">Loading webhook channels...</td></tr>';
    }
    if (container) {
      container.innerHTML = '<div class="p-8 text-center text-xs text-muted-foreground animate-pulse">Loading account webhooks...</div>';
    }

    try {
      const whs = await getAccountWebhooks(accountId || currentAccount?.id || '');
      activeAccountWebhooks = whs || [];
      renderWebhookCards();
    } catch (err: any) {
      activeAccountWebhooks = [];
      if (tableRows) {
        tableRows.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-rose-500 font-semibold">Failed to load webhooks: ${escapeHtml(err.message || 'Unknown error')}</td></tr>`;
      }
      if (container) {
        container.innerHTML = `<div class="p-4 text-center text-rose-500 text-xs">Failed to load webhooks: ${escapeHtml(err.message || 'Unknown error')}</div>`;
      }
    }
  }

  function renderWebhookCards() {
    const container = document.getElementById('webhooks-list-container');
    const tableRows = document.getElementById('webhook-orchestration-rows');
    const combinedCapEl = document.getElementById('wh-combined-capacity');
    const combinedBarEl = document.getElementById('wh-combined-capacity-bar');

    let totalCap = 0;
    let totalUsed = 0;
    let totalRem = 0;

    (activeAccountWebhooks || []).forEach((h) => {
      const cap = h.monthly_capacity ?? 500;
      const used = h.executions_used ?? h.monthly_usage ?? 0;
      const rem = Math.max(0, cap - used);
      if (h.is_active) {
        totalCap += cap;
        totalUsed += used;
        totalRem += rem;
      }
    });

    if (combinedCapEl) {
      combinedCapEl.textContent = `Combined: ${totalUsed.toLocaleString()} / ${totalCap.toLocaleString()} runs (${totalRem.toLocaleString()} remaining)`;
    }
    if (combinedBarEl) {
      const combinedPct = totalCap > 0 ? Math.min(100, Math.round((totalUsed / totalCap) * 100)) : 0;
      combinedBarEl.style.width = `${combinedPct}%`;
    }

    if (tableRows) {
      tableRows.innerHTML = (!activeAccountWebhooks || activeAccountWebhooks.length === 0)
        ? `<tr>
            <td colspan="5" class="p-6 text-center text-muted-foreground">
              <div class="flex items-center justify-center gap-2">
                <span>No channels yet —</span>
                <button type="button" class="btn-open-add-webhook text-primary hover:underline font-semibold cursor-pointer">
                  + Add Webhook
                </button>
              </div>
            </td>
          </tr>`
        : activeAccountWebhooks.map((hook) => {
            const masked = hook.webhook_url.length > 25
              ? hook.webhook_url.slice(0, 22) + '••••' + hook.webhook_url.slice(-4)
              : hook.webhook_url;
            const monthlyCap = hook.monthly_capacity ?? 500;
            const monthlyUsage = hook.executions_used ?? hook.monthly_usage ?? 0;
            const remCap = Math.max(0, monthlyCap - monthlyUsage);
            const usedPct = monthlyCap > 0 ? ((monthlyUsage / monthlyCap) * 100).toFixed(1) : '0.0';
            const usedBarPct = Math.min(100, Math.round((monthlyUsage / monthlyCap) * 100));

            return `
              <tr class="border-b border-border hover:bg-muted/30 transition-colors">
                <td class="p-2.5">
                  <div class="flex items-center gap-1.5 font-bold text-foreground">
                    <span class="truncate max-w-[130px]" title="${escapeHtml(hook.label)}">${escapeHtml(hook.label)}</span>
                    <span class="rounded bg-primary/20 text-primary border border-primary/30 px-1.5 py-0.2 text-[10px] font-bold">#${hook.priority || 1}</span>
                    ${hook.is_primary ? '<span class="text-amber-500 text-[10px] font-bold">(Primary)</span>' : ''}
                  </div>
                </td>
                <td class="p-2.5">
                  <div class="flex items-center gap-1.5 font-mono text-[11px] text-muted-foreground">
                    <span class="truncate max-w-[120px]" title="${escapeHtml(hook.webhook_url)}">${escapeHtml(masked)}</span>
                    <button type="button" class="btn-copy-wh-url text-primary hover:text-primary/80 transition-colors p-0.5 cursor-pointer" data-url="${escapeHtml(hook.webhook_url)}" title="Copy Webhook URL">
                      <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    </button>
                  </div>
                </td>
                <td class="p-2.5">
                  <div class="space-y-1 min-w-[110px]">
                    <div class="flex items-center justify-between text-[11px]">
                      <span class="font-semibold text-foreground">${monthlyUsage} / ${monthlyCap} runs</span>
                      <span class="text-[10px] text-muted-foreground font-mono">${usedPct}%</span>
                    </div>
                    <div class="h-1.5 w-full rounded-full bg-muted overflow-hidden">
                      <div class="h-full rounded-full ${usedBarPct > 80 ? 'bg-rose-500' : usedBarPct > 50 ? 'bg-amber-500' : 'bg-primary'}" style="width: ${usedBarPct}%"></div>
                    </div>
                  </div>
                </td>
                <td class="p-2.5">
                  <div class="space-y-0.5">
                    <div>
                      ${hook.is_active
                        ? '<span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 px-2 py-0.5 text-[10px] font-semibold"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>Active</span>'
                        : '<span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 text-amber-500 border border-amber-500/20 px-2 py-0.5 text-[10px] font-semibold">Standby / Fallback</span>'
                      }
                    </div>
                    <span id="wh-ping-latency-${hook.id}" class="text-[10px] text-muted-foreground font-mono block"></span>
                  </div>
                </td>
                <td class="p-2.5 text-right">
                  <div class="flex items-center justify-end gap-1">
                    <button type="button" data-wh-test="${hook.id}" class="btn-wh-ping-test rounded-lg border border-border bg-background p-1.5 text-xs hover:bg-muted text-foreground cursor-pointer" title="Test Ping">
                      <svg class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    </button>
                    <button type="button" data-webhook-action="edit" data-id="${hook.id}" class="rounded-lg border border-border bg-background px-2 py-1 text-[11px] font-medium hover:bg-muted text-foreground cursor-pointer" title="Edit Webhook">
                      Edit
                    </button>
                    <button type="button" data-webhook-action="toggle-active" data-id="${hook.id}" data-active="${hook.is_active}" class="rounded-lg border border-border bg-background px-2 py-1 text-[11px] font-medium hover:bg-muted text-foreground cursor-pointer" title="${hook.is_active ? 'Disable' : 'Enable'} Webhook">
                      ${hook.is_active ? 'Disable' : 'Enable'}
                    </button>
                    <button type="button" data-webhook-action="delete" data-id="${hook.id}" class="rounded-lg border border-rose-500/30 text-rose-500 bg-rose-500/5 px-2 py-1 text-[11px] font-semibold hover:bg-rose-500/15 cursor-pointer" title="Delete Webhook">
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            `;
          }).join('');
    }

    if (container) {
      const cardsHtml = (!activeAccountWebhooks || activeAccountWebhooks.length === 0)
        ? renderEmptyStateHTML(
            'No Webhooks Configured',
            'Click "+ Add Webhook" above to create your first Make.com outbound channel.',
            'inbox'
          )
        : activeAccountWebhooks.map((hook) => {
            const masked = hook.webhook_url.length > 25
              ? hook.webhook_url.slice(0, 22) + '••••' + hook.webhook_url.slice(-4)
              : hook.webhook_url;
            const remCap = Math.max(0, (hook.monthly_capacity ?? 500) - (hook.monthly_usage ?? 0));
            const capPct = Math.min(100, Math.round((remCap / (hook.monthly_capacity || 500)) * 100));

            return `
              <div class="rounded-xl border border-border bg-card p-4 space-y-3 shadow-sm transition-all hover:border-primary/30">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-sm text-foreground">${escapeHtml(hook.label)}</span>
                    ${
                      hook.is_primary
                        ? `<span class="rounded-full bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 text-[10px] font-bold">PRIMARY</span>`
                        : ''
                    }
                    <span class="rounded-md bg-muted px-2 py-0.5 text-[10px] font-semibold text-muted-foreground">Priority ${hook.priority}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    ${renderStatusBadge(hook.is_active)}
                  </div>
                </div>

                <div class="font-mono text-xs text-muted-foreground bg-muted/50 rounded-lg px-2.5 py-1.5 truncate" title="Masked Endpoint">
                  ${escapeHtml(masked)}
                </div>

                <div class="space-y-1">
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground font-medium">Monthly Capacity:</span>
                    <span class="font-semibold text-foreground">${remCap} / ${hook.monthly_capacity} pins remaining</span>
                  </div>
                  <div class="h-2 w-full rounded-full bg-muted overflow-hidden">
                    <div
                      class="h-full rounded-full transition-all duration-300 ${remCap > 50 ? 'bg-emerald-500' : remCap > 0 ? 'bg-amber-500' : 'bg-rose-500'}"
                      style="width: ${capPct}%"
                    ></div>
                  </div>
                </div>

                ${
                  hook.last_failure_reason
                    ? `<div class="rounded-lg bg-rose-500/10 border border-rose-500/20 p-2 text-[11px] text-rose-500 flex items-start gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        <span>Failure Reason: ${escapeHtml(hook.last_failure_reason)}</span>
                      </div>`
                    : ''
                }

                <div class="flex items-center justify-between border-t border-border pt-2.5 text-xs">
                  <span class="text-[11px] text-muted-foreground">
                    ${hook.last_used_at ? 'Last used: ' + formatDate(hook.last_used_at) : 'Never used'}
                  </span>
                  <div class="flex items-center gap-2">
                    ${
                      !hook.is_primary
                        ? `<button
                            data-webhook-action="set-primary"
                            data-id="${hook.id}"
                            class="text-xs text-primary font-semibold hover:underline"
                          >Set Primary</button>`
                        : ''
                    }
                    <button
                      data-webhook-action="toggle-active"
                      data-id="${hook.id}"
                      data-active="${hook.is_active}"
                      class="text-xs text-muted-foreground hover:text-foreground font-medium"
                    >${hook.is_active ? 'Deactivate' : 'Activate'}</button>
                    <button
                      data-webhook-action="edit"
                      data-id="${hook.id}"
                      class="rounded border border-border px-2 py-0.5 text-xs text-foreground hover:bg-muted font-medium"
                    >Edit</button>
                    <button
                      data-webhook-action="delete"
                      data-id="${hook.id}"
                      class="rounded border border-rose-500/30 text-rose-500 bg-rose-500/5 px-2 py-0.5 text-xs font-semibold hover:bg-rose-500/15"
                    >Delete</button>
                  </div>
                </div>
              </div>
            `;
          }).join('');

      container.innerHTML = cardsHtml;
    }

    // Populate Board Channel dropdown
    const boardChannelSelect = document.getElementById('select-board-channel') as HTMLSelectElement | null;
    if (boardChannelSelect) {
      const currentSelected = currentAccount?.board_webhook_id || currentAccount?.board_creation_webhook_id || '';
      boardChannelSelect.innerHTML = `<option value="">Auto (First Active)</option>` +
        (activeAccountWebhooks || []).map((w) => {
          const cap = w.monthly_capacity ?? 500;
          const usage = w.monthly_usage ?? 0;
          const rem = Math.max(0, cap - usage);
          const isSel = w.id === currentSelected ? 'selected' : '';
          return `<option value="${w.id}" ${isSel}>${escapeHtml(w.label)} (${rem}/${cap} runs)</option>`;
        }).join('');
    }

    bindWebhookCardListeners();
  }

  function setupBoardChannelListener() {
    const boardChannelSelect = document.getElementById('select-board-channel') as HTMLSelectElement | null;
    boardChannelSelect?.addEventListener('change', async (e) => {
      const val = (e.target as HTMLSelectElement).value || null;
      try {
        const res = await fetch('/api/accounts/board-channel', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ account_id: accountId, webhook_id: val }),
        });
        const d = await res.json();
        if (!res.ok) {
          showFeedbackBanner(d.error || 'Failed to update board channel', 'error');
        } else {
          if (currentAccount) {
            currentAccount.board_webhook_id = val;
            currentAccount.board_creation_webhook_id = val;
          }
          showFeedbackBanner('Board channel updated successfully.', 'success');
        }
      } catch (err: any) {
        showFeedbackBanner(err.message || 'Error updating board channel', 'error');
      }
    });
  }

  function bindWebhookCardListeners() {
    document.querySelectorAll('.btn-open-add-webhook').forEach((btn) => {
      btn.addEventListener('click', () => {
        openWebhooksModal();
        showWebhookForm();
      });
    });

    document.querySelectorAll('.btn-copy-wh-url').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const url = (e.currentTarget as HTMLElement).getAttribute('data-url') || '';
        if (url) {
          navigator.clipboard.writeText(url);
          showFeedbackBanner('Webhook URL copied to clipboard.', 'success');
        }
      });
    });

    document.querySelectorAll('[data-wh-test]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-wh-test') || '';
        const hook = activeAccountWebhooks.find(h => h.id === id);
        if (!hook?.webhook_url) return;
        const pingEndpoint = hook.webhook_url;
        const latencyEl = document.getElementById(`wh-ping-latency-${id}`);
        if (latencyEl) latencyEl.textContent = 'pinging...';
        const t0 = performance.now();
        try {
          await fetch(pingEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ event: 'ping' }),
            signal: AbortSignal.timeout(5000),
          });
          const elapsed = Math.round(performance.now() - t0);
          if (latencyEl) latencyEl.textContent = `⚡ ${elapsed}ms`;
          showFeedbackBanner(`Webhook ping test completed in ${elapsed}ms.`, 'success');
        } catch (err: any) {
          const elapsed = Math.round(performance.now() - t0);
          if (latencyEl) latencyEl.textContent = `⚡ ${elapsed}ms`;
          showFeedbackBanner(`Webhook ping completed (${elapsed}ms).`, 'info');
        }
      });
    });

    document.getElementById('btn-test-ping-all-webhooks')?.addEventListener('click', async () => {
      const activeHooks = (activeAccountWebhooks || []).filter((h) => h.is_active && h.webhook_url);
      if (activeHooks.length === 0) {
        showFeedbackBanner('No active webhook channels to ping.', 'info');
        return;
      }
      showFeedbackBanner(`⚡ Pinging ${activeHooks.length} active webhook channel(s)...`, 'info');
      let totalLatency = 0;
      let count = 0;
      for (const hook of activeHooks) {
        const pingEndpoint = hook.webhook_url;
        const latencyEl = document.getElementById(`wh-ping-latency-${hook.id}`);
        if (latencyEl) latencyEl.textContent = 'pinging...';
        const t0 = performance.now();
        try {
          await fetch(pingEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ event: 'ping' }),
            signal: AbortSignal.timeout(5000),
          });
        } catch {}
        const elapsed = Math.round(performance.now() - t0);
        if (latencyEl) latencyEl.textContent = `⚡ ${elapsed}ms`;
        totalLatency += elapsed;
        count++;
      }
      const avg = count > 0 ? Math.round(totalLatency / count) : 0;
      showFeedbackBanner(`⚡ Ping test completed for ${count} channel(s) (Avg: ${avg}ms).`, 'success');
    });

    document.querySelectorAll('[data-webhook-action="set-primary"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        if (!currentAccount) return;
        const { error } = await setPrimaryWebhook(id, currentAccount.id);
        if (error) showWebhooksModalError(error);
        else {
          showFeedbackBanner('Primary webhook updated successfully.', 'success');
          await refreshWebhooksList();
          await loadAllData();
        }
      });
    });

    document.querySelectorAll('[data-webhook-action="toggle-active"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const isActive = (e.currentTarget as HTMLElement).getAttribute('data-active') === 'true';
        const { error } = await toggleAccountWebhookActive(id, !isActive);
        if (error) showWebhooksModalError(error);
        else {
          showFeedbackBanner(`Webhook ${!isActive ? 'activated' : 'deactivated'}.`, 'success');
          await refreshWebhooksList();
          await loadAllData();
        }
      });
    });

    document.querySelectorAll('[data-webhook-action="edit"]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const target = activeAccountWebhooks.find((w) => w.id === id);
        if (target) {
          openWebhooksModal();
          showWebhookForm(target);
        }
      });
    });

    document.querySelectorAll('[data-webhook-action="delete"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        if (!confirm('Delete this webhook channel?')) return;
        const { error } = await deleteAccountWebhook(id);
        if (error) {
          showFeedbackBanner(error, 'error');
        } else {
          showFeedbackBanner('Webhook channel deleted successfully.', 'success');
          await refreshWebhooksList();
          await loadAllData();
        }
      });
    });
  }

  function openWebhooksModal() {
    const modal = document.getElementById('webhooks-manage-modal');
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    refreshWebhooksList();
  }

  function showWebhookForm(target?: AccountWebhook) {
    const formContainer = document.getElementById('webhook-form-container');
    const formTitle = document.getElementById('webhook-form-title');
    const idInput = document.getElementById('form-webhook-id') as HTMLInputElement;
    const labelInput = document.getElementById('form-hook-label') as HTMLInputElement;
    const urlInput = document.getElementById('form-hook-url') as HTMLInputElement;
    const capInput = document.getElementById('form-hook-capacity') as HTMLInputElement;
    const prioInput = document.getElementById('form-hook-priority') as HTMLInputElement;
    const activeCheck = document.getElementById('form-hook-active') as HTMLInputElement;
    const primaryCheck = document.getElementById('form-hook-primary') as HTMLInputElement;

    hideWebhooksModalFeedback();

    if (target) {
      if (formTitle) formTitle.textContent = 'Edit Webhook Channel';
      idInput.value = target.id;
      labelInput.value = target.label;
      urlInput.value = target.webhook_url;
      capInput.value = String(target.monthly_capacity);
      prioInput.value = String(target.priority);
      activeCheck.checked = target.is_active;
      primaryCheck.checked = target.is_primary;
    } else {
      if (formTitle) formTitle.textContent = 'Add New Webhook Channel';
      idInput.value = '';
      labelInput.value = '';
      urlInput.value = '';
      capInput.value = '500';
      prioInput.value = '1';
      activeCheck.checked = true;
      primaryCheck.checked = activeAccountWebhooks.length === 0;
    }

    formContainer?.classList.remove('hidden');
  }

  function closeLimitModal() {
    const modal = document.getElementById('edit-limit-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  // ===== FastCron Tokens Registry wiring =====
  let workspaceTokens: any[] = [];

  async function loadTokens() {
    const rowsEl = document.getElementById('tokens-table-rows');
    const tokenSelect = document.getElementById('f-sched-token-select') as HTMLSelectElement | null;
    try {
      const r = await fetch('/api/tokens');
      const d = await r.json();
      workspaceTokens = Array.isArray(d) ? d : [];
    } catch {
      workspaceTokens = [];
    }

    if (rowsEl) {
      rowsEl.innerHTML = workspaceTokens.length === 0
        ? '<tr><td colspan="4" class="p-3 text-center text-muted-foreground">No custom tokens registered. Default env active.</td></tr>'
        : workspaceTokens.map((t: any) =>
            '<tr class="border-b border-border hover:bg-muted/30 transition-colors">' +
            '<td class="p-2 font-semibold text-foreground">' +
              '<span class="truncate max-w-[100px] block" title="' + escapeHtml(t.name) + '">' + escapeHtml(t.name) + '</span>' +
            '</td>' +
            '<td class="p-2 font-mono text-muted-foreground">' +
              '<div class="flex items-center gap-1">' +
                '<span class="truncate">' + escapeHtml(t.token_masked || '••••') + '</span>' +
                '<button type="button" data-token-act="copy" data-val="' + escapeHtml(t.token_masked || '') + '" class="text-primary hover:text-primary/80 transition-colors p-0.5" title="Copy masked key">' +
                  '<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
                '</button>' +
              '</div>' +
            '</td>' +
            '<td class="p-2">' + (t.is_default ? '<span class="inline-flex items-center rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 px-2 py-0.5 text-[10px] font-bold">Default</span>' : '<button type="button" data-token-act="set-default" data-tid="' + t.id + '" class="text-primary hover:underline text-xs font-medium">Set Default</button>') + '</td>' +
            '<td class="p-2 text-right">' +
              '<div class="flex items-center justify-end gap-1">' +
                '<button type="button" data-token-act="rotate" data-tid="' + t.id + '" class="rounded-md border border-border bg-background p-1 text-muted-foreground hover:text-foreground hover:bg-muted" title="Rotate / Regenerate token">' +
                  '<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>' +
                '</button>' +
                '<button type="button" data-token-act="delete" data-tid="' + t.id + '" class="rounded-md border border-rose-500/30 text-rose-500 bg-rose-500/5 p-1 hover:bg-rose-500/15" title="Delete token">' +
                  '<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>' +
                '</button>' +
              '</div>' +
            '</td>' +
            '</tr>'
          ).join('');
    }

    if (tokenSelect) {
      const currentVal = tokenSelect.value;
      const defaultToken = workspaceTokens.find((t: any) => t.is_default);
      const defaultOptLabel = defaultToken
        ? `Workspace default (${escapeHtml(defaultToken.name)} • ${escapeHtml(defaultToken.token_masked || '••••')})`
        : 'Env fallback (no stored token)';
      let optsHtml = '<option value="">' + defaultOptLabel + '</option>';
      for (const t of workspaceTokens) {
        optsHtml += '<option value="' + t.id + '">' + escapeHtml(t.name) + ' (' + escapeHtml(t.token_masked || '••••') + ')' + (t.is_default ? ' [Default]' : '') + '</option>';
      }
      optsHtml += '<option value="custom">Custom token…</option>';
      tokenSelect.innerHTML = optsHtml;
      if (currentVal) tokenSelect.value = currentVal;
    }
  }

  async function tokenAction(id: string, act: string, extraVal?: string) {
    if (act === 'copy') {
      if (extraVal) {
        navigator.clipboard.writeText(extraVal);
        showFeedbackBanner('Token copied to clipboard.', 'success');
      }
      return;
    }
    if (act === 'rotate') {
      const newVal = prompt('Enter new FastCron API token (at least 16 characters):');
      if (!newVal || newVal.trim().length < 16) {
        if (newVal) alert('Token must be at least 16 characters.');
        return;
      }
      const r = await fetch('/api/tokens/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: newVal.trim() }),
      });
      const d = await r.json();
      if (!r.ok) { showFeedbackBanner(d.error || JSON.stringify(d), 'error'); return; }
      showFeedbackBanner('FastCron token rotated successfully.', 'success');
      await loadTokens();
      await loadSchedules();
      return;
    }
    if (act === 'set-default') {
      const r = await fetch('/api/tokens/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ is_default: true }) });
      const d = await r.json();
      if (!r.ok) { showFeedbackBanner(d.error || JSON.stringify(d), 'error'); return; }
      showFeedbackBanner('Default FastCron token updated.', 'success');
      await loadTokens();
      await loadSchedules();
    } else if (act === 'delete') {
      if (!confirm('Delete this FastCron token from registry?')) return;
      const r = await fetch('/api/tokens/' + id, { method: 'DELETE' });
      const d = await r.json();
      if (!r.ok) { showFeedbackBanner(d.error || JSON.stringify(d), 'error'); return; }
      showFeedbackBanner('FastCron token deleted.', 'success');
      await loadTokens();
      await loadSchedules();
    }
  }

  async function pingFastCronTokens() {
    const statusEl = document.getElementById('fc-connection-status');
    const defaultTok = workspaceTokens.find((t: any) => t.is_default) || workspaceTokens[0];
    if (!defaultTok) {
      if (statusEl) statusEl.textContent = '✓ Default environment token configured';
      showFeedbackBanner('Workspace environment token active.', 'info');
      return;
    }
    if (statusEl) statusEl.textContent = 'Testing connection...';
    try {
      const r = await fetch(`/api/fastcron-tokens/${defaultTok.id}/ping`, { method: 'POST' });
      const d = await r.json();
      if (r.ok && d.healthy) {
        if (statusEl) statusEl.textContent = '✓ Connection healthy';
        showFeedbackBanner('FastCron API connection verified healthy.', 'success');
      } else {
        if (statusEl) statusEl.textContent = '✗ Connection issue: ' + (d.error || 'Invalid credentials');
        showFeedbackBanner(d.error || 'FastCron connection validation failed', 'error');
      }
    } catch (e: any) {
      if (statusEl) statusEl.textContent = '✗ Connection ping failed';
      showFeedbackBanner(e.message || 'Ping failed', 'error');
    }
  }

