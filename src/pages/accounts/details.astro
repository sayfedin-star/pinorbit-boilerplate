  function formatRangeList(set: Set<number>, max: number, startAtZero = true): string {
    if (set.size === 0) return '*';
    if (set.size === (startAtZero ? max + 1 : max)) return '*';
    const sorted = Array.from(set).sort((a, b) => a - b);
    return sorted.join(',');
  }

  function getVisualCronExpression(): string {
    const mStr = formatRangeList(visualMinutes, 59, true);
    const hStr = formatRangeList(visualHours, 23, true);
    const dStr = visualWeekdays.size === 7 || visualWeekdays.size === 0 ? '*' : Array.from(visualWeekdays).sort((a, b) => a - b).join(',');
    return `${mStr} ${hStr} * * ${dStr}`;
  }

  function parseCronExpressionToVisual(expr: string) {
    if (!expr || typeof expr !== 'string') return;
    const parts = expr.trim().split(/\s+/);
    if (parts.length < 5) return;

    visualMinutes.clear();
    const parseField = (part: string, min: number, max: number, targetSet: Set<number>) => {
      if (part === '*') {
        for (let i = min; i <= max; i++) targetSet.add(i);
        return;
      }
      if (part.startsWith('*/')) {
        const step = parseInt(part.slice(2), 10) || 1;
        for (let i = min; i <= max; i += step) targetSet.add(i);
        return;
      }
      part.split(',').forEach(item => {
        if (item.includes('-')) {
          const [s, e] = item.split('-').map(Number);
          if (!isNaN(s) && !isNaN(e)) {
            for (let i = s; i <= e; i++) targetSet.add(i);
          }
        } else {
          const n = parseInt(item, 10);
          if (!isNaN(n)) targetSet.add(n);
        }
      });
    };

    visualMinutes.clear();
    parseField(parts[0], 0, 59, visualMinutes);
    visualHours.clear();
    parseField(parts[1], 0, 23, visualHours);
    visualWeekdays.clear();
    parseField(parts[4], 0, 6, visualWeekdays);

    renderVisualCronGrids();
    updateVisualCronPreview();
  }

  function buildHumanReadableSummary(cronExpr: string): string {
    const parts = cronExpr.trim().split(/\s+/);
    if (parts.length < 5) return 'Invalid cron expression format (must have 5 fields)';

    const [mPart, hPart, , , dowPart] = parts;
    const dayNames: Record<number, string> = { 0: 'Sunday', 1: 'Monday', 2: 'Tuesday', 3: 'Wednesday', 4: 'Thursday', 5: 'Friday', 6: 'Saturday', 7: 'Sunday' };

    let mText = '';
    if (mPart === '*') mText = 'every minute';
    else if (mPart.startsWith('*/')) mText = `every ${mPart.slice(2)} minutes`;
    else {
      const mins = mPart.split(',');
      if (mins.length === 1) mText = `at minute ${mins[0]}`;
      else if (mins.length <= 3) mText = `at minute ${mins.slice(0, -1).join(', ')} and ${mins[mins.length - 1]}`;
      else mText = `at minutes ${mins.slice(0, 3).join(', ')}... (+${mins.length - 3} more)`;
    }

    let hText = '';
    if (hPart === '*') hText = 'every hour';
    else if (hPart.startsWith('*/')) hText = `every ${hPart.slice(2)} hours`;
    else if (hPart.includes('-')) hText = `past hour ${hPart}`;
    else {
      const hrs = hPart.split(',');
      if (hrs.length <= 3) hText = `past hour ${hrs.join(', ')}`;
      else hText = `past hour ${hrs.slice(0, 3).join(', ')}... (+${hrs.length - 3} more)`;
    }

    let dText = '';
    if (dowPart === '*') dText = 'every day';
    else if (dowPart === '1-5') dText = 'on Monday through Friday';
    else if (dowPart === '6,0' || dowPart === '0,6') dText = 'on weekends';
    else {
      const dows = dowPart.split(',').map(d => dayNames[Number(d)] || d);
      dText = `on ${dows.join(', ')}`;
    }

    return `At ${mText} ${hText} ${dText}`;
  }

  function calculateNextExecution(cronExpr: string, tzStr = 'UTC'): string {
    try {
      const parts = cronExpr.trim().split(/\s+/);
      if (parts.length < 5) return '--:--';
      const [mPart, hPart, , , dowPart] = parts;

      const matchNum = (val: number, rule: string): boolean => {
        if (rule === '*') return true;
        if (rule.startsWith('*/')) {
          const step = Number(rule.slice(2)) || 1;
          return val % step === 0;
        }
        return rule.split(',').some(part => {
          if (part.includes('-')) {
            const [start, end] = part.split('-').map(Number);
            return val >= start && val <= end;
          }
          return Number(part) === val;
        });
      };

      const scanTime = new Date(Date.now() + 60000);
      scanTime.setSeconds(0, 0);

      // Scan up to 7 days minute-by-minute
      for (let offset = 0; offset < 7 * 24 * 60; offset++) {
        const testDate = new Date(scanTime.getTime() + offset * 60000);
        let m = testDate.getUTCMinutes(), h = testDate.getUTCHours(), dow = testDate.getUTCDay();
        try {
          const formatter = new Intl.DateTimeFormat('en-US', { timeZone: tzStr, minute: 'numeric', hour: 'numeric', weekday: 'short', hour12: false });
          const partsTz = formatter.formatToParts(testDate);
          m = Number(partsTz.find(p => p.type === 'minute')?.value ?? m);
          h = Number(partsTz.find(p => p.type === 'hour')?.value ?? h);
          const dayStr = partsTz.find(p => p.type === 'weekday')?.value ?? '';
          const dowMap: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
          if (dayStr in dowMap) dow = dowMap[dayStr];
        } catch {}

        if (matchNum(m, mPart) && matchNum(h, hPart) && matchNum(dow, dowPart)) {
          const dayName = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][dow];
          const padH = h < 10 ? '0' + h : String(h);
          const padM = m < 10 ? '0' + m : String(m);
          return `${dayName}, ${padH}:${padM}`;
        }
      }
      return 'Within 7 days: none';
    } catch {
      return '--:--';
    }
  }

  function updateVisualCronPreview() {
    const expr = getVisualCronExpression();
    const tz = (document.getElementById('f-sched-tz') as HTMLInputElement)?.value || 'UTC';
    const sumEl = document.getElementById('visual-human-summary');
    const nextEl = document.getElementById('visual-next-exec');
    if (sumEl) sumEl.textContent = buildHumanReadableSummary(expr);
    if (nextEl) nextEl.textContent = calculateNextExecution(expr, tz);
  }

  function updateRawCronPreview() {
    const rawVal = (document.getElementById('f-raw-cron') as HTMLTextAreaElement)?.value || '* * * * *';
    const tz = (document.getElementById('f-sched-tz') as HTMLInputElement)?.value || 'UTC';
    const sumEl = document.getElementById('raw-human-summary');
    const nextEl = document.getElementById('raw-next-exec');
    if (sumEl) sumEl.textContent = buildHumanReadableSummary(rawVal);
    if (nextEl) nextEl.textContent = calculateNextExecution(rawVal, tz);
  }

  // ===== Posting Schedules (engine) & Batch wiring =====
  let accountSchedules: any[] = [];
  const selectedScheduleIds = new Set<string>();

  function updateBatchButtonState() {
    const count = selectedScheduleIds.size;
    const badge = document.getElementById('batch-sel-count');
    const btnBatch = document.getElementById('btn-sched-batch') as HTMLButtonElement | null;
    const btnEdit = document.getElementById('batch-act-edit') as HTMLButtonElement | null;
    if (badge) {
      badge.textContent = String(count);
      badge.classList.toggle('hidden', count === 0);
    }
    if (btnBatch) {
      btnBatch.disabled = count === 0;
      if (count === 0) {
        btnBatch.title = 'Select rows first';
        btnBatch.classList.add('opacity-50', 'cursor-not-allowed');
      } else {
        btnBatch.title = 'Batch actions';
        btnBatch.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    }
    if (btnEdit) {
      btnEdit.disabled = count !== 1;
    }
    const headerChk = document.getElementById('sched-select-all-header') as HTMLInputElement | null;
    if (headerChk) {
      headerChk.checked = accountSchedules.length > 0 && accountSchedules.every(s => selectedScheduleIds.has(s.id));
    }
  }

  async function executeBatchAction(action: 'run' | 'resume' | 'pause' | 'delete' | 'export') {
    if (selectedScheduleIds.size === 0) {
      alert('Please select at least one schedule.');
      return;
    }
    const ids = Array.from(selectedScheduleIds);

    if (action === 'export') {
      const items = accountSchedules.filter(s => selectedScheduleIds.has(s.id));
      exportSchedulesCsv(items);
      return;
    }

    if (action === 'delete' && !confirm(`Delete ${ids.length} selected schedule(s)?`)) return;

    try {
      const r = await fetch('/api/schedules/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids, action }),
      });
      const d = await r.json();
      if (!r.ok) {
        showFeedbackBanner(d.error || JSON.stringify(d), 'error');
        alert(d.error || JSON.stringify(d));
      } else {
        let msg = `Bulk ${action}: Total: ${d.total}, Success: ${d.success}, Failed: ${d.failed}`;
        if (d.remote_orphans && d.remote_orphans > 0) {
          msg = `Bulk ${action}: Success: ${d.success} (remote orphans: ${d.remote_orphans}), Failed: ${d.failed}`;
        }
        showFeedbackBanner(msg, d.failed === 0 && (!d.remote_orphans || d.remote_orphans === 0) ? 'success' : 'info');
        alert(msg);
      }
      selectedScheduleIds.clear();
      updateBatchButtonState();
      await loadSchedules();
    } catch (err: any) {
      showFeedbackBanner(err.message || 'Batch action failed', 'error');
    }
  }

  function exportSchedulesCsv(itemsToExport: any[]) {
    const headers = ['label', 'account', 'window', 'interval', 'days', 'status', 'job_id', 'last_dispatched_at'];
    const rows = itemsToExport.map(s => {
      const accName = s.accounts?.account_name || (currentAccount?.account_name) || '';
      const win = `${s.window_start || '09:00'} - ${s.window_end || '21:00'}`;
      const days = Array.isArray(s.active_days) ? s.active_days.join(';') : (s.active_days || '');
      return [
        `"${(s.label || '').replace(/"/g, '""')}"`,
        `"${accName.replace(/"/g, '""')}"`,
        `"${win}"`,
        s.interval_minutes ?? 36,
        `"${days}"`,
        s.status || 'active',
        s.fastcron_job_id || '',
        s.last_dispatched_at || ''
      ].join(',');
    });
    const csvContent = [headers.join(','), ...rows].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `schedules-export-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showFeedbackBanner('Schedules exported to CSV.', 'success');
  }

  async function loadSchedules() {
    const rowsEl = document.getElementById('account-schedules-rows');
    if (!rowsEl || !accountId) return;
    try {
      const r = await fetch('/api/schedules?account_id=' + encodeURIComponent(accountId));
      const d = await r.json();
      accountSchedules = Array.isArray(d) ? d : [];
    } catch { accountSchedules = []; }

    const txtPage = document.getElementById('batch-txt-select-page');
    if (txtPage) txtPage.textContent = `Select all on page (${accountSchedules.length})`;

    rowsEl.innerHTML = accountSchedules.length === 0
      ? '<tr><td colspan="6" class="p-4 text-center text-muted-foreground">No engine schedules yet. Click "+ New" to create your first schedule.</td></tr>'
      : accountSchedules.map((s: any) => {
          const tz = s.timezone || 'UTC';
          let day = '', hm = '';
          try {
            const parts = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
            day = parts.find((p: any) => p.type === 'weekday')?.value || '';
            hm = (parts.find((p: any) => p.type === 'hour')?.value || '00') + ':' + (parts.find((p: any) => p.type === 'minute')?.value || '00');
          } catch {}
          const isDayOff = day && Array.isArray(s.active_days) && s.active_days.length > 0 && !s.active_days.includes(day);
          const w0 = String(s.window_start || '09:00').slice(0,5);
          const w1 = String(s.window_end || '21:00').slice(0,5);
          const isClosed = hm && (w0 <= w1 ? (hm < w0 || hm > w1) : (hm < w0 && hm > w1));

          let windowBadge = '';
          let nextPinText = '';

          if (s.status === 'paused') {
            windowBadge = '<span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 text-amber-500 px-2 py-0.5 text-[10px] font-semibold">Paused</span>';
          } else if (s.cron_expression) {
            windowBadge = '<span class="inline-flex items-center gap-1 rounded-full bg-indigo-500/10 text-indigo-400 px-2 py-0.5 text-[10px] font-semibold">Custom Cron</span>';
          } else if (isDayOff) {
            windowBadge = '<span class="inline-flex items-center gap-1 rounded-full bg-zinc-500/10 text-zinc-400 px-2 py-0.5 text-[10px] font-semibold">Day Off</span>';
          } else if (isClosed) {
            windowBadge = '<span class="inline-flex items-center gap-1 rounded-full bg-zinc-500/10 text-zinc-400 px-2 py-0.5 text-[10px] font-semibold">Window Closed</span>';
          } else {
            windowBadge = '<span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 text-emerald-500 px-2 py-0.5 text-[10px] font-semibold"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>Active</span>';
          }

          if (s.cron_expression) {
            const nextComputed = calculateNextExecution(s.cron_expression, tz);
            nextPinText = 'Next run: ' + nextComputed;
          } else {
            nextPinText = 'Next: ~' + Math.max(1, Math.round((s.interval_minutes || 36) / 2)) + 'm';
          }

          const startedText = s.started_at
            ? (new Date(s.started_at) > new Date() ? 'Starts ' + String(s.started_at).slice(0, 10) : 'Started ' + String(s.started_at).slice(0, 10))
            : 'Immediate';
          const lastDispHtml = s.last_dispatched_at 
            ? '<span>Last dispatch: ' + escapeHtml(new Date(s.last_dispatched_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })) + '</span>' 
            : '<span title="No successful dispatch yet">Last dispatch: never</span>';

          const tokenDisplay = s.token_name
            ? escapeHtml(s.token_name) + ' (' + escapeHtml(s.fastcron_token_masked || '') + ')'
            : (s.fastcron_token_masked ? 'Custom (' + escapeHtml(s.fastcron_token_masked) + ')' : 'Default (Workspace)');

          const webhookLabel = s.webhook_label || (s.account_webhooks?.label) || (s.webhook_id ? 'Selected Webhook' : 'Auto / Any Active');
          const isChecked = selectedScheduleIds.has(s.id);

          return '<tr class="border-b border-border hover:bg-muted/30 transition-colors">' +
            '<td class="p-2.5">' +
              '<input type="checkbox" class="sched-row-chk h-3.5 w-3.5 rounded border-border text-primary cursor-pointer" data-id="' + s.id + '" ' + (isChecked ? 'checked' : '') + ' />' +
            '</td>' +
            '<td class="p-2.5">' +
              '<div class="font-bold text-foreground">' + escapeHtml(s.label || '(unnamed schedule)') + '</div>' +
              '<div class="flex flex-wrap items-center gap-1.5 pt-1 text-[10px] text-muted-foreground">' +
                windowBadge +
                '<span>•</span><span>' + escapeHtml(startedText) + '</span>' +
                '<span>•</span>' + lastDispHtml +
                '<span>•</span><span class="text-primary font-medium">' + escapeHtml(nextPinText) + '</span>' +
              '</div>' +
            '</td>' +
            '<td class="p-2.5">' +
              '<span class="inline-flex items-center rounded-lg bg-muted px-2 py-1 text-[11px] font-medium text-foreground">' + escapeHtml(webhookLabel) + '</span>' +
            '</td>' +
            '<td class="p-2.5">' +
              (s.cron_expression
                ? '<div class="font-mono text-[11px] font-semibold text-primary">' + escapeHtml(s.cron_expression) + '</div>'
                : '<div class="font-semibold text-foreground">' + escapeHtml(String(s.window_start).slice(0,5)) + '–' + escapeHtml(String(s.window_end).slice(0,5)) + ' <span class="text-[10px] text-muted-foreground font-normal">(' + escapeHtml(s.timezone) + ')</span></div>' +
                  '<div class="text-[11px] text-muted-foreground">' + s.interval_minutes + 'm ±' + s.random_delay_minutes + 'm • ' + escapeHtml((s.active_days || []).join(', ')) + '</div>'
              ) +
            '</td>' +
            '<td class="p-2.5 text-muted-foreground text-[11px]">' + tokenDisplay + '</td>' +
            '<td class="p-2.5 text-right">' +
              '<select class="sched-action-select rounded-lg border border-border bg-background py-1 px-2 text-xs font-semibold text-foreground focus:outline-none cursor-pointer" data-sid="' + s.id + '">' +
                '<option value="" disabled selected>Actions ▾</option>' +
                '<option value="run">⚡ Run Now</option>' +
                '<option value="edit">✏️ Edit</option>' +
                '<option value="' + (s.status === 'paused' ? 'resume' : 'pause') + '">' + (s.status === 'paused' ? '▶️ Resume' : '⏸️ Pause') + '</option>' +
                '<option value="clone">📋 Clone</option>' +
                '<option value="logs">📜 FastCron Logs</option>' +
                '<option value="delete">🗑️ Delete</option>' +
              '</select>' +
            '</td>' +
          '</tr>';
        }).join('');

    updateBatchButtonState();
    if (currentAccount) {
      renderHeader(currentAccount);
      renderScheduling(currentAccount);
    }
  }

  function populateChannelSelect() {
    const sel = document.getElementById('f-channel') as HTMLSelectElement | null;
    if (!sel) return;
    const active = (activeAccountWebhooks || []).filter((w: any) => w.is_active);
    sel.innerHTML = active.length
      ? '<option value="">Auto / Any Active Channel</option>' + active.map((w: any, i: number) => '<option value="' + w.id + '">' + escapeHtml((w as any).label || (i === 0 ? 'Primary' : 'Channel ' + (i + 1))) + '</option>').join('')
      : '<option value="">No active webhook configured</option>';
  }

  function updateSchedCadence() {
    const presetSel = document.getElementById('f-sched-interval-preset') as HTMLSelectElement | null;
    const intervalInput = document.getElementById('f-sched-interval') as HTMLInputElement | null;
    let interval = 36;
    if (presetSel && presetSel.value !== 'custom') {
      interval = Number(presetSel.value) || 36;
      if (intervalInput) intervalInput.value = String(interval);
    } else if (intervalInput) {
      interval = Number(intervalInput.value) || 36;
    }

    const start = (document.getElementById('f-sched-start') as HTMLInputElement)?.value || '09:00';
    const end = (document.getElementById('f-sched-end') as HTMLInputElement)?.value || '21:00';
    const [sH, sM] = start.split(':').map(Number);
    const [eH, eM] = end.split(':').map(Number);
    let winMins = (eH * 60 + eM) - (sH * 60 + sM);
    if (winMins <= 0) winMins += 1440;
    const h = (winMins / 60).toFixed(1);
    const estPins = Math.floor(winMins / interval);

    const checkedDays: string[] = [];
    document.querySelectorAll('.f-sched-day-chk:checked').forEach((chk) => {
      checkedDays.push((chk as HTMLInputElement).value);
    });

    const cronExpr = buildPortableCron({
      interval_minutes: interval,
      window_start: start,
      window_end: end,
      active_days: checkedDays.length > 0 ? checkedDays : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    });

    const perHourRuns = interval < 60
      ? `${(60 / interval).toFixed(1).replace(/\.0$/, '')} runs/hr`
      : `1 run / ${Math.round(interval / 60)} hrs`;

    const txtEl = document.getElementById('sched-cadence-text');
    const effEl = document.getElementById('sched-cadence-effective');
    if (txtEl) txtEl.textContent = `At ${interval}m interval across ${h}h window, capacity is ~${estPins} pins/day (${perHourRuns} active).`;
    if (effEl) effEl.textContent = `Portable Cron: ${cronExpr} • Window & active days enforced server-side`;
  }

  function openScheduleModal(s?: any) {
    populateChannelSelect();
    const acc: any = currentAccount || {};
    (document.getElementById('schedule-modal-title') as HTMLElement).textContent = s ? 'Edit Posting Schedule' : 'Add Posting Schedule';
    (document.getElementById('f-sched-id') as HTMLInputElement).value = s?.id || '';
    (document.getElementById('f-sched-label') as HTMLInputElement).value = s?.label || '';
    (document.getElementById('f-fc-token') as HTMLInputElement).value = '';

    const tokenSelect = document.getElementById('f-sched-token-select') as HTMLSelectElement;
    const customTokenBox = document.getElementById('f-sched-custom-token-box');
    const statusEl = document.getElementById('fc-token-status');

    if (s?.fastcron_token_id) {
      tokenSelect.value = s.fastcron_token_id;
      customTokenBox?.classList.add('hidden');
    } else if (s?.has_fastcron_token && !s?.fastcron_token_id) {
      tokenSelect.value = 'custom';
      customTokenBox?.classList.remove('hidden');
      if (statusEl) statusEl.innerHTML = '<span class="text-emerald-600 font-medium">Custom override: ' + escapeHtml(s.fastcron_token_masked) + '</span>';
    } else {
      tokenSelect.value = '';
      customTokenBox?.classList.add('hidden');
      if (statusEl) statusEl.innerHTML = '<span class="text-muted-foreground">Using default (workspace / environment)</span>';
    }

    if (s?.webhook_id) (document.getElementById('f-channel') as HTMLSelectElement).value = s.webhook_id;
    else (document.getElementById('f-channel') as HTMLSelectElement).value = '';

    (document.getElementById('f-sched-tz') as HTMLInputElement).value = s?.timezone || acc.timezone || 'UTC';
    (document.getElementById('f-sched-batch') as HTMLInputElement).value = String(s?.batch ?? 1);
    (document.getElementById('f-sched-start') as HTMLInputElement).value = (s?.window_start || acc.posting_window_start || '09:00').slice(0, 5);
    (document.getElementById('f-sched-end') as HTMLInputElement).value = (s?.window_end || acc.posting_window_end || '21:00').slice(0, 5);

    const mins = s?.interval_minutes ?? acc.posting_interval_minutes ?? 36;
    const presetSel = document.getElementById('f-sched-interval-preset') as HTMLSelectElement;
    const customContainer = document.getElementById('f-sched-custom-interval-container');
    const customInput = document.getElementById('f-sched-interval') as HTMLInputElement;

    const standardPresets = ['5', '10', '15', '30', '36', '45', '60', '120', '180', '240', '360', '720', '1440'];
    if (standardPresets.includes(String(mins))) {
      presetSel.value = String(mins);
      customContainer?.classList.add('hidden');
      customInput.value = String(mins);
    } else {
      presetSel.value = 'custom';
      customContainer?.classList.remove('hidden');
      customInput.value = String(mins);
    }

    (document.getElementById('f-sched-delay') as HTMLInputElement).value = String(s?.random_delay_minutes ?? acc.random_delay_minutes ?? 0);

    const activeDays = Array.isArray(s?.active_days)
      ? s.active_days
      : (typeof s?.active_days === 'string' ? s.active_days.replace(/[{}"']/g, '').split(',').map((x: string) => x.trim()) : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']);

    document.querySelectorAll('.f-sched-day-chk').forEach((chk) => {
      (chk as HTMLInputElement).checked = activeDays.includes((chk as HTMLInputElement).value);
    });

    (document.getElementById('f-sched-started') as HTMLInputElement).value = s?.started_at ? String(s.started_at).slice(0, 10) : '';

    // Cron Tabs setup
    if (s?.cron_expression) {
      const rawInput = document.getElementById('f-raw-cron') as HTMLTextAreaElement | null;
      if (rawInput) rawInput.value = s.cron_expression;
      parseCronExpressionToVisual(s.cron_expression);
      setCronTab('visual');
    } else {
      setCronTab('simple');
    }

    // Integration box (when editing existing schedule)
    const intBox = document.getElementById('sched-integration-box');
    if (s && s.id) {
      intBox?.classList.remove('hidden');
      (document.getElementById('sched-int-id') as HTMLInputElement).value = s.id;
      const tokInput = document.getElementById('sched-int-token') as HTMLInputElement;
      tokInput.value = s.dispatch_token || '';
      tokInput.type = 'password';

      const base = window.location.origin;
      const urlStr = `${base}/api/internal/pinterest/dispatch-due-pin?schedule_id=${encodeURIComponent(s.id)}&dispatch_token=${encodeURIComponent(s.dispatch_token || '')}`;
      (document.getElementById('sched-int-url') as HTMLInputElement).value = urlStr;
    } else {
      intBox?.classList.add('hidden');
    }

    (document.getElementById('schedule-modal') as any)?.showModal?.();
  }

  async function scheduleAction(id: string, act: string) {
    if (act === 'edit') { openScheduleModal(accountSchedules.find((x) => x.id === id)); return; }
    if (act === 'logs') {
      const r = await fetch('/api/schedules/' + id + '/fastcron?view=logs');
      const d = await r.json();
      alert(JSON.stringify(d, null, 2));
      return;
    }
    if (act === 'pause' || act === 'resume') {
      const sched = accountSchedules.find((x) => x.id === id);
      if (!sched?.fastcron_job_id) {
        alert('No FastCron job yet — press Sync Missing first');
        return;
      }
    }
    if (act === 'delete' && !confirm('Delete this schedule?')) return;
    const r = await fetch('/api/schedules/' + id + '/action', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: act }) });
    const d = await r.json();
    if (!r.ok) {
      showFeedbackBanner(d.error || JSON.stringify(d), 'error');
      alert(d.error || JSON.stringify(d));
    } else {
      if (d.remote_error) {
        showFeedbackBanner(`Schedule deleted (remote error: ${d.remote_error}).`, 'info');
      } else {
        showFeedbackBanner(`Schedule action "${act}" completed.`, 'success');
      }
    }
    await loadSchedules();
  }

  let schedulesListenersAttached = false;
  function setupSchedulesListeners() {
    if (schedulesListenersAttached) return;
    schedulesListenersAttached = true;

    // FastCron Token listeners
    document.getElementById('btn-add-token')?.addEventListener('click', openTokenModal);
    document.getElementById('btn-close-token-modal')?.addEventListener('click', closeTokenModal);
    document.getElementById('btn-cancel-token')?.addEventListener('click', closeTokenModal);
    document.getElementById('btn-ping-tokens')?.addEventListener('click', pingFastCronTokens);

    document.getElementById('tokens-table-rows')?.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-token-act]');
      if (!t) return;
      const act = t.getAttribute('data-token-act');
      const tid = t.getAttribute('data-tid');
      const extraVal = t.getAttribute('data-val');
      if (act && (tid || extraVal)) tokenAction(tid || '', act, extraVal || undefined);
    });

    document.getElementById('token-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errBox = document.getElementById('token-modal-error');
      if (errBox) errBox.classList.add('hidden');

      const name = (document.getElementById('f-token-name') as HTMLInputElement).value.trim();
      const token = (document.getElementById('f-token-val') as HTMLInputElement).value.trim();
      const isDefault = (document.getElementById('f-token-default') as HTMLInputElement).checked;

      try {
        const r = await fetch('/api/tokens', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, token, is_default: isDefault }),
        });
        const d = await r.json();
        if (!r.ok) {
          if (errBox) { errBox.textContent = d.error || JSON.stringify(d); errBox.classList.remove('hidden'); }
          return;
        }
        closeTokenModal();
        showFeedbackBanner('FastCron token added to workspace registry.', 'success');
        await loadTokens();
        await loadSchedules();
      } catch (err: any) {
        if (errBox) { errBox.textContent = err.message || 'Network error'; errBox.classList.remove('hidden'); }
      }
    });

    // Tab switcher listeners
    document.getElementById('tab-btn-simple')?.addEventListener('click', () => setCronTab('simple'));
    document.getElementById('tab-btn-visual')?.addEventListener('click', () => setCronTab('visual'));
    document.getElementById('tab-btn-raw')?.addEventListener('click', () => setCronTab('raw'));

    // Visual Cron chips delegation
    document.getElementById('cron-minute-grid')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-cron-m]');
      if (!btn) return;
      const m = Number(btn.getAttribute('data-cron-m'));
      if (visualMinutes.has(m)) visualMinutes.delete(m);
      else visualMinutes.add(m);
      renderVisualCronGrids();
      updateVisualCronPreview();
    });

    document.getElementById('cron-hour-grid')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-cron-h]');
      if (!btn) return;
      const h = Number(btn.getAttribute('data-cron-h'));
      if (visualHours.has(h)) visualHours.delete(h);
      else visualHours.add(h);
      renderVisualCronGrids();
      updateVisualCronPreview();
    });

    document.getElementById('cron-dow-grid')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-cron-dow]');
      if (!btn) return;
      const d = Number(btn.getAttribute('data-cron-dow'));
      if (visualWeekdays.has(d)) visualWeekdays.delete(d);
      else visualWeekdays.add(d);
      renderVisualCronGrids();
      updateVisualCronPreview();
    });

    // Minute presets
    document.querySelectorAll('.btn-min-preset').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const val = (e.currentTarget as HTMLElement).getAttribute('data-preset-min');
        visualMinutes.clear();
        if (val === '5') { for (let i = 0; i < 60; i += 5) visualMinutes.add(i); }
        else if (val === '15') { for (let i = 0; i < 60; i += 15) visualMinutes.add(i); }
        else if (val === '30') { for (let i = 0; i < 60; i += 30) visualMinutes.add(i); }
        else if (val === 'clear') { visualMinutes.add(0); }
        renderVisualCronGrids();
        updateVisualCronPreview();
      });
    });

    // Hour presets
    document.querySelectorAll('.btn-hr-preset').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const val = (e.currentTarget as HTMLElement).getAttribute('data-preset-hr');
        visualHours.clear();
        if (val === 'all') { for (let i = 0; i < 24; i++) visualHours.add(i); }
        else if (val === 'work') { for (let i = 9; i <= 17; i++) visualHours.add(i); }
        else if (val === '2') { for (let i = 0; i < 24; i += 2) visualHours.add(i); }
        renderVisualCronGrids();
        updateVisualCronPreview();
      });
    });

    // Dow presets
    document.querySelectorAll('.btn-dow-preset').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const val = (e.currentTarget as HTMLElement).getAttribute('data-preset-dow');
        visualWeekdays.clear();
        if (val === 'weekdays') { [1, 2, 3, 4, 5].forEach(i => visualWeekdays.add(i)); }
        else if (val === 'weekends') { [6, 0].forEach(i => visualWeekdays.add(i)); }
        else if (val === 'all') { [0, 1, 2, 3, 4, 5, 6].forEach(i => visualWeekdays.add(i)); }
        renderVisualCronGrids();
        updateVisualCronPreview();
      });
    });

    document.getElementById('f-raw-cron')?.addEventListener('input', updateRawCronPreview);

    // Schedule modal token select handler
    document.getElementById('f-sched-token-select')?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      const customBox = document.getElementById('f-sched-custom-token-box');
      if (val === 'custom') {
        customBox?.classList.remove('hidden');
      } else {
        customBox?.classList.add('hidden');
      }
    });

    // Schedule modal interval preset handler
    document.getElementById('f-sched-interval-preset')?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      const customContainer = document.getElementById('f-sched-custom-interval-container');
      if (val === 'custom') {
        customContainer?.classList.remove('hidden');
      } else {
        customContainer?.classList.add('hidden');
      }
      updateSchedCadence();
    });

    document.getElementById('btn-refresh-schedules')?.addEventListener('click', () => loadSchedules());
    document.getElementById('btn-sync-missing')?.addEventListener('click', async () => {
      const r = await fetch('/api/schedules/sync-missing', { method: 'POST' });
      const d = await r.json();
      if (!r.ok) {
        showFeedbackBanner(d.error || JSON.stringify(d), 'error');
        alert(d.error || JSON.stringify(d));
      } else {
        showFeedbackBanner('Sync completed.', 'success');
        alert(JSON.stringify(d));
      }
      await loadSchedules();
    });

    // Batch dropdown handlers
    const batchBtn = document.getElementById('btn-sched-batch');
    const batchMenu = document.getElementById('sched-batch-menu');
    batchBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (selectedScheduleIds.size === 0) return;
      batchMenu?.classList.toggle('hidden');
    });
    document.addEventListener('click', () => batchMenu?.classList.add('hidden'));
    updateBatchButtonState();

    document.getElementById('batch-act-select-page')?.addEventListener('click', () => {
      document.querySelectorAll('.sched-row-chk').forEach(c => {
        (c as HTMLInputElement).checked = true;
        const id = (c as HTMLInputElement).getAttribute('data-id');
        if (id) selectedScheduleIds.add(id);
      });
      updateBatchButtonState();
      batchMenu?.classList.add('hidden');
    });

    document.getElementById('batch-act-select-all')?.addEventListener('click', () => {
      accountSchedules.forEach(s => selectedScheduleIds.add(s.id));
      document.querySelectorAll('.sched-row-chk').forEach(c => (c as HTMLInputElement).checked = true);
      updateBatchButtonState();
      batchMenu?.classList.add('hidden');
    });

    document.getElementById('batch-act-edit')?.addEventListener('click', () => {
      batchMenu?.classList.add('hidden');
      if (selectedScheduleIds.size === 1) {
        const id = Array.from(selectedScheduleIds)[0];
        const s = accountSchedules.find(x => x.id === id);
        if (s) openScheduleModal(s);
      }
    });

    document.getElementById('batch-act-run')?.addEventListener('click', () => { batchMenu?.classList.add('hidden'); executeBatchAction('run'); });
    document.getElementById('batch-act-enable')?.addEventListener('click', () => { batchMenu?.classList.add('hidden'); executeBatchAction('resume'); });
    document.getElementById('batch-act-disable')?.addEventListener('click', () => { batchMenu?.classList.add('hidden'); executeBatchAction('pause'); });
    document.getElementById('batch-act-delete')?.addEventListener('click', () => { batchMenu?.classList.add('hidden'); executeBatchAction('delete'); });
    document.getElementById('batch-act-export')?.addEventListener('click', () => { batchMenu?.classList.add('hidden'); executeBatchAction('export'); });

    // Table checkbox selection
    document.getElementById('sched-select-all-header')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      document.querySelectorAll('.sched-row-chk').forEach(c => {
        (c as HTMLInputElement).checked = checked;
        const id = (c as HTMLInputElement).getAttribute('data-id');
        if (id) {
          if (checked) selectedScheduleIds.add(id);
          else selectedScheduleIds.delete(id);
        }
      });
      updateBatchButtonState();
    });

    document.getElementById('account-schedules-rows')?.addEventListener('change', (e) => {
      const chk = (e.target as HTMLElement).closest('.sched-row-chk') as HTMLInputElement | null;
      if (chk) {
        const id = chk.getAttribute('data-id');
        if (id) {
          if (chk.checked) selectedScheduleIds.add(id);
          else selectedScheduleIds.delete(id);
          updateBatchButtonState();
        }
      }
    });

    document.getElementById('btn-add-schedule')?.addEventListener('click', () => openScheduleModal());
    document.getElementById('btn-close-sched-modal')?.addEventListener('click', () => (document.getElementById('schedule-modal') as any)?.close?.());
    document.getElementById('btn-cancel-sched')?.addEventListener('click', () => (document.getElementById('schedule-modal') as any)?.close?.());

    ['f-sched-interval', 'f-sched-start', 'f-sched-end', 'f-sched-tz'].forEach((iv) =>
      document.getElementById(iv)?.addEventListener('input', () => {
        updateSchedCadence();
        if (currentCronTab === 'visual') updateVisualCronPreview();
        if (currentCronTab === 'raw') updateRawCronPreview();
      })
    );

    // Integration box reveal and copy buttons
    document.getElementById('btn-toggle-reveal-token')?.addEventListener('click', () => {
      const input = document.getElementById('sched-int-token') as HTMLInputElement;
      const btn = document.getElementById('btn-toggle-reveal-token');
      if (input.type === 'password') {
        input.type = 'text';
        if (btn) btn.textContent = 'Hide';
      } else {
        input.type = 'password';
        if (btn) btn.textContent = 'Reveal';
      }
    });

    document.getElementById('btn-copy-sched-id')?.addEventListener('click', () => {
      const val = (document.getElementById('sched-int-id') as HTMLInputElement).value;
      if (val) { navigator.clipboard.writeText(val); showFeedbackBanner('Schedule ID copied to clipboard.', 'success'); }
    });

    document.getElementById('btn-copy-sched-token')?.addEventListener('click', () => {
      const val = (document.getElementById('sched-int-token') as HTMLInputElement).value;
      if (val) { navigator.clipboard.writeText(val); showFeedbackBanner('Dispatch token copied to clipboard.', 'success'); }
    });

    document.getElementById('btn-copy-sched-url')?.addEventListener('click', () => {
      const val = (document.getElementById('sched-int-url') as HTMLInputElement).value;
      if (val) { navigator.clipboard.writeText(val); showFeedbackBanner('Webhook dispatch URL copied to clipboard.', 'success'); }
    });

    document.getElementById('schedule-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = (document.getElementById('f-sched-id') as HTMLInputElement).value;
      const tokenSelectVal = (document.getElementById('f-sched-token-select') as HTMLSelectElement).value;
      const fcToken = (document.getElementById('f-fc-token') as HTMLInputElement).value.trim();

      const presetVal = (document.getElementById('f-sched-interval-preset') as HTMLSelectElement).value;
      const intervalMinutes = presetVal === 'custom'
        ? Number((document.getElementById('f-sched-interval') as HTMLInputElement).value || 36)
        : Number(presetVal || 36);

      const checkedDays: string[] = [];
      document.querySelectorAll('.f-sched-day-chk:checked').forEach((chk) => {
        checkedDays.push((chk as HTMLInputElement).value);
      });

      let finalCronExpression: string | null = null;
      if (currentCronTab === 'visual') {
        finalCronExpression = getVisualCronExpression();
      } else if (currentCronTab === 'raw') {
        finalCronExpression = (document.getElementById('f-raw-cron') as HTMLTextAreaElement).value.trim() || null;
      }

      const body: Record<string, any> = {
        account_id: accountId,
        label: (document.getElementById('f-sched-label') as HTMLInputElement).value,
        webhook_id: (document.getElementById('f-channel') as HTMLSelectElement).value || null,
        timezone: (document.getElementById('f-sched-tz') as HTMLInputElement).value,
        batch: Number((document.getElementById('f-sched-batch') as HTMLInputElement).value || 1),
        window_start: (document.getElementById('f-sched-start') as HTMLInputElement).value,
        window_end: (document.getElementById('f-sched-end') as HTMLInputElement).value,
        interval_minutes: intervalMinutes,
        random_delay_minutes: Number((document.getElementById('f-sched-delay') as HTMLInputElement).value || 0),
        active_days: checkedDays.length > 0 ? checkedDays : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
        started_at: (document.getElementById('f-sched-started') as HTMLInputElement).value || null,
        cron_expression: finalCronExpression,
      };

      if (tokenSelectVal === 'custom') {
        if (fcToken.length > 0) body.fastcron_token = fcToken;
        body.fastcron_token_id = null;
      } else if (tokenSelectVal) {
        body.fastcron_token_id = tokenSelectVal;
        body.fastcron_token = null;
      } else {
        body.fastcron_token_id = null;
        body.fastcron_token = null;
      }

      const r = id
        ? await fetch('/api/schedules/' + id, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        : await fetch('/api/schedules', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const d = await r.json();
      if (!r.ok) {
        showFeedbackBanner(d.error || JSON.stringify(d), 'error');
        alert(d.error || JSON.stringify(d));
        return;
      }
      (document.getElementById('schedule-modal') as any)?.close?.();
      showFeedbackBanner(id ? 'Posting schedule updated.' : 'Posting schedule created.', 'success');
      await loadSchedules();
    });

    document.getElementById('account-schedules-rows')?.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      if (select && select.classList.contains('sched-action-select')) {
        const sid = select.getAttribute('data-sid');
        const act = select.value;
        select.value = '';
        if (sid && act) scheduleAction(sid, act);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', init);
</script>
