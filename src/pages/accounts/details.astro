  function renderScheduling(acc: Account) {
    const startedElem = document.getElementById('sched-started-at');
    const windowElem = document.getElementById('sched-posting-window');
    const intervalElem = document.getElementById('sched-posting-interval');
    const delayElem = document.getElementById('sched-random-delay');
    const tzElem = document.getElementById('sched-timezone');
    const lastPubElem = document.getElementById('sched-last-published');
    const activeDaysElem = document.getElementById('sched-active-days');
    const paceValElem = document.getElementById('sched-pace-val');
    const paceDescElem = document.getElementById('sched-pace-desc');

    const tz = acc.timezone || 'Europe/London';
    const now = new Date();

    // 1. Timezone Clock Calculation
    let targetTimeStr = '';
    let offsetStr = '';
    let currentDayStr = 'Mon';
    try {
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
        weekday: 'short',
      });
      const parts = formatter.formatToParts(now);
      const hourPart = parts.find((p) => p.type === 'hour')?.value || '12';
      const minPart = parts.find((p) => p.type === 'minute')?.value || '00';
      const dayPeriod = parts.find((p) => p.type === 'dayPeriod')?.value || 'AM';
      currentDayStr = parts.find((p) => p.type === 'weekday')?.value || 'Mon';
      targetTimeStr = `${hourPart}:${minPart} ${dayPeriod}`;

      const tzFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        timeZoneName: 'short',
      });
      const tzParts = tzFormatter.formatToParts(now);
      const tzName = tzParts.find((p) => p.type === 'timeZoneName')?.value || '';
      offsetStr = tzName ? ` (${tzName})` : '';
    } catch (e) {
      targetTimeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    if (tzElem) {
      tzElem.textContent = `${tz}${offsetStr} • ${targetTimeStr}`;
    }

    // Use shared helpers
    const activeDays = parseActiveDays(acc.active_days);
    const windowDurationMins = calcWindowMins(acc.posting_window_start || '09:00', acc.posting_window_end || '21:00');
    const windowHours = (windowDurationMins / 60).toFixed(1).replace(/\.0$/, '');

    const rawStart = acc.posting_window_start || '09:00';
    const rawEnd = acc.posting_window_end || '21:00';
    const startStr = rawStart.slice(0, 5);
    const endStr = rawEnd.slice(0, 5);

    const [startH, startM] = startStr.split(':').map(Number);
    const [endH, endM] = endStr.split(':').map(Number);
    const startTotalMins = (startH || 0) * 60 + (startM || 0);
    const endTotalMins = (endH || 0) * 60 + (endM || 0);

    const isDayActive = activeDays.includes(currentDayStr);

    if (activeDaysElem) {
      const allWeekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
      activeDaysElem.innerHTML = allWeekdays
        .map((day) => {
          const isActive = activeDays.includes(day);
          return `<span class="inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-bold ${
            isActive
              ? 'bg-primary/10 border border-primary/20 text-primary'
              : 'bg-muted/50 border border-border text-muted-foreground line-through opacity-50'
          }">${day}</span>`;
        })
        .join('');
    }

    if (windowElem) {
      windowElem.textContent = `${startStr} — ${endStr} (${windowHours} hrs)`;
    }

    // Window status
    let nowMinutes = 0;
    try {
      const nowFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        hour: 'numeric',
        minute: 'numeric',
        hour12: false,
      });
      const nowParts = nowFormatter.formatToParts(now);
      const nowH = parseInt(nowParts.find((p) => p.type === 'hour')?.value || '0', 10);
      const nowM = parseInt(nowParts.find((p) => p.type === 'minute')?.value || '0', 10);
      nowMinutes = nowH * 60 + nowM;
    } catch (e) {
      nowMinutes = now.getHours() * 60 + now.getMinutes();
    }

    let isInWindow = false;
    if (startTotalMins <= endTotalMins) {
      isInWindow = nowMinutes >= startTotalMins && nowMinutes <= endTotalMins;
    } else {
      isInWindow = nowMinutes >= startTotalMins || nowMinutes <= endTotalMins;
    }



    // 5. Cadence Pace Analyzer & Quick Auto-Adjust Action
    const maxDaily = acc.max_pins_per_day || 20;
    const optimalPaceMins = Math.max(1, Math.round(windowDurationMins / maxDaily));
    const configuredInterval = acc.posting_interval_minutes || 30;
    const isTooFast = configuredInterval < optimalPaceMins && maxDaily < 100;

    if (startedElem) {
      startedElem.textContent = acc.pinning_started_at ? formatDate(acc.pinning_started_at) : 'Not configured';
    }
    if (intervalElem) {
      intervalElem.textContent = configuredInterval >= 60 ? `Every ${configuredInterval / 60} ${configuredInterval === 60 ? 'hour' : 'hours'}` : `Every ${configuredInterval} mins`;
    }
    if (delayElem) {
      delayElem.textContent = `${acc.random_delay_minutes || 0} mins`;
    }
    if (lastPubElem) {
      lastPubElem.textContent = acc.last_published_at ? formatDate(acc.last_published_at) : 'No published pins yet';
    }

    if (paceValElem) {
      paceValElem.textContent = `1 pin / ${optimalPaceMins}m optimal pacing`;
    }
    if (paceDescElem) {
      paceDescElem.innerHTML = `
        <span class="block">At limit of ${maxDaily} pins/day across ${windowHours}h window, optimal interval is ~1 pin every ${optimalPaceMins} mins (Configured: ${configuredInterval}m).</span>
        ${isTooFast ? `
          <div class="mt-2.5 pt-2 border-t border-primary/20 flex flex-wrap items-center justify-between gap-2">
            <span class="text-[11px] text-amber-600 dark:text-amber-400 font-semibold flex items-center gap-1">
              ⚠️ Rapid Interval Notice: All ${maxDaily} daily pins will post in ~${configuredInterval * maxDaily} mins.
            </span>
            <button id="btn-apply-optimal-pacing" data-optimal="${optimalPaceMins}" class="inline-flex items-center gap-1 rounded-lg bg-primary px-2.5 py-1 text-xs font-bold text-primary-foreground shadow hover:bg-primary/90 transition-all">
              ⚡ Auto-Set to ${optimalPaceMins} mins
            </button>
          </div>
        ` : ''}
      `;

      // Emit a data attribute so setupModalListeners can delegate the click once
      // (button HTML is already rendered inline above via paceDescElem.innerHTML)
    }
  } // end renderScheduling

  function renderWebhookSummary(sum: any) {
    const channelsElem = document.getElementById('wh-sum-channels');
    const primaryElem = document.getElementById('wh-sum-primary');
    const countElem = document.getElementById('wh-sum-capacity-count');
    const barElem = document.getElementById('wh-sum-capacity-bar');

    if (channelsElem) {
      channelsElem.textContent = `${sum.activeWebhooks} Active of ${sum.totalWebhooks} Total`;
    }
    if (primaryElem) {
      primaryElem.innerHTML = `<span class="font-bold text-foreground">${escapeHtml(sum.primaryWebhookLabel || 'None')}</span> <span class="text-[10px] font-normal text-muted-foreground">• Primary Channel</span>`;
    }
    if (countElem) {
      countElem.textContent = `${sum.totalRemainingCapacity} pins remaining`;
    }
    if (barElem) {
      const pct = Math.min(100, Math.round((sum.totalRemainingCapacity / 1500) * 100));
      barElem.style.width = `${pct}%`;
    }

    document.getElementById('btn-test-webhook-ping')?.removeEventListener('click', () => {});
    // Listener is registered once in setupModalListeners() via delegation
  }

  function renderRecentPins(pins: Pin[], totalCount: number = 0) {
    const container = document.getElementById('account-pins-container');
    const resultCountElem = document.getElementById('pin-result-count');
    const queueBadge = document.getElementById('pin-queue-count-badge');

    if (resultCountElem) {
      resultCountElem.textContent = `Showing ${pins.length} of ${totalCount} pins`;
    }
    if (queueBadge) {
      queueBadge.textContent = String(totalCount);
    }

    if (!container) return;

    if (!pins || pins.length === 0) {
      const isFiltered = filterStatus !== 'all' || filterBoard !== 'all' || filterSearch !== '' || filterDateFrom !== '' || filterDateTo !== '';
      container.innerHTML = renderEmptyStateHTML(
        isFiltered ? 'No Pins Match Filters' : 'No Pins Found for Account',
        isFiltered ? 'Try clearing or broadening your search filters.' : 'Import scheduled posts to populate this account queue.',
        'inbox'
      );
      return;
    }

    const rowsHtml = pins
      .map(
        (pin) => `
        <tr class="transition-colors hover:bg-muted/40 text-xs">
          <td class="px-5 py-3 font-medium text-foreground">
            <div class="flex items-center gap-3">
              <img src="${escapeHtml(pin.image_url)}" alt="" class="h-9 w-9 rounded-lg object-cover border border-border bg-muted flex-shrink-0" onerror="this.src='https://images.unsplash.com/photo-1495521821757-a1efb6729352?auto=format&fit=crop&w=150&q=80'" />
              <div class="space-y-0.5">
                <p class="max-w-xs font-semibold truncate text-foreground" title="${escapeHtml(pin.title)}">${escapeHtml(pin.title)}</p>
                ${pin.description ? `<p class="max-w-xs truncate text-[11px] text-muted-foreground">${escapeHtml(pin.description)}</p>` : ''}
              </div>
            </div>
          </td>
          <td class="px-5 py-3 text-muted-foreground">${escapeHtml(pin.board_name || 'No board')}</td>
          <td class="px-5 py-3">${renderPinStatusBadgeWithRetry(pin)}</td>
          <td class="px-5 py-3 text-muted-foreground font-mono text-[11px]">${pin.retry_count || 0}/${pin.max_retries || 3}</td>
          <td class="px-5 py-3 text-muted-foreground whitespace-nowrap">${pin.scheduled_for ? formatDate(pin.scheduled_for) : '-'}</td>
          <td class="px-5 py-3 text-muted-foreground whitespace-nowrap">${pin.posted_at ? formatDate(pin.posted_at) : formatDate(pin.created_at)}</td>
        </tr>
      `
      )
      .join('');

    container.innerHTML = `
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead class="border-b border-border bg-muted/50 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
              <tr>
                <th class="px-5 py-3">Pin Title</th>
                <th class="px-5 py-3">Target Board</th>
                <th class="px-5 py-3">Status</th>
                <th class="px-5 py-3">Attempts</th>
                <th class="px-5 py-3">Scheduled For</th>
                <th class="px-5 py-3">Posted / Created</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              ${rowsHtml}
            </tbody>
          </table>
        </div>
      </div>
    `;
  }

  function renderRecentLogs(logs: Log[]) {
    const container = document.getElementById('account-logs-container');
    if (!container) return;

    if (!logs || logs.length === 0) {
      container.innerHTML = renderEmptyStateHTML(
        'No Logs Recorded',
        'Automation execution attempts will record webhook logs here.',
        'alert-circle'
      );
      return;
    }

    const rowsHtml = logs
      .map(
        (log) => `
        <tr class="transition-colors hover:bg-muted/40 text-xs">
          <td class="px-5 py-3">${renderStatusBadge(log.status)}</td>
          <td class="px-5 py-3 font-medium text-foreground max-w-md truncate" title="${escapeHtml(log.message || '')}">${escapeHtml(log.message || 'Execution completed.')}</td>
          <td class="px-5 py-3 text-muted-foreground font-mono text-[11px]">${log.webhook_label ? escapeHtml(log.webhook_label) : 'System Hook'}</td>
          <td class="px-5 py-3 text-muted-foreground whitespace-nowrap">${formatDate(log.created_at)}</td>
        </tr>
      `
      )
      .join('');

    container.innerHTML = `
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
