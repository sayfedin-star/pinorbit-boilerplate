---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import KPIStatCard from '../../components/ui/KPIStatCard.astro';
import RunNowButton from '../../components/cron/RunNowButton.astro';
---

<Layout title="Manage Account Details" description="Detailed operational, scheduling, and activity control center for Pinterest account.">
  <!-- Back Link & Breadcrumb -->
  <div class="mb-4 flex items-center justify-between">
    <a href="/accounts" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      <span>&larr; Back to Accounts</span>
    </a>
    <span class="text-xs text-muted-foreground font-mono">Account ID: <span id="display-account-id">---</span></span>
  </div>

  <!-- Global Feedback Banner -->
  <div id="account-feedback-banner" class="hidden mb-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span id="account-feedback-text">Account updated successfully.</span>
    </div>
    <button id="close-account-feedback" class="font-bold opacity-70 hover:opacity-100">&times;</button>
  </div>

  <!-- Header Control Card -->
  <div class="mb-6 rounded-2xl border border-border bg-card p-6 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <!-- Dynamic: account name, status, ID -->
      <div id="account-header-info" class="animate-pulse flex items-center gap-3.5">
        <div class="h-12 w-12 rounded-2xl bg-muted flex-shrink-0"></div>
        <div class="space-y-2">
          <div class="h-6 w-40 rounded-lg bg-muted"></div>
          <div class="h-4 w-56 rounded-lg bg-muted"></div>
        </div>
      </div>
      <!-- Static: action buttons always in DOM -->
      <div id="account-header-actions" class="flex flex-wrap items-center gap-2.5">
        <button
          id="btn-open-create-board-modal"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Create Board</span>
        </button>
        <button
          id="btn-refresh-boards"
          class="inline-flex items-center gap-1 rounded-xl border border-border bg-background px-3 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          <span>Refresh List</span>
        </button>
        <!-- Per-Account Shortcut Buttons -->
        <a
          id="btn-header-boards"
          href="/accounts/boards"
          class="inline-flex items-center gap-1.5 rounded-xl border border-indigo-500/30 bg-indigo-500/10 px-3 py-2 text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:bg-indigo-500/20 transition-all shadow-sm"
          title="Manage boards for this account"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L8.6 3.3A2 2 0 0 0 6.9 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
          <span id="btn-header-boards-label">Boards (0)</span>
        </a>
        <a
          id="btn-header-pins"
          href="/accounts/pins"
          class="inline-flex items-center gap-1.5 rounded-xl border border-pink-500/30 bg-pink-500/10 px-3 py-2 text-xs font-semibold text-pink-600 dark:text-pink-400 hover:bg-pink-500/20 transition-all shadow-sm"
          title="View and filter pins queue for this account"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-pink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <span>Pins Queue</span>
        </a>
        <a
          id="btn-header-pipeline-kit"
          href="/accounts/board-pipeline"
          class="inline-flex items-center gap-1.5 rounded-xl border border-primary/30 bg-primary/10 px-3 py-2 text-xs font-semibold text-primary hover:bg-primary/20 transition-all shadow-sm"
          title="Open Make.com Board Pipeline Scenario Kit"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Board Pipeline Kit &rarr;</span>
        </a>
        <a
          id="btn-import-posts"
          href="/imports"
          class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white shadow hover:bg-emerald-700 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span>+ Import Posts</span>
        </a>
        <button
          id="btn-edit-limit"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          <span id="btn-edit-limit-label">Limit: --/day</span>
        </button>
        <button
          id="btn-toggle-active"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground hover:opacity-80 transition-all"
        >
          <span id="btn-toggle-active-label">Activate</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Section 1: Overview KPI Cards (8 Grid Items) -->
  <div class="mb-8 space-y-3">
    <h3 class="text-sm font-bold text-foreground tracking-wide uppercase">Operational Overview & Metrics</h3>
    <div id="kpis-grid-container" class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
      <div class="rounded-xl border border-border bg-card p-4 text-center animate-pulse"><div class="h-6 w-12 bg-muted mx-auto rounded"></div></div>
    </div>
  </div>

  <!-- SIDE-BY-SIDE SPLIT SECTION (Webhooks 65% / FastCron API Tokens 35%) -->
  <div class="mb-8 flex flex-col lg:flex-row items-stretch gap-6">
    <!-- LEFT PANEL (65% width) - Webhook Orchestration Table -->
    <div class="w-full lg:w-[65%] rounded-2xl border border-border bg-card p-5 shadow-sm flex flex-col justify-between space-y-4">
      <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between border-b border-border pb-3 gap-3">
          <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-foreground">Webhook Orchestration Summary</h3>
              <p class="text-xs text-muted-foreground">Channel capacities, fallback priority & execution stats</p>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <!-- Board Channel Select -->
            <div class="flex items-center gap-1.5 bg-muted/60 border border-border px-2 py-1 rounded-lg">
              <label for="select-board-channel" class="text-[11px] font-semibold text-muted-foreground whitespace-nowrap">Board Channel (create/list/delete):</label>
              <select id="select-board-channel" class="rounded border border-border bg-background py-0.5 px-2 text-[11px] font-medium text-foreground focus:border-primary focus:outline-none max-w-[170px] cursor-pointer">
                <option value="">Auto (First Active)</option>
              </select>
            </div>

            <a
              id="btn-board-pipeline-kit"
              href="/accounts/board-pipeline"
              class="inline-flex items-center gap-1 rounded-lg border border-indigo-500/30 bg-indigo-500/10 px-2.5 py-1.5 text-xs font-semibold text-indigo-500 hover:bg-indigo-500/20 transition-all shadow-sm"
              title="Open Make.com Board Pipeline Scenario Kit"
            >
              <span>Board Pipeline Kit &rarr;</span>
            </a>

            <button
              type="button"
              id="btn-test-ping-all-webhooks"
              class="inline-flex items-center gap-1 rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm"
              title="Test ping all active webhook channels"
            >
              <span>⚡ Test Ping All</span>
            </button>
            <button
              type="button"
              id="open-webhooks-modal-btn"
              class="inline-flex items-center gap-1 rounded-lg bg-primary px-2.5 py-1.5 text-xs font-semibold text-primary-foreground hover:bg-primary/90 transition-all shadow-sm"
            >
              <span>+ Add Webhook</span>
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="text-left border-b border-border text-muted-foreground">
                <th class="p-2.5 font-semibold">WEBHOOK NAME & CHANNEL</th>
                <th class="p-2.5 font-semibold">TARGET ENDPOINT</th>
                <th class="p-2.5 font-semibold">EXECUTIONS / RUNS</th>
                <th class="p-2.5 font-semibold">HEALTH / STATUS</th>
                <th class="p-2.5 font-semibold text-right">ACTIONS</th>
              </tr>
            </thead>
            <tbody id="webhook-orchestration-rows">
              <tr><td colspan="5" class="p-4 text-center text-muted-foreground">Loading webhook channels...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Table Footer: Total Combined Capacity Summary Bar -->
      <div id="webhook-combined-footer" class="pt-3 border-t border-border space-y-1.5">
        <div class="flex items-center justify-between text-xs">
          <span class="font-semibold text-muted-foreground">Total Orchestrated Capacity</span>
          <span id="wh-combined-capacity" class="font-mono font-bold text-foreground">Combined: 0 / 0 runs remaining</span>
        </div>
        <div class="h-2 w-full rounded-full bg-muted overflow-hidden">
          <div id="wh-combined-capacity-bar" class="h-full rounded-full bg-primary transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <!-- RIGHT PANEL (35% width) - FastCron API Tokens -->
    <div class="w-full lg:w-[35%] rounded-2xl border border-border bg-card p-5 shadow-sm flex flex-col justify-between space-y-4">
      <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between border-b border-border pb-3 gap-3">
          <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-foreground">FastCron API Tokens</h3>
              <p class="text-xs text-muted-foreground">Workspace token registry</p>
            </div>
          </div>
          <button id="btn-add-token" class="inline-flex items-center gap-1 rounded-lg bg-primary px-2.5 py-1.5 text-xs font-semibold text-primary-foreground hover:bg-primary/90 transition-all shadow-sm">
            + Add Token
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="text-left border-b border-border text-muted-foreground">
                <th class="p-2 font-semibold">TOKEN NAME</th>
                <th class="p-2 font-semibold">MASKED KEY</th>
                <th class="p-2 font-semibold">STATUS</th>
                <th class="p-2 font-semibold text-right">ACTIONS</th>
              </tr>
            </thead>
            <tbody id="tokens-table-rows"></tbody>
          </table>
        </div>
      </div>

      <!-- Bottom tip: Subtle info banner showing connection health with FastCron API -->
      <div class="pt-3 border-t border-border flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs text-emerald-500 font-medium">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          <span id="fc-connection-status">✓ Connection healthy</span>
        </div>
        <button type="button" id="btn-ping-tokens" class="text-xs text-primary hover:underline font-medium">Test Connection</button>
      </div>
    </div>
  </div>

  <!-- Section: Posting Schedules & Automation -->
  <div class="mb-8 rounded-2xl border border-border bg-card p-5 shadow-sm space-y-4">
    <div class="flex flex-wrap items-center justify-between border-b border-border pb-3 gap-3">
      <div class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-pink-500/10 text-pink-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-foreground">Posting Schedules & Automation</h3>
          <p class="text-xs text-muted-foreground">Manage multi-schedule posting engine for this account</p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <RunNowButton
          endpoint="/api/accounts/run-now"
          label="Run Now"
          forceLabel="⚡ Force Run"
          size="sm"
          variant="emerald"
          buttonId="account-details-run-now"
          payload={{ account_id: "" }}
          scope="account-schedules"
        />
        <button id="btn-add-schedule" class="inline-flex items-center gap-1 rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground hover:bg-primary/90 transition-all shadow-sm">+ New</button>
        
        <!-- Batch Dropdown -->
        <div class="relative inline-block text-left" id="batch-dropdown-container">
          <button id="btn-sched-batch" type="button" class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-background px-3 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm">
            <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <span>Batch</span>
            <span id="batch-sel-count" class="hidden rounded-full bg-primary/20 text-primary px-1.5 py-0.2 text-[10px] font-bold">0</span>
            <svg class="h-3 w-3 text-muted-foreground ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="sched-batch-menu" class="hidden absolute left-0 mt-1 w-56 rounded-xl border border-border bg-card shadow-xl z-50 py-1 text-xs divide-y divide-border">
            <div class="py-1">
              <button type="button" id="batch-act-select-page" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-foreground">
                <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span id="batch-txt-select-page">Select all on page</span>
              </button>
              <button type="button" id="batch-act-select-all" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-foreground">
                <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                <span>Select all in account</span>
              </button>
            </div>
            <div class="py-1">
              <button type="button" id="batch-act-edit" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-foreground">
                <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span>Edit</span>
              </button>
              <button type="button" id="batch-act-run" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-foreground">
                <svg class="h-3.5 w-3.5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <span>Run</span>
              </button>
            </div>
            <div class="py-1">
              <button type="button" id="batch-act-enable" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Enable</span>
              </button>
              <button type="button" id="batch-act-disable" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-amber-600 dark:text-amber-400">
                <svg class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                <span>Disable</span>
              </button>
            </div>
            <div class="py-1">
              <button type="button" id="batch-act-delete" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-rose-500 font-semibold">
                <svg class="h-3.5 w-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                <span>Delete</span>
              </button>
            </div>
            <div class="py-1">
              <button type="button" id="batch-act-export" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-foreground">
                <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Export</span>
              </button>
            </div>
          </div>
        </div>

