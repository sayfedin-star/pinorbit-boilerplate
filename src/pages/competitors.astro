            <input id="edit-niche-input" type="text" class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
          </div>
          <div class="space-y-1.5">
            <label for="edit-tags-input" class="block text-xs font-semibold text-foreground">Tags (Comma-Separated)</label>
            <input id="edit-tags-input" type="text" class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
