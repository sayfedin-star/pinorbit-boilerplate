    <div class="fixed inset-0" data-close></div>
    <div class="relative w-full max-w-sm rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-4 z-10">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-rose-500/10 text-rose-500"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
        <h3 id="confirm-title" class="text-sm font-bold text-foreground">Are you sure?</h3>
      </div>
      <p id="confirm-message" class="text-xs text-muted-foreground"></p>
