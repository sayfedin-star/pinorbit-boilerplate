    showOverlay($('add-competitor-modal'));
  }

  function setAddModalTab(mode: 'single' | 'bulk') {
    if (mode === 'single') {
      modalTabSingle.className = 'flex-1 py-1.5 text-xs font-bold rounded-lg bg-background text-foreground shadow-2xs transition-all';
      modalTabBulk.className = 'flex-1 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all';
      singleForm.classList.remove('hidden');
      bulkForm.classList.add('hidden');
    } else {
      modalTabBulk.className = 'flex-1 py-1.5 text-xs font-bold rounded-lg bg-background text-foreground shadow-2xs transition-all';
      modalTabSingle.className = 'flex-1 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all';
      bulkForm.classList.remove('hidden');
      singleForm.classList.add('hidden');
    }
  }

  modalTabSingle?.addEventListener('click', () => setAddModalTab('single'));
  modalTabBulk?.addEventListener('click', () => setAddModalTab('bulk'));
  $('open-add-competitor-modal').addEventListener('click', () => openAddModal('single'));

  function extractUsernamesFromText(text: string): string[] {
    const raw = text.split(/[\n,;]+/).map(line => cleanPinterestUsername(line)).filter(Boolean);
    return Array.from(new Set(raw));
  }

  function updateBulkDetection() {
    if (!bulkTextarea || !bulkDetectedCount || !addBulkSubmitBtn) return;
    const usernames = extractUsernamesFromText(bulkTextarea.value);
    const count = usernames.length;
    bulkDetectedCount.textContent = `${count} ${count === 1 ? 'profile' : 'profiles'} detected`;
    addBulkSubmitBtn.textContent = `Track ${count} ${count === 1 ? 'Profile' : 'Profiles'} Now`;
    addBulkSubmitBtn.disabled = count === 0;
  }

  bulkTextarea?.addEventListener('input', updateBulkDetection);

  // Single Add Submit
  singleForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const typeRadio = document.querySelector<HTMLInputElement>('input[name="account_type_radio"]:checked');
    const rawU = ($('competitor-username-input') as HTMLInputElement).value;
    const u = cleanPinterestUsername(rawU);
    const niche = ($('competitor-niche-input') as HTMLInputElement).value.trim();
    const tags = ($('competitor-tags-input') as HTMLInputElement).value.trim();
    const notes = ($('competitor-notes-input') as HTMLTextAreaElement).value.trim();

    try {
      await addCompetitor({
        username: u, niche, notes, tags,
        account_type: (typeRadio?.value as any) || 'competitor',
      });
      hideOverlay($('add-competitor-modal'));
      toast(`Started tracking @${u}!`);
      await loadWorkspaceData();
    } catch (err: any) {
      const er = $('add-competitor-error');
      er.textContent = err.message || 'Failed to add profile';
      er.classList.remove('hidden');
    }
  });

  // Bulk Add Submit
  bulkForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const typeRadio = document.querySelector<HTMLInputElement>('input[name="bulk_account_type_radio"]:checked');
    const usernames = extractUsernamesFromText(bulkTextarea.value);
    const niche = ($('bulk-niche-input') as HTMLInputElement).value.trim();
    const rawTags = ($('bulk-tags-input') as HTMLInputElement).value.trim();
    const tags = rawTags.split(',').map(t => t.trim()).filter(Boolean);
    const account_type = (typeRadio?.value as any) || 'competitor';

    if (usernames.length === 0) {
      const er = $('add-competitor-error');
      er.textContent = 'Please enter at least one valid username or URL';
      er.classList.remove('hidden');
      return;
    }

    addBulkSubmitBtn.disabled = true;
    addBulkSubmitBtn.textContent = 'Importing profiles…';

    try {
      const res = await addBulkCompetitors({
        competitors: usernames.map(u => ({ username: u, niche, tags, account_type })),
        niche, tags, account_type,
      });

      hideOverlay($('add-competitor-modal'));
      toast(`Successfully added ${res.count || usernames.length} profiles to tracking!`);
      await loadWorkspaceData();
    } catch (err: any) {
      const er = $('add-competitor-error');
      er.textContent = err.message || 'Failed to bulk import profiles';
      er.classList.remove('hidden');
    } finally {
      addBulkSubmitBtn.disabled = false;
      updateBulkDetection();
    }
  });

  // ─── Edit profile modal ───────────────────────────────────────────────────
  function openEditModal(id: string) {
    const c = competitorsList.find(x => x.id === id);
    if (!c) return;
    $('edit-competitor-error').classList.add('hidden');
    ($('edit-competitor-id') as HTMLInputElement).value = id;
    ($('edit-fullname-input') as HTMLInputElement).value = c.full_name || '';
    ($('edit-username-input') as HTMLInputElement).value = c.username || '';
    ($('edit-niche-input') as HTMLInputElement).value = c.niche || '';
    ($('edit-tags-input') as HTMLInputElement).value = Array.isArray(c.tags) ? c.tags.join(', ') : '';
    document.querySelectorAll<HTMLInputElement>('input[name="edit_account_type_radio"]').forEach(r => {
      r.checked = r.value === (c.account_type === 'own' ? 'own' : 'competitor');
    });
    showOverlay($('edit-competitor-modal'));
  }

  $('edit-competitor-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = ($('edit-competitor-id') as HTMLInputElement).value;
    const typeRadio = document.querySelector<HTMLInputElement>('input[name="edit_account_type_radio"]:checked');
    const rawTags = ($('edit-tags-input') as HTMLInputElement).value;
    const tagsArr = rawTags.split(',').map(t => t.trim()).filter(Boolean);
    const btn = $('submit-edit-competitor-modal') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      await updateCompetitor(id, {
        full_name: ($('edit-fullname-input') as HTMLInputElement).value || undefined,
        username: cleanPinterestUsername(($('edit-username-input') as HTMLInputElement).value) || undefined,
        account_type: (typeRadio?.value as any) || 'competitor',
        niche: ($('edit-niche-input') as HTMLInputElement).value || undefined,
        tags: tagsArr,
      });
      hideOverlay($('edit-competitor-modal'));
      toast('Profile updated successfully');
      await loadWorkspaceData();
    } catch (err: any) {
      const er = $('edit-competitor-error');
      er.textContent = err.message || 'Failed to update';
      er.classList.remove('hidden');
    } finally {
      btn.disabled = false; btn.textContent = 'Save Changes';
    }
  });

  // ─── Paste payload modal ──────────────────────────────────────────────────
  function openPasteModal(id?: string) {
    selectedCompetitorIdForPayload = id || null;
    const sel = $('payload-target-competitor-select') as HTMLSelectElement;
    sel.innerHTML = `<option value="" disabled ${!id ? 'selected' : ''}>Select profile…</option>` +
      competitorsList.map(c => `<option value="${c.id}" ${c.id === id ? 'selected' : ''}>${escHtml(c.full_name || c.username)} (@${escHtml(c.username)})</option>`).join('');
    $('paste-payload-error').classList.add('hidden');
    ($('paste-payload-form') as HTMLFormElement).reset();
    $('detected-payload-type').textContent = 'Waiting for paste...';
    $('detected-payload-type').className = 'rounded-full bg-muted px-2.5 py-0.5 text-[10px] font-semibold text-foreground';
    showOverlay($('paste-payload-modal'));
  }
  $('open-paste-payload-modal')?.addEventListener('click', () => openPasteModal());

  const rawPayloadTextarea = $('raw-payload-textarea') as HTMLTextAreaElement;
  rawPayloadTextarea?.addEventListener('input', () => {
    const text = rawPayloadTextarea.value.trim();
    const tag = $('detected-payload-type');
    if (!tag) return;
    if (!text) { tag.textContent = 'Waiting for paste...'; tag.className = 'rounded-full bg-muted px-2.5 py-0.5 text-[10px] font-semibold text-foreground'; return; }
    const p = parsePinterestPayload(text);
    if (p.type === 'user_profile') {
      tag.textContent = '✓ User Profile (UserResource)';
      tag.className = 'rounded-full bg-emerald-500/20 text-emerald-500 px-2.5 py-0.5 text-[10px] font-bold';
    } else if (p.type === 'user_boards') {
      tag.textContent = '✓ User Boards (BoardsResource)';
      tag.className = 'rounded-full bg-primary/20 text-primary px-2.5 py-0.5 text-[10px] font-bold';
    } else {
      tag.textContent = '✕ Unknown Payload';
      tag.className = 'rounded-full bg-rose-500/20 text-rose-500 px-2.5 py-0.5 text-[10px] font-bold';
    }
  });

  $('paste-payload-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const sel = $('payload-target-competitor-select') as HTMLSelectElement;
    const targetId = sel?.value;
    const text = rawPayloadTextarea?.value.trim() || '';
    if (!targetId) {
      const er = $('paste-payload-error');
      if (er) { er.textContent = 'Please select a target profile'; er.classList.remove('hidden'); }
      return;
    }
    const res = await ingestDevToolsPayload(targetId, text);
    if (res.success) {
      hideOverlay($('paste-payload-modal'));
      toast(res.message);
      await loadWorkspaceData();
    } else {
      const er = $('paste-payload-error');
      if (er) { er.textContent = res.message; er.classList.remove('hidden'); }
    }
  });

  // ─── Targeted Update Polling ──────────────────────────────────────────────
  let activePollingInterval: any = null;

  function pollJobStatus(jobId: string, totalCount: number | 'all') {
    if (activePollingInterval) clearInterval(activePollingInterval);

    const startTime = Date.now();
    activePollingInterval = setInterval(async () => {
      try {
        const workspaceId = getActiveWorkspaceId();
        const res = await apiJSON(`/api/admin/competitor-ops?job_id=${jobId}&workspace_id=${workspaceId}`);
        if (res.job) {
          const { status, items_processed = 0, error_message } = res.job;
          const countStr = totalCount === 'all' ? `${items_processed}` : `${items_processed}/${totalCount}`;
          toast(`⚡ Scraping in progress (${countStr} profiles processed)...`, 'info');

          if (status === 'completed') {
            clearInterval(activePollingInterval);
            activePollingInterval = null;
            toast(`✅ Competitor update complete! (${items_processed} profiles refreshed)`, 'success');
            await loadWorkspaceData();
          } else if (status === 'failed') {
            clearInterval(activePollingInterval);
            activePollingInterval = null;
            toast(`❌ Competitor scraping failed: ${error_message || 'Workflow error'}`, 'error');
            await loadWorkspaceData();
          }
        }

        if (Date.now() - startTime > 300000) {
          clearInterval(activePollingInterval);
          activePollingInterval = null;
        }
      } catch {
        // fail-lazy during transient network polling
      }
    }, 2000);
  }

  // ─── Run Targeted Update ──────────────────────────────────────────────────
  async function executeCompetitorUpdate(targetIds?: string[], force: boolean = false) {
    const ids = targetIds ?? (selectedIds.size > 0 ? Array.from(selectedIds) : []);
    const selBtn = $('update-selected-btn') as HTMLButtonElement;
    const selIcon = $('update-selected-icon');

    if (selBtn) selBtn.disabled = true;
    selIcon?.classList.add('animate-spin');

    try {
      const workspaceId = getActiveWorkspaceId();
      const payload: Record<string, any> = {
        workspace_id: workspaceId,
        force,
      };

      if (ids.length > 0) {
        payload.scope = 'selected';
        payload.ids = ids;
      } else {
        payload.scope = 'all';
      }

      const res = await apiJSON('/api/admin/competitor-ops', {
        method: 'POST',
        body: JSON.stringify(payload),
      });

      if (res.job_id) {
        const shortJobId = res.job_id.slice(0, 8);
        const count = ids.length > 0 ? ids.length : 'all';
        toast(`🚀 Workflow dispatched (#${shortJobId}) — updating ${count} profile(s)...`, 'success');
        pollJobStatus(res.job_id, count);
      } else {
        toast('Update dispatched successfully', 'success');
        await loadWorkspaceData();
      }
    } catch (err: any) {
      toast(`Failed to dispatch update: ${err.message || 'Server error'}`, 'error');
    } finally {
      selIcon?.classList.remove('animate-spin');
      if (selBtn) selBtn.disabled = false;
    }
  }

  $('update-selected-btn')?.addEventListener('click', () => executeCompetitorUpdate());

  // ─── Refresh button ───────────────────────────────────────────────────────
  $('refresh-btn').addEventListener('click', async () => {
    const icon = $('refresh-icon');
    icon.classList.add('animate-spin');
    try {
      await loadWorkspaceData();
      toast('Competitor data refreshed');
    } finally {
      setTimeout(() => icon.classList.remove('animate-spin'), 400);
    }
  });

  // ─── Keyboard shortcuts ───────────────────────────────────────────────────
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput && !(document.activeElement instanceof HTMLInputElement) && !(document.activeElement instanceof HTMLTextAreaElement)) {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    } else if (e.key === 'Escape') {
      hideGlobalRowMenu();
      if (!drawer.classList.contains('translate-x-full')) closeDrawer();
      document.querySelectorAll<HTMLElement>('.overlay-root').forEach(m => {
        if (!m.classList.contains('hidden')) hideOverlay(m);
      });
    }
  });

  // ─── Data loader ──────────────────────────────────────────────────────────
  async function loadArchivedUsernames() {
    try {
      const res = await fetch('/api/pinarchive/archived-usernames');
      if (res.ok) {
        const json = await res.json();
        if (json.success && Array.isArray(json.usernames)) {
          archivedUsernames = new Set(json.usernames.map((u: string) => String(u).toLowerCase()));
        }
      }
    } catch (e) {
      console.warn('Failed to load archived usernames:', e);
    }
  }

  async function loadWorkspaceData() {
    loadHiddenStorage();
    renderSkeleton();
    try {
      await Promise.all([
        getCompetitors().then(list => { competitorsList = list; }),
        loadArchivedUsernames(),
      ]);
      populateTagDropdown();
      renderKPIs();
      renderTable();
      buildColVisibilityMenu();
      $('updated-at').textContent = `Synced ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
    } catch (err: any) {
      toast(`Failed to load data: ${err.message}`, 'error');
    }
  }

  // ─── Boot ─────────────────────────────────────────────────────────────────
  loadWorkspaceData();
</script>
