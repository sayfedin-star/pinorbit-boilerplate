---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import RunNowButton from '../components/cron/RunNowButton.astro';
import ProviderBadge from '../components/cron/ProviderBadge.astro';
import { humanCron, humanCronTitle } from '../lib/cron-helper';
import { dbClients } from '../server/db/clients';

const workspaceId = Astro.locals.activeWorkspaceId || '';
const runtimeEnv = (Astro.locals as any)?.runtime?.env || (Astro.locals as any)?.runtimeEnv;

let competitor_pipeline_settings: { cron_expression?: string | null } | null = null;
if (workspaceId) {
  try {
    const compClient = dbClients.getCompetitors(runtimeEnv);
    const { data } = await compClient
      .from('competitor_pipeline_settings')
      .select('cron_expression')
      .eq('workspace_id', workspaceId)
      .maybeSingle();
    competitor_pipeline_settings = data;
  } catch (e) {
    console.warn('[competitors] Error fetching pipeline settings:', e);
  }
}

const rawExpr = competitor_pipeline_settings?.cron_expression || null;
const cronExpr = rawExpr || '—';
const cronTitle = rawExpr ? humanCronTitle(rawExpr) : 'No schedule configured yet';
const cronDesc = rawExpr ? humanCron(rawExpr) : 'Configure automated scraping schedule in Ops Console';
---

<Layout title="Competitor Intelligence" description="Track competitor Pinterest growth, reach, views, followers, and board creation strategy over time.">

  <!-- ═══ Header & Primary Actions ═══ -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center justify-center rounded-2xl bg-primary/10 p-2.5 text-primary border border-primary/20 shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </span>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl font-bold tracking-tight text-foreground">Competitor Intelligence</h1>
            <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-[11px] font-semibold text-primary border border-primary/20">
              Live Monitor
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-0.5">
            Monitor profile reach, follower velocity, and board strategy timeline.
          </p>
        </div>
      </div>
    </div>

    <!-- Top Action Group (Uniform h-9 buttons with clean minimalist styling) -->
    <div class="flex flex-wrap items-center gap-2 self-start sm:self-auto">
      <!-- Utility Toolbar -->
      <div class="flex items-center rounded-xl border border-border/80 bg-card p-0.5 shadow-xs">
        <button id="refresh-btn" title="Refresh data table"
          class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-all">
          <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
        </button>
        <div class="h-4 w-px bg-border/80 my-auto"></div>
        <button id="export-csv-btn" title="Export all filtered profiles to CSV"
          class="inline-flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-foreground hover:bg-muted/80 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span>Export CSV</span>
        </button>
        <div class="h-4 w-px bg-border/80 my-auto"></div>
        <a href="/competitors/settings"
          class="inline-flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-foreground hover:bg-muted/80 transition-all" title="View Ops Console and Token Settings">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>Ops Console</span>
        </a>
      </div>

      <RunNowButton
        endpoint="/api/admin/competitor-ops"
        payload={{ scope: 'all' }}
        forcePayload={{ scope: 'all', force: true }}
        label="Run Full Update"
        forceLabel="⚡ Force Run"
        size="md"
        variant="primary"
        buttonId="run-full-update-btn-unified"
        scope="competitors"
      />

      <button id="open-add-competitor-modal"
        class="inline-flex h-9 items-center justify-center gap-1.5 rounded-xl bg-primary px-4 text-xs font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 hover:scale-[1.01] active:scale-[0.99] transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Track Profiles</span>
      </button>
    </div>
  </div>

  <!-- ═══ Automation & Ingestion Scheduler Bar ═══ -->
  <div class="mb-6 rounded-2xl border border-border/80 bg-card/60 backdrop-blur-sm p-3.5 sm:px-5 sm:py-3 shadow-xs flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="relative flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        <span class="absolute -top-0.5 -right-0.5 flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
      </div>
      <div class="flex items-center gap-2 flex-wrap text-xs">
        <span class="font-bold text-foreground">Automated Pipeline</span>
        <span id="comp-pipeline-badge" class="text-[10px] font-bold px-2 py-0.2 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
          Active
        </span>
        <span
          id="comp-cron-badge"
          class="text-[10px] font-mono px-2 py-0.2 rounded-full bg-muted text-muted-foreground border border-border/60 cursor-help"
          title={cronTitle}
          data-tooltip={cronDesc}
        >
          {rawExpr ? cronExpr : 'No schedule configured'}
        </span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 self-start md:self-auto">
      <ProviderBadge workspaceId={Astro.locals.activeWorkspaceId || ''} />
      <button id="open-paste-payload-modal"
        class="inline-flex h-7.5 items-center gap-1.5 rounded-lg border border-border/80 bg-background px-2.5 text-[11px] font-semibold text-foreground hover:bg-muted/80 transition-all shadow-2xs"
        title="Paste raw Pinterest JSON from DevTools">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
        <span>Ingest JSON</span>
      </button>
      <a
        href="/competitors/settings"
        class="inline-flex h-7.5 items-center gap-1 rounded-lg border border-border/80 bg-background px-2.5 text-[11px] font-semibold text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-all shadow-2xs"
      >
        <span>⚙️ Vault</span>
      </a>
    </div>
  </div>

  <!-- ═══ KPI Dashboard (4 cards) ═══ -->
  <div class="mb-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
    <!-- Card 1: Tracked Profiles -->
    <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-primary/30 transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Tracked Profiles</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mt-2 font-mono tabular-nums" id="kpi-total">-</div>
        <div class="mt-2 h-1.5 rounded-full bg-muted overflow-hidden flex" id="kpi-split-bar">
          <div class="bg-blue-500 h-full transition-all duration-300" style="width:0%"></div>
          <div class="bg-purple-500 h-full transition-all duration-300" style="width:0%"></div>
        </div>
        <div class="mt-2 text-[11px] font-medium text-muted-foreground flex items-center justify-between" id="kpi-split-label">
          <span>0 own</span>
          <span>0 competitors</span>
        </div>
      </div>
    </div>

    <!-- Card 2: Combined Reach -->
    <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-emerald-500/30 transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Combined Reach</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        </span>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400 mt-2 font-mono tabular-nums" id="kpi-reach">-</div>
        <div class="mt-2 text-[11px] text-muted-foreground truncate flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          <span id="kpi-reach-sub" class="truncate">monthly profile reach</span>
        </div>
      </div>
    </div>

    <!-- Card 3: Total Audience -->
    <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-blue-500/30 transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Total Audience</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </span>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mt-2 font-mono tabular-nums" id="kpi-followers">-</div>
        <div class="mt-2 text-[11px] text-muted-foreground flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
          <span id="kpi-followers-sub">avg — / profile</span>
        </div>
      </div>
    </div>

    <!-- Card 4: Pins Tracked -->
    <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-amber-500/30 transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Pins Tracked</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </span>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mt-2 font-mono tabular-nums" id="kpi-pins">-</div>
        <div class="mt-2 flex items-center gap-1.5 text-[11px] text-muted-foreground">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          <span id="kpi-active-sub">0 active this week</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ Table Workspace & Enhanced Controls ═══ -->
  <div class="rounded-2xl border border-border bg-card shadow-xs overflow-hidden mb-8">
    
    <!-- Tier 1: View Navigation & Display Controls (Clean 2-sided alignment) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-border px-5 py-3 bg-muted/20">
      
      <!-- Left: Segmented Tabs -->
      <div class="flex items-center gap-1 bg-muted/70 p-1 rounded-xl border border-border/60 overflow-x-auto">
        <button data-type-tab="all" class="account-type-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-background text-foreground shadow-2xs transition-all whitespace-nowrap">All Profiles</button>
        <button data-type-tab="own" class="account-type-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all whitespace-nowrap">👤 My Accounts</button>
        <button data-type-tab="competitor" class="account-type-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all whitespace-nowrap">🎯 Competitors</button>
        <button data-type-tab="hidden" class="account-type-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all flex items-center gap-1.5 whitespace-nowrap">
          <span>👁️‍🗨️ Hidden</span>
          <span id="hidden-tab-badge" class="hidden rounded-full bg-muted-foreground/20 px-1.5 py-0.2 text-[9.5px] font-bold">0</span>
        </button>
      </div>

      <!-- Right: View Display Controls Group & Profile Count -->
      <div class="flex items-center gap-2.5 flex-wrap self-start sm:self-auto">
        <span class="text-[11px] text-muted-foreground font-mono hidden md:inline" id="updated-at"></span>

        <!-- Segmented Display Toolbar -->
        <div class="flex items-center rounded-xl border border-border bg-background p-0.5 shadow-2xs">
          <!-- Number Format Toggle -->
          <button id="num-format-toggle-btn" class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-all" title="Toggle Compact / Full number format">
            <span class="text-[10px] font-mono">#</span>
            <span id="num-format-label">Full</span>
          </button>

          <div class="h-3.5 w-px bg-border my-auto"></div>

          <!-- Density Toggle -->
          <button id="density-toggle-btn" class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-all" title="Toggle Table Density (Comfortable / Compact)">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <span id="density-label">Comfortable</span>
          </button>

          <div class="h-3.5 w-px bg-border my-auto"></div>

          <!-- Column Visibility Dropdown -->
          <div class="relative" id="col-visibility-wrapper">
            <button id="col-visibility-btn" class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-muted transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <span>Columns</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="col-visibility-menu" class="hidden absolute right-0 top-full mt-1.5 z-30 w-52 rounded-xl border border-border bg-card shadow-lg p-2 space-y-1">
              <div class="flex items-center justify-between pb-1 px-1 border-b border-border/80 text-[11px] font-semibold text-muted-foreground">
                <span>Toggle Columns</span>
                <button id="reset-cols-btn" class="text-primary hover:underline text-[10px]">Reset</button>
              </div>
              <div id="col-checkboxes-container" class="space-y-0.5 max-h-60 overflow-y-auto"></div>
            </div>
          </div>
        </div>

        <!-- Counter Pill -->
        <span class="inline-flex items-center rounded-xl bg-primary/10 px-3 py-1 text-xs font-bold text-primary border border-primary/20" id="competitor-badge-count">
          0 Profiles
        </span>
      </div>
    </div>

    <!-- Tier 2: Unified Search & Quick Filter Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5 border-b border-border px-5 py-2.5 bg-background">
      
      <!-- Search Input (Flex-1) -->
      <div class="relative flex-1 max-w-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="competitor-search-input" type="text" placeholder="Search handle, name, tag…"
          class="w-full h-8.5 rounded-xl border border-border bg-muted/20 py-1.5 pl-8 pr-12 text-xs text-foreground placeholder:text-muted-foreground focus:bg-background focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-2xs" />
        <button id="search-clear-btn" class="hidden absolute right-6 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground text-xs p-0.5" title="Clear search">✕</button>
        <kbd class="absolute right-2 top-1/2 -translate-y-1/2 rounded border border-border bg-card px-1 text-[9px] font-bold text-muted-foreground pointer-events-none">/</kbd>
      </div>

      <!-- Quick Filter Dropdowns -->
      <div class="flex items-center gap-2 flex-wrap">
        <!-- Activity Status Filter -->
        <select id="activity-filter-select" class="h-8.5 rounded-xl border border-border bg-muted/20 hover:bg-background px-3 py-1 text-xs font-medium text-foreground focus:border-primary focus:outline-none transition-colors shadow-2xs" title="Filter by profile activity state">
          <option value="all">⚡ All Activity</option>
          <option value="active">🟢 Active (&le; 7d)</option>
          <option value="cooling">🟡 Cooling (7-30d)</option>
          <option value="stale">🔴 Stale (&gt; 30d)</option>
        </select>

        <!-- Tag Filter -->
        <select id="tag-filter-select" class="h-8.5 rounded-xl border border-border bg-muted/20 hover:bg-background px-3 py-1 text-xs font-medium text-foreground focus:border-primary focus:outline-none transition-colors shadow-2xs">
          <option value="all">🏷️ All Tags</option>
        </select>
      </div>
    </div>

    <!-- Active Filters Strip (Visible when filtered) -->
    <div id="active-filters-bar" class="hidden items-center justify-between gap-2 border-b border-border bg-muted/40 px-5 py-2 text-xs">
