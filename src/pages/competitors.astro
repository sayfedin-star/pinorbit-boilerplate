  <!-- ═══ MODAL: Compare ═══ -->
  <div id="compare-modal" class="overlay-root fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
