---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<Layout title="Competitor Intelligence" description="Track competitor Pinterest growth, reach, views, followers, and board creation strategy over time.">

  <!-- ═══ Header & Primary Actions ═══ -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <SectionHeader
      title="Competitor Intelligence"
      description="Monitor competitor profile reach, follower velocity, and Pinterest board strategy timeline."
    />
    <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-auto">
      <button id="refresh-btn" title="Refresh data"
        class="inline-flex items-center justify-center rounded-xl border border-border bg-card p-2.5 text-muted-foreground shadow-sm hover:bg-muted hover:text-foreground transition-all">
        <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
      </button>
      <button id="export-csv-btn"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span>Export CSV</span>
      </button>
      <button id="run-full-update-btn"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
        <svg id="run-full-update-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <span>⚡ Run Full Update Now</span>
      </button>
      <a href="/competitors/settings"
        class="inline-flex items-center gap-2 rounded-xl border border-border bg-card px-4 py-2.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all">
        <span>⚙️ Ops Console</span>
      </a>
      <button id="open-add-competitor-modal"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Track Profile</span>
      </button>
    </div>
  </div>

  <!-- ═══ KPI Dashboard (4 cards) ═══ -->
  <div class="mb-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Tracked Profiles</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-1" id="kpi-total">-</div>
      <div class="mt-2 h-1 rounded-full bg-muted overflow-hidden flex" id="kpi-split-bar"><div class="bg-blue-500 h-full" style="width:0%"></div><div class="bg-purple-500 h-full" style="width:0%"></div></div>
      <div class="mt-1.5 text-[11px] text-muted-foreground" id="kpi-split-label">0 own • 0 competitors</div>
    </div>
    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Combined Reach</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500"><svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg></span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-emerald-500 mt-1" id="kpi-reach">-</div>
      <div class="mt-1.5 text-[11px] text-muted-foreground truncate" id="kpi-reach-sub">monthly profile reach</div>
    </div>
    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Total Audience</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-500/10 text-blue-500"><svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-1" id="kpi-followers">-</div>
      <div class="mt-1.5 text-[11px] text-muted-foreground" id="kpi-followers-sub">avg — / profile</div>
    </div>
    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Pins Tracked</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500"><svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-1" id="kpi-pins">-</div>
      <div class="mt-1.5 flex items-center gap-1.5 text-[11px] text-muted-foreground"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><span id="kpi-active-sub">0 active this week</span></div>
    </div>
  </div>

  <!-- ═══ Table Workspace ═══ -->
  <div class="rounded-xl border border-border bg-card shadow-sm overflow-hidden mb-8">
    <!-- Toolbar -->
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between border-b border-border px-6 py-4 bg-muted/30">
      <div class="flex items-center gap-3 flex-wrap">
        <div class="flex items-center gap-1 bg-muted/60 p-1 rounded-xl border border-border/60">
          <button data-type-tab="all" class="account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold bg-background text-foreground shadow-xs transition-all">All Profiles</button>
          <button data-type-tab="own" class="account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">👤 My Accounts</button>
          <button data-type-tab="competitor" class="account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">🎯 Competitors</button>
        </div>
        <div class="flex items-center gap-1.5">
          <label for="tag-filter-select" class="text-xs font-semibold text-muted-foreground">Tag:</label>
          <select id="tag-filter-select" class="rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium text-foreground focus:border-primary focus:outline-none">
            <option value="all">All Tags</option>
          </select>
        </div>
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input id="competitor-search-input" type="text" placeholder="Search username, name, niche…"
            class="w-56 rounded-xl border border-border bg-background py-1.5 pl-8 pr-8 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
          <kbd class="absolute right-2 top-1/2 -translate-y-1/2 rounded border border-border bg-muted px-1 text-[9px] font-bold text-muted-foreground">/</kbd>
        </div>
      </div>
      <div class="flex items-center gap-2.5 flex-wrap">
        <span class="text-[10px] text-muted-foreground" id="updated-at"></span>
        <div class="relative" id="col-visibility-wrapper">
          <button id="col-visibility-btn" class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Columns</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="col-visibility-menu" class="hidden absolute right-0 top-full mt-1.5 z-30 w-48 rounded-xl border border-border bg-card shadow-lg p-2 space-y-0.5"></div>
        </div>
        <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary" id="competitor-badge-count">0 Profiles</span>
      </div>
    </div>

    <!-- Selection action bar -->
    <div id="selection-bar" class="hidden items-center justify-between gap-3 border-b border-border bg-primary/5 px-6 py-2.5 flex-wrap">
      <div class="flex items-center gap-3">
        <span class="text-xs font-semibold text-primary" id="selection-count">0 selected</span>
        <label class="inline-flex items-center gap-1.5 text-[11px] text-foreground font-medium cursor-pointer">
          <input type="checkbox" id="bulk-dispatch" class="rounded border-border text-primary focus:ring-primary h-3.5 w-3.5" />
          <span>Fetch now (dispatch)</span>
        </label>
      </div>
      <div class="flex items-center gap-2 flex-wrap">
        <button id="update-selected-btn" class="rounded-lg bg-primary px-3 py-1.5 text-[11px] font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-all flex items-center gap-1.5 disabled:opacity-50 disabled:cursor-not-allowed">
          <svg id="update-selected-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span id="update-selected-label">⚡ Update selected</span>
        </button>
        <button id="send-selected-to-pinarchive-btn" class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 text-[11px] font-bold shadow-sm transition-all flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
          <span>Send to PinArchive</span>
        </button>
        <button id="open-compare-btn" disabled class="rounded-lg bg-primary px-3 py-1.5 text-[11px] font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-all disabled:opacity-40 disabled:cursor-not-allowed">⚖ Compare</button>
        <button id="export-selected-btn" class="rounded-lg border border-border bg-background px-3 py-1.5 text-[11px] font-semibold text-foreground hover:bg-muted transition-all">Export selected</button>
        <button id="clear-selection-btn" class="rounded-lg px-3 py-1.5 text-[11px] font-semibold text-muted-foreground hover:bg-muted hover:text-foreground transition-all">Clear</button>
      </div>
    </div>

    <div class="overflow-auto max-h-[600px]">
      <table class="w-full text-left text-xs text-muted-foreground" id="competitors-table">
        <thead class="sticky top-0 z-10 border-b border-border bg-muted text-foreground font-semibold" id="competitors-thead"></thead>
        <tbody id="competitors-table-body" class="divide-y divide-border bg-card"></tbody>
        <tfoot id="competitors-tfoot" class="hidden border-t-2 border-border bg-muted/50"></tfoot>
      </table>
    </div>

    <!-- Pagination -->
    <div id="pagination-bar" class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-6 py-3 bg-muted/30">
      <span class="text-[11px] text-muted-foreground" id="page-info">—</span>
      <div class="flex items-center gap-2">
        <label class="text-[11px] text-muted-foreground" for="rows-per-page">Rows:</label>
        <select id="rows-per-page" class="rounded-lg border border-border bg-background px-2 py-1 text-[11px] text-foreground focus:outline-none">
          <option>10</option><option>25</option><option>50</option>
        </select>
        <button id="page-prev" class="rounded-lg border border-border bg-background px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted disabled:opacity-40 transition-all" disabled>← Prev</button>
        <button id="page-next" class="rounded-lg border border-border bg-background px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted disabled:opacity-40 transition-all" disabled>Next →</button>
      </div>
    </div>
  </div>

  <!-- ═══ Details Drawer (slide-over) ═══ -->
  <div id="drawer-backdrop" class="fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300"></div>
  <aside id="competitor-drawer" aria-label="Competitor details"
    class="fixed inset-y-0 right-0 z-50 w-full max-w-md transform translate-x-full transition-transform duration-300 bg-card border-l border-border shadow-2xl flex flex-col">
    <div class="flex items-center justify-between border-b border-border px-5 py-4">
      <span class="text-sm font-bold text-foreground">Profile Overview</span>
      <button id="drawer-close" class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div id="drawer-body" class="flex-1 overflow-y-auto p-5 space-y-5"></div>
  </aside>

  <!-- ═══ MODAL: Track Profile ═══ -->
  <div id="add-competitor-modal" class="overlay-root fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div class="fixed inset-0" data-close></div>
    <div class="relative w-full max-w-lg rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
          <h3 class="text-base font-bold text-foreground">Track Pinterest Profile</h3>
        </div>
        <button data-close class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
      </div>
      <div id="add-competitor-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>
      <form id="add-competitor-form" class="space-y-4">
        <div class="space-y-1.5">
          <label class="block text-xs font-semibold text-foreground">Profile Classification *</label>
          <div class="grid grid-cols-2 gap-3">
            <label class="flex items-center justify-between rounded-xl border border-border bg-background p-3 cursor-pointer hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-all">
              <div class="flex items-center gap-2"><span class="text-sm">🎯</span><div><div class="text-xs font-bold text-foreground">Competitor</div><div class="text-[10px] text-muted-foreground">External target profile</div></div></div>
              <input type="radio" name="account_type_radio" value="competitor" checked class="text-primary focus:ring-primary" />
            </label>
            <label class="flex items-center justify-between rounded-xl border border-border bg-background p-3 cursor-pointer hover:border-primary has-[:checked]:border-primary has-[:checked]:bg-primary/5 transition-all">
              <div class="flex items-center gap-2"><span class="text-sm">👤</span><div><div class="text-xs font-bold text-foreground">My Account</div><div class="text-[10px] text-muted-foreground">Internal brand account</div></div></div>
              <input type="radio" name="account_type_radio" value="own" class="text-primary focus:ring-primary" />
            </label>
          </div>
        </div>
        <div class="space-y-1.5">
          <label for="competitor-username-input" class="block text-xs font-semibold text-foreground">Pinterest Username *</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-xs font-semibold text-muted-foreground">@</span>
            <input id="competitor-username-input" type="text" required placeholder="e.g. tastyrecipes"
              class="w-full rounded-xl border border-border bg-background py-2.5 pl-8 pr-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="competitor-niche-input" class="block text-xs font-semibold text-foreground">Niche / Category</label>
            <input id="competitor-niche-input" type="text" placeholder="e.g. Food & Cooking" class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
          </div>
          <div class="space-y-1.5">
            <label for="competitor-tags-input" class="block text-xs font-semibold text-foreground">Tags (Comma-Separated)</label>
            <input id="competitor-tags-input" type="text" placeholder="e.g. Main, E-com, Priority" class="w-full rounded-xl border border-border bg-background py-2.5 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
          </div>
        </div>
        <div class="space-y-1.5">
          <label for="competitor-notes-input" class="block text-xs font-semibold text-foreground">Internal Strategy Notes</label>
          <textarea id="competitor-notes-input" rows="3" placeholder="e.g. Focuses on 30-minute quick dinners and keto meal prep infographics..." class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
        </div>
        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button type="button" data-close class="rounded-xl border border-border px-4 py-2.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground">Cancel</button>
          <button type="submit" class="rounded-xl bg-primary px-5 py-2.5 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all">Start Tracking</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ═══ MODAL: Paste DevTools Payload ═══ -->
  <div id="paste-payload-modal" class="overlay-root fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div class="fixed inset-0" data-close></div>
    <div class="relative w-full max-w-2xl rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg></div>
          <h3 class="text-base font-bold text-foreground">Ingest DevTools Payload</h3>
        </div>
