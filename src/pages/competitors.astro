  window.addEventListener('resize', () => hideGlobalRowMenu(), { passive: true });

  // ─── Hide / Unhide Logic ──────────────────────────────────────────────────
  function toggleHideProfile(id: string) {
    const c = competitorsList.find(x => x.id === id);
    const u = c?.username || 'profile';
    if (hiddenProfileIds.has(id)) {
      hiddenProfileIds.delete(id);
      toast(`Unhid @${u}`);
    } else {
      hiddenProfileIds.add(id);
      selectedIds.delete(id);
      toast(`Hidden @${u} from active view`);
    }
    saveHiddenStorage();
    renderKPIs();
    renderTable();
  }

  hideSelectedBtn?.addEventListener('click', () => {
    if (selectedIds.size === 0) return;
    const isViewingHidden = activeTypeTab === 'hidden';
    const count = selectedIds.size;

    selectedIds.forEach(id => {
      if (isViewingHidden) {
        hiddenProfileIds.delete(id);
      } else {
        hiddenProfileIds.add(id);
      }
    });

    saveHiddenStorage();
    selectedIds.clear();
    toast(isViewingHidden ? `Unhid ${count} profile(s)` : `Hidden ${count} profile(s) from view`);
    renderKPIs();
    renderTable();
  });

  // ─── Selection bar ────────────────────────────────────────────────────────
  function updateSelectionBar() {
    const isViewingHidden = activeTypeTab === 'hidden';
    if (selectedIds.size > 0) {
      selectionBar.classList.remove('hidden'); selectionBar.classList.add('flex');
      selectionCount.textContent = `${selectedIds.size} selected`;
      compareBtn.disabled = selectedIds.size < 2 || selectedIds.size > 4;
      compareBtn.title = selectedIds.size < 2 ? 'Select at least 2 profiles to compare' : (selectedIds.size > 4 ? 'Select up to 4 profiles' : 'Compare selected profiles side-by-side');
      $('update-selected-label').textContent = `⚡ Update (${selectedIds.size})`;
      
      if (hideSelectedLabel) hideSelectedLabel.textContent = isViewingHidden ? `Unhide (${selectedIds.size})` : `Hide (${selectedIds.size})`;
      if (hideSelectedIcon) hideSelectedIcon.textContent = isViewingHidden ? '👁️' : '👁️‍🗨️';
    } else {
      selectionBar.classList.add('hidden'); selectionBar.classList.remove('flex');
