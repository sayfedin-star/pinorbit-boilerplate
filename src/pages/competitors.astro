<style is:global>
  @keyframes po-shimmer { 100% { transform: translateX(100%); } }
  .skeleton { position: relative; overflow: hidden; background: rgb(128 128 128 / 0.15); border-radius: 0.5rem; }
  .skeleton::after { content: ''; position: absolute; inset: 0; transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.25), transparent);
    animation: po-shimmer 1.4s infinite; }
</style>

<script>
  import { parsePinterestPayload } from '../lib/competitors';
  import { getActiveWorkspaceId } from '../lib/workspaces';
  import type { Competitor, CompetitorDeltaStats } from '../lib/types';

  // ─── Server-only CRUD for Project 2 (via admin endpoints) ───
  async function apiJSON(url: string, opts: RequestInit = {}) {
    const r = await fetch(url, { headers: { 'Content-Type': 'application/json' }, ...opts });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error((d as any).error || `HTTP ${r.status}`);
    return d as any;
  }
  async function getCompetitors() { return (await apiJSON('/api/admin/competitors')).competitors as any[]; }
  async function getCompetitorDetails(id: string) { return apiJSON(`/api/admin/competitors?id=${encodeURIComponent(id)}`); }
  async function addCompetitor(data: any) { return (await apiJSON('/api/admin/competitors', { method: 'POST', body: JSON.stringify(data) })).competitor; }
  async function updateCompetitor(id: string, data: any) { return (await apiJSON('/api/admin/competitors', { method: 'PATCH', body: JSON.stringify({ id, ...data }) })).competitor; }
  async function deleteCompetitor(id: string) { await apiJSON('/api/admin/competitors', { method: 'DELETE', body: JSON.stringify({ id }) }); return true; }
  async function ingestDevToolsPayload(competitorId: string, payloadText: string) {
    return apiJSON('/api/admin/competitors/ingest', { method: 'POST', body: JSON.stringify({ competitor_id: competitorId, payload: payloadText }) });
  }

  // ─── State ────────────────────────────────────────────────────────────────
  let competitorsList: Competitor[] = [];
  let filteredCache: Competitor[] = [];
  const selectedIds = new Set<string>();
  let selectedCompetitorIdForPayload: string | null = null;

  let activeTypeTab: 'all' | 'own' | 'competitor' = 'all';
  let selectedTag = 'all';
  let searchQuery = '';
  let sortKey: string | null = null;
  let sortDir: 'asc' | 'desc' = 'desc';
  let page = 1;
  let rowsPerPage = Number(localStorage.getItem('po_comp_rows') || 10);
  let archivedUsernames = new Set<string>();

  interface ColDef { key: string; label: string; defaultVisible: boolean; locked?: boolean; }
  const COLUMN_DEFS: ColDef[] = [
    { key: 'select',       label: '',               defaultVisible: true, locked: true },
    { key: 'profile',      label: 'Profile',        defaultVisible: true, locked: true },
    { key: 'type',         label: 'Type',           defaultVisible: true },
    { key: 'niche',        label: 'Niche',          defaultVisible: false },
    { key: 'reach',        label: 'Monthly Reach',  defaultVisible: true },
    { key: 'views',        label: 'Profile Views',  defaultVisible: true },
    { key: 'followers',    label: 'Followers',      defaultVisible: false },
    { key: 'pins',         label: 'Total Pins',     defaultVisible: true },
    { key: 'boards_count', label: 'Boards Count',   defaultVisible: true },
    { key: 'last_pin',     label: 'Last Pin',       defaultVisible: true },
    { key: 'strategy_age', label: 'Strategy Age',   defaultVisible: false },
    { key: 'actions',      label: 'Actions',        defaultVisible: true, locked: true },
  ];
  const colVisible: Record<string, boolean> = {};
  try {
    const saved = JSON.parse(localStorage.getItem('po_comp_cols') || '{}');
    COLUMN_DEFS.forEach(c => { colVisible[c.key] = (c.key in saved) ? !!saved[c.key] : c.defaultVisible; });
  } catch { COLUMN_DEFS.forEach(c => { colVisible[c.key] = c.defaultVisible; }); }

  // ─── DOM refs ─────────────────────────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const tbody = $('competitors-table-body'), thead = $('competitors-thead'), tfoot = $('competitors-tfoot');
  const badge = $('competitor-badge-count'), pageInfo = $('page-info');
  const prevBtn = $('page-prev') as HTMLButtonElement, nextBtn = $('page-next') as HTMLButtonElement;
  const rowsSelect = $('rows-per-page') as HTMLSelectElement;
  const selectionBar = $('selection-bar'), selectionCount = $('selection-count');
  const compareBtn = $('open-compare-btn') as HTMLButtonElement;
  const tagFilterSelect = $('tag-filter-select') as HTMLSelectElement;
  const searchInput = $('competitor-search-input') as HTMLInputElement;
  const drawer = $('competitor-drawer'), drawerBackdrop = $('drawer-backdrop'), drawerBody = $('drawer-body');

  // ─── Formatting helpers ───────────────────────────────────────────────────
  const escHtml = (s: any) => String(s ?? '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string));
  const fmtFull = (n: number | null | undefined) => (n ?? 0).toLocaleString('en-US');
  const fmtCompact = (n: number | null | undefined) => new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(n ?? 0);
  function timeAgo(iso?: string | null): string {
    if (!iso) return '—';
    const ms = Date.now() - new Date(iso).getTime();
    if (isNaN(ms) || ms < 0) return '—';
    const m = Math.floor(ms / 60000);
    if (m < 1) return 'just now';
    if (m < 60) return `${m}m ago`;
    const h = Math.floor(m / 60);
    if (h < 24) return `${h}h ago`;
    const d = Math.floor(h / 24);
    if (d < 30) return `${d}d ago`;
    const mo = Math.floor(d / 30);
    if (mo < 12) return `${mo}mo ago`;
    return `${Math.floor(mo / 12)}y ago`;
  }
  function activityOf(c: Competitor): { label: string; dot: string; text: string } {
    if (!c.last_pin_at) return { label: 'Unknown', dot: 'bg-muted-foreground/40', text: 'text-muted-foreground' };
    const d = (Date.now() - new Date(c.last_pin_at).getTime()) / 86400000;
    if (d <= 7) return { label: 'Active', dot: 'bg-emerald-500', text: 'text-emerald-500' };
    if (d <= 30) return { label: 'Cooling', dot: 'bg-amber-500', text: 'text-amber-500' };
    return { label: 'Stale', dot: 'bg-rose-500', text: 'text-rose-500' };
  }
  function deltaChip(change: number, percent: number): string {
    if (!change && !percent) return '<span class="rounded-full bg-muted px-1.5 py-0.5 text-[10px] font-semibold text-muted-foreground">—</span>';
    const up = change > 0;
    const label = `${up ? 'increased by' : 'decreased by'} ${Math.abs(percent).toFixed(1)}%`;
    return `<span class="inline-flex items-center gap-0.5 rounded-full px-1.5 py-0.5 text-[10px] font-bold ${up ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500'}" role="status" aria-label="${label}">${up ? '↑' : '↓'} ${Math.abs(percent).toFixed(1)}%</span>`;
  }
  function formatDeltaSpan(diff: number | undefined | null): string {
    if (diff === undefined || diff === null || diff === 0) return '';
    const isPos = diff > 0;
    return `<span class="ml-1.5 font-semibold text-[10px] ${isPos ? 'text-emerald-500' : 'text-rose-500'}">(${isPos ? '+' : ''}${fmtFull(diff)})</span>`;
  }
  function sparkline(values: number[], cls: string): string {
    if (values.length < 2) return '<div class="text-[10px] text-muted-foreground py-2">Not enough history yet — ingest more snapshots.</div>';
    const w = 280, h = 48, pad = 3;
    const min = Math.min(...values), max = Math.max(...values);
    const range = max - min || 1;
    const pts = values.map((v, i) => {
      const x = pad + (i * (w - pad * 2)) / (values.length - 1);
      const y = h - pad - ((v - min) / range) * (h - pad * 2);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    });
    const last = pts[pts.length - 1].split(',');
    return `<svg viewBox="0 0 ${w} ${h}" class="w-full ${cls}" preserveAspectRatio="none">
      <polyline points="${pts.join(' ')}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="${last[0]}" cy="${last[1]}" r="3" fill="currentColor"/></svg>`;
  }

  // ─── Toasts ───────────────────────────────────────────────────────────────
  function toast(message: string, type: 'success' | 'error' | 'info' = 'success') {
    const colors = { success: 'border-emerald-500/40 text-emerald-600 dark:text-emerald-400', error: 'border-rose-500/40 text-rose-600 dark:text-rose-400', info: 'border-primary/40 text-primary' };
    const icons = { success: '✓', error: '✕', info: 'ℹ' };
    const el = document.createElement('div');
    el.className = `flex items-start gap-2.5 rounded-xl border bg-card p-3 text-xs font-semibold shadow-lg ${colors[type]}`;
    el.innerHTML = `<span class="flex-shrink-0">${icons[type]}</span><span class="flex-1 text-foreground">${escHtml(message)}</span>
      <button class="text-muted-foreground hover:text-foreground" aria-label="Dismiss">✕</button>`;
    el.querySelector('button')!.addEventListener('click', () => el.remove());
    $('toast-root').appendChild(el);
    setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .3s'; setTimeout(() => el.remove(), 300); }, 4200);
  }

  // ─── Overlays (generic show/hide + focus + Esc) ───────────────────────────
  const lastFocusMap = new Map<HTMLElement, Element | null>();
  function showOverlay(el: HTMLElement) {
    lastFocusMap.set(el, document.activeElement);
    el.classList.remove('hidden'); el.classList.add('flex');
    const f = el.querySelector<HTMLElement>('input:not([type=hidden]), select, textarea');
    (f || el.querySelector<HTMLElement>('button[data-close]'))?.focus();
  }
  function hideOverlay(el: HTMLElement) {
    el.classList.add('hidden'); el.classList.remove('flex');
    const prev = lastFocusMap.get(el) as HTMLElement | null;
    prev?.focus?.();
  }
  document.querySelectorAll('.overlay-root').forEach(root => {
    root.querySelectorAll('[data-close]').forEach(btn => btn.addEventListener('click', () => hideOverlay(root as HTMLElement)));
  });

  let confirmResolver: ((ok: boolean) => void) | null = null;
  function askConfirm(title: string, message: string): Promise<boolean> {
    $('confirm-title').textContent = title;
    $('confirm-message').textContent = message;
    showOverlay($('confirm-modal'));
    return new Promise(res => { confirmResolver = res; });
  }
  $('confirm-ok').addEventListener('click', () => { hideOverlay($('confirm-modal')); confirmResolver?.(true); confirmResolver = null; });
  $('confirm-cancel').addEventListener('click', () => { hideOverlay($('confirm-modal')); confirmResolver?.(false); confirmResolver = null; });

  // ─── Filtering / sorting ──────────────────────────────────────────────────
  function applySortAndFilter(): Competitor[] {
    let filtered = competitorsList.filter(c => {
      if (activeTypeTab === 'own') return c.account_type === 'own';
      if (activeTypeTab === 'competitor') return c.account_type !== 'own';
      return true;
    });
    if (selectedTag !== 'all') filtered = filtered.filter(c => Array.isArray(c.tags) && c.tags.includes(selectedTag));
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(c =>
        (c.username || '').toLowerCase().includes(q) ||
        (c.full_name || '').toLowerCase().includes(q) ||
        (c.niche || '').toLowerCase().includes(q));
    }
    if (sortKey) {
      filtered = [...filtered].sort((a, b) => {
        let av: any, bv: any;
        if (sortKey === 'last_pin_at') { av = a.last_pin_at ? +new Date(a.last_pin_at) : 0; bv = b.last_pin_at ? +new Date(b.last_pin_at) : 0; }
        else { av = (a as any)[sortKey] ?? 0; bv = (b as any)[sortKey] ?? 0; }
        return sortDir === 'asc' ? av - bv : bv - av;
      });
    }
    return filtered;
  }

  // ─── KPIs ─────────────────────────────────────────────────────────────────
  function renderKPIs() {
    const total = competitorsList.length;
    const own = competitorsList.filter(c => c.account_type === 'own').length;
    const comp = total - own;
    const reach = competitorsList.reduce((s, c) => s + (c.profile_reach || 0), 0);
    const followers = competitorsList.reduce((s, c) => s + (c.follower_count || 0), 0);
    const pins = competitorsList.reduce((s, c) => s + (c.pin_count || 0), 0);
    const activeWeek = competitorsList.filter(c => c.last_pin_at && (Date.now() - +new Date(c.last_pin_at)) < 7 * 86400000).length;
    const top = [...competitorsList].sort((a, b) => (b.profile_reach || 0) - (a.profile_reach || 0))[0];

    $('kpi-total').textContent = String(total);
    $('kpi-split-label').textContent = `${own} own • ${comp} competitors`;
    const bar = $('kpi-split-bar').children as HTMLCollectionOf<HTMLElement>;
    bar[0].style.width = total ? `${(own / total) * 100}%` : '0%';
    bar[1].style.width = total ? `${(comp / total) * 100}%` : '0%';
    $('kpi-reach').textContent = fmtCompact(reach);
    $('kpi-reach-sub').textContent = top ? `top: @${top.username}` : 'monthly profile reach';
    $('kpi-followers').textContent = fmtCompact(followers);
    $('kpi-followers-sub').textContent = total ? `avg ${fmtCompact(Math.round(followers / total))} / profile` : 'avg — / profile';
    $('kpi-pins').textContent = fmtCompact(pins);
    $('kpi-active-sub').textContent = `${activeWeek} active this week`;
  }

  // ─── Table rendering ──────────────────────────────────────────────────────
  const SORTABLE: Record<string, string> = {
    reach: 'profile_reach', views: 'profile_views', followers: 'follower_count',
    pins: 'pin_count', boards_count: 'boards_count', last_pin: 'last_pin_at',
  };
  const visibleCols = () => COLUMN_DEFS.filter(c => colVisible[c.key] || c.locked);

  function renderTableHeader() {
    const cols = visibleCols();
    thead.innerHTML = `<tr>${cols.map(c => {
      const sk = SORTABLE[c.key];
      const sortable = !!sk;
      const arrow = sk ? (sortKey === sk ? (sortDir === 'asc' ? '<span class="text-primary ml-1">↑</span>' : '<span class="text-primary ml-1">↓</span>') : '<span class="ml-1 opacity-30">↕</span>') : '';
      const ariaSort = sk && sortKey === sk ? `aria-sort="${sortDir === 'asc' ? 'ascending' : 'descending'}"` : '';
      if (c.key === 'select') return `<th scope="col" class="py-3 px-4 w-8"><input type="checkbox" id="select-all-cb" class="rounded accent-primary" title="Select all filtered"/></th>`;
      const align = c.key === 'actions' ? 'text-right' : '';
      return `<th scope="col" ${ariaSort} class="py-3 px-4 ${align} ${sortable ? 'cursor-pointer select-none hover:text-primary' : ''}" ${sortable ? `data-sort-col="${c.key}"` : ''}>${c.label}${arrow}</th>`;
    }).join('')}</tr>`;
    thead.querySelectorAll<HTMLElement>('[data-sort-col]').forEach(th => {
      th.addEventListener('click', () => {
        const sk = SORTABLE[th.dataset.sortCol!];
        if (sortKey === sk) sortDir = sortDir === 'asc' ? 'desc' : 'asc';
        else { sortKey = sk; sortDir = 'desc'; }
        renderTable();
      });
    });
    $('select-all-cb')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      filteredCache.forEach(c => checked ? selectedIds.add(c.id) : selectedIds.delete(c.id));
      renderTable();
    });
  }

  function renderSkeleton() {
    const n = visibleCols().length;
    tbody.innerHTML = Array.from({ length: 5 }, () =>
      `<tr>${Array.from({ length: n }, (_, i) => `<td class="py-4 ${i === 0 ? 'px-4' : 'px-4'}"><div class="skeleton h-4 ${i === 1 ? 'w-32' : 'w-16'}"></div></td>`).join('')}</tr>`).join('');
  }

  function renderTable() {
    renderTableHeader();
    filteredCache = applySortAndFilter();
    badge.textContent = `${filteredCache.length} ${filteredCache.length === 1 ? 'Profile' : 'Profiles'}`;

    const totalPages = Math.max(1, Math.ceil(filteredCache.length / rowsPerPage));
    if (page > totalPages) page = totalPages;
    const start = (page - 1) * rowsPerPage;
    const pageRows = filteredCache.slice(start, start + rowsPerPage);

    pageInfo.textContent = filteredCache.length
      ? `Showing ${start + 1}–${Math.min(start + rowsPerPage, filteredCache.length)} of ${filteredCache.length}`
      : 'No rows';
    prevBtn.disabled = page <= 1;
    nextBtn.disabled = page >= totalPages;

    updateSelectionBar();

    if (filteredCache.length === 0) {
      tfoot.classList.add('hidden');
      const isEmptyWorkspace = competitorsList.length === 0;
      tbody.innerHTML = `<tr><td colspan="99" class="py-16 text-center">
        <div class="flex flex-col items-center gap-3 px-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-muted-foreground/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          ${isEmptyWorkspace ? `
            <div class="text-sm font-bold text-foreground">No profiles tracked yet</div>
            <p class="max-w-sm text-xs text-muted-foreground">Start monitoring competitor reach, follower velocity and board strategy. Data syncs automatically daily at 02:00 UTC, or instantly via DevTools payloads.</p>
            <div class="flex gap-2.5">
              <button id="empty-track-btn" class="rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90">+ Track Profile</button>
              <button id="empty-paste-btn" class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted">Paste Payload</button>
            </div>` : `
            <div class="text-sm font-bold text-foreground">No matches for your filters</div>
            <button id="clear-filters-btn" class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted">Clear filters</button>`}
        </div></td></tr>`;
      $('empty-track-btn')?.addEventListener('click', () => showOverlay($('add-competitor-modal')));
      $('empty-paste-btn')?.addEventListener('click', () => openPasteModal());
      $('clear-filters-btn')?.addEventListener('click', () => {
        searchQuery = ''; searchInput.value = ''; selectedTag = 'all'; tagFilterSelect.value = 'all';
        activeTypeTab = 'all'; syncTabClasses(); page = 1; renderTable();
      });
      return;
    }

    // tfoot totals
    const totR = filteredCache.reduce((s, c) => s + (c.profile_reach || 0), 0);
    const totV = filteredCache.reduce((s, c) => s + (c.profile_views || 0), 0);
    const totP = filteredCache.reduce((s, c) => s + (c.pin_count || 0), 0);
    tfoot.innerHTML = `<tr>${visibleCols().map(c => {
      if (c.key === 'profile') return `<td class="py-3 px-4 font-bold text-xs text-foreground">∑ Totals (${filteredCache.length})</td>`;
      if (c.key === 'reach') return `<td class="py-3 px-4 font-bold text-xs text-emerald-500">${fmtFull(totR)}</td>`;
      if (c.key === 'views') return `<td class="py-3 px-4 font-bold text-xs text-foreground">${fmtFull(totV)}</td>`;
      if (c.key === 'pins') return `<td class="py-3 px-4 font-bold text-xs text-foreground">${fmtFull(totP)}</td>`;
      return `<td class="py-3 px-4"></td>`;
    }).join('')}</tr>`;
    tfoot.classList.remove('hidden');

    // tbody
    tbody.innerHTML = pageRows.map(c => {
      const rawAvatar = c.avatar_url && /^https?:\/\//i.test(c.avatar_url) ? c.avatar_url : `https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&h=200&q=80`;
      const avatar = escHtml(rawAvatar);
      const isOwn = c.account_type === 'own';
      const act = activityOf(c);
      const isSel = selectedIds.has(c.id);

      const tagsHtml = (Array.isArray(c.tags) && c.tags.length > 0)
        ? `<div class="flex flex-wrap items-center gap-1 pt-1">${c.tags.map(t => `<button data-click-tag="${escHtml(t)}" class="rounded bg-muted px-1.5 py-0.5 text-[9.5px] font-semibold text-muted-foreground border border-border/50 hover:border-primary hover:text-foreground">#${escHtml(t)}</button>`).join('')}</div>` : '';

      const cellMap: Record<string, string> = {
        select: `<td class="py-4 px-4"><input type="checkbox" data-row-select="${c.id}" ${isSel ? 'checked' : ''} class="rounded accent-primary" /></td>`,
        profile: (() => {
          const isArchived = archivedUsernames.has((c.username || '').toLowerCase());
          const pinArchiveBadge = isArchived
            ? `<a href="/pinarchive/account/${encodeURIComponent(c.username)}" title="View in PinArchive" class="inline-flex items-center px-1.5 py-0.5 rounded text-[9.5px] font-semibold bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 hover:bg-purple-500/20 transition-colors">In PinArchive</a>`
            : '';

          return `<td class="py-4 px-4">
            <div class="flex items-center gap-3">
              <img src="${avatar}" alt="${escHtml(c.username)}" loading="lazy" class="h-10 w-10 rounded-full object-cover border border-border shadow-sm flex-shrink-0" />
              <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <a href="/competitors/details?id=${c.id}" aria-label="View detailed analytics for ${escHtml(c.full_name || c.username)}" class="text-xs font-bold text-foreground hover:text-primary transition-colors truncate text-left">${escHtml(c.full_name || c.username)}</a>
                  <a href="https://www.pinterest.com/${escHtml(c.username)}/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground/60 hover:text-primary" title="Open Pinterest">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                  ${pinArchiveBadge}
                </div>
                <span class="text-[11px] text-muted-foreground">@${escHtml(c.username)}</span>
                ${tagsHtml}
              </div>
            </div></td>`;
        })(),
        type: `<td class="py-4 px-4"><span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold border ${isOwn ? 'bg-blue-500/10 text-blue-500 border-blue-500/20' : 'bg-purple-500/10 text-purple-500 border-purple-500/20'}">${isOwn ? '👤 My Account' : '🎯 Competitor'}</span></td>`,
        niche: `<td class="py-4 px-4"><span class="inline-flex items-center rounded-md bg-muted px-2 py-1 text-[11px] font-medium text-foreground">${escHtml(c.niche || 'General')}</span></td>`,
        reach: `<td class="py-4 px-4 font-bold text-emerald-500">${fmtFull(c.profile_reach || 0)}${formatDeltaSpan(c.deltas?.reachChange ?? c.deltas?.reach?.change)}</td>`,
        views: `<td class="py-4 px-4 font-semibold text-foreground">${fmtFull(c.profile_views || 0)}${formatDeltaSpan(c.deltas?.viewsChange ?? c.deltas?.views?.change)}</td>`,
        followers: `<td class="py-4 px-4 font-semibold text-foreground">${fmtFull(c.follower_count || 0)}${formatDeltaSpan(c.deltas?.followersChange ?? c.deltas?.followers?.change)}</td>`,
        pins: `<td class="py-4 px-4 text-foreground">${fmtFull(c.pin_count || 0)}${formatDeltaSpan(c.deltas?.pinsChange ?? c.deltas?.pins?.change)}</td>`,
        boards_count: `<td class="py-4 px-4"><span class="inline-flex items-center rounded-md bg-muted/60 px-2 py-1 text-[11px] font-semibold text-foreground">${c.boards_count ?? 0}</span></td>`,
        last_pin: `<td class="py-4 px-4 text-[11px] ${act.text}" title="${escHtml(c.last_pin_at || '')}">
          <span class="inline-flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full ${act.dot}"></span><span>${timeAgo(c.last_pin_at)}${c.last_pin_at ? ' · ' + new Date(c.last_pin_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : ''}</span></span>
        </td>`,
        strategy_age: `<td class="py-4 px-4"><span class="rounded bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">${c.strategy_age_days ? `${c.strategy_age_days}d active` : 'Unknown'}</span></td>`,
        actions: (() => {
          const isArchived = archivedUsernames.has((c.username || '').toLowerCase());
          const pinArchiveBtn = isArchived
            ? `<a href="/pinarchive/account/${encodeURIComponent(c.username)}" class="rounded-lg border border-border p-1.5 text-purple-500 hover:bg-purple-500/10" title="View in PinArchive"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg></a>`
            : `<button data-pinarchive-import-id="${c.id}" data-username="${escHtml(c.username)}" class="rounded-lg border border-border p-1.5 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/10" title="Send to PinArchive"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg></button>`;

          return `<td class="py-4 px-4 text-right">
            <div class="flex items-center justify-end gap-1.5">
              ${pinArchiveBtn}
              <button data-drawer-id="${c.id}" class="rounded-lg border border-border p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground" title="Quick preview"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
              <button data-edit-id="${c.id}" class="rounded-lg border border-border p-1.5 text-muted-foreground hover:bg-amber-500/10 hover:text-amber-500" title="Edit"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
              <button data-paste-id="${c.id}" class="rounded-lg border border-border p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground" title="Paste DevTools Payload"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg></button>
              <button data-delete-id="${c.id}" data-username="${escHtml(c.username)}" class="rounded-lg p-1.5 text-muted-foreground hover:bg-rose-500/10 hover:text-rose-500" title="Delete"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
            </div></td>`;
        })(),
      };

      const cells = visibleCols().map(col => cellMap[col.key] || `<td class="py-4 px-4"></td>`).join('');
      return `<tr class="${isSel ? 'bg-primary/5' : 'hover:bg-muted/30'} transition-colors">${cells}</tr>`;
    }).join('');

    // Attach row events
    tbody.querySelectorAll<HTMLInputElement>('[data-row-select]').forEach(cb => {
      cb.addEventListener('change', () => {
        const id = cb.dataset.rowSelect!;
        if (cb.checked) selectedIds.add(id); else selectedIds.delete(id);
        renderTable();
      });
    });
    tbody.querySelectorAll<HTMLElement>('[data-click-tag]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedTag = btn.dataset.clickTag!;
        tagFilterSelect.value = selectedTag;
        page = 1;
        renderTable();
      });
    });
    tbody.querySelectorAll<HTMLElement>('[data-drawer-id]').forEach(btn => {
      btn.addEventListener('click', () => openDrawer(btn.dataset.drawerId!));
    });
    tbody.querySelectorAll<HTMLElement>('[data-edit-id]').forEach(btn => {
      btn.addEventListener('click', () => openEditModal(btn.dataset.editId!));
    });
    tbody.querySelectorAll<HTMLElement>('[data-paste-id]').forEach(btn => {
      btn.addEventListener('click', () => openPasteModal(btn.dataset.pasteId!));
    });
    tbody.querySelectorAll<HTMLElement>('[data-pinarchive-import-id]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const u = btn.dataset.username!;
        btn.setAttribute('disabled', 'true');
        try {
          const res = await fetch('/api/pinarchive/accounts-import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accounts: [{ username: u }] }),
          });
          const json = await res.json();
          if (!res.ok || !json.success) throw new Error(json.error || 'Failed to import to PinArchive');
          toast(`Sent @${u} to PinArchive!`);
          archivedUsernames.add(u.toLowerCase());
          renderTable();
        } catch (err: any) {
          toast(err.message || 'Import failed', 'error');
        } finally {
          btn.removeAttribute('disabled');
        }
      });
    });
    tbody.querySelectorAll<HTMLElement>('[data-delete-id]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.deleteId!, u = btn.dataset.username || 'this profile';
        const ok = await askConfirm('Remove Profile', `Are you sure you want to stop tracking @${u}? Historical snapshots will be retained.`);
        if (!ok) return;
        try {
          await deleteCompetitor(id);
          selectedIds.delete(id);
          toast(`Removed @${u}`);
          await loadWorkspaceData();
        } catch (err: any) {
          toast(err.message || 'Failed to delete', 'error');
        }
      });
    });
  }

  // ─── Selection bar ────────────────────────────────────────────────────────
  function updateSelectionBar() {
    const runUpdateLabel = $('run-full-update-label');
    const updateSelectedLabel = $('update-selected-label');
    if (selectedIds.size > 0) {
      selectionBar.classList.remove('hidden'); selectionBar.classList.add('flex');
      selectionCount.textContent = `${selectedIds.size} selected`;
      compareBtn.disabled = selectedIds.size < 2 || selectedIds.size > 4;
      compareBtn.title = selectedIds.size < 2 ? 'Select at least 2 profiles to compare' : (selectedIds.size > 4 ? 'Select up to 4 profiles' : 'Compare selected profiles');
      if (runUpdateLabel) runUpdateLabel.textContent = `⚡ Update Selected (${selectedIds.size})`;
      if (updateSelectedLabel) updateSelectedLabel.textContent = `⚡ Update selected (${selectedIds.size})`;
    } else {
      selectionBar.classList.add('hidden'); selectionBar.classList.remove('flex');
      if (runUpdateLabel) runUpdateLabel.textContent = '⚡ Run Full Update Now';
      if (updateSelectedLabel) updateSelectedLabel.textContent = '⚡ Update selected';
    }
  }

  $('clear-selection-btn').addEventListener('click', () => { selectedIds.clear(); renderTable(); });
  $('export-selected-btn').addEventListener('click', () => exportCSV(Array.from(selectedIds)));

  $('send-selected-to-pinarchive-btn')?.addEventListener('click', async () => {
    const selectedComps = competitorsList.filter(c => selectedIds.has(c.id));
    if (selectedComps.length === 0) return;
    const dispatchActive = ($('bulk-dispatch') as HTMLInputElement)?.checked || false;
    if (dispatchActive && selectedComps.length > 5) {
      toast('Dispatch is limited to 5 accounts max.', 'error');
      return;
    }
    if (selectedComps.length > 50) {
      toast('Import is limited to 50 accounts max per batch.', 'error');
      return;
    }
    const btn = $('send-selected-to-pinarchive-btn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch('/api/pinarchive/accounts-import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          accounts: selectedComps.map(c => ({ username: c.username })),
          dispatch: dispatchActive,
        }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'Bulk import failed');
      toast(`Imported ${json.imported} account(s), ${json.skipped} already archived.`);
      selectedComps.forEach(c => archivedUsernames.add((c.username || '').toLowerCase()));
      selectedIds.clear();
      renderTable();
    } catch (err: any) {
      toast(err.message || 'Bulk import failed', 'error');
    } finally {
      btn.disabled = false;
    }
  });

  // ─── Column visibility menu ───────────────────────────────────────────────
  const colMenu = $('col-visibility-menu');
  function buildColVisibilityMenu() {
    colMenu.innerHTML = COLUMN_DEFS.filter(c => !c.locked).map(c => `
      <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-muted/60 transition-colors text-xs font-medium text-foreground">
        <input type="checkbox" class="rounded accent-primary" data-col-key="${c.key}" ${colVisible[c.key] ? 'checked' : ''} />
        <span>${c.label}</span>
      </label>`).join('');
    colMenu.querySelectorAll<HTMLInputElement>('input[data-col-key]').forEach(cb => {
      cb.addEventListener('change', () => {
        colVisible[cb.dataset.colKey!] = cb.checked;
        localStorage.setItem('po_comp_cols', JSON.stringify(colVisible));
        renderTable();
      });
    });
  }
  $('col-visibility-btn').addEventListener('click', (e) => { e.stopPropagation(); colMenu.classList.toggle('hidden'); });
  document.addEventListener('click', (e) => {
    const w = $('col-visibility-wrapper');
    if (w && !w.contains(e.target as Node)) colMenu.classList.add('hidden');
  });

  // ─── Tags dropdown ────────────────────────────────────────────────────────
  function populateTagDropdown() {
    const s = new Set<string>();
    competitorsList.forEach(c => Array.isArray(c.tags) && c.tags.forEach(t => s.add(t)));
    const arr = Array.from(s).sort();
    tagFilterSelect.innerHTML = `<option value="all">All Tags</option>` +
      arr.map(t => `<option value="${escHtml(t)}" ${selectedTag === t ? 'selected' : ''}>#${escHtml(t)}</option>`).join('');
  }

  // ─── Pagination & rows per page ───────────────────────────────────────────
  rowsSelect.value = String(rowsPerPage);
  rowsSelect.addEventListener('change', () => {
    rowsPerPage = Number(rowsSelect.value);
    localStorage.setItem('po_comp_rows', String(rowsPerPage));
    page = 1;
    renderTable();
  });
  prevBtn.addEventListener('click', () => { if (page > 1) { page--; renderTable(); } });
  nextBtn.addEventListener('click', () => { page++; renderTable(); });

  // ─── Filter tabs & search ─────────────────────────────────────────────────
  const typeTabBtns = document.querySelectorAll<HTMLButtonElement>('.account-type-tab-btn');
  function syncTabClasses() {
    typeTabBtns.forEach(b => {
      const active = (b.dataset.typeTab || 'all') === activeTypeTab;
      b.className = active
        ? 'account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold bg-background text-foreground shadow-xs transition-all'
        : 'account-type-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all';
    });
  }
  typeTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeTypeTab = (btn.dataset.typeTab as any) || 'all';
      syncTabClasses();
      page = 1;
      renderTable();
    });
  });

  tagFilterSelect.addEventListener('change', () => { selectedTag = tagFilterSelect.value; page = 1; renderTable(); });

  let searchDebounce: any;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => { searchQuery = searchInput.value.trim(); page = 1; renderTable(); }, 180);
  });

  // ─── CSV Export ───────────────────────────────────────────────────────────
  function exportCSV(idFilter?: string[]) {
    const list = idFilter && idFilter.length
      ? competitorsList.filter(c => idFilter.includes(c.id))
      : applySortAndFilter();
    if (!list.length) { toast('No profiles to export', 'info'); return; }

    const headers = ['Username', 'Full Name', 'Account Type', 'Niche', 'Monthly Reach', 'Profile Views', 'Followers', 'Pins', 'Boards', 'Last Pin At', 'Tags'];
    const rows = list.map(c => [
      c.username,
      c.full_name || '',
      c.account_type || 'competitor',
      c.niche || '',
      c.profile_reach ?? '',
      c.profile_views ?? '',
      c.follower_count ?? '',
      c.pin_count ?? '',
      c.boards_count ?? '',
      c.last_pin_at || '',
      Array.isArray(c.tags) ? c.tags.join(';') : '',
    ]);

    const csv = [headers, ...rows]
      .map(r => r.map(v => `"${String(v ?? '').replace(/"/g, '""')}"`).join(','))
      .join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pinorbit-competitors-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    toast(`Exported ${list.length} profiles to CSV`);
  }
  $('export-csv-btn').addEventListener('click', () => exportCSV());

  // ─── Side Drawer ──────────────────────────────────────────────────────────
  function openDrawer(id: string) {
    const c = competitorsList.find(x => x.id === id);
    if (!c) return;

    const drawerAvatar = c.avatar_url && /^https?:\/\//i.test(c.avatar_url) ? c.avatar_url : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&h=200&q=80';
    drawerBody.innerHTML = `
      <div class="flex items-center gap-3 pb-3 border-b border-border">
        <img src="${escHtml(drawerAvatar)}" class="h-12 w-12 rounded-full object-cover border border-border" />
        <div class="min-w-0 flex-1">
          <div class="text-sm font-bold text-foreground truncate">${escHtml(c.full_name || c.username)}</div>
          <div class="text-xs text-muted-foreground">@${escHtml(c.username)}</div>
        </div>
        <a href="/competitors/details?id=${c.id}" class="rounded-xl bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow-sm hover:bg-primary/90">Full Details →</a>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-xl border border-border bg-background p-3">
          <div class="text-[10px] text-muted-foreground uppercase font-semibold">Monthly Reach</div>
          <div class="text-lg font-bold text-emerald-500 mt-0.5">${fmtCompact(c.profile_reach)}</div>
        </div>
        <div class="rounded-xl border border-border bg-background p-3">
          <div class="text-[10px] text-muted-foreground uppercase font-semibold">Profile Views</div>
          <div class="text-lg font-bold text-foreground mt-0.5">${fmtCompact(c.profile_views)}</div>
        </div>
        <div class="rounded-xl border border-border bg-background p-3">
          <div class="text-[10px] text-muted-foreground uppercase font-semibold">Followers</div>
          <div class="text-lg font-bold text-foreground mt-0.5">${fmtCompact(c.follower_count)}</div>
        </div>
        <div class="rounded-xl border border-border bg-background p-3">
          <div class="text-[10px] text-muted-foreground uppercase font-semibold">Pins</div>
          <div class="text-lg font-bold text-foreground mt-0.5">${fmtCompact(c.pin_count)}</div>
        </div>
      </div>
      <div class="space-y-2">
        <div class="text-xs font-bold text-foreground">Reach History (Last 14d)</div>
        <div id="drawer-sparkline" class="rounded-xl border border-border bg-background p-3">
          <div class="text-xs text-muted-foreground animate-pulse">Loading history…</div>
        </div>
      </div>
      <div class="space-y-2">
        <div class="text-xs font-bold text-foreground">Strategy Notes</div>
        <div class="rounded-xl border border-border bg-background p-3 text-xs text-muted-foreground whitespace-pre-wrap">${escHtml(c.notes || 'No internal notes set yet.')}</div>
      </div>`;

    drawer.classList.remove('translate-x-full');
    drawerBackdrop.classList.remove('pointer-events-none');
    drawerBackdrop.classList.remove('opacity-0');
    drawerBackdrop.classList.add('opacity-100');

    // Async load details for sparkline
    getCompetitorDetails(c.id).then(det => {
      const el = $('drawer-sparkline');
      if (!el) return;
      if (!det || !det.snapshots || det.snapshots.length < 2) {
        el.innerHTML = '<div class="text-[11px] text-muted-foreground">Not enough snapshot history yet. Ingest DevTools payloads to build timeline.</div>';
        return;
      }
      const vals = det.snapshots.map(s => s.profile_reach || 0);
      el.innerHTML = sparkline(vals, 'text-emerald-500');
    }).catch(() => {
      const el = $('drawer-sparkline');
      if (el) el.innerHTML = '<div class="text-[11px] text-muted-foreground">Could not load sparkline.</div>';
    });
  }

  function closeDrawer() {
    drawer.classList.add('translate-x-full');
    drawerBackdrop.classList.add('opacity-0');
    drawerBackdrop.classList.remove('opacity-100');
    drawerBackdrop.classList.add('pointer-events-none');
  }
  $('drawer-close').addEventListener('click', closeDrawer);
  drawerBackdrop.addEventListener('click', closeDrawer);

  // ─── Compare modal ────────────────────────────────────────────────────────
  compareBtn.addEventListener('click', async () => {
    const list = competitorsList.filter(c => selectedIds.has(c.id));
    if (list.length < 2) return;

    // Load deltas in parallel
    const details = await Promise.all(list.map(c => getCompetitorDetails(c.id).catch(() => null)));

    const body = $('compare-body');
    body.innerHTML = `
      <table class="w-full text-left text-xs border border-border">
        <thead>
          <tr class="bg-muted border-b border-border">
            <th class="py-3 px-4 text-muted-foreground font-semibold">Metric</th>
            ${list.map(c => {
              const compAvatar = c.avatar_url && /^https?:\/\//i.test(c.avatar_url) ? c.avatar_url : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&h=200&q=80';
              return `
              <th class="py-3 px-4 font-bold text-foreground">
                <div class="flex items-center gap-2">
                  <img src="${escHtml(compAvatar)}" class="h-6 w-6 rounded-full" />
                  <span>@${escHtml(c.username)}</span>
                </div>
              </th>`;
            }).join('')}
          </tr>
        </thead>
        <tbody class="divide-y divide-border bg-card">
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Type</td>${list.map(c => `<td class="py-2.5 px-4">${c.account_type === 'own' ? '👤 My Account' : '🎯 Competitor'}</td>`).join('')}</tr>
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Niche</td>${list.map(c => `<td class="py-2.5 px-4">${escHtml(c.niche || '—')}</td>`).join('')}</tr>
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Monthly Reach</td>${list.map((c, i) => {
            const d = details[i]?.deltas?.reach;
            return `<td class="py-2.5 px-4 font-bold text-emerald-500">${fmtCompact(c.profile_reach)} ${d ? deltaChip(d.change, d.percent) : ''}</td>`;
          }).join('')}</tr>
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Profile Views</td>${list.map((c, i) => {
            const d = details[i]?.deltas?.views;
            return `<td class="py-2.5 px-4 font-semibold text-foreground">${fmtCompact(c.profile_views)} ${d ? deltaChip(d.change, d.percent) : ''}</td>`;
          }).join('')}</tr>
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Followers</td>${list.map((c, i) => {
            const d = details[i]?.deltas?.followers;
            return `<td class="py-2.5 px-4 font-semibold text-foreground">${fmtCompact(c.follower_count)} ${d ? deltaChip(d.change, d.percent) : ''}</td>`;
          }).join('')}</tr>
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Pins</td>${list.map(c => `<td class="py-2.5 px-4 text-foreground">${fmtCompact(c.pin_count)}</td>`).join('')}</tr>
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Boards</td>${list.map(c => `<td class="py-2.5 px-4 text-foreground">${c.boards_count ?? 0}</td>`).join('')}</tr>
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Last Pin</td>${list.map(c => `<td class="py-2.5 px-4 text-muted-foreground">${timeAgo(c.last_pin_at)}</td>`).join('')}</tr>
          <tr><td class="py-2.5 px-4 font-semibold text-muted-foreground">Actions</td>${list.map(c => `<td class="py-2.5 px-4"><a href="/competitors/details?id=${c.id}" class="text-primary font-bold hover:underline">Details →</a></td>`).join('')}</tr>
        </tbody>
      </table>`;
    showOverlay($('compare-modal'));
  });

  // ─── Add profile modal ────────────────────────────────────────────────────
  $('open-add-competitor-modal').addEventListener('click', () => {
    $('add-competitor-error').classList.add('hidden');
    ($('add-competitor-form') as HTMLFormElement).reset();
    showOverlay($('add-competitor-modal'));
  });
  $('add-competitor-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const typeRadio = document.querySelector<HTMLInputElement>('input[name="account_type_radio"]:checked');
    const u = ($('competitor-username-input') as HTMLInputElement).value.trim();
    const niche = ($('competitor-niche-input') as HTMLInputElement).value.trim();
    const tags = ($('competitor-tags-input') as HTMLInputElement).value.trim();
    const notes = ($('competitor-notes-input') as HTMLTextAreaElement).value.trim();

    try {
      await addCompetitor({
        username: u, niche, notes, tags,
        account_type: (typeRadio?.value as any) || 'competitor',
      });
      hideOverlay($('add-competitor-modal'));
      toast(`Started tracking @${u.replace(/^@/, '')}`);
      await loadWorkspaceData();
    } catch (err: any) {
      const er = $('add-competitor-error');
      er.textContent = err.message || 'Failed to add profile';
      er.classList.remove('hidden');
    }
  });

  // ─── Edit profile modal ───────────────────────────────────────────────────
  function openEditModal(id: string) {
    const c = competitorsList.find(x => x.id === id);
    if (!c) return;
    $('edit-competitor-error').classList.add('hidden');
    ($('edit-competitor-id') as HTMLInputElement).value = id;
    ($('edit-fullname-input') as HTMLInputElement).value = c.full_name || '';
    ($('edit-username-input') as HTMLInputElement).value = c.username || '';
    ($('edit-niche-input') as HTMLInputElement).value = c.niche || '';
    ($('edit-tags-input') as HTMLInputElement).value = Array.isArray(c.tags) ? c.tags.join(', ') : '';
    document.querySelectorAll<HTMLInputElement>('input[name="edit_account_type_radio"]').forEach(r => {
      r.checked = r.value === (c.account_type === 'own' ? 'own' : 'competitor');
    });
    showOverlay($('edit-competitor-modal'));
  }
  $('edit-competitor-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = ($('edit-competitor-id') as HTMLInputElement).value;
    const typeRadio = document.querySelector<HTMLInputElement>('input[name="edit_account_type_radio"]:checked');
    const rawTags = ($('edit-tags-input') as HTMLInputElement).value;
    const tagsArr = rawTags.split(',').map(t => t.trim()).filter(Boolean);
    const btn = $('submit-edit-competitor-modal') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      await updateCompetitor(id, {
        full_name: ($('edit-fullname-input') as HTMLInputElement).value || undefined,
        username: ($('edit-username-input') as HTMLInputElement).value || undefined,
        account_type: (typeRadio?.value as any) || 'competitor',
        niche: ($('edit-niche-input') as HTMLInputElement).value || undefined,
        tags: tagsArr,
      });
      hideOverlay($('edit-competitor-modal'));
      toast('Profile updated');
      await loadWorkspaceData();
    } catch (err: any) {
      const er = $('edit-competitor-error');
      er.textContent = err.message || 'Failed to update';
      er.classList.remove('hidden');
    } finally {
      btn.disabled = false; btn.textContent = 'Save Changes';
    }
  });

  // ─── Paste payload modal ──────────────────────────────────────────────────
  function openPasteModal(id?: string) {
    selectedCompetitorIdForPayload = id || null;
    const sel = $('payload-target-competitor-select') as HTMLSelectElement;
    sel.innerHTML = `<option value="" disabled ${!id ? 'selected' : ''}>Select profile…</option>` +
      competitorsList.map(c => `<option value="${c.id}" ${c.id === id ? 'selected' : ''}>${escHtml(c.full_name || c.username)} (@${escHtml(c.username)})</option>`).join('');
    $('paste-payload-error').classList.add('hidden');
    ($('paste-payload-form') as HTMLFormElement).reset();
    $('detected-payload-type').textContent = 'Waiting for paste...';
    $('detected-payload-type').className = 'rounded bg-muted px-2 py-0.5 text-[10px] font-semibold text-foreground';
    showOverlay($('paste-payload-modal'));
  }
  $('open-paste-payload-modal')?.addEventListener('click', () => openPasteModal());

  const rawPayloadTextarea = $('raw-payload-textarea') as HTMLTextAreaElement;
  rawPayloadTextarea?.addEventListener('input', () => {
    const text = rawPayloadTextarea.value.trim();
    const tag = $('detected-payload-type');
    if (!tag) return;
    if (!text) { tag.textContent = 'Waiting for paste...'; tag.className = 'rounded bg-muted px-2 py-0.5 text-[10px] font-semibold text-foreground'; return; }
    const p = parsePinterestPayload(text);
    if (p.type === 'user_profile') {
      tag.textContent = '✓ User Profile (UserResource)';
      tag.className = 'rounded bg-emerald-500/20 text-emerald-500 px-2 py-0.5 text-[10px] font-bold';
    } else if (p.type === 'user_boards') {
      tag.textContent = '✓ User Boards (BoardsResource)';
      tag.className = 'rounded bg-primary/20 text-primary px-2 py-0.5 text-[10px] font-bold';
    } else {
      tag.textContent = '✕ Unknown Payload';
      tag.className = 'rounded bg-rose-500/20 text-rose-500 px-2 py-0.5 text-[10px] font-bold';
    }
  });

  $('paste-payload-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const sel = $('payload-target-competitor-select') as HTMLSelectElement;
    const targetId = sel?.value;
    const text = rawPayloadTextarea?.value.trim() || '';
    if (!targetId) {
      const er = $('paste-payload-error');
      if (er) { er.textContent = 'Please select a target profile'; er.classList.remove('hidden'); }
      return;
    }
    const res = await ingestDevToolsPayload(targetId, text);
    if (res.success) {
      hideOverlay($('paste-payload-modal'));
      toast(res.message);
      await loadWorkspaceData();
    } else {
      const er = $('paste-payload-error');
      if (er) { er.textContent = res.message; er.classList.remove('hidden'); }
    }
  });

  let activePollingInterval: any = null;

  function pollJobStatus(jobId: string, totalCount: number | 'all') {
    if (activePollingInterval) clearInterval(activePollingInterval);

    const startTime = Date.now();
    activePollingInterval = setInterval(async () => {
      try {
        const workspaceId = getActiveWorkspaceId();
        const res = await apiJSON(`/api/admin/competitor-ops?job_id=${jobId}&workspace_id=${workspaceId}`);
        if (res.job) {
          const { status, items_processed = 0, error_message } = res.job;
          const countStr = totalCount === 'all' ? `${items_processed}` : `${items_processed}/${totalCount}`;
          toast(`⚡ Scraping in progress (${countStr} profiles processed)...`, 'info');

          if (status === 'completed') {
            clearInterval(activePollingInterval);
            activePollingInterval = null;
            toast(`✅ Competitor update complete! (${items_processed} profiles refreshed)`, 'success');
            await loadWorkspaceData();
          } else if (status === 'failed') {
            clearInterval(activePollingInterval);
            activePollingInterval = null;
            toast(`❌ Competitor scraping failed: ${error_message || 'Workflow error'}`, 'error');
            await loadWorkspaceData();
          }
        }

        // Timeout safety: stop polling after 5 minutes
        if (Date.now() - startTime > 300000) {
          clearInterval(activePollingInterval);
          activePollingInterval = null;
        }
      } catch {
        // fail-lazy during transient network polling
      }
    }, 2000);
  }

  // ─── Run Full / Targeted Update ──────────────────────────────────────────
  async function executeCompetitorUpdate(targetIds?: string[], force: boolean = false) {
    const ids = targetIds ?? (selectedIds.size > 0 ? Array.from(selectedIds) : []);
    const runBtn = $('run-full-update-btn') as HTMLButtonElement;
    const runIcon = $('run-full-update-icon');
    const selBtn = $('update-selected-btn') as HTMLButtonElement;
    const selIcon = $('update-selected-icon');

    if (runBtn) runBtn.disabled = true;
    if (selBtn) selBtn.disabled = true;
    runIcon?.classList.add('animate-spin');
    selIcon?.classList.add('animate-spin');

    try {
      const workspaceId = getActiveWorkspaceId();
      const payload: Record<string, any> = {
        workspace_id: workspaceId,
        force,
      };

      if (ids.length > 0) {
        payload.scope = 'selected';
        payload.ids = ids;
      } else {
        payload.scope = 'all';
      }

      const res = await apiJSON('/api/admin/competitor-ops', {
        method: 'POST',
        body: JSON.stringify(payload),
      });

      if (res.job_id) {
        const shortJobId = res.job_id.slice(0, 8);
        const count = ids.length > 0 ? ids.length : 'all';
        toast(`🚀 Workflow dispatched (#${shortJobId}) — scraping profiles on background runner...`, 'success');
        pollJobStatus(res.job_id, count);
      } else {
        toast('Update dispatched successfully', 'success');
        await loadWorkspaceData();
      }
    } catch (err: any) {
      toast(`Failed to dispatch update: ${err.message || 'Server error'}`, 'error');
    } finally {
      runIcon?.classList.remove('animate-spin');
      selIcon?.classList.remove('animate-spin');
      if (runBtn) runBtn.disabled = false;
      if (selBtn) selBtn.disabled = false;
    }
  }

  $('run-full-update-btn')?.addEventListener('click', () => executeCompetitorUpdate());
  $('update-selected-btn')?.addEventListener('click', () => executeCompetitorUpdate());

  // ─── Refresh button ───────────────────────────────────────────────────────
  $('refresh-btn').addEventListener('click', async () => {
    const icon = $('refresh-icon');
    icon.classList.add('animate-spin');
    try {
      await loadWorkspaceData();
      toast('Competitor data refreshed');
    } finally {
      setTimeout(() => icon.classList.remove('animate-spin'), 400);
    }
  });

  // ─── Keyboard shortcuts ───────────────────────────────────────────────────
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== searchInput && !(document.activeElement instanceof HTMLInputElement) && !(document.activeElement instanceof HTMLTextAreaElement)) {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    } else if (e.key === 'Escape') {
      if (!drawer.classList.contains('translate-x-full')) closeDrawer();
      document.querySelectorAll<HTMLElement>('.overlay-root').forEach(m => {
        if (!m.classList.contains('hidden')) hideOverlay(m);
      });
    }
  });

  // ─── Data loader ──────────────────────────────────────────────────────────
  async function loadArchivedUsernames() {
    try {
      const res = await fetch('/api/pinarchive/archived-usernames');
      if (res.ok) {
        const json = await res.json();
        if (json.success && Array.isArray(json.usernames)) {
          archivedUsernames = new Set(json.usernames.map((u: string) => String(u).toLowerCase()));
        }
      }
    } catch (e) {
      console.warn('Failed to load archived usernames:', e);
    }
  }

  async function loadWorkspaceData() {
    renderSkeleton();
    try {
      await Promise.all([
        getCompetitors().then(list => { competitorsList = list; }),
        loadArchivedUsernames(),
      ]);
      populateTagDropdown();
      renderKPIs();
      renderTable();
      buildColVisibilityMenu();
      $('updated-at').textContent = `Updated ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
    } catch (err: any) {
      toast(`Failed to load data: ${err.message}`, 'error');
    }
  }

  // ─── Boot ─────────────────────────────────────────────────────────────────
  loadWorkspaceData();
</script>
