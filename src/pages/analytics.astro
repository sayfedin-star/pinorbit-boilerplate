---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

export const prerender = false;
---

<Layout title="Pinterest Analytics" description="Multi-tenant Pinterest performance analytics, connection statistics, and control plane.">
  <!-- Page Header -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <SectionHeader
      title="Pinner Analytics"
      description="Aggregated reach, engagement metrics, and operational control plane across all connected Pinterest accounts."
    />

    <!-- Global Window Selector & Action Buttons -->
    <div class="flex flex-wrap items-center gap-3 self-start sm:self-auto">
      <!-- Time Window Tabs (7D / 14D / 30D / 90D) -->
      <div class="inline-flex rounded-xl border border-border bg-card p-1 shadow-sm" id="global-window-toggles">
        <button
          data-window="7"
          class="window-btn rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          7D
        </button>
        <button
          data-window="14"
          class="window-btn rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          14D
        </button>
        <button
          data-window="30"
          class="window-btn active rounded-lg bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground shadow-sm transition-all"
        >
          30D
        </button>
        <button
          data-window="90"
          class="window-btn rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground"
        >
          90D
        </button>
      </div>

      <!-- Secrets Page Link -->
      <a
        href="/analytics/secrets"
        class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all"
        title="Manage Webhook Ingest Secrets"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-1.5 1.5L10 13l-4 4-2-2 4-4 7.5-7.5m1.5-1.5L21 2z"/><circle cx="7.5" cy="16.5" r="3.5"/></svg>
        <span>Secrets</span>
      </a>

      <!-- Refresh Button -->
      <button
        id="refresh-connections-btn"
        class="inline-flex items-center justify-center rounded-xl border border-border bg-card p-2 text-muted-foreground shadow-sm hover:bg-muted hover:text-foreground transition-all"
        title="Refresh Connections"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
          <path d="M16 21h5v-5"/>
        </svg>
      </button>

      <!-- Add Connection Button -->
      <button
        id="add-connection-btn"
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-3.5 py-2 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        <span>Add Connection</span>
      </button>
    </div>
  </div>

  <!-- Operational Ingestion Sync Status Bar -->
  <div class="mb-6 rounded-2xl border border-border bg-card p-4 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v4"/><path d="M12 18v4"/><path d="m4.93 4.93 2.83 2.83"/><path d="m16.24 16.24 2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="m4.93 19.07 2.83-2.83"/><path d="m16.24 7.76 2.83-2.83"/>
          </svg>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-xs font-bold text-foreground">Pinterest Analytics Control Plane</h3>
            <span id="cache-status-badge" class="rounded-full bg-blue-500/10 px-2 py-0.5 text-[10px] font-semibold text-blue-600 dark:text-blue-400">
              Project 3 Warehouse
            </span>
          </div>
          <p class="text-[11px] text-muted-foreground mt-0.5">
            Ingestion source: Pinterest API v5 via Make.com with FastCron automation
          </p>
        </div>
      </div>

      <div class="flex items-center gap-4 text-xs text-muted-foreground">
        <div>
          <span class="font-medium">Total Accounts:</span>
          <span id="total-accounts-count" class="font-semibold text-foreground ml-1">---</span>
        </div>
        <div>
          <span class="font-medium">Active Window:</span>
          <span id="active-window-label" class="font-semibold text-primary ml-1">30 Days</span>
        </div>
      </div>
    </div>
  </div>

  <!-- V22.1 Connections Statistics Table -->
  <div class="mb-10 rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
    <div class="flex flex-col gap-3 border-b border-border p-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-base font-bold text-foreground">Connections Performance Overview</h2>
        <p class="text-xs text-muted-foreground">Aggregated metrics for each connected Pinterest account over the selected window</p>
      </div>
      <div class="text-xs text-muted-foreground">
        Click an account name to view daily logs and top 50 pins
      </div>
    </div>

    <!-- Table with horizontal scrolling -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="border-b border-border bg-muted/20 text-[11px] uppercase tracking-wider text-muted-foreground font-semibold">
          <tr>
            <th class="py-3 px-4 min-w-[200px]">Display Name</th>
            <th class="py-3 px-4 text-center">Status</th>
            <th class="py-3 px-4 min-w-[140px]">Last Sync</th>
            <th class="py-3 px-4 text-right">Impressions</th>
            <th class="py-3 px-4 text-right">Engagements</th>
            <th class="py-3 px-4 text-right">Pin Clicks</th>
            <th class="py-3 px-4 text-right">Outbound Clicks</th>
            <th class="py-3 px-4 text-right">Saves</th>
            <th class="py-3 px-4 text-right min-w-[140px]">Actions</th>
          </tr>
        </thead>
        <tbody id="connections-tbody" class="divide-y divide-border">
          <tr>
            <td colspan="9" class="py-12 text-center text-muted-foreground">
              <div class="inline-flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <span>Loading connections statistics...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add Connection Modal -->
  <div id="add-connection-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-background/80 backdrop-blur-sm">
    <div class="flex min-h-screen items-center justify-center p-4">
      <div class="relative w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl">
        <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
          <h3 class="text-base font-bold text-foreground">Add Pinterest Connection</h3>
          <button id="close-add-modal-btn" class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <form id="add-connection-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-foreground mb-1">Account Display Name</label>
            <input
              type="text"
              id="new-connection-name"
              required
              placeholder="e.g. crispcrumbs or my_pinterest_handle"
              class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
            <p class="text-[10px] text-muted-foreground mt-1">Unique label identifying this Pinterest account.</p>
          </div>

          <div class="flex items-center justify-end gap-2 pt-2">
            <button
              type="button"
              id="cancel-add-modal-btn"
              class="rounded-xl border border-border px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all"
            >
              Cancel
            </button>
            <button
              type="submit"
              id="submit-add-btn"
              class="rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground hover:bg-primary/90 transition-all"
            >
              Create Connection
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- V23 Upgraded Settings Slide-over Drawer -->
  <div id="settings-drawer" class="fixed inset-0 z-50 hidden overflow-hidden">
    <div id="settings-drawer-backdrop" class="absolute inset-0 bg-background/80 backdrop-blur-sm transition-opacity"></div>
    <div class="fixed inset-y-0 right-0 flex max-w-full pl-6 sm:pl-10">
      <div class="w-screen max-w-xl border-l border-border bg-card p-6 shadow-2xl flex flex-col justify-between overflow-y-auto">
        <div>
          <!-- Drawer Header -->
          <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
            <div>
              <div class="flex items-center gap-2">
                <h3 id="drawer-connection-name" class="text-base font-bold text-foreground">Connection Settings</h3>
                <span id="drawer-connection-status" class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">
                  Active
                </span>
                <button
                  type="button"
                  id="drawer-reenable-btn"
                  class="hidden rounded-lg bg-emerald-500/10 border border-emerald-500/30 px-2 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/20"
                >
                  Re-enable (401)
                </button>
              </div>
              <p class="text-xs text-muted-foreground mt-0.5">FastCron automation, date offsets, and pipeline controls</p>
            </div>
            <button id="close-settings-drawer-btn" class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>

          <!-- V23.1 Connection Health Strip (Top Banner from /runs API) -->
          <div id="drawer-health-strip" class="mb-5 rounded-xl border border-border/80 bg-muted/30 p-3.5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span id="health-dot" class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span id="health-label" class="text-xs font-bold text-foreground">Connection Healthy</span>
              </div>
              <div class="flex items-center gap-3 text-[11px] text-muted-foreground">
                <span>Total Runs: <strong id="health-total-runs" class="text-foreground">0</strong></span>
                <span>•</span>
                <span>Failures: <strong id="health-failures" class="text-foreground">0</strong></span>
                <span>•</span>
                <span>Last Success: <strong id="health-last-success" class="text-foreground">Never</strong></span>
              </div>
            </div>
          </div>

          <!-- Form: Pipelines & Controls -->
          <form id="connection-settings-form" class="space-y-6">
            <input type="hidden" id="drawer-connection-id" value="" />

            <!-- Pipeline A: Account Analytics -->
            <div class="space-y-3.5 rounded-xl border border-border/80 bg-muted/20 p-4">
              <div class="flex items-center justify-between border-b border-border/60 pb-2.5">
                <div>
                  <span class="text-xs font-bold text-foreground">Pipeline A: Account Analytics</span>
                  <div class="flex items-center gap-2 text-[10px] text-muted-foreground mt-0.5">
                    <span id="pipeline-a-job-id" class="font-mono">FastCron Job: Not configured</span>
                  </div>
                </div>
                <span id="drawer-channel-a-badge" class="rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-semibold text-amber-600 dark:text-amber-400">
                  Pending
                </span>
              </div>

              <div>
                <label class="block text-[11px] font-semibold text-foreground mb-1">Make.com Webhook URL</label>
                <input
                  type="url"
                  id="setting-analytics-webhook"
                  placeholder="https://hook.us2.make.com/..."
                  class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-[11px] font-semibold text-foreground mb-1">Sync Time (HH:MM)</label>
                  <input
                    type="text"
                    id="setting-analytics-time"
                    placeholder="04:00"
                    class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-foreground mb-1">Timezone</label>
                  <select
                    id="setting-workspace-timezone"
                    class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  >
                    <option value="UTC">UTC (Coordinated Universal Time)</option>
                    <option value="America/New_York">America/New_York (EST/EDT)</option>
                    <option value="America/Chicago">America/Chicago (CST/CDT)</option>
                    <option value="America/Los_Angeles">America/Los_Angeles (PST/PDT)</option>
                    <option value="Europe/London">Europe/London (GMT/BST)</option>
                    <option value="Europe/Paris">Europe/Paris (CET/CEST)</option>
                  </select>
                </div>
              </div>

              <!-- Date Offsets (Pipeline A) -->
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block text-[10px] font-semibold text-muted-foreground mb-0.5">Start Offset (days ago)</label>
                  <input
                    type="number"
                    id="setting-analytics-start-offset"
                    min="1"
                    max="90"
                    value="7"
                    class="w-full rounded-xl border border-border bg-card px-3 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
                <div>
                  <label class="block text-[10px] font-semibold text-muted-foreground mb-0.5">End Offset (days ago)</label>
                  <input
                    type="number"
                    id="setting-analytics-end-offset"
                    min="0"
                    max="60"
                    value="1"
                    class="w-full rounded-xl border border-border bg-card px-3 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
              </div>

              <!-- Actions Row for Pipeline A -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1.5">
                <button
                  type="button"
                  id="ping-analytics-btn"
                  class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                >
                  Test Ping
                </button>
                <button
                  type="button"
                  id="run-analytics-btn"
                  class="rounded-xl bg-primary/10 border border-primary/20 px-2.5 py-1.5 text-[11px] font-semibold text-primary hover:bg-primary/20 transition-all"
                >
                  Run Now
                </button>
                <button
                  type="button"
                  id="sync-fastcron-a-btn"
                  class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                >
                  ⚡ Sync Schedule
                </button>
                <button
                  type="button"
                  id="view-logs-a-btn"
                  class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                >
                  📋 View Logs
                </button>
              </div>
            </div>

            <!-- Pipeline B: Ranked Top Pins -->
            <div class="space-y-3.5 rounded-xl border border-border/80 bg-muted/20 p-4">
              <div class="flex items-center justify-between border-b border-border/60 pb-2.5">
                <div>
                  <span class="text-xs font-bold text-foreground">Pipeline B: Ranked Top Pins</span>
                  <div class="flex items-center gap-2 text-[10px] text-muted-foreground mt-0.5">
                    <span id="pipeline-b-job-id" class="font-mono">FastCron Job: Not configured</span>
                  </div>
                </div>
                <span id="drawer-channel-b-badge" class="rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-semibold text-amber-600 dark:text-amber-400">
                  Pending
                </span>
              </div>

              <div>
                <label class="block text-[11px] font-semibold text-foreground mb-1">Make.com Webhook URL</label>
                <input
                  type="url"
                  id="setting-top-pins-webhook"
                  placeholder="https://hook.us2.make.com/..."
                  class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <label class="block text-[11px] font-semibold text-foreground mb-1">Sync Time (HH:MM)</label>
                  <input
                    type="text"
                    id="setting-top-pins-time"
                    placeholder="04:30"
                    class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
                <div>
                  <label class="block text-[11px] font-semibold text-foreground mb-1">Number of Pins (1–50)</label>
                  <input
                    type="number"
                    id="setting-top-pins-num-pins"
                    min="1"
                    max="50"
                    value="50"
                    class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
              </div>

              <!-- Date Offsets (Pipeline B) -->
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block text-[10px] font-semibold text-muted-foreground mb-0.5">Start Offset (days ago)</label>
                  <input
                    type="number"
                    id="setting-top-pins-start-offset"
                    min="1"
                    max="90"
                    value="7"
                    class="w-full rounded-xl border border-border bg-card px-3 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
                <div>
                  <label class="block text-[10px] font-semibold text-muted-foreground mb-0.5">End Offset (days ago)</label>
                  <input
                    type="number"
                    id="setting-top-pins-end-offset"
                    min="0"
                    max="60"
                    value="2"
                    class="w-full rounded-xl border border-border bg-card px-3 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                  />
                </div>
              </div>

              <!-- V23 Sort Modes Multi-Select Chips -->
              <div class="space-y-1.5 pt-1">
                <label class="block text-[11px] font-semibold text-foreground">Sort Modes (Click to Toggle)</label>
                <div class="flex flex-wrap gap-1.5" id="sort-modes-chips-container">
                  <button type="button" data-mode="IMPRESSION" class="sort-chip active rounded-lg border border-primary bg-primary/10 px-2 py-1 text-[11px] font-semibold text-primary">IMPRESSION</button>
                  <button type="button" data-mode="OUTBOUND_CLICK" class="sort-chip active rounded-lg border border-primary bg-primary/10 px-2 py-1 text-[11px] font-semibold text-primary">OUTBOUND_CLICK</button>
                  <button type="button" data-mode="SAVE" class="sort-chip active rounded-lg border border-primary bg-primary/10 px-2 py-1 text-[11px] font-semibold text-primary">SAVE</button>
                  <button type="button" data-mode="ENGAGEMENT" class="sort-chip active rounded-lg border border-primary bg-primary/10 px-2 py-1 text-[11px] font-semibold text-primary">ENGAGEMENT</button>
                  <button type="button" data-mode="PIN_CLICK" class="sort-chip active rounded-lg border border-primary bg-primary/10 px-2 py-1 text-[11px] font-semibold text-primary">PIN_CLICK</button>
                </div>
              </div>

              <!-- Actions Row for Pipeline B -->
              <div class="flex flex-wrap items-center gap-1.5 pt-1.5">
                <button
                  type="button"
                  id="ping-top-pins-btn"
                  class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                >
                  Test Ping
                </button>
                <button
                  type="button"
                  id="run-top-pins-btn"
                  class="rounded-xl bg-primary/10 border border-primary/20 px-2.5 py-1.5 text-[11px] font-semibold text-primary hover:bg-primary/20 transition-all"
                >
                  Run Now
                </button>
                <button
                  type="button"
                  id="sync-fastcron-b-btn"
                  class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                >
                  ⚡ Sync Schedule
                </button>
                <button
                  type="button"
                  id="view-logs-b-btn"
                  class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                >
                  📋 View Logs
                </button>
              </div>
            </div>

            <!-- V23 & R16 FastCron Options Card -->
            <div class="space-y-3 rounded-xl border border-border/80 bg-muted/20 p-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-foreground">FastCron Execution Options</span>
                <span id="fastcron-token-status-badge" class="rounded-full bg-slate-500/10 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-400">
                  Token: Workspace Default
                </span>
              </div>

              <!-- Connection-Specific FastCron Token (Write-Only) -->
              <div class="space-y-1">
                <label class="block text-[10px] font-semibold text-muted-foreground">FastCron API Token (Write-Only Override)</label>
                <input
                  type="password"
                  id="setting-fastcron-token"
                  placeholder="Leave empty to use workspace default..."
                  autocomplete="new-password"
                  class="w-full rounded-xl border border-border bg-card px-2.5 py-1.5 text-xs text-foreground font-mono focus:border-primary focus:outline-none"
                />
                <p class="text-[10px] text-muted-foreground">
                  Overrides the workspace FastCron API token specifically for this connection.
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <div>
                  <label class="block text-[10px] font-semibold text-muted-foreground mb-1">Email Failure Notify</label>
                  <select
                    id="setting-fastcron-notify"
                    class="w-full rounded-xl border border-border bg-card px-2.5 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
                  >
                    <option value="true">Enabled</option>
                    <option value="false">Disabled</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[10px] font-semibold text-muted-foreground mb-1">Timeout (5–60s)</label>
                  <input
                    type="number"
                    id="setting-fastcron-timeout"
                    min="5"
                    max="60"
                    value="30"
                    class="w-full rounded-xl border border-border bg-card px-2.5 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-[10px] font-semibold text-muted-foreground mb-1">Max Instances (0–5)</label>
                  <input
                    type="number"
                    id="setting-fastcron-instances"
                    min="0"
                    max="5"
                    value="1"
                    class="w-full rounded-xl border border-border bg-card px-2.5 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>
              </div>
            </div>

            <!-- Drawer Footer (Danger Zone) -->
            <div class="flex items-center justify-between pt-4 border-t border-border">
              <button
                type="button"
                id="delete-connection-btn"
                class="rounded-xl border border-destructive/20 bg-destructive/10 px-3.5 py-2 text-xs font-semibold text-destructive hover:bg-destructive/20 transition-all"
              >
                🗑️ Delete Connection
              </button>
              <button
                type="submit"
                id="save-drawer-settings-btn"
                class="rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground hover:bg-primary/90 transition-all"
              >
                Save Settings
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal (Typed Name Gate) -->
  <div id="delete-confirm-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-background/80 backdrop-blur-sm">
    <div class="flex min-h-screen items-center justify-center p-4">
      <div class="relative w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl">
        <div class="flex items-center justify-between pb-3 border-b border-border mb-4">
          <h3 class="text-base font-bold text-destructive">Confirm Connection Deletion</h3>
          <button id="close-delete-modal-btn" class="rounded-lg p-1 text-muted-foreground hover:bg-muted">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <p class="text-xs text-muted-foreground mb-4">
          This will soft-delete connection <strong id="delete-target-name" class="text-foreground">---</strong> and stop automated syncing. Historical analytics data will be preserved.
        </p>

        <div class="space-y-3">
          <label class="block text-xs font-semibold text-foreground">
            Type <code id="delete-prompt-code" class="font-mono text-primary font-bold">---</code> to confirm:
          </label>
          <input
            type="text"
            id="delete-typed-input"
            placeholder="Type account name..."
            class="w-full rounded-xl border border-border bg-card px-3 py-2 text-xs text-foreground focus:border-destructive focus:outline-none"
          />
        </div>

        <div class="flex items-center justify-end gap-2 pt-4">
          <button
            type="button"
            id="cancel-delete-modal-btn"
            class="rounded-xl border border-border px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-muted"
          >
            Cancel
          </button>
          <button
            type="button"
            id="execute-delete-btn"
            disabled
            class="rounded-xl bg-destructive px-4 py-2 text-xs font-bold text-destructive-foreground hover:bg-destructive/90 disabled:opacity-40 disabled:cursor-not-allowed"
          >
            Delete Connection
          </button>
  <!-- Toast Container -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-[100] flex flex-col gap-2 max-w-sm pointer-events-none"></div>
</Layout>

<script>
  // Inlined full safeFetchJson for zero-dependency browser reliability
  async function safeFetchJson(input, init) {
    var res = await fetch(input, init);
    if (res.status === 401 || res.status === 403) {
      if (typeof window !== 'undefined') {
        window.location.href = '/login';
      }
      throw new Error('HTTP ' + res.status + ': Unauthorized or forbidden. Redirecting to login.');
    }
    if (res.status === 404) {
      throw new Error('HTTP 404: Endpoint unavailable - redeploy required');
    }
    var contentType = res.headers.get('content-type') || '';
    if (!contentType.includes('application/json')) {
      throw new Error('HTTP ' + res.status + ': Server returned non-JSON response (' + (contentType || 'empty') + ')');
    }
    var data = await res.json();
    if (!res.ok) {
      var errorMsg = (data && (data.error || data.message)) || res.statusText || 'Request failed';
      throw new Error('HTTP ' + res.status + ': ' + errorMsg);
    }
    return data;
  }

  function calculateConnectionHealth(runs, isRevoked) {
    if (isRevoked) {
      return {
        consecutive_failures: 0,
        last_success_at: null,
        total_runs: runs ? runs.length : 0,
        health_status: 'revoked',
      };
    }
    if (!runs || runs.length === 0) {
      return {
        consecutive_failures: 0,
        last_success_at: null,
        total_runs: 0,
        health_status: 'healthy',
      };
    }
    var consecutiveFailures = 0;
    for (var i = 0; i < runs.length; i++) {
      if (runs[i].status === 'failed') {
        consecutiveFailures++;
      } else {
        break;
      }
    }
    var lastSuccess = runs.find(function (r) { return r.status === 'completed' || r.status === 'success'; });
    var healthStatus = 'healthy';
    if (consecutiveFailures >= 3) {
      healthStatus = 'critical';
    } else if (consecutiveFailures >= 1) {
      healthStatus = 'warning';
    }
    return {
      consecutive_failures: consecutiveFailures,
      last_success_at: lastSuccess ? lastSuccess.started_at : null,
      total_runs: runs.length,
      health_status: healthStatus,
    };
  }

  var activeWindowDays = 30;
  var connectionsList = [];
  var currentSelectedConnection = null;

  function escapeHtml(s) {
    return String(s || '').replace(/[&<>"']/g, function (m) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
    });
  }

  function showToast(message, type) {
    if (type === undefined) type = 'info';
    var container = document.getElementById('toast-container');
    if (!container) {
      alert(message);
      return;
    }
    var toast = document.createElement('div');
    toast.className = 'pointer-events-auto rounded-xl px-4 py-3 text-xs font-semibold shadow-2xl border transition-all duration-300 transform translate-y-2 opacity-0 flex items-center justify-between gap-3 ' + (
      type === 'success'
        ? 'bg-emerald-900 text-emerald-100 border-emerald-700'
        : type === 'error'
        ? 'bg-red-950 text-red-100 border-red-700'
        : 'bg-card text-foreground border-border'
    );
    var span = document.createElement('span');
    span.textContent = message;
    var closeBtn = document.createElement('button');
    closeBtn.className = 'text-xs opacity-70 hover:opacity-100 ml-2 font-bold';
    closeBtn.innerHTML = '&times;';
    toast.appendChild(span);
    toast.appendChild(closeBtn);
    container.appendChild(toast);
    requestAnimationFrame(function () {
      toast.classList.remove('translate-y-2', 'opacity-0');
    });
    var dismiss = function () {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(function () { toast.remove(); }, 300);
    };
    closeBtn.addEventListener('click', dismiss);
    setTimeout(dismiss, 5000);
  }

  function formatNumber(num) {
    if (num === undefined || num === null) return '0';
    return Number(num).toLocaleString();
  }

  function formatDate(dateStr) {
    if (!dateStr) return '—';
    try {
      var d = new Date(dateStr);
      return d.toLocaleDateString(undefined, {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch (e) {
      return dateStr || '—';
    }
  }

  async function loadConnections() {
    var tbody = document.getElementById('connections-tbody');
    if (!tbody) return;

    try {
      tbody.innerHTML = '<tr><td colspan="9" class="py-8 text-center text-muted-foreground">' +
        '<div class="inline-flex items-center gap-2">' +
        '<svg class="animate-spin h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>' +
        '<span>Loading connections for ' + activeWindowDays + 'D window...</span>' +
        '</div></td></tr>';

      var json = await safeFetchJson('/api/analytics/connections?window_days=' + activeWindowDays);
      connectionsList = Array.isArray(json.data) ? json.data : [];

      var totalCountEl = document.getElementById('total-accounts-count');
      if (totalCountEl) totalCountEl.textContent = connectionsList.length.toString();

      if (connectionsList.length === 0) {
        tbody.innerHTML = '<tr><td colspan="9" class="py-12 text-center text-muted-foreground">' +
          '<p class="font-medium text-foreground">No Pinterest connections found</p>' +
          '<p class="text-xs text-muted-foreground mt-1">Add your first connection to begin syncing metrics and ranked top pins.</p>' +
          '<button onclick="document.getElementById(\'add-connection-btn\')?.click()" class="mt-4 inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 py-1.5 text-xs font-bold text-primary-foreground">' +
          '+ Add Connection</button></td></tr>';
        return;
      }

      tbody.innerHTML = connectionsList
        .map(function (conn) {
          var stats = conn.stats || {
            impressions: 0,
            engagements: 0,
            pin_clicks: 0,
            outbound_clicks: 0,
            saves: 0,
          };

          var isRevoked = Boolean(conn.revoked_at);
          var isEnabled = conn.analytics_enabled;
          var statusBadge = isRevoked
            ? '<span class="inline-flex items-center rounded-full bg-red-500/10 px-2 py-0.5 text-[10px] font-bold text-red-600 dark:text-red-400">Revoked (401)</span>'
            : isEnabled
            ? '<span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">Active</span>'
            : '<span class="inline-flex items-center rounded-full bg-slate-500/10 px-2 py-0.5 text-[10px] font-bold text-slate-600 dark:text-slate-400">Disabled</span>';

          var safeId = escapeHtml(conn.id);
          var safeName = escapeHtml(conn.display_name || 'Account');

          return '<tr class="hover:bg-muted/30 transition-colors">' +
            '<td class="py-3.5 px-4 font-semibold">' +
              '<a href="/analytics/' + safeId + '" class="text-primary hover:underline flex items-center gap-1.5 group">' +
                '<span class="font-bold text-foreground group-hover:text-primary transition-colors">' + safeName + '</span>' +
                '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 opacity-60 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>' +
              '</a>' +
            '</td>' +
            '<td class="py-3.5 px-4 text-center">' + statusBadge + '</td>' +
            '<td class="py-3.5 px-4 text-muted-foreground">' + formatDate(conn.last_analytics_sync_at) + '</td>' +
            '<td class="py-3.5 px-4 text-right font-medium text-foreground">' + formatNumber(stats.impressions) + '</td>' +
            '<td class="py-3.5 px-4 text-right font-medium text-foreground">' + formatNumber(stats.engagements) + '</td>' +
            '<td class="py-3.5 px-4 text-right font-medium text-foreground">' + formatNumber(stats.pin_clicks) + '</td>' +
            '<td class="py-3.5 px-4 text-right font-medium text-foreground">' + formatNumber(stats.outbound_clicks) + '</td>' +
            '<td class="py-3.5 px-4 text-right font-medium text-foreground">' + formatNumber(stats.saves) + '</td>' +
            '<td class="py-3.5 px-4 text-right">' +
              '<div class="flex items-center justify-end gap-1.5">' +
                '<a href="/analytics/' + safeId + '" class="rounded-lg border border-border bg-card px-2 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all" title="View Detailed Analytics">View</a>' +
                '<button data-settings-id="' + safeId + '" class="settings-trigger-btn rounded-lg border border-border bg-card p-1 text-muted-foreground hover:bg-muted hover:text-foreground transition-all" title="Configure Settings & Schedules">' +
                  '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>' +
                '</button>' +
              '</div>' +
            '</td>' +
          '</tr>';
        })
        .join('');

      document.querySelectorAll('.settings-trigger-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var connId = btn.getAttribute('data-settings-id');
          if (connId) openSettingsDrawer(connId);
        });
      });
    } catch (err) {
      tbody.innerHTML = '<tr><td colspan="9" class="py-8 text-center text-red-500">' +
        '<p class="font-bold">Failed to load connections</p>' +
        '<p class="text-xs text-muted-foreground mt-1">' + (err.message || 'Error') + '</p>' +
        '</td></tr>';
      showToast('Error loading connections: ' + (err.message || 'Error'), 'error');
    }
  }

  // Open Upgraded Settings Drawer
  async function openSettingsDrawer(connectionId) {
    var drawer = document.getElementById('settings-drawer');
    if (!drawer) return;

    var conn = connectionsList.find(function (c) { return c.id === connectionId; });
    if (!conn) return;
    currentSelectedConnection = conn;

    var drawerConnId = document.getElementById('drawer-connection-id');
    if (drawerConnId) drawerConnId.value = conn.id;

    var titleEl = document.getElementById('drawer-connection-name');
    if (titleEl) titleEl.textContent = conn.display_name;

    var statusBadge = document.getElementById('drawer-connection-status');
    var reenableBtn = document.getElementById('drawer-reenable-btn');
    if (statusBadge) {
      if (conn.revoked_at) {
        statusBadge.textContent = 'Revoked (401)';
        statusBadge.className = 'rounded-full bg-red-500/10 px-2 py-0.5 text-[10px] font-semibold text-red-600 dark:text-red-400';
        if (reenableBtn) reenableBtn.classList.remove('hidden');
      } else {
        statusBadge.textContent = conn.analytics_enabled ? 'Active' : 'Disabled';
        statusBadge.className = conn.analytics_enabled
          ? 'rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400'
          : 'rounded-full bg-slate-500/10 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-400';
        if (reenableBtn) reenableBtn.classList.add('hidden');
      }
    }

    // Populate FastCron IDs
    var jobAEl = document.getElementById('pipeline-a-job-id');
    if (jobAEl) jobAEl.textContent = conn.analytics_fastcron_job_id ? 'FastCron Job #' + conn.analytics_fastcron_job_id : 'FastCron Job: Not configured';
    var jobBEl = document.getElementById('pipeline-b-job-id');
    if (jobBEl) jobBEl.textContent = conn.top_pins_fastcron_job_id ? 'FastCron Job #' + conn.top_pins_fastcron_job_id : 'FastCron Job: Not configured';

    // Populate Status Badges
    var badgeA = document.getElementById('drawer-channel-a-badge');
    if (badgeA) {
      badgeA.textContent = conn.analytics_schedule_status || 'pending';
      badgeA.className = conn.analytics_schedule_status === 'synced'
        ? 'rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400'
        : 'rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-semibold text-amber-600 dark:text-amber-400';
    }
    var badgeB = document.getElementById('drawer-channel-b-badge');
    if (badgeB) {
      badgeB.textContent = conn.top_pins_schedule_status || 'pending';
      badgeB.className = conn.top_pins_schedule_status === 'synced'
        ? 'rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400'
        : 'rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-semibold text-amber-600 dark:text-amber-400';
    }

    // Pipeline A
    var elAWeb = document.getElementById('setting-analytics-webhook');
    if (elAWeb) elAWeb.value = conn.analytics_webhook_url || '';
    var elATime = document.getElementById('setting-analytics-time');
    if (elATime) elATime.value = conn.analytics_sync_time || '04:00';
    var elAStart = document.getElementById('setting-analytics-start-offset');
    if (elAStart) elAStart.value = conn.analytics_start_offset_days || '7';
    var elAEnd = document.getElementById('setting-analytics-end-offset');
    if (elAEnd) elAEnd.value = conn.analytics_end_offset_days || '1';

    // Pipeline B
    var elBWeb = document.getElementById('setting-top-pins-webhook');
    if (elBWeb) elBWeb.value = conn.top_pins_webhook_url || '';
    var elBTime = document.getElementById('setting-top-pins-time');
    if (elBTime) elBTime.value = conn.top_pins_sync_time || '04:30';
    var elBStart = document.getElementById('setting-top-pins-start-offset');
    if (elBStart) elBStart.value = conn.top_pins_start_offset_days || '7';
    var elBEnd = document.getElementById('setting-top-pins-end-offset');
    if (elBEnd) elBEnd.value = conn.top_pins_end_offset_days || '2';
    var elBPins = document.getElementById('setting-top-pins-num-pins');
    if (elBPins) elBPins.value = conn.top_pins_num_of_pins || 50;

    // Sort Modes Chips
    var selectedModes = new Set(conn.top_pins_sort_modes || ['IMPRESSION', 'OUTBOUND_CLICK', 'SAVE', 'ENGAGEMENT', 'PIN_CLICK']);
    document.querySelectorAll('#sort-modes-chips-container .sort-chip').forEach(function (chip) {
      var mode = chip.getAttribute('data-mode') || '';
      if (selectedModes.has(mode)) {
        chip.classList.add('active', 'border-primary', 'bg-primary/10', 'text-primary');
        chip.classList.remove('border-border', 'text-muted-foreground');
      } else {
        chip.classList.remove('active', 'border-primary', 'bg-primary/10', 'text-primary');
        chip.classList.add('border-border', 'text-muted-foreground');
      }
    });

    // FastCron Options & Per-Connection Token
    var tokenBadge = document.getElementById('fastcron-token-status-badge');
    var tokenInput = document.getElementById('setting-fastcron-token');
    if (tokenInput) tokenInput.value = '';
    if (tokenBadge) {
      if (conn.has_fastcron_token) {
        tokenBadge.textContent = 'Token: •••••••• (Custom)';
        tokenBadge.className = 'rounded-full bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-600 dark:text-emerald-400';
      } else {
        tokenBadge.textContent = 'Token: Workspace Default';
        tokenBadge.className = 'rounded-full bg-slate-500/10 px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:text-slate-400';
      }
    }
    var elNotify = document.getElementById('setting-fastcron-notify');
    if (elNotify) elNotify.value = conn.fastcron_notify === false ? 'false' : 'true';
    var elTimeout = document.getElementById('setting-fastcron-timeout');
    if (elTimeout) elTimeout.value = conn.fastcron_timeout || 30;
    var elInstances = document.getElementById('setting-fastcron-instances');
    if (elInstances) elInstances.value = conn.fastcron_instances !== undefined ? conn.fastcron_instances : 1;

    drawer.classList.remove('hidden');

    // Fetch and render Health Strip from /runs API
    loadConnectionHealthStrip(connectionId, Boolean(conn.revoked_at));
  }

  async function loadConnectionHealthStrip(connectionId, isRevoked) {
    try {
      var runsJson = await safeFetchJson('/api/analytics/runs?connection_id=' + connectionId + '&limit=50');
      var runs = Array.isArray(runsJson.data) ? runsJson.data : [];
      var health = calculateConnectionHealth(runs, isRevoked);

      var dotEl = document.getElementById('health-dot');
      var labelEl = document.getElementById('health-label');
      var totalEl = document.getElementById('health-total-runs');
      var failEl = document.getElementById('health-failures');
      var successEl = document.getElementById('health-last-success');

      if (totalEl) totalEl.textContent = health.total_runs.toString();
      if (failEl) failEl.textContent = health.consecutive_failures.toString();
      if (successEl) successEl.textContent = health.last_success_at ? formatDate(health.last_success_at) : 'Never';

      if (dotEl && labelEl) {
        if (health.health_status === 'revoked') {
          dotEl.className = 'h-2.5 w-2.5 rounded-full bg-red-500';
          labelEl.textContent = 'Account Revoked (401)';
        } else if (health.health_status === 'critical') {
          dotEl.className = 'h-2.5 w-2.5 rounded-full bg-red-500 animate-pulse';
          labelEl.textContent = 'Critical (3+ Consecutive Failures)';
        } else if (health.health_status === 'warning') {
          dotEl.className = 'h-2.5 w-2.5 rounded-full bg-amber-500';
          labelEl.textContent = 'Warning (Recent Failures)';
        } else {
          dotEl.className = 'h-2.5 w-2.5 rounded-full bg-emerald-500';
          labelEl.textContent = 'Connection Healthy';
        }
      }
    } catch (e) {
      console.warn('Failed to load runs for health strip:', e);
      var labelEl2 = document.getElementById('health-label');
      if (labelEl2) labelEl2.textContent = 'Health Status Unavailable';
    }
  }

  function closeSettingsDrawer() {
    var drawer = document.getElementById('settings-drawer');
    if (drawer) drawer.classList.add('hidden');
  }

  document.addEventListener('DOMContentLoaded', function () {
    // Window selector buttons
    document.querySelectorAll('#global-window-toggles .window-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('#global-window-toggles .window-btn').forEach(function (b) {
          b.classList.remove('active', 'bg-primary', 'text-primary-foreground', 'shadow-sm');
          b.classList.add('text-muted-foreground');
        });
        btn.classList.add('active', 'bg-primary', 'text-primary-foreground', 'shadow-sm');
        btn.classList.remove('text-muted-foreground');

        activeWindowDays = parseInt(btn.getAttribute('data-window') || '30', 10);
        var winLabel = document.getElementById('active-window-label');
        if (winLabel) winLabel.textContent = activeWindowDays + ' Days';

        loadConnections();
      });
    });

    var refreshConnBtn = document.getElementById('refresh-connections-btn');
    if (refreshConnBtn) {
      refreshConnBtn.addEventListener('click', function () {
        loadConnections();
      });
    }

    // Add Connection Modal
    var addModal = document.getElementById('add-connection-modal');
    var addConnBtn = document.getElementById('add-connection-btn');
    if (addConnBtn) {
      addConnBtn.addEventListener('click', function () {
        if (addModal) addModal.classList.remove('hidden');
        var newConnInput = document.getElementById('new-connection-name');
        if (newConnInput) newConnInput.focus();
      });
    }

    var closeAddBtn = document.getElementById('close-add-modal-btn');
    if (closeAddBtn) closeAddBtn.addEventListener('click', function () { if (addModal) addModal.classList.add('hidden'); });
    var cancelAddBtn = document.getElementById('cancel-add-modal-btn');
    if (cancelAddBtn) cancelAddBtn.addEventListener('click', function () { if (addModal) addModal.classList.add('hidden'); });

    var addConnForm = document.getElementById('add-connection-form');
    if (addConnForm) {
      addConnForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        var input = document.getElementById('new-connection-name');
        var name = input ? input.value.trim() : '';
        if (!name) return;

        var submitBtn = document.getElementById('submit-add-btn');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Creating...';
        }

        try {
          var json = await safeFetchJson('/api/analytics/connections', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ display_name: name, analytics_enabled: true }),
          });
          if (!json.success) throw new Error(json.error || 'Failed to create connection');

          if (addModal) addModal.classList.add('hidden');
          if (input) input.value = '';
          showToast('✅ Connection created successfully!', 'success');
          await loadConnections();
        } catch (err) {
          showToast(err.message || 'Create failed', 'error');
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Create Connection';
          }
        }
      });
    }

    // Drawer close buttons
    var closeDrawerBtn = document.getElementById('close-settings-drawer-btn');
    if (closeDrawerBtn) closeDrawerBtn.addEventListener('click', closeSettingsDrawer);
    var drawerBackdrop = document.getElementById('settings-drawer-backdrop');
    if (drawerBackdrop) drawerBackdrop.addEventListener('click', closeSettingsDrawer);

    // Sort Mode Chips Toggle
    document.querySelectorAll('#sort-modes-chips-container .sort-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var isActive = chip.classList.contains('active');
        if (isActive) {
          var activeCount = document.querySelectorAll('#sort-modes-chips-container .sort-chip.active').length;
          if (activeCount <= 1) {
            showToast('At least one sort mode must remain selected.', 'error');
            return;
          }
          chip.classList.remove('active', 'border-primary', 'bg-primary/10', 'text-primary');
          chip.classList.add('border-border', 'text-muted-foreground');
        } else {
          chip.classList.add('active', 'border-primary', 'bg-primary/10', 'text-primary');
          chip.classList.remove('border-border', 'text-muted-foreground');
        }
      });
    });

    // Save Drawer Settings
    var settingsForm = document.getElementById('connection-settings-form');
    if (settingsForm) {
      settingsForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;

        var saveBtn = document.getElementById('save-drawer-settings-btn');
        if (saveBtn) {
          saveBtn.disabled = true;
          saveBtn.textContent = 'Saving...';
        }

        var activeSortModes = [];
        document.querySelectorAll('#sort-modes-chips-container .sort-chip.active').forEach(function (c) {
          var mode = c.getAttribute('data-mode');
          if (mode) activeSortModes.push(mode);
        });

        var elAWeb = document.getElementById('setting-analytics-webhook');
        var elATime = document.getElementById('setting-analytics-time');
        var elAStart = document.getElementById('setting-analytics-start-offset');
        var elAEnd = document.getElementById('setting-analytics-end-offset');
        var elBWeb = document.getElementById('setting-top-pins-webhook');
        var elBTime = document.getElementById('setting-top-pins-time');
        var elBStart = document.getElementById('setting-top-pins-start-offset');
        var elBEnd = document.getElementById('setting-top-pins-end-offset');
        var elBPins = document.getElementById('setting-top-pins-num-pins');
        var elNotify = document.getElementById('setting-fastcron-notify');
        var elTimeout = document.getElementById('setting-fastcron-timeout');
        var elInstances = document.getElementById('setting-fastcron-instances');
        var elTz = document.getElementById('setting-workspace-timezone');

        var payload = {
          analytics_webhook_url: elAWeb ? elAWeb.value.trim() || null : null,
          analytics_sync_time: elATime ? elATime.value.trim() || '04:00' : '04:00',
          analytics_start_offset_days: elAStart ? parseInt(elAStart.value || '7', 10) : 7,
          analytics_end_offset_days: elAEnd ? parseInt(elAEnd.value || '1', 10) : 1,
          top_pins_webhook_url: elBWeb ? elBWeb.value.trim() || null : null,
          top_pins_sync_time: elBTime ? elBTime.value.trim() || '04:30' : '04:30',
          top_pins_start_offset_days: elBStart ? parseInt(elBStart.value || '7', 10) : 7,
          top_pins_end_offset_days: elBEnd ? parseInt(elBEnd.value || '2', 10) : 2,
          top_pins_num_of_pins: elBPins ? parseInt(elBPins.value || '50', 10) : 50,
          top_pins_sort_modes: activeSortModes,
          fastcron_notify: elNotify ? elNotify.value === 'true' : true,
          fastcron_timeout: elTimeout ? parseInt(elTimeout.value || '30', 10) : 30,
          fastcron_instances: elInstances ? parseInt(elInstances.value || '1', 10) : 1,
          timezone: elTz ? elTz.value : 'UTC',
        };

        var fastcronTokenInput = document.getElementById('setting-fastcron-token');
        var fastcronTokenVal = fastcronTokenInput ? fastcronTokenInput.value.trim() : '';
        if (fastcronTokenVal) {
          payload.fastcron_token = fastcronTokenVal;
        }

        try {
          var json = await safeFetchJson('/api/analytics/connections/' + connId + '/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!json.success) throw new Error(json.error || 'Failed to save settings.');

          showToast('✅ Settings saved successfully', 'success');
          closeSettingsDrawer();
          await loadConnections();
        } catch (err) {
          showToast(err.message || 'Save failed', 'error');
        } finally {
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.textContent = 'Save Settings';
          }
        }
      });
    }

    // Test Ping Buttons
    var pingABtn = document.getElementById('ping-analytics-btn');
    if (pingABtn) {
      pingABtn.addEventListener('click', async function () {
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;
        pingABtn.disabled = true;
        try {
          var json = await safeFetchJson('/api/analytics/trigger-sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connection_id: connId, channel: 'analytics', mode: 'ping' }),
          });
          showToast(json.message || '✅ Pipeline A ping successful!', 'success');
        } catch (err) {
          showToast('Ping failed: ' + (err.message || 'Error'), 'error');
        } finally {
          pingABtn.disabled = false;
        }
      });
    }

    var pingBBtn = document.getElementById('ping-top-pins-btn');
    if (pingBBtn) {
      pingBBtn.addEventListener('click', async function () {
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;
        pingBBtn.disabled = true;
        try {
          var json = await safeFetchJson('/api/analytics/trigger-sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connection_id: connId, channel: 'top_pins', mode: 'ping' }),
          });
          showToast(json.message || '✅ Pipeline B ping successful!', 'success');
        } catch (err) {
          showToast('Ping failed: ' + (err.message || 'Error'), 'error');
        } finally {
          pingBBtn.disabled = false;
        }
      });
    }

    // Run Now Buttons
    var runABtn = document.getElementById('run-analytics-btn');
    if (runABtn) {
      runABtn.addEventListener('click', async function () {
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;
        runABtn.disabled = true;
        try {
          var json = await safeFetchJson('/api/analytics/trigger-sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connection_id: connId, channel: 'analytics', mode: 'sync' }),
          });
          showToast(json.message || '✅ Analytics sync triggered!', 'success');
        } catch (err) {
          showToast('Run failed: ' + (err.message || 'Error'), 'error');
        } finally {
          runABtn.disabled = false;
        }
      });
    }

    var runBBtn = document.getElementById('run-top-pins-btn');
    if (runBBtn) {
      runBBtn.addEventListener('click', async function () {
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;
        runBBtn.disabled = true;
        try {
          var json = await safeFetchJson('/api/analytics/trigger-sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connection_id: connId, channel: 'top_pins', mode: 'sync' }),
          });
          showToast(json.message || '✅ Top pins sync triggered!', 'success');
        } catch (err) {
          showToast('Run failed: ' + (err.message || 'Error'), 'error');
        } finally {
          runBBtn.disabled = false;
        }
      });
    }

    // Sync Schedule Buttons
    var syncABtn = document.getElementById('sync-fastcron-a-btn');
    if (syncABtn) {
      syncABtn.addEventListener('click', async function () {
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;
        syncABtn.disabled = true;
        try {
          var json = await safeFetchJson('/api/analytics/schedule/sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connection_id: connId, channel: 'analytics' }),
          });
          if (json.success) {
            showToast('✅ Schedule synced! FastCron Job #' + json.fastcron_job_id, 'success');
            await loadConnections();
            if (currentSelectedConnection) openSettingsDrawer(connId);
          } else {
            showToast('FastCron Sync Error: ' + json.error, 'error');
          }
        } catch (err) {
          showToast('FastCron Sync Error: ' + (err.message || 'Error'), 'error');
        } finally {
          syncABtn.disabled = false;
        }
      });
    }

    var syncBBtn = document.getElementById('sync-fastcron-b-btn');
    if (syncBBtn) {
      syncBBtn.addEventListener('click', async function () {
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;
        syncBBtn.disabled = true;
        try {
          var json = await safeFetchJson('/api/analytics/schedule/sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connection_id: connId, channel: 'top_pins' }),
          });
          if (json.success) {
            showToast('✅ Schedule synced! FastCron Job #' + json.fastcron_job_id, 'success');
            await loadConnections();
            if (currentSelectedConnection) openSettingsDrawer(connId);
          } else {
            showToast('FastCron Sync Error: ' + json.error, 'error');
          }
        } catch (err) {
          showToast('FastCron Sync Error: ' + (err.message || 'Error'), 'error');
        } finally {
          syncBBtn.disabled = false;
        }
      });
    }

    // View Logs Buttons
    var viewLogsABtn = document.getElementById('view-logs-a-btn');
    if (viewLogsABtn) {
      viewLogsABtn.addEventListener('click', async function () {
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;
        try {
          var json = await safeFetchJson('/api/analytics/cron/logs?connection_id=' + connId + '&channel=analytics');
          if (json.success && Array.isArray(json.logs)) {
            alert('FastCron Logs (Job #' + json.job_id + '):\n' + json.logs.map(function (l) { return '[' + (l.date || l.time) + '] HTTP ' + (l.http_status || '200'); }).join('\n'));
          } else {
            showToast(json.error || 'No logs available.', 'info');
          }
        } catch (err) {
          showToast('Failed to load logs: ' + (err.message || 'Error'), 'error');
        }
      });
    }

    var viewLogsBBtn = document.getElementById('view-logs-b-btn');
    if (viewLogsBBtn) {
      viewLogsBBtn.addEventListener('click', async function () {
        var drawerConnIdEl = document.getElementById('drawer-connection-id');
        var connId = drawerConnIdEl ? drawerConnIdEl.value : '';
        if (!connId) return;
        try {
          var json = await safeFetchJson('/api/analytics/cron/logs?connection_id=' + connId + '&channel=top_pins');
          if (json.success && Array.isArray(json.logs)) {
            alert('FastCron Logs (Job #' + json.job_id + '):\n' + json.logs.map(function (l) { return '[' + (l.date || l.time) + '] HTTP ' + (l.http_status || '200'); }).join('\n'));
          } else {
            showToast(json.error || 'No logs available.', 'info');
          }
        } catch (err) {
          showToast('Failed to load logs: ' + (err.message || 'Error'), 'error');
        }
      });
    }

    // Typed Delete Confirmation Modal (Danger Zone)
    var deleteModal = document.getElementById('delete-confirm-modal');
    var deleteTargetName = document.getElementById('delete-target-name');
    var deletePromptCode = document.getElementById('delete-prompt-code');
    var deleteTypedInput = document.getElementById('delete-typed-input');
    var executeDeleteBtn = document.getElementById('execute-delete-btn');

    var deleteConnBtn = document.getElementById('delete-connection-btn');
    if (deleteConnBtn) {
      deleteConnBtn.addEventListener('click', function () {
        if (!currentSelectedConnection) return;
        if (deleteTargetName) deleteTargetName.textContent = currentSelectedConnection.display_name;
        if (deletePromptCode) deletePromptCode.textContent = currentSelectedConnection.display_name;
        if (deleteTypedInput) deleteTypedInput.value = '';
        if (executeDeleteBtn) executeDeleteBtn.disabled = true;
        if (deleteModal) deleteModal.classList.remove('hidden');
      });
    }

    var closeDelBtn = document.getElementById('close-delete-modal-btn');
    if (closeDelBtn) closeDelBtn.addEventListener('click', function () { if (deleteModal) deleteModal.classList.add('hidden'); });
    var cancelDelBtn = document.getElementById('cancel-delete-modal-btn');
    if (cancelDelBtn) cancelDelBtn.addEventListener('click', function () { if (deleteModal) deleteModal.classList.add('hidden'); });

    if (deleteTypedInput) {
      deleteTypedInput.addEventListener('input', function (e) {
        var val = e.target.value.trim();
        if (executeDeleteBtn) {
          executeDeleteBtn.disabled = (val !== (currentSelectedConnection ? currentSelectedConnection.display_name : ''));
        }
      });
    }

    if (executeDeleteBtn) {
      executeDeleteBtn.addEventListener('click', async function () {
        if (!currentSelectedConnection) return;
        executeDeleteBtn.disabled = true;
        executeDeleteBtn.textContent = 'Deleting...';

        try {
          var json = await safeFetchJson('/api/analytics/connections/' + currentSelectedConnection.id, {
            method: 'DELETE',
          });
          if (!json.success) throw new Error(json.error || 'Failed to delete connection.');

          showToast('✅ Connection deleted successfully.', 'success');
          if (deleteModal) deleteModal.classList.add('hidden');
          closeSettingsDrawer();
          await loadConnections();
        } catch (err) {
          showToast(err.message || 'Delete error', 'error');
        } finally {
          executeDeleteBtn.textContent = 'Delete Connection';
        }
      });
    }

    loadConnections();
  });
</script>

