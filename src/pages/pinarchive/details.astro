---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pin Deep-Dive & Metrics History" description="Archived pin performance, historical saves/repins growth, SEO annotations, and canonical cluster variations.">
  <!-- ═══ Sticky Mini-bar on Scroll (T1) ═══ -->
  <div
    id="sticky-mini-bar"
    class="fixed top-0 left-0 right-0 z-40 bg-card/90 backdrop-blur-md border-b border-border shadow-md px-6 py-2.5 flex items-center justify-between transition-all duration-300 -translate-y-full opacity-0 pointer-events-none"
  >
    <div class="flex items-center gap-3 min-w-0 max-w-xl">
      <a href="/pinarchive" class="text-xs font-semibold text-muted-foreground hover:text-foreground shrink-0">← Back</a>
      <span class="text-xs text-border shrink-0">|</span>
      <h3 id="sticky-title" class="text-xs font-bold text-foreground truncate"></h3>
    </div>
    <div class="flex items-center gap-4 text-xs shrink-0">
      <div>Saves: <strong id="sticky-saves" class="text-rose-500 font-bold">-</strong></div>
      <div>Velocity: <strong id="sticky-velocity" class="text-emerald-500 font-bold">-</strong></div>
      <div id="sticky-stage-badge"></div>
    </div>
  </div>

  <!-- Back Button & Refresh Header -->
  <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <a href="/pinarchive" class="inline-flex items-center gap-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <span>Back to PinArchive Intelligence</span>
    </a>

    <div class="flex items-center gap-3">
      <span id="pin-refresh-meta" class="text-xs text-muted-foreground hidden sm:inline-block"></span>
      <button
        id="refresh-pin-btn"
        type="button"
        title="Refresh pin details"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all"
      >
        <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
        </svg>
        <span>Refresh</span>
      </button>
    </div>
  </div>

  <!-- Loading Skeleton -->
  <div id="pin-loading-skeleton" class="space-y-6">
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm animate-pulse flex flex-col md:flex-row gap-6">
      <div class="w-full md:w-56 h-64 bg-muted rounded-xl"></div>
      <div class="flex-1 space-y-4">
        <div class="h-6 w-3/4 bg-muted rounded"></div>
        <div class="h-4 w-1/2 bg-muted rounded"></div>
        <div class="grid grid-cols-3 gap-3 pt-4">
          <div class="h-16 bg-muted rounded-xl"></div>
          <div class="h-16 bg-muted rounded-xl"></div>
          <div class="h-16 bg-muted rounded-xl"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div id="pin-error-container" class="hidden rounded-2xl border border-rose-500/30 bg-rose-500/10 p-8 text-center text-xs text-rose-500 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto mb-2 text-rose-500 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <p id="pin-error-text" class="font-bold text-sm">Failed to load pin details.</p>
    <a href="/pinarchive" class="mt-4 inline-block font-semibold text-primary hover:underline">Return to PinArchive</a>
  </div>

  <!-- Pin Detail Main Container -->
  <div id="pin-main-content" class="hidden space-y-8">
    <!-- ═══ Pin Header Hero Card (T1 + T2) ═══ -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm overflow-hidden">
      <div class="flex flex-col md:flex-row items-start gap-6">
        <!-- Pin Image Preview -->
        <div class="relative w-full md:w-56 shrink-0 aspect-[2/3] max-h-80 bg-muted/60 rounded-xl overflow-hidden flex items-center justify-center border border-border/80 shadow-sm group">
          <img
            id="pin-detail-image"
            src=""
            alt="Pinterest Pin"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
          />
          <div id="pin-detail-fallback-icon" class="hidden absolute inset-0 flex items-center justify-center text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </div>
          <span id="pin-detail-category-badge" class="hidden absolute top-2.5 left-2.5 text-[10px] font-bold bg-background/90 backdrop-blur-xs text-foreground px-2.5 py-1 rounded-md shadow-xs border border-border/40"></span>
        </div>

        <!-- Pin Information -->
        <div class="flex-1 space-y-4 min-w-0">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span id="pin-stage-badge"></span>
              <span id="pin-anomaly-badge"></span>
              <span id="pin-board-badge" class="rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-muted-foreground border border-border/60"></span>
              <span id="pin-canonical-badge" class="hidden rounded-full bg-purple-500/10 px-2.5 py-0.5 text-xs font-bold text-purple-500 border border-purple-500/20"></span>
            </div>
            <h1 id="pin-detail-title" class="text-xl font-bold tracking-tight text-foreground line-clamp-3"></h1>
            <p id="pin-detail-description" class="mt-2 text-xs text-muted-foreground line-clamp-3"></p>
          </div>

          <!-- Quick Copy Buttons Toolbar (T1) -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            <button
              id="copy-id-btn"
              type="button"
              class="inline-flex items-center gap-1 text-[11px] font-semibold bg-muted hover:bg-muted/80 text-foreground px-2.5 py-1 rounded-lg border border-border transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span>Copy Pin ID</span>
            </button>
            <button
              id="copy-url-btn"
              type="button"
              class="inline-flex items-center gap-1 text-[11px] font-semibold bg-muted hover:bg-muted/80 text-foreground px-2.5 py-1 rounded-lg border border-border transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <span>Copy URL</span>
            </button>
            <button
              id="copy-title-btn"
              type="button"
              class="inline-flex items-center gap-1 text-[11px] font-semibold bg-muted hover:bg-muted/80 text-foreground px-2.5 py-1 rounded-lg border border-border transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
              <span>Copy Title</span>
            </button>
          </div>

          <!-- Metadata row with Created Date (T1 + Created Date directive) -->
          <div class="flex flex-wrap items-center gap-3 text-xs text-muted-foreground pt-2 border-t border-border/60">
            <div class="flex items-center gap-1.5">
              <span>Pin ID:</span>
              <strong class="font-mono text-foreground" id="pin-id-str"></strong>
            </div>
            <span>•</span>
            <div class="flex items-center gap-1.5">
              <span>Created:</span>
              <span class="font-medium text-foreground" id="pin-created-date-str">—</span>
            </div>
            <span>•</span>
            <div class="flex items-center gap-1.5">
              <span>Archived:</span>
              <span class="font-medium text-foreground" id="pin-archived-date-str">—</span>
            </div>
            <span>•</span>
            <a
              id="pin-external-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-semibold text-primary hover:underline"
            >
              <span>View on Pinterest</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>

          <!-- Annotation Tags with Direct Links (T1) -->
          <div class="pt-2">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider block">Annotations & SEO Keywords</span>
              <span id="annotations-counter" class="text-[10px] text-muted-foreground font-medium"></span>
            </div>
            <div id="pin-annotations-container" class="flex flex-wrap items-center gap-1.5"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ KPI Stats Grid with Full Numbers & Snapshot Deltas (T1) ═══ -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <!-- Saves -->
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Total Saves</span>
        <div class="flex items-baseline justify-center gap-1.5 mt-1">
          <span class="text-xl font-bold text-rose-500" id="kpi-detail-saves">-</span>
          <span id="kpi-delta-saves" class="text-[10px] font-bold"></span>
        </div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Cumulative</span>
      </div>

      <!-- Repins -->
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Repins</span>
        <div class="flex items-baseline justify-center gap-1.5 mt-1">
          <span class="text-xl font-bold text-foreground" id="kpi-detail-repins">-</span>
          <span id="kpi-delta-repins" class="text-[10px] font-bold"></span>
        </div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Re-pin shares</span>
      </div>

      <!-- Comments -->
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Comments</span>
        <div class="flex items-baseline justify-center gap-1.5 mt-1">
          <span class="text-xl font-bold text-foreground" id="kpi-detail-comments">-</span>
          <span id="kpi-delta-comments" class="text-[10px] font-bold"></span>
        </div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">User comments</span>
      </div>

      <!-- Shares -->
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Shares</span>
        <div class="flex items-baseline justify-center gap-1.5 mt-1">
          <span class="text-xl font-bold text-blue-500" id="kpi-detail-shares">-</span>
          <span id="kpi-delta-shares" class="text-[10px] font-bold"></span>
        </div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Social shares</span>
      </div>

      <!-- Velocity -->
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Velocity</span>
        <div class="text-xl font-bold text-emerald-500 mt-1" id="kpi-detail-velocity">-</div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Saves / day</span>
      </div>

      <!-- Reactions -->
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Reactions</span>
        <div class="flex items-baseline justify-center gap-1.5 mt-1">
          <span class="text-xl font-bold text-purple-500" id="kpi-detail-reactions">-</span>
          <span id="kpi-delta-reactions" class="text-[10px] font-bold"></span>
        </div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Total reactions</span>
      </div>
    </div>

    <!-- ═══ Performance Trend Chart & History (T1) ═══ -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm relative">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-6">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>📈 Performance Trajectory</span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500" id="metrics-count-badge">0 Snapshots</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Historical growth curve tracked during automated refresh cycles.</p>
        </div>
        <div class="flex items-center gap-3 text-xs">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
            <span class="text-muted-foreground font-medium">Saves</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-blue-500"></span>
            <span class="text-muted-foreground font-medium">Repins</span>
          </div>
        </div>
      </div>

      <!-- Chart / Notice Container -->
      <div id="chart-wrapper" class="w-full relative">
        <div id="chart-notice" class="hidden py-12 text-center text-xs text-muted-foreground bg-muted/20 rounded-xl border border-dashed border-border"></div>
        <div id="svg-chart-container" class="w-full h-64 overflow-hidden relative"></div>
      </div>
    </div>

    <!-- ═══ Canonical Asset Consolidation Card (T2) ═══ -->
    <div id="canonical-consolidation-section" class="hidden rounded-2xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4 pb-4 border-b border-border">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>🧬 Canonical Asset Consolidation</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-500" id="cluster-rank-badge">Rank #1</span>
          </h2>
          <p id="cluster-summary-text" class="text-xs text-muted-foreground mt-0.5"></p>
        </div>
      </div>

      <div id="canonical-siblings-list" class="divide-y divide-border/60 bg-muted/20 rounded-xl border border-border/60 overflow-hidden"></div>
    </div>

    <!-- ═══ Pin Editorial Notes Section (T3-notes) ═══ -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>📝 Editorial Notes & Strategy</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Private workspace notes regarding content angle, imagery iteration, or performance.</p>
        </div>
        <span id="notes-status-caption" class="text-xs text-muted-foreground"></span>
      </div>

      <div class="space-y-2">
        <textarea
          id="pin-notes-textarea"
          rows="4"
          maxlength="2000"
          placeholder="Add strategic notes about this pin..."
          class="w-full rounded-xl border border-border bg-background p-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary resize-y"
        ></textarea>
        <div class="flex items-center justify-between">
          <span id="notes-char-count" class="text-[11px] text-muted-foreground font-mono">0 / 2000</span>
          <button
            id="save-notes-btn"
            type="button"
            class="rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-all disabled:opacity-50"
          >
            Save Notes
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let currentPin: any = null;

  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Full numbers formatting everywhere
  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  // Compact abbreviation ONLY allowed for SVG chart axis ticks
  function fmtCompact(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    if (num >= 1_000_000) return (num / 1_000_000).toFixed(1) + 'M';
    if (num >= 1_000) return (num / 1_000).toFixed(1) + 'k';
    return num.toLocaleString('en-US');
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function renderStageBadge(stage?: string | null): string {
    switch (stage) {
      case 'NEW':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">🟢 NEW (≤14d)</span>';
      case 'GROWING':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">🚀 GROWING (≥10/d)</span>';
      case 'MATURE':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">🟣 MATURE (>14d)</span>';
      case 'COOLING':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">❄️ COOLING (<2/d)</span>';
      default:
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-slate-500/10 text-slate-500 border border-slate-500/20">⚪ DORMANT (<0.5/d)</span>';
    }
  }

  function renderDelta(val: number, label: string): string {
    if (val > 0) {
      return `<span class="text-emerald-500" aria-label="${label} increased by ${val}">(+${fmtNumber(val)})</span>`;
    }
    if (val < 0) {
      return `<span class="text-rose-500" aria-label="${label} decreased by ${Math.abs(val)}">(−${fmtNumber(Math.abs(val))})</span>`;
    }
    return '';
  }

  function renderSvgChart(metrics: any[]) {
    const container = document.getElementById('svg-chart-container');
    const notice = document.getElementById('chart-notice');
    if (!container || !notice) return;

    if (!Array.isArray(metrics) || metrics.length < 2) {
      notice.innerHTML = 'Not enough history yet — refresh cycle will build history (1 snapshot recorded).';
      notice.classList.remove('hidden');
      container.classList.add('hidden');
      return;
    }

    if (metrics.length < 4) {
      notice.innerHTML = `Building history — refresh cycle will complete the curve (${metrics.length} of 4 snapshots).`;
      notice.classList.remove('hidden');
    } else {
      notice.classList.add('hidden');
    }

    container.classList.remove('hidden');

    const width = container.clientWidth || 800;
    const height = 250;
    const padX = 50;
    const padY = 30;

    const saves = metrics.map((m) => Number(m.saves || 0));
    const repins = metrics.map((m) => Number(m.repins || 0));
    const maxVal = Math.max(...saves, ...repins, 10);
    const minVal = 0;

    const ptsCount = metrics.length;
    const getX = (i: number) => padX + (i / (ptsCount - 1)) * (width - padX * 2);
    const getY = (v: number) => height - padY - ((v - minVal) / (maxVal - minVal)) * (height - padY * 2);

    const savesPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.saves || 0)).toFixed(1)}`)
      .join(' ');

    const repinsPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.repins || 0)).toFixed(1)}`)
      .join(' ');

    const savesArea = `${savesPath} L ${getX(ptsCount - 1)} ${height - padY} L ${getX(0)} ${height - padY} Z`;

    const gridY1 = height - padY;
    const gridY2 = height - padY - (height - padY * 2) * 0.5;
    const gridY3 = padY;

    container.innerHTML = `
      <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" class="overflow-visible" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="savesGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#f43f5e" stop-opacity="0.0"/>
          </linearGradient>
        </defs>

        <!-- Grid lines -->
        <line x1="${padX}" y1="${gridY1}" x2="${width - padX}" y2="${gridY1}" stroke="currentColor" class="text-border" stroke-width="1" />
        <line x1="${padX}" y1="${gridY2}" x2="${width - padX}" y2="${gridY2}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />
        <line x1="${padX}" y1="${gridY3}" x2="${width - padX}" y2="${gridY3}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />

        <!-- Y Axis Labels (compact formatting allowed only here) -->
        <text x="${padX - 8}" y="${gridY1}" text-anchor="end" class="fill-muted-foreground text-[10px]" dominant-baseline="middle">${fmtCompact(minVal)}</text>
        <text x="${padX - 8}" y="${gridY2}" text-anchor="end" class="fill-muted-foreground text-[10px]" dominant-baseline="middle">${fmtCompact(Math.round(maxVal / 2))}</text>
        <text x="${padX - 8}" y="${gridY3}" text-anchor="end" class="fill-muted-foreground text-[10px]" dominant-baseline="middle">${fmtCompact(maxVal)}</text>

        <!-- Area Fill -->
        <path d="${savesArea}" fill="url(#savesGrad)" />

        <!-- Repins Line -->
        <path d="${repinsPath}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Saves Line -->
        <path d="${savesPath}" fill="none" stroke="#f43f5e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Interactive Data Points with Full Number Tooltips -->
        ${metrics
          .map(
            (m, i) => `
              <g class="group cursor-pointer">
                <circle cx="${getX(i).toFixed(1)}" cy="${getY(Number(m.saves || 0)).toFixed(1)}" r="4.5" fill="#f43f5e" stroke="var(--color-card, #fff)" stroke-width="2" class="group-hover:r-6 transition-all" />
                <title>${fmtDate(m.recorded_at)}: ${fmtNumber(m.saves)} saves · ${fmtNumber(m.repins)} repins</title>
              </g>
            `
          )
          .join('')}

        <!-- X Axis Labels -->
        <text x="${padX}" y="${height - 10}" text-anchor="start" class="fill-muted-foreground text-[10px]">${fmtDate(metrics[0]?.recorded_at)}</text>
        <text x="${width - padX}" y="${height - 10}" text-anchor="end" class="fill-muted-foreground text-[10px]">${fmtDate(metrics[metrics.length - 1]?.recorded_at)}</text>
      </svg>
    `;
  }

  function setupCopyButton(id: string, textFn: () => string) {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.addEventListener('click', async () => {
      try {
        const text = textFn();
        await navigator.clipboard.writeText(text);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span>Copied ✓</span>';
        btn.classList.add('bg-emerald-500/20', 'text-emerald-600', 'dark:text-emerald-400');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('bg-emerald-500/20', 'text-emerald-600', 'dark:text-emerald-400');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy to clipboard', err);
      }
    });
  }

  function setupStickyBar(pin: any) {
    const stickyBar = document.getElementById('sticky-mini-bar');
    const stickyTitle = document.getElementById('sticky-title');
    const stickySaves = document.getElementById('sticky-saves');
    const stickyVelocity = document.getElementById('sticky-velocity');
    const stickyStage = document.getElementById('sticky-stage-badge');

    if (!stickyBar || !pin) return;

    if (stickyTitle) stickyTitle.textContent = pin.title || `Pin ${pin.pin_id}`;
    if (stickySaves) stickySaves.textContent = fmtNumber(pin.saves);
    if (stickyVelocity) stickyVelocity.textContent = `${Number(pin.velocity || 0).toFixed(1)}/d`;
    if (stickyStage) stickyStage.innerHTML = renderStageBadge(pin.stage);

    window.addEventListener('scroll', () => {
      if (window.scrollY > 400) {
        stickyBar.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
        stickyBar.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      } else {
        stickyBar.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
        stickyBar.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }
    });
  }

  function setupNotes(pin: any) {
    const textarea = document.getElementById('pin-notes-textarea') as HTMLTextAreaElement | null;
    const charCount = document.getElementById('notes-char-count');
    const saveBtn = document.getElementById('save-notes-btn') as HTMLButtonElement | null;
    const statusCaption = document.getElementById('notes-status-caption');

    if (!textarea || !saveBtn || !pin) return;

    textarea.value = pin.notes || '';
    if (charCount) charCount.textContent = `${textarea.value.length} / 2000`;
    if (statusCaption && pin.notes_updated_at) {
      statusCaption.textContent = `Last saved ${fmtDate(pin.notes_updated_at)}`;
    }

    textarea.addEventListener('input', () => {
      if (charCount) charCount.textContent = `${textarea.value.length} / 2000`;
    });

    saveBtn.addEventListener('click', async () => {
      try {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        const res = await fetch('/api/pinarchive/notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            pin_id: pin.id,
            notes: textarea.value,
          }),
        });

        const json = await res.json();
        if (!res.ok || !json.success) {
          throw new Error(json.error || 'Failed to save notes');
        }

        if (statusCaption) statusCaption.textContent = 'Saved just now ✓';
      } catch (err: any) {
        alert(`Error saving notes: ${err.message}`);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Notes';
      }
    });
  }

  async function loadPinDetail() {
    const urlParams = new URLSearchParams(window.location.search);
    const pinId = urlParams.get('id');

    const skeleton = document.getElementById('pin-loading-skeleton');
    const mainContent = document.getElementById('pin-main-content');
    const errorContainer = document.getElementById('pin-error-container');
    const errorText = document.getElementById('pin-error-text');

    if (!pinId) {
      if (skeleton) skeleton.classList.add('hidden');
      if (errorContainer) errorContainer.classList.remove('hidden');
      if (errorText) errorText.textContent = 'Missing pin identifier parameter in URL.';
      return;
    }

    try {
      if (skeleton) skeleton.classList.remove('hidden');
      if (mainContent) mainContent.classList.add('hidden');
      if (errorContainer) errorContainer.classList.add('hidden');

      const res = await fetch(`/api/pinarchive/pin?id=${encodeURIComponent(pinId)}`);
      if (!res.ok) {
        const errJson = await res.json().catch(() => ({}));
        throw new Error(errJson.error || `HTTP ${res.status}`);
      }

      const json = await res.json();
      if (!json.success || !json.pin) {
        throw new Error(json.error || 'Failed to load pin data');
      }

      const pin = json.pin;
      currentPin = pin;
      const metrics: any[] = json.metrics || [];
      const siblings: any[] = json.canonical_siblings || [];
      const clusterStats = json.cluster_stats || { total_saves: pin.saves, variations_count: 1, rank: 1, share_pct: 100 };

      // 1. Header Hero Card
      const img = document.getElementById('pin-detail-image') as HTMLImageElement | null;
      const fallbackIcon = document.getElementById('pin-detail-fallback-icon');
      if (img) {
        if (pin.image_url) {
          img.src = pin.image_url;
          img.onerror = () => {
            img.style.display = 'none';
            if (fallbackIcon) fallbackIcon.classList.remove('hidden');
          };
        } else {
          img.style.display = 'none';
          if (fallbackIcon) fallbackIcon.classList.remove('hidden');
        }
      }

      const stageBadge = document.getElementById('pin-stage-badge');
      if (stageBadge) stageBadge.innerHTML = renderStageBadge(pin.stage);

      const anomalyBadge = document.getElementById('pin-anomaly-badge');
      if (anomalyBadge) {
        if (pin.anomaly === 'SPIKE') {
          anomalyBadge.innerHTML = '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20 animate-pulse">🔥 SPIKE</span>';
        } else if (pin.anomaly === 'COOLING') {
          anomalyBadge.innerHTML = '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">❄️ COOLING</span>';
        } else {
          anomalyBadge.innerHTML = '';
        }
      }

      const categoryBadge = document.getElementById('pin-detail-category-badge');
      if (categoryBadge) {
        if (pin.seo_category) {
          categoryBadge.textContent = pin.seo_category;
          categoryBadge.classList.remove('hidden');
        } else {
          categoryBadge.classList.add('hidden');
        }
      }

      const boardBadge = document.getElementById('pin-board-badge');
      if (boardBadge) {
        boardBadge.textContent = pin.board_name ? `📁 ${pin.board_name}` : '📁 General Board';
      }

      const canonicalBadge = document.getElementById('pin-canonical-badge');
      if (canonicalBadge) {
        if (pin.canonical_pin_id) {
          canonicalBadge.textContent = `Canonical #${pin.canonical_pin_id}`;
          canonicalBadge.classList.remove('hidden');
        } else {
          canonicalBadge.classList.add('hidden');
        }
      }

      const titleEl = document.getElementById('pin-detail-title');
      if (titleEl) titleEl.textContent = pin.title || `Pin ${pin.pin_id}`;

      const descEl = document.getElementById('pin-detail-description');
      if (descEl) descEl.textContent = pin.description || pin.seo_alt_text || 'No description available for this pin.';

      const idStr = document.getElementById('pin-id-str');
      if (idStr) idStr.textContent = pin.pin_id || pin.id;

      // Created and Archived dates
      const createdDateStr = document.getElementById('pin-created-date-str');
      if (createdDateStr) createdDateStr.textContent = fmtDate(pin.created_at_pinterest);

      const dateStr = document.getElementById('pin-archived-date-str');
      if (dateStr) dateStr.textContent = fmtDate(pin.archived_at);

      const extLink = document.getElementById('pin-external-link') as HTMLAnchorElement | null;
      if (extLink) {
        extLink.href = pin.link || `https://www.pinterest.com/pin/${pin.pin_id}/`;
      }

      // Copy buttons
      setupCopyButton('copy-id-btn', () => pin.pin_id || pin.id);
      setupCopyButton('copy-url-btn', () => pin.link || `https://www.pinterest.com/pin/${pin.pin_id}/`);
      setupCopyButton('copy-title-btn', () => pin.title || `Pin ${pin.pin_id}`);

      // Annotations with linked clickable URLs for all chips
      const annContainer = document.getElementById('pin-annotations-container');
      const annCounter = document.getElementById('annotations-counter');
      if (annContainer) {
        const annotations = Array.isArray(pin.annotations) ? pin.annotations : [];
        let linkedCount = 0;

        if (annotations.length === 0) {
          annContainer.innerHTML = '<span class="text-xs text-muted-foreground">No annotations stored</span>';
          if (annCounter) annCounter.textContent = '';
        } else {
          annContainer.innerHTML = annotations
            .map((a: any) => {
              const name = typeof a === 'string' ? a : a?.name || '';
              if (!name) return '';
              let fullUrl = '';
              if (typeof a === 'object' && a?.url) {
                fullUrl = `https://www.pinterest.com${a.url.startsWith('/') ? a.url : '/' + a.url}`;
              } else if (typeof a === 'object' && a?.idea_id) {
                fullUrl = `https://www.pinterest.com/ideas/${encodeURIComponent(name)}/${a.idea_id}/`;
              } else {
                fullUrl = `https://www.pinterest.com/search/pins/?q=${encodeURIComponent(name)}`;
              }
              linkedCount++;

              return `
                <a
                  href="${escapeHtml(fullUrl)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs bg-primary/10 hover:bg-primary/20 text-primary px-2.5 py-1 rounded-lg font-medium border border-primary/20 transition-colors"
                  title="${escapeHtml(name)} (Pinterest Idea)"
                >
                  <span>${escapeHtml(name)}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              `;
            })
            .join('');

          if (annCounter) annCounter.textContent = `${linkedCount} linked annotation${linkedCount === 1 ? '' : 's'}`;
        }
      }

      // 2. KPI Deltas with Full Numbers
      const deltas = pin.deltas || {};
      const savesEl = document.getElementById('kpi-detail-saves');
      if (savesEl) savesEl.textContent = fmtNumber(pin.saves);
      const deltaSavesEl = document.getElementById('kpi-delta-saves');
      if (deltaSavesEl) deltaSavesEl.innerHTML = renderDelta(deltas.saves || 0, 'Saves');

      const repinsEl = document.getElementById('kpi-detail-repins');
      if (repinsEl) repinsEl.textContent = fmtNumber(pin.repins);
      const deltaRepinsEl = document.getElementById('kpi-delta-repins');
      if (deltaRepinsEl) deltaRepinsEl.innerHTML = renderDelta(deltas.repins || 0, 'Repins');

      const commentsEl = document.getElementById('kpi-detail-comments');
      if (commentsEl) commentsEl.textContent = fmtNumber(pin.comments);
      const deltaCommentsEl = document.getElementById('kpi-delta-comments');
      if (deltaCommentsEl) deltaCommentsEl.innerHTML = renderDelta(deltas.comments || 0, 'Comments');

      const sharesEl = document.getElementById('kpi-detail-shares');
      if (sharesEl) sharesEl.textContent = fmtNumber(pin.share_count);
      const deltaSharesEl = document.getElementById('kpi-delta-shares');
      if (deltaSharesEl) deltaSharesEl.innerHTML = renderDelta(deltas.shares || 0, 'Shares');

      const velocityEl = document.getElementById('kpi-detail-velocity');
      if (velocityEl) velocityEl.textContent = `${Number(pin.velocity || 0).toFixed(1)}/d`;

      const reactionsEl = document.getElementById('kpi-detail-reactions');
      const totalReactions = Number((pin.reactions as any)?.total || 0);
      if (reactionsEl) reactionsEl.textContent = fmtNumber(totalReactions);
      const deltaReactionsEl = document.getElementById('kpi-delta-reactions');
      if (deltaReactionsEl) deltaReactionsEl.innerHTML = renderDelta(deltas.reactions || 0, 'Reactions');

      // 3. SVG Trajectory Chart
      const metricsBadge = document.getElementById('metrics-count-badge');
      if (metricsBadge) metricsBadge.textContent = `${metrics.length} Snapshot${metrics.length === 1 ? '' : 's'}`;
      renderSvgChart(metrics);

      // 4. Canonical Asset Consolidation Card (T2)
      const consSection = document.getElementById('canonical-consolidation-section');
      const rankBadge = document.getElementById('cluster-rank-badge');
      const clusterSummary = document.getElementById('cluster-summary-text');
      const siblingsList = document.getElementById('canonical-siblings-list');

      if (consSection && pin.canonical_pin_id) {
        consSection.classList.remove('hidden');
        if (rankBadge) rankBadge.textContent = `Rank #${clusterStats.rank} of ${clusterStats.variations_count}`;
        if (clusterSummary) {
          clusterSummary.textContent = `This asset: ${fmtNumber(clusterStats.total_saves)} saves across ${clusterStats.variations_count} variation${clusterStats.variations_count === 1 ? '' : 's'} — your copy ranks #${clusterStats.rank} (${clusterStats.share_pct}% share).`;
        }

        if (siblingsList) {
          if (siblings.length > 0) {
            siblingsList.innerHTML = siblings
              .map(
                (s: any, idx: number) => {
                  const sSaves = Number(s.saves || 0);
                  const share = clusterStats.total_saves > 0 ? Math.round((sSaves / clusterStats.total_saves) * 100) : 0;
                  return `
                    <a
                      href="/pinarchive/details?id=${escapeHtml(s.id)}"
                      class="flex items-center justify-between p-3.5 hover:bg-muted/40 transition-colors group focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      <div class="flex items-center gap-3 min-w-0">
                        <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-purple-500/10 text-purple-500 font-bold text-xs shrink-0">
                          #${idx + 2}
                        </span>
                        <div class="min-w-0">
                          <span class="text-xs font-bold text-foreground group-hover:text-primary transition-colors truncate block">
                            ${escapeHtml(s.title || `Pin ${s.pin_id}`)}
                          </span>
                          <span class="text-[10px] text-muted-foreground font-mono">Pin ID: ${escapeHtml(s.pin_id)}</span>
                        </div>
                      </div>
                      <div class="flex items-center gap-3 shrink-0">
                        <span class="text-[10px] text-muted-foreground font-mono">(${share}%)</span>
                        <span class="text-xs font-bold text-rose-500">${fmtNumber(sSaves)} saves</span>
                        <span class="text-muted-foreground group-hover:text-primary transition-colors text-xs font-bold">→</span>
                      </div>
                    </a>
                  `;
                }
              )
              .join('');
          } else {
            siblingsList.innerHTML = '<div class="p-4 text-center text-xs text-muted-foreground">No other pin variations in this cluster.</div>';
          }
        }
      } else if (consSection) {
        consSection.classList.add('hidden');
      }

      // 5. Sticky bar & Notes
      setupStickyBar(pin);
      setupNotes(pin);

      if (skeleton) skeleton.classList.add('hidden');
      if (mainContent) mainContent.classList.remove('hidden');
    } catch (e: any) {
      console.error('Error loading pin detail:', e);
      if (skeleton) skeleton.classList.add('hidden');
      if (errorContainer) errorContainer.classList.remove('hidden');
      if (errorText) errorText.textContent = e.message || 'Failed to load pin details.';
    }
  }

  function init() {
    loadPinDetail();

    const refreshBtn = document.getElementById('refresh-pin-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const icon = document.getElementById('refresh-icon');
        if (icon) icon.classList.add('animate-spin');
        loadPinDetail().finally(() => {
          setTimeout(() => {
            if (icon) icon.classList.remove('animate-spin');
          }, 400);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
