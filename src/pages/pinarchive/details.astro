---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pin Deep-Dive & Metrics History — PinArchive" description="Archived pin performance, historical saves/repins growth, SEO annotations, and canonical cluster variations.">
  <!-- ═══ Sticky Mini-bar on Scroll ═══ -->
  <div
    id="sticky-mini-bar"
    class="fixed top-0 left-0 right-0 z-40 bg-card/90 backdrop-blur-md border-b border-border shadow-md px-6 py-2.5 flex items-center justify-between transition-all duration-300 -translate-y-full opacity-0 pointer-events-none"
  >
    <div class="flex items-center gap-3 min-w-0 max-w-xl">
      <a href="/pinarchive" class="text-xs font-semibold text-muted-foreground hover:text-foreground shrink-0 transition-colors">← Back</a>
      <span class="text-xs text-border shrink-0">|</span>
      <h3 id="sticky-title" class="text-xs font-bold text-foreground truncate"></h3>
    </div>
    <div class="flex items-center gap-4 text-xs shrink-0">
      <div>Saves: <strong id="sticky-saves" class="text-rose-500 font-bold tabular-nums">-</strong></div>
      <div>Velocity: <strong id="sticky-velocity" class="text-emerald-500 font-bold tabular-nums">-</strong></div>
      <div id="sticky-stage-badge"></div>
    </div>
  </div>

  <!-- Breadcrumb & Top Action Header -->
  <div class="mb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div class="flex items-center gap-2 text-xs">
      <a
        href="/pinarchive"
        class="inline-flex items-center gap-1.5 font-semibold text-muted-foreground hover:text-foreground transition-colors group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        <span>PinArchive</span>
      </a>
      <span class="text-muted-foreground/50">/</span>
      <span class="text-muted-foreground font-medium">Pin Deep-Dive</span>
      <span class="text-muted-foreground/50">/</span>
      <span id="breadcrumb-pin-title" class="font-bold text-foreground truncate max-w-[200px] sm:max-w-[320px]">Pin Details</span>
    </div>

    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span id="pin-refresh-meta" class="text-xs text-muted-foreground hidden sm:inline-block"></span>
      <button
        id="refresh-pin-btn"
        type="button"
        title="Refresh pin details"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all cursor-pointer"
      >
        <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
        </svg>
        <span>Refresh Data</span>
      </button>
    </div>
  </div>

  <!-- Loading Skeleton -->
  <div id="pin-loading-skeleton" class="space-y-6">
    <div class="rounded-3xl border border-border bg-card p-6 shadow-xs animate-pulse flex flex-col md:flex-row gap-6">
      <div class="w-full md:w-60 h-80 bg-muted rounded-2xl"></div>
      <div class="flex-1 space-y-4">
        <div class="h-5 w-1/3 bg-muted rounded-full"></div>
        <div class="h-8 w-3/4 bg-muted rounded-lg"></div>
        <div class="h-4 w-1/2 bg-muted rounded"></div>
        <div class="grid grid-cols-3 gap-3 pt-4">
          <div class="h-20 bg-muted rounded-2xl"></div>
          <div class="h-20 bg-muted rounded-2xl"></div>
          <div class="h-20 bg-muted rounded-2xl"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div id="pin-error-container" class="hidden rounded-3xl border border-rose-500/30 bg-rose-500/10 p-8 text-center text-xs text-rose-500 shadow-xs">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto mb-2 text-rose-500 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <p id="pin-error-text" class="font-bold text-sm">Failed to load pin details.</p>
    <a href="/pinarchive" class="mt-4 inline-block font-semibold text-primary hover:underline">Return to PinArchive</a>
  </div>

  <!-- Pin Detail Main Container -->
  <div id="pin-main-content" class="hidden space-y-6">
    <!-- ═══ 1. Pin Header Hero Card ═══ -->
    <div class="rounded-3xl border border-border bg-card p-6 sm:p-7 shadow-xs overflow-hidden">
      <div class="flex flex-col md:flex-row items-start gap-7">
        <!-- Pin Image Preview Card -->
        <div class="relative w-full md:w-64 shrink-0 aspect-[2/3] max-h-[380px] bg-muted/60 rounded-2xl overflow-hidden flex items-center justify-center border border-border/80 shadow-md group">
          <img
            id="pin-detail-image"
            src=""
            alt="Pinterest Pin"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
          />
          <div id="pin-detail-fallback-icon" class="hidden absolute inset-0 flex items-center justify-center text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </div>
          <span id="pin-detail-category-badge" class="hidden absolute top-3 left-3 text-[10px] font-bold bg-background/90 backdrop-blur-md text-foreground px-2.5 py-1 rounded-lg shadow-xs border border-border/40 max-w-[160px] truncate"></span>
          
          <a
            id="pin-image-overlay-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white font-bold text-xs gap-1.5 backdrop-blur-xs"
          >
            <span>Open High-Res</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <!-- Pin Information -->
        <div class="flex-1 space-y-4 min-w-0">
          <div>
            <!-- Status & Metadata Badges -->
            <div class="flex flex-wrap items-center gap-2 mb-2.5">
              <span id="pin-stage-badge"></span>
              <span id="pin-anomaly-badge"></span>
              <span id="pin-board-badge" class="inline-flex items-center gap-1 rounded-full bg-muted/80 px-3 py-1 text-xs font-semibold text-muted-foreground border border-border/60"></span>
              <span id="pin-canonical-badge" class="hidden inline-flex items-center gap-1 rounded-full bg-purple-500/10 px-3 py-1 text-xs font-bold text-purple-500 border border-purple-500/20"></span>
              <span id="pin-account-badge" class="hidden inline-flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-bold text-primary border border-primary/20"></span>
            </div>

            <!-- Title -->
            <h1 id="pin-detail-title" class="text-xl sm:text-2xl font-black tracking-tight text-foreground line-clamp-3 leading-snug"></h1>
            
            <!-- Description -->
            <p id="pin-detail-description" class="mt-2 text-xs text-muted-foreground line-clamp-3 leading-relaxed"></p>
          </div>

          <!-- Quick Copy Action Toolbar -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            <button
              id="copy-id-btn"
              type="button"
              class="inline-flex items-center gap-1.5 text-xs font-semibold bg-muted/60 hover:bg-muted text-foreground px-3 py-1.5 rounded-xl border border-border shadow-2xs transition-all cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span>Copy Pin ID</span>
            </button>
            <button
              id="copy-url-btn"
              type="button"
              class="inline-flex items-center gap-1.5 text-xs font-semibold bg-muted/60 hover:bg-muted text-foreground px-3 py-1.5 rounded-xl border border-border shadow-2xs transition-all cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <span>Copy Pinterest URL</span>
            </button>
            <button
              id="copy-title-btn"
              type="button"
              class="inline-flex items-center gap-1.5 text-xs font-semibold bg-muted/60 hover:bg-muted text-foreground px-3 py-1.5 rounded-xl border border-border shadow-2xs transition-all cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
              <span>Copy Title</span>
            </button>
          </div>

          <!-- Structured Metadata Key-Value Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-3 pb-1 border-t border-border/70">
            <div class="bg-muted/30 rounded-xl p-2.5 border border-border/40">
              <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground block">Pin ID</span>
              <span class="font-mono text-xs font-bold text-foreground block mt-0.5 truncate" id="pin-id-str">—</span>
            </div>
            <div class="bg-muted/30 rounded-xl p-2.5 border border-border/40">
              <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground block">Created Date</span>
              <span class="text-xs font-bold text-foreground block mt-0.5" id="pin-created-date-str">—</span>
            </div>
            <div class="bg-muted/30 rounded-xl p-2.5 border border-border/40">
              <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground block">First Tracked</span>
              <span class="text-xs font-bold text-foreground block mt-0.5" id="pin-first-seen-date-str">—</span>
            </div>
            <div class="bg-muted/30 rounded-xl p-2.5 border border-border/40">
              <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground block">Last Archived</span>
              <span class="text-xs font-bold text-foreground block mt-0.5" id="pin-archived-date-str">—</span>
            </div>
          </div>

          <!-- Direct External Action Links -->
          <div class="flex flex-wrap items-center gap-3 text-xs pt-1">
            <a
              id="pin-external-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-bold text-primary hover:underline"
            >
              <span>View on Pinterest</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
            <span id="pin-dest-sep" class="text-muted-foreground/60 hidden">•</span>
            <a
              id="pin-destination-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center gap-1 font-semibold text-muted-foreground hover:text-foreground hover:underline hidden"
            >
              <span>Visit Destination Site ↗</span>
            </a>
          </div>

          <!-- Annotation Tags with Clickable Pinterest Idea Links -->
          <div class="pt-2">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
                <span>🏷️</span>
                <span>Annotations & SEO Keywords</span>
              </span>
              <span id="annotations-counter" class="text-[10px] font-semibold text-muted-foreground"></span>
            </div>
            <div id="pin-annotations-container" class="flex flex-wrap items-center gap-1.5"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ 2. Clean 6-Card KPI Stat Bar ═══ -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <!-- Saves -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-2xs">
        <span class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider block">Total Saves</span>
        <div class="flex items-baseline gap-1.5 mt-1">
          <span class="text-2xl font-bold text-rose-500 tabular-nums" id="kpi-detail-saves">-</span>
          <span id="kpi-delta-saves" class="text-xs font-bold text-emerald-600 dark:text-emerald-400"></span>
        </div>
        <span class="text-[10px] text-muted-foreground block mt-0.5">Cumulative saves</span>
      </div>

      <!-- Repins -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-2xs">
        <span class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider block">Repins</span>
        <div class="flex items-baseline gap-1.5 mt-1">
          <span class="text-2xl font-bold text-foreground tabular-nums" id="kpi-detail-repins">-</span>
          <span id="kpi-delta-repins" class="text-xs font-bold text-emerald-600 dark:text-emerald-400"></span>
        </div>
        <span class="text-[10px] text-muted-foreground block mt-0.5">Re-pin shares</span>
      </div>

      <!-- Comments -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-2xs">
        <span class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider block">Comments</span>
        <div class="flex items-baseline gap-1.5 mt-1">
          <span class="text-2xl font-bold text-foreground tabular-nums" id="kpi-detail-comments">-</span>
          <span id="kpi-delta-comments" class="text-xs font-bold text-emerald-600 dark:text-emerald-400"></span>
        </div>
        <span class="text-[10px] text-muted-foreground block mt-0.5">User comments</span>
      </div>

      <!-- Shares -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-2xs">
        <span class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider block">Shares</span>
        <div class="flex items-baseline gap-1.5 mt-1">
          <span class="text-2xl font-bold text-sky-500 tabular-nums" id="kpi-detail-shares">-</span>
          <span id="kpi-delta-shares" class="text-xs font-bold text-emerald-600 dark:text-emerald-400"></span>
        </div>
        <span class="text-[10px] text-muted-foreground block mt-0.5">Social shares</span>
      </div>

      <!-- Velocity -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-2xs">
        <span class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider block">Velocity</span>
        <div class="text-2xl font-bold text-emerald-500 tabular-nums mt-1" id="kpi-detail-velocity">-</div>
        <span class="text-[10px] text-muted-foreground block mt-0.5">Saves / day</span>
      </div>

      <!-- Reactions -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-2xs">
        <span class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider block">Reactions</span>
        <div class="flex items-baseline gap-1.5 mt-1">
          <span class="text-2xl font-bold text-purple-500 tabular-nums" id="kpi-detail-reactions">-</span>
          <span id="kpi-delta-reactions" class="text-xs font-bold text-emerald-600 dark:text-emerald-400"></span>
        </div>
        <span class="text-[10px] text-muted-foreground block mt-0.5">Total reactions</span>
      </div>
    </div>

    <!-- ═══ 3. Performance Trajectory SVG Chart & Growth History ═══ -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-border/70">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>📈 Performance Trajectory</span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20" id="metrics-count-badge">0 Snapshots</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Historical growth curve tracked during automated refresh cycles.</p>
        </div>
        
        <div class="flex items-center gap-4 text-xs font-semibold">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
            <span class="text-foreground">Saves</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-blue-500"></span>
            <span class="text-foreground">Repins</span>
          </div>
        </div>
      </div>

      <!-- Chart Wrapper -->
      <div id="chart-wrapper" class="w-full relative">
        <div id="chart-notice" class="hidden py-10 text-center text-xs text-muted-foreground bg-muted/20 rounded-xl border border-dashed border-border"></div>
        <div id="svg-chart-container" class="w-full h-64 overflow-hidden relative"></div>
      </div>

      <!-- Snapshots History Table -->
      <div id="metrics-history-container" class="pt-2"></div>
    </div>

    <!-- ═══ 4. Canonical Asset Consolidation Card ═══ -->
    <div id="canonical-consolidation-section" class="hidden rounded-3xl border border-border bg-card p-6 sm:p-7 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 pb-4 border-b border-border/70">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>🧬 Canonical Asset Consolidation</span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20" id="cluster-rank-badge">Rank #1</span>
          </h2>
          <p id="cluster-summary-text" class="text-xs text-muted-foreground mt-0.5"></p>
        </div>
      </div>

      <div id="canonical-siblings-list" class="divide-y divide-border/60 bg-muted/20 rounded-2xl border border-border/60 overflow-hidden"></div>
    </div>

    <!-- ═══ 5. Pin Editorial Notes & Workspace Strategy ═══ -->
    <div class="rounded-3xl border border-border bg-card p-6 sm:p-7 shadow-xs space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>📝 Editorial Notes & Strategy</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Private workspace notes regarding content angle, imagery iteration, or performance.</p>
        </div>
        <span id="notes-status-caption" class="text-xs font-medium text-muted-foreground"></span>
      </div>

      <div class="space-y-3">
        <textarea
          id="pin-notes-textarea"
          rows="4"
          maxlength="2000"
          placeholder="Add strategic notes about this pin (e.g. key hooks, seasonality, high-performing boards)..."
          class="w-full rounded-2xl border border-border bg-background p-3.5 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary resize-y leading-relaxed"
        ></textarea>
        <div class="flex items-center justify-between">
          <span id="notes-char-count" class="text-[11px] text-muted-foreground font-mono">0 / 2000</span>
          <button
            id="save-notes-btn"
            type="button"
            class="rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary/90 transition-all disabled:opacity-50 cursor-pointer"
          >
            Save Notes
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let currentPin: any = null;

  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtCompact(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    if (num >= 1_000_000) return (num / 1_000_000).toFixed(1) + 'M';
    if (num >= 1_000) return (num / 1_000).toFixed(1) + 'k';
    return num.toLocaleString('en-US');
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function fmtDateTime(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    } catch {
      return '—';
    }
  }

  function renderDeltaChip(cur: number, prev: number | null): string {
    if (prev === null) return '';
    const d = cur - prev;
    if (d > 0) return `<span class="inline-block text-[10px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-1.5 py-0.2 rounded-md ml-1">(+${fmtNumber(d)})</span>`;
    if (d < 0) return `<span class="inline-block text-[10px] font-bold text-rose-500 bg-rose-500/10 px-1.5 py-0.2 rounded-md ml-1">(−${fmtNumber(Math.abs(d))})</span>`;
    return '';
  }

  function renderMetricsTable(metrics: any[]) {
    const container = document.getElementById('metrics-history-container');
    if (!container) return;

    if (!Array.isArray(metrics) || metrics.length === 0) {
      container.innerHTML = '<div class="py-8 text-center text-xs text-muted-foreground bg-muted/20 rounded-2xl">No snapshots recorded yet.</div>';
      return;
    }

    const rows = [...metrics].reverse(); // newest first
    const first = metrics[0];
    const last = metrics[metrics.length - 1];
    
    const calcNet = (k: string) => Number(last[k] || 0) - Number(first[k] || 0);

    const renderNetCell = (diff: number) => {
      if (diff > 0) {
        return `<td class="py-3 px-3.5 text-right font-bold tabular-nums text-emerald-600 dark:text-emerald-400 whitespace-nowrap">+${fmtNumber(diff)}</td>`;
      }
      if (diff < 0) {
        return `<td class="py-3 px-3.5 text-right font-bold tabular-nums text-rose-500 whitespace-nowrap">−${fmtNumber(Math.abs(diff))}</td>`;
      }
      return `<td class="py-3 px-3.5 text-right font-medium tabular-nums text-muted-foreground whitespace-nowrap">0</td>`;
    };

    const renderSnapshotCell = (val: number, delta: number | null) => {
      const strVal = fmtNumber(val);
      if (delta === null || delta === 0) {
        return `<td class="py-3 px-3.5 text-right font-medium tabular-nums text-foreground whitespace-nowrap">${strVal}</td>`;
      }
      if (delta > 0) {
        return `<td class="py-3 px-3.5 text-right font-medium tabular-nums text-foreground whitespace-nowrap">${strVal} <span class="font-bold text-emerald-600 dark:text-emerald-400 text-xs ml-1">(+${fmtNumber(delta)})</span></td>`;
      }
      return `<td class="py-3 px-3.5 text-right font-medium tabular-nums text-foreground whitespace-nowrap">${strVal} <span class="font-bold text-rose-500 text-xs ml-1">(−${fmtNumber(Math.abs(delta))})</span></td>`;
    };

    container.innerHTML = `
      <div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-2xs">
        <table class="w-full text-left text-xs">
          <thead class="bg-muted/40 text-muted-foreground text-[11px] uppercase border-b border-border/80 font-semibold">
            <tr>
              <th class="py-3 px-3.5">Recorded Date & Time</th>
              <th class="py-3 px-3.5 text-right">Saves</th>
              <th class="py-3 px-3.5 text-right">Repins</th>
              <th class="py-3 px-3.5 text-right">Comments</th>
              <th class="py-3 px-3.5 text-right">Shares</th>
              <th class="py-3 px-3.5 text-right">Reactions</th>
              <th class="py-3 px-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60">
            <tr class="bg-emerald-500/5 font-bold border-b border-emerald-500/20">
              <td class="py-3 px-3.5 text-emerald-600 dark:text-emerald-400 font-bold whitespace-nowrap">
                Σ Total Net Growth
              </td>
              ${renderNetCell(calcNet('saves'))}
              ${renderNetCell(calcNet('repins'))}
              ${renderNetCell(calcNet('comments'))}
              ${renderNetCell(calcNet('shares'))}
              ${renderNetCell(calcNet('reactions_total'))}
              <td></td>
            </tr>
            ${rows.map((m, idx) => {
              const prev = rows[idx + 1] || null;
              const getDelta = (k: string) => (prev ? Number(m[k] || 0) - Number(prev[k] || 0) : null);
              return `
                <tr class="hover:bg-muted/30 transition-colors">
                  <td class="py-3 px-3.5 font-medium text-muted-foreground whitespace-nowrap">
                    ${escapeHtml(fmtDateTime(m.recorded_at))}
                  </td>
                  ${renderSnapshotCell(Number(m.saves || 0), getDelta('saves'))}
                  ${renderSnapshotCell(Number(m.repins || 0), getDelta('repins'))}
                  ${renderSnapshotCell(Number(m.comments || 0), getDelta('comments'))}
                  ${renderSnapshotCell(Number(m.shares || 0), getDelta('shares'))}
                  ${renderSnapshotCell(Number(m.reactions_total || 0), getDelta('reactions_total'))}
                  <td class="py-3 px-3.5 text-right whitespace-nowrap">
                    <button
                      type="button"
                      data-del-metric="${escapeHtml(m.id || '')}"
                      class="rounded-lg border border-border hover:border-rose-500/40 hover:bg-rose-500/10 text-muted-foreground hover:text-rose-500 px-2 py-0.5 text-[11px] font-semibold transition-colors cursor-pointer"
                    >🗑 Delete</button>
                  </td>
                </tr>`;
            }).join('')}
          </tbody>
        </table>
      </div>
    `;

    container.querySelectorAll<HTMLButtonElement>('[data-del-metric]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-del-metric');
        if (!id) return;
        if (!confirm('Delete this snapshot? Deltas and growth velocity will automatically adjust.')) return;
        btn.disabled = true;
        try {
          const res = await fetch('/api/pinarchive/metrics', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ metric_ids: [id] }),
          });
          const json = await res.json();
          if (!res.ok || !json.success) throw new Error(json.error || `HTTP ${res.status}`);
          await loadPinDetail();
        } catch (err: any) {
          alert(`Error deleting snapshot: ${err.message}`);
          btn.disabled = false;
        }
      });
    });
  }

  function renderStageBadge(stage?: string | null): string {
    switch (stage) {
      case 'NEW':
        return '<span class="text-[10px] font-bold px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">🟢 NEW (≤14d)</span>';
      case 'GROWING':
        return '<span class="text-[10px] font-bold px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">🚀 GROWING (≥10/d)</span>';
      case 'MATURE':
        return '<span class="text-[10px] font-bold px-3 py-1 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">🟣 MATURE (>14d)</span>';
      case 'COOLING':
        return '<span class="text-[10px] font-bold px-3 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">❄️ COOLING (<2/d)</span>';
      default:
        return '<span class="text-[10px] font-bold px-3 py-1 rounded-full bg-slate-500/10 text-slate-500 border border-slate-500/20">⚪ DORMANT (<0.5/d)</span>';
    }
  }

  function renderDelta(val: number, label: string): string {
    if (val > 0) {
      return `(+${fmtNumber(val)})`;
    }
    if (val < 0) {
      return `(−${fmtNumber(Math.abs(val))})`;
    }
    return '';
  }

  function renderSvgChart(metrics: any[]) {
    const container = document.getElementById('svg-chart-container');
    const notice = document.getElementById('chart-notice');
    if (!container || !notice) return;

    if (!Array.isArray(metrics) || metrics.length < 2) {
      notice.innerHTML = '<span class="font-medium">Building history…</span> Next automated refresh cycle will plot the trajectory curve (1 snapshot recorded).';
      notice.classList.remove('hidden');
      container.classList.add('hidden');
      return;
    }

    notice.classList.add('hidden');
    container.classList.remove('hidden');

    const width = container.clientWidth || 800;
    const height = 240;
    const padX = 50;
    const padY = 25;

    const saves = metrics.map((m) => Number(m.saves || 0));
    const repins = metrics.map((m) => Number(m.repins || 0));
    const maxVal = Math.max(...saves, ...repins, 10);
    const minVal = 0;

    const ptsCount = metrics.length;
    const getX = (i: number) => padX + (i / (ptsCount - 1)) * (width - padX * 2);
    const getY = (v: number) => height - padY - ((v - minVal) / (maxVal - minVal)) * (height - padY * 2);

    const savesPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.saves || 0)).toFixed(1)}`)
      .join(' ');

    const repinsPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.repins || 0)).toFixed(1)}`)
      .join(' ');

    const savesArea = `${savesPath} L ${getX(ptsCount - 1)} ${height - padY} L ${getX(0)} ${height - padY} Z`;
    const repinsArea = `${repinsPath} L ${getX(ptsCount - 1)} ${height - padY} L ${getX(0)} ${height - padY} Z`;

    const gridY1 = height - padY;
    const gridY2 = height - padY - (height - padY * 2) * 0.5;
    const gridY3 = padY;

    container.innerHTML = `
      <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" class="overflow-visible" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="savesGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.28"/>
            <stop offset="100%" stop-color="#f43f5e" stop-opacity="0.0"/>
          </linearGradient>
          <linearGradient id="repinsGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.0"/>
          </linearGradient>
        </defs>

        <!-- Grid lines -->
        <line x1="${padX}" y1="${gridY1}" x2="${width - padX}" y2="${gridY1}" stroke="currentColor" class="text-border/60" stroke-width="1" />
        <line x1="${padX}" y1="${gridY2}" x2="${width - padX}" y2="${gridY2}" stroke="currentColor" class="text-border/40" stroke-dasharray="4 4" stroke-width="1" />
        <line x1="${padX}" y1="${gridY3}" x2="${width - padX}" y2="${gridY3}" stroke="currentColor" class="text-border/40" stroke-dasharray="4 4" stroke-width="1" />

        <!-- Y Axis Labels -->
        <text x="${padX - 8}" y="${gridY1}" text-anchor="end" class="fill-muted-foreground text-[10px] font-medium" dominant-baseline="middle">${fmtCompact(minVal)}</text>
        <text x="${padX - 8}" y="${gridY2}" text-anchor="end" class="fill-muted-foreground text-[10px] font-medium" dominant-baseline="middle">${fmtCompact(Math.round(maxVal / 2))}</text>
        <text x="${padX - 8}" y="${gridY3}" text-anchor="end" class="fill-muted-foreground text-[10px] font-medium" dominant-baseline="middle">${fmtCompact(maxVal)}</text>

        <!-- Area Fills -->
        <path d="${repinsArea}" fill="url(#repinsGrad)" />
        <path d="${savesArea}" fill="url(#savesGrad)" />

        <!-- Repins Polyline -->
        <path d="${repinsPath}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Saves Polyline -->
        <path d="${savesPath}" fill="none" stroke="#f43f5e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Interactive Data Points -->
        ${metrics
          .map(
            (m, i) => `
              <g class="group cursor-pointer">
                <circle cx="${getX(i).toFixed(1)}" cy="${getY(Number(m.saves || 0)).toFixed(1)}" r="4.5" fill="#f43f5e" stroke="var(--color-card, #fff)" stroke-width="2" class="group-hover:r-6 transition-all" />
                <circle cx="${getX(i).toFixed(1)}" cy="${getY(Number(m.repins || 0)).toFixed(1)}" r="3.5" fill="#3b82f6" stroke="var(--color-card, #fff)" stroke-width="1.5" class="group-hover:r-5 transition-all" />
                <title>${fmtDateTime(m.recorded_at)}: ${fmtNumber(m.saves)} saves · ${fmtNumber(m.repins)} repins</title>
              </g>
            `
          )
          .join('')}

        <!-- X Axis Labels -->
        <text x="${padX}" y="${height - 6}" text-anchor="start" class="fill-muted-foreground text-[10px] font-medium">${fmtDate(metrics[0]?.recorded_at)}</text>
        <text x="${width - padX}" y="${height - 6}" text-anchor="end" class="fill-muted-foreground text-[10px] font-medium">${fmtDate(metrics[metrics.length - 1]?.recorded_at)}</text>
      </svg>
    `;
  }

  function setupCopyButton(id: string, textFn: () => string) {
    const btn = document.getElementById(id);
    if (!btn) return;
    btn.addEventListener('click', async () => {
      try {
        const text = textFn();
        await navigator.clipboard.writeText(text);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span>Copied ✓</span>';
        btn.classList.add('bg-emerald-500/20', 'text-emerald-600', 'dark:text-emerald-400', 'border-emerald-500/30');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('bg-emerald-500/20', 'text-emerald-600', 'dark:text-emerald-400', 'border-emerald-500/30');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy to clipboard', err);
      }
    });
  }

  function setupStickyBar(pin: any) {
    const stickyBar = document.getElementById('sticky-mini-bar');
    const stickyTitle = document.getElementById('sticky-title');
    const stickySaves = document.getElementById('sticky-saves');
    const stickyVelocity = document.getElementById('sticky-velocity');
    const stickyStage = document.getElementById('sticky-stage-badge');

    if (!stickyBar || !pin) return;

    if (stickyTitle) stickyTitle.textContent = pin.title || `Pin ${pin.pin_id}`;
    if (stickySaves) stickySaves.textContent = fmtNumber(pin.saves);
    if (stickyVelocity) stickyVelocity.textContent = `${Number(pin.velocity || 0).toFixed(1)}/d`;
    if (stickyStage) stickyStage.innerHTML = renderStageBadge(pin.stage);

    window.addEventListener('scroll', () => {
      if (window.scrollY > 350) {
        stickyBar.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
        stickyBar.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      } else {
        stickyBar.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
        stickyBar.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }
    });
  }

  function setupNotes(pin: any) {
    const textarea = document.getElementById('pin-notes-textarea') as HTMLTextAreaElement | null;
    const charCount = document.getElementById('notes-char-count');
    const saveBtn = document.getElementById('save-notes-btn') as HTMLButtonElement | null;
    const statusCaption = document.getElementById('notes-status-caption');

    if (!textarea || !saveBtn || !pin) return;

    textarea.value = pin.notes || '';
    if (charCount) charCount.textContent = `${textarea.value.length} / 2000`;
    if (statusCaption && pin.notes_updated_at) {
      statusCaption.textContent = `Last saved ${fmtDate(pin.notes_updated_at)}`;
    }

    textarea.addEventListener('input', () => {
      if (charCount) charCount.textContent = `${textarea.value.length} / 2000`;
    });

    saveBtn.addEventListener('click', async () => {
      try {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';
        const res = await fetch('/api/pinarchive/notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            pin_id: pin.id,
            notes: textarea.value,
          }),
        });

        const json = await res.json();
        if (!res.ok || !json.success) {
          throw new Error(json.error || 'Failed to save notes');
        }

        if (statusCaption) statusCaption.textContent = 'Saved just now ✓';
      } catch (err: any) {
        alert(`Error saving notes: ${err.message}`);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Notes';
      }
    });
  }

  async function loadPinDetail() {
    const urlParams = new URLSearchParams(window.location.search);
    const pinId = urlParams.get('id');

    const skeleton = document.getElementById('pin-loading-skeleton');
    const mainContent = document.getElementById('pin-main-content');
    const errorContainer = document.getElementById('pin-error-container');
    const errorText = document.getElementById('pin-error-text');

    if (!pinId) {
      if (skeleton) skeleton.classList.add('hidden');
      if (errorContainer) errorContainer.classList.remove('hidden');
      if (errorText) errorText.textContent = 'Missing pin identifier parameter in URL.';
      return;
    }

    try {
      if (skeleton) skeleton.classList.remove('hidden');
      if (mainContent) mainContent.classList.add('hidden');
      if (errorContainer) errorContainer.classList.add('hidden');

      const res = await fetch(`/api/pinarchive/pin?id=${encodeURIComponent(pinId)}`);
      if (!res.ok) {
        const errJson = await res.json().catch(() => ({}));
        throw new Error(errJson.error || `HTTP ${res.status}`);
      }

      const json = await res.json();
      if (!json.success || !json.pin) {
        throw new Error(json.error || 'Failed to load pin data');
      }

      const pin = json.pin;
      currentPin = pin;
      const metrics: any[] = json.metrics || [];
      const siblings: any[] = json.canonical_siblings || [];
      const clusterStats = json.cluster_stats || { total_saves: pin.saves, variations_count: 1, rank: 1, share_pct: 100 };

      // Breadcrumb title
      const bcTitle = document.getElementById('breadcrumb-pin-title');
      if (bcTitle) bcTitle.textContent = pin.title || `Pin #${pin.pin_id}`;

      // 1. Header Hero Card
      const img = document.getElementById('pin-detail-image') as HTMLImageElement | null;
      const fallbackIcon = document.getElementById('pin-detail-fallback-icon');
      const imgOverlayLink = document.getElementById('pin-image-overlay-link') as HTMLAnchorElement | null;
      
      if (img) {
        if (pin.image_url) {
          img.src = pin.image_url;
          if (imgOverlayLink) imgOverlayLink.href = pin.image_url;
          img.onerror = () => {
            img.style.display = 'none';
            if (fallbackIcon) fallbackIcon.classList.remove('hidden');
          };
        } else {
          img.style.display = 'none';
          if (fallbackIcon) fallbackIcon.classList.remove('hidden');
        }
      }

      const stageBadge = document.getElementById('pin-stage-badge');
      if (stageBadge) stageBadge.innerHTML = renderStageBadge(pin.stage);

      const anomalyBadge = document.getElementById('pin-anomaly-badge');
      if (anomalyBadge) {
        if (pin.anomaly === 'SPIKE') {
          anomalyBadge.innerHTML = '<span class="text-[10px] font-bold px-3 py-1 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20 animate-pulse">🔥 SPIKE</span>';
        } else if (pin.anomaly === 'COOLING') {
          anomalyBadge.innerHTML = '<span class="text-[10px] font-bold px-3 py-1 rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">❄️ COOLING</span>';
        } else {
          anomalyBadge.innerHTML = '';
        }
      }

      const categoryBadge = document.getElementById('pin-detail-category-badge');
      if (categoryBadge) {
        if (pin.seo_category) {
          categoryBadge.textContent = pin.seo_category;
          categoryBadge.classList.remove('hidden');
        } else {
          categoryBadge.classList.add('hidden');
        }
      }

      const boardBadge = document.getElementById('pin-board-badge');
      if (boardBadge) {
        boardBadge.textContent = pin.board_name ? `📁 ${pin.board_name}` : '📁 General Board';
      }

      const canonicalBadge = document.getElementById('pin-canonical-badge');
      if (canonicalBadge) {
        if (pin.canonical_pin_id) {
          canonicalBadge.textContent = `🧬 Canonical #${pin.canonical_pin_id}`;
          canonicalBadge.classList.remove('hidden');
        } else {
          canonicalBadge.classList.add('hidden');
        }
      }

      const accountBadge = document.getElementById('pin-account-badge');
      if (accountBadge) {
        if (pin.account_username) {
          accountBadge.textContent = `@${pin.account_username}`;
          accountBadge.classList.remove('hidden');
        } else {
          accountBadge.classList.add('hidden');
        }
      }

      const titleEl = document.getElementById('pin-detail-title');
      if (titleEl) titleEl.textContent = pin.title || `Pin ${pin.pin_id}`;

      const descEl = document.getElementById('pin-detail-description');
      if (descEl) descEl.textContent = pin.description || pin.seo_alt_text || 'No description available for this pin.';

      const idStr = document.getElementById('pin-id-str');
      if (idStr) idStr.textContent = pin.pin_id || pin.id;

      // Created and Archived dates
      const createdDateStr = document.getElementById('pin-created-date-str');
      if (createdDateStr) createdDateStr.textContent = fmtDate(pin.created_at_pinterest);

      const dateStr = document.getElementById('pin-archived-date-str');
      if (dateStr) dateStr.textContent = fmtDate(pin.archived_at);

      const firstSeenDateStr = document.getElementById('pin-first-seen-date-str');
      if (firstSeenDateStr) firstSeenDateStr.textContent = fmtDate(pin.first_seen_at);

      const extLink = document.getElementById('pin-external-link') as HTMLAnchorElement | null;
      if (extLink) {
        extLink.href = `https://www.pinterest.com/pin/${pin.pin_id || pin.id}/`;
      }

      const destLink = document.getElementById('pin-destination-link') as HTMLAnchorElement | null;
      const destSep = document.getElementById('pin-dest-sep');
      if (destLink) {
        if (pin.link) {
          destLink.href = pin.link;
          destLink.classList.remove('hidden');
          if (destSep) destSep.classList.remove('hidden');
        } else {
          destLink.classList.add('hidden');
          if (destSep) destSep.classList.add('hidden');
        }
      }

      // Copy buttons
      setupCopyButton('copy-id-btn', () => pin.pin_id || pin.id);
      setupCopyButton('copy-url-btn', () => `https://www.pinterest.com/pin/${pin.pin_id || pin.id}/`);
      setupCopyButton('copy-title-btn', () => pin.title || `Pin ${pin.pin_id}`);

      // Annotations with linked clickable URLs
      const annContainer = document.getElementById('pin-annotations-container');
      const annCounter = document.getElementById('annotations-counter');
      if (annContainer) {
        const annotations = Array.isArray(pin.annotations) ? pin.annotations : [];
        let linkedCount = 0;

        if (annotations.length === 0) {
          annContainer.innerHTML = '<span class="text-xs text-muted-foreground">No annotations stored</span>';
          if (annCounter) annCounter.textContent = '';
        } else {
          annContainer.innerHTML = annotations
            .map((a: any) => {
              const name = typeof a === 'string' ? a : a?.name || '';
              if (!name) return '';
              let fullUrl = '';
              if (typeof a === 'object' && a?.url) {
                fullUrl = `https://www.pinterest.com${a.url.startsWith('/') ? a.url : '/' + a.url}`;
              } else if (typeof a === 'object' && a?.idea_id) {
                fullUrl = `https://www.pinterest.com/ideas/${encodeURIComponent(name)}/${a.idea_id}/`;
              } else {
                fullUrl = `https://www.pinterest.com/search/pins/?q=${encodeURIComponent(name)}`;
              }
              linkedCount++;

              return `
                <a
                  href="${escapeHtml(fullUrl)}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 px-3 py-1.5 rounded-xl font-medium border border-rose-500/20 transition-all group"
                  title="${escapeHtml(name)} (Pinterest Idea)"
                >
                  <span>${escapeHtml(name)}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 shrink-0 opacity-70 group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              `;
            })
            .join('');

          if (annCounter) annCounter.textContent = `${linkedCount} linked idea${linkedCount === 1 ? '' : 's'}`;
        }
      }

      // 2. KPI Deltas with Full Numbers
      const deltas = pin.deltas || {};
      const savesEl = document.getElementById('kpi-detail-saves');
      if (savesEl) savesEl.textContent = fmtNumber(pin.saves);
      const deltaSavesEl = document.getElementById('kpi-delta-saves');
      if (deltaSavesEl) {
        deltaSavesEl.textContent = renderDelta(deltas.saves || 0, 'Saves');
        deltaSavesEl.className = (deltas.saves || 0) >= 0 ? 'text-xs font-bold text-emerald-600 dark:text-emerald-400' : 'text-xs font-bold text-rose-500';
      }

      const repinsEl = document.getElementById('kpi-detail-repins');
      if (repinsEl) repinsEl.textContent = fmtNumber(pin.repins);
      const deltaRepinsEl = document.getElementById('kpi-delta-repins');
      if (deltaRepinsEl) {
        deltaRepinsEl.textContent = renderDelta(deltas.repins || 0, 'Repins');
        deltaRepinsEl.className = (deltas.repins || 0) >= 0 ? 'text-xs font-bold text-emerald-600 dark:text-emerald-400' : 'text-xs font-bold text-rose-500';
      }

      const commentsEl = document.getElementById('kpi-detail-comments');
      if (commentsEl) commentsEl.textContent = fmtNumber(pin.comments);
      const deltaCommentsEl = document.getElementById('kpi-delta-comments');
      if (deltaCommentsEl) {
        deltaCommentsEl.textContent = renderDelta(deltas.comments || 0, 'Comments');
        deltaCommentsEl.className = (deltas.comments || 0) >= 0 ? 'text-xs font-bold text-emerald-600 dark:text-emerald-400' : 'text-xs font-bold text-rose-500';
      }

      const sharesEl = document.getElementById('kpi-detail-shares');
      if (sharesEl) sharesEl.textContent = fmtNumber(pin.share_count);
      const deltaSharesEl = document.getElementById('kpi-delta-shares');
      if (deltaSharesEl) {
        deltaSharesEl.textContent = renderDelta(deltas.shares || 0, 'Shares');
        deltaSharesEl.className = (deltas.shares || 0) >= 0 ? 'text-xs font-bold text-emerald-600 dark:text-emerald-400' : 'text-xs font-bold text-rose-500';
      }

      const velocityEl = document.getElementById('kpi-detail-velocity');
      if (velocityEl) velocityEl.textContent = `${Number(pin.velocity || 0).toFixed(1)}/d`;

      const reactionsEl = document.getElementById('kpi-detail-reactions');
      const totalReactions = Number((pin.reactions as any)?.total || 0);
      if (reactionsEl) reactionsEl.textContent = fmtNumber(totalReactions);
      const deltaReactionsEl = document.getElementById('kpi-delta-reactions');
      if (deltaReactionsEl) {
        deltaReactionsEl.textContent = renderDelta(deltas.reactions || 0, 'Reactions');
        deltaReactionsEl.className = (deltas.reactions || 0) >= 0 ? 'text-xs font-bold text-emerald-600 dark:text-emerald-400' : 'text-xs font-bold text-rose-500';
      }

      // 3. SVG Trajectory Chart
      const metricsBadge = document.getElementById('metrics-count-badge');
      if (metricsBadge) metricsBadge.textContent = `${metrics.length} Snapshot${metrics.length === 1 ? '' : 's'}`;
      renderSvgChart(metrics);
      renderMetricsTable(metrics);

      // 4. Canonical Asset Consolidation Card
      const consSection = document.getElementById('canonical-consolidation-section');
      const rankBadge = document.getElementById('cluster-rank-badge');
      const clusterSummary = document.getElementById('cluster-summary-text');
      const siblingsList = document.getElementById('canonical-siblings-list');

      if (consSection && pin.canonical_pin_id) {
        consSection.classList.remove('hidden');
        if (rankBadge) rankBadge.textContent = `Rank #${clusterStats.rank} of ${clusterStats.variations_count}`;
        if (clusterSummary) {
          clusterSummary.textContent = `This asset: ${fmtNumber(clusterStats.total_saves)} saves across ${clusterStats.variations_count} variation${clusterStats.variations_count === 1 ? '' : 's'} — your copy ranks #${clusterStats.rank} (${clusterStats.share_pct}% share).`;
        }

        if (siblingsList) {
          if (siblings.length > 0) {
            siblingsList.innerHTML = siblings
              .map(
                (s: any, idx: number) => {
                  const sSaves = Number(s.saves || 0);
                  const share = clusterStats.total_saves > 0 ? Math.round((sSaves / clusterStats.total_saves) * 100) : 0;
                  return `
                    <a
                      href="/pinarchive/details?id=${escapeHtml(s.id)}"
                      class="flex items-center justify-between p-4 hover:bg-muted/40 transition-colors group focus-visible:ring-2 focus-visible:ring-primary"
                    >
                      <div class="flex items-center gap-3.5 min-w-0">
                        <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 font-bold text-xs shrink-0">
                          #${idx + 2}
                        </span>
                        <div class="min-w-0">
                          <span class="text-xs font-bold text-foreground group-hover:text-primary transition-colors truncate block">
                            ${escapeHtml(s.title || `Pin ${s.pin_id}`)}
                          </span>
                          <span class="text-[10px] text-muted-foreground font-mono">Pin ID: ${escapeHtml(s.pin_id)}</span>
                        </div>
                      </div>
                      <div class="flex items-center gap-3 shrink-0">
                        <span class="text-[10px] text-muted-foreground font-mono">(${share}%)</span>
                        <span class="text-xs font-bold text-rose-500 tabular-nums">${fmtNumber(sSaves)} saves</span>
                        <span class="text-muted-foreground group-hover:text-primary transition-colors text-xs font-bold">→</span>
                      </div>
                    </a>
                  `;
                }
              )
              .join('');
          } else {
            siblingsList.innerHTML = '<div class="p-5 text-center text-xs text-muted-foreground">Unique variation in this workspace (sole pinned instance).</div>';
          }
        }
      } else if (consSection) {
        consSection.classList.add('hidden');
      }

      // 5. Sticky bar & Notes
      setupStickyBar(pin);
      setupNotes(pin);

      if (skeleton) skeleton.classList.add('hidden');
      if (errorContainer) errorContainer.classList.add('hidden');
      if (mainContent) mainContent.classList.remove('hidden');
    } catch (e: any) {
      if (retries > 0) {
        setTimeout(() => loadPinDetail(retries - 1), 1500);
        return;
      }
      console.error('Error loading pin detail:', e);
      if (skeleton) skeleton.classList.add('hidden');
      if (mainContent) mainContent.classList.add('hidden');
      if (errorContainer) {
        errorContainer.classList.remove('hidden');
        errorContainer.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto mb-2 text-rose-500 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <p id="pin-error-text" class="font-bold text-sm">Failed to load pin details: ${escapeHtml(e.message || 'Error')}</p>
          <div class="mt-4 flex items-center justify-center gap-3">
            <button id="retry-pin-detail-btn" class="font-bold underline cursor-pointer">Retry</button>
            <span class="text-muted-foreground">•</span>
            <a href="/pinarchive" class="font-semibold text-primary hover:underline">Return to PinArchive</a>
          </div>
        `;
        document.getElementById('retry-pin-detail-btn')?.addEventListener('click', () => {
          if (skeleton) skeleton.classList.remove('hidden');
          if (errorContainer) errorContainer.classList.add('hidden');
          loadPinDetail(2);
        });
      }
    }
  }

  function init() {
    loadPinDetail();

    const refreshBtn = document.getElementById('refresh-pin-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const icon = document.getElementById('refresh-icon');
        if (icon) icon.classList.add('animate-spin');
        loadPinDetail().finally(() => {
          setTimeout(() => {
            if (icon) icon.classList.remove('animate-spin');
          }, 400);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
