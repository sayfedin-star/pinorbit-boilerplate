---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pin Deep-Dive & Metrics History" description="Archived pin performance, historical saves/repins growth, SEO annotations, and canonical cluster variations.">
  <!-- Back Button & Breadcrumbs Header -->
  <div class="mb-4 flex items-center justify-between">
    <a href="/pinarchive" class="inline-flex items-center gap-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <span>Back to PinArchive Intelligence</span>
    </a>

    <div class="flex items-center gap-2">
      <button
        id="refresh-pin-btn"
        type="button"
        title="Refresh pin details"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all"
      >
        <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
        </svg>
        <span>Refresh</span>
      </button>
    </div>
  </div>

  <!-- Loading Skeleton -->
  <div id="pin-loading-skeleton" class="space-y-6">
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm animate-pulse flex flex-col md:flex-row gap-6">
      <div class="w-full md:w-56 h-64 bg-muted rounded-xl"></div>
      <div class="flex-1 space-y-4">
        <div class="h-6 w-3/4 bg-muted rounded"></div>
        <div class="h-4 w-1/2 bg-muted rounded"></div>
        <div class="grid grid-cols-3 gap-3 pt-4">
          <div class="h-16 bg-muted rounded-xl"></div>
          <div class="h-16 bg-muted rounded-xl"></div>
          <div class="h-16 bg-muted rounded-xl"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error State -->
  <div id="pin-error-container" class="hidden rounded-2xl border border-rose-500/30 bg-rose-500/10 p-8 text-center text-xs text-rose-500 shadow-sm">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto mb-2 text-rose-500 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <p id="pin-error-text" class="font-bold text-sm">Failed to load pin details.</p>
    <a href="/pinarchive" class="mt-4 inline-block font-semibold text-primary hover:underline">Return to PinArchive</a>
  </div>

  <!-- Pin Detail Main Container -->
  <div id="pin-main-content" class="hidden space-y-8">
    <!-- ═══ Pin Header Card ═══ -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm overflow-hidden">
      <div class="flex flex-col md:flex-row items-start gap-6">
        <!-- Pin Image Preview -->
        <div class="relative w-full md:w-56 shrink-0 aspect-[2/3] max-h-80 bg-muted/60 rounded-xl overflow-hidden flex items-center justify-center border border-border/80 shadow-sm group">
          <img
            id="pin-detail-image"
            src=""
            alt="Pinterest Pin"
            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
          />
          <div id="pin-detail-fallback-icon" class="hidden absolute inset-0 flex items-center justify-center text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </div>
          <span id="pin-detail-category-badge" class="hidden absolute top-2.5 left-2.5 text-[10px] font-bold bg-background/90 backdrop-blur-xs text-foreground px-2.5 py-1 rounded-md shadow-xs border border-border/40"></span>
        </div>

        <!-- Pin Information -->
        <div class="flex-1 space-y-4 min-w-0">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span id="pin-board-badge" class="rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-muted-foreground border border-border/60"></span>
              <span id="pin-canonical-badge" class="hidden rounded-full bg-purple-500/10 px-2.5 py-0.5 text-xs font-bold text-purple-500 border border-purple-500/20"></span>
            </div>
            <h1 id="pin-detail-title" class="text-xl font-bold tracking-tight text-foreground line-clamp-3"></h1>
            <p id="pin-detail-description" class="mt-2 text-xs text-muted-foreground line-clamp-3"></p>
          </div>

          <!-- Metadata row -->
          <div class="flex flex-wrap items-center gap-3 text-xs text-muted-foreground pt-1 border-t border-border/60">
            <div class="flex items-center gap-1.5">
              <span>Pin ID:</span>
              <strong class="font-mono text-foreground" id="pin-id-str"></strong>
            </div>
            <span>•</span>
            <div class="flex items-center gap-1.5">
              <span>Archived:</span>
              <span class="font-medium text-foreground" id="pin-archived-date-str"></span>
            </div>
            <span>•</span>
            <a
              id="pin-external-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-semibold text-primary hover:underline"
            >
              <span>View on Pinterest</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>

          <!-- Annotation Tags -->
          <div class="pt-2">
            <span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider block mb-1.5">Annotations & SEO Keywords</span>
            <div id="pin-annotations-container" class="flex flex-wrap items-center gap-1.5"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ KPI Stats Grid (6 Chips) ═══ -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Total Saves</span>
        <div class="text-xl font-bold text-rose-500 mt-1" id="kpi-detail-saves">-</div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Cumulative</span>
      </div>
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Repins</span>
        <div class="text-xl font-bold text-foreground mt-1" id="kpi-detail-repins">-</div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Re-pin shares</span>
      </div>
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Comments</span>
        <div class="text-xl font-bold text-foreground mt-1" id="kpi-detail-comments">-</div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">User comments</span>
      </div>
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Shares</span>
        <div class="text-xl font-bold text-blue-500 mt-1" id="kpi-detail-shares">-</div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Social shares</span>
      </div>
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Velocity</span>
        <div class="text-xl font-bold text-emerald-500 mt-1" id="kpi-detail-velocity">-</div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Saves / day</span>
      </div>
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm text-center">
        <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Reactions</span>
        <div class="text-xl font-bold text-purple-500 mt-1" id="kpi-detail-reactions">-</div>
        <span class="text-[9px] text-muted-foreground block mt-0.5">Total reactions</span>
      </div>
    </div>

    <!-- ═══ Performance Trend Chart & History ═══ -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-6">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>📈 Performance Trajectory</span>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500" id="metrics-count-badge">0 Snapshots</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Historical saves growth tracked during automated refresh cycles.</p>
        </div>
        <div class="flex items-center gap-3 text-xs">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
            <span class="text-muted-foreground font-medium">Saves</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-blue-500"></span>
            <span class="text-muted-foreground font-medium">Repins</span>
          </div>
        </div>
      </div>

      <!-- Chart / Notice Container -->
      <div id="chart-wrapper" class="w-full">
        <div id="chart-notice" class="hidden py-16 text-center text-xs text-muted-foreground bg-muted/20 rounded-xl border border-dashed border-border">
          Not enough history yet — refresh cycle will build history.
        </div>
        <div id="svg-chart-container" class="w-full h-64 overflow-hidden relative"></div>
      </div>
    </div>

    <!-- ═══ Canonical Duplicates / Siblings Section ═══ -->
    <div id="canonical-siblings-section" class="hidden rounded-2xl border border-border bg-card p-6 shadow-sm">
      <div class="mb-4">
        <h2 class="text-base font-bold text-foreground flex items-center gap-2">
          <span>🧬 Canonical Variations in Cluster</span>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-500" id="siblings-count-badge">0 Variations</span>
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">Other pins in this workspace that share the same Pinterest canonical root ID.</p>
      </div>

      <div id="canonical-siblings-list" class="divide-y divide-border/60 bg-muted/20 rounded-xl border border-border/60 overflow-hidden"></div>
    </div>
  </div>
</Layout>

<script>
  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    if (num >= 1_000_000) return (num / 1_000_000).toFixed(1) + 'M';
    if (num >= 1_000) return (num / 1_000).toFixed(1) + 'k';
    return num.toLocaleString();
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return 'N/A';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return 'N/A';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return 'N/A';
    }
  }

  function renderSvgChart(metrics: any[]) {
    const container = document.getElementById('svg-chart-container');
    const notice = document.getElementById('chart-notice');
    if (!container || !notice) return;

    if (!Array.isArray(metrics) || metrics.length < 2) {
      notice.classList.remove('hidden');
      container.classList.add('hidden');
      return;
    }

    notice.classList.add('hidden');
    container.classList.remove('hidden');

    const width = container.clientWidth || 800;
    const height = 250;
    const padX = 50;
    const padY = 30;

    const saves = metrics.map((m) => Number(m.saves || 0));
    const repins = metrics.map((m) => Number(m.repins || 0));
    const maxVal = Math.max(...saves, ...repins, 10);
    const minVal = 0;

    const ptsCount = metrics.length;
    const getX = (i: number) => padX + (i / (ptsCount - 1)) * (width - padX * 2);
    const getY = (v: number) => height - padY - ((v - minVal) / (maxVal - minVal)) * (height - padY * 2);

    const savesPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.saves || 0)).toFixed(1)}`)
      .join(' ');

    const repinsPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.repins || 0)).toFixed(1)}`)
      .join(' ');

    // Area path for saves
    const savesArea = `${savesPath} L ${getX(ptsCount - 1)} ${height - padY} L ${getX(0)} ${height - padY} Z`;

    // Grid lines
    const gridY1 = height - padY;
    const gridY2 = height - padY - (height - padY * 2) * 0.5;
    const gridY3 = padY;

    container.innerHTML = `
      <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" class="overflow-visible" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="savesGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#f43f5e" stop-opacity="0.0"/>
          </linearGradient>
        </defs>

        <!-- Grid lines -->
        <line x1="${padX}" y1="${gridY1}" x2="${width - padX}" y2="${gridY1}" stroke="currentColor" class="text-border" stroke-width="1" />
        <line x1="${padX}" y1="${gridY2}" x2="${width - padX}" y2="${gridY2}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />
        <line x1="${padX}" y1="${gridY3}" x2="${width - padX}" y2="${gridY3}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />

        <!-- Y Axis Labels -->
        <text x="${padX - 8}" y="${gridY1}" text-anchor="end" class="fill-muted-foreground text-[10px]" dominant-baseline="middle">${fmtNumber(minVal)}</text>
        <text x="${padX - 8}" y="${gridY2}" text-anchor="end" class="fill-muted-foreground text-[10px]" dominant-baseline="middle">${fmtNumber(Math.round(maxVal / 2))}</text>
        <text x="${padX - 8}" y="${gridY3}" text-anchor="end" class="fill-muted-foreground text-[10px]" dominant-baseline="middle">${fmtNumber(maxVal)}</text>

        <!-- Area Fill -->
        <path d="${savesArea}" fill="url(#savesGrad)" />

        <!-- Repins Line -->
        <path d="${repinsPath}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Saves Line -->
        <path d="${savesPath}" fill="none" stroke="#f43f5e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Data points -->
        ${metrics
          .map(
            (m, i) => `
              <circle cx="${getX(i).toFixed(1)}" cy="${getY(Number(m.saves || 0)).toFixed(1)}" r="4" fill="#f43f5e" stroke="var(--color-card, #fff)" stroke-width="2">
                <title>${fmtDate(m.recorded_at)}: ${fmtNumber(m.saves)} saves</title>
              </circle>
            `
          )
          .join('')}

        <!-- X Axis Labels (first and last) -->
        <text x="${padX}" y="${height - 10}" text-anchor="start" class="fill-muted-foreground text-[10px]">${fmtDate(metrics[0]?.recorded_at)}</text>
        <text x="${width - padX}" y="${height - 10}" text-anchor="end" class="fill-muted-foreground text-[10px]">${fmtDate(metrics[metrics.length - 1]?.recorded_at)}</text>
      </svg>
    `;
  }

  async function loadPinDetail() {
    const urlParams = new URLSearchParams(window.location.search);
    const pinId = urlParams.get('id');

    const skeleton = document.getElementById('pin-loading-skeleton');
    const mainContent = document.getElementById('pin-main-content');
    const errorContainer = document.getElementById('pin-error-container');
    const errorText = document.getElementById('pin-error-text');

    if (!pinId) {
      if (skeleton) skeleton.classList.add('hidden');
      if (errorContainer) errorContainer.classList.remove('hidden');
      if (errorText) errorText.textContent = 'Missing pin identifier parameter in URL.';
      return;
    }

    try {
      if (skeleton) skeleton.classList.remove('hidden');
      if (mainContent) mainContent.classList.add('hidden');
      if (errorContainer) errorContainer.classList.add('hidden');

      const res = await fetch(`/api/pinarchive/pin?id=${encodeURIComponent(pinId)}`);
      if (!res.ok) {
        const errJson = await res.json().catch(() => ({}));
        throw new Error(errJson.error || `HTTP ${res.status}`);
      }

      const json = await res.json();
      if (!json.success || !json.pin) {
        throw new Error(json.error || 'Failed to load pin data');
      }

      const pin = json.pin;
      const metrics: any[] = json.metrics || [];
      const siblings: any[] = json.canonical_siblings || [];

      // 1. Populate Header Card
      const img = document.getElementById('pin-detail-image') as HTMLImageElement | null;
      const fallbackIcon = document.getElementById('pin-detail-fallback-icon');
      if (img) {
        if (pin.image_url) {
          img.src = pin.image_url;
          img.onerror = () => {
            img.style.display = 'none';
            if (fallbackIcon) fallbackIcon.classList.remove('hidden');
          };
        } else {
          img.style.display = 'none';
          if (fallbackIcon) fallbackIcon.classList.remove('hidden');
        }
      }

      const categoryBadge = document.getElementById('pin-detail-category-badge');
      if (categoryBadge) {
        if (pin.seo_category) {
          categoryBadge.textContent = pin.seo_category;
          categoryBadge.classList.remove('hidden');
        } else {
          categoryBadge.classList.add('hidden');
        }
      }

      const boardBadge = document.getElementById('pin-board-badge');
      if (boardBadge) {
        boardBadge.textContent = pin.board_name ? `📁 ${pin.board_name}` : '📁 General Board';
      }

      const canonicalBadge = document.getElementById('pin-canonical-badge');
      if (canonicalBadge) {
        if (pin.canonical_pin_id) {
          canonicalBadge.textContent = `Canonical #${pin.canonical_pin_id}`;
          canonicalBadge.classList.remove('hidden');
        } else {
          canonicalBadge.classList.add('hidden');
        }
      }

      const titleEl = document.getElementById('pin-detail-title');
      if (titleEl) titleEl.textContent = pin.title || `Pin ${pin.pin_id}`;

      const descEl = document.getElementById('pin-detail-description');
      if (descEl) descEl.textContent = pin.description || pin.seo_alt_text || 'No description available for this pin.';

      const idStr = document.getElementById('pin-id-str');
      if (idStr) idStr.textContent = pin.pin_id || pin.id;

      const dateStr = document.getElementById('pin-archived-date-str');
      if (dateStr) dateStr.textContent = fmtDate(pin.archived_at || pin.created_at_pinterest);

      const extLink = document.getElementById('pin-external-link') as HTMLAnchorElement | null;
      if (extLink) {
        extLink.href = pin.link || `https://www.pinterest.com/pin/${pin.pin_id}/`;
      }

      // Annotations
      const annContainer = document.getElementById('pin-annotations-container');
      if (annContainer) {
        const annotations = Array.isArray(pin.annotations) ? pin.annotations : [];
        if (annotations.length === 0) {
          annContainer.innerHTML = '<span class="text-xs text-muted-foreground">No annotations stored</span>';
        } else {
          const visible = annotations.slice(0, 10);
          const overflow = annotations.length > 10 ? annotations.length - 10 : 0;
          annContainer.innerHTML = `
            ${visible
              .map((a: any) => {
                const name = typeof a === 'string' ? a : a.name;
                return `<span class="inline-block text-xs bg-muted px-2.5 py-1 rounded-lg text-foreground font-medium border border-border/60">${escapeHtml(name)}</span>`;
              })
              .join('')}
            ${overflow > 0 ? `<span class="text-xs text-muted-foreground font-bold px-2 py-1">+${overflow} more</span>` : ''}
          `;
        }
      }

      // 2. Populate KPI Chips
      const savesEl = document.getElementById('kpi-detail-saves');
      if (savesEl) savesEl.textContent = fmtNumber(pin.saves);

      const repinsEl = document.getElementById('kpi-detail-repins');
      if (repinsEl) repinsEl.textContent = fmtNumber(pin.repins);

      const commentsEl = document.getElementById('kpi-detail-comments');
      if (commentsEl) commentsEl.textContent = fmtNumber(pin.comments);

      const sharesEl = document.getElementById('kpi-detail-shares');
      if (sharesEl) sharesEl.textContent = fmtNumber(pin.share_count);

      const velocityEl = document.getElementById('kpi-detail-velocity');
      if (velocityEl) velocityEl.textContent = `${Number(pin.velocity || 0).toFixed(1)}/d`;

      const reactionsEl = document.getElementById('kpi-detail-reactions');
      const totalReactions = Number((pin.reactions as any)?.total || 0);
      if (reactionsEl) reactionsEl.textContent = fmtNumber(totalReactions);

      // 3. Render Chart
      const metricsBadge = document.getElementById('metrics-count-badge');
      if (metricsBadge) metricsBadge.textContent = `${metrics.length} Snapshot${metrics.length === 1 ? '' : 's'}`;
      renderSvgChart(metrics);

      // 4. Canonical Siblings
      const siblingsSection = document.getElementById('canonical-siblings-section');
      const siblingsBadge = document.getElementById('siblings-count-badge');
      const siblingsList = document.getElementById('canonical-siblings-list');

      if (siblingsSection && siblingsList) {
        if (siblings.length > 0) {
          if (siblingsBadge) siblingsBadge.textContent = `${siblings.length} Variation${siblings.length === 1 ? '' : 's'}`;
          siblingsSection.classList.remove('hidden');
          siblingsList.innerHTML = siblings
            .map(
              (s: any) => `
                <a
                  href="/pinarchive/details?id=${escapeHtml(s.id)}"
                  class="flex items-center justify-between p-3.5 hover:bg-muted/40 transition-colors group"
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-purple-500/10 text-purple-500 shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                    </span>
                    <div class="min-w-0">
                      <span class="text-xs font-bold text-foreground group-hover:text-primary transition-colors truncate block">
                        ${escapeHtml(s.title || `Pin ${s.pin_id}`)}
                      </span>
                      <span class="text-[10px] text-muted-foreground font-mono">Pin ID: ${escapeHtml(s.pin_id)}</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <span class="text-xs font-bold text-rose-500">${fmtNumber(s.saves)} saves</span>
                    <span class="text-muted-foreground group-hover:text-primary transition-colors text-xs font-bold">→</span>
                  </div>
                </a>
              `
            )
            .join('');
        } else {
          siblingsSection.classList.add('hidden');
        }
      }

      if (skeleton) skeleton.classList.add('hidden');
      if (mainContent) mainContent.classList.remove('hidden');
    } catch (e: any) {
      console.error('Error loading pin detail:', e);
      if (skeleton) skeleton.classList.add('hidden');
      if (errorContainer) errorContainer.classList.remove('hidden');
      if (errorText) errorText.textContent = e.message || 'Failed to load pin details.';
    }
  }

  function init() {
    loadPinDetail();

    const refreshBtn = document.getElementById('refresh-pin-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const icon = document.getElementById('refresh-icon');
        if (icon) icon.classList.add('animate-spin');
        loadPinDetail().finally(() => {
          setTimeout(() => {
            if (icon) icon.classList.remove('animate-spin');
          }, 400);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
