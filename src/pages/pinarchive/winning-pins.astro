  function renderPins(pins: any[]) {
    const grid = document.getElementById('winners-grid');
    const badge = document.getElementById('winners-badge-count');
    if (badge) badge.textContent = `${pins.length}`;

    if (!grid) return;

    if (pins.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full py-12 text-center text-xs text-muted-foreground bg-muted/20 rounded-xl border border-dashed border-border">
          No archived winning pins matched your active filters.
        </div>
      `;
      return;
    }

    grid.innerHTML = pins.map((p) => renderSinglePinCard(p)).join('');
    attachCompareListeners();
  }

  function renderByBoard(pins: any[]) {
    const container = document.getElementById('by-board-container');
    if (!container) return;

    if (pins.length === 0) {
      container.innerHTML = `
        <div class="py-12 text-center text-xs text-muted-foreground bg-muted/20 rounded-xl border border-dashed border-border">
          No pins available to group by board.
        </div>
      `;
      return;
    }

    const groups: Record<string, any[]> = {};
    pins.forEach((p) => {
      const b = p.board_name || 'Unassigned Board';
      if (!groups[b]) groups[b] = [];
      groups[b].push(p);
    });

    container.innerHTML = Object.entries(groups)
      .map(([boardName, boardPins]) => {
        const boardSaves = boardPins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
        return `
          <div class="rounded-xl border border-border bg-card p-5 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-border/60 pb-3">
              <div class="flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-foreground">${escapeHtml(boardName)}</h3>
                  <span class="text-[11px] text-muted-foreground">${boardPins.length} pin${boardPins.length === 1 ? '' : 's'} · ${fmtNumber(boardSaves)} total saves</span>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              ${boardPins.map((p) => renderSinglePinCard(p)).join('')}
            </div>
          </div>
        `;
      })
      .join('');

    attachCompareListeners();
  }

  function renderCanonicalClusters(pins: any[]) {
    const container = document.getElementById('canonical-container');
    const badge = document.getElementById('canonical-badge-count');
    if (!container) return;

    const clusters: Record<string, any[]> = {};
    pins.forEach((p) => {
      if (p.canonical_pin_id) {
        if (!clusters[p.canonical_pin_id]) clusters[p.canonical_pin_id] = [];
        clusters[p.canonical_pin_id].push(p);
      }
    });

    const clusterEntries = Object.entries(clusters).filter(([_, list]) => list.length >= 1);
    if (badge) badge.textContent = `${clusterEntries.length} Clusters`;

    if (clusterEntries.length === 0) {
      container.innerHTML = `
        <div class="p-8 text-center text-xs text-muted-foreground">
          No canonical pin clusters found for active filters.
        </div>
      `;
      return;
    }

    container.innerHTML = clusterEntries
      .map(([canonicalId, clusterPins]) => {
        const clusterTotalSaves = clusterPins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
        clusterPins.sort((a, b) => Number(b.saves || 0) - Number(a.saves || 0));

        const itemsList = clusterPins
          .map((p) => {
            const pinSaves = Number(p.saves || 0);
            const sharePct = clusterTotalSaves > 0 ? Math.round((pinSaves / clusterTotalSaves) * 100) : 0;
            return `
              <li class="flex items-center justify-between py-1.5 px-3 text-xs rounded-lg hover:bg-muted/40 transition-colors">
                <div class="flex items-center gap-2 min-w-0">
                  <a href="/pinarchive/details?id=${encodeURIComponent(p.id)}" class="font-medium text-foreground hover:text-primary transition-colors truncate max-w-md">
                    ${escapeHtml(p.title || `Pin ${p.pin_id}`)}
                  </a>
                  <span class="text-[10px] text-muted-foreground">(@${escapeHtml(p.board_name || 'board')})</span>
                </div>
                <div class="flex items-center gap-2 shrink-0 ml-2">
                  <span class="text-[10px] text-muted-foreground font-mono">(${sharePct}%)</span>
                  <span class="font-bold text-rose-500">${fmtNumber(pinSaves)} saves</span>
                </div>
              </li>
            `;
          })
          .join('');

        return `
          <div class="p-5 hover:bg-muted/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-md bg-purple-500/10 text-purple-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                </span>
                <span class="font-bold text-xs text-foreground font-mono">Canonical #${escapeHtml(canonicalId)}</span>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-500">
                  ${clusterPins.length} Pin Variations
                </span>
              </div>
              <span class="text-xs font-semibold text-muted-foreground">
                Cluster Saves: <strong class="text-foreground">${fmtNumber(clusterTotalSaves)}</strong>
              </span>
            </div>
            <ul class="space-y-0.5 bg-muted/20 rounded-xl p-2 border border-border/40">
              ${itemsList}
            </ul>
          </div>
        `;
      })
      .join('');
  }

  function populateBoardFilter(pins: any[]) {
    const select = document.getElementById('filter-board-select') as HTMLSelectElement | null;
    if (!select) return;

    const currentVal = select.value;
    const boards = Array.from(new Set(pins.map((p) => p.board_name).filter(Boolean))).sort();

    select.innerHTML = '<option value="">All Boards</option>' +
      boards.map((b) => `<option value="${escapeHtml(b)}" ${b === currentVal ? 'selected' : ''}>${escapeHtml(b)}</option>`).join('');
  }

  async function loadPins(retries = 2) {
    const searchInput = document.getElementById('filter-search-input') as HTMLInputElement | null;
    const boardSelect = document.getElementById('filter-board-select') as HTMLSelectElement | null;
    const stageSelect = document.getElementById('filter-stage-select') as HTMLSelectElement | null;
    const clusterToggle = document.getElementById('filter-cluster-toggle') as HTMLInputElement | null;

    const params = new URLSearchParams();
    if (searchInput?.value) params.set('q', searchInput.value.trim());
    if (boardSelect?.value) params.set('board', boardSelect.value);
    if (stageSelect?.value) params.set('stage', stageSelect.value);
    if (clusterToggle?.checked) params.set('in_cluster', '1');
    params.set('sort', currentSort);
    params.set('limit', String(currentLimit));

    try {
      const res = await fetch(`/api/pinarchive/pins?${params.toString()}`, { signal: AbortSignal.timeout(8000) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load pins');

      rawPins = json.pins || [];

      // Populate Board select if not set
      if (!boardSelect?.value) {
        populateBoardFilter(rawPins);
      }

      // Render based on active view
      if (activeView === 'grid') {
        renderPins(rawPins);
      } else {
        renderByBoard(rawPins);
      }

      renderCanonicalClusters(rawPins);
    } catch (e: any) {
      if (retries > 0) {
        setTimeout(() => loadPins(retries - 1), 1500);
        return;
      }
      console.error('Error loading PinArchive pins:', e);
      const grid = document.getElementById('winners-grid');
      if (grid) {
        grid.innerHTML = `
          <div class="col-span-full py-12 text-center text-xs text-rose-500 bg-rose-500/10 rounded-2xl border border-rose-500/20 p-6">
            Failed to load winning pins. <button id="retry-load-pins-btn" class="underline font-bold cursor-pointer ml-1">Retry</button>
          </div>
        `;
        document.getElementById('retry-load-pins-btn')?.addEventListener('click', () => loadPins(2));
      }
      const canonicalContainer = document.getElementById('canonical-container');
      if (canonicalContainer) {
        canonicalContainer.innerHTML = '<div class="p-6 text-center text-xs text-muted-foreground">Failed to load cluster data.</div>';
      }
    }
  }

  function attachCompareListeners() {
    document.querySelectorAll<HTMLInputElement>('[data-pin-compare]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-pin-compare');
        if (!id) return;
        if (cb.checked) {
          if (selectedForCompare.size >= 2) {
            cb.checked = false;
            alert('You can select a maximum of 2 pins for side-by-side comparison.');
            return;
          }
          selectedForCompare.add(id);
        } else {
          selectedForCompare.delete(id);
        }
        updateCompareBar();
      });
    });
  }

  function updateCompareBar() {
    const bar = document.getElementById('floating-compare-bar');
    const text = document.getElementById('compare-count-text');
    if (!bar || !text) return;

    if (selectedForCompare.size > 0) {
      bar.classList.remove('hidden');
      text.textContent = `${selectedForCompare.size} of 2 Pins Selected`;
    } else {
      bar.classList.add('hidden');
    }
  }

  function renderPinSvgChart(metrics: any[], gradId: string): string {
    if (!Array.isArray(metrics) || metrics.length === 0) {
      return '<div class="h-44 flex items-center justify-center text-xs text-muted-foreground bg-muted/10 rounded-xl border border-dashed border-border/80">No historical snapshots recorded yet</div>';
    }

    if (metrics.length === 1) {
      const m = metrics[0];
      return `
        <div class="h-44 flex flex-col items-center justify-center text-xs text-muted-foreground bg-muted/10 rounded-xl border border-dashed border-border/80 p-4 text-center">
          <span class="font-semibold text-foreground mb-1">1 Snapshot Recorded</span>
          <span>${fmtDate(m.recorded_at)}: ${fmtNumber(m.saves)} saves · ${fmtNumber(m.repins)} repins</span>
          <span class="text-[10px] text-muted-foreground mt-1">Refresh cycle will plot trajectory curve</span>
        </div>
      `;
    }

    const width = 380;
    const height = 180;
    const padX = 40;
    const padY = 24;

    const saves = metrics.map((m) => Number(m.saves || 0));
    const repins = metrics.map((m) => Number(m.repins || 0));
    const maxVal = Math.max(...saves, ...repins, 10);
    const minVal = 0;

    const ptsCount = metrics.length;
    const getX = (i: number) => padX + (i / (ptsCount - 1)) * (width - padX * 2);
    const getY = (v: number) => height - padY - ((v - minVal) / (maxVal - minVal)) * (height - padY * 2);

    const savesPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.saves || 0)).toFixed(1)}`)
      .join(' ');

    const repinsPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.repins || 0)).toFixed(1)}`)
      .join(' ');

    const savesArea = `${savesPath} L ${getX(ptsCount - 1)} ${height - padY} L ${getX(0)} ${height - padY} Z`;

    const gridY1 = height - padY;
    const gridY2 = height - padY - (height - padY * 2) * 0.5;
    const gridY3 = padY;

    return `
      <div class="h-48 w-full bg-card rounded-xl border border-border/60 p-2">
        <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" class="overflow-visible" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.25"/>
              <stop offset="100%" stop-color="#f43f5e" stop-opacity="0.0"/>
            </linearGradient>
          </defs>

          <!-- Grid lines -->
          <line x1="${padX}" y1="${gridY1}" x2="${width - padX}" y2="${gridY1}" stroke="currentColor" class="text-border" stroke-width="1" />
          <line x1="${padX}" y1="${gridY2}" x2="${width - padX}" y2="${gridY2}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />
          <line x1="${padX}" y1="${gridY3}" x2="${width - padX}" y2="${gridY3}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />

          <!-- Y Axis Labels -->
          <text x="${padX - 6}" y="${gridY1}" text-anchor="end" class="fill-muted-foreground text-[9px]" dominant-baseline="middle">${fmtCompact(minVal)}</text>
          <text x="${padX - 6}" y="${gridY2}" text-anchor="end" class="fill-muted-foreground text-[9px]" dominant-baseline="middle">${fmtCompact(Math.round(maxVal / 2))}</text>
          <text x="${padX - 6}" y="${gridY3}" text-anchor="end" class="fill-muted-foreground text-[9px]" dominant-baseline="middle">${fmtCompact(maxVal)}</text>

          <!-- Area Fill -->
          <path d="${savesArea}" fill="url(#${gradId})" />

          <!-- Repins Line -->
          <path d="${repinsPath}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

          <!-- Saves Line -->
          <path d="${savesPath}" fill="none" stroke="#f43f5e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

          <!-- Data Points -->
          ${metrics
            .map(
              (m, i) => `
                <g class="group cursor-pointer">
                  <circle cx="${getX(i).toFixed(1)}" cy="${getY(Number(m.saves || 0)).toFixed(1)}" r="3.5" fill="#f43f5e" stroke="var(--color-card, #fff)" stroke-width="1.5" />
                  <title>${fmtDate(m.recorded_at)}: ${fmtNumber(m.saves)} saves · ${fmtNumber(m.repins)} repins</title>
                </g>
              `
            )
            .join('')}
        </svg>
      </div>
      <div class="flex items-center justify-between text-[10px] text-muted-foreground px-2 pt-1">
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-rose-500"></span> Saves</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-blue-500"></span> Repins</span>
        <span>${metrics.length} snapshot(s)</span>
      </div>
    `;
  }

