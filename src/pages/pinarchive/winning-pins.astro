  // ═══ Render Canonical Clusters View ═══
  function renderCanonicalClusters(pins: any[]) {
    const container = document.getElementById('canonical-container');
    const badge = document.getElementById('canonical-badge-count');
    if (!container) return;

    const clusters: Record<string, any[]> = {};
    pins.forEach((p) => {
      if (p.canonical_pin_id) {
        if (!clusters[p.canonical_pin_id]) clusters[p.canonical_pin_id] = [];
        clusters[p.canonical_pin_id].push(p);
      }
    });

    const clusterEntries = Object.entries(clusters).filter(([_, list]) => list.length >= 1);
    if (badge) badge.textContent = `${clusterEntries.length} Clusters`;

    if (clusterEntries.length === 0) {
      container.innerHTML = `
        <div class="p-8 text-center text-xs text-muted-foreground">
          No canonical pin clusters found for active filters.
        </div>
      `;
      return;
    }

    container.innerHTML = clusterEntries
      .map(([canonicalId, clusterPins]) => {
        const clusterTotalSaves = clusterPins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
        clusterPins.sort((a, b) => Number(b.saves || 0) - Number(a.saves || 0));

        const itemsList = clusterPins
          .map((p) => {
            const pinSaves = Number(p.saves || 0);
            const sharePct = clusterTotalSaves > 0 ? Math.round((pinSaves / clusterTotalSaves) * 100) : 0;
            return `
              <li class="flex items-center justify-between py-2 px-3 text-xs rounded-xl hover:bg-muted/40 transition-colors">
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="h-8 w-8 rounded-lg bg-muted overflow-hidden shrink-0 border border-border cursor-pointer" data-peek-trigger="${escapeHtml(p.id)}">
                    ${p.image_url ? `<img src="${escapeHtml(p.image_url)}" class="h-full w-full object-cover" />` : ''}
                  </div>
                  <a href="javascript:void(0)" data-peek-trigger="${escapeHtml(p.id)}" class="font-bold text-foreground hover:text-primary transition-colors truncate max-w-md">
                    ${escapeHtml(p.title || `Pin ${p.pin_id}`)}
                  </a>
                  <span class="text-[10px] text-muted-foreground">(@${escapeHtml(p.board_name || 'board')})</span>
                </div>
                <div class="flex items-center gap-3 shrink-0 ml-2">
                  <span class="text-[10px] text-muted-foreground font-mono">(${sharePct}%)</span>
                  <span class="font-extrabold text-rose-500 font-mono">${fmtNumber(pinSaves)} saves</span>
                </div>
              </li>
            `;
          })
          .join('');

        return `
          <div class="p-5 hover:bg-muted/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-purple-500/10 text-purple-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                </span>
                <span class="font-extrabold text-xs text-foreground font-mono">Canonical #${escapeHtml(canonicalId)}</span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-500 border border-purple-500/20">
                  ${clusterPins.length} Variations
                </span>
              </div>
              <span class="text-xs font-semibold text-muted-foreground">
                Cluster Total: <strong class="text-foreground font-extrabold font-mono">${fmtNumber(clusterTotalSaves)} saves</strong>
              </span>
            </div>
            <ul class="space-y-1 bg-muted/20 rounded-2xl p-2.5 border border-border/40">
              ${itemsList}
            </ul>
          </div>
        `;
      })
      .join('');

    attachListeners();
  }

  // ═══ Quick-Peek Drawer Logic & Forecast Projections ═══
