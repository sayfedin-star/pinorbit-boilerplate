      <div class="flex items-center gap-1.5">
        <!-- Prev/Next Pin Navigation in Drawer -->
        <button id="peek-prev-btn" type="button" title="Previous pin" class="p-1.5 rounded-lg border border-border bg-background text-muted-foreground hover:text-foreground cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button id="peek-next-btn" type="button" title="Next pin" class="p-1.5 rounded-lg border border-border bg-background text-muted-foreground hover:text-foreground cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <button id="peek-close-btn" type="button" class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted cursor-pointer ml-1">
