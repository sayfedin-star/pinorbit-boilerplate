  function closeQuickPeek() {
    const backdrop = document.getElementById('quick-peek-backdrop');
    const drawer = document.getElementById('quick-peek-drawer');
    if (backdrop) backdrop.classList.add('hidden');
    if (drawer) drawer.classList.add('translate-x-full');
  }

  // ═══ Attach Click & Checkbox Listeners ═══
  function attachListeners() {
    // Quick Peek Triggers
    document.querySelectorAll<HTMLElement>('[data-peek-trigger]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = el.getAttribute('data-peek-trigger');
        if (id) openQuickPeek(id);
      });
    });

    // Compare Checkboxes
    document.querySelectorAll<HTMLInputElement>('[data-pin-compare]').forEach((cb) => {
      cb.addEventListener('change', (e) => {
        e.stopPropagation();
        const id = cb.getAttribute('data-pin-compare');
        if (!id) return;
        if (cb.checked) {
          if (selectedForCompare.size >= 4) {
            cb.checked = false;
            alert('You can select a maximum of 4 pins simultaneously for comparison / AI prompt generation.');
            return;
          }
          selectedForCompare.add(id);
        } else {
          selectedForCompare.delete(id);
        }
        updateCompareBar();
      });
    });
  }

  function updateCompareBar() {
    const bar = document.getElementById('floating-compare-bar');
    const text = document.getElementById('compare-count-text');
    if (!bar || !text) return;

    if (selectedForCompare.size > 0) {
      bar.classList.remove('hidden');
      text.textContent = `${selectedForCompare.size} of 4 Pins Selected`;
    } else {
      bar.classList.add('hidden');
    }
  }

  // ═══ SVG Growth Trajectory Chart ═══
  function renderPinSvgChart(metrics: any[], gradId: string): string {
    if (!Array.isArray(metrics) || metrics.length === 0) {
      return '<div class="h-44 flex items-center justify-center text-xs text-muted-foreground bg-muted/10 rounded-2xl border border-dashed border-border/80">No historical snapshots recorded yet</div>';
    }

    if (metrics.length === 1) {
      const m = metrics[0];
      return `
        <div class="h-44 flex flex-col items-center justify-center text-xs text-muted-foreground bg-muted/10 rounded-2xl border border-dashed border-border/80 p-4 text-center">
          <span class="font-bold text-foreground mb-1">1 Snapshot Recorded</span>
          <span>${fmtDate(m.recorded_at)}: ${fmtNumber(m.saves)} saves · ${fmtNumber(m.repins)} repins</span>
          <span class="text-[10px] text-muted-foreground mt-1">Subsequent refresh cycles will plot the growth curve</span>
        </div>
      `;
    }

    const width = 380;
    const height = 180;
    const padX = 40;
    const padY = 24;

    const saves = metrics.map((m) => Number(m.saves || 0));
    const repins = metrics.map((m) => Number(m.repins || 0));
    const maxVal = Math.max(...saves, ...repins, 10);
    const minVal = 0;

    const ptsCount = metrics.length;
    const getX = (i: number) => padX + (i / (ptsCount - 1)) * (width - padX * 2);
    const getY = (v: number) => height - padY - ((v - minVal) / (maxVal - minVal)) * (height - padY * 2);

    const savesPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.saves || 0)).toFixed(1)}`)
      .join(' ');

    const repinsPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.repins || 0)).toFixed(1)}`)
      .join(' ');

    const savesArea = `${savesPath} L ${getX(ptsCount - 1)} ${height - padY} L ${getX(0)} ${height - padY} Z`;

    const gridY1 = height - padY;
    const gridY2 = height - padY - (height - padY * 2) * 0.5;
    const gridY3 = padY;

    return `
      <div class="h-48 w-full bg-card rounded-2xl border border-border/60 p-2 shadow-2xs">
        <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" class="overflow-visible" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.25"/>
              <stop offset="100%" stop-color="#f43f5e" stop-opacity="0.0"/>
            </linearGradient>
          </defs>

          <!-- Grid lines -->
          <line x1="${padX}" y1="${gridY1}" x2="${width - padX}" y2="${gridY1}" stroke="currentColor" class="text-border" stroke-width="1" />
          <line x1="${padX}" y1="${gridY2}" x2="${width - padX}" y2="${gridY2}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />
          <line x1="${padX}" y1="${gridY3}" x2="${width - padX}" y2="${gridY3}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />

          <!-- Y Axis Labels -->
          <text x="${padX - 6}" y="${gridY1}" text-anchor="end" class="fill-muted-foreground text-[9px] font-mono" dominant-baseline="middle">${fmtCompact(minVal)}</text>
          <text x="${padX - 6}" y="${gridY2}" text-anchor="end" class="fill-muted-foreground text-[9px] font-mono" dominant-baseline="middle">${fmtCompact(Math.round(maxVal / 2))}</text>
          <text x="${padX - 6}" y="${gridY3}" text-anchor="end" class="fill-muted-foreground text-[9px] font-mono" dominant-baseline="middle">${fmtCompact(maxVal)}</text>

          <!-- Area Fill -->
          <path d="${savesArea}" fill="url(#${gradId})" />

          <!-- Repins Line -->
          <path d="${repinsPath}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

          <!-- Saves Line -->
          <path d="${savesPath}" fill="none" stroke="#f43f5e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

          <!-- Data Points -->
          ${metrics
            .map(
              (m, i) => `
                <g class="group cursor-pointer">
                  <circle cx="${getX(i).toFixed(1)}" cy="${getY(Number(m.saves || 0)).toFixed(1)}" r="3.5" fill="#f43f5e" stroke="var(--color-card, #fff)" stroke-width="1.5" />
                  <title>${fmtDate(m.recorded_at)}: ${fmtNumber(m.saves)} saves · ${fmtNumber(m.repins)} repins</title>
                </g>
              `
            )
            .join('')}
        </svg>
      </div>
      <div class="flex items-center justify-between text-[10px] text-muted-foreground px-2 pt-1">
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-rose-500"></span> Saves</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-blue-500"></span> Repins</span>
        <span>${metrics.length} snapshot(s)</span>
      </div>
    `;
  }

  // ═══ AI Prompt Generation Logic ═══
  function generateAIPrompt(pinsToUse?: any[]) {
    const list = pinsToUse && pinsToUse.length > 0 ? pinsToUse : selectedForCompare.size > 0 ? rawPins.filter((p) => selectedForCompare.has(p.id)) : filteredPins.slice(0, 10);

    if (list.length === 0) {
      alert('No winning pins available to generate prompt.');
      return;
    }

    const titles = list.map((p) => `- ${p.title || `Pin ${p.pin_id}`} (@${p.account_username || p.board_name || 'account'} | ${fmtNumber(p.saves)} saves | +${fmtNumber(getPinDeltaByActiveTimeframe(p))} in ${activeTimeframe})`).join('\n');

    const tagSet = new Set<string>();
    list.forEach((p) => {
      if (Array.isArray(p.annotations)) {
        p.annotations.forEach((a: any) => {
          const name = typeof a === 'string' ? a : a?.name || '';
          if (name) tagSet.add(name);
        });
      }
    });

    const tagsStr = Array.from(tagSet).slice(0, 12).join(', ');

    const promptText = `Act as an elite Pinterest growth and content strategist.
Analyze these high-velocity winning pins from our top performing archive:

TOP WINNING PINS:
${titles}

HIGH-IMPACT KEYWORDS & TOPIC CLUSTERS:
${tagsStr || 'N/A'}

TASK:
1. Extract the core psychological hook and winning title formula behind these pins.
2. Generate 10 brand-new viral pin title variations optimized for high CTR and saves.
3. Write 3 high-converting Pinterest pin descriptions incorporating the top keywords naturally.
4. Suggest 3 visual concept angles (image composition, text overlay placement, color palette) to replicate this success.`;

    const modal = document.getElementById('ai-prompt-modal');
    const textarea = document.getElementById('ai-prompt-textarea') as HTMLTextAreaElement | null;
    if (modal && textarea) {
      textarea.value = promptText;
      modal.classList.remove('hidden');
    }
  }

  // ═══ Compare Modal Dialog (Up to 4 Pins) ═══
