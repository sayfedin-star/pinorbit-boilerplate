    const modal = document.getElementById('compare-modal');
    const content = document.getElementById('compare-modal-content');
    if (!modal || !content || selectedForCompare.size < 2) return;

    modal.classList.remove('hidden');
    content.innerHTML = '<div class="py-12 text-center text-xs text-muted-foreground animate-pulse">Fetching comparison datasets...</div>';

    const ids = Array.from(selectedForCompare);
    try {
      const pinPromises = ids.map((id) => fetch(`/api/pinarchive/pin?id=${encodeURIComponent(id)}`).then((r) => r.json()));
      const results = await Promise.all(pinPromises);

      const validPins = results.filter((r) => r.success && r.pin);
      if (validPins.length < 2) throw new Error('Could not fetch selected pins for comparison.');

      const cols = validPins.length >= 3 ? (validPins.length === 4 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' : 'grid-cols-1 md:grid-cols-3') : 'grid-cols-1 md:grid-cols-2';

      content.innerHTML = `
        <div class="grid ${cols} gap-4">
          ${validPins
            .map((res, i) => {
              const p = res.pin;
              const m = Array.isArray(res.metrics) ? res.metrics : [];
              const st = getPinStrategy(p);
              const d24 = Number(p.delta_saves_24h ?? p.delta_saves ?? 0);
              return `
                <div class="rounded-2xl border border-border bg-card p-4 space-y-3 shadow-xs">
                  <div class="flex items-center gap-3">
                    <img src="${escapeHtml(p.image_url)}" class="h-14 w-14 object-cover rounded-xl border border-border" />
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1 mb-1">
                        ${renderStrategyBadge(st)}
                      </div>
                      <h4 class="text-xs font-bold text-foreground line-clamp-1">${escapeHtml(p.title || `Pin ${i + 1}`)}</h4>
                      <span class="text-[10px] text-muted-foreground">@${escapeHtml(p.account_username || p.board_name || 'account')}</span>
                    </div>
                  </div>
                  <div class="grid grid-cols-3 gap-1.5 pt-2 border-t border-border text-center">
                    <div class="bg-emerald-500/10 p-2 rounded-xl border border-emerald-500/20">
                      <span class="text-[9px] font-bold text-emerald-700 dark:text-emerald-300 block">24h Growth</span>
                      <span class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 font-mono">+${fmtNumber(d24)}</span>
                    </div>
                    <div class="bg-muted/30 p-2 rounded-xl">
                      <span class="text-[9px] font-bold text-muted-foreground block">Total Saves</span>
                      <span class="text-xs font-extrabold text-rose-500 font-mono">${fmtNumber(p.saves)}</span>
                    </div>
                    <div class="bg-muted/30 p-2 rounded-xl">
                      <span class="text-[9px] font-bold text-muted-foreground block">Velocity</span>
                      <span class="text-xs font-extrabold text-foreground font-mono">${Number(p.velocity || 0).toFixed(1)}/d</span>
                    </div>
                  </div>
                  <div class="space-y-1 pt-1">
                    <span class="text-[10px] font-bold text-muted-foreground block">Trajectory</span>
                    ${renderPinSvgChart(m, `compareGrad${i}`)}
                  </div>
                </div>
              `;
            })
            .join('')}
        </div>
      `;
    } catch (err: any) {
      content.innerHTML = `<div class="p-6 text-center text-xs text-rose-500">${escapeHtml(err.message)}</div>`;
    }
  }

  // ═══ Apply Filters, Sort, and Keyword Mining ═══
  function applyActiveFilters() {
    let result = [...rawPins];

    const accountSelect = document.getElementById('filter-account-select') as HTMLSelectElement | null;
    if (accountSelect && accountSelect.value) {
      result = result.filter((p) => p.account_id === accountSelect.value || p.account_username === accountSelect.value);
    }

    // Quick Matrix Slicing
    if (activeQuickFilter === 'evergreen') {
      result = result.filter((p) => getPinStrategy(p) === 'EVERGREEN');
    } else if (activeQuickFilter === 'rocket') {
      result = result.filter((p) => getPinStrategy(p) === 'ROCKET');
    } else if (activeQuickFilter === 'spike') {
      result = result.filter((p) => p.anomaly === 'SPIKE');
    } else if (activeQuickFilter === 'cluster') {
      result = result.filter((p) => Boolean(p.canonical_pin_id));
    }

    filteredPins = sortPins(result);
    currentPage = 1;

    updateExecutiveKPIs(filteredPins);
    updateKeywordMining(filteredPins);
    renderActiveView();
  }

  function populateAccountFilter(accounts: any[]) {
    const select = document.getElementById('filter-account-select') as HTMLSelectElement | null;
    if (!select) return;

    const currentVal = select.value;
    select.innerHTML = '<option value="">All Accounts</option>' +
      accounts.map((acc) => `<option value="${escapeHtml(acc.id)}" ${acc.id === currentVal ? 'selected' : ''}>@${escapeHtml(acc.username)}</option>`).join('');
  }

  function populateBoardFilter(pins: any[]) {
    const select = document.getElementById('filter-board-select') as HTMLSelectElement | null;
    if (!select) return;

    const currentVal = select.value;
    const boards = Array.from(new Set(pins.map((p) => p.board_name).filter(Boolean))).sort();

    select.innerHTML = '<option value="">All Boards</option>' +
      boards.map((b) => `<option value="${escapeHtml(b)}" ${b === currentVal ? 'selected' : ''}>${escapeHtml(b)}</option>`).join('');
  }

  async function loadPins(retries = 2) {
    const searchInput = document.getElementById('filter-search-input') as HTMLInputElement | null;
    const accountSelect = document.getElementById('filter-account-select') as HTMLSelectElement | null;
    const boardSelect = document.getElementById('filter-board-select') as HTMLSelectElement | null;
    const stageSelect = document.getElementById('filter-stage-select') as HTMLSelectElement | null;
    const clusterToggle = document.getElementById('filter-cluster-toggle') as HTMLInputElement | null;

    const params = new URLSearchParams();
    if (searchInput?.value) params.set('q', searchInput.value.trim());
    if (accountSelect?.value) params.set('account_id', accountSelect.value);
    if (boardSelect?.value) params.set('board', boardSelect.value);
    if (stageSelect?.value) params.set('stage', stageSelect.value);
    if (clusterToggle?.checked) params.set('in_cluster', '1');
    params.set('sort', currentSort.startsWith('velocity') ? 'velocity' : 'saves');
    params.set('limit', '500');

    try {
      const res = await fetch(`/api/pinarchive/pins?${params.toString()}`, { signal: AbortSignal.timeout(8000) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load pins');

      rawPins = json.pins || [];
      rawAccounts = json.accounts || [];

      if (!accountSelect?.value) {
        populateAccountFilter(rawAccounts);
      }

      if (!boardSelect?.value) {
        populateBoardFilter(rawPins);
      }

      applyActiveFilters();
    } catch (e: any) {
      if (retries > 0) {
        setTimeout(() => loadPins(retries - 1), 1500);
        return;
      }
      console.error('Error loading PinArchive pins:', e);
      const grid = document.getElementById('winners-grid');
      if (grid) {
        grid.innerHTML = `
          <div class="col-span-full py-12 text-center text-xs text-rose-500 bg-rose-500/10 rounded-2xl border border-rose-500/20 p-6">
            Failed to load winning pins. <button id="retry-load-pins-btn" class="underline font-bold cursor-pointer ml-1">Retry</button>
          </div>
        `;
        document.getElementById('retry-load-pins-btn')?.addEventListener('click', () => loadPins(2));
      }
    }
  }

  function exportCSV() {
    if (!filteredPins.length) {
      alert('No pins available in the current filtered view to export.');
      return;
    }

    const headers = ['Pin ID', 'Title', 'Account', 'Board', 'Strategy Matrix', '24h Growth', '3d Growth', '7d Growth', 'Total Saves', 'Repins', 'Velocity', 'Virality %', 'Pinterest Link', 'Created At'];
    const rows = filteredPins.map((p) => {
      const saves = Number(p.saves || 0);
      const repins = Number(p.repins || 0);
      const virality = saves > 0 ? ((repins / saves) * 100).toFixed(0) : '0';
      return [
        p.pin_id,
        `"${(p.title || '').replace(/"/g, '""')}"`,
        `"${(p.account_username || '').replace(/"/g, '""')}"`,
        `"${(p.board_name || '').replace(/"/g, '""')}"`,
        getPinStrategy(p),
        Number(p.delta_saves_24h || 0),
        Number(p.delta_saves_3d || 0),
        Number(p.delta_saves_7d || 0),
        saves,
        repins,
        p.velocity || 0,
        virality,
        `"https://www.pinterest.com/pin/${p.pin_id}/"`,
        p.created_at_pinterest || '',
      ];
    });

    const csvContent = [headers.join(','), ...rows.map((r) => r.join(','))].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pinarchive-delta-growth-${activeTimeframe}-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function init() {
    loadPins();

    // Growth Timeframe Slicer Pills (24h / 3d / 7d / all)
    document.querySelectorAll<HTMLButtonElement>('[data-timeframe]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTimeframe = (btn.getAttribute('data-timeframe') || '24h') as any;
        document.querySelectorAll<HTMLButtonElement>('[data-timeframe]').forEach((b) => {
          b.className = 'timeframe-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0';
        });
        btn.className = 'timeframe-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-primary text-primary-foreground shadow-2xs transition-all cursor-pointer shrink-0';

        // Auto align sort
        if (activeTimeframe === '24h') currentSort = 'delta_24h_desc';
        else if (activeTimeframe === '3d') currentSort = 'delta_3d_desc';
        else if (activeTimeframe === '7d') currentSort = 'delta_7d_desc';
        else currentSort = 'saves_desc';

        const sortSelect = document.getElementById('pins-sort-select') as HTMLSelectElement | null;
        if (sortSelect) sortSelect.value = currentSort;

        applyActiveFilters();
      });
    });

    // View Switcher Buttons
    const gridBtn = document.getElementById('view-grid-btn');
    const tableBtn = document.getElementById('view-table-btn');
    const boardBtn = document.getElementById('view-board-btn');
    const clustersBtn = document.getElementById('view-clusters-btn');

    const winnersGrid = document.getElementById('winners-grid');
    const tableContainer = document.getElementById('winners-table-container');
    const byBoardContainer = document.getElementById('by-board-container');
    const clustersContainer = document.getElementById('clusters-view-container');
    const paginationWrapper = document.getElementById('pagination-wrapper');

    function setActiveView(v: 'grid' | 'table' | 'board' | 'clusters') {
      activeView = v;
      const activeCls = 'inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg bg-primary text-primary-foreground shadow-xs transition-all cursor-pointer';
      const inactiveCls = 'inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer';

      if (gridBtn) gridBtn.className = v === 'grid' ? activeCls : inactiveCls;
      if (tableBtn) tableBtn.className = v === 'table' ? activeCls : inactiveCls;
      if (boardBtn) boardBtn.className = v === 'board' ? activeCls : inactiveCls;
      if (clustersBtn) clustersBtn.className = v === 'clusters' ? activeCls : inactiveCls;

      winnersGrid?.classList.toggle('hidden', v !== 'grid');
      tableContainer?.classList.toggle('hidden', v !== 'table');
      byBoardContainer?.classList.toggle('hidden', v !== 'board');
      clustersContainer?.classList.toggle('hidden', v !== 'clusters');
      paginationWrapper?.classList.toggle('hidden', v === 'board' || v === 'clusters');

      renderActiveView();
    }

    gridBtn?.addEventListener('click', () => setActiveView('grid'));
    tableBtn?.addEventListener('click', () => setActiveView('table'));
    boardBtn?.addEventListener('click', () => setActiveView('board'));
    clustersBtn?.addEventListener('click', () => setActiveView('clusters'));

    // Quick Matrix Slicer Pills
    document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeQuickFilter = btn.getAttribute('data-quick-filter') || 'all';
        document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]').forEach((b) => {
          b.className = 'quick-pill px-2.5 py-1 rounded-lg text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0';
        });
        btn.className = 'quick-pill active px-2.5 py-1 rounded-lg text-xs font-bold bg-muted text-foreground transition-all cursor-pointer shrink-0';
        applyActiveFilters();
      });
    });

    // Filter controls
    const searchInput = document.getElementById('filter-search-input');
    const accountSelect = document.getElementById('filter-account-select');
    const boardSelect = document.getElementById('filter-board-select');
    const stageSelect = document.getElementById('filter-stage-select');
    const clusterToggle = document.getElementById('filter-cluster-toggle');
    const clearBtn = document.getElementById('clear-filters-btn');

    let debounceTimer: any = null;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          loadPins();
        }, 300);
      });
    }

    if (accountSelect) accountSelect.addEventListener('change', () => applyActiveFilters());
    if (boardSelect) boardSelect.addEventListener('change', loadPins);
    if (stageSelect) stageSelect.addEventListener('change', loadPins);
    if (clusterToggle) clusterToggle.addEventListener('change', loadPins);

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) (searchInput as HTMLInputElement).value = '';
        if (accountSelect) (accountSelect as HTMLSelectElement).value = '';
        if (boardSelect) (boardSelect as HTMLSelectElement).value = '';
        if (stageSelect) (stageSelect as HTMLSelectElement).value = '';
        if (clusterToggle) (clusterToggle as HTMLInputElement).checked = false;
        activeQuickFilter = 'all';
        activeTimeframe = '24h';
        currentSort = 'delta_24h_desc';
        document.querySelectorAll<HTMLButtonElement>('[data-timeframe]').forEach((b) => {
          b.className = b.getAttribute('data-timeframe') === '24h'
            ? 'timeframe-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-primary text-primary-foreground shadow-2xs transition-all cursor-pointer shrink-0'
            : 'timeframe-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0';
        });
        loadPins();
      });
    }

    // Keyboard shortcut '/' to search
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && !(document.activeElement instanceof HTMLInputElement || document.activeElement instanceof HTMLTextAreaElement)) {
        e.preventDefault();
        searchInput?.focus();
      }
      if (e.key === 'Escape') {
        closeQuickPeek();
        document.getElementById('compare-modal')?.classList.add('hidden');
        document.getElementById('ai-prompt-modal')?.classList.add('hidden');
      }
    });

    // Sort & Limit Selectors
    const sortSelect = document.getElementById('pins-sort-select') as HTMLSelectElement | null;
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value;
        filteredPins = sortPins(filteredPins);
        currentPage = 1;
        renderActiveView();
      });
    }

    const limitSelect = document.getElementById('pins-limit-select') as HTMLSelectElement | null;
    if (limitSelect) {
      limitSelect.addEventListener('change', () => {
        pageSize = parseInt(limitSelect.value, 10) || 24;
        currentPage = 1;
        renderActiveView();
      });
    }

    // Table Column Sort Headers
    document.querySelectorAll<HTMLElement>('.table-sort-header').forEach((th) => {
      th.addEventListener('click', () => {
        const sortKey = th.getAttribute('data-sort');
        if (!sortKey) return;
        if (sortKey === 'delta') {
          currentSort = currentSort === `delta_${activeTimeframe}_desc` || currentSort === 'delta_desc' ? 'delta_asc' : `delta_${activeTimeframe}_desc`;
        } else if (currentSort === `${sortKey}_desc`) {
          currentSort = `${sortKey}_asc`;
        } else {
          currentSort = `${sortKey}_desc`;
        }
        if (sortSelect) sortSelect.value = currentSort;
        filteredPins = sortPins(filteredPins);
        currentPage = 1;
        renderActiveView();
      });
    });

    // Copy All Keywords Button
    document.getElementById('copy-all-keywords-btn')?.addEventListener('click', () => {
      const tagSet = new Set<string>();
      filteredPins.forEach((p) => {
        if (Array.isArray(p.annotations)) {
          p.annotations.forEach((a: any) => {
            const name = typeof a === 'string' ? a : a?.name || '';
            if (name) tagSet.add(name);
          });
        }
      });
      const tagsList = Array.from(tagSet).join(', ');
      navigator.clipboard.writeText(tagsList);
      const btn = document.getElementById('copy-all-keywords-btn');
      if (btn) {
        btn.innerHTML = '<span>Copied All Tags!</span>';
        setTimeout(() => {
          if (btn) btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><span>Copy All Tags</span>';
        }, 1500);
      }
    });

    // AI Prompt Actions
    document.getElementById('bulk-ai-prompt-btn')?.addEventListener('click', () => generateAIPrompt());
    document.getElementById('launch-bulk-ai-btn')?.addEventListener('click', () => generateAIPrompt());
    document.getElementById('close-ai-modal-btn')?.addEventListener('click', () => {
      document.getElementById('ai-prompt-modal')?.classList.add('hidden');
    });

    document.getElementById('copy-ai-prompt-btn')?.addEventListener('click', () => {
      const textarea = document.getElementById('ai-prompt-textarea') as HTMLTextAreaElement | null;
      if (textarea) {
        navigator.clipboard.writeText(textarea.value);
        const textSpan = document.getElementById('copy-ai-prompt-text');
        if (textSpan) textSpan.textContent = 'Copied to Clipboard!';
        setTimeout(() => {
          if (textSpan) textSpan.textContent = 'Copy Prompt to Clipboard';
        }, 1500);
      }
    });

    // CSV Export
    const exportBtn = document.getElementById('export-csv-btn');
    if (exportBtn) exportBtn.addEventListener('click', exportCSV);

    // Compare Controls
    const launchCompareBtn = document.getElementById('launch-compare-btn');
    if (launchCompareBtn) launchCompareBtn.addEventListener('click', openCompareModal);

    const clearCompareBtn = document.getElementById('clear-compare-btn');
    if (clearCompareBtn) {
      clearCompareBtn.addEventListener('click', () => {
        selectedForCompare.clear();
        updateCompareBar();
        document.querySelectorAll<HTMLInputElement>('[data-pin-compare]').forEach((cb) => {
          cb.checked = false;
        });
      });
    }

    const closeCompareModal = document.getElementById('close-compare-modal');
    if (closeCompareModal) {
      closeCompareModal.addEventListener('click', () => {
        document.getElementById('compare-modal')?.classList.add('hidden');
      });
    }

    // Quick Peek Drawer Close / Prev / Next
    document.getElementById('quick-peek-backdrop')?.addEventListener('click', closeQuickPeek);
    document.getElementById('peek-close-btn')?.addEventListener('click', closeQuickPeek);

    document.getElementById('peek-prev-btn')?.addEventListener('click', () => {
      if (currentPeekIndex > 0) {
        currentPeekIndex--;
        const prevPin = filteredPins[currentPeekIndex];
        if (prevPin) openQuickPeek(prevPin.id);
      }
    });

    document.getElementById('peek-next-btn')?.addEventListener('click', () => {
      if (currentPeekIndex < filteredPins.length - 1) {
        currentPeekIndex++;
        const nextPin = filteredPins[currentPeekIndex];
        if (nextPin) openQuickPeek(nextPin.id);
      }
    });

    // Refresh button
    const refreshBtn = document.getElementById('refresh-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const icon = document.getElementById('refresh-icon');
        if (icon) icon.classList.add('animate-spin');
        loadPins().finally(() => {
          setTimeout(() => {
            if (icon) icon.classList.remove('animate-spin');
          }, 400);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
