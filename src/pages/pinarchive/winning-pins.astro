</Layout>

<script>
  let rawPins: any[] = [];
  let filteredPins: any[] = [];
  let currentSort = 'saves';
  let currentLimit = 50;
  let activeView: 'grid' | 'table' | 'board' | 'clusters' = 'grid';
  let activeQuickFilter = 'all';
  const selectedForCompare = new Set<string>();
  let currentPeekIndex = -1;

  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtCompact(n: number): string {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1_000) return (n / 1_000).toFixed(1) + 'k';
    return String(Math.round(n));
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function renderStageBadge(stage?: string | null): string {
    switch (stage) {
      case 'NEW':
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">🟢 NEW</span>';
      case 'GROWING':
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">🚀 GROWING</span>';
      case 'MATURE':
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">🟣 MATURE</span>';
      case 'COOLING':
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">❄️ COOLING</span>';
      default:
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-slate-500/10 text-slate-500 border border-slate-500/20">⚪ DORMANT</span>';
    }
  }

  function renderAnomalyBadge(anomaly?: string | null): string {
    if (anomaly === 'SPIKE') {
      return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20 animate-pulse">🔥 SPIKE</span>';
    }
    if (anomaly === 'COOLING') {
      return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">❄️ COOLING</span>';
    }
    return '';
  }

  function renderRankBadge(index: number): string {
    if (index === 0) {
      return '<span class="inline-flex items-center justify-center h-6 px-2 rounded-lg bg-amber-500 text-white font-extrabold text-[10px] shadow-xs border border-amber-400">🥇 #1</span>';
    }
    if (index === 1) {
      return '<span class="inline-flex items-center justify-center h-6 px-2 rounded-lg bg-slate-400 text-white font-extrabold text-[10px] shadow-xs border border-slate-300">🥈 #2</span>';
    }
    if (index === 2) {
      return '<span class="inline-flex items-center justify-center h-6 px-2 rounded-lg bg-amber-700 text-white font-extrabold text-[10px] shadow-xs border border-amber-600">🥉 #3</span>';
    }
    return `<span class="inline-flex items-center justify-center h-5 px-1.5 rounded-md bg-muted/90 text-muted-foreground font-bold text-[9px] border border-border">#${index + 1}</span>`;
  }

  // ═══ KPI Computation ═══
  function updateExecutiveKPIs(pins: any[]) {
    if (!pins || pins.length === 0) {
      const topTitle = document.getElementById('kpi-top-title');
      const topVel = document.getElementById('kpi-top-velocity');
      const topSaves = document.getElementById('kpi-top-saves');
      const avgVelElem = document.getElementById('kpi-avg-velocity');
      const totalSavesElem = document.getElementById('kpi-total-analyzed-saves');
      const sampleCountElem = document.getElementById('kpi-active-sample-count');
      const domName = document.getElementById('kpi-dominant-board-name');
      const domSaves = document.getElementById('kpi-dominant-board-saves');
      const domPins = document.getElementById('kpi-dominant-board-pins');

      if (topTitle) topTitle.textContent = 'No active pins';
      if (topVel) topVel.textContent = '0.0/d';
      if (topSaves) topSaves.textContent = '0 saves';
      if (avgVelElem) avgVelElem.textContent = '0.0/d';
      if (totalSavesElem) totalSavesElem.textContent = '0 total saves';
      if (sampleCountElem) sampleCountElem.textContent = '0 pins';
      if (domName) domName.textContent = '—';
      if (domSaves) domSaves.textContent = '0 saves';
      if (domPins) domPins.textContent = '0 winners';
      return;
    }

    // 1. Top Velocity Pin
    const sortedByVelocity = [...pins].sort((a, b) => Number(b.velocity || 0) - Number(a.velocity || 0));
    const topPin = sortedByVelocity[0];
    if (topPin) {
      const topTitle = document.getElementById('kpi-top-title');
      const topVel = document.getElementById('kpi-top-velocity');
      const topSaves = document.getElementById('kpi-top-saves');
      const thumbWrapper = document.getElementById('kpi-top-thumb-wrapper');

      if (topTitle) topTitle.textContent = topPin.title || `Pin ${topPin.pin_id}`;
      if (topVel) topVel.textContent = `${Number(topPin.velocity || 0).toFixed(1)}/d`;
      if (topSaves) topSaves.textContent = `${fmtNumber(topPin.saves)} saves · @${topPin.board_name || 'board'}`;
      if (thumbWrapper && topPin.image_url) {
        thumbWrapper.innerHTML = `<img src="${escapeHtml(topPin.image_url)}" class="w-full h-full object-cover rounded-xl" />`;
      }
    }

    // 2. Average Velocity & Total Saves
    const totalSaves = pins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
    const avgVelocity = pins.reduce((acc, p) => acc + Number(p.velocity || 0), 0) / pins.length;

    const avgVelElem = document.getElementById('kpi-avg-velocity');
    const totalSavesElem = document.getElementById('kpi-total-analyzed-saves');
    const sampleCountElem = document.getElementById('kpi-active-sample-count');

    if (avgVelElem) avgVelElem.textContent = `${avgVelocity.toFixed(1)}/d`;
    if (totalSavesElem) totalSavesElem.textContent = `${fmtNumber(totalSaves)} total saves`;
    if (sampleCountElem) sampleCountElem.textContent = `${pins.length} active pins`;

    // 3. Dominant Board
    const boardStats: Record<string, { count: number; saves: number }> = {};
    pins.forEach((p) => {
      const b = p.board_name || 'Unassigned';
      if (!boardStats[b]) boardStats[b] = { count: 0, saves: 0 };
      boardStats[b].count += 1;
      boardStats[b].saves += Number(p.saves || 0);
    });

    const dominantEntry = Object.entries(boardStats).sort((a, b) => b[1].saves - a[1].saves)[0];
    const domName = document.getElementById('kpi-dominant-board-name');
    const domSaves = document.getElementById('kpi-dominant-board-saves');
    const domPins = document.getElementById('kpi-dominant-board-pins');

    if (dominantEntry) {
      if (domName) domName.textContent = dominantEntry[0];
      if (domSaves) domSaves.textContent = `${fmtNumber(dominantEntry[1].saves)} saves`;
      if (domPins) domPins.textContent = `${dominantEntry[1].count} winning pins`;
    }

    // 4. Growth Stages Distribution
    let cGrowing = 0;
    let cMature = 0;
    let cNew = 0;
    let cCooling = 0;

    pins.forEach((p) => {
      if (p.stage === 'GROWING') cGrowing++;
      else if (p.stage === 'MATURE') cMature++;
      else if (p.stage === 'NEW') cNew++;
      else cCooling++;
    });

    const len = pins.length;
    const pGrowing = Math.round((cGrowing / len) * 100);
    const pMature = Math.round((cMature / len) * 100);
    const pNew = Math.round((cNew / len) * 100);
    const pCooling = Math.max(0, 100 - pGrowing - pMature - pNew);

    const bGrowing = document.getElementById('kpi-bar-growing');
    const bMature = document.getElementById('kpi-bar-mature');
    const bNew = document.getElementById('kpi-bar-new');
    const bCooling = document.getElementById('kpi-bar-cooling');

    if (bGrowing) bGrowing.style.width = `${pGrowing}%`;
    if (bMature) bMature.style.width = `${pMature}%`;
    if (bNew) bNew.style.width = `${pNew}%`;
    if (bCooling) bCooling.style.width = `${pCooling}%`;

    const elGrow = document.getElementById('kpi-count-growing');
    const elMat = document.getElementById('kpi-count-mature');
    const elNew = document.getElementById('kpi-count-new');
    const elCool = document.getElementById('kpi-count-cooling');

    if (elGrow) elGrow.textContent = String(cGrowing);
    if (elMat) elMat.textContent = String(cMature);
    if (elNew) elNew.textContent = String(cNew);
    if (elCool) elCool.textContent = String(cCooling);

    // Update Quick Filter counts
    const qAll = document.getElementById('quick-count-all');
    const qGrow = document.getElementById('quick-count-growing');
    const qSpike = document.getElementById('quick-count-spike');

    if (qAll) qAll.textContent = String(rawPins.length);
    if (qGrow) qGrow.textContent = String(rawPins.filter((p) => p.stage === 'GROWING').length);
    if (qSpike) qSpike.textContent = String(rawPins.filter((p) => p.anomaly === 'SPIKE').length);
  }

  // ═══ Single Card (Grid View) ═══
  function renderSinglePinCard(p: any, index: number): string {
    const saves = Number(p.saves || 0);
    const repins = Number(p.repins || 0);
    const velocity = Number(p.velocity || 0);
    const annotations = Array.isArray(p.annotations) ? p.annotations : [];
    const category = p.seo_category || p.board_name || null;
    const pinterestUrl = `https://www.pinterest.com/pin/${p.pin_id}/`;
    const destinationUrl = p.link ? p.link : null;
    const imageUrl = p.image_url || '';
    const pinId = p.id || '';
    const isSelected = selectedForCompare.has(pinId);
    const createdDate = fmtDate(p.created_at_pinterest);
    const viralityRatio = saves > 0 ? ((repins / saves) * 100).toFixed(0) : '0';

    // Linked annotations chips (max 3)
    const tagsHtml = annotations.slice(0, 3).map((a: any) => {
      const name = typeof a === 'string' ? a : a?.name || '';
      if (!name) return '';
      return `
        <span class="inline-flex items-center text-[9.5px] bg-muted/80 text-muted-foreground px-2 py-0.5 rounded-md font-medium truncate max-w-[120px]" title="${escapeHtml(name)}">
          #${escapeHtml(name)}
        </span>
      `;
    }).join('');

    const moreTagsCount = annotations.length > 3 ? annotations.length - 3 : 0;

    return `
      <div class="group rounded-2xl border border-border bg-card overflow-hidden shadow-xs hover:shadow-md hover:border-primary/40 transition-all flex flex-col justify-between relative">
        <!-- Top Overlays: Rank Badge + Compare Checkbox -->
        <div class="absolute top-2.5 left-2.5 z-20">
          ${renderRankBadge(index)}
        </div>

        <div class="absolute top-2.5 right-2.5 z-20 bg-background/90 backdrop-blur-xs rounded-xl px-2 py-1 border border-border/80 shadow-2xs flex items-center gap-1.5">
          <input
            type="checkbox"
            data-pin-compare="${escapeHtml(pinId)}"
            ${isSelected ? 'checked' : ''}
            class="rounded border-border text-primary focus:ring-primary h-3.5 w-3.5 cursor-pointer"
            id="compare-${escapeHtml(pinId)}"
          />
          <label for="compare-${escapeHtml(pinId)}" class="text-[10px] font-bold text-muted-foreground cursor-pointer select-none">Compare</label>
        </div>

        <div>
          <!-- Image preview with hover zoom & Quick Peek Trigger -->
          <div class="relative w-full h-44 bg-muted/50 overflow-hidden flex items-center justify-center block cursor-pointer group/img" data-peek-trigger="${escapeHtml(pinId)}">
            ${imageUrl ? `
              <img
                src="${escapeHtml(imageUrl)}"
                alt="${escapeHtml(p.title || 'Pinterest Pin')}"
                loading="lazy"
                class="w-full h-full object-cover object-center group-hover/img:scale-105 transition-transform duration-300"
                onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
              />
              <div class="hidden absolute inset-0 flex items-center justify-center text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            ` : `
              <div class="flex items-center justify-center text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            `}
            
            <!-- Quick Peek Overlay Pill on Hover -->
            <div class="absolute inset-0 bg-black/30 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-2xs">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-background/90 text-foreground font-bold text-xs shadow-md border border-border">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Quick Peek</span>
              </span>
            </div>

            ${category ? `
              <span class="absolute bottom-2.5 left-2.5 text-[9.5px] font-bold bg-background/90 backdrop-blur-xs text-foreground px-2 py-0.5 rounded-lg shadow-2xs max-w-[150px] truncate border border-border/40" title="${escapeHtml(category)}">
                ${escapeHtml(category)}
              </span>
            ` : ''}
          </div>

          <!-- Card Body -->
          <div class="p-4 space-y-2.5">
            <div class="flex flex-wrap items-center gap-1.5">
              ${renderStageBadge(p.stage)}
              ${renderAnomalyBadge(p.anomaly)}
              ${p.canonical_pin_id ? '<span class="text-[9.5px] font-bold px-1.5 py-0.5 rounded-md bg-purple-500/10 text-purple-500 border border-purple-500/20">🧬 Cluster</span>' : ''}
            </div>

            <div>
              <h3
                class="text-xs font-bold text-foreground line-clamp-2 hover:text-primary transition-colors cursor-pointer"
                data-peek-trigger="${escapeHtml(pinId)}"
                title="${escapeHtml(p.title || 'Untitled Pin')}"
              >
