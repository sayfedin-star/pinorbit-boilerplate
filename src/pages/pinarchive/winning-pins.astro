    if (badge) badge.textContent = `${pins.length}`;

    if (!grid) return;

    if (pins.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full py-16 text-center text-xs text-muted-foreground bg-muted/20 rounded-2xl border border-dashed border-border">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto mb-2 opacity-40 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          No archived winning pins matched your active filters.
        </div>
      `;
      return;
    }

    grid.innerHTML = pins.map((p, idx) => renderSinglePinCard(p, idx)).join('');
