        ` : ''}

        <!-- Outbound Link Details -->
        ${destinationUrl ? `
          <div class="p-3 bg-muted/30 rounded-xl border border-border text-xs flex items-center justify-between">
            <span class="text-muted-foreground truncate max-w-xs">Destination: <strong class="text-foreground">${escapeHtml(destinationUrl)}</strong></span>
            <a href="${escapeHtml(destinationUrl)}" target="_blank" rel="noopener noreferrer nofollow" class="text-primary font-bold hover:underline shrink-0 ml-2">Visit Site ↗</a>
          </div>
        ` : ''}
      `;

      // Copy listeners in drawer
      document.getElementById('drawer-copy-id-btn')?.addEventListener('click', () => {
        navigator.clipboard.writeText(p.pin_id);
        const btn = document.getElementById('drawer-copy-id-btn');
        if (btn) btn.innerHTML = '<span>Copied!</span>';
        setTimeout(() => { if (btn) btn.innerHTML = '<span>Copy ID</span>'; }, 1500);
      });

      document.getElementById('drawer-copy-url-btn')?.addEventListener('click', () => {
        navigator.clipboard.writeText(pinterestUrl);
        const btn = document.getElementById('drawer-copy-url-btn');
        if (btn) btn.innerHTML = '<span>Copied!</span>';
        setTimeout(() => { if (btn) btn.innerHTML = '<span>Copy Link</span>'; }, 1500);
