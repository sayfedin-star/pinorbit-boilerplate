  // ═══ Pagination Renderer ═══
  function updatePaginationControls() {
    const container = document.getElementById('pagination-controls-container');
    const info = document.getElementById('pagination-info-text');
    const rangeText = document.getElementById('winners-showing-range-text');
    if (!container || !info) return;

    const total = filteredPins.length;
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (currentPage > totalPages) currentPage = totalPages;

    const start = total === 0 ? 0 : (currentPage - 1) * pageSize + 1;
    const end = Math.min(currentPage * pageSize, total);

    const txt = `Showing ${start} to ${end} of ${total} winning pins`;
    info.textContent = txt;
    if (rangeText) rangeText.textContent = txt;

    if (totalPages <= 1) {
      container.innerHTML = '';
      return;
    }

    let buttonsHtml = `
      <button
        type="button"
        data-page="1"
        ${currentPage === 1 ? 'disabled class="opacity-40 cursor-not-allowed"' : 'class="cursor-pointer hover:bg-muted"'}
        class="px-2.5 py-1 text-xs font-bold rounded-lg border border-border bg-background transition-all"
        title="First page"
      >
        «
      </button>
      <button
        type="button"
        data-page="${currentPage - 1}"
        ${currentPage === 1 ? 'disabled class="opacity-40 cursor-not-allowed"' : 'class="cursor-pointer hover:bg-muted"'}
        class="px-2.5 py-1 text-xs font-bold rounded-lg border border-border bg-background transition-all"
        title="Previous page"
      >
        ‹
      </button>
    `;

    const startPage = Math.max(1, currentPage - 2);
    const endPage = Math.min(totalPages, currentPage + 2);

    for (let p = startPage; p <= endPage; p++) {
      const isActive = p === currentPage;
      buttonsHtml += `
        <button
          type="button"
          data-page="${p}"
          class="px-3 py-1 text-xs font-bold rounded-lg transition-all cursor-pointer ${
            isActive
              ? 'bg-primary text-primary-foreground shadow-xs'
              : 'border border-border bg-background text-foreground hover:bg-muted'
          }"
        >
          ${p}
        </button>
      `;
    }

    buttonsHtml += `
      <button
        type="button"
        data-page="${currentPage + 1}"
        ${currentPage === totalPages ? 'disabled class="opacity-40 cursor-not-allowed"' : 'class="cursor-pointer hover:bg-muted"'}
        class="px-2.5 py-1 text-xs font-bold rounded-lg border border-border bg-background transition-all"
        title="Next page"
      >
        ›
      </button>
      <button
        type="button"
        data-page="${totalPages}"
        ${currentPage === totalPages ? 'disabled class="opacity-40 cursor-not-allowed"' : 'class="cursor-pointer hover:bg-muted"'}
        class="px-2.5 py-1 text-xs font-bold rounded-lg border border-border bg-background transition-all"
        title="Last page"
      >
        »
      </button>
    `;

    container.innerHTML = buttonsHtml;

    container.querySelectorAll<HTMLButtonElement>('[data-page]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = parseInt(btn.getAttribute('data-page') || '1', 10);
        if (p >= 1 && p <= totalPages && p !== currentPage) {
          currentPage = p;
          renderActiveView();
          window.scrollTo({ top: 400, behavior: 'smooth' });
        }
      });
    });
  }

  // ═══ Multi-Sort Evaluator ═══
  function sortPins(list: any[]) {
    return [...list].sort((a, b) => {
      const sA = Number(a.saves || 0);
      const sB = Number(b.saves || 0);
      const vA = Number(a.velocity || 0);
      const vB = Number(b.velocity || 0);
      const rA = Number(a.repins || 0);
      const rB = Number(b.repins || 0);
      const vrA = sA > 0 ? (rA / sA) * 100 : 0;
      const vrB = sB > 0 ? (rB / sB) * 100 : 0;
      const d24A = Number(a.delta_saves_24h ?? a.delta_saves ?? 0);
      const d24B = Number(b.delta_saves_24h ?? b.delta_saves ?? 0);
      const d3A = Number(a.delta_saves_3d ?? a.delta_saves ?? 0);
      const d3B = Number(b.delta_saves_3d ?? b.delta_saves ?? 0);
      const d7A = Number(a.delta_saves_7d ?? a.delta_saves ?? 0);
      const d7B = Number(b.delta_saves_7d ?? b.delta_saves ?? 0);
      const tA = new Date(a.created_at_pinterest || 0).getTime();
      const tB = new Date(b.created_at_pinterest || 0).getTime();

      switch (currentSort) {
        case 'delta_24h_desc':
        case 'delta_desc':
          return d24B - d24A;
        case 'delta_3d_desc':
          return d3B - d3A;
        case 'delta_7d_desc':
          return d7B - d7A;
        case 'saves_asc':
          return sA - sB;
        case 'velocity_desc':
          return vB - vA;
        case 'velocity_asc':
          return vA - vB;
        case 'repins_desc':
          return rB - rA;
        case 'virality_desc':
          return vrB - vrA;
        case 'newest':
          return tB - tA;
        case 'oldest':
          return tA - tB;
        case 'saves_desc':
        default:
          return sB - sA;
      }
    });
  }

  // ═══ Render Active View ═══
  function renderActiveView() {
    const total = filteredPins.length;
    const startIdx = (currentPage - 1) * pageSize;
    const pagePins = filteredPins.slice(startIdx, startIdx + pageSize);

    const badge = document.getElementById('winners-badge-count');
    if (badge) badge.textContent = `${total}`;

    // Update Header Sort Icons
    ['delta', 'saves', 'velocity', 'virality'].forEach((col) => {
      const icon = document.getElementById(`sort-icon-${col}`);
      if (icon) {
        if (currentSort.startsWith(col)) {
          icon.textContent = currentSort.endsWith('asc') ? '▲' : '▼';
          icon.classList.add('text-primary');
        } else {
          icon.textContent = '↕';
          icon.classList.remove('text-primary');
        }
      }
    });

    if (activeView === 'grid') {
      const grid = document.getElementById('winners-grid');
      if (grid) {
        if (pagePins.length === 0) {
          grid.innerHTML = `
            <div class="col-span-full py-16 text-center text-xs text-muted-foreground bg-muted/20 rounded-2xl border border-dashed border-border">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 opacity-40 mx-auto mb-2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              No archived winning pins matched your active filters.
            </div>
          `;
        } else {
          grid.innerHTML = pagePins.map((p, i) => renderSinglePinCard(p, startIdx + i)).join('');
          attachListeners();
        }
      }
    } else if (activeView === 'table') {
      renderTableView(pagePins, startIdx);
    } else if (activeView === 'board') {
      renderByBoard(filteredPins);
    } else if (activeView === 'clusters') {
      renderCanonicalClusters(filteredPins);
    }

    updatePaginationControls();
  }

  // ═══ Render By Board View ═══
  function renderByBoard(pins: any[]) {
    const container = document.getElementById('by-board-container');
    if (!container) return;

    if (pins.length === 0) {
      container.innerHTML = `
        <div class="py-12 text-center text-xs text-muted-foreground bg-muted/20 rounded-2xl border border-dashed border-border">
          No pins available to group by board.
        </div>
      `;
      return;
    }

    const groups: Record<string, any[]> = {};
    pins.forEach((p) => {
      const b = p.board_name || 'Unassigned Board';
      if (!groups[b]) groups[b] = [];
      groups[b].push(p);
    });

    container.innerHTML = Object.entries(groups)
      .map(([boardName, boardPins]) => {
        const boardSaves = boardPins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
        const boardAvgVel = boardPins.reduce((acc, p) => acc + Number(p.velocity || 0), 0) / boardPins.length;

        return `
          <div class="rounded-2xl border border-border bg-card p-5 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-border/60 pb-3 gap-2">
              <div class="flex items-center gap-2.5">
                <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-foreground">@${escapeHtml(boardName)}</h3>
                  <span class="text-[11px] text-muted-foreground font-medium">${boardPins.length} winning pin${boardPins.length === 1 ? '' : 's'}</span>
                </div>
              </div>
              <div class="flex items-center gap-3 text-xs">
                <span class="text-rose-500 font-extrabold font-mono">${fmtNumber(boardSaves)} total saves</span>
                <span class="text-border">|</span>
