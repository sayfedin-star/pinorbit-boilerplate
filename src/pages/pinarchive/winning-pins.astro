---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
---

<Layout title="Winning Pins — PinArchive" description="Historical pin performance archive, high-velocity winners, and canonical groupings.">
  <!-- ═══ Back Link & Top Bar ═══ -->
  <div class="mb-5">
    <a
      href="/pinarchive"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors group mb-3"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      <span>Back to PinArchive Dashboard</span>
    </a>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2.5">
          <SectionHeader
            title="🏆 Winning Pins Intelligence"
            description="High-velocity winning pins, performance breakdowns, cluster analysis, and side-by-side growth trajectories."
          />
        </div>
        <div id="refresh-meta-line" class="text-xs text-muted-foreground -mt-3 mb-2 flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span id="refresh-meta-text" class="font-medium text-foreground">Historical archive active</span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-auto">
        <!-- Multi-View Segmented Switcher -->
        <div class="flex items-center bg-card border border-border rounded-xl p-1 shadow-xs">
          <button
            id="view-grid-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg bg-primary text-primary-foreground shadow-xs transition-all cursor-pointer"
            title="Modern card grid view"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
            <span>Grid</span>
          </button>
          <button
            id="view-table-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer"
            title="Dense data sheet view"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            <span>Table</span>
          </button>
          <button
            id="view-board-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer"
            title="Grouped by Pinterest board"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            <span>By Board</span>
          </button>
          <button
            id="view-clusters-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer"
            title="Canonical pin duplicate clusters"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            <span>Clusters</span>
          </button>
        </div>

        <!-- CSV Export Button -->
        <button
          id="export-csv-btn"
          type="button"
          title="Export current filtered view to CSV"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Export CSV</span>
        </button>

        <!-- Refresh Button -->
        <button
          id="refresh-btn"
          type="button"
          title="Refresh pins data"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all cursor-pointer"
        >
          <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
          </svg>
          <span>Refresh</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ 1. Executive Winning KPIs Summary Header ═══ -->
  <div id="kpi-header-section" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <!-- Card 1: Top Velocity Champion -->
    <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-xs hover:border-primary/40 transition-all group flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-bold text-muted-foreground uppercase tracking-wider">Top Velocity Pin</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-rose-500/10 text-rose-500 border border-rose-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
      </div>
      <div class="mt-3 flex items-center gap-3">
        <div id="kpi-top-thumb-wrapper" class="h-12 w-12 rounded-xl bg-muted shrink-0 overflow-hidden border border-border/80 flex items-center justify-center">
          <span class="text-xs text-muted-foreground font-mono">#1</span>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5">
            <span id="kpi-top-velocity" class="text-xl font-extrabold tracking-tight text-emerald-500 font-mono tabular-nums">0.0/d</span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">Pace</span>
          </div>
          <p id="kpi-top-title" class="text-xs font-semibold text-foreground truncate mt-0.5" title="Top Performer">Loading...</p>
          <span id="kpi-top-saves" class="text-[11px] text-muted-foreground">0 saves</span>
        </div>
      </div>
    </div>

    <!-- Card 2: Average Daily Velocity -->
    <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-xs hover:border-primary/40 transition-all group flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-bold text-muted-foreground uppercase tracking-wider">Average Velocity</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </span>
      </div>
      <div class="mt-3">
        <div class="flex items-baseline gap-2">
          <span id="kpi-avg-velocity" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground font-mono tabular-nums">0.0/d</span>
          <span class="text-[11px] font-semibold text-emerald-500 font-mono">avg saves/day</span>
        </div>
        <div class="mt-1 text-xs text-muted-foreground flex items-center justify-between">
          <span id="kpi-total-analyzed-saves">0 total saves</span>
          <span id="kpi-active-sample-count" class="text-[10px] bg-muted px-1.5 py-0.5 rounded text-muted-foreground font-semibold">0 pins</span>
        </div>
      </div>
    </div>

    <!-- Card 3: Dominant Winning Board -->
    <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-xs hover:border-primary/40 transition-all group flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-bold text-muted-foreground uppercase tracking-wider">Dominant Board</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </span>
      </div>
      <div class="mt-3">
        <div id="kpi-dominant-board-name" class="text-base font-bold text-foreground truncate" title="Board Name">—</div>
        <div class="mt-1 text-xs text-muted-foreground flex items-center justify-between">
          <span id="kpi-dominant-board-saves" class="text-rose-500 font-semibold">0 saves</span>
          <span id="kpi-dominant-board-pins" class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold">0 winners</span>
        </div>
      </div>
    </div>

    <!-- Card 4: Growth Stages Breakdown -->
    <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-xs hover:border-primary/40 transition-all group flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-bold text-muted-foreground uppercase tracking-wider">Growth Stages</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-purple-500/10 text-purple-500 border border-purple-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20"/><path d="m17 5-5-3-5 3"/><path d="m17 19-5 3-5-3"/></svg>
        </span>
      </div>
      <div class="mt-3 space-y-1.5">
        <!-- Visual Distribution Bar -->
        <div class="h-2 w-full bg-muted rounded-full overflow-hidden flex" id="kpi-stage-bar">
          <div id="kpi-bar-growing" class="bg-emerald-500 h-full" style="width: 0%" title="Growing"></div>
          <div id="kpi-bar-mature" class="bg-purple-500 h-full" style="width: 0%" title="Mature"></div>
          <div id="kpi-bar-new" class="bg-cyan-500 h-full" style="width: 0%" title="New"></div>
          <div id="kpi-bar-cooling" class="bg-amber-500 h-full" style="width: 0%" title="Cooling/Dormant"></div>
        </div>
        <div class="flex items-center justify-between text-[10px] font-semibold text-muted-foreground pt-0.5">
          <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> <span id="kpi-count-growing">0</span> 🚀</span>
          <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-purple-500"></span> <span id="kpi-count-mature">0</span> 🟣</span>
          <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-cyan-500"></span> <span id="kpi-count-new">0</span> 🟢</span>
          <span class="flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span> <span id="kpi-count-cooling">0</span> ❄️</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ 2. Smart Quick-Filter Chips & Search Toolbar ═══ -->
  <div class="rounded-2xl border border-border bg-card p-4 shadow-xs mb-6 space-y-3.5">
    <!-- Preset Slicer Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs no-scrollbar">
      <span class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider shrink-0 flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <span>Quick:</span>
      </span>
      <button
        type="button"
        data-quick-filter="all"
        class="quick-pill active px-3 py-1 rounded-xl text-xs font-bold bg-primary text-primary-foreground transition-all cursor-pointer shrink-0"
      >
        🌟 All Winners (<span id="quick-count-all">0</span>)
      </button>
      <button
        type="button"
        data-quick-filter="growing"
        class="quick-pill px-3 py-1 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
      >
        🚀 Growing Pace (<span id="quick-count-growing">0</span>)
      </button>
      <button
        type="button"
        data-quick-filter="spike"
        class="quick-pill px-3 py-1 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
      >
        🔥 Viral Spikes (<span id="quick-count-spike">0</span>)
      </button>
      <button
        type="button"
        data-quick-filter="velocity-high"
        class="quick-pill px-3 py-1 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
      >
        ⚡ High Velocity (≥20/d)
      </button>
      <button
        type="button"
        data-quick-filter="fresh"
        class="quick-pill px-3 py-1 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
      >
        🌱 Fresh Winners (≤14d)
      </button>
      <button
        type="button"
        data-quick-filter="cluster"
        class="quick-pill px-3 py-1 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
      >
        🧬 In Clusters
      </button>
    </div>

    <!-- Main Filter Controls Row -->
    <div class="flex flex-wrap items-center gap-3 justify-between pt-1 border-t border-border/60">
      <!-- Left Controls: Search & Dropdowns -->
      <div class="flex flex-wrap items-center gap-2.5 flex-1 min-w-[280px]">
        <!-- Search Input -->
        <div class="relative flex-1 min-w-[200px] max-w-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            id="filter-search-input"
            type="text"
            placeholder="Search pin title, keywords, tags…"
            class="w-full rounded-xl border border-border bg-background py-1.5 pl-8 pr-7 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary shadow-2xs"
          />
          <kbd class="absolute right-2 top-1/2 -translate-y-1/2 rounded border border-border bg-muted px-1 text-[9px] font-bold text-muted-foreground">/</kbd>
        </div>

        <!-- Board Filter -->
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-2xs">
          <label for="filter-board-select" class="text-xs font-semibold text-muted-foreground">Board:</label>
          <select id="filter-board-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer max-w-[150px] truncate">
            <option value="">All Boards</option>
          </select>
        </div>

        <!-- Stage Filter -->
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-2xs">
          <label for="filter-stage-select" class="text-xs font-semibold text-muted-foreground">Stage:</label>
          <select id="filter-stage-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
            <option value="">All Stages</option>
            <option value="NEW">🟢 NEW (≤14d)</option>
            <option value="GROWING">🚀 GROWING (≥10/d)</option>
            <option value="MATURE">🟣 MATURE (&gt;14d)</option>
            <option value="COOLING">❄️ COOLING (&lt;2/d)</option>
            <option value="DORMANT">⚪ DORMANT (&lt;0.5/d)</option>
          </select>
        </div>

        <!-- In-Cluster Toggle Checkbox -->
        <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-medium text-muted-foreground hover:text-foreground select-none px-1">
          <input id="filter-cluster-toggle" type="checkbox" class="rounded border-border text-primary focus:ring-primary h-4 w-4 cursor-pointer" />
          <span>In Cluster Only</span>
        </label>
      </div>

      <!-- Right Controls: Sort & Limit & Clear -->
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-2xs">
          <label for="pins-sort-select" class="text-xs font-semibold text-muted-foreground">Sort:</label>
          <select id="pins-sort-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
            <option value="saves">Total Saves</option>
            <option value="velocity">Velocity (Saves/Day)</option>
          </select>
        </div>

        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-2xs">
          <label for="pins-limit-select" class="text-xs font-semibold text-muted-foreground">Show:</label>
          <select id="pins-limit-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
          </select>
        </div>

        <button id="clear-filters-btn" type="button" class="text-xs font-bold text-muted-foreground hover:text-rose-500 px-2.5 py-1.5 rounded-lg hover:bg-rose-500/10 transition-all cursor-pointer">
          Reset
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ 3. Active Winners Presentation Area ═══ -->
  <section class="mb-12" aria-labelledby="winners-section-heading">
    <!-- Header Section Info -->
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 id="winners-section-heading" class="text-base font-bold text-foreground flex items-center gap-2">
          <span>Ranked Intelligence</span>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20" id="winners-badge-count">0</span>
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">Top performing archived pins ranked by selected metric (persisted workspace filters apply server-side).</p>
      </div>
    </div>

    <!-- VIEW 1: Modern Grid View (Default) -->
    <div id="winners-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <!-- Loading Shimmer Skeletons -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-xs animate-pulse space-y-3">
        <div class="h-44 bg-muted rounded-xl"></div>
        <div class="h-4 w-3/4 bg-muted rounded"></div>
        <div class="h-3 w-1/2 bg-muted rounded"></div>
      </div>
      <div class="rounded-2xl border border-border bg-card p-4 shadow-xs animate-pulse space-y-3">
        <div class="h-44 bg-muted rounded-xl"></div>
        <div class="h-4 w-3/4 bg-muted rounded"></div>
        <div class="h-3 w-1/2 bg-muted rounded"></div>
      </div>
      <div class="rounded-2xl border border-border bg-card p-4 shadow-xs animate-pulse space-y-3">
        <div class="h-44 bg-muted rounded-xl"></div>
        <div class="h-4 w-3/4 bg-muted rounded"></div>
        <div class="h-3 w-1/2 bg-muted rounded"></div>
      </div>
      <div class="rounded-2xl border border-border bg-card p-4 shadow-xs animate-pulse space-y-3">
        <div class="h-44 bg-muted rounded-xl"></div>
        <div class="h-4 w-3/4 bg-muted rounded"></div>
        <div class="h-3 w-1/2 bg-muted rounded"></div>
      </div>
    </div>

    <!-- VIEW 2: Pro Data Table View (Hidden by default) -->
    <div id="winners-table-container" class="hidden rounded-2xl border border-border bg-card shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-border bg-muted/40 text-muted-foreground font-bold">
              <th class="py-3 px-3 text-center w-12">#</th>
              <th class="py-3 px-3 min-w-[240px]">Pin Title &amp; Details</th>
              <th class="py-3 px-3 min-w-[120px]">Board</th>
              <th class="py-3 px-3 text-center">Stage</th>
              <th class="py-3 px-3 text-right cursor-pointer hover:text-foreground table-sort-header" data-sort="saves">
                Saves ↕
              </th>
              <th class="py-3 px-3 text-right cursor-pointer hover:text-foreground table-sort-header" data-sort="repins">
                Repins ↕
              </th>
              <th class="py-3 px-3 text-right cursor-pointer hover:text-foreground table-sort-header" data-sort="velocity">
                Velocity ↕
              </th>
              <th class="py-3 px-3 text-center">Virality</th>
              <th class="py-3 px-3 text-right w-28">Actions</th>
            </tr>
          </thead>
          <tbody id="winners-table-body" class="divide-y divide-border/60">
            <!-- Rows rendered dynamically -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- VIEW 3: By Board Container (Hidden by default) -->
