    <!-- VIEW 4: Canonical Clusters View (Hidden by default) -->
    <div id="clusters-view-container" class="hidden space-y-6">
      <div class="rounded-2xl border border-border bg-card shadow-xs overflow-hidden">
        <div class="p-4 bg-muted/30 border-b border-border flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-purple-500/10 text-purple-500 border border-purple-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
