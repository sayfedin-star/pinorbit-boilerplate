  // ═══ Render By Board View ═══
  function renderByBoard(pins: any[]) {
    const container = document.getElementById('by-board-container');
    if (!container) return;

    if (pins.length === 0) {
      container.innerHTML = `
        <div class="py-12 text-center text-xs text-muted-foreground bg-muted/20 rounded-2xl border border-dashed border-border">
          No pins available to group by board.
        </div>
      `;
      return;
    }

    const groups: Record<string, any[]> = {};
    pins.forEach((p) => {
      const b = p.board_name || 'Unassigned Board';
      if (!groups[b]) groups[b] = [];
      groups[b].push(p);
    });

    container.innerHTML = Object.entries(groups)
      .map(([boardName, boardPins]) => {
        const boardSaves = boardPins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
        const boardAvgVel = boardPins.reduce((acc, p) => acc + Number(p.velocity || 0), 0) / boardPins.length;

        return `
          <div class="rounded-2xl border border-border bg-card p-5 shadow-xs space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-border/60 pb-3 gap-2">
              <div class="flex items-center gap-2.5">
                <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                </span>
                <div>
                  <h3 class="text-sm font-bold text-foreground">@${escapeHtml(boardName)}</h3>
                  <span class="text-[11px] text-muted-foreground font-medium">${boardPins.length} winning pin${boardPins.length === 1 ? '' : 's'}</span>
                </div>
              </div>
              <div class="flex items-center gap-3 text-xs">
                <span class="text-rose-500 font-extrabold font-mono">${fmtNumber(boardSaves)} total saves</span>
                <span class="text-border">|</span>
                <span class="text-emerald-500 font-bold font-mono">avg ${boardAvgVel.toFixed(1)}/d</span>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              ${boardPins.map((p, idx) => renderSinglePinCard(p, idx)).join('')}
            </div>
          </div>
        `;
      })
      .join('');

    attachListeners();
  }

  // ═══ Render Canonical Clusters View ═══
  function renderCanonicalClusters(pins: any[]) {
    const container = document.getElementById('canonical-container');
    const badge = document.getElementById('canonical-badge-count');
    if (!container) return;

    const clusters: Record<string, any[]> = {};
    pins.forEach((p) => {
      if (p.canonical_pin_id) {
        if (!clusters[p.canonical_pin_id]) clusters[p.canonical_pin_id] = [];
        clusters[p.canonical_pin_id].push(p);
      }
    });

    const clusterEntries = Object.entries(clusters).filter(([_, list]) => list.length >= 1);
    if (badge) badge.textContent = `${clusterEntries.length} Clusters`;

    if (clusterEntries.length === 0) {
      container.innerHTML = `
        <div class="p-8 text-center text-xs text-muted-foreground">
          No canonical pin clusters found for active filters.
        </div>
      `;
      return;
    }

    container.innerHTML = clusterEntries
      .map(([canonicalId, clusterPins]) => {
        const clusterTotalSaves = clusterPins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
        clusterPins.sort((a, b) => Number(b.saves || 0) - Number(a.saves || 0));

        const itemsList = clusterPins
          .map((p) => {
            const pinSaves = Number(p.saves || 0);
            const sharePct = clusterTotalSaves > 0 ? Math.round((pinSaves / clusterTotalSaves) * 100) : 0;
            return `
              <li class="flex items-center justify-between py-2 px-3 text-xs rounded-xl hover:bg-muted/40 transition-colors">
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="h-8 w-8 rounded-lg bg-muted overflow-hidden shrink-0 border border-border cursor-pointer" data-peek-trigger="${escapeHtml(p.id)}">
                    ${p.image_url ? `<img src="${escapeHtml(p.image_url)}" class="h-full w-full object-cover" />` : ''}
                  </div>
                  <a href="javascript:void(0)" data-peek-trigger="${escapeHtml(p.id)}" class="font-bold text-foreground hover:text-primary transition-colors truncate max-w-md">
                    ${escapeHtml(p.title || `Pin ${p.pin_id}`)}
                  </a>
                  <span class="text-[10px] text-muted-foreground">(@${escapeHtml(p.board_name || 'board')})</span>
                </div>
                <div class="flex items-center gap-3 shrink-0 ml-2">
                  <span class="text-[10px] text-muted-foreground font-mono">(${sharePct}%)</span>
                  <span class="font-extrabold text-rose-500 font-mono">${fmtNumber(pinSaves)} saves</span>
                </div>
              </li>
            `;
          })
          .join('');

        return `
          <div class="p-5 hover:bg-muted/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-purple-500/10 text-purple-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                </span>
                <span class="font-extrabold text-xs text-foreground font-mono">Canonical #${escapeHtml(canonicalId)}</span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-500 border border-purple-500/20">
                  ${clusterPins.length} Variations
                </span>
              </div>
              <span class="text-xs font-semibold text-muted-foreground">
                Cluster Total: <strong class="text-foreground font-extrabold font-mono">${fmtNumber(clusterTotalSaves)} saves</strong>
              </span>
            </div>
            <ul class="space-y-1 bg-muted/20 rounded-2xl p-2.5 border border-border/40">
              ${itemsList}
            </ul>
          </div>
        `;
      })
      .join('');

    attachListeners();
  }

  // ═══ Quick-Peek Drawer Logic ═══
  async function openQuickPeek(pinId: string) {
    const backdrop = document.getElementById('quick-peek-backdrop');
    const drawer = document.getElementById('quick-peek-drawer');
    const content = document.getElementById('quick-peek-content');
    if (!backdrop || !drawer || !content) return;

    currentPeekIndex = filteredPins.findIndex((p) => p.id === pinId);

    backdrop.classList.remove('hidden');
    drawer.classList.remove('translate-x-full');
    content.innerHTML = `
      <div class="animate-pulse space-y-4 py-8">
        <div class="h-64 bg-muted rounded-2xl"></div>
        <div class="h-6 w-3/4 bg-muted rounded"></div>
        <div class="h-20 bg-muted rounded-xl"></div>
      </div>
    `;

    try {
      const res = await fetch(`/api/pinarchive/pin?id=${encodeURIComponent(pinId)}`, { signal: AbortSignal.timeout(8000) });
      const json = await res.json();
      if (!json.success || !json.pin) throw new Error(json.error || 'Failed to load pin data');

      const p = json.pin;
      const metrics = Array.isArray(json.metrics) ? json.metrics : [];
      const annotations = Array.isArray(p.annotations) ? p.annotations : [];
      const pinterestUrl = `https://www.pinterest.com/pin/${p.pin_id}/`;
      const destinationUrl = p.link || null;
      const viralityRatio = Number(p.saves || 0) > 0 ? ((Number(p.repins || 0) / Number(p.saves)) * 100).toFixed(0) : '0';

      const tagsHtml = annotations.map((a: any) => {
        const name = typeof a === 'string' ? a : a?.name || '';
        if (!name) return '';
        const targetUrl = typeof a === 'object' && a?.url ? `https://www.pinterest.com${a.url.startsWith('/') ? a.url : '/' + a.url}` : `https://www.pinterest.com/search/pins/?q=${encodeURIComponent(name)}`;
        return `
          <a
            href="${escapeHtml(targetUrl)}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-xs bg-primary/10 hover:bg-primary/20 text-primary px-2.5 py-1 rounded-xl font-semibold transition-colors"
          >
            <span>#${escapeHtml(name)}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        `;
      }).join('');

      content.innerHTML = `
        <!-- Image & Top Badges -->
        <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-muted/60 border border-border shadow-md group">
          <img src="${escapeHtml(p.image_url)}" class="w-full h-full object-cover" />
          <a href="${escapeHtml(p.image_url)}" target="_blank" rel="noopener noreferrer" class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white font-bold text-xs gap-1.5 backdrop-blur-xs">
            <span>Open High-Resolution</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>

        <!-- Badges & Title -->
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-1.5">
            ${renderStageBadge(p.stage)}
            ${renderAnomalyBadge(p.anomaly)}
            <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-muted text-foreground border border-border">
              @${escapeHtml(p.board_name || 'board')}
            </span>
            ${p.canonical_pin_id ? `<span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-500 border border-purple-500/20">Canonical #${escapeHtml(p.canonical_pin_id)}</span>` : ''}
          </div>
          <h2 class="text-base font-extrabold text-foreground leading-snug">${escapeHtml(p.title || `Pin ${p.pin_id}`)}</h2>
          ${p.description ? `<p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">${escapeHtml(p.description)}</p>` : ''}
          <div class="text-[11px] text-muted-foreground pt-1">
            Created on Pinterest: <strong class="text-foreground">${fmtDate(p.created_at_pinterest)}</strong>
          </div>
        </div>

        <!-- Quick Copy Action Bar -->
        <div class="flex flex-wrap items-center gap-2 pt-1">
          <button id="drawer-copy-id-btn" type="button" class="inline-flex items-center gap-1.5 text-xs font-bold bg-muted/60 hover:bg-muted text-foreground px-3 py-1.5 rounded-xl border border-border shadow-2xs transition-all cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span>Copy ID</span>
          </button>
          <button id="drawer-copy-url-btn" type="button" class="inline-flex items-center gap-1.5 text-xs font-bold bg-muted/60 hover:bg-muted text-foreground px-3 py-1.5 rounded-xl border border-border shadow-2xs transition-all cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            <span>Copy Link</span>
          </button>
          <a href="/pinarchive/details?id=${encodeURIComponent(p.id)}" class="inline-flex items-center gap-1.5 text-xs font-bold bg-primary text-primary-foreground px-3.5 py-1.5 rounded-xl shadow-xs hover:bg-primary/90 transition-all ml-auto">
            <span>Full Deep-Dive →</span>
          </a>
        </div>

        <!-- 4-Grid Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          <div class="bg-muted/30 rounded-2xl p-3 border border-border text-center">
            <span class="text-[10px] font-bold text-muted-foreground uppercase block">Saves</span>
            <span class="text-base font-extrabold text-rose-500 font-mono">${fmtNumber(p.saves)}</span>
          </div>
          <div class="bg-muted/30 rounded-2xl p-3 border border-border text-center">
            <span class="text-[10px] font-bold text-muted-foreground uppercase block">Repins</span>
            <span class="text-base font-extrabold text-foreground font-mono">${fmtNumber(p.repins)}</span>
          </div>
          <div class="bg-muted/30 rounded-2xl p-3 border border-border text-center">
            <span class="text-[10px] font-bold text-muted-foreground uppercase block">Velocity</span>
            <span class="text-base font-extrabold text-emerald-500 font-mono">${Number(p.velocity || 0).toFixed(1)}/d</span>
          </div>
          <div class="bg-muted/30 rounded-2xl p-3 border border-border text-center">
            <span class="text-[10px] font-bold text-muted-foreground uppercase block">Virality Ratio</span>
            <span class="text-base font-extrabold text-primary font-mono">${viralityRatio}%</span>
          </div>
        </div>

        <!-- Trajectory Chart -->
        <div class="space-y-2">
          <span class="text-xs font-bold text-foreground block">Historical Growth Trajectory</span>
          ${renderPinSvgChart(metrics, 'drawerGrad')}
        </div>

        <!-- Annotations Tags -->
        ${tagsHtml ? `
          <div class="space-y-2">
            <span class="text-xs font-bold text-foreground block">Pinterest SEO Annotations (${annotations.length})</span>
            <div class="flex flex-wrap items-center gap-1.5">
              ${tagsHtml}
            </div>
          </div>
        ` : ''}

        <!-- Outbound Link Details -->
        ${destinationUrl ? `
          <div class="p-3 bg-muted/30 rounded-xl border border-border text-xs flex items-center justify-between">
            <span class="text-muted-foreground truncate max-w-xs">Destination: <strong class="text-foreground">${escapeHtml(destinationUrl)}</strong></span>
            <a href="${escapeHtml(destinationUrl)}" target="_blank" rel="noopener noreferrer nofollow" class="text-primary font-bold hover:underline shrink-0 ml-2">Visit Site ↗</a>
          </div>
        ` : ''}
      `;

      // Copy listeners in drawer
      document.getElementById('drawer-copy-id-btn')?.addEventListener('click', () => {
        navigator.clipboard.writeText(p.pin_id);
        const btn = document.getElementById('drawer-copy-id-btn');
        if (btn) btn.innerHTML = '<span>Copied!</span>';
        setTimeout(() => { if (btn) btn.innerHTML = '<span>Copy ID</span>'; }, 1500);
      });

      document.getElementById('drawer-copy-url-btn')?.addEventListener('click', () => {
        navigator.clipboard.writeText(pinterestUrl);
        const btn = document.getElementById('drawer-copy-url-btn');
        if (btn) btn.innerHTML = '<span>Copied!</span>';
        setTimeout(() => { if (btn) btn.innerHTML = '<span>Copy Link</span>'; }, 1500);
      });
    } catch (e: any) {
      content.innerHTML = `<div class="p-8 text-center text-xs text-rose-500 bg-rose-500/10 rounded-2xl border border-rose-500/20">${escapeHtml(e.message)}</div>`;
    }
  }

  function closeQuickPeek() {
    const backdrop = document.getElementById('quick-peek-backdrop');
    const drawer = document.getElementById('quick-peek-drawer');
    if (backdrop) backdrop.classList.add('hidden');
    if (drawer) drawer.classList.add('translate-x-full');
  }

  // ═══ Attach Click & Checkbox Listeners ═══
  function attachListeners() {
    // Quick Peek Triggers
    document.querySelectorAll<HTMLElement>('[data-peek-trigger]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = el.getAttribute('data-peek-trigger');
        if (id) openQuickPeek(id);
      });
    });

    // Compare Checkboxes
    document.querySelectorAll<HTMLInputElement>('[data-pin-compare]').forEach((cb) => {
      cb.addEventListener('change', (e) => {
        e.stopPropagation();
        const id = cb.getAttribute('data-pin-compare');
        if (!id) return;
        if (cb.checked) {
          if (selectedForCompare.size >= 3) {
            cb.checked = false;
            alert('You can select a maximum of 3 pins for side-by-side comparison.');
            return;
          }
          selectedForCompare.add(id);
        } else {
          selectedForCompare.delete(id);
        }
        updateCompareBar();
      });
    });
  }

  function updateCompareBar() {
    const bar = document.getElementById('floating-compare-bar');
    const text = document.getElementById('compare-count-text');
    if (!bar || !text) return;

    if (selectedForCompare.size > 0) {
      bar.classList.remove('hidden');
      text.textContent = `${selectedForCompare.size} of 3 Pins Selected`;
    } else {
      bar.classList.add('hidden');
    }
  }

  // ═══ SVG Growth Trajectory Chart ═══
  function renderPinSvgChart(metrics: any[], gradId: string): string {
    if (!Array.isArray(metrics) || metrics.length === 0) {
      return '<div class="h-44 flex items-center justify-center text-xs text-muted-foreground bg-muted/10 rounded-2xl border border-dashed border-border/80">No historical snapshots recorded yet</div>';
    }

    if (metrics.length === 1) {
      const m = metrics[0];
      return `
        <div class="h-44 flex flex-col items-center justify-center text-xs text-muted-foreground bg-muted/10 rounded-2xl border border-dashed border-border/80 p-4 text-center">
          <span class="font-bold text-foreground mb-1">1 Snapshot Recorded</span>
          <span>${fmtDate(m.recorded_at)}: ${fmtNumber(m.saves)} saves · ${fmtNumber(m.repins)} repins</span>
          <span class="text-[10px] text-muted-foreground mt-1">Subsequent refresh cycles will plot the growth curve</span>
        </div>
      `;
    }

    const width = 380;
    const height = 180;
    const padX = 40;
    const padY = 24;

    const saves = metrics.map((m) => Number(m.saves || 0));
    const repins = metrics.map((m) => Number(m.repins || 0));
    const maxVal = Math.max(...saves, ...repins, 10);
    const minVal = 0;

    const ptsCount = metrics.length;
    const getX = (i: number) => padX + (i / (ptsCount - 1)) * (width - padX * 2);
    const getY = (v: number) => height - padY - ((v - minVal) / (maxVal - minVal)) * (height - padY * 2);

    const savesPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.saves || 0)).toFixed(1)}`)
      .join(' ');

    const repinsPath = metrics
      .map((m, i) => `${i === 0 ? 'M' : 'L'} ${getX(i).toFixed(1)} ${getY(Number(m.repins || 0)).toFixed(1)}`)
      .join(' ');

    const savesArea = `${savesPath} L ${getX(ptsCount - 1)} ${height - padY} L ${getX(0)} ${height - padY} Z`;

    const gridY1 = height - padY;
    const gridY2 = height - padY - (height - padY * 2) * 0.5;
    const gridY3 = padY;

    return `
      <div class="h-48 w-full bg-card rounded-2xl border border-border/60 p-2 shadow-2xs">
        <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" class="overflow-visible" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.25"/>
              <stop offset="100%" stop-color="#f43f5e" stop-opacity="0.0"/>
            </linearGradient>
          </defs>

          <!-- Grid lines -->
          <line x1="${padX}" y1="${gridY1}" x2="${width - padX}" y2="${gridY1}" stroke="currentColor" class="text-border" stroke-width="1" />
          <line x1="${padX}" y1="${gridY2}" x2="${width - padX}" y2="${gridY2}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />
          <line x1="${padX}" y1="${gridY3}" x2="${width - padX}" y2="${gridY3}" stroke="currentColor" class="text-border" stroke-dasharray="4 4" stroke-width="1" />

          <!-- Y Axis Labels -->
          <text x="${padX - 6}" y="${gridY1}" text-anchor="end" class="fill-muted-foreground text-[9px] font-mono" dominant-baseline="middle">${fmtCompact(minVal)}</text>
          <text x="${padX - 6}" y="${gridY2}" text-anchor="end" class="fill-muted-foreground text-[9px] font-mono" dominant-baseline="middle">${fmtCompact(Math.round(maxVal / 2))}</text>
          <text x="${padX - 6}" y="${gridY3}" text-anchor="end" class="fill-muted-foreground text-[9px] font-mono" dominant-baseline="middle">${fmtCompact(maxVal)}</text>

          <!-- Area Fill -->
          <path d="${savesArea}" fill="url(#${gradId})" />

          <!-- Repins Line -->
          <path d="${repinsPath}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />

          <!-- Saves Line -->
          <path d="${savesPath}" fill="none" stroke="#f43f5e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

          <!-- Data Points -->
          ${metrics
            .map(
              (m, i) => `
                <g class="group cursor-pointer">
                  <circle cx="${getX(i).toFixed(1)}" cy="${getY(Number(m.saves || 0)).toFixed(1)}" r="3.5" fill="#f43f5e" stroke="var(--color-card, #fff)" stroke-width="1.5" />
                  <title>${fmtDate(m.recorded_at)}: ${fmtNumber(m.saves)} saves · ${fmtNumber(m.repins)} repins</title>
                </g>
              `
            )
            .join('')}
        </svg>
      </div>
      <div class="flex items-center justify-between text-[10px] text-muted-foreground px-2 pt-1">
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-rose-500"></span> Saves</span>
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-blue-500"></span> Repins</span>
        <span>${metrics.length} snapshot(s)</span>
      </div>
    `;
  }

  // ═══ Compare Modal Dialog ═══
  async function openCompareModal() {
    const modal = document.getElementById('compare-modal');
    const content = document.getElementById('compare-modal-content');
    if (!modal || !content || selectedForCompare.size < 2) return;

    modal.classList.remove('hidden');
    content.innerHTML = '<div class="py-12 text-center text-xs text-muted-foreground animate-pulse">Fetching comparison datasets...</div>';

    const ids = Array.from(selectedForCompare);
    try {
      const pinPromises = ids.map((id) => fetch(`/api/pinarchive/pin?id=${encodeURIComponent(id)}`).then((r) => r.json()));
      const results = await Promise.all(pinPromises);

      const validPins = results.filter((r) => r.success && r.pin);
      if (validPins.length < 2) throw new Error('Could not fetch selected pins for comparison.');

      const cols = validPins.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2';

      content.innerHTML = `
        <div class="grid grid-cols-1 ${cols} gap-4">
          ${validPins
            .map((res, i) => {
              const p = res.pin;
              const m = Array.isArray(res.metrics) ? res.metrics : [];
              return `
                <div class="rounded-2xl border border-border bg-card p-4 space-y-3 shadow-xs">
                  <div class="flex items-center gap-3">
                    <img src="${escapeHtml(p.image_url)}" class="h-14 w-14 object-cover rounded-xl border border-border" />
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1 mb-1">
                        ${renderStageBadge(p.stage)}
                        ${renderAnomalyBadge(p.anomaly)}
                      </div>
                      <h4 class="text-xs font-bold text-foreground line-clamp-1">${escapeHtml(p.title || `Pin ${i + 1}`)}</h4>
                      <span class="text-[10px] text-muted-foreground">@${escapeHtml(p.board_name || 'board')}</span>
                    </div>
                  </div>
                  <div class="grid grid-cols-3 gap-1.5 pt-2 border-t border-border text-center">
                    <div class="bg-muted/30 p-2 rounded-xl">
                      <span class="text-[9px] font-bold text-muted-foreground block">Saves</span>
                      <span class="text-xs font-extrabold text-rose-500 font-mono">${fmtNumber(p.saves)}</span>
                    </div>
                    <div class="bg-muted/30 p-2 rounded-xl">
                      <span class="text-[9px] font-bold text-muted-foreground block">Repins</span>
                      <span class="text-xs font-extrabold text-foreground font-mono">${fmtNumber(p.repins)}</span>
                    </div>
                    <div class="bg-muted/30 p-2 rounded-xl">
                      <span class="text-[9px] font-bold text-muted-foreground block">Velocity</span>
                      <span class="text-xs font-extrabold text-emerald-500 font-mono">${Number(p.velocity || 0).toFixed(1)}/d</span>
                    </div>
                  </div>
                  <div class="space-y-1 pt-1">
                    <span class="text-[10px] font-bold text-muted-foreground block">Trajectory</span>
                    ${renderPinSvgChart(m, `compareGrad${i}`)}
                  </div>
                </div>
              `;
            })
            .join('')}
        </div>
      `;
    } catch (err: any) {
      content.innerHTML = `<div class="p-6 text-center text-xs text-rose-500">${escapeHtml(err.message)}</div>`;
    }
  }

  // ═══ Apply Quick Filters & Search ═══
  function applyActiveFilters() {
    let result = [...rawPins];

    // Quick Filter Preset Slicing
    if (activeQuickFilter === 'growing') {
      result = result.filter((p) => p.stage === 'GROWING');
    } else if (activeQuickFilter === 'spike') {
      result = result.filter((p) => p.anomaly === 'SPIKE');
    } else if (activeQuickFilter === 'velocity-high') {
      result = result.filter((p) => Number(p.velocity || 0) >= 20);
    } else if (activeQuickFilter === 'fresh') {
      result = result.filter((p) => {
        if (!p.created_at_pinterest) return false;
        const days = (Date.now() - new Date(p.created_at_pinterest).getTime()) / 86400000;
        return days <= 14;
      });
    } else if (activeQuickFilter === 'cluster') {
      result = result.filter((p) => Boolean(p.canonical_pin_id));
    }

    filteredPins = result;
    updateExecutiveKPIs(filteredPins);

    if (activeView === 'grid') {
      renderPins(filteredPins);
    } else if (activeView === 'table') {
      renderTableView(filteredPins);
    } else if (activeView === 'board') {
      renderByBoard(filteredPins);
    } else if (activeView === 'clusters') {
      renderCanonicalClusters(filteredPins);
    }
  }

  function populateBoardFilter(pins: any[]) {
    const select = document.getElementById('filter-board-select') as HTMLSelectElement | null;
    if (!select) return;

    const currentVal = select.value;
    const boards = Array.from(new Set(pins.map((p) => p.board_name).filter(Boolean))).sort();

    select.innerHTML = '<option value="">All Boards</option>' +
      boards.map((b) => `<option value="${escapeHtml(b)}" ${b === currentVal ? 'selected' : ''}>${escapeHtml(b)}</option>`).join('');
  }

  async function loadPins(retries = 2) {
    const searchInput = document.getElementById('filter-search-input') as HTMLInputElement | null;
    const boardSelect = document.getElementById('filter-board-select') as HTMLSelectElement | null;
    const stageSelect = document.getElementById('filter-stage-select') as HTMLSelectElement | null;
    const clusterToggle = document.getElementById('filter-cluster-toggle') as HTMLInputElement | null;

    const params = new URLSearchParams();
    if (searchInput?.value) params.set('q', searchInput.value.trim());
    if (boardSelect?.value) params.set('board', boardSelect.value);
    if (stageSelect?.value) params.set('stage', stageSelect.value);
    if (clusterToggle?.checked) params.set('in_cluster', '1');
    params.set('sort', currentSort);
    params.set('limit', String(currentLimit));

    try {
      const res = await fetch(`/api/pinarchive/pins?${params.toString()}`, { signal: AbortSignal.timeout(8000) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load pins');

      rawPins = json.pins || [];

      if (!boardSelect?.value) {
        populateBoardFilter(rawPins);
      }

      applyActiveFilters();
    } catch (e: any) {
      if (retries > 0) {
        setTimeout(() => loadPins(retries - 1), 1500);
        return;
      }
      console.error('Error loading PinArchive pins:', e);
      const grid = document.getElementById('winners-grid');
      if (grid) {
        grid.innerHTML = `
          <div class="col-span-full py-12 text-center text-xs text-rose-500 bg-rose-500/10 rounded-2xl border border-rose-500/20 p-6">
            Failed to load winning pins. <button id="retry-load-pins-btn" class="underline font-bold cursor-pointer ml-1">Retry</button>
          </div>
        `;
        document.getElementById('retry-load-pins-btn')?.addEventListener('click', () => loadPins(2));
      }
    }
  }

  function exportCSV() {
    if (!filteredPins.length) {
      alert('No pins available in the current filtered view to export.');
      return;
    }

    const headers = ['Pin ID', 'Title', 'Board', 'Category', 'Saves', 'Repins', 'Velocity', 'Stage', 'Anomaly', 'Canonical Cluster', 'Pinterest Link', 'Created At'];
    const rows = filteredPins.map((p) => [
      p.pin_id,
      `"${(p.title || '').replace(/"/g, '""')}"`,
      `"${(p.board_name || '').replace(/"/g, '""')}"`,
      `"${(p.seo_category || '').replace(/"/g, '""')}"`,
      p.saves || 0,
      p.repins || 0,
      p.velocity || 0,
      p.stage || 'DORMANT',
      p.anomaly || 'NONE',
      p.canonical_pin_id || '',
      `"https://www.pinterest.com/pin/${p.pin_id}/"`,
      p.created_at_pinterest || '',
    ]);

    const csvContent = [headers.join(','), ...rows.map((r) => r.join(','))].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pinarchive-winners-${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function init() {
    loadPins();

    // View Switcher Buttons
    const gridBtn = document.getElementById('view-grid-btn');
    const tableBtn = document.getElementById('view-table-btn');
    const boardBtn = document.getElementById('view-board-btn');
    const clustersBtn = document.getElementById('view-clusters-btn');

    const winnersGrid = document.getElementById('winners-grid');
    const tableContainer = document.getElementById('winners-table-container');
    const byBoardContainer = document.getElementById('by-board-container');
    const clustersContainer = document.getElementById('clusters-view-container');

    function setActiveView(v: 'grid' | 'table' | 'board' | 'clusters') {
      activeView = v;
      const activeCls = 'inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg bg-primary text-primary-foreground shadow-xs transition-all cursor-pointer';
      const inactiveCls = 'inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer';

      if (gridBtn) gridBtn.className = v === 'grid' ? activeCls : inactiveCls;
      if (tableBtn) tableBtn.className = v === 'table' ? activeCls : inactiveCls;
      if (boardBtn) boardBtn.className = v === 'board' ? activeCls : inactiveCls;
      if (clustersBtn) clustersBtn.className = v === 'clusters' ? activeCls : inactiveCls;

      winnersGrid?.classList.toggle('hidden', v !== 'grid');
      tableContainer?.classList.toggle('hidden', v !== 'table');
      byBoardContainer?.classList.toggle('hidden', v !== 'board');
      clustersContainer?.classList.toggle('hidden', v !== 'clusters');

      applyActiveFilters();
    }

    gridBtn?.addEventListener('click', () => setActiveView('grid'));
    tableBtn?.addEventListener('click', () => setActiveView('table'));
    boardBtn?.addEventListener('click', () => setActiveView('board'));
    clustersBtn?.addEventListener('click', () => setActiveView('clusters'));

    // Quick Filter Preset Chips
    document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeQuickFilter = btn.getAttribute('data-quick-filter') || 'all';
        document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]').forEach((b) => {
          b.className = 'quick-pill px-3 py-1 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0';
        });
        btn.className = 'quick-pill active px-3 py-1 rounded-xl text-xs font-bold bg-primary text-primary-foreground transition-all cursor-pointer shrink-0';
        applyActiveFilters();
      });
    });

    // Filter controls
    const searchInput = document.getElementById('filter-search-input');
    const boardSelect = document.getElementById('filter-board-select');
    const stageSelect = document.getElementById('filter-stage-select');
    const clusterToggle = document.getElementById('filter-cluster-toggle');
    const clearBtn = document.getElementById('clear-filters-btn');

    let debounceTimer: any = null;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          loadPins();
        }, 300);
      });
    }

    if (boardSelect) boardSelect.addEventListener('change', loadPins);
    if (stageSelect) stageSelect.addEventListener('change', loadPins);
    if (clusterToggle) clusterToggle.addEventListener('change', loadPins);

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) (searchInput as HTMLInputElement).value = '';
        if (boardSelect) (boardSelect as HTMLSelectElement).value = '';
        if (stageSelect) (stageSelect as HTMLSelectElement).value = '';
        if (clusterToggle) (clusterToggle as HTMLInputElement).checked = false;
        activeQuickFilter = 'all';
        document.querySelectorAll<HTMLButtonElement>('[data-quick-filter]').forEach((b) => {
          b.className = b.getAttribute('data-quick-filter') === 'all'
            ? 'quick-pill active px-3 py-1 rounded-xl text-xs font-bold bg-primary text-primary-foreground transition-all cursor-pointer shrink-0'
            : 'quick-pill px-3 py-1 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0';
        });
        loadPins();
      });
    }

    // Keyboard shortcut '/' to search
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && !(document.activeElement instanceof HTMLInputElement || document.activeElement instanceof HTMLTextAreaElement)) {
        e.preventDefault();
        searchInput?.focus();
      }
      if (e.key === 'Escape') {
        closeQuickPeek();
        document.getElementById('compare-modal')?.classList.add('hidden');
      }
    });

    // Sort & Limit Selectors
    const sortSelect = document.getElementById('pins-sort-select') as HTMLSelectElement | null;
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value;
        loadPins();
      });
    }

    const limitSelect = document.getElementById('pins-limit-select') as HTMLSelectElement | null;
    if (limitSelect) {
      limitSelect.addEventListener('change', () => {
        currentLimit = parseInt(limitSelect.value, 10) || 50;
        loadPins();
      });
    }

    // Table Column Sort Headers
    document.querySelectorAll<HTMLElement>('.table-sort-header').forEach((th) => {
      th.addEventListener('click', () => {
        const sortKey = th.getAttribute('data-sort');
        if (!sortKey) return;
        if (sortSelect) {
          sortSelect.value = sortKey;
          currentSort = sortKey;
          loadPins();
        }
      });
    });

    // CSV Export
    const exportBtn = document.getElementById('export-csv-btn');
    if (exportBtn) exportBtn.addEventListener('click', exportCSV);

    // Compare Controls
    const launchCompareBtn = document.getElementById('launch-compare-btn');
    if (launchCompareBtn) launchCompareBtn.addEventListener('click', openCompareModal);

    const clearCompareBtn = document.getElementById('clear-compare-btn');
    if (clearCompareBtn) {
      clearCompareBtn.addEventListener('click', () => {
        selectedForCompare.clear();
        updateCompareBar();
        document.querySelectorAll<HTMLInputElement>('[data-pin-compare]').forEach((cb) => {
          cb.checked = false;
        });
      });
    }

    const closeCompareModal = document.getElementById('close-compare-modal');
    if (closeCompareModal) {
      closeCompareModal.addEventListener('click', () => {
        document.getElementById('compare-modal')?.classList.add('hidden');
      });
    }

    // Quick Peek Drawer Close / Prev / Next
    document.getElementById('quick-peek-backdrop')?.addEventListener('click', closeQuickPeek);
    document.getElementById('peek-close-btn')?.addEventListener('click', closeQuickPeek);

    document.getElementById('peek-prev-btn')?.addEventListener('click', () => {
      if (currentPeekIndex > 0) {
        currentPeekIndex--;
        const prevPin = filteredPins[currentPeekIndex];
        if (prevPin) openQuickPeek(prevPin.id);
      }
    });

    document.getElementById('peek-next-btn')?.addEventListener('click', () => {
      if (currentPeekIndex < filteredPins.length - 1) {
        currentPeekIndex++;
        const nextPin = filteredPins[currentPeekIndex];
        if (nextPin) openQuickPeek(nextPin.id);
      }
    });

    // Refresh button
    const refreshBtn = document.getElementById('refresh-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const icon = document.getElementById('refresh-icon');
        if (icon) icon.classList.add('animate-spin');
        loadPins().finally(() => {
          setTimeout(() => {
            if (icon) icon.classList.remove('animate-spin');
          }, 400);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
