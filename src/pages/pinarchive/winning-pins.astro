<script>
  let rawPins: any[] = [];
  let rawAccounts: any[] = [];
  let filteredPins: any[] = [];
  let activeTimeframe: '24h' | '3d' | '7d' | 'all' = '24h';
  let currentSort = 'delta_24h_desc';
  let currentPage = 1;
  let pageSize = 24;
  let activeView: 'grid' | 'table' | 'board' | 'clusters' = 'grid';
  let activeQuickFilter = 'all';
  const selectedForCompare = new Set<string>();
  let currentPeekIndex = -1;

  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtCompact(n: number): string {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1_000) return (n / 1_000).toFixed(1) + 'k';
    return String(Math.round(n));
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function getPinDeltaByActiveTimeframe(p: any): number {
    switch (activeTimeframe) {
      case '3d':
        return Number(p.delta_saves_3d ?? p.delta_saves ?? 0);
      case '7d':
        return Number(p.delta_saves_7d ?? p.delta_saves ?? 0);
      case 'all':
        return Number(p.saves ?? 0);
      case '24h':
      default:
        return Number(p.delta_saves_24h ?? p.delta_saves ?? 0);
    }
  }

  // ═══ Strategy Matrix ═══
  type PinStrategy = 'EVERGREEN' | 'ROCKET' | 'VIRAL' | 'MATURE' | 'COOLING';

  function getPinStrategy(p: any): PinStrategy {
    const saves = Number(p.saves || 0);
    const repins = Number(p.repins || 0);
    const velocity = Number(p.velocity || 0);
    const ageDays = Number(p.age_days) || (p.created_at_pinterest ? Math.max(0, (Date.now() - new Date(p.created_at_pinterest).getTime()) / 86400000) : 30);
    const viralityRatio = saves > 0 ? (repins / saves) * 100 : 0;

    if (ageDays <= 14 && velocity >= 15) return 'ROCKET';
    if (ageDays > 45 && velocity >= 8 && saves >= 2500) return 'EVERGREEN';
    if (viralityRatio >= 90) return 'VIRAL';
    if (p.stage === 'COOLING' || velocity < 2) return 'COOLING';
    return 'MATURE';
  }

  function renderStrategyBadge(strategy: PinStrategy): string {
    switch (strategy) {
      case 'EVERGREEN':
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-emerald-600/10 text-emerald-600 dark:text-emerald-400 border border-emerald-600/20" title="Evergreen Giant (>45d, steady high saves)">🌲 EVERGREEN</span>';
      case 'ROCKET':
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20 animate-pulse" title="Viral Rocket (≤14d, high velocity)">🚀 ROCKET</span>';
      case 'VIRAL':
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20" title="High Repin/Save Ratio (>90%)">💎 VIRAL</span>';
      case 'COOLING':
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" title="Slowing growth pace">❄️ COOLING</span>';
      default:
        return '<span class="inline-flex items-center gap-1 text-[9.5px] font-bold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">🟣 MATURE</span>';
    }
  }

  function renderRankBadge(index: number): string {
    if (index === 0) {
      return '<span class="inline-flex items-center justify-center h-6 px-2 rounded-lg bg-amber-500 text-white font-extrabold text-[10px] shadow-xs border border-amber-400">🥇 #1</span>';
    }
    if (index === 1) {
      return '<span class="inline-flex items-center justify-center h-6 px-2 rounded-lg bg-slate-400 text-white font-extrabold text-[10px] shadow-xs border border-slate-300">🥈 #2</span>';
    }
    if (index === 2) {
      return '<span class="inline-flex items-center justify-center h-6 px-2 rounded-lg bg-amber-700 text-white font-extrabold text-[10px] shadow-xs border border-amber-600">🥉 #3</span>';
    }
    return `<span class="inline-flex items-center justify-center h-5 px-1.5 rounded-md bg-muted/90 text-muted-foreground font-bold text-[9px] border border-border">#${index + 1}</span>`;
  }

  // ═══ Keyword Mining Extraction ═══
  function updateKeywordMining(pins: any[]) {
    const container = document.getElementById('keywords-cloud-container');
    if (!container) return;

    if (!pins || pins.length === 0) {
      container.innerHTML = '<span class="text-xs text-muted-foreground">No keyword annotations found for active filters.</span>';
      return;
    }

    const keywordStats: Record<string, { count: number; totalSaves: number }> = {};

    pins.forEach((p) => {
      const pinSaves = Number(p.saves || 0);
      const annotations = Array.isArray(p.annotations) ? p.annotations : [];
      const seenForPin = new Set<string>();

      annotations.forEach((a: any) => {
        const name = typeof a === 'string' ? a.trim() : a?.name ? String(a.name).trim() : '';
        if (name && !seenForPin.has(name.toLowerCase())) {
          seenForPin.add(name.toLowerCase());
          if (!keywordStats[name]) keywordStats[name] = { count: 0, totalSaves: 0 };
          keywordStats[name].count += 1;
          keywordStats[name].totalSaves += pinSaves;
        }
      });
    });

    const sortedKeywords = Object.entries(keywordStats)
      .sort((a, b) => b[1].count !== a[1].count ? b[1].count - a[1].count : b[1].totalSaves - a[1].totalSaves)
      .slice(0, 14);

    if (sortedKeywords.length === 0) {
      container.innerHTML = '<span class="text-xs text-muted-foreground">No Pinterest SEO annotations found on selected pins.</span>';
      return;
    }

    container.innerHTML = sortedKeywords.map(([name, stat]) => `
      <a
        href="/pinarchive/topics?q=${encodeURIComponent(name)}"
        title="${escapeHtml(name)} — ${stat.count} winning pins, ${fmtNumber(stat.totalSaves)} saves"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-muted/60 hover:bg-primary/15 hover:text-primary border border-border/80 text-xs font-semibold text-foreground transition-all group"
      >
        <span class="text-amber-500 font-bold">#</span>
        <span class="truncate max-w-[160px]">${escapeHtml(name)}</span>
        <span class="text-[10px] font-mono px-1.5 py-0.2 rounded-md bg-background text-muted-foreground group-hover:text-primary font-bold border border-border/40">
          ${stat.count}
        </span>
      </a>
    `).join('');
  }

  // ═══ KPI Computation ═══
  function updateExecutiveKPIs(pins: any[]) {
    if (!pins || pins.length === 0) {
      const topTitle = document.getElementById('kpi-top-title');
      const topVel = document.getElementById('kpi-top-velocity');
      const topSaves = document.getElementById('kpi-top-saves');
      const avgVelElem = document.getElementById('kpi-avg-velocity');
      const totalSavesElem = document.getElementById('kpi-total-analyzed-saves');
      const sampleCountElem = document.getElementById('kpi-active-sample-count');
      const domName = document.getElementById('kpi-dominant-board-name');
      const domSaves = document.getElementById('kpi-dominant-board-saves');
      const domPins = document.getElementById('kpi-dominant-board-pins');

      if (topTitle) topTitle.textContent = 'No active pins';
      if (topVel) topVel.textContent = '+0 saves';
      if (topSaves) topSaves.textContent = '0 total saves';
      if (avgVelElem) avgVelElem.textContent = '0.0/d';
      if (totalSavesElem) totalSavesElem.textContent = '0 total saves';
      if (sampleCountElem) sampleCountElem.textContent = '0 pins';
      if (domName) domName.textContent = '—';
      if (domSaves) domSaves.textContent = '0 saves';
      if (domPins) domPins.textContent = '0 winners';
      return;
    }

    // 1. Top Growth Champion (Dynamic based on active timeframe)
    const sortedByGrowth = [...pins].sort((a, b) => getPinDeltaByActiveTimeframe(b) - getPinDeltaByActiveTimeframe(a));
    const topPin = sortedByGrowth[0];
    if (topPin) {
      const topLabel = document.getElementById('kpi-top-label');
      const topTitle = document.getElementById('kpi-top-title');
      const topVel = document.getElementById('kpi-top-velocity');
      const topTag = document.getElementById('kpi-top-timeframe-tag');
      const topSaves = document.getElementById('kpi-top-saves');
      const thumbWrapper = document.getElementById('kpi-top-thumb-wrapper');

      const deltaVal = getPinDeltaByActiveTimeframe(topPin);
      if (topLabel) topLabel.textContent = `🔥 Top ${activeTimeframe.toUpperCase()} Growth`;
      if (topTag) topTag.textContent = activeTimeframe.toUpperCase();
      if (topTitle) topTitle.textContent = topPin.title || `Pin ${topPin.pin_id}`;
      if (topVel) topVel.textContent = `+${fmtNumber(deltaVal)} saves`;
      if (topSaves) topSaves.textContent = `${fmtNumber(topPin.saves)} total · @${topPin.account_username || topPin.board_name || 'account'}`;
      if (thumbWrapper && topPin.image_url) {
        thumbWrapper.innerHTML = `<img src="${escapeHtml(topPin.image_url)}" class="w-full h-full object-cover rounded-xl" />`;
      }
    }

    // 2. Average Velocity & Total Saves
    const totalSaves = pins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
    const avgVelocity = pins.reduce((acc, p) => acc + Number(p.velocity || 0), 0) / pins.length;

    const avgVelElem = document.getElementById('kpi-avg-velocity');
    const totalSavesElem = document.getElementById('kpi-total-analyzed-saves');
    const sampleCountElem = document.getElementById('kpi-active-sample-count');

    if (avgVelElem) avgVelElem.textContent = `${avgVelocity.toFixed(1)}/d`;
    if (totalSavesElem) totalSavesElem.textContent = `${fmtNumber(totalSaves)} total saves`;
    if (sampleCountElem) sampleCountElem.textContent = `${pins.length} active pins`;

    // 3. Dominant Board
    const boardStats: Record<string, { count: number; saves: number }> = {};
    pins.forEach((p) => {
      const b = p.board_name || 'Unassigned';
      if (!boardStats[b]) boardStats[b] = { count: 0, saves: 0 };
      boardStats[b].count += 1;
      boardStats[b].saves += Number(p.saves || 0);
    });

    const dominantEntry = Object.entries(boardStats).sort((a, b) => b[1].saves - a[1].saves)[0];
    const domName = document.getElementById('kpi-dominant-board-name');
    const domSaves = document.getElementById('kpi-dominant-board-saves');
    const domPins = document.getElementById('kpi-dominant-board-pins');

    if (dominantEntry) {
      if (domName) domName.textContent = dominantEntry[0];
      if (domSaves) domSaves.textContent = `${fmtNumber(dominantEntry[1].saves)} saves`;
      if (domPins) domPins.textContent = `${dominantEntry[1].count} winning pins`;
    }

    // 4. Strategy Matrix Distribution
    let cEvergreen = 0;
    let cRocket = 0;
    let cVirality = 0;
    let cMature = 0;

    pins.forEach((p) => {
      const st = getPinStrategy(p);
      if (st === 'EVERGREEN') cEvergreen++;
      else if (st === 'ROCKET') cRocket++;
      else if (st === 'VIRAL') cVirality++;
      else cMature++;
    });

    const len = pins.length;
    const pEvergreen = Math.round((cEvergreen / len) * 100);
    const pRocket = Math.round((cRocket / len) * 100);
    const pVirality = Math.round((cVirality / len) * 100);
    const pMature = Math.max(0, 100 - pEvergreen - pRocket - pVirality);

    const bEvergreen = document.getElementById('kpi-bar-evergreen');
    const bRocket = document.getElementById('kpi-bar-rocket');
    const bVirality = document.getElementById('kpi-bar-virality');
    const bMature = document.getElementById('kpi-bar-mature');

    if (bEvergreen) bEvergreen.style.width = `${pEvergreen}%`;
    if (bRocket) bRocket.style.width = `${pRocket}%`;
    if (bVirality) bVirality.style.width = `${pVirality}%`;
    if (bMature) bMature.style.width = `${pMature}%`;

    const elEver = document.getElementById('kpi-count-evergreen');
    const elRoc = document.getElementById('kpi-count-rocket');
    const elVir = document.getElementById('kpi-count-virality');
    const elMat = document.getElementById('kpi-count-mature');

    if (elEver) elEver.textContent = String(cEvergreen);
    if (elRoc) elRoc.textContent = String(cRocket);
    if (elVir) elVir.textContent = String(cVirality);
    if (elMat) elMat.textContent = String(cMature);

    // Update Quick Filter counts
    const qAll = document.getElementById('quick-count-all');
    const qEver = document.getElementById('quick-count-evergreen');
    const qRoc = document.getElementById('quick-count-rocket');
    const qSpike = document.getElementById('quick-count-spike');

    if (qAll) qAll.textContent = String(rawPins.length);
    if (qEver) qEver.textContent = String(rawPins.filter((p) => getPinStrategy(p) === 'EVERGREEN').length);
    if (qRoc) qRoc.textContent = String(rawPins.filter((p) => getPinStrategy(p) === 'ROCKET').length);
    if (qSpike) qSpike.textContent = String(rawPins.filter((p) => p.anomaly === 'SPIKE').length);
  }

