---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
---

<Layout title="Winning Pins Intelligence — PinArchive" description="Cross-account high-velocity winners, delta growth analytics (24h/3d/7d), evergreen strategy matrix, and keyword mining.">
  <!-- ═══ Back Link & Top Bar ═══ -->
  <div class="mb-5">
    <a
      href="/pinarchive"
      class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors group mb-3"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      <span>Back to PinArchive Dashboard</span>
    </a>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="flex items-center gap-2.5">
          <SectionHeader
            title="🏆 Winning Pins Intelligence"
            description="Cross-account performance, 24h / 3d / 7d delta growth momentum, evergreen strategy matrix, and SEO keywords mining."
          />
        </div>
        <div id="refresh-meta-line" class="text-xs text-muted-foreground -mt-3 mb-2 flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span id="refresh-meta-text" class="font-medium text-foreground">Cross-account archive active</span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-auto">
        <!-- Multi-View Segmented Switcher -->
        <div class="flex items-center bg-card border border-border rounded-xl p-1 shadow-xs">
          <button
            id="view-grid-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg bg-primary text-primary-foreground shadow-xs transition-all cursor-pointer"
            title="Modern card grid view"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
            <span>Grid</span>
          </button>
          <button
            id="view-table-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer"
            title="Dense data sheet view"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            <span>Table</span>
          </button>
          <button
            id="view-board-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer"
            title="Grouped by Pinterest board"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
            <span>By Board</span>
          </button>
          <button
            id="view-clusters-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all cursor-pointer"
            title="Canonical pin duplicate clusters"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
            <span>Clusters</span>
          </button>
        </div>

        <!-- Topic Clusters Link -->
        <a
          href="/pinarchive/topics"
          title="Explore Topic Clusters"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all"
        >
          <span class="text-amber-500 font-bold">🏷️</span>
          <span>Topics</span>
        </a>

        <!-- CSV Export Button -->
        <button
          id="export-csv-btn"
          type="button"
          title="Export current filtered view to CSV"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Export CSV</span>
        </button>

        <!-- Refresh Button -->
        <button
          id="refresh-btn"
          type="button"
          title="Refresh pins data"
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all cursor-pointer"
        >
          <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
          </svg>
          <span>Refresh</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ 1. Executive Winning KPIs Summary Header ═══ -->
  <div id="kpi-header-section" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <!-- Card 1: Top Growth Champion (Dynamic by Timeframe) -->
    <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-xs hover:border-primary/40 transition-all group flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-bold text-muted-foreground uppercase tracking-wider" id="kpi-top-label">🔥 Top 24h Growth</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-rose-500/10 text-rose-500 border border-rose-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
      </div>
      <div class="mt-3 flex items-center gap-3">
        <div id="kpi-top-thumb-wrapper" class="h-12 w-12 rounded-xl bg-muted shrink-0 overflow-hidden border border-border/80 flex items-center justify-center">
          <span class="text-xs text-muted-foreground font-mono">#1</span>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5">
            <span id="kpi-top-velocity" class="text-xl font-extrabold tracking-tight text-emerald-500 font-mono tabular-nums">+0 saves</span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" id="kpi-top-timeframe-tag">24h</span>
          </div>
          <p id="kpi-top-title" class="text-xs font-semibold text-foreground truncate mt-0.5" title="Top Performer">Loading...</p>
          <span id="kpi-top-saves" class="text-[11px] text-muted-foreground">0 total saves · @account</span>
        </div>
      </div>
    </div>

    <!-- Card 2: Average Daily Velocity -->
    <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-xs hover:border-primary/40 transition-all group flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-bold text-muted-foreground uppercase tracking-wider">Average Velocity</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </span>
      </div>
      <div class="mt-3">
        <div class="flex items-baseline gap-2">
          <span id="kpi-avg-velocity" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground font-mono tabular-nums">0.0/d</span>
          <span class="text-[11px] font-semibold text-emerald-500 font-mono">avg saves/day</span>
        </div>
        <div class="mt-1 text-xs text-muted-foreground flex items-center justify-between">
          <span id="kpi-total-analyzed-saves">0 total saves</span>
          <span id="kpi-active-sample-count" class="text-[10px] bg-muted px-1.5 py-0.5 rounded text-muted-foreground font-semibold">0 pins</span>
        </div>
      </div>
    </div>

    <!-- Card 3: Dominant Winning Board -->
    <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-xs hover:border-primary/40 transition-all group flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-bold text-muted-foreground uppercase tracking-wider">Dominant Board</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </span>
      </div>
      <div class="mt-3">
        <div id="kpi-dominant-board-name" class="text-base font-bold text-foreground truncate" title="Board Name">—</div>
        <div class="mt-1 text-xs text-muted-foreground flex items-center justify-between">
          <span id="kpi-dominant-board-saves" class="text-rose-500 font-semibold">0 saves</span>
          <span id="kpi-dominant-board-pins" class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded-full font-bold">0 winners</span>
        </div>
      </div>
    </div>

    <!-- Card 4: Strategy Matrix Breakdown -->
    <div class="relative overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-xs hover:border-primary/40 transition-all group flex flex-col justify-between">
      <div class="flex items-center justify-between">
        <span class="text-[10.5px] font-bold text-muted-foreground uppercase tracking-wider">Strategy Matrix</span>
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-purple-500/10 text-purple-500 border border-purple-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </span>
      </div>
      <div class="mt-3 space-y-1.5">
        <!-- Visual Distribution Bar -->
        <div class="h-2 w-full bg-muted rounded-full overflow-hidden flex" id="kpi-stage-bar">
          <div id="kpi-bar-evergreen" class="bg-emerald-600 h-full" style="width: 0%" title="Evergreen Giants"></div>
          <div id="kpi-bar-rocket" class="bg-rose-500 h-full" style="width: 0%" title="Viral Rockets"></div>
          <div id="kpi-bar-virality" class="bg-primary h-full" style="width: 0%" title="High Virality"></div>
          <div id="kpi-bar-mature" class="bg-purple-500 h-full" style="width: 0%" title="Mature Stable"></div>
        </div>
        <div class="flex items-center justify-between text-[10px] font-bold text-muted-foreground pt-0.5">
          <span class="flex items-center gap-1" title="Evergreen Giants (>45d + steady high saves)"><span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> <span id="kpi-count-evergreen">0</span> 🌲</span>
          <span class="flex items-center gap-1" title="Viral Rockets (≤14d + fast pace)"><span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span> <span id="kpi-count-rocket">0</span> 🚀</span>
          <span class="flex items-center gap-1" title="High Virality (>90% Repin/Save Ratio)"><span class="h-1.5 w-1.5 rounded-full bg-primary"></span> <span id="kpi-count-virality">0</span> 💎</span>
          <span class="flex items-center gap-1" title="Mature Content"><span class="h-1.5 w-1.5 rounded-full bg-purple-500"></span> <span id="kpi-count-mature">0</span> 🟣</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ 2. In-Depth Keyword & SEO Mining Box ═══ -->
  <div id="keyword-mining-box" class="rounded-2xl border border-border bg-card p-4 sm:p-5 shadow-xs mb-6 space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-border/60 pb-3">
      <div class="flex items-center gap-2.5">
        <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 text-sm">
          🏷️
        </span>
        <div>
          <h3 class="text-xs sm:text-sm font-bold text-foreground flex items-center gap-1.5">
            <span>Winning SEO Keywords Mining</span>
            <span class="text-[10px] font-semibold text-muted-foreground">(Top recurring Pinterest annotations in active filtered scope)</span>
          </h3>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="copy-all-keywords-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-border bg-background text-xs font-bold text-foreground hover:bg-muted shadow-2xs transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span>Copy All Tags</span>
        </button>
        <a
          href="/pinarchive/topics"
          class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline"
        >
          <span>All Topic Clusters →</span>
        </a>
      </div>
    </div>

    <!-- Active Keywords Cloud -->
    <div id="keywords-cloud-container" class="flex flex-wrap items-center gap-1.5 min-h-[36px]">
      <span class="text-xs text-muted-foreground animate-pulse">Mining keyword clusters from active winners...</span>
    </div>
  </div>

  <!-- ═══ 3. Growth Timeframe Slicers & Filter Controls Toolbar ═══ -->
  <div class="rounded-2xl border border-border bg-card p-4 shadow-xs mb-6 space-y-3.5">
    <!-- Growth Timeframe Slicer Pills (24h / 3d / 7d / All-Time) -->
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs no-scrollbar">
        <span class="text-[11px] font-bold text-muted-foreground uppercase tracking-wider shrink-0 flex items-center gap-1">
          <span>⚡ Growth Pace:</span>
        </span>
        <button
          type="button"
          data-timeframe="24h"
          class="timeframe-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-primary text-primary-foreground shadow-2xs transition-all cursor-pointer shrink-0"
        >
          🔥 Last 24 Hours
        </button>
        <button
          type="button"
          data-timeframe="3d"
          class="timeframe-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
        >
          📈 Last 3 Days
        </button>
        <button
          type="button"
          data-timeframe="7d"
          class="timeframe-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
        >
          🗓️ Last 7 Days
        </button>
        <button
          type="button"
          data-timeframe="all"
          class="timeframe-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
        >
          ⭐ All-Time Total
        </button>
      </div>

      <!-- Quick Matrix Slicers -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs no-scrollbar">
        <button
          type="button"
          data-quick-filter="all"
          class="quick-pill active px-2.5 py-1 rounded-lg text-xs font-bold bg-muted text-foreground transition-all cursor-pointer shrink-0"
        >
          All (<span id="quick-count-all">0</span>)
        </button>
        <button
          type="button"
          data-quick-filter="evergreen"
          class="quick-pill px-2.5 py-1 rounded-lg text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
        >
          🌲 Evergreen (<span id="quick-count-evergreen">0</span>)
        </button>
        <button
          type="button"
          data-quick-filter="rocket"
          class="quick-pill px-2.5 py-1 rounded-lg text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
        >
          🚀 Rockets (<span id="quick-count-rocket">0</span>)
        </button>
        <button
          type="button"
          data-quick-filter="spike"
          class="quick-pill px-2.5 py-1 rounded-lg text-xs font-semibold bg-background border border-border text-muted-foreground hover:text-foreground transition-all cursor-pointer shrink-0"
        >
          🔥 Spikes (<span id="quick-count-spike">0</span>)
        </button>
      </div>
    </div>

    <!-- Main Filter Controls Row -->
    <div class="flex flex-wrap items-center gap-3 justify-between pt-2 border-t border-border/60">
      <!-- Left Controls: Search & Account & Board & Stage -->
      <div class="flex flex-wrap items-center gap-2.5 flex-1 min-w-[280px]">
        <!-- Search Input -->
        <div class="relative flex-1 min-w-[180px] max-w-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            id="filter-search-input"
            type="text"
            placeholder="Search pin title, keywords, tags…"
            class="w-full rounded-xl border border-border bg-background py-1.5 pl-8 pr-7 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary shadow-2xs"
          />
          <kbd class="absolute right-2 top-1/2 -translate-y-1/2 rounded border border-border bg-muted px-1 text-[9px] font-bold text-muted-foreground">/</kbd>
        </div>

        <!-- Account Filter Dropdown -->
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-2xs">
          <label for="filter-account-select" class="text-xs font-semibold text-muted-foreground">Account:</label>
          <select id="filter-account-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer max-w-[140px] truncate">
            <option value="">All Accounts</option>
          </select>
        </div>

        <!-- Board Filter Dropdown -->
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-2xs">
          <label for="filter-board-select" class="text-xs font-semibold text-muted-foreground">Board:</label>
          <select id="filter-board-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer max-w-[130px] truncate">
            <option value="">All Boards</option>
          </select>
        </div>

        <!-- Stage Filter -->
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-2xs">
          <label for="filter-stage-select" class="text-xs font-semibold text-muted-foreground">Stage:</label>
          <select id="filter-stage-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
            <option value="">All Stages</option>
            <option value="NEW">🟢 NEW</option>
            <option value="GROWING">🚀 GROWING</option>
            <option value="MATURE">🟣 MATURE</option>
            <option value="COOLING">❄️ COOLING</option>
          </select>
        </div>

        <!-- In-Cluster Toggle Checkbox -->
        <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs font-medium text-muted-foreground hover:text-foreground select-none px-1">
          <input id="filter-cluster-toggle" type="checkbox" class="rounded border-border text-primary focus:ring-primary h-3.5 w-3.5 cursor-pointer" />
          <span>In Cluster</span>
        </label>
      </div>

      <!-- Right Controls: Sort & Limit & Clear -->
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-2xs">
          <label for="pins-sort-select" class="text-xs font-semibold text-muted-foreground">Sort:</label>
          <select id="pins-sort-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
            <option value="delta_24h_desc">🔥 24h Growth (High → Low)</option>
            <option value="delta_3d_desc">📈 3-Day Growth (High → Low)</option>
            <option value="delta_7d_desc">🗓️ 7-Day Growth (High → Low)</option>
            <option value="saves_desc">Total Saves (High → Low)</option>
            <option value="velocity_desc">Daily Velocity (High → Low)</option>
            <option value="repins_desc">Total Repins (High → Low)</option>
            <option value="virality_desc">Virality Ratio %</option>
            <option value="newest">Newest on Pinterest</option>
