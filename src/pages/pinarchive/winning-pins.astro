  <!-- ═══ 4. Floating Multi-Pin Compare Bar ═══ -->
  <div id="floating-compare-bar" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-card/95 backdrop-blur-md border border-primary/40 rounded-2xl shadow-2xl px-5 py-3 flex items-center gap-4 animate-in fade-in slide-in-from-bottom-2 duration-200">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
      </span>
      <div>
        <span id="compare-count-text" class="text-xs font-bold text-foreground block">2 Pins Selected</span>
        <span class="text-[10px] text-muted-foreground">Compare trajectories side-by-side</span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button id="launch-compare-btn" type="button" class="rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary/90 transition-all cursor-pointer">
        Compare Trajectories
      </button>
      <button id="clear-compare-btn" type="button" class="rounded-xl border border-border bg-background px-3 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all cursor-pointer">
        Clear
      </button>
    </div>
  </div>

  <!-- ═══ 5. Quick-Peek Slide-Over Drawer ═══ -->
  <div id="quick-peek-backdrop" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs transition-opacity duration-300"></div>
  <div
    id="quick-peek-drawer"
    class="fixed top-0 right-0 bottom-0 z-50 w-full max-w-xl bg-card border-l border-border shadow-2xl transform translate-x-full transition-transform duration-300 ease-out flex flex-col"
  >
    <!-- Drawer Header -->
    <div class="p-4 sm:p-5 border-b border-border flex items-center justify-between bg-muted/20">
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        </span>
        <div>
          <h3 class="text-sm font-bold text-foreground">Quick-Peek Intelligence</h3>
          <span id="peek-drawer-meta" class="text-[10px] text-muted-foreground">Snapshot metrics &amp; trajectory</span>
