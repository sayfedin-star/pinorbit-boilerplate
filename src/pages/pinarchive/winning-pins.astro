    <!-- Drawer Scrollable Content -->
    <div id="quick-peek-content" class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-6">
      <!-- Loading Skeleton inside drawer -->
      <div class="animate-pulse space-y-4">
        <div class="h-64 bg-muted rounded-2xl"></div>
        <div class="h-6 w-3/4 bg-muted rounded"></div>
        <div class="h-20 bg-muted rounded-xl"></div>
