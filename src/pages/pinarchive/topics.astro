---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
---

<Layout title="Topic Clusters — PinArchive Intelligence" description="Deep analysis per SEO topic cluster: volume, efficiency, stages, boards, and co-occurring keywords.">
  <div id="topics-page-root" class="space-y-6">
    <!-- Back Link & Header -->
    <div>
      <a
        href="/pinarchive"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors group mb-3"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back to PinArchive Dashboard</span>
      </a>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <SectionHeader
          title="🏷️ Topic Clusters"
          description="Deep analysis per SEO topic cluster: volume, efficiency, stages, boards, and co-occurring keywords."
        />

        <div class="flex items-center gap-2 self-start sm:self-auto">
          <button
            id="refresh-topics-btn"
            type="button"
            class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
            </svg>
            <span>Refresh</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="topics-loading" class="py-12 text-center text-xs text-muted-foreground">
      <div class="inline-block h-6 w-6 animate-spin rounded-full border-2 border-primary border-t-transparent mb-2"></div>
      <p>Loading topic cluster intelligence…</p>
    </div>

    <!-- Error State -->
    <div id="topics-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-6 text-center text-xs text-rose-500">
      <p id="topics-error-msg" class="font-bold">Failed to load topic clusters.</p>
    </div>

    <!-- ═══ MODE A: LIST VIEW (All Topic Clusters Table) ═══ -->
    <div id="topics-list-mode" class="hidden space-y-4">
      <div class="overflow-x-auto rounded-xl border border-border bg-card shadow-xs">
        <table class="w-full text-left text-xs">
          <thead class="bg-muted/40 text-muted-foreground text-[11px] uppercase border-b border-border/80 font-semibold">
            <tr>
              <th class="py-3 px-4 font-semibold text-foreground">Topic Cluster</th>
              <th class="py-3 px-4 font-semibold text-right">Pins</th>
              <th class="py-3 px-4 font-semibold text-right">Total Saves</th>
              <th class="py-3 px-4 font-semibold text-right">Saves / Pin</th>
            </tr>
          </thead>
          <tbody id="topics-table-body" class="divide-y divide-border/60">
            <!-- Populated via JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- ═══ MODE B: DETAIL VIEW (Single Topic Cluster Deep-Dive) ═══ -->
    <div id="topics-detail-mode" class="hidden space-y-6">
      <!-- 1. Header Row -->
      <div class="rounded-xl border border-border bg-card p-5 shadow-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <a
              href="/pinarchive/topics"
              class="text-xs font-semibold text-muted-foreground hover:text-foreground inline-flex items-center gap-1 transition-colors"
            >
              <span>← All Clusters</span>
            </a>
            <span class="text-xs text-muted-foreground">•</span>
            <span class="text-xs font-bold text-primary">SEO Topic Cluster</span>
          </div>
          <h2 id="topic-detail-title" class="text-xl font-bold tracking-tight text-foreground"></h2>
        </div>

        <div class="flex items-center gap-2">
          <a
            id="topic-pinterest-search-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl bg-primary text-primary-foreground px-3.5 py-2 text-xs font-bold shadow-xs hover:bg-primary/90 transition-all"
          >
            <span>Search on Pinterest</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </div>

      <!-- 2. KPI Cards Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
          <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Pins Tracked</span>
          <div class="text-xl font-bold text-foreground mt-1" id="kpi-topic-pins">-</div>
        </div>
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
          <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Total Saves</span>
          <div class="text-xl font-bold text-rose-500 mt-1" id="kpi-topic-saves">-</div>
        </div>
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
          <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Avg Saves / Pin</span>
          <div class="text-xl font-bold text-emerald-500 mt-1" id="kpi-topic-avg-saves">-</div>
        </div>
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
          <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Median Saves</span>
          <div class="text-xl font-bold text-foreground mt-1" id="kpi-topic-median-saves">-</div>
        </div>
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
          <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Avg Velocity</span>
          <div class="text-xl font-bold text-emerald-500 mt-1" id="kpi-topic-velocity">-</div>
        </div>
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
          <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider block">Total Repins</span>
          <div class="text-xl font-bold text-blue-500 mt-1" id="kpi-topic-repins">-</div>
        </div>
      </div>

      <!-- 3. Stage Distribution Chips -->
      <div class="rounded-xl border border-border bg-card p-4 shadow-sm">
        <span class="text-xs font-bold text-foreground block mb-2">📊 Lifecycle Stage Distribution</span>
        <div id="topic-stages-container" class="flex flex-wrap items-center gap-2">
          <!-- Populated via JS -->
        </div>
      </div>

      <!-- 4. Two-Column Grid: Boards Breakdown | Accounts Breakdown -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Boards Breakdown -->
        <div class="rounded-xl border border-border bg-card p-5 shadow-sm space-y-3">
          <h3 class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
            <span>📁 Top Boards</span>
          </h3>
          <div id="topic-boards-list" class="divide-y divide-border/60 space-y-1">
            <!-- Populated via JS -->
          </div>
        </div>

        <!-- Accounts Breakdown -->
        <div class="rounded-xl border border-border bg-card p-5 shadow-sm space-y-3">
          <h3 class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
            <span>👤 Accounts Tracking This Topic</span>
          </h3>
          <div id="topic-accounts-list" class="divide-y divide-border/60 space-y-1">
            <!-- Populated via JS -->
          </div>
        </div>
      </div>

      <!-- 5. Co-occurring Keywords Chips -->
      <div class="rounded-xl border border-border bg-card p-5 shadow-sm space-y-3">
        <h3 class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
          <span>🧩 Co-occurring Keywords</span>
          <span class="text-[10px] text-muted-foreground lowercase">(click to pivot cluster)</span>
        </h3>
        <div id="topic-cooccurring-container" class="flex flex-wrap items-center gap-2">
          <!-- Populated via JS -->
        </div>
      </div>

      <!-- 6. Top Pins Grid -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-foreground uppercase tracking-wider">📌 Top Pins in Cluster</h3>
        <div id="topic-pins-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <!-- Populated via JS -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function renderStageBadge(stage?: string | null): string {
    switch (stage) {
      case 'NEW':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">🟢 NEW (≤14d)</span>';
      case 'GROWING':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">🚀 GROWING (≥10/d)</span>';
      case 'MATURE':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">🟣 MATURE (>14d)</span>';
      case 'COOLING':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">❄️ COOLING (<2/d)</span>';
      default:
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-slate-500/10 text-slate-500 border border-slate-500/20">⚪ DORMANT (<0.5/d)</span>';
    }
  }

  function renderAnomalyBadge(anomaly?: string | null): string {
    if (anomaly === 'SPIKE') {
      return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20 animate-pulse">🔥 SPIKE</span>';
    }
    if (anomaly === 'COOLING') {
      return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">❄️ COOLING</span>';
    }
    return '';
  }

  function renderSinglePinCard(p: any): string {
    const saves = Number(p.saves || 0);
    const repins = Number(p.repins || 0);
    const velocity = Number(p.velocity || 0);
    const shares = Number(p.share_count || 0);
    const annotations = Array.isArray(p.annotations) ? p.annotations : [];
    const category = p.seo_category || p.board_name || null;
    const pinterestUrl = `https://www.pinterest.com/pin/${p.pin_id}/`;
    const destinationUrl = p.link ? p.link : null;
    const imageUrl = p.image_url || '';
    const pinId = p.id || '';
    const createdDate = fmtDate(p.created_at_pinterest);

    const tagsHtml = annotations.slice(0, 4).map((a: any) => {
      const name = typeof a === 'string' ? a : a?.name || '';
      if (!name) return '';
      let targetUrl = '';
      if (typeof a === 'object' && a?.url) {
        targetUrl = `https://www.pinterest.com${a.url.startsWith('/') ? a.url : '/' + a.url}`;
      } else if (typeof a === 'object' && a?.idea_id) {
        targetUrl = `https://www.pinterest.com/ideas/${encodeURIComponent(name)}/${a.idea_id}/`;
      } else {
        targetUrl = `https://www.pinterest.com/search/pins/?q=${encodeURIComponent(name)}`;
      }

      return `
        <a
          href="${escapeHtml(targetUrl)}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[10px] bg-primary/10 hover:bg-primary/20 text-primary px-2 py-0.5 rounded-md font-medium truncate max-w-[130px] transition-colors"
          title="${escapeHtml(name)} (Pinterest Idea)"
        >
          <span class="truncate">${escapeHtml(name)}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      `;
    }).join('');

    const moreTagsCount = annotations.length > 4 ? annotations.length - 4 : 0;

    return `
      <div class="group rounded-xl border border-border bg-card overflow-hidden shadow-sm hover:shadow-md hover:border-primary/40 transition-all flex flex-col justify-between relative">
        <div>
          <!-- Image preview -->
          <a href="/pinarchive/details?id=${encodeURIComponent(pinId)}" class="relative w-full h-44 bg-muted/50 overflow-hidden flex items-center justify-center block">
            ${imageUrl ? `
              <img
                src="${escapeHtml(imageUrl)}"
                alt="${escapeHtml(p.title || 'Pinterest Pin')}"
                loading="lazy"
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
              />
              <div class="hidden absolute inset-0 flex items-center justify-center text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            ` : `
              <div class="flex items-center justify-center text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            `}
            ${category ? `
              <span class="absolute top-2.5 left-2.5 text-[10px] font-bold bg-background/90 backdrop-blur-xs text-foreground px-2 py-0.5 rounded-md shadow-xs max-w-[140px] truncate" title="${escapeHtml(category)}">
                ${escapeHtml(category)}
              </span>
            ` : ''}
          </a>

          <!-- Content -->
          <div class="p-4 space-y-2.5">
            <div class="flex flex-wrap items-center gap-1.5">
              ${renderStageBadge(p.stage)}
              ${renderAnomalyBadge(p.anomaly)}
            </div>

            <div>
              <a href="/pinarchive/details?id=${encodeURIComponent(pinId)}" class="block group/link">
                <h3 class="text-xs font-bold text-foreground line-clamp-2 group-hover/link:text-primary transition-colors" title="${escapeHtml(p.title || 'Untitled Pin')}">
                  ${escapeHtml(p.title || `Pin ${p.pin_id}`)}
                </h3>
              </a>
              <div class="text-[10px] text-muted-foreground mt-0.5">
                Created: <span class="font-medium text-foreground">${createdDate}</span>
              </div>
            </div>

            <!-- Metrics Row (Full Numbers) -->
            <div class="grid grid-cols-3 gap-1.5 pt-1">
              <div class="bg-muted/40 rounded-lg p-1.5 text-center border border-border/40">
                <span class="text-[9px] text-muted-foreground uppercase block font-semibold">Saves</span>
                <span class="text-xs font-bold text-rose-500">${fmtNumber(saves)}</span>
              </div>
              <div class="bg-muted/40 rounded-lg p-1.5 text-center border border-border/40">
                <span class="text-[9px] text-muted-foreground uppercase block font-semibold">Repins</span>
                <span class="text-xs font-bold text-foreground">${fmtNumber(repins)}</span>
              </div>
              <div class="bg-muted/40 rounded-lg p-1.5 text-center border border-border/40">
                <span class="text-[9px] text-muted-foreground uppercase block font-semibold">Velocity</span>
                <span class="text-xs font-bold text-emerald-500">${velocity.toFixed(1)}/d</span>
              </div>
            </div>

            <!-- Social & Tags -->
            ${shares > 0 ? `
              <div class="flex items-center gap-1 text-[10px] text-blue-500 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                <span>${fmtNumber(shares)} shares</span>
              </div>
            ` : ''}

            ${tagsHtml ? `
              <div class="flex flex-wrap items-center gap-1 pt-1">
                ${tagsHtml}
                ${moreTagsCount > 0 ? `<span class="text-[9px] text-muted-foreground font-semibold">+${moreTagsCount}</span>` : ''}
              </div>
            ` : ''}
          </div>
        </div>

        <!-- Footer link -->
        <div class="px-4 py-2.5 bg-muted/20 border-t border-border/60 flex items-center justify-between text-[11px] gap-2">
          <span class="text-muted-foreground text-[10px] truncate max-w-[100px]">${p.board_name ? escapeHtml(p.board_name) : ''}</span>
          <div class="flex items-center gap-2">
            ${destinationUrl ? `
              <a href="${escapeHtml(destinationUrl)}" target="_blank" rel="noopener noreferrer nofollow" class="text-[10px] font-medium text-muted-foreground hover:text-foreground hover:underline">
                Visit Site ↗
              </a>
            ` : ''}
            <a href="${escapeHtml(pinterestUrl)}" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:underline inline-flex items-center gap-1">
              <span>View on Pinterest</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>
      </div>
    `;
  }

  async function loadClusterList() {
    const loadingEl = document.getElementById('topics-loading');
    const listModeEl = document.getElementById('topics-list-mode');
    const tbody = document.getElementById('topics-table-body');
    const errorEl = document.getElementById('topics-error');
    const errorMsg = document.getElementById('topics-error-msg');

    try {
      const res = await fetch('/api/pinarchive/topics');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to fetch topics');

      const topics = json.topics || [];
      if (loadingEl) loadingEl.classList.add('hidden');
      if (listModeEl) listModeEl.classList.remove('hidden');

      if (tbody) {
        if (topics.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="4" class="p-6 text-center text-xs text-muted-foreground bg-muted/20">
                No topic clusters identified in archive yet.
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = topics.map((t: any) => {
          const savesPerPin = t.pins > 0 ? Math.round(Number(t.sum_saves || 0) / t.pins) : 0;
          return `
            <tr
              class="hover:bg-muted/30 transition-colors cursor-pointer"
              data-topic="${encodeURIComponent(t.name)}"
            >
              <td class="py-3 px-4 font-bold text-foreground">
                <span class="inline-flex items-center gap-1.5 text-primary hover:underline">
                  <span>🏷️</span>
                  <span>${escapeHtml(t.name)}</span>
                </span>
              </td>
              <td class="py-3 px-4 text-right font-medium text-foreground tabular-nums">${fmtNumber(t.pins)}</td>
              <td class="py-3 px-4 text-right font-semibold text-rose-500 tabular-nums">${fmtNumber(t.sum_saves)}</td>
              <td class="py-3 px-4 text-right font-medium text-emerald-500 tabular-nums">${fmtNumber(savesPerPin)}</td>
            </tr>
          `;
        }).join('');

        tbody.querySelectorAll<HTMLTableRowElement>('[data-topic]').forEach((row) => {
          row.addEventListener('click', () => {
            location.href = '/pinarchive/topics?name=' + row.getAttribute('data-topic');
          });
        });
      }
    } catch (err: any) {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) errorEl.classList.remove('hidden');
      if (errorMsg) errorMsg.textContent = err.message || 'Failed to load topic clusters';
    }
  }

  async function loadClusterDetail(name: string) {
    const loadingEl = document.getElementById('topics-loading');
    const detailModeEl = document.getElementById('topics-detail-mode');
    const errorEl = document.getElementById('topics-error');
    const errorMsg = document.getElementById('topics-error-msg');

    try {
      const res = await fetch(`/api/pinarchive/topic-detail?name=${encodeURIComponent(name)}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to fetch topic details');

      if (loadingEl) loadingEl.classList.add('hidden');
      if (detailModeEl) detailModeEl.classList.remove('hidden');

      // 1. Header
      const titleEl = document.getElementById('topic-detail-title');
      if (titleEl) titleEl.textContent = json.topic || name;

      const pinterestLink = document.getElementById('topic-pinterest-search-link') as HTMLAnchorElement | null;
      if (pinterestLink) {
        pinterestLink.href = `https://www.pinterest.com/search/pins/?q=${encodeURIComponent(name)}`;
      }

      // 2. KPIs
      const kpis = json.kpis || {};
      const kpiPins = document.getElementById('kpi-topic-pins');
      if (kpiPins) kpiPins.textContent = fmtNumber(kpis.pins);

      const kpiSaves = document.getElementById('kpi-topic-saves');
      if (kpiSaves) kpiSaves.textContent = fmtNumber(kpis.total_saves);

      const kpiAvgSaves = document.getElementById('kpi-topic-avg-saves');
      if (kpiAvgSaves) kpiAvgSaves.textContent = fmtNumber(kpis.avg_saves);

      const kpiMedianSaves = document.getElementById('kpi-topic-median-saves');
      if (kpiMedianSaves) kpiMedianSaves.textContent = fmtNumber(kpis.median_saves);

      const kpiVelocity = document.getElementById('kpi-topic-velocity');
      if (kpiVelocity) kpiVelocity.textContent = `${Number(kpis.avg_velocity || 0).toFixed(1)}/d`;

      const kpiRepins = document.getElementById('kpi-topic-repins');
      if (kpiRepins) kpiRepins.textContent = fmtNumber(kpis.total_repins);

      // 3. Stage Distribution
      const stagesContainer = document.getElementById('topic-stages-container');
      if (stagesContainer) {
        const sd = json.stage_distribution || {};
        const stageConfig = [
          { key: 'NEW', label: '🟢 NEW', cls: 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/20' },
          { key: 'GROWING', label: '🚀 GROWING', cls: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20' },
          { key: 'MATURE', label: '🟣 MATURE', cls: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20' },
          { key: 'COOLING', label: '❄️ COOLING', cls: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20' },
          { key: 'DORMANT', label: '⚪ DORMANT', cls: 'bg-slate-500/10 text-slate-500 border-slate-500/20' },
        ];

        stagesContainer.innerHTML = stageConfig.map((sc) => {
          const count = sd[sc.key] || 0;
          return `
            <span class="inline-flex items-center gap-1 text-xs font-bold px-3 py-1 rounded-full border ${sc.cls}">
              <span>${sc.label}:</span>
              <span>${fmtNumber(count)}</span>
            </span>
          `;
        }).join('');
      }

      // 4. Boards breakdown
      const boardsList = document.getElementById('topic-boards-list');
      if (boardsList) {
        const boards = (json.boards || []).slice(0, 10);
        if (boards.length === 0) {
          boardsList.innerHTML = '<p class="text-xs text-muted-foreground py-2">No boards recorded</p>';
        } else {
          boardsList.innerHTML = boards.map((b: any) => `
            <div class="flex items-center justify-between py-2 text-xs">
              <span class="font-medium text-foreground truncate max-w-[200px]">${escapeHtml(b.name || 'General Board')}</span>
              <div class="flex items-center gap-3 text-right">
                <span class="text-muted-foreground">${fmtNumber(b.pins)} pins</span>
                <span class="font-bold text-rose-500 tabular-nums">${fmtNumber(b.sum_saves)} saves</span>
              </div>
            </div>
          `).join('');
        }
      }

      // 4. Accounts breakdown
      const accountsList = document.getElementById('topic-accounts-list');
      if (accountsList) {
        const accounts = (json.accounts || []).slice(0, 10);
        if (accounts.length === 0) {
          accountsList.innerHTML = '<p class="text-xs text-muted-foreground py-2">No accounts recorded</p>';
        } else {
          accountsList.innerHTML = accounts.map((a: any) => `
            <div class="flex items-center justify-between py-2 text-xs">
              <span class="font-bold text-foreground">@${escapeHtml(a.username || 'unknown')}</span>
              <div class="flex items-center gap-3 text-right">
                <span class="text-muted-foreground">${fmtNumber(a.pins)} pins</span>
                <span class="font-bold text-rose-500 tabular-nums">${fmtNumber(a.sum_saves)} saves</span>
              </div>
            </div>
          `).join('');
        }
      }

      // 5. Co-occurring keywords
      const cooccContainer = document.getElementById('topic-cooccurring-container');
      if (cooccContainer) {
        const cooccurring = json.cooccurring || [];
        if (cooccurring.length === 0) {
          cooccContainer.innerHTML = '<p class="text-xs text-muted-foreground">No co-occurring keywords recorded for this cluster.</p>';
        } else {
          cooccContainer.innerHTML = cooccurring.map((c: any) => `
            <a
              href="/pinarchive/topics?name=${encodeURIComponent(c.name)}"
              class="inline-flex items-center gap-1.5 text-xs bg-muted/60 hover:bg-primary/10 hover:text-primary text-foreground px-3 py-1.5 rounded-xl border border-border transition-all"
            >
              <span>🏷️</span>
              <span class="font-semibold">${escapeHtml(c.name)}</span>
              <span class="text-[10px] text-muted-foreground font-mono">(${fmtNumber(c.pins)})</span>
            </a>
          `).join('');
        }
      }

      // 6. Top Pins Grid
      const pinsGrid = document.getElementById('topic-pins-grid');
      if (pinsGrid) {
        const topPins = json.top_pins || [];
        if (topPins.length === 0) {
          pinsGrid.innerHTML = '<div class="col-span-full py-8 text-center text-xs text-muted-foreground bg-muted/20 rounded-xl">No member pins found.</div>';
        } else {
          pinsGrid.innerHTML = topPins.map((p: any) => renderSinglePinCard(p)).join('');
        }
      }
    } catch (err: any) {
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) errorEl.classList.remove('hidden');
      if (errorMsg) errorMsg.textContent = err.message || 'Failed to load topic cluster detail';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const topicName = new URLSearchParams(window.location.search).get('name')?.trim();

    if (topicName) {
      loadClusterDetail(topicName);
    } else {
      loadClusterList();
    }

    const refreshBtn = document.getElementById('refresh-topics-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const currentName = new URLSearchParams(window.location.search).get('name')?.trim();
        if (currentName) {
          loadClusterDetail(currentName);
        } else {
          loadClusterList();
        }
      });
    }
  });
</script>
