---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
---

<Layout title="Topic Clusters — PinArchive Intelligence" description="Deep analysis per SEO topic cluster: volume, efficiency, stages, boards, and co-occurring keywords.">
  <div id="topics-page-root" class="space-y-6">
    <!-- Back Link & Header -->
    <div>
      <a
        href="/pinarchive"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors group mb-3"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back to PinArchive Dashboard</span>
      </a>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <SectionHeader
          title="🏷️ Topic Clusters"
          description="Deep analysis per SEO topic cluster: volume, efficiency, stages, boards, and co-occurring keywords."
        />

        <div class="flex items-center gap-2 self-start sm:self-auto">
          <button
            id="refresh-topics-btn"
            type="button"
            class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3.5 py-2 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
            </svg>
            <span>Refresh</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="topics-loading" class="py-16 text-center text-xs text-muted-foreground">
      <div class="inline-block h-7 w-7 animate-spin rounded-full border-2 border-primary border-t-transparent mb-3"></div>
      <p class="font-medium text-foreground">Loading topic cluster intelligence…</p>
      <p class="text-[11px] text-muted-foreground mt-1">Aggregating cross-account Pinterest topic data</p>
    </div>

    <!-- Error State -->
    <div id="topics-error" class="hidden rounded-2xl border border-rose-500/30 bg-rose-500/10 p-6 text-center text-xs text-rose-500">
      <p id="topics-error-msg" class="font-bold">Failed to load topic clusters.</p>
    </div>

    <!-- ═══ MODE A: LIST VIEW (All Topic Clusters Table) ═══ -->
    <div id="topics-list-mode" class="hidden space-y-4">
      <!-- Filter Bar -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="flex flex-1 items-center gap-2.5">
          <div class="relative flex-1 max-w-sm">
            <input
              type="text"
              id="topics-search-input"
              placeholder="Search topic clusters..."
              class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-medium text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-primary pl-9"
            />
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-2.5 h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </div>
          <span id="topics-count-summary" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">0 clusters</span>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Min Pins Filter -->
          <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-xs">
            <label for="topics-min-pins-select" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">Min Pins:</label>
            <select id="topics-min-pins-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
              <option value="1" selected>1+ (All)</option>
              <option value="2">2+ Pins</option>
              <option value="3">3+ Pins</option>
              <option value="5">5+ Pins</option>
              <option value="10">10+ Pins</option>
            </select>
          </div>

          <!-- Sort Select -->
          <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5 shadow-xs">
            <label for="topics-sort-select" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">Sort:</label>
            <select id="topics-sort-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
              <option value="sum_saves" selected>Total Saves</option>
              <option value="pins">Pins Count</option>
              <option value="avg_saves">Saves per Pin</option>
              <option value="name">Name (A-Z)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-border bg-card shadow-xs">
        <table class="w-full text-left text-xs">
          <thead class="bg-muted/40 text-muted-foreground text-[11px] uppercase border-b border-border/80 font-semibold">
            <tr>
              <th class="py-3 px-4 font-semibold text-foreground">Topic Cluster</th>
              <th class="py-3 px-4 font-semibold text-right">Pins</th>
              <th class="py-3 px-4 font-semibold text-right">Total Saves</th>
              <th class="py-3 px-4 font-semibold text-right">Saves / Pin</th>
            </tr>
          </thead>
          <tbody id="topics-table-body" class="divide-y divide-border/60">
            <!-- Populated via JS -->
          </tbody>
        </table>
      </div>

      <!-- Pagination Container -->
      <div id="topics-pagination" class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <!-- Populated via JS -->
      </div>
    </div>

    <!-- ═══ MODE B: DETAIL VIEW (Single Topic Cluster Deep-Dive) ═══ -->
    <div id="topics-detail-mode" class="hidden space-y-6">
      <!-- 1. Header Row -->
      <div class="rounded-2xl border border-border bg-card p-5 shadow-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <a
              href="/pinarchive/topics"
              class="inline-flex items-center gap-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors"
            >
              <span>← All Clusters</span>
            </a>
            <span class="text-xs text-muted-foreground/60">•</span>
            <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20">
              <span>🏷️</span>
              <span>SEO Topic Cluster</span>
            </span>
          </div>
          <h2 id="topic-detail-title" class="text-xl sm:text-2xl font-bold tracking-tight text-foreground"></h2>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Account Filter (Detail) -->
          <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-3 py-1.5 shadow-xs">
            <span class="text-xs text-muted-foreground">👤</span>
            <label for="topic-detail-account-select" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">Account:</label>
            <select id="topic-detail-account-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer max-w-[160px] truncate">
              <option value="" selected>All Accounts</option>
            </select>
          </div>

          <!-- Board Filter (Detail) -->
          <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-3 py-1.5 shadow-xs">
            <span class="text-xs text-muted-foreground">📁</span>
            <label for="topic-detail-board-select" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">Board:</label>
            <select id="topic-detail-board-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer max-w-[160px] truncate">
              <option value="" selected>All Boards</option>
            </select>
          </div>

          <!-- Active Filter Reset Button -->
          <button
            id="detail-reset-filters-btn"
            type="button"
            class="hidden items-center gap-1 text-xs font-semibold text-rose-500 hover:text-rose-600 bg-rose-500/10 hover:bg-rose-500/20 px-2.5 py-1.5 rounded-xl border border-rose-500/20 transition-colors cursor-pointer"
            title="Reset filters to All Accounts and All Boards"
          >
            <span>✕ Reset Filter</span>
          </button>

          <a
            id="topic-pinterest-search-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl bg-primary text-primary-foreground px-3.5 py-2 text-xs font-bold shadow-xs hover:bg-primary/90 transition-all"
          >
            <span>Search on Pinterest</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </div>

      <!-- 2. Modern 6-Card KPI Stat Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <!-- Pins Tracked -->
        <div class="rounded-2xl border border-border bg-card p-4 shadow-xs hover:shadow-sm transition-all group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Pins Tracked</span>
            <div class="h-7 w-7 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center text-xs group-hover:scale-105 transition-transform">
              📌
            </div>
          </div>
          <div class="text-xl font-bold text-foreground tabular-nums" id="kpi-topic-pins">-</div>
        </div>

        <!-- Total Saves -->
        <div class="rounded-2xl border border-border bg-card p-4 shadow-xs hover:shadow-sm transition-all group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Total Saves</span>
            <div class="h-7 w-7 rounded-lg bg-rose-500/10 text-rose-500 flex items-center justify-center text-xs group-hover:scale-105 transition-transform">
              ❤️
            </div>
          </div>
          <div class="text-xl font-bold text-rose-500 tabular-nums" id="kpi-topic-saves">-</div>
        </div>

        <!-- Avg Saves / Pin -->
        <div class="rounded-2xl border border-border bg-card p-4 shadow-xs hover:shadow-sm transition-all group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Avg Saves/Pin</span>
            <div class="h-7 w-7 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xs group-hover:scale-105 transition-transform">
              📈
            </div>
          </div>
          <div class="text-xl font-bold text-emerald-500 tabular-nums" id="kpi-topic-avg-saves">-</div>
        </div>

        <!-- Median Saves -->
        <div class="rounded-2xl border border-border bg-card p-4 shadow-xs hover:shadow-sm transition-all group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Median Saves</span>
            <div class="h-7 w-7 rounded-lg bg-purple-500/10 text-purple-500 flex items-center justify-center text-xs group-hover:scale-105 transition-transform">
              🎯
            </div>
          </div>
          <div class="text-xl font-bold text-foreground tabular-nums" id="kpi-topic-median-saves">-</div>
        </div>

        <!-- Avg Velocity -->
        <div class="rounded-2xl border border-border bg-card p-4 shadow-xs hover:shadow-sm transition-all group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Avg Velocity</span>
            <div class="h-7 w-7 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center text-xs group-hover:scale-105 transition-transform">
              ⚡
            </div>
          </div>
          <div class="text-xl font-bold text-amber-500 tabular-nums" id="kpi-topic-velocity">-</div>
        </div>

        <!-- Total Repins -->
        <div class="rounded-2xl border border-border bg-card p-4 shadow-xs hover:shadow-sm transition-all group">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Total Repins</span>
            <div class="h-7 w-7 rounded-lg bg-blue-500/10 text-blue-500 flex items-center justify-center text-xs group-hover:scale-105 transition-transform">
              🔁
            </div>
          </div>
          <div class="text-xl font-bold text-blue-500 tabular-nums" id="kpi-topic-repins">-</div>
        </div>
      </div>

      <!-- 3. Interactive Lifecycle Stage Filter Bar -->
      <div class="rounded-2xl border border-border bg-card p-4 shadow-xs">
        <div class="flex items-center justify-between mb-2.5">
          <span class="text-xs font-bold text-foreground flex items-center gap-1.5">
            <span>📊</span>
            <span>Lifecycle Stage Distribution</span>
            <span class="text-[10px] text-muted-foreground font-normal">(click to filter pins)</span>
          </span>
        </div>
        <div id="topic-stages-container" class="flex flex-wrap items-center gap-2">
          <!-- Populated via JS -->
        </div>
      </div>

      <!-- 4. Two-Column Grid: Boards Breakdown | Accounts Breakdown -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <!-- Boards Breakdown -->
        <div class="rounded-2xl border border-border bg-card p-5 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
              <span>📁</span>
              <span>Top Boards</span>
            </h3>
            <span class="text-[10px] text-muted-foreground">Click board to filter</span>
          </div>
          <div id="topic-boards-list" class="divide-y divide-border/60 space-y-1">
            <!-- Populated via JS -->
          </div>
        </div>

        <!-- Accounts Breakdown -->
        <div class="rounded-2xl border border-border bg-card p-5 shadow-xs space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
              <span>👤</span>
              <span>Accounts Tracking This Topic</span>
            </h3>
            <span class="text-[10px] text-muted-foreground">Click account to filter</span>
          </div>
          <div id="topic-accounts-list" class="divide-y divide-border/60 space-y-1">
            <!-- Populated via JS -->
          </div>
        </div>
      </div>

      <!-- 5. Co-occurring Keywords Chips -->
      <div class="rounded-2xl border border-border bg-card p-5 shadow-xs space-y-3">
        <h3 class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
          <span>🧩</span>
          <span>Co-occurring Keywords</span>
          <span class="text-[10px] text-muted-foreground lowercase font-normal">(click to pivot cluster)</span>
        </h3>
        <div id="topic-cooccurring-container" class="flex flex-wrap items-center gap-2">
          <!-- Populated via JS -->
        </div>
      </div>

      <!-- 6. Top Pins Grid -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold text-foreground uppercase tracking-wider flex items-center gap-1.5">
            <span>📌</span>
            <span>Member Pins in Cluster</span>
          </h3>
          <span id="topic-pins-count-badge" class="text-xs font-semibold text-muted-foreground"></span>
        </div>
        <div id="topic-pins-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <!-- Populated via JS -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function renderStageBadge(stage?: string | null): string {
    switch (stage) {
      case 'NEW':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">🟢 NEW (≤14d)</span>';
      case 'GROWING':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">🚀 GROWING (≥10/d)</span>';
      case 'MATURE':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">🟣 MATURE (>14d)</span>';
      case 'COOLING':
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">❄️ COOLING (<2/d)</span>';
      default:
        return '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-slate-500/10 text-slate-500 border border-slate-500/20">⚪ DORMANT (<0.5/d)</span>';
    }
  }

  function renderAnomalyBadge(anomaly?: string | null): string {
    if (anomaly === 'SPIKE') {
      return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20 animate-pulse">🔥 SPIKE</span>';
    }
    if (anomaly === 'COOLING') {
      return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">❄️ COOLING</span>';
    }
    return '';
  }

  function renderSinglePinCard(p: any): string {
    const saves = Number(p.saves || 0);
    const repins = Number(p.repins || 0);
    const velocity = Number(p.velocity || 0);
    const shares = Number(p.share_count || 0);
    const annotations = Array.isArray(p.annotations) ? p.annotations : [];
    const category = p.seo_category || p.board_name || null;
    const pinterestUrl = `https://www.pinterest.com/pin/${p.pin_id}/`;
    const destinationUrl = p.link ? p.link : null;
    const imageUrl = p.image_url || '';
    const pinId = p.id || '';
    const createdDate = fmtDate(p.created_at_pinterest);

    const tagsHtml = annotations.slice(0, 3).map((a: any) => {
      const name = typeof a === 'string' ? a : a?.name || '';
      if (!name) return '';
      let targetUrl = '';
      if (typeof a === 'object' && a?.url) {
        targetUrl = `https://www.pinterest.com${a.url.startsWith('/') ? a.url : '/' + a.url}`;
      } else if (typeof a === 'object' && a?.idea_id) {
        targetUrl = `https://www.pinterest.com/ideas/${encodeURIComponent(name)}/${a.idea_id}/`;
      } else {
        targetUrl = `https://www.pinterest.com/search/pins/?q=${encodeURIComponent(name)}`;
      }

      return `
        <a
          href="${escapeHtml(targetUrl)}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[10px] bg-primary/10 hover:bg-primary/20 text-primary px-2 py-0.5 rounded-md font-medium truncate max-w-[120px] transition-colors"
          title="${escapeHtml(name)} (Pinterest Idea)"
        >
          <span class="truncate">${escapeHtml(name)}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      `;
    }).join('');

    const moreTagsCount = annotations.length > 3 ? annotations.length - 3 : 0;

    return `
      <div class="group rounded-2xl border border-border bg-card overflow-hidden shadow-xs hover:shadow-md hover:border-primary/40 transition-all flex flex-col justify-between relative">
        <div>
          <!-- Image preview -->
          <a href="/pinarchive/details?id=${encodeURIComponent(pinId)}" class="relative w-full h-44 bg-muted/50 overflow-hidden flex items-center justify-center block">
            ${imageUrl ? `
              <img
                src="${escapeHtml(imageUrl)}"
                alt="${escapeHtml(p.title || 'Pinterest Pin')}"
                loading="lazy"
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
              />
              <div class="hidden absolute inset-0 flex items-center justify-center text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            ` : `
              <div class="flex items-center justify-center text-muted-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
              </div>
            `}
            ${category ? `
              <span class="absolute top-2.5 left-2.5 text-[10px] font-bold bg-background/90 backdrop-blur-xs text-foreground px-2 py-0.5 rounded-md shadow-xs max-w-[140px] truncate" title="${escapeHtml(category)}">
                ${escapeHtml(category)}
              </span>
            ` : ''}
          </a>

          <!-- Content -->
          <div class="p-4 space-y-2.5">
            <div class="flex flex-wrap items-center gap-1.5">
              ${renderStageBadge(p.stage)}
              ${renderAnomalyBadge(p.anomaly)}
            </div>

            <div>
              <a href="/pinarchive/details?id=${encodeURIComponent(pinId)}" class="block group/link">
                <h3 class="text-xs font-bold text-foreground line-clamp-2 group-hover/link:text-primary transition-colors" title="${escapeHtml(p.title || 'Untitled Pin')}">
                  ${escapeHtml(p.title || `Pin ${p.pin_id}`)}
                </h3>
              </a>
              <div class="text-[10px] text-muted-foreground mt-1 flex items-center justify-between">
                <span>Created: <strong class="font-medium text-foreground">${createdDate}</strong></span>
                ${p.account_username ? `<span class="text-primary font-medium">@${escapeHtml(p.account_username)}</span>` : ''}
              </div>
            </div>

            <!-- Metrics Row (Full Numbers) -->
            <div class="grid grid-cols-3 gap-1.5 pt-1">
              <div class="bg-muted/40 rounded-xl p-2 text-center border border-border/40">
                <span class="text-[9px] text-muted-foreground uppercase block font-bold">Saves</span>
                <span class="text-xs font-bold text-rose-500 tabular-nums">${fmtNumber(saves)}</span>
              </div>
              <div class="bg-muted/40 rounded-xl p-2 text-center border border-border/40">
                <span class="text-[9px] text-muted-foreground uppercase block font-bold">Repins</span>
                <span class="text-xs font-bold text-foreground tabular-nums">${fmtNumber(repins)}</span>
              </div>
              <div class="bg-muted/40 rounded-xl p-2 text-center border border-border/40">
                <span class="text-[9px] text-muted-foreground uppercase block font-bold">Velocity</span>
                <span class="text-xs font-bold text-emerald-500 tabular-nums">${velocity.toFixed(1)}/d</span>
              </div>
            </div>

            <!-- Social & Tags -->
            ${shares > 0 ? `
              <div class="flex items-center gap-1 text-[10px] text-blue-500 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                <span>${fmtNumber(shares)} shares</span>
              </div>
            ` : ''}

            ${tagsHtml ? `
              <div class="flex flex-wrap items-center gap-1 pt-1">
                ${tagsHtml}
                ${moreTagsCount > 0 ? `<span class="text-[9px] text-muted-foreground font-semibold">+${moreTagsCount}</span>` : ''}
              </div>
            ` : ''}
          </div>
        </div>

        <!-- Footer link -->
        <div class="px-4 py-2.5 bg-muted/20 border-t border-border/60 flex items-center justify-between text-[11px] gap-2">
          <span class="text-muted-foreground text-[10px] truncate max-w-[110px]" title="${escapeHtml(p.board_name || '')}">${p.board_name ? escapeHtml(p.board_name) : ''}</span>
          <div class="flex items-center gap-2 shrink-0">
            ${destinationUrl ? `
              <a href="${escapeHtml(destinationUrl)}" target="_blank" rel="noopener noreferrer nofollow" class="text-[10px] font-medium text-muted-foreground hover:text-foreground hover:underline">
                Visit Site ↗
              </a>
            ` : ''}
            <a href="${escapeHtml(pinterestUrl)}" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:underline inline-flex items-center gap-1">
              <span>View</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>
      </div>
    `;
  }

  let clusterSearch = '';
  let clusterSort = 'sum_saves';
  let clusterMinPins = 1;
  let clusterPage = 1;
  const clusterPageSize = 50;

  let detailAccountId = '';
  let detailBoard = '';
  let detailStage = '';
  let cachedTopicName = '';
  let rawClusterData: any = null;
  let allClusterPins: any[] = [];

  function renderClusterPagination(total: number, currentPage: number, limit: number) {
    const paginationEl = document.getElementById('topics-pagination');
    if (!paginationEl) return;

    const totalPages = Math.max(1, Math.ceil(total / limit));
    if (totalPages <= 1) {
      paginationEl.innerHTML = `
        <span class="text-xs text-muted-foreground">Showing <strong>${total}</strong> clusters</span>
        <div></div>
      `;
      return;
    }

    const startItem = (currentPage - 1) * limit + 1;
    const endItem = Math.min(currentPage * limit, total);

    const pages: (number | string)[] = [];
    if (totalPages <= 7) {
      for (let i = 1; i <= totalPages; i++) pages.push(i);
    } else {
      pages.push(1);
      if (currentPage > 3) pages.push('…');
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      for (let i = start; i <= end; i++) {
        if (!pages.includes(i)) pages.push(i);
      }
      if (currentPage < totalPages - 2) pages.push('…');
      if (!pages.includes(totalPages)) pages.push(totalPages);
    }

    const buttonsHtml = pages.map((p) => {
      if (p === '…') return '<span class="px-2 py-1 text-xs text-muted-foreground">…</span>';
      const pageNum = Number(p);
      const isActive = pageNum === currentPage;
      return `
        <button
          type="button"
          data-topic-page="${pageNum}"
          class="min-w-[32px] h-8 px-2 rounded-lg text-xs font-bold transition-colors cursor-pointer ${
            isActive ? 'bg-primary text-primary-foreground shadow-xs' : 'border border-border bg-card text-foreground hover:bg-muted'
          }"
        >${pageNum}</button>
      `;
    }).join('');

    paginationEl.innerHTML = `
      <span class="text-xs text-muted-foreground">
        Showing <strong>${startItem}–${endItem}</strong> of <strong>${total}</strong> clusters
      </span>
      <div class="flex items-center gap-1">
        ${buttonsHtml}
      </div>
    `;

    paginationEl.querySelectorAll<HTMLButtonElement>('[data-topic-page]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const p = Number(btn.getAttribute('data-topic-page'));
        if (p && p !== clusterPage) {
          clusterPage = p;
          loadClusterList();
        }
      });
    });
  }

  async function loadClusterList(retries = 2) {
    const loadingEl = document.getElementById('topics-loading');
    const listModeEl = document.getElementById('topics-list-mode');
    const tbody = document.getElementById('topics-table-body');
    const errorEl = document.getElementById('topics-error');
    const errorMsg = document.getElementById('topics-error-msg');
    const countSummaryEl = document.getElementById('topics-count-summary');

    try {
      const params = new URLSearchParams({
        page: String(clusterPage),
        page_size: String(clusterPageSize),
        sort: clusterSort,
        min_pins: String(clusterMinPins),
      });
      if (clusterSearch) params.set('q', clusterSearch);

      const res = await fetch(`/api/pinarchive/topics?${params.toString()}`, { signal: AbortSignal.timeout(8000) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to fetch topic clusters');

      const topics = json.topics || [];
      const total = Number(json.total || 0);

      if (errorEl) errorEl.classList.add('hidden');
      if (loadingEl) loadingEl.classList.add('hidden');
      if (listModeEl) listModeEl.classList.remove('hidden');

      if (countSummaryEl) countSummaryEl.textContent = `${fmtNumber(total)} clusters`;

      if (tbody) {
        if (topics.length === 0) {
          tbody.innerHTML = `<tr><td colspan="4" class="p-8 text-center text-xs text-muted-foreground bg-muted/20">No topic clusters found.</td></tr>`;
          renderClusterPagination(0, 1, clusterPageSize);
          return;
        }

        tbody.innerHTML = topics.map((t: any) => {
          const savesPerPin = Number(t.avg_saves) || (t.pins > 0 ? Math.round(Number(t.sum_saves || 0) / t.pins) : 0);
          return `
            <tr
              class="hover:bg-muted/30 transition-colors cursor-pointer"
              data-topic="${encodeURIComponent(t.name)}"
            >
              <td class="py-3.5 px-4 font-bold text-foreground">
                <span class="inline-flex items-center gap-1.5 text-primary hover:underline">
                  <span>🏷️</span>
                  <span>${escapeHtml(t.name)}</span>
                </span>
              </td>
              <td class="py-3.5 px-4 text-right font-medium text-foreground tabular-nums">${fmtNumber(t.pins)}</td>
              <td class="py-3.5 px-4 text-right font-bold text-rose-500 tabular-nums">${fmtNumber(t.sum_saves)}</td>
              <td class="py-3.5 px-4 text-right font-medium text-emerald-500 tabular-nums">${fmtNumber(savesPerPin)}</td>
            </tr>
          `;
        }).join('');

        tbody.querySelectorAll<HTMLTableRowElement>('[data-topic]').forEach((row) => {
          row.addEventListener('click', () => {
            location.href = '/pinarchive/topics?name=' + row.getAttribute('data-topic');
          });
        });

        renderClusterPagination(total, clusterPage, clusterPageSize);
      }
    } catch (err: any) {
      if (retries > 0) {
        setTimeout(() => loadClusterList(retries - 1), 1500);
        return;
      }
      console.error('Error loading topic clusters:', err);
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) {
        errorEl.classList.remove('hidden');
        errorEl.innerHTML = `
          <p id="topics-error-msg" class="font-bold">Failed to load topic clusters: ${escapeHtml(err.message || 'Network error')}</p>
          <button id="retry-topics-list-btn" class="mt-2 text-xs font-bold underline cursor-pointer text-rose-500 hover:text-rose-600">Retry</button>
        `;
        document.getElementById('retry-topics-list-btn')?.addEventListener('click', () => {
          if (loadingEl) loadingEl.classList.remove('hidden');
          if (errorEl) errorEl.classList.add('hidden');
          loadClusterList(2);
        });
      }
    }
  }

  function renderFilteredClusterView() {
    if (!rawClusterData) return;

    let filteredPins = allClusterPins.filter((p) => {
      if (detailAccountId && p.account_id !== detailAccountId) return false;
      if (detailBoard && (p.board_name || 'General Board').trim() !== detailBoard) return false;
      if (detailStage && p.stage !== detailStage) return false;
      return true;
    });

    const pinsCount = filteredPins.length;
    let totalSaves = 0;
    let totalRepins = 0;
    let totalVelocity = 0;
    const savesList: number[] = [];
    const stagesCount: Record<string, number> = { NEW: 0, GROWING: 0, MATURE: 0, COOLING: 0, DORMANT: 0 };

    for (const p of filteredPins) {
      const s = Number(p.saves || 0);
      const r = Number(p.repins || 0);
      const v = Number(p.velocity || 0);
      totalSaves += s;
      totalRepins += r;
      totalVelocity += v;
      savesList.push(s);
      if (p.stage && p.stage in stagesCount) stagesCount[p.stage]++;
    }

    savesList.sort((a, b) => a - b);
    let medianSaves = 0;
    if (savesList.length > 0) {
      const mid = Math.floor(savesList.length / 2);
      medianSaves = savesList.length % 2 === 1 ? savesList[mid] : Math.round((savesList[mid - 1] + savesList[mid]) / 2);
    }

    const kpiPins = document.getElementById('kpi-topic-pins');
    if (kpiPins) kpiPins.textContent = fmtNumber(pinsCount);

    const kpiSaves = document.getElementById('kpi-topic-saves');
    if (kpiSaves) kpiSaves.textContent = fmtNumber(totalSaves);

    const kpiAvgSaves = document.getElementById('kpi-topic-avg-saves');
    if (kpiAvgSaves) kpiAvgSaves.textContent = fmtNumber(pinsCount > 0 ? Math.round(totalSaves / pinsCount) : 0);

    const kpiMedianSaves = document.getElementById('kpi-topic-median-saves');
    if (kpiMedianSaves) kpiMedianSaves.textContent = fmtNumber(medianSaves);

    const kpiVelocity = document.getElementById('kpi-topic-velocity');
    if (kpiVelocity) kpiVelocity.textContent = `${pinsCount > 0 ? (totalVelocity / pinsCount).toFixed(1) : '0.0'}/d`;

    const kpiRepins = document.getElementById('kpi-topic-repins');
    if (kpiRepins) kpiRepins.textContent = fmtNumber(totalRepins);

    const resetBtn = document.getElementById('detail-reset-filters-btn');
    if (resetBtn) {
      if (detailAccountId || detailBoard || detailStage) {
        resetBtn.classList.remove('hidden');
        resetBtn.classList.add('inline-flex');
      } else {
        resetBtn.classList.add('hidden');
        resetBtn.classList.remove('inline-flex');
      }
    }

    const stagesContainer = document.getElementById('topic-stages-container');
    if (stagesContainer) {
      const stageConfig = [
        { key: '', label: '⚡ ALL PINS', count: allClusterPins.length },
        { key: 'NEW', label: '🟢 NEW', count: stagesCount.NEW || 0, cls: 'bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/20' },
        { key: 'GROWING', label: '🚀 GROWING', count: stagesCount.GROWING || 0, cls: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20' },
        { key: 'MATURE', label: '🟣 MATURE', count: stagesCount.MATURE || 0, cls: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20' },
        { key: 'COOLING', label: '❄️ COOLING', count: stagesCount.COOLING || 0, cls: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20' },
        { key: 'DORMANT', label: '⚪ DORMANT', count: stagesCount.DORMANT || 0, cls: 'bg-slate-500/10 text-slate-500 border-slate-500/20' },
      ];

      stagesContainer.innerHTML = stageConfig.map((sc) => {
        const isSelected = detailStage === sc.key;
        return `
          <button
            type="button"
            data-stage-filter="${sc.key}"
            class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full border transition-all cursor-pointer ${
              isSelected ? 'bg-primary text-primary-foreground border-primary shadow-xs' : (sc.cls || 'bg-muted/40 text-muted-foreground border-border hover:bg-muted')
            }"
          >
            <span>${sc.label}:</span>
            <span class="tabular-nums">${fmtNumber(sc.count)}</span>
          </button>
        `;
      }).join('');

      stagesContainer.querySelectorAll<HTMLButtonElement>('[data-stage-filter]').forEach((btn) => {
        btn.addEventListener('click', () => {
          detailStage = btn.getAttribute('data-stage-filter') || '';
          renderFilteredClusterView();
        });
      });
    }

    const boardsList = document.getElementById('topic-boards-list');
    if (boardsList) {
      const boardTally = new Map<string, { name: string; pins: number; sum_saves: number }>();
      for (const p of filteredPins) {
        const bName = (p.board_name || 'General Board').trim();
        let bEntry = boardTally.get(bName);
        if (!bEntry) { bEntry = { name: bName, pins: 0, sum_saves: 0 }; boardTally.set(bName, bEntry); }
        bEntry.pins += 1;
        bEntry.sum_saves += Number(p.saves || 0);
      }
      const boards = Array.from(boardTally.values()).sort((a, b) => b.sum_saves - a.sum_saves).slice(0, 10);
      if (boards.length === 0) {
        boardsList.innerHTML = '<p class="text-xs text-muted-foreground py-2">No boards recorded</p>';
      } else {
        boardsList.innerHTML = boards.map((b) => {
          const isSelected = detailBoard === b.name;
          return `
            <div data-filter-board-item="${escapeHtml(b.name)}" class="flex items-center justify-between py-2 px-2 -mx-2 rounded-xl text-xs hover:bg-muted/50 transition-colors cursor-pointer group ${isSelected ? 'bg-primary/10 font-bold' : ''}">
              <span class="font-medium text-foreground truncate max-w-[200px] group-hover:text-primary transition-colors">${escapeHtml(b.name)}</span>
              <div class="flex items-center gap-3 text-right">
                <span class="text-muted-foreground">${fmtNumber(b.pins)} pins</span>
                <span class="font-bold text-rose-500 tabular-nums">${fmtNumber(b.sum_saves)} saves</span>
              </div>
            </div>
          `;
        }).join('');

        boardsList.querySelectorAll<HTMLDivElement>('[data-filter-board-item]').forEach((el) => {
          el.addEventListener('click', () => {
            const b = el.getAttribute('data-filter-board-item') || '';
            detailBoard = detailBoard === b ? '' : b;
            const bSelect = document.getElementById('topic-detail-board-select') as HTMLSelectElement | null;
            if (bSelect) bSelect.value = detailBoard;
            renderFilteredClusterView();
          });
        });
      }
    }

    const accountsList = document.getElementById('topic-accounts-list');
    if (accountsList) {
      const accountTally = new Map<string, { account_id: string; username: string; pins: number; sum_saves: number }>();
      for (const p of filteredPins) {
        const accId = p.account_id || '';
        const uname = p.account_username || 'unknown';
        let aEntry = accountTally.get(accId);
        if (!aEntry) { aEntry = { account_id: accId, username: uname, pins: 0, sum_saves: 0 }; accountTally.set(accId, aEntry); }
        aEntry.pins += 1;
        aEntry.sum_saves += Number(p.saves || 0);
      }
      const accounts = Array.from(accountTally.values()).sort((a, b) => b.sum_saves - a.sum_saves).slice(0, 10);
      if (accounts.length === 0) {
        accountsList.innerHTML = '<p class="text-xs text-muted-foreground py-2">No accounts recorded</p>';
      } else {
        accountsList.innerHTML = accounts.map((a) => {
          const isSelected = detailAccountId === a.account_id;
          return `
            <div data-filter-account-item="${escapeHtml(a.account_id)}" class="flex items-center justify-between py-2 px-2 -mx-2 rounded-xl text-xs hover:bg-muted/50 transition-colors cursor-pointer group ${isSelected ? 'bg-primary/10 font-bold' : ''}">
              <span class="font-bold text-foreground group-hover:text-primary transition-colors">@${escapeHtml(a.username)}</span>
              <div class="flex items-center gap-3 text-right">
                <span class="text-muted-foreground">${fmtNumber(a.pins)} pins</span>
                <span class="font-bold text-rose-500 tabular-nums">${fmtNumber(a.sum_saves)} saves</span>
              </div>
            </div>
          `;
        }).join('');

        accountsList.querySelectorAll<HTMLDivElement>('[data-filter-account-item]').forEach((el) => {
          el.addEventListener('click', () => {
            const accId = el.getAttribute('data-filter-account-item') || '';
            detailAccountId = detailAccountId === accId ? '' : accId;
            const aSelect = document.getElementById('topic-detail-account-select') as HTMLSelectElement | null;
            if (aSelect) aSelect.value = detailAccountId;
            renderFilteredClusterView();
          });
        });
      }
    }

    const pinsGrid = document.getElementById('topic-pins-grid');
    const pinsCountBadge = document.getElementById('topic-pins-count-badge');
    if (pinsCountBadge) pinsCountBadge.textContent = `${fmtNumber(filteredPins.length)} pin${filteredPins.length === 1 ? '' : 's'}`;

    if (pinsGrid) {
      if (filteredPins.length === 0) {
        pinsGrid.innerHTML = '<div class="col-span-full py-12 text-center text-xs text-muted-foreground bg-muted/20 rounded-2xl">No pins match the selected filters.</div>';
      } else {
        pinsGrid.innerHTML = filteredPins.map((p) => renderSinglePinCard(p)).join('');
      }
    }
  }

  async function loadClusterDetail(name: string, retries = 2) {
    cachedTopicName = name;
    const loadingEl = document.getElementById('topics-loading');
    const detailModeEl = document.getElementById('topics-detail-mode');
    const errorEl = document.getElementById('topics-error');
    const errorMsg = document.getElementById('topics-error-msg');

    try {
      const res = await fetch(`/api/pinarchive/topic-detail?name=${encodeURIComponent(name)}`, { signal: AbortSignal.timeout(8000) });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to fetch topic details');

      rawClusterData = json;
      allClusterPins = json.pins || json.top_pins || [];

      if (errorEl) errorEl.classList.add('hidden');
      if (loadingEl) loadingEl.classList.add('hidden');
      if (detailModeEl) detailModeEl.classList.remove('hidden');

      const titleEl = document.getElementById('topic-detail-title');
      if (titleEl) titleEl.textContent = json.topic || name;

      const pinterestLink = document.getElementById('topic-pinterest-search-link') as HTMLAnchorElement | null;
      if (pinterestLink) pinterestLink.href = `https://www.pinterest.com/search/pins/?q=${encodeURIComponent(name)}`;

      const accSelect = document.getElementById('topic-detail-account-select') as HTMLSelectElement | null;
      if (accSelect) {
        const accounts = json.all_accounts || json.accounts || [];
        accSelect.innerHTML = '<option value="">All Accounts</option>' + accounts.map((a: any) => `
          <option value="${escapeHtml(a.account_id || a.id)}" ${detailAccountId === (a.account_id || a.id) ? 'selected' : ''}>
            @${escapeHtml(a.username || 'unknown')} (${fmtNumber(a.pins)})
          </option>
        `).join('');
      }

      const boardSelect = document.getElementById('topic-detail-board-select') as HTMLSelectElement | null;
      if (boardSelect) {
        const boards = json.all_boards || json.boards || [];
        boardSelect.innerHTML = '<option value="">All Boards</option>' + boards.map((b: any) => `
          <option value="${escapeHtml(b.name)}" ${detailBoard === b.name ? 'selected' : ''}>
            ${escapeHtml(b.name)} (${fmtNumber(b.pins)})
          </option>
        `).join('');
      }

      const cooccContainer = document.getElementById('topic-cooccurring-container');
      if (cooccContainer) {
        const cooccurring = json.cooccurring || [];
        if (cooccurring.length === 0) {
          cooccContainer.innerHTML = '<p class="text-xs text-muted-foreground">No co-occurring keywords recorded for this cluster.</p>';
        } else {
          cooccContainer.innerHTML = cooccurring.map((c: any) => `
            <a href="/pinarchive/topics?name=${encodeURIComponent(c.name)}" class="inline-flex items-center gap-1.5 text-xs bg-muted/60 hover:bg-primary/10 hover:text-primary text-foreground px-3 py-1.5 rounded-xl border border-border transition-all">
              <span>🏷️</span>
              <span class="font-semibold">${escapeHtml(c.name)}</span>
              <span class="text-[10px] text-muted-foreground font-mono">(${fmtNumber(c.pins)})</span>
            </a>
          `).join('');
        }
      }

      renderFilteredClusterView();
    } catch (err: any) {
      if (retries > 0) {
        setTimeout(() => loadClusterDetail(name, retries - 1), 1500);
        return;
      }
      console.error('Error loading topic cluster detail:', err);
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) {
        errorEl.classList.remove('hidden');
        errorEl.innerHTML = `
          <p id="topics-error-msg" class="font-bold">Failed to load topic cluster detail: ${escapeHtml(err.message || 'Network error')}</p>
          <button id="retry-topic-detail-btn" class="mt-2 text-xs font-bold underline cursor-pointer text-rose-500 hover:text-rose-600">Retry</button>
        `;
        document.getElementById('retry-topic-detail-btn')?.addEventListener('click', () => {
          if (loadingEl) loadingEl.classList.remove('hidden');
          if (errorEl) errorEl.classList.add('hidden');
          loadClusterDetail(name, 2);
        });
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const topicName = new URLSearchParams(window.location.search).get('name')?.trim();
    if (topicName) {
      loadClusterDetail(topicName);

      const detailAccSelect = document.getElementById('topic-detail-account-select') as HTMLSelectElement | null;
      if (detailAccSelect) {
        detailAccSelect.addEventListener('change', () => {
          detailAccountId = detailAccSelect.value;
          renderFilteredClusterView();
        });
      }

      const detailBoardSelect = document.getElementById('topic-detail-board-select') as HTMLSelectElement | null;
      if (detailBoardSelect) {
        detailBoardSelect.addEventListener('change', () => {
          detailBoard = detailBoardSelect.value;
          renderFilteredClusterView();
        });
      }

      const resetBtn = document.getElementById('detail-reset-filters-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          detailAccountId = '';
          detailBoard = '';
          detailStage = '';
          if (detailAccSelect) detailAccSelect.value = '';
          if (detailBoardSelect) detailBoardSelect.value = '';
          renderFilteredClusterView();
        });
      }
    } else {
      loadClusterList();
      const searchInput = document.getElementById('topics-search-input') as HTMLInputElement | null;
      if (searchInput) {
        let debounceTimer: ReturnType<typeof setTimeout> | null = null;
        searchInput.addEventListener('input', () => {
          if (debounceTimer) clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            clusterSearch = searchInput.value.trim();
            clusterPage = 1;
            loadClusterList();
          }, 300);
        });
      }
      const sortSelect = document.getElementById('topics-sort-select') as HTMLSelectElement | null;
      if (sortSelect) {
        sortSelect.addEventListener('change', () => {
          clusterSort = sortSelect.value;
          clusterPage = 1;
          loadClusterList();
        });
      }
      const minPinsSelect = document.getElementById('topics-min-pins-select') as HTMLSelectElement | null;
      if (minPinsSelect) {
        minPinsSelect.addEventListener('change', () => {
          clusterMinPins = parseInt(minPinsSelect.value, 10) || 1;
          clusterPage = 1;
          loadClusterList();
        });
      }
    }

    const refreshBtn = document.getElementById('refresh-topics-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const currentName = new URLSearchParams(window.location.search).get('name')?.trim() || cachedTopicName;
        if (currentName) loadClusterDetail(currentName);
        else loadClusterList();
      });
    }
  });
</script>
