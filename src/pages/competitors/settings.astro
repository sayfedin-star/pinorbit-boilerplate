---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProviderBadge from '../../components/cron/ProviderBadge.astro';
import RunNowButton from '../../components/cron/RunNowButton.astro';
import { humanCron, humanCronTitle } from '../../lib/cron-helper';
import { dbClients } from '../../server/db/clients';
import { getWorkspaces } from '../../lib/workspaces';

const workspaceId = Astro.locals.activeWorkspaceId || '';
const runtimeEnv = (Astro.locals as any)?.runtime?.env || (Astro.locals as any)?.runtimeEnv;
const workspaces = await getWorkspaces(Astro.cookies, Astro.request, Astro.response?.headers);
const currentWorkspace = workspaces.find((w) => w.id === workspaceId) || workspaces[0];
const isMasterWorkspace = Boolean(currentWorkspace?.is_master);

let competitor_pipeline_settings: { cron_expression?: string | null } | null = null;
if (workspaceId) {
  try {
    const compClient = dbClients.getCompetitors(runtimeEnv);
    const { data } = await compClient
      .from('competitor_pipeline_settings')
      .select('cron_expression')
      .eq('workspace_id', workspaceId)
      .maybeSingle();
    competitor_pipeline_settings = data;
  } catch (e) {
    console.warn('[competitors/settings] Error fetching pipeline settings:', e);
  }
}

const rawExpr = competitor_pipeline_settings?.cron_expression || null;
const cronExpr = rawExpr || '—';
const cronTitle = rawExpr ? humanCronTitle(rawExpr) : 'No schedule yet';
const cronDesc = rawExpr ? humanCron(rawExpr) : 'Create a schedule via Configure Schedule';
---

<Layout title="Competitor Intelligence Settings" description="Closed-loop control plane for Pinterest competitor ingestion, credential vault, pipeline schedules, and live job auditing.">
  <div id="competitors-settings-root" data-workspace-id={workspaceId} data-is-master={isMasterWorkspace ? 'true' : 'false'} class="space-y-6 max-w-7xl mx-auto pb-12">

  <!-- ═══ Navigation & Top Header ═══ -->
  <div class="space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <a href="/competitors" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back to Competitors</span>
      </a>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2">
        <button
          id="btn-toggle-all-collapse"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-muted transition-all shadow-xs cursor-pointer"
          title="Expand or collapse all console sections"
        >
          <svg id="collapse-all-icon" class="h-3.5 w-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          <span id="collapse-all-text">Collapse All</span>
        </button>

        <button
          id="refresh-all-btn"
          title="Refresh all console state"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-muted transition-all shadow-xs cursor-pointer"
        >
          <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
          <span>Refresh</span>
        </button>
      </div>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <SectionHeader
        title="Competitor Operations Console"
        description="Unified management for Pinterest ingestion schedules, credential vault, pipeline parameters, and background sync jobs."
      />
    </div>

    <!-- ═══ Quick Anchor Navigation Pills ═══ -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs no-scrollbar">
      <a href="#sec-schedules" class="inline-flex items-center gap-1.5 shrink-0 px-3 py-1.5 rounded-xl border border-border/80 bg-card hover:bg-muted font-medium text-foreground transition-colors shadow-2xs">
        <span>⚡</span><span>Schedules</span>
        <span id="nav-schedules-badge" class="rounded-full bg-primary/10 text-primary px-1.5 py-0.2 text-[10px] font-bold">1</span>
      </a>
      <a href="#sec-pipeline" class="inline-flex items-center gap-1.5 shrink-0 px-3 py-1.5 rounded-xl border border-border/80 bg-card hover:bg-muted font-medium text-foreground transition-colors shadow-2xs">
        <span>⚙️</span><span>Pipeline</span>
        <span id="nav-pipeline-badge" class="rounded-full bg-emerald-500/10 text-emerald-500 px-1.5 py-0.2 text-[10px] font-bold">Active</span>
      </a>
      <a href="#sec-vault" class="inline-flex items-center gap-1.5 shrink-0 px-3 py-1.5 rounded-xl border border-border/80 bg-card hover:bg-muted font-medium text-foreground transition-colors shadow-2xs">
        <span>🔐</span><span>Vault</span>
        <span id="nav-vault-badge" class="rounded-full bg-muted text-muted-foreground px-1.5 py-0.2 text-[10px] font-bold">1</span>
      </a>
      <a href="#sec-matrix" class="inline-flex items-center gap-1.5 shrink-0 px-3 py-1.5 rounded-xl border border-border/80 bg-card hover:bg-muted font-medium text-foreground transition-colors shadow-2xs">
        <span>🎯</span><span>Matrix</span>
        <span id="nav-matrix-badge" class="rounded-full bg-primary/10 text-primary px-1.5 py-0.2 text-[10px] font-bold">3</span>
      </a>
      <a href="#sec-jobs" class="inline-flex items-center gap-1.5 shrink-0 px-3 py-1.5 rounded-xl border border-border/80 bg-card hover:bg-muted font-medium text-foreground transition-colors shadow-2xs">
        <span>📋</span><span>Audit Logs</span>
        <span id="nav-jobs-badge" class="rounded-full bg-muted text-muted-foreground px-1.5 py-0.2 text-[10px] font-bold">15</span>
      </a>
    </div>
  </div>

  {isMasterWorkspace && (
    <!-- ═══ 👑 Master Workspace (Global Orchestrator) Banner ═══ -->
    <div class="rounded-2xl border border-amber-500/30 bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 shadow-xs">
      <div class="flex items-center gap-3.5">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xl shadow-2xs">
          👑
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-foreground">Master Workspace (Global Competitor Orchestrator)</h3>
            <span class="rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 text-[10px] font-bold">ALL-WORKSPACES MODE</span>
          </div>
          <p class="text-xs text-muted-foreground mt-0.5">
            This workspace acts as the central orchestrator. Competitor sync pipelines and FastCron schedules configured here run across <strong>all active workspaces</strong> simultaneously.
          </p>
        </div>
      </div>
    </div>
  )}

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ═══ SECTION 0: FastCron API Tokens & Provider ═══ -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div id="sec-tokens-provider" class="collapsible-card rounded-2xl border border-border bg-card shadow-sm transition-all overflow-hidden">
    <div class="collapsible-header flex items-center justify-between p-5 cursor-pointer select-none hover:bg-muted/30 transition-colors border-b border-border/60" data-target="body-tokens-provider">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20">
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-bold text-foreground">FastCron API Tokens &amp; Orchestration Engine</h2>
            <span id="token-status-msg" class="text-emerald-500 font-semibold text-[11px]">✓ Connection healthy</span>
          </div>
          <p class="text-xs text-muted-foreground">Workspace token vault registry and isolated webhook dispatch routing.</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button
          id="btn-add-token"
          type="button"
          onclick="event.stopPropagation()"
          class="inline-flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded-xl bg-primary text-primary-foreground hover:bg-primary/90 transition-all shadow-xs cursor-pointer"
        >
          + Add Token
        </button>
        <div class="chevron-icon h-7 w-7 rounded-lg flex items-center justify-center text-muted-foreground hover:bg-muted transition-transform duration-200">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
      </div>
    </div>

    <div id="body-tokens-provider" class="collapsible-body p-5 space-y-4">
      <div class="flex flex-col lg:flex-row gap-5">
        <!-- Left: FastCron API Tokens (45%) -->
        <div class="lg:w-[45%] rounded-xl border border-border bg-background/60 p-4 space-y-3">
          <div class="flex items-center justify-between border-b border-border/60 pb-2.5">
            <span class="text-xs font-bold text-foreground">Registered API Tokens</span>
            <button id="btn-ping-tokens" type="button" class="text-[11px] font-semibold text-primary hover:underline cursor-pointer">Test Connection</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead>
                <tr class="text-left border-b border-border text-muted-foreground text-[10px] font-bold">
                  <th class="py-2 px-2">NAME</th>
                  <th class="py-2 px-2">KEY</th>
                  <th class="py-2 px-2">STATUS</th>
                  <th class="py-2 px-2 text-right">ACTION</th>
                </tr>
              </thead>
              <tbody id="tokens-table-rows" class="divide-y divide-border/60">
                <tr><td colspan="4" class="p-3 text-center text-muted-foreground">Loading tokens…</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Right: Global Cron Engine (55%) -->
        <div class="lg:w-[55%] rounded-xl border border-border bg-background/60 p-4 flex flex-col justify-between space-y-3">
          <div class="space-y-2">
            <div class="flex items-center justify-between border-b border-border/60 pb-2.5">
              <span class="text-xs font-bold text-foreground">Global Cron Engine &amp; Dispatch Routing</span>
              <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">● FastCron Active</span>
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed">
              PinOrbit triggers background scraping workers using stateless cron dispatches. Each schedule emits an authenticated payload to the internal ingestion endpoint (<code class="font-mono text-foreground text-[11px]">/api/internal/competitors/dispatch</code>) with an encrypted webhook secret token.
            </p>
          </div>
          <div class="flex items-center justify-between text-xs pt-2 border-t border-border/60">
            <span class="inline-flex items-center gap-1.5 text-muted-foreground text-[11px]">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Encrypted AES-GCM vault security active
            </span>
            <a href="/settings/workspace" class="font-semibold text-primary hover:underline text-[11px]">Settings &gt; Workspace &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ═══ SECTION 1: Posting Schedules & Automation ═══ -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div id="sec-schedules" class="collapsible-card rounded-2xl border border-border bg-card shadow-sm transition-all overflow-hidden">
    <div class="collapsible-header flex items-center justify-between p-5 cursor-pointer select-none hover:bg-muted/30 transition-colors border-b border-border/60" data-target="body-schedules">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-pink-500/10 text-pink-500 border border-pink-500/20">
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-bold text-foreground">Posting Schedules &amp; Automation</h2>
            <span id="comp-cron-global-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">Active Multi-Schedule</span>
          </div>
          <p class="text-xs text-muted-foreground">Manage multi-schedule competitor scraping, profile metrics refresh, and change detection.</p>
        </div>
      </div>

      <div class="flex items-center gap-2" onclick="event.stopPropagation()">
        <!-- Run Now Button with Dual Scope Selector -->
        <RunNowButton
          endpoint="/api/internal/competitors/dispatch"
          payload={{ workspace_id: workspaceId, pipeline: "competitors" }}
          label={isMasterWorkspace ? 'Run All Workspaces' : 'Run Now'}
          forceLabel="⚡ Force Run"
          scope="competitors"
          isMaster={isMasterWorkspace}
          currentWsName={currentWorkspace?.name || 'Hymum'}
        />

        <button
          id="btn-add-competitor-schedule"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3 py-2 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary/90 transition-all cursor-pointer"
        >
          <span>+ New Schedule</span>
        </button>

        <div class="relative inline-block text-left" id="comp-batch-dropdown-container">
          <button
            type="button"
            id="btn-comp-batch"
            class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-xs cursor-pointer"
          >
            <span>Batch</span>
            <span id="comp-batch-sel-count" class="hidden rounded-full bg-primary/20 text-primary px-1.5 py-0.2 text-[10px] font-bold">0</span>
            <svg class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="comp-sched-batch-menu" class="hidden absolute right-0 mt-1 w-56 rounded-2xl border border-border bg-card shadow-xl z-50 py-1 text-xs divide-y divide-border/80">
            <div class="p-1">
              <button type="button" id="comp-batch-act-select-all" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-foreground cursor-pointer rounded-lg">
                <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span>Select All</span>
              </button>
            </div>
            <div class="p-1 space-y-0.5">
              <button type="button" id="comp-batch-act-run" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-primary font-semibold cursor-pointer rounded-lg">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <span>Run Now</span>
              </button>
              <button type="button" id="comp-batch-act-enable" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-emerald-600 dark:text-emerald-400 cursor-pointer rounded-lg">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                <span>Enable Selected</span>
              </button>
              <button type="button" id="comp-batch-act-disable" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-amber-600 dark:text-amber-400 cursor-pointer rounded-lg">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                <span>Disable Selected</span>
              </button>
            </div>
            <div class="p-1 space-y-0.5">
              <button type="button" id="comp-batch-act-export" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-muted-foreground hover:text-foreground cursor-pointer rounded-lg">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Export JSON</span>
              </button>
              <button type="button" id="comp-batch-act-delete" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-rose-500 font-semibold cursor-pointer rounded-lg">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                <span>Delete Selected</span>
              </button>
            </div>
          </div>
        </div>

        <button
          id="btn-comp-sync-missing"
          type="button"
          class="inline-flex items-center gap-1 rounded-xl border border-border bg-card px-2.5 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-muted transition-all shadow-xs cursor-pointer"
          title="Auto-create and sync missing default schedules"
        >
          Sync Missing
        </button>

        <button
          id="btn-comp-refresh-schedules"
          type="button"
          class="inline-flex items-center justify-center rounded-xl border border-border bg-card p-2 text-muted-foreground hover:text-foreground hover:bg-muted transition-all shadow-xs cursor-pointer"
          title="Refresh schedule telemetry"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
        </button>

        <div class="chevron-icon h-7 w-7 rounded-lg flex items-center justify-center text-muted-foreground hover:bg-muted transition-transform duration-200 cursor-pointer" onclick="this.closest('.collapsible-header').click()">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
      </div>
    </div>

    <div id="body-schedules" class="collapsible-body p-5 space-y-4">
      <!-- Pacing Cadence Banner -->
      <div id="comp-sched-pace-box" class="rounded-xl border border-border/80 bg-background/50 p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="text-amber-500">⚡</span>
          <span class="font-bold text-muted-foreground">Automation Cadence:</span>
          <span id="comp-sched-pace-val" class="font-semibold text-foreground">1 Active Schedule · ~7 Runs / Week</span>
        </div>
        <div class="text-[11px] text-muted-foreground" id="comp-sched-pace-desc">
          Schedules synchronized with FastCron (1 token in vault).
        </div>
      </div>

      <!-- Schedules Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left" id="competitor-schedules-table">
          <thead>
            <tr class="border-b border-border text-muted-foreground text-[10px] font-bold">
              <th class="p-3 w-8">
                <input type="checkbox" id="comp-sched-select-all" class="h-3.5 w-3.5 rounded border-border text-primary cursor-pointer" />
              </th>
              <th class="p-3">SCHEDULE &amp; STATUS</th>
              <th class="p-3">SCHEDULE &amp; CADENCE</th>
              <th class="p-3">NEXT RUN</th>
              <th class="p-3">LAST RUN</th>
              <th class="p-3">FASTCRON TOKEN</th>
              <th class="p-3 text-right">ACTIONS</th>
            </tr>
          </thead>
          <tbody id="competitor-schedules-rows" class="divide-y divide-border/60">
            <tr><td colspan="7" class="p-6 text-center text-muted-foreground">Loading schedules…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- ═══ SECTION 2: Pipeline Ingestion Controls ═══ -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <div id="sec-pipeline" class="collapsible-card rounded-2xl border border-border bg-card shadow-sm transition-all overflow-hidden">
    <div class="collapsible-header flex items-center justify-between p-5 cursor-pointer select-none hover:bg-muted/30 transition-colors border-b border-border/60" data-target="body-pipeline">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-purple-500/10 text-purple-500 border border-purple-500/20">
