  function renderJobs(jobs: any[]) {
    const tbody = $('jobs-table-body');
    if (!jobs || jobs.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-muted-foreground">No recent ingestion jobs recorded.</td></tr>`;
      return;
    }

    const badgeStyle: Record<string, string> = {
      queued: 'bg-blue-500/10 text-blue-500 border-blue-500/30',
      running: 'bg-amber-500/10 text-amber-500 border-amber-500/30 animate-pulse',
      completed: 'bg-emerald-500/10 text-emerald-500 border-emerald-500/30',
      failed: 'bg-rose-500/10 text-rose-500 border-rose-500/30',
    };

    tbody.innerHTML = jobs.map((j: any) => {
      const shortId = j.id ? `job-${j.id.slice(0, 8)}` : '—';
      const target = j.competitor_id ? `Targeted (${j.competitor_id.slice(0, 8)}…)` : 'All Active Profiles';
      const statusCls = badgeStyle[j.status] || 'bg-muted text-muted-foreground';
      const processed = j.items_processed ?? 0;
      const started = j.started_at ? timeAgo(j.started_at) : (j.created_at ? timeAgo(j.created_at) : '—');
      const completed = j.completed_at ? timeAgo(j.completed_at) : (j.status === 'running' ? 'In Progress…' : '—');
      const err = j.error_message ? `<span class="text-rose-500 text-[10px] truncate max-w-xs block" title="${escHtml(j.error_message)}">⚠️ ${escHtml(j.error_message)}</span>` : '<span class="text-muted-foreground text-[10px]">None</span>';

      return `<tr class="hover:bg-muted/30 transition-colors">
        <td class="py-3 px-4 font-mono font-bold text-foreground text-[11px]">${escHtml(shortId)}</td>
        <td class="py-3 px-4 text-[11px] font-medium text-foreground">${escHtml(target)}</td>
        <td class="py-3 px-4">
          <span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-bold ${statusCls}">
            ${escHtml(j.status)}
          </span>
        </td>
        <td class="py-3 px-4 text-[11px] font-semibold text-foreground">${processed}</td>
        <td class="py-3 px-4 text-[11px]">${escHtml(started)}</td>
        <td class="py-3 px-4 text-[11px]">${escHtml(completed)}</td>
        <td class="py-3 px-4">${err}</td>
      </tr>`;
    }).join('');
  }

  // ─── Data Loading ─────────────────────────────────────────────────────────
  async function loadAllState() {
    try {
      const [opsData, cookiesData] = await Promise.all([
        fetchAPI('/api/admin/competitor-ops'),
        fetchAPI('/api/admin/pinterest-cookies'),
        loadTokens(),
      ]);

      if (opsData.success) {
        const kekBadge = $('kek-badge');
        if (opsData.kekActive) {
          kekBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500';
          kekBadge.textContent = '🔑 KEK active';
        } else {
          kekBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground';
          kekBadge.textContent = '🔑 KEK —';
        }
        renderPipelineSettings(opsData.settings);
        renderCompetitorsMatrix(opsData.competitors);
        renderJobs(opsData.jobs);
      }
      if (cookiesData.success) {
        renderCookies(cookiesData.cookies);
      }
    } catch (err: any) {
      toast(`Failed to load console state: ${err.message}`, 'error');
    }
  }

  // ─── Event Handlers ───────────────────────────────────────────────────────
  // 1. Refresh All
  $('refresh-all-btn').addEventListener('click', async () => {
    $('refresh-icon').classList.add('animate-spin');
    await loadAllState();
    setTimeout(() => $('refresh-icon').classList.remove('animate-spin'), 400);
    toast('Operations state refreshed', 'info');
  });

  // 2. Pipeline Settings Form Submit
  $('pipeline-settings-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const is_enabled = ( $('pipe-is-enabled') as HTMLInputElement ).checked;
    const dry_run = ( $('pipe-dry-run') as HTMLInputElement ).checked;
    const max_retries = Number(( $('pipe-max-retries') as HTMLInputElement ).value || 3);

    try {
      const res = await fetchAPI('/api/admin/competitor-ops', {
        method: 'PUT',
        body: JSON.stringify({ is_enabled, dry_run, max_retries }),
      });
      if (res.success) {
        renderPipelineSettings(res.settings);
        toast('Pipeline settings updated successfully', 'success');
      }
    } catch (err: any) {
      toast(`Update failed: ${err.message}`, 'error');
    }
  });

  let activePollingInterval: any = null;

  function pollJobStatus(jobId: string) {
    if (activePollingInterval) clearInterval(activePollingInterval);

    const startTime = Date.now();
    activePollingInterval = setInterval(async () => {
      try {
        const res = await fetchAPI(`/api/admin/competitor-ops?job_id=${jobId}`);
        if (res.job) {
          const { status, items_processed = 0, error_message } = res.job;
          if (status === 'completed') {
            clearInterval(activePollingInterval);
            activePollingInterval = null;
            toast(`✅ Scraping complete! ${items_processed} profile(s) updated`, 'success');
            loadAllState();
          } else if (status === 'failed') {
            clearInterval(activePollingInterval);
            activePollingInterval = null;
            toast(`❌ Scraping failed: ${error_message || 'Workflow error'}`, 'error');
            loadAllState();
          }
        }
        if (Date.now() - startTime > 300000) {
          clearInterval(activePollingInterval);
          activePollingInterval = null;
        }
      } catch {
        // network retry
      }
    }, 2000);
  }

  // 3. Run Full Update Now
  $('btn-run-full-update').addEventListener('click', async () => {
    try {
      const res = await fetchAPI('/api/admin/competitor-ops', {
        method: 'POST',
        body: JSON.stringify({ scope: 'all' }),
      });
      if (res.job_id) {
        toast(`🚀 Workflow dispatched (#${res.job_id.slice(0, 8)}) — scraping in progress...`, 'success');
        pollJobStatus(res.job_id);
      } else {
        toast('Full update dispatched', 'success');
      }
      loadAllState();
    } catch (err: any) {
      toast(`Dispatch failed: ${err.message}`, 'error');
    }
  });

  // 4. Modal: Add Cookie
  $('open-add-cookie-modal').addEventListener('click', () => {
    $('add-cookie-error').classList.add('hidden');
    ( $('cookie-value-input') as HTMLTextAreaElement ).value = '';
    ( $('cookie-expires-input') as HTMLInputElement ).value = '';
    showModal($('add-cookie-modal'));
  });

  $('add-cookie-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const cookie_value = ( $('cookie-value-input') as HTMLTextAreaElement ).value.trim();
    const expires_at = ( $('cookie-expires-input') as HTMLInputElement ).value || null;

    if (cookie_value.length < 20) {
      $('add-cookie-error').textContent = 'Cookie string must be at least 20 characters.';
      $('add-cookie-error').classList.remove('hidden');
      return;
    }

    try {
      const res = await fetchAPI('/api/admin/pinterest-cookies', {
        method: 'POST',
        body: JSON.stringify({ cookie_value, expires_at }),
      });
      if (res.success) {
        hideModal($('add-cookie-modal'));
        toast('Cookie stored and encrypted in vault', 'success');
        loadAllState();
      }
    } catch (err: any) {
      $('add-cookie-error').textContent = err.message;
      $('add-cookie-error').classList.remove('hidden');
    }
  });

  // 5. Event Delegation for Interactive Tables
  document.addEventListener('change', async (e) => {
    const target = e.target as HTMLElement;

    // Cookie active toggle
    if (target.classList.contains('ck-toggle')) {
      const id = target.dataset.id;
      const is_active = (target as HTMLInputElement).checked;
      try {
        await fetchAPI('/api/admin/pinterest-cookies', {
          method: 'PATCH',
          body: JSON.stringify({ id, is_active }),
        });
        toast(`Cookie status updated`, 'success');
      } catch (err: any) {
        toast(`Failed to toggle cookie: ${err.message}`, 'error');
        (target as HTMLInputElement).checked = !is_active;
      }
    }

    // Competitor active toggle
    if (target.classList.contains('comp-active')) {
      const competitor_id = target.dataset.id;
      const is_active = (target as HTMLInputElement).checked;
      try {
        await fetchAPI('/api/admin/competitor-ops', {
          method: 'PATCH',
          body: JSON.stringify({ competitor_id, is_active }),
        });
        toast(`Competitor status updated`, 'success');
      } catch (err: any) {
        toast(`Failed to update competitor: ${err.message}`, 'error');
        (target as HTMLInputElement).checked = !is_active;
      }
    }

    // Competitor frequency change
    if (target.classList.contains('comp-freq')) {
      const competitor_id = target.dataset.id;
      const update_frequency_hours = Number((target as HTMLInputElement).value || 24);
      try {
        await fetchAPI('/api/admin/competitor-ops', {
          method: 'PATCH',
          body: JSON.stringify({ competitor_id, update_frequency_hours }),
        });
        toast(`Update cadence updated to ${update_frequency_hours}h`, 'success');
      } catch (err: any) {
        toast(`Failed to update cadence: ${err.message}`, 'error');
      }
    }
  });

  document.addEventListener('click', async (e) => {
    const target = (e.target as HTMLElement).closest('button');
    if (!target) return;

    // Delete Cookie
    if (target.classList.contains('ck-del')) {
      const id = target.dataset.id;
      if (!confirm('Are you sure you want to remove this credential from the vault?')) return;
      try {
        await fetchAPI('/api/admin/pinterest-cookies', {
          method: 'DELETE',
          body: JSON.stringify({ id }),
        });
        toast('Cookie removed from vault', 'info');
        loadAllState();
      } catch (err: any) {
        toast(`Failed to delete: ${err.message}`, 'error');
      }
    }

    // Delete FastCron Token
    if (target.classList.contains('token-del')) {
      const id = target.dataset.tokenId;
      if (!id || !confirm('Are you sure you want to delete this API token from the vault?')) return;
      try {
        await fetchAPI(`/api/competitors/tokens/${id}`, {
          method: 'DELETE',
        });
        toast('Token removed from vault', 'info');
        await loadTokens();
      } catch (err: any) {
        toast(`Failed to delete token: ${err.message}`, 'error');
      }
    }

    // Update single competitor now
    if (target.classList.contains('update-now')) {
      const competitor_id = target.dataset.id;
      const username = target.dataset.username;
      try {
        const res = await fetchAPI('/api/admin/competitor-ops', {
          method: 'POST',
          body: JSON.stringify({ competitor_id, username }),
        });
        toast(`Queued @${username} (job ${res.job_id?.slice(0, 8)}) — runs within 5 min`, 'success');
        loadAllState();
      } catch (err: any) {
        toast(`Dispatch failed: ${err.message}`, 'error');
      }
    }
  });

  // 6. FastCron Token Vault Actions
  $('btn-add-token')?.addEventListener('click', () => {
    $('comp-token-error')?.classList.add('hidden');
    ( $('comp-f-token-name') as HTMLInputElement ).value = '';
    ( $('comp-f-token-value') as HTMLInputElement ).value = '';
    ( $('comp-f-token-default') as HTMLInputElement ).checked = true;
    showModal($('comp-token-modal'));
  });

  $('add-token-modal-btn')?.addEventListener('click', () => {
    $('comp-token-error')?.classList.add('hidden');
    ( $('comp-f-token-name') as HTMLInputElement ).value = '';
    ( $('comp-f-token-value') as HTMLInputElement ).value = '';
    ( $('comp-f-token-default') as HTMLInputElement ).checked = true;
    showModal($('comp-token-modal'));
  });

  $('comp-token-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = ( $('comp-f-token-name') as HTMLInputElement ).value.trim();
    const token = ( $('comp-f-token-value') as HTMLInputElement ).value.trim();
    const is_default = ( $('comp-f-token-default') as HTMLInputElement ).checked;

    if (!name || token.length < 8) {
      const errEl = $('comp-token-error');
      if (errEl) {
        errEl.textContent = 'Token name and key (at least 8 characters) are required.';
        errEl.classList.remove('hidden');
      }
      return;
    }

    try {
      const res = await fetchAPI('/api/competitors/tokens', {
        method: 'POST',
        body: JSON.stringify({ name, token, is_default }),
      });
      if (res.success) {
        hideModal($('comp-token-modal'));
        toast('Token saved and encrypted in vault', 'success');
        await loadTokens();
      }
    } catch (err: any) {
      const errEl = $('comp-token-error');
      if (errEl) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      }
    }
  });

  $('btn-ping-tokens')?.addEventListener('click', async () => {
    const statusEl = $('token-status-msg');
    if (statusEl) statusEl.textContent = 'Testing connection...';
    try {
      await fetchAPI('/api/competitors/tokens');
      if (statusEl) statusEl.textContent = '✓ Vault healthy';
      toast('FastCron token registry connection verified', 'success');
    } catch (err: any) {
      if (statusEl) statusEl.textContent = '⚠ Connection error';
      toast(`Connection check failed: ${err.message}`, 'error');
    }
  });

  // 7. Schedule Modal & Provider Selection
  $('btn-open-schedule-modal')?.addEventListener('click', () => {
    document.getElementById('competitors-schedule-modal')?.classList.remove('hidden');
  });

  window.addEventListener('cron:schedule-selected', async (e: any) => {
    const { expression, timezone } = e.detail;
    try {
      const res = await fetchAPI('/api/admin/competitor-ops', {
        method: 'PUT',
        body: JSON.stringify({ cron_expression: expression, timezone, schedule_status: 'active' }),
      });
      if (res.success) {
        toast(`Schedule updated to ${expression} (${timezone})`, 'success');
        loadAllState();
      }
    } catch (err: any) {
      toast(`Failed to update schedule: ${err.message}`, 'error');
    }
  });

  // Initial Boot
  loadAllState();
</script>
