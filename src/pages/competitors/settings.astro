---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProviderBadge from '../../components/cron/ProviderBadge.astro';
import RunNowButton from '../../components/cron/RunNowButton.astro';
import { humanCron, humanCronTitle } from '../../lib/cron-helper';
import { dbClients } from '../../server/db/clients';

const workspaceId = Astro.locals.activeWorkspaceId || '';
const runtimeEnv = (Astro.locals as any)?.runtime?.env || (Astro.locals as any)?.runtimeEnv;

let competitor_pipeline_settings: { cron_expression?: string | null } | null = null;
if (workspaceId) {
  try {
    const compClient = dbClients.getCompetitors(runtimeEnv);
    const { data } = await compClient
      .from('competitor_pipeline_settings')
      .select('cron_expression')
      .eq('workspace_id', workspaceId)
      .maybeSingle();
    competitor_pipeline_settings = data;
  } catch (e) {
    console.warn('[competitors/settings] Error fetching pipeline settings:', e);
  }
}

const rawExpr = competitor_pipeline_settings?.cron_expression || null;
const cronExpr = rawExpr || '—';
const cronTitle = rawExpr ? humanCronTitle(rawExpr) : 'No schedule yet';
const cronDesc = rawExpr ? humanCron(rawExpr) : 'Create a schedule via Configure Schedule';
---

<Layout title="Competitor Intelligence Settings" description="Closed-loop control plane for Pinterest competitor ingestion, credential vault, pipeline schedules, and live job auditing.">

  <!-- ═══ Navigation & Header ═══ -->
  <div class="mb-6">
    <div class="mb-3">
      <a href="/competitors" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back to Competitors</span>
      </a>
    </div>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <SectionHeader
        title="Competitor Operations Console"
        description="Unified management for Pinterest ingestion schedules, credential vault, pipeline parameters, and background sync jobs."
      />
      <div class="flex items-center gap-2.5 self-start sm:self-auto">
        <button id="refresh-all-btn" title="Refresh all settings"
          class="inline-flex items-center justify-center rounded-xl border border-border bg-card p-2.5 text-muted-foreground shadow-sm hover:bg-muted hover:text-foreground transition-all">
          <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="space-y-8">
    <!-- ═══ SECTION 0: Automation Schedules & Cron Provider ═══ -->
    <div class="space-y-6">

      <!-- Side-by-Side Cards: Schedules (65%) & FastCron Tokens (35%) -->
      <div class="flex flex-col lg:flex-row gap-6">

        <!-- Left: FastCron API Tokens (35%) -->
        <div class="lg:w-[35%] rounded-2xl border border-border bg-card p-5 space-y-4 shadow-sm flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-border/80 pb-3 gap-2">
              <div class="flex items-center gap-2">
                <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div>
                  <h3 class="text-xs font-bold text-foreground">FastCron API Tokens</h3>
                  <p class="text-[10px] text-muted-foreground">Workspace token registry</p>
                </div>
              </div>
              <button
                id="btn-add-token"
                type="button"
                class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-xl bg-primary text-primary-foreground hover:bg-primary/90 transition-all shadow-xs cursor-pointer"
              >
                + Add Token
              </button>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-xs">
                <thead>
                  <tr class="text-left border-b border-border text-muted-foreground text-[10px] font-bold">
                    <th class="p-2">NAME</th>
                    <th class="p-2">KEY</th>
                    <th class="p-2">STATUS</th>
                    <th class="p-2 text-right">ACTION</th>
                  </tr>
                </thead>
                <tbody id="tokens-table-rows">
                  <tr>
                    <td colspan="4" class="p-4 text-center text-muted-foreground">Loading tokens...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="pt-3 border-t border-border/60 flex items-center justify-between text-[11px] text-muted-foreground">
            <div class="flex items-center gap-1.5">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
              <span id="token-status-msg" class="text-emerald-500 font-medium text-[10px]">✓ Connection healthy</span>
            </div>
            <button
              id="btn-ping-tokens"
              type="button"
              class="text-[10px] font-semibold text-muted-foreground hover:text-foreground underline cursor-pointer"
            >
              Test Connection
            </button>
          </div>
        </div>

        <!-- Right: Global Cron Provider Badge & Quick Overview (65%) -->
        <div class="lg:w-[65%] rounded-2xl border border-border bg-card p-5 space-y-4 shadow-sm flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between border-b border-border/80 pb-3">
              <div class="flex items-center gap-2">
                <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                  <h3 class="text-xs font-bold text-foreground">Global Cron Engine & Orchestration</h3>
                  <p class="text-[10px] text-muted-foreground">Provider is set in Settings &gt; Workspace, tokens are isolated per project</p>
                </div>
              </div>
              <ProviderBadge workspaceId={workspaceId} />
            </div>

            <p class="text-xs text-muted-foreground leading-relaxed">
              PinOrbit triggers background scraping workers using stateless cron dispatches. Each schedule emits an authenticated payload to the internal ingestion endpoint (<code class="text-[11px] text-primary font-mono">/api/internal/competitors/dispatch</code>) with an encrypted webhook secret token.
            </p>
          </div>

          <div class="pt-3 border-t border-border/60 flex items-center justify-between text-[11px] text-muted-foreground">
            <span class="flex items-center gap-1.5 text-[10px]">
              <span class="inline-block h-2 w-2 rounded-full bg-primary"></span>
              Encrypted AES-GCM vault security active
            </span>
            <a href="/settings" class="text-[10px] font-semibold text-primary hover:underline">Settings &gt; Workspace →</a>
          </div>
        </div>

      </div>

      <!-- ═══ Multi-Schedule Table & Controls (P1/P4 Parity) ═══ -->
      <div class="rounded-2xl border border-border bg-card p-5 space-y-4 shadow-sm">
        
        <!-- Header Controls -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border pb-4">
          <div class="flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-pink-500/10 text-pink-500 border border-pink-500/20 shadow-2xs">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-sm font-bold text-foreground">Posting Schedules &amp; Automation</h2>
                <span id="comp-cron-global-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground">Active Multi-Schedule</span>
              </div>
              <p class="text-xs text-muted-foreground mt-0.5">Manage multi-schedule competitor scraping, profile metrics refresh, and change detection</p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <!-- Run Now Button -->
            <RunNowButton
              endpoint="/api/internal/competitors/dispatch"
              payload={{ workspace_id: workspaceId, pipeline: "competitors" }}
              label="Run Now"
              forceLabel="⚡ Force Run"
              scope="competitors"
            />

            <!-- New Schedule Button -->
            <button
              id="btn-add-competitor-schedule"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-foreground shadow-2xs hover:bg-primary/90 transition-all cursor-pointer"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>+ New Schedule</span>
            </button>

            <!-- Batch Actions Dropdown -->
            <div class="relative inline-block text-left" id="comp-batch-dropdown-container">
              <button
                id="btn-comp-batch"
                type="button"
                class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-2xs cursor-pointer"
              >
                <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span>Batch</span>
                <span id="comp-batch-sel-count" class="hidden rounded-full bg-primary/20 text-primary px-1.5 py-0.2 text-[10px] font-bold">0</span>
                <svg class="h-3 w-3 text-muted-foreground ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </button>

              <div id="comp-sched-batch-menu" class="hidden absolute right-0 mt-1 w-56 rounded-2xl border border-border bg-card shadow-xl z-50 py-1 text-xs divide-y divide-border/80">
                <div class="py-1">
                  <button type="button" id="comp-batch-act-select-all" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-foreground cursor-pointer">
                    <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    <span>Select all</span>
                  </button>
                </div>
                <div class="py-1">
                  <button type="button" id="comp-batch-act-run" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-primary font-semibold cursor-pointer">
                    <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    <span>Run Selected Now</span>
                  </button>
                  <button type="button" id="comp-batch-act-enable" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-emerald-600 dark:text-emerald-400 cursor-pointer">
                    <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Resume / Enable Selected</span>
                  </button>
                  <button type="button" id="comp-batch-act-disable" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-amber-600 dark:text-amber-400 cursor-pointer">
                    <svg class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    <span>Pause / Disable Selected</span>
                  </button>
                </div>
                <div class="py-1">
                  <button type="button" id="comp-batch-act-export" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-muted-foreground hover:text-foreground cursor-pointer">
                    <svg class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    <span>Export Selected (JSON)</span>
                  </button>
                  <button type="button" id="comp-batch-act-delete" class="w-full text-left px-3 py-1.5 hover:bg-muted flex items-center gap-2 text-rose-500 font-semibold cursor-pointer">
                    <svg class="h-3.5 w-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    <span>Delete Selected</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Sync Missing Button -->
            <button
              id="btn-comp-sync-missing"
              type="button"
              class="inline-flex items-center gap-1 rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-2xs cursor-pointer"
            >
              <span>Sync Missing</span>
            </button>

            <!-- Refresh Button -->
            <button
              id="btn-comp-refresh-schedules"
              type="button"
              class="inline-flex items-center gap-1 rounded-xl border border-border bg-background p-2 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-2xs cursor-pointer"
              title="Refresh schedule telemetry"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            </button>
          </div>
        </div>

        <!-- Cadence Analyzer Banner -->
        <div id="comp-sched-pace-box" class="rounded-xl border border-border/80 bg-background/50 p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2">
            <span class="text-primary font-bold">⚡ Automation Cadence:</span>
            <span id="comp-sched-pace-val" class="font-semibold text-foreground">Calculating cadence...</span>
          </div>
          <div class="text-[11px] text-muted-foreground" id="comp-sched-pace-desc">
            FastCron controls ingestion schedules independently across configured timezones.
          </div>
        </div>

        <!-- Multi-Schedule Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left" id="competitor-schedules-table">
            <thead>
              <tr class="border-b border-border bg-muted/30 text-muted-foreground text-[10px] font-bold">
                <th class="p-3 w-8">
                  <input type="checkbox" id="comp-sched-select-all" class="h-3.5 w-3.5 rounded border-border text-primary cursor-pointer" />
                </th>
                <th class="p-3">SCHEDULE &amp; STATUS</th>
                <th class="p-3">SCHEDULE &amp; CADENCE</th>
                <th class="p-3">NEXT RUN</th>
                <th class="p-3">LAST RUN</th>
                <th class="p-3">FASTCRON TOKEN</th>
                <th class="p-3 text-right">ACTIONS</th>
              </tr>
            </thead>
            <tbody id="competitor-schedules-rows" class="divide-y divide-border/60">
              <tr>
                <td colspan="7" class="p-6 text-center text-muted-foreground">Loading competitor automation schedules...</td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>

    </div>

    <!-- ═══ SECTION 1: Pipeline Settings ═══ -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border pb-5 mb-5">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>⚙️</span>
            <span>Pipeline Ingestion Controls</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Configure global automation parameters, dry-run safety modes, and retry boundaries.</p>
        </div>
        <div class="flex items-center gap-2.5">
          <button id="btn-run-full-update"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span>Run Full Update Now</span>
          </button>
        </div>
      </div>

      <form id="pipeline-settings-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Pipeline Switch -->
        <div class="flex flex-col justify-between rounded-xl border border-border bg-background p-4">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground">Pipeline Status</span>
              <div class="flex items-center gap-1.5">
                <span id="kek-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground">🔑 KEK —</span>
                <span id="pipeline-status-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500">Active</span>
              </div>
            </div>
            <p class="text-[11px] text-muted-foreground mt-1">When disabled, automated cron runs and background workers cleanly skip execution.</p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="checkbox" id="pipe-is-enabled" class="h-4 w-4 rounded accent-primary cursor-pointer" checked />
            <label for="pipe-is-enabled" class="text-xs font-semibold text-foreground cursor-pointer">Enable Automation Pipeline</label>
          </div>
        </div>

        <!-- Dry Run Switch -->
        <div class="flex flex-col justify-between rounded-xl border border-border bg-background p-4">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground">Dry-Run Simulation</span>
              <span id="dry-run-status-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground">Off</span>
            </div>
            <p class="text-[11px] text-muted-foreground mt-1">Queries Pinterest API & rotates cookies but commits zero database writes.</p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="checkbox" id="pipe-dry-run" class="h-4 w-4 rounded accent-amber-500 cursor-pointer" />
            <label for="pipe-dry-run" class="text-xs font-semibold text-foreground cursor-pointer">Enable Dry-Run Mode</label>
          </div>
        </div>

        <!-- GitHub Actions Daily Schedule (02:00 UTC) -->
        <div class="flex flex-col justify-between rounded-xl border border-border bg-background p-4">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground">GitHub Actions Cron</span>
              <span id="gh-schedule-status-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500">Active</span>
            </div>
            <p class="text-[11px] text-muted-foreground mt-1">Built-in Daily @ 02:00 UTC workflow trigger. Leave unchecked to use FastCron only.</p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="checkbox" id="pipe-github-schedule" class="h-4 w-4 rounded accent-primary cursor-pointer" checked />
            <label for="pipe-github-schedule" class="text-xs font-semibold text-foreground cursor-pointer">Enable Daily @ 02:00 UTC</label>
          </div>
        </div>

        <!-- Max Retries & Save -->
        <div class="flex flex-col justify-between rounded-xl border border-border bg-background p-4">
          <div>
            <span class="text-xs font-bold text-foreground">Network Max Retries</span>
            <p class="text-[11px] text-muted-foreground mt-1">Exponential backoff ceiling per competitor fetch attempt (1–10).</p>
          </div>
          <div class="mt-4 flex items-center gap-3">
            <input type="number" id="pipe-max-retries" min="1" max="10" value="3"
              class="w-20 rounded-xl border border-border bg-card py-1.5 px-3 text-xs font-semibold text-foreground focus:border-primary focus:outline-none" />
            <button type="submit" id="btn-save-pipeline"
              class="rounded-xl border border-border bg-card px-4 py-1.5 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all">
              Save Settings
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- ═══ SECTION 2: Pinterest Cookies (Vault) ═══ -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border pb-5 mb-5">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>🔐</span>
            <span>Pinterest Session Vault</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Encrypted at rest using AES-GCM and workspace KEK. Used for authenticated Pinterest scraping.</p>
        </div>
        <button id="open-add-cookie-modal"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-md hover:bg-emerald-500 transition-all self-start sm:self-auto">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Add Cookie</span>
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-muted-foreground" id="cookies-table">
          <thead class="border-b border-border bg-muted/60 text-foreground font-semibold">
            <tr>
              <th scope="col" class="py-3 px-4">Vault Identifier</th>
              <th scope="col" class="py-3 px-4">Security Level</th>
              <th scope="col" class="py-3 px-4">Status</th>
