  <!-- Toast Notification Anchor -->
  <div id="toast-root" aria-live="polite" class="fixed bottom-4 right-4 z-[70] flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]"></div>
</Layout>

<script>
  import { humanCron, humanCronTitle } from '../../lib/cron-helper';
  import { fmtAuditTimestamp, fmtDuration } from '../../lib/format-audit';

  // ─── Helpers & Utilities ───────────────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const escHtml = (s: any) => String(s ?? '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string));
  const fmtCompact = (n: number | null | undefined) => new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(n ?? 0);

  function timeAgo(iso?: string | null): string {
    if (!iso) return 'Never';
    const ms = Date.now() - new Date(iso).getTime();
    if (isNaN(ms) || ms < 0) return 'Just now';
    const m = Math.floor(ms / 60000);
    if (m < 1) return 'Just now';
    if (m < 60) return `${m}m ago`;
    const h = Math.floor(m / 60);
    if (h < 24) return `${h}h ago`;
    const d = Math.floor(h / 24);
    return `${d}d ago`;
  }

  function toast(message: string, type: 'success' | 'error' | 'info' = 'success') {
    const colors = {
      success: 'border-emerald-500/40 text-emerald-600 dark:text-emerald-400',
      error: 'border-rose-500/40 text-rose-600 dark:text-rose-400',
      info: 'border-primary/40 text-primary',
    };
    const icons = { success: '✓', error: '✕', info: 'ℹ' };
    const el = document.createElement('div');
    el.className = `flex items-start gap-2.5 rounded-xl border bg-card p-3 text-xs font-semibold shadow-lg ${colors[type]}`;
    el.innerHTML = `<span class="flex-shrink-0">${icons[type]}</span><span class="flex-1 text-foreground">${escHtml(message)}</span>
      <button class="text-muted-foreground hover:text-foreground" aria-label="Dismiss">✕</button>`;
    el.querySelector('button')!.addEventListener('click', () => el.remove());
    $('toast-root').appendChild(el);
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transition = 'opacity .3s';
      setTimeout(() => el.remove(), 300);
    }, 4000);
  }

  async function fetchAPI(url: string, opts: RequestInit = {}) {
    const res = await fetch(url, {
      ...opts,
      headers: { 'Content-Type': 'application/json', ...(opts.headers || {}) },
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok) {
      throw new Error(json.error || `HTTP ${res.status}`);
    }
    return json;
  }

  function showModal(modal: HTMLElement) {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  function hideModal(modal: HTMLElement) {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.hasAttribute('data-close')) {
      const modal = target.closest('.overlay-root') as HTMLElement;
      if (modal) hideModal(modal);
    }
  });

  // ─── Multi-Schedule State ──────────────────────────────────────────────────
  let loadedSchedules: any[] = [];
  let loadedTokens: any[] = [];
  let selectedScheduleIds = new Set<string>();
  let currentBuilderTab: 'simple' | 'raw' = 'simple';

  function setBuilderTab(tab: 'simple' | 'raw') {
    currentBuilderTab = tab;
    const simpleBtn = $('comp-tab-btn-simple');
    const rawBtn = $('comp-tab-btn-raw');
    const simplePane = $('comp-tab-pane-simple');
    const rawPane = $('comp-tab-pane-raw');

    if (tab === 'simple') {
      simpleBtn?.classList.add('border-b-2', 'border-primary', 'text-primary', 'font-bold');
      simpleBtn?.classList.remove('text-muted-foreground');
      rawBtn?.classList.remove('border-b-2', 'border-primary', 'text-primary', 'font-bold');
      rawBtn?.classList.add('text-muted-foreground');
      simplePane?.classList.remove('hidden');
      rawPane?.classList.add('hidden');
    } else {
      rawBtn?.classList.add('border-b-2', 'border-primary', 'text-primary', 'font-bold');
      rawBtn?.classList.remove('text-muted-foreground');
      simpleBtn?.classList.remove('border-b-2', 'border-primary', 'text-primary', 'font-bold');
      simpleBtn?.classList.add('text-muted-foreground');
      rawPane?.classList.remove('hidden');
      simplePane?.classList.add('hidden');
    }
    updateSchedulePreview();
  }

  function updateSchedulePreview() {
    const previewEl = $('comp-sched-summary-preview');
    if (!previewEl) return;

    if (currentBuilderTab === 'simple') {
      const time = ( $('comp-f-sched-time') as HTMLInputElement )?.value || '02:00';
      const tz = ( $('comp-f-sched-tz') as HTMLSelectElement )?.value || 'UTC';
      const [hStr, mStr] = time.split(':');
      const h = parseInt(hStr || '2', 10);
      const m = parseInt(mStr || '0', 10);
      const expr = `${m} ${h} * * *`;
      previewEl.textContent = `${expr} (${humanCronTitle(expr)} ${tz})`;
    } else {
      const raw = ( $('comp-f-raw-cron') as HTMLInputElement )?.value?.trim() || '0 2 * * *';
      previewEl.textContent = `${raw} (${humanCronTitle(raw)})`;
    }
  }

  $('comp-tab-btn-simple')?.addEventListener('click', () => setBuilderTab('simple'));
  $('comp-tab-btn-raw')?.addEventListener('click', () => setBuilderTab('raw'));
  $('comp-f-sched-time')?.addEventListener('input', updateSchedulePreview);
  $('comp-f-sched-tz')?.addEventListener('change', updateSchedulePreview);
  $('comp-f-raw-cron')?.addEventListener('input', updateSchedulePreview);

  // ─── Render Schedules Table ───────────────────────────────────────────────
  function renderSchedules() {
    const tbody = $('competitor-schedules-rows');
    if (!tbody) return;

    if (loadedSchedules.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-muted-foreground">
        <div class="flex flex-col items-center justify-center gap-2">
          <span class="text-2xl">📅</span>
          <span class="font-bold text-xs">No competitor automation schedules configured</span>
          <span class="text-[11px] text-muted-foreground">Click "+ New Schedule" or "Sync Missing" to create automated daily scraping.</span>
        </div>
      </td></tr>`;
      return;
    }

    tbody.innerHTML = loadedSchedules.map((s: any) => {
      const isSelected = selectedScheduleIds.has(s.id);
      const isPaused = s.status === 'paused' || s.paused;
      const statusPill = isPaused
        ? `<span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-amber-500/10 text-amber-500 border border-amber-500/20">⏸ Paused</span>`
        : `<span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">● Active</span>`;

      const nextRunHtml = fmtAuditTimestamp(s.next_run, { timezone: s.timezone }).html;
      const lastRunHtml = s.last_run ? fmtAuditTimestamp(s.last_run, { timezone: s.timezone }).html : '<span class="text-muted-foreground/60 text-xs font-medium">Never</span>';
      const httpBadge = s.last_http_code
        ? `<span class="rounded px-1.5 py-0.5 text-[9px] font-bold ${s.last_http_code === 202 || s.last_http_code === 200 ? 'bg-emerald-500/10 text-emerald-500 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-500 border border-rose-500/20'}">HTTP ${s.last_http_code}</span>`
        : '';

      return `<tr class="hover:bg-muted/30 transition-colors border-b border-border/60 ${isSelected ? 'bg-primary/5' : ''}">
        <td class="p-3 w-8">
          <input type="checkbox" data-sched-select="${s.id}" ${isSelected ? 'checked' : ''} class="h-3.5 w-3.5 rounded border-border text-primary cursor-pointer" />
        </td>
        <td class="p-3">
          <div class="flex items-center gap-2">
            <span class="font-bold text-foreground">${escHtml(s.label || 'Schedule')}</span>
            ${statusPill}
          </div>
          <div class="text-[10px] text-muted-foreground font-mono mt-0.5">#${s.fastcron_job_id || s.id.slice(0, 8)}</div>
        </td>
        <td class="p-3">
          <div class="font-mono font-semibold text-primary text-[11px]">${escHtml(s.expression)}</div>
          <div class="text-[10px] text-muted-foreground">${escHtml(humanCronTitle(s.expression))} (${escHtml(s.timezone || 'UTC')})</div>
        </td>
        <td class="p-3">${nextRunHtml}</td>
        <td class="p-3">
          ${lastRunHtml}
          ${httpBadge ? `<div class="mt-1">${httpBadge}</div>` : ''}
        </td>
        <td class="p-3">
          <div class="font-semibold text-foreground text-[11px]">${escHtml(s.token_name)}</div>
          <div class="text-[10px] text-muted-foreground font-mono">${escHtml(s.masked_token)}</div>
        </td>
        <td class="p-3 text-right">
          <div class="flex items-center justify-end gap-1.5">
            <button data-act-run="${s.id}" class="rounded-lg p-1.5 text-primary hover:bg-primary/10 transition-all" title="Run Now">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </button>
            <button data-act-pause="${s.id}" data-paused="${isPaused}" class="rounded-lg p-1.5 ${isPaused ? 'text-emerald-500 hover:bg-emerald-500/10' : 'text-amber-500 hover:bg-amber-500/10'} transition-all" title="${isPaused ? 'Resume' : 'Pause'}">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                ${isPaused ? '<polygon points="5 3 19 12 5 21 5 3"/>' : '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>'}
              </svg>
            </button>
            <button data-act-clone="${s.id}" class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground transition-all" title="Clone Schedule">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
            <button data-act-logs="${s.id}" class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground transition-all" title="Execution Logs">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </button>
            <button data-act-edit="${s.id}" class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground transition-all" title="Edit Schedule">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
            <button data-act-delete="${s.id}" class="rounded-lg p-1.5 text-rose-500 hover:bg-rose-500/10 transition-all" title="Delete Schedule">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        </td>
      </tr>`;
    }).join('');
  }

  function updateCadenceBanner() {
    const paceVal = $('comp-sched-pace-val');
    const paceDesc = $('comp-sched-pace-desc');
    const globalBadge = $('comp-cron-global-badge');
    if (!paceVal) return;

    const activeCount = loadedSchedules.filter((s) => s.status === 'active' && !s.paused).length;
    const totalWeeklyRuns = activeCount * 7; // assuming daily averages

    paceVal.textContent = `${activeCount} Active Schedule${activeCount === 1 ? '' : 's'} · ~${totalWeeklyRuns} Runs / Week`;
    if (paceDesc) {
      paceDesc.textContent = activeCount > 0
        ? `Schedules synchronized with FastCron (${loadedTokens.length} token${loadedTokens.length === 1 ? '' : 's'} in vault).`
        : 'No active schedules running. Add a schedule to enable automated background scraping.';
    }

    if (globalBadge) {
      globalBadge.className = activeCount > 0
        ? 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20'
        : 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground';
      globalBadge.textContent = activeCount > 0 ? `${activeCount} Active` : 'No Active Schedules';
    }
  }

  async function loadSchedules() {
    try {
      const res = await fetchAPI('/api/competitors/schedules');
      loadedSchedules = res.schedules || [];
      renderSchedules();
      updateCadenceBanner();
    } catch (err: any) {
      const tbody = $('competitor-schedules-rows');
      if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-center text-rose-500">Failed to load schedules: ${escHtml(err.message)}</td></tr>`;
    }
  }

  async function loadTokens() {
    const tbody = $('tokens-table-rows');
    const schedTokenSelect = $('comp-f-sched-token') as HTMLSelectElement;
    try {
      const res = await fetchAPI('/api/competitors/tokens');
      loadedTokens = Array.isArray(res) ? res : [];
      if (!tbody) return;

      if (loadedTokens.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-muted-foreground text-[11px]">No FastCron tokens registered. Click "+ Add Token" above.</td></tr>`;
      } else {
        tbody.innerHTML = loadedTokens.map((t: any) => {
          const isDefault = Boolean(t.is_default);
          const defaultBadge = isDefault
            ? `<span class="inline-flex items-center gap-1 rounded-full px-1.5 py-0.2 text-[9px] font-bold bg-emerald-500/10 text-emerald-500">Default</span>`
            : `<span class="text-muted-foreground text-[9px]">Active</span>`;
          const delBtn = t.source === 'env'
            ? `<span class="text-[9px] text-muted-foreground">Server</span>`
            : `<button data-token-id="${t.id}" class="token-del text-rose-500 hover:text-rose-400 font-semibold text-[10px] cursor-pointer">Delete</button>`;

          return `<tr class="hover:bg-muted/30 transition-colors border-b border-border/60">
            <td class="p-2 font-semibold text-foreground text-[11px]">${escHtml(t.name)}</td>
            <td class="p-2 font-mono text-muted-foreground text-[10px]">${escHtml(t.masked_token)}</td>
            <td class="p-2">${defaultBadge}</td>
            <td class="p-2 text-right">${delBtn}</td>
          </tr>`;
        }).join('');
      }

      if (schedTokenSelect) {
        schedTokenSelect.innerHTML = `<option value="">Default (Workspace / Environment)</option>` +
          loadedTokens.map((t: any) => `<option value="${t.id || ''}">${escHtml(t.name)} (${escHtml(t.masked_token)}) ${t.is_default ? '★ Default' : ''}</option>`).join('');
      }
    } catch (err: any) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-rose-500 text-[11px]">Failed to load tokens</td></tr>`;
    }
  }

  // ─── Table Delegated Actions ──────────────────────────────────────────────
  $('competitor-schedules-rows')?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const runId = target.closest('[data-act-run]')?.getAttribute('data-act-run');
    const pauseId = target.closest('[data-act-pause]')?.getAttribute('data-act-pause');
    const isPaused = target.closest('[data-act-pause]')?.getAttribute('data-paused') === 'true';
    const cloneId = target.closest('[data-act-clone]')?.getAttribute('data-act-clone');
    const logsId = target.closest('[data-act-logs]')?.getAttribute('data-act-logs');
    const editId = target.closest('[data-act-edit]')?.getAttribute('data-act-edit');
    const delId = target.closest('[data-act-delete]')?.getAttribute('data-act-delete');

    if (runId) {
      try {
        await fetchAPI('/api/competitors/schedules/bulk', {
          method: 'POST',
          body: JSON.stringify({ action: 'run', ids: [runId] }),
        });
        toast('Manual execution triggered', 'success');
        await loadSchedules();
      } catch (err: any) {
        toast(`Run failed: ${err.message}`, 'error');
      }
    } else if (pauseId) {
      try {
        await fetchAPI(`/api/competitors/schedules/${pauseId}`, {
          method: 'PATCH',
          body: JSON.stringify({ status: isPaused ? 'active' : 'paused' }),
        });
        toast(isPaused ? 'Schedule resumed' : 'Schedule paused', 'info');
        await loadSchedules();
      } catch (err: any) {
        toast(`Failed: ${err.message}`, 'error');
      }
    } else if (cloneId) {
      try {
        await fetchAPI('/api/competitors/schedules/bulk', {
          method: 'POST',
          body: JSON.stringify({ action: 'clone', ids: [cloneId] }),
        });
        toast('Schedule cloned', 'success');
        await loadSchedules();
      } catch (err: any) {
        toast(`Clone failed: ${err.message}`, 'error');
      }
    } else if (logsId) {
      const sched = loadedSchedules.find((s) => s.id === logsId);
      if (sched) {
        const titleEl = $('comp-logs-job-subtitle');
        const tbody = $('comp-logs-table-rows');
        if (titleEl) titleEl.textContent = `${sched.label || 'Schedule'} (#${sched.fastcron_job_id || sched.id.slice(0, 8)})`;
        if (tbody) {
          const logs: any[] = sched.cron_logs || [];
          tbody.innerHTML = logs.length === 0
            ? `<tr><td colspan="4" class="p-4 text-center text-muted-foreground">No recent execution logs found.</td></tr>`
            : logs.map((l: any) => `<tr class="border-b border-border/60">
                <td class="p-2 font-mono">${escHtml(l.date || '—')}</td>
                <td class="p-2 font-bold ${l.status === 'OK' || l.status === 'success' ? 'text-emerald-500' : 'text-amber-500'}">${escHtml(l.status || 'OK')}</td>
                <td class="p-2">${l.http_status_code ? `<span class="rounded px-1 py-0.2 text-[9px] font-bold ${l.http_status_code === 202 || l.http_status_code === 200 ? 'bg-emerald-500/10 text-emerald-500' : 'bg-rose-500/10 text-rose-500'}">HTTP ${l.http_status_code}</span>` : '—'}</td>
                <td class="p-2 text-right font-mono text-muted-foreground">${l.duration ? l.duration + 's' : '—'}</td>
              </tr>`).join('');
        }
        ( $('comp-logs-modal') as HTMLDialogElement )?.showModal();
      }
    } else if (editId) {
      const sched = loadedSchedules.find((s) => s.id === editId);
      if (sched) {
        ( $('comp-f-sched-id') as HTMLInputElement ).value = sched.id;
        ( $('comp-f-sched-label') as HTMLInputElement ).value = sched.label || '';
        ( $('comp-f-sched-tz') as HTMLSelectElement ).value = sched.timezone || 'UTC';
        ( $('comp-f-sched-token') as HTMLSelectElement ).value = sched.fastcron_token_id || '';
        ( $('comp-f-sched-enabled') as HTMLInputElement ).checked = sched.status === 'active';
        ( $('comp-f-raw-cron') as HTMLInputElement ).value = sched.expression || '0 2 * * *';
        ( $('comp-schedule-modal-title') as HTMLElement ).textContent = `Edit Schedule (${sched.label || sched.id.slice(0, 8)})`;
        setBuilderTab('raw');
        ( $('comp-schedule-modal') as HTMLDialogElement )?.showModal();
      }
    } else if (delId) {
      if (!confirm('Are you sure you want to delete this competitor schedule?')) return;
      try {
        await fetchAPI(`/api/competitors/schedules/${delId}`, { method: 'DELETE' });
        toast('Schedule deleted', 'info');
        await loadSchedules();
      } catch (err: any) {
        toast(`Delete failed: ${err.message}`, 'error');
      }
    }
  });

  // ─── Checkbox Selections & Batch Actions ──────────────────────────────────
  $('comp-sched-select-all')?.addEventListener('change', (e) => {
    const checked = (e.target as HTMLInputElement).checked;
    selectedScheduleIds.clear();
    if (checked) {
      loadedSchedules.forEach((s) => selectedScheduleIds.add(s.id));
    }
    renderSchedules();
    updateBatchCount();
  });

  $('competitor-schedules-rows')?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    const schedId = target.getAttribute('data-sched-select');
    if (schedId) {
      if (target.checked) selectedScheduleIds.add(schedId);
      else selectedScheduleIds.delete(schedId);
      updateBatchCount();
    }
  });

  function updateBatchCount() {
    const cnt = $('comp-batch-sel-count');
    if (cnt) {
      cnt.textContent = String(selectedScheduleIds.size);
      cnt.classList.toggle('hidden', selectedScheduleIds.size === 0);
    }
  }

  // Batch menu toggle
  const batchBtn = $('btn-comp-batch');
  const batchMenu = $('comp-sched-batch-menu');
  batchBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    batchMenu?.classList.toggle('hidden');
  });
  document.addEventListener('click', () => batchMenu?.classList.add('hidden'));

  $('comp-batch-act-select-all')?.addEventListener('click', () => {
    loadedSchedules.forEach((s) => selectedScheduleIds.add(s.id));
    renderSchedules();
    updateBatchCount();
  });

  $('comp-batch-act-run')?.addEventListener('click', async () => {
    if (selectedScheduleIds.size === 0) return;
    try {
      await fetchAPI('/api/competitors/schedules/bulk', {
        method: 'POST',
        body: JSON.stringify({ action: 'run', ids: Array.from(selectedScheduleIds) }),
      });
      toast(`Triggered run for ${selectedScheduleIds.size} schedules`, 'success');
      await loadSchedules();
    } catch (err: any) {
      toast(`Batch run failed: ${err.message}`, 'error');
    }
  });

  $('comp-batch-act-enable')?.addEventListener('click', async () => {
    if (selectedScheduleIds.size === 0) return;
    try {
      await fetchAPI('/api/competitors/schedules/bulk', {
        method: 'POST',
        body: JSON.stringify({ action: 'resume', ids: Array.from(selectedScheduleIds) }),
      });
      toast(`Resumed ${selectedScheduleIds.size} schedules`, 'success');
      selectedScheduleIds.clear();
      updateBatchCount();
      await loadSchedules();
    } catch (err: any) {
      toast(`Batch resume failed: ${err.message}`, 'error');
    }
  });

  $('comp-batch-act-disable')?.addEventListener('click', async () => {
    if (selectedScheduleIds.size === 0) return;
    try {
      await fetchAPI('/api/competitors/schedules/bulk', {
        method: 'POST',
        body: JSON.stringify({ action: 'pause', ids: Array.from(selectedScheduleIds) }),
      });
      toast(`Paused ${selectedScheduleIds.size} schedules`, 'info');
      selectedScheduleIds.clear();
      updateBatchCount();
      await loadSchedules();
    } catch (err: any) {
      toast(`Batch pause failed: ${err.message}`, 'error');
    }
  });

  $('comp-batch-act-export')?.addEventListener('click', () => {
    if (selectedScheduleIds.size === 0) return;
    const exported = loadedSchedules.filter((s) => selectedScheduleIds.has(s.id));
    const blob = new Blob([JSON.stringify(exported, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `competitor-schedules-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  });

  $('comp-batch-act-delete')?.addEventListener('click', async () => {
    if (selectedScheduleIds.size === 0) return;
    if (!confirm(`Delete ${selectedScheduleIds.size} selected competitor schedules?`)) return;
    try {
      await fetchAPI('/api/competitors/schedules/bulk', {
        method: 'POST',
        body: JSON.stringify({ action: 'delete', ids: Array.from(selectedScheduleIds) }),
      });
      toast(`Deleted ${selectedScheduleIds.size} schedules`, 'info');
      selectedScheduleIds.clear();
      updateBatchCount();
      await loadSchedules();
    } catch (err: any) {
      toast(`Batch delete failed: ${err.message}`, 'error');
    }
  });

  // ─── Modal Schedule Form Submit ───────────────────────────────────────────
  $('btn-add-competitor-schedule')?.addEventListener('click', () => {
    ( $('comp-f-sched-id') as HTMLInputElement ).value = '';
    ( $('comp-f-sched-label') as HTMLInputElement ).value = 'Daily Competitor Ingestion';
    ( $('comp-f-sched-time') as HTMLInputElement ).value = '02:00';
    ( $('comp-f-sched-tz') as HTMLSelectElement ).value = 'UTC';
    ( $('comp-f-sched-enabled') as HTMLInputElement ).checked = true;
    ( $('comp-schedule-modal-title') as HTMLElement ).textContent = 'Configure Competitor Schedule';
    setBuilderTab('simple');
    ( $('comp-schedule-modal') as HTMLDialogElement )?.showModal();
  });

  $('comp-schedule-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = ( $('comp-f-sched-id') as HTMLInputElement ).value;
    const label = ( $('comp-f-sched-label') as HTMLInputElement ).value.trim();
    const timezone = ( $('comp-f-sched-tz') as HTMLSelectElement ).value || 'UTC';
    const enabled = ( $('comp-f-sched-enabled') as HTMLInputElement ).checked;
    const token_id = ( $('comp-f-sched-token') as HTMLSelectElement ).value || null;

    let cron_expression = '0 2 * * *';
    if (currentBuilderTab === 'simple') {
      const time = ( $('comp-f-sched-time') as HTMLInputElement ).value || '02:00';
      const [hStr, mStr] = time.split(':');
      cron_expression = `${parseInt(mStr || '0', 10)} ${parseInt(hStr || '2', 10)} * * *`;
    } else {
      cron_expression = ( $('comp-f-raw-cron') as HTMLInputElement ).value.trim();
    }

    try {
      if (id) {
        await fetchAPI(`/api/competitors/schedules/${id}`, {
          method: 'PATCH',
          body: JSON.stringify({ label, cron_expression, timezone, enabled, token_id }),
        });
        toast('Schedule updated successfully', 'success');
      } else {
        await fetchAPI('/api/competitors/schedules', {
          method: 'POST',
          body: JSON.stringify({ label, cron_expression, timezone, enabled, token_id }),
        });
        toast('New schedule created successfully', 'success');
      }
      ( $('comp-schedule-modal') as HTMLDialogElement )?.close();
      await loadSchedules();
    } catch (err: any) {
      toast(`Failed to save schedule: ${err.message}`, 'error');
    }
  });

  // Sync Missing & Refresh buttons
  $('btn-comp-sync-missing')?.addEventListener('click', async () => {
    try {
      const res = await fetchAPI('/api/competitors/schedules/sync-missing', { method: 'POST' });
      toast(res.message || 'Sync missing completed', 'success');
      await loadSchedules();
    } catch (err: any) {
      toast(`Sync missing failed: ${err.message}`, 'error');
    }
  });

  $('btn-comp-refresh-schedules')?.addEventListener('click', async () => {
    toast('Refreshing schedule telemetry...', 'info');
    await loadSchedules();
  });

  // ─── Existing Pipeline Controls, Cookies Vault & Competitor Matrix ─────────
  function renderPipelineSettings(settings: any, kekActive: boolean) {
    const isEnabled = settings?.is_enabled ?? true;
    const dryRun = settings?.dry_run ?? false;
    const maxRetries = settings?.max_retries ?? 3;
    const githubScheduleEnabled = settings?.github_schedule_enabled ?? true;

    ( $('pipe-is-enabled') as HTMLInputElement ).checked = isEnabled;
    ( $('pipe-dry-run') as HTMLInputElement ).checked = dryRun;
    ( $('pipe-max-retries') as HTMLInputElement ).value = String(maxRetries);
    if ($('pipe-github-schedule')) {
      ( $('pipe-github-schedule') as HTMLInputElement ).checked = githubScheduleEnabled;
    }

    const ghBadge = $('gh-schedule-status-badge');
    if (ghBadge) {
      if (githubScheduleEnabled) {
        ghBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500';
        ghBadge.textContent = 'Active';
      } else {
        ghBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground';
        ghBadge.textContent = 'Off';
      }
    }

    const kekBadge = $('kek-badge');
    if (kekActive) {
      kekBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/30';
      kekBadge.textContent = '🔑 KEK Active';
    } else {
      kekBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-rose-500/10 text-rose-500 border border-rose-500/30';
      kekBadge.textContent = '🔑 KEK Inactive';
    }

    const pipeBadge = $('pipeline-status-badge');
    if (isEnabled) {
      pipeBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500';
      pipeBadge.textContent = 'Active';
    } else {
      pipeBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-rose-500/10 text-rose-500';
      pipeBadge.textContent = 'Disabled';
    }

    const dryBadge = $('dry-run-status-badge');
    if (dryRun) {
      dryBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-amber-500/10 text-amber-500';
      dryBadge.textContent = 'Active';
    } else {
      dryBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground';
      dryBadge.textContent = 'Off';
    }
  }

  function renderCookies(cookies: any[]) {
    const tbody = $('cookies-table-body');
    if (!cookies || cookies.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="py-8 text-center text-muted-foreground">
        <div class="flex flex-col items-center justify-center gap-1.5">
          <span class="text-base">🔓</span>
          <span class="font-medium text-xs">No Pinterest cookies stored in vault</span>
          <span class="text-[11px] text-muted-foreground/80">Add an active session cookie to enable automated background ingestion.</span>
        </div>
      </td></tr>`;
      return;
    }

    tbody.innerHTML = cookies.map((c: any) => {
      const maskedId = c.id.slice(0, 8) + '••••' + c.id.slice(-4);
      const isActive = c.is_active !== false;
      const created = c.created_at ? new Date(c.created_at).toLocaleDateString() : '—';
      const expires = c.expires_at ? new Date(c.expires_at).toLocaleDateString() : 'No expiry set';

      return `<tr class="hover:bg-muted/30 transition-colors">
        <td class="py-3 px-4 font-mono font-bold text-foreground text-[11px]">${escHtml(maskedId)}</td>
        <td class="py-3 px-4">
          <span class="inline-flex items-center gap-1 rounded-md bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-500">
            🔒 Encrypted (AES-GCM)
          </span>
        </td>
        <td class="py-3 px-4">
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" class="sr-only peer ck-toggle" data-id="${c.id}" ${isActive ? 'checked' : ''} />
            <div class="w-8 h-4 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </td>
        <td class="py-3 px-4 text-[11px]">${timeAgo(c.last_used_at)}</td>
        <td class="py-3 px-4 text-[11px]">${escHtml(expires)}</td>
        <td class="py-3 px-4 text-[11px]">${escHtml(created)}</td>
        <td class="py-3 px-4 text-right">
          <button data-id="${c.id}" class="ck-del rounded-lg p-1.5 text-muted-foreground hover:bg-rose-500/10 hover:text-rose-500 transition-all" title="Delete Cookie">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </td>
      </tr>`;
    }).join('');
  }

  function renderCompetitorsMatrix(competitors: any[]) {
    const tbody = $('competitors-matrix-body');
    $('competitor-matrix-count').textContent = `${competitors?.length || 0} Tracked`;

    if (!competitors || competitors.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-muted-foreground">
        No tracked competitors found in this workspace. Add competitors from the main Competitors tab.
      </td></tr>`;
      return;
    }

    tbody.innerHTML = competitors.map((c: any) => {
      const s = Array.isArray(c.competitor_settings) ? c.competitor_settings[0] : c.competitor_settings;
      const isActive = c.is_active !== undefined ? Boolean(c.is_active) : Boolean(s?.is_active ?? true);
      const freq = s?.update_frequency_hours ?? 24;
      const reach = fmtCompact(c.profile_reach || 0);
      const followers = fmtCompact(c.follower_count || 0);

      return `<tr class="hover:bg-muted/30 transition-colors">
        <td class="py-3 px-4">
          <div class="flex items-center gap-2.5">
            ${c.avatar_url ? `<img src="${escHtml(c.avatar_url)}" alt="" class="h-7 w-7 rounded-full object-cover border border-border" />` : `<div class="flex h-7 w-7 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-xs">@</div>`}
            <div>
              <div class="font-semibold text-foreground text-xs">@${escHtml(c.username)}</div>
              <div class="text-[10px] text-muted-foreground">${escHtml(c.full_name || 'Competitor')}</div>
            </div>
          </div>
        </td>
        <td class="py-3 px-4">
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" class="sr-only peer comp-active" data-id="${c.id}" ${isActive ? 'checked' : ''} />
            <div class="w-8 h-4 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-primary"></div>
          </label>
        </td>
        <td class="py-3 px-4">
          <div class="flex items-center gap-1.5">
            <select data-id="${c.id}" class="comp-freq rounded-lg border border-border bg-background py-1 px-2 text-[11px] font-semibold text-foreground focus:border-primary focus:outline-none">
              <option value="6" ${freq === 6 ? 'selected' : ''}>Every 6h</option>
              <option value="12" ${freq === 12 ? 'selected' : ''}>Every 12h</option>
              <option value="24" ${freq === 24 ? 'selected' : ''}>Every 24h (Daily)</option>
              <option value="48" ${freq === 48 ? 'selected' : ''}>Every 48h (2 Days)</option>
              <option value="168" ${freq === 168 ? 'selected' : ''}>Weekly</option>
            </select>
          </div>
        </td>
        <td class="py-3 px-4">
          <div class="flex flex-col text-xs">
            <span class="font-semibold text-foreground">${followers} <span class="text-[10px] text-muted-foreground font-normal">followers</span></span>
            <span class="text-[10px] text-muted-foreground">${reach} views/mo</span>
          </div>
        </td>
        <td class="py-3 px-4 text-[11px]">${timeAgo(c.last_checked_at)}</td>
        <td class="py-3 px-4 text-right">
          <button data-id="${c.id}" data-username="${escHtml(c.username)}"
            class="update-now inline-flex items-center gap-1 rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            <span>Scrape Now</span>
          </button>
        </td>
      </tr>`;
    }).join('');
  }

  function renderTriggerBadge(trigger?: string | null): string {
    const t = String(trigger || 'manual').toLowerCase();
    if (t === 'cron') {
      return `<span class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[9px] font-bold border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
        <span>🕐</span><span>cron</span>
      </span>`;
    }
    if (t === 'run_now') {
      return `<span class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[9px] font-bold border border-sky-500/30 bg-sky-500/10 text-sky-600 dark:text-sky-400">
        <span>⚡</span><span>run_now</span>
      </span>`;
    }
    if (t === 'full') {
      return `<span class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[9px] font-bold border border-purple-500/30 bg-purple-500/10 text-purple-600 dark:text-purple-400">
        <span>🧹</span><span>full</span>
      </span>`;
    }
    return `<span class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-[9px] font-bold border border-border bg-muted/60 text-muted-foreground">
      <span>manual</span>
    </span>`;
  }

  function renderJobs(jobs: any[]) {
    const tbody = $('jobs-table-body');
    if (!jobs || jobs.length === 0) {
      tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-muted-foreground">
        No recent ingestion jobs recorded yet.
      </td></tr>`;
      return;
    }

    tbody.innerHTML = jobs.map((j: any) => {
      const statusColors: Record<string, string> = {
        completed: 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20',
        failed: 'bg-rose-500/10 text-rose-500 border-rose-500/20',
        running: 'bg-primary/10 text-primary border-primary/20 animate-pulse',
        pending: 'bg-amber-500/10 text-amber-500 border-amber-500/20',
      };
      const pillClass = statusColors[j.status] || 'bg-muted text-muted-foreground border-border';
      const shortId = j.id ? j.id.slice(0, 8) : '—';
      const scopeLabel = j.competitor_id ? `Target: ${j.competitor_id.slice(0, 8)}` : 'Full Workspace Ingestion';
      const triggerBadge = renderTriggerBadge(j.trigger);

      const startedHtml = fmtAuditTimestamp(j.started_at).html;
      const completedHtml = j.status === 'running'
        ? `<span class="inline-flex items-center gap-1.5 text-primary font-semibold text-xs"><span class="h-1.5 w-1.5 rounded-full bg-primary animate-ping"></span>In progress</span>`
        : fmtAuditTimestamp(j.completed_at).html;
      const durationStr = fmtDuration(j.started_at, j.completed_at);

      const err = j.error_message ? `<span class="text-rose-500 font-mono text-[10px]" title="${escHtml(j.error_message)}">${escHtml(j.error_message.slice(0, 30))}…</span>` : '<span class="text-muted-foreground/60">—</span>';

      return `<tr class="hover:bg-muted/30 transition-colors">
        <td class="py-3 px-4 font-mono font-bold text-foreground text-[11px]">#${escHtml(shortId)}</td>
        <td class="py-3 px-4">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="font-semibold text-foreground text-[11px]">${escHtml(scopeLabel)}</span>
            ${triggerBadge}
          </div>
        </td>
        <td class="py-3 px-4">
          <span class="inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[10px] font-bold border ${pillClass}">
            ${escHtml(j.status)}
          </span>
        </td>
        <td class="py-3 px-4 font-mono text-foreground font-semibold text-[11px]">${j.items_processed ?? 0}</td>
        <td class="py-3 px-4">${startedHtml}</td>
        <td class="py-3 px-4">${completedHtml}</td>
        <td class="py-3 px-4 font-mono text-foreground font-semibold text-[11px]">${escHtml(durationStr)}</td>
        <td class="py-3 px-4 text-[11px]">${err}</td>
      </tr>`;
    }).join('');
  }

  async function loadAllState() {
    await Promise.all([loadSchedules(), loadTokens()]);

    try {
      const [opsRes, cookiesRes] = await Promise.all([
        fetchAPI('/api/admin/competitor-ops'),
        fetchAPI('/api/admin/pinterest-cookies'),
      ]);

      if (opsRes.success) {
        renderPipelineSettings(opsRes.settings, opsRes.kekActive);
        renderCompetitorsMatrix(opsRes.competitors);
        renderJobs(opsRes.jobs);
      }

      if (cookiesRes.success) {
        renderCookies(cookiesRes.cookies);
      }
    } catch (err: any) {
      toast(`Failed to load pipeline state: ${err.message}`, 'error');
    }
  }

  // Event Listeners for existing features
  $('refresh-all-btn')?.addEventListener('click', async () => {
    $('refresh-icon')?.classList.add('animate-spin');
    toast('Refreshing full console state...', 'info');
    await loadAllState();
    setTimeout(() => $('refresh-icon')?.classList.remove('animate-spin'), 500);
  });

  $('pipeline-settings-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const is_enabled = ( $('pipe-is-enabled') as HTMLInputElement ).checked;
    const dry_run = ( $('pipe-dry-run') as HTMLInputElement ).checked;
    const github_schedule_enabled = $('pipe-github-schedule') ? ( $('pipe-github-schedule') as HTMLInputElement ).checked : true;
    const max_retries = Number(( $('pipe-max-retries') as HTMLInputElement ).value || 3);

    try {
      const res = await fetchAPI('/api/admin/competitor-ops', {
        method: 'PUT',
        body: JSON.stringify({ is_enabled, dry_run, github_schedule_enabled, max_retries }),
      });
      if (res.success) {
        toast('Pipeline settings updated successfully', 'success');
        renderPipelineSettings(res.settings, true);
      }
    } catch (err: any) {
      toast(`Failed to save settings: ${err.message}`, 'error');
    }
  });

  $('btn-run-full-update')?.addEventListener('click', async () => {
    if (!confirm('Trigger immediate full workspace competitor ingestion run?')) return;
    try {
      const res = await fetchAPI('/api/admin/competitor-ops', {
        method: 'POST',
        body: JSON.stringify({}),
      });
      toast(`🚀 Ingestion workflow dispatched (#${res.job_id?.slice(0, 8)})`, 'success');
      await loadAllState();
    } catch (err: any) {
      toast(`Dispatch failed: ${err.message}`, 'error');
    }
  });

  // Cookie Modal
  $('open-add-cookie-modal')?.addEventListener('click', () => {
    $('add-cookie-error')?.classList.add('hidden');
    ( $('cookie-value-input') as HTMLTextAreaElement ).value = '';
    ( $('cookie-expires-input') as HTMLInputElement ).value = '';
    showModal($('add-cookie-modal'));
  });

  $('add-cookie-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const cookie_value = ( $('cookie-value-input') as HTMLTextAreaElement ).value.trim();
    const expires_at = ( $('cookie-expires-input') as HTMLInputElement ).value || null;

    if (cookie_value.length < 20) {
      const errEl = $('add-cookie-error');
      if (errEl) {
        errEl.textContent = 'Cookie string must be at least 20 characters.';
        errEl.classList.remove('hidden');
      }
      return;
    }

    try {
      const res = await fetchAPI('/api/admin/pinterest-cookies', {
        method: 'POST',
        body: JSON.stringify({ cookie_value, expires_at }),
      });
      if (res.success) {
        hideModal($('add-cookie-modal'));
        toast('Cookie stored and encrypted in vault', 'success');
        await loadAllState();
      }
    } catch (err: any) {
      const errEl = $('add-cookie-error');
      if (errEl) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      }
    }
  });

  // Token Modal
  $('btn-add-token')?.addEventListener('click', () => {
    $('comp-token-error')?.classList.add('hidden');
    ( $('comp-f-token-name') as HTMLInputElement ).value = '';
    ( $('comp-f-token-value') as HTMLInputElement ).value = '';
    ( $('comp-f-token-default') as HTMLInputElement ).checked = true;
    showModal($('comp-token-modal'));
  });

  $('comp-token-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = ( $('comp-f-token-name') as HTMLInputElement ).value.trim();
    const token = ( $('comp-f-token-value') as HTMLInputElement ).value.trim();
    const is_default = ( $('comp-f-token-default') as HTMLInputElement ).checked;

    if (!name || token.length < 8) {
      const errEl = $('comp-token-error');
      if (errEl) {
        errEl.textContent = 'Token name and key (at least 8 characters) are required.';
        errEl.classList.remove('hidden');
      }
      return;
    }

    try {
      const res = await fetchAPI('/api/competitors/tokens', {
        method: 'POST',
        body: JSON.stringify({ name, token, is_default }),
      });
      if (res.success) {
        hideModal($('comp-token-modal'));
        toast('Token saved and encrypted in vault', 'success');
        await loadTokens();
        await loadSchedules();
      }
    } catch (err: any) {
      const errEl = $('comp-token-error');
      if (errEl) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
      }
    }
  });

  $('btn-ping-tokens')?.addEventListener('click', async () => {
    const statusEl = $('token-status-msg');
    if (statusEl) statusEl.textContent = 'Testing connection...';
    try {
      await fetchAPI('/api/competitors/tokens');
      if (statusEl) statusEl.textContent = '✓ Connection healthy';
      toast('FastCron token registry connection verified', 'success');
    } catch (err: any) {
      if (statusEl) statusEl.textContent = '⚠ Connection error';
      toast(`Connection check failed: ${err.message}`, 'error');
    }
  });

  // Delegated interactive actions (cookies, competitors matrix)
  document.addEventListener('change', async (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('ck-toggle')) {
      const id = target.dataset.id;
      const is_active = (target as HTMLInputElement).checked;
      try {
        await fetchAPI('/api/admin/pinterest-cookies', {
          method: 'PATCH',
          body: JSON.stringify({ id, is_active }),
        });
        toast('Cookie status updated', 'success');
      } catch (err: any) {
        toast(`Failed to toggle cookie: ${err.message}`, 'error');
        (target as HTMLInputElement).checked = !is_active;
      }
    }

    if (target.classList.contains('comp-active')) {
      const competitor_id = target.dataset.id;
      const is_active = (target as HTMLInputElement).checked;
      try {
        await fetchAPI('/api/admin/competitor-ops', {
          method: 'PATCH',
          body: JSON.stringify({ competitor_id, is_active }),
        });
        toast('Competitor status updated', 'success');
      } catch (err: any) {
        toast(`Failed to update competitor: ${err.message}`, 'error');
        (target as HTMLInputElement).checked = !is_active;
      }
    }

    if (target.classList.contains('comp-freq')) {
      const competitor_id = target.dataset.id;
      const update_frequency_hours = Number((target as HTMLInputElement).value || 24);
      try {
        await fetchAPI('/api/admin/competitor-ops', {
          method: 'PATCH',
          body: JSON.stringify({ competitor_id, update_frequency_hours }),
        });
        toast(`Update cadence updated to ${update_frequency_hours}h`, 'success');
      } catch (err: any) {
        toast(`Failed to update cadence: ${err.message}`, 'error');
      }
    }
  });

  document.addEventListener('click', async (e) => {
    const target = (e.target as HTMLElement).closest('button');
    if (!target) return;

    if (target.classList.contains('ck-del')) {
      const id = target.dataset.id;
      if (!confirm('Are you sure you want to remove this credential from the vault?')) return;
      try {
        await fetchAPI('/api/admin/pinterest-cookies', {
          method: 'DELETE',
          body: JSON.stringify({ id }),
        });
        toast('Cookie removed from vault', 'info');
        await loadAllState();
      } catch (err: any) {
        toast(`Failed to delete: ${err.message}`, 'error');
      }
    }

    if (target.classList.contains('token-del')) {
      const id = target.dataset.tokenId;
      if (!id || !confirm('Are you sure you want to delete this API token from the vault?')) return;
      try {
        await fetchAPI(`/api/competitors/tokens/${id}`, { method: 'DELETE' });
        toast('Token removed from vault', 'info');
        await loadTokens();
        await loadSchedules();
      } catch (err: any) {
        toast(`Failed to delete token: ${err.message}`, 'error');
      }
    }

    if (target.classList.contains('update-now')) {
      const competitor_id = target.dataset.id;
      const username = target.dataset.username;
      try {
        const res = await fetchAPI('/api/admin/competitor-ops', {
          method: 'POST',
          body: JSON.stringify({ competitor_id, username }),
        });
        toast(`Queued @${username} (job ${res.job_id?.slice(0, 8)})`, 'success');
        await loadAllState();
      } catch (err: any) {
        toast(`Dispatch failed: ${err.message}`, 'error');
      }
    }
  });

  // Listen for audit timestamp display preference changes
  window.addEventListener('pinorbit_audit_ts_mode_changed', () => {
    renderSchedules();
    renderJobs(cachedJobs);
  });

  // Initial load
  loadAllState();
</script>
