---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProviderBadge from '../../components/cron/ProviderBadge.astro';
import AddNewScheduleModal from '../../components/cron/AddNewScheduleModal.astro';
import { humanCron, humanCronTitle } from '../../lib/cron-helper';
import { dbClients } from '../../server/db/clients';

const workspaceId = Astro.locals.activeWorkspaceId || '';
const runtimeEnv = (Astro.locals as any)?.runtime?.env || (Astro.locals as any)?.runtimeEnv;

let competitor_pipeline_settings: { cron_expression?: string | null } | null = null;
if (workspaceId) {
  try {
    const compClient = dbClients.getCompetitors(runtimeEnv);
    const { data } = await compClient
      .from('competitor_pipeline_settings')
      .select('cron_expression')
      .eq('workspace_id', workspaceId)
      .maybeSingle();
    competitor_pipeline_settings = data;
  } catch (e) {
    console.warn('[competitors/settings] Error fetching pipeline settings:', e);
  }
}

const rawExpr = competitor_pipeline_settings?.cron_expression || null;
const cronExpr = rawExpr || '—';
const cronTitle = rawExpr ? humanCronTitle(rawExpr) : 'No schedule yet';
const cronDesc = rawExpr ? humanCron(rawExpr) : 'Create a schedule via Configure Schedule';
---

<Layout title="Competitor Intelligence Settings" description="Closed-loop control plane for Pinterest competitor ingestion, credential vault, pipeline schedules, and live job auditing.">

  <!-- ═══ Navigation & Header ═══ -->
  <div class="mb-6">
    <div class="mb-3">
      <a href="/competitors" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back to Competitors</span>
      </a>
    </div>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <SectionHeader
        title="Competitor Operations Console"
        description="Unified management for Pinterest ingestion schedules, credential vault, pipeline parameters, and background sync jobs."
      />
      <div class="flex items-center gap-2.5 self-start sm:self-auto">
        <button id="refresh-all-btn" title="Refresh all settings"
          class="inline-flex items-center justify-center rounded-xl border border-border bg-card p-2.5 text-muted-foreground shadow-sm hover:bg-muted hover:text-foreground transition-all">
          <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="space-y-8">
    <!-- ═══ SECTION 0: Automation Schedules & Cron Provider ═══ -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border pb-5">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>⚡</span>
            <span>Automation Schedules & Cron Provider</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Stateless multi-job scheduler for Competitor profile scraping, board change detection, and metrics refresh.</p>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="btn-open-schedule-modal"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all cursor-pointer"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Configure Schedule</span>
          </button>
        </div>
      </div>

      <!-- Cron Engine Provider & Pipeline Badge -->
      <div class="flex flex-wrap items-center gap-2.5">
        <span
          id="comp-cron-badge"
          class="text-[10px] font-mono px-2.5 py-1 rounded-full bg-muted text-muted-foreground border border-border cursor-help"
          title={cronTitle}
          data-tooltip={cronDesc}
        >
          {rawExpr ? `${cronExpr} (${cronTitle})` : 'No schedule — Configure Schedule →'}
        </span>
        <ProviderBadge workspaceId={Astro.locals.activeWorkspaceId || ''} />
      </div>


      <!-- FastCron API Tokens Table Card -->
      <div class="rounded-xl border border-border/80 bg-background/50 p-4 space-y-3">
        <div class="flex flex-wrap items-center justify-between border-b border-border/80 pb-2.5 gap-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-foreground">FastCron API Tokens</span>
            <span class="text-[10px] font-semibold text-muted-foreground px-2 py-0.5 rounded-full bg-muted">Workspace token registry — Provider is global (Settings &gt; Workspace), tokens are per-project</span>
          </div>
          <div class="flex items-center gap-2">
            <button
              id="btn-ping-tokens"
              type="button"
              class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground font-semibold px-2 py-1 rounded-lg border border-border bg-card hover:bg-muted transition-all cursor-pointer"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              <span>Test Connection</span>
            </button>
            <button
              id="btn-add-token"
              type="button"
              class="inline-flex items-center gap-1 text-xs font-semibold px-3 py-1 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-all shadow-xs cursor-pointer"
            >
              + Add Token
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="text-left border-b border-border text-muted-foreground">
                <th class="p-2.5 font-semibold">TOKEN NAME</th>
                <th class="p-2.5 font-semibold">MASKED KEY</th>
                <th class="p-2.5 font-semibold">SOURCE</th>
                <th class="p-2.5 font-semibold">STATUS</th>
                <th class="p-2.5 font-semibold text-right">ACTIONS</th>
              </tr>
            </thead>
            <tbody id="tokens-table-rows">
              <tr>
                <td colspan="5" class="p-4 text-center text-muted-foreground">Loading FastCron token registry...</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="pt-2 border-t border-border/60 flex items-center justify-between text-[11px] text-muted-foreground">
          <span>Tokens are encrypted with AES-GCM at rest using workspace KEK</span>
          <span id="token-status-msg" class="text-emerald-500 font-medium">✓ Vault healthy</span>
        </div>
      </div>
    </div>

    <!-- ═══ SECTION 1: Pipeline Settings ═══ -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border pb-5 mb-5">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>⚙️</span>
            <span>Pipeline Ingestion Controls</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Configure global automation parameters, dry-run safety modes, and retry boundaries.</p>
        </div>
        <div class="flex items-center gap-2.5">
          <button id="btn-run-full-update"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <span>Run Full Update Now</span>
          </button>
        </div>
      </div>

      <form id="pipeline-settings-form" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Pipeline Switch -->
        <div class="flex flex-col justify-between rounded-xl border border-border bg-background p-4">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground">Pipeline Status</span>
              <div class="flex items-center gap-1.5">
                <span id="kek-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground">🔑 KEK —</span>
                <span id="pipeline-status-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500">Active</span>
              </div>
            </div>
            <p class="text-[11px] text-muted-foreground mt-1">When disabled, automated cron runs and background workers cleanly skip execution.</p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="checkbox" id="pipe-is-enabled" class="h-4 w-4 rounded accent-primary cursor-pointer" checked />
            <label for="pipe-is-enabled" class="text-xs font-semibold text-foreground cursor-pointer">Enable Automation Pipeline</label>
          </div>
        </div>

        <!-- Dry Run Switch -->
        <div class="flex flex-col justify-between rounded-xl border border-border bg-background p-4">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-foreground">Dry-Run Simulation</span>
              <span id="dry-run-status-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground">Off</span>
            </div>
            <p class="text-[11px] text-muted-foreground mt-1">Queries Pinterest API & rotates cookies but commits zero database writes.</p>
          </div>
          <div class="mt-4 flex items-center gap-2">
            <input type="checkbox" id="pipe-dry-run" class="h-4 w-4 rounded accent-amber-500 cursor-pointer" />
            <label for="pipe-dry-run" class="text-xs font-semibold text-foreground cursor-pointer">Enable Dry-Run Mode</label>
          </div>
        </div>

        <!-- Max Retries & Save -->
        <div class="flex flex-col justify-between rounded-xl border border-border bg-background p-4">
          <div>
            <span class="text-xs font-bold text-foreground">Network Max Retries</span>
            <p class="text-[11px] text-muted-foreground mt-1">Exponential backoff ceiling per competitor fetch attempt (1–10).</p>
          </div>
          <div class="mt-4 flex items-center gap-3">
            <input type="number" id="pipe-max-retries" min="1" max="10" value="3"
              class="w-20 rounded-xl border border-border bg-card py-1.5 px-3 text-xs font-semibold text-foreground focus:border-primary focus:outline-none" />
            <button type="submit" id="btn-save-pipeline"
              class="rounded-xl border border-border bg-card px-4 py-1.5 text-xs font-semibold text-foreground shadow-xs hover:bg-muted transition-all">
              Save Settings
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- ═══ SECTION 2: Pinterest Cookies (Vault) ═══ -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border pb-5 mb-5">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>🔐</span>
            <span>Pinterest Session Vault</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Encrypted at rest using AES-GCM and workspace KEK. Used for authenticated Pinterest scraping.</p>
        </div>
        <button id="open-add-cookie-modal"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-md hover:bg-emerald-500 transition-all self-start sm:self-auto">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span>Add Cookie</span>
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-muted-foreground" id="cookies-table">
          <thead class="border-b border-border bg-muted/60 text-foreground font-semibold">
            <tr>
              <th scope="col" class="py-3 px-4">Vault Identifier</th>
              <th scope="col" class="py-3 px-4">Security Level</th>
              <th scope="col" class="py-3 px-4">Status</th>
              <th scope="col" class="py-3 px-4">Last Used</th>
              <th scope="col" class="py-3 px-4">Expires At</th>
              <th scope="col" class="py-3 px-4">Created At</th>
              <th scope="col" class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="cookies-table-body" class="divide-y divide-border bg-card">
            <tr><td colspan="7" class="py-6 text-center text-muted-foreground">Loading vault credentials…</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ═══ SECTION 3: Per-Competitor Controls ═══ -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border pb-5 mb-5">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>🎯</span>
            <span>Per-Competitor Ingestion Matrix</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Toggle active tracking per profile, configure update cadence, or dispatch targeted syncs.</p>
        </div>
        <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary self-start sm:self-auto" id="competitor-matrix-count">0 Tracked</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-muted-foreground" id="competitors-matrix-table">
          <thead class="border-b border-border bg-muted/60 text-foreground font-semibold">
            <tr>
              <th scope="col" class="py-3 px-4">Competitor Profile</th>
              <th scope="col" class="py-3 px-4">Tracking State</th>
              <th scope="col" class="py-3 px-4">Update Cadence</th>
              <th scope="col" class="py-3 px-4">Current Audience</th>
              <th scope="col" class="py-3 px-4">Last Checked</th>
              <th scope="col" class="py-3 px-4 text-right">Targeted Actions</th>
            </tr>
          </thead>
          <tbody id="competitors-matrix-body" class="divide-y divide-border bg-card">
            <tr><td colspan="6" class="py-6 text-center text-muted-foreground">Loading competitor matrix…</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ═══ SECTION 4: Recent Ingestion Jobs ═══ -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border pb-5 mb-5">
        <div>
          <h2 class="text-base font-bold text-foreground flex items-center gap-2">
            <span>📋</span>
            <span>Recent Ingestion Jobs & Live Audit</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Audit log of the last 15 ingestion runs with status codes, items processed, and error telemetry.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-muted-foreground" id="jobs-table">
          <thead class="border-b border-border bg-muted/60 text-foreground font-semibold">
            <tr>
              <th scope="col" class="py-3 px-4">Job ID</th>
              <th scope="col" class="py-3 px-4">Target Scope</th>
              <th scope="col" class="py-3 px-4">Status</th>
              <th scope="col" class="py-3 px-4">Items Processed</th>
              <th scope="col" class="py-3 px-4">Started At</th>
              <th scope="col" class="py-3 px-4">Completed At</th>
              <th scope="col" class="py-3 px-4">Telemetry / Errors</th>
            </tr>
          </thead>
          <tbody id="jobs-table-body" class="divide-y divide-border bg-card">
            <tr><td colspan="7" class="py-6 text-center text-muted-foreground">Loading recent jobs…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ═══ MODAL: Add Cookie ═══ -->
  <div id="add-cookie-modal" class="overlay-root fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div class="fixed inset-0" data-close></div>
    <div class="relative w-full max-w-lg rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <h3 class="text-base font-bold text-foreground">Add Encrypted Pinterest Cookie</h3>
        </div>
        <button data-close class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="add-cookie-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>

      <form id="add-cookie-form" class="space-y-4">
        <div class="space-y-1.5">
          <label for="cookie-value-input" class="block text-xs font-semibold text-foreground">Cookie String *</label>
          <textarea id="cookie-value-input" required rows="4" placeholder="Paste Pinterest session cookie (e.g. _pinterest_sess=...; auth_token=...)"
            class="w-full rounded-xl border border-border bg-background py-2 px-3 font-mono text-[11px] text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
          <p class="text-[10px] text-muted-foreground">Payload is encrypted client-side / at-rest via AES-GCM before database write. Raw string is never exposed.</p>
        </div>

        <div class="space-y-1.5">
          <label for="cookie-expires-input" class="block text-xs font-semibold text-foreground">Expiration Date (Optional)</label>
          <input type="datetime-local" id="cookie-expires-input"
            class="w-full rounded-xl border border-border bg-background py-2 px-3 text-xs text-foreground focus:border-primary focus:outline-none" />
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button type="button" data-close class="rounded-xl border border-border px-4 py-2.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground">Cancel</button>
          <button type="submit" class="rounded-xl bg-emerald-600 px-5 py-2.5 text-xs font-semibold text-white shadow-md hover:bg-emerald-500 transition-all">Save (Encrypted)</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ═══ MODAL: Add FastCron Token ═══ -->
  <div id="comp-token-modal" class="overlay-root fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4" aria-modal="true" role="dialog">
    <div class="fixed inset-0" data-close></div>
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-4 z-10">
      <div class="flex items-center justify-between border-b border-border pb-3">
        <h3 class="text-base font-bold text-foreground">Add FastCron API Token</h3>
        <button data-close class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground">
          ✕
        </button>
      </div>
      <div id="comp-token-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-500"></div>
      <form id="comp-token-form" class="space-y-4 text-xs">
        <div>
          <label for="comp-f-token-name" class="block font-bold text-foreground mb-1">Token Name / Label</label>
          <input
            type="text"
            id="comp-f-token-name"
            placeholder="e.g. Competitor FastCron API Key"
            class="w-full rounded-xl border border-border bg-background px-3 py-2 text-foreground font-semibold focus:border-primary focus:outline-none"
            required
          />
        </div>
        <div>
          <label for="comp-f-token-value" class="block font-bold text-foreground mb-1">FastCron API Secret Key</label>
          <input
            type="password"
            id="comp-f-token-value"
            placeholder="Paste FastCron API Token"
            class="w-full rounded-xl border border-border bg-background px-3 py-2 text-foreground font-mono focus:border-primary focus:outline-none"
            required
          />
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="comp-f-token-default" class="h-4 w-4 rounded border-border text-primary cursor-pointer" />
          <label for="comp-f-token-default" class="text-xs font-semibold text-foreground cursor-pointer">Set as default workspace token</label>
        </div>
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-border">
          <button type="button" data-close class="rounded-xl border border-border bg-background px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all cursor-pointer">
            Cancel
          </button>
          <button type="submit" class="rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground hover:bg-primary/90 transition-all shadow-xs cursor-pointer">
            Save Token
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ═══ MODAL: Automation Schedule Builder ═══ -->
  <AddNewScheduleModal modalId="competitors-schedule-modal" pipeline="competitors" />

  <!-- Toast Notification Anchor -->
  <div id="toast-root" aria-live="polite" class="fixed bottom-4 right-4 z-[70] flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]"></div>
</Layout>

<script>
  import { humanCron, humanCronTitle } from '../../lib/cron-helper';

  // ─── Helpers & Utilities ───────────────────────────────────────────────────
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const escHtml = (s: any) => String(s ?? '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string));
  const fmtCompact = (n: number | null | undefined) => new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(n ?? 0);

  function timeAgo(iso?: string | null): string {
    if (!iso) return 'Never';
    const ms = Date.now() - new Date(iso).getTime();
    if (isNaN(ms) || ms < 0) return 'Just now';
    const m = Math.floor(ms / 60000);
    if (m < 1) return 'Just now';
    if (m < 60) return `${m}m ago`;
    const h = Math.floor(m / 60);
    if (h < 24) return `${h}h ago`;
    const d = Math.floor(h / 24);
    return `${d}d ago`;
  }

  function toast(message: string, type: 'success' | 'error' | 'info' = 'success') {
    const colors = {
      success: 'border-emerald-500/40 text-emerald-600 dark:text-emerald-400',
      error: 'border-rose-500/40 text-rose-600 dark:text-rose-400',
      info: 'border-primary/40 text-primary',
    };
    const icons = { success: '✓', error: '✕', info: 'ℹ' };
    const el = document.createElement('div');
    el.className = `flex items-start gap-2.5 rounded-xl border bg-card p-3 text-xs font-semibold shadow-lg ${colors[type]}`;
    el.innerHTML = `<span class="flex-shrink-0">${icons[type]}</span><span class="flex-1 text-foreground">${escHtml(message)}</span>
      <button class="text-muted-foreground hover:text-foreground" aria-label="Dismiss">✕</button>`;
    el.querySelector('button')!.addEventListener('click', () => el.remove());
    $('toast-root').appendChild(el);
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transition = 'opacity .3s';
      setTimeout(() => el.remove(), 300);
    }, 4500);
  }

  // ─── Modals ───────────────────────────────────────────────────────────────
  function showModal(el: HTMLElement) {
    el.classList.remove('hidden');
    el.classList.add('flex');
    el.querySelector<HTMLElement>('input, textarea, button[data-close]')?.focus();
  }
  function hideModal(el: HTMLElement) {
    el.classList.add('hidden');
    el.classList.remove('flex');
  }
  document.querySelectorAll('.overlay-root').forEach(root => {
    root.querySelectorAll('[data-close]').forEach(btn => btn.addEventListener('click', () => hideModal(root as HTMLElement)));
  });

  // ─── API Layer ────────────────────────────────────────────────────────────
  async function fetchAPI(url: string, options: RequestInit = {}) {
    const res = await fetch(url, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        ...(options.headers || {}),
      },
    });
    const data = await res.json().catch(() => ({ success: false, error: 'Malformed JSON response' }));
    if (!res.ok && res.status !== 202) {
      throw new Error(data.error || `HTTP ${res.status}`);
    }
    return data;
  }

  // ─── Renderers ────────────────────────────────────────────────────────────
  function renderPipelineSettings(settings: any) {
    const isEnabled = Boolean(settings?.is_enabled ?? true);
    const dryRun = Boolean(settings?.dry_run ?? false);
    const maxRetries = settings?.max_retries ?? 3;
    const expr = settings?.cron_expression || null;

    ( $('pipe-is-enabled') as HTMLInputElement ).checked = isEnabled;
    ( $('pipe-dry-run') as HTMLInputElement ).checked = dryRun;
    ( $('pipe-max-retries') as HTMLInputElement ).value = String(maxRetries);

    const pipeBadge = $('pipeline-status-badge');
    if (isEnabled) {
      pipeBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500';
      pipeBadge.textContent = 'Active';
    } else {
      pipeBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-rose-500/10 text-rose-500';
      pipeBadge.textContent = 'Disabled';
    }

    const dryBadge = $('dry-run-status-badge');
    if (dryRun) {
      dryBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-amber-500/10 text-amber-500';
      dryBadge.textContent = 'Active';
    } else {
      dryBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground';
      dryBadge.textContent = 'Off';
    }

    const cronBadge = $('comp-cron-badge');
    if (cronBadge) {
      if (expr) {
        cronBadge.textContent = `${expr} (${humanCronTitle(expr)})`;
        cronBadge.title = humanCronTitle(expr);
        cronBadge.setAttribute('data-tooltip', humanCron(expr));
      } else {
        cronBadge.textContent = 'No schedule — Configure Schedule →';
        cronBadge.title = 'No schedule yet';
        cronBadge.setAttribute('data-tooltip', 'Create a schedule via Configure Schedule');
      }
    }
  }

  async function loadTokens() {
    const tbody = $('tokens-table-rows');
    const select = $('cron-token-select') as HTMLSelectElement;
    try {
      const res = await fetchAPI('/api/competitors/tokens');
      const tokens = Array.isArray(res) ? res : [];
      if (!tbody) return;

      if (tokens.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-muted-foreground">No FastCron tokens registered. Click "+ Add Token" above to add one.</td></tr>`;
      } else {
        tbody.innerHTML = tokens.map((t: any) => {
          const isEnv = t.source === 'env';
          const isDefault = Boolean(t.is_default);
          const defaultBadge = isDefault
            ? `<span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/30">★ Default</span>`
            : `<span class="text-muted-foreground text-[10px]">Active</span>`;
          const sourceBadge = isEnv
            ? `<span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold bg-amber-500/10 text-amber-500">Env</span>`
            : `<span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold bg-muted text-muted-foreground">Vault</span>`;
          const delBtn = isEnv
            ? `<span class="text-[10px] text-muted-foreground">Managed by Server</span>`
            : `<button data-token-id="${t.id}" class="token-del text-rose-500 hover:text-rose-400 font-semibold text-xs transition-colors cursor-pointer">Delete</button>`;

          return `<tr class="hover:bg-muted/30 transition-colors border-b border-border/60">
            <td class="p-2.5 font-semibold text-foreground">${escHtml(t.name)}</td>
            <td class="p-2.5 font-mono text-muted-foreground text-[11px]">${escHtml(t.masked_token)}</td>
            <td class="p-2.5">${sourceBadge}</td>
            <td class="p-2.5">${defaultBadge}</td>
            <td class="p-2.5 text-right">${delBtn}</td>
          </tr>`;
        }).join('');
      }

      if (select) {
        select.innerHTML = tokens.length === 0
          ? `<option value="">Server Default (Environment Variable)</option>`
          : tokens.map((t: any) => `<option value="${t.id || ''}" ${t.is_default ? 'selected' : ''}>${escHtml(t.name)} (${escHtml(t.masked_token)}) ${t.is_default ? '★ Default' : ''}</option>`).join('');
      }
    } catch (err: any) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-rose-500">Failed to load tokens: ${escHtml(err.message)}</td></tr>`;
    }
  }

