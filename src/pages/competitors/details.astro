---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Competitor Deep-Dive & Analytics Engine" description="Historical growth trajectory, Month-over-Month comparisons, pinning velocity, and board timeline analytics.">
  <div id="competitor-details-page-root" class="space-y-6">
    
    <!-- ═══ Top Navigation & Primary Action Controls ═══ -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <a href="/competitors" class="inline-flex items-center gap-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors group">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        <span>Back to Competitors Workspace</span>
      </a>

      <!-- Action Toolbar -->
      <div class="flex items-center gap-2 flex-wrap self-start sm:self-auto">
        <button
          id="refresh-competitor-btn"
          type="button"
          class="inline-flex h-9 items-center justify-center gap-1.5 rounded-xl border border-border/80 bg-card px-3 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-muted/80 shadow-2xs transition-all cursor-pointer"
          title="Refresh competitor analytics"
        >
          <svg id="refresh-competitor-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
          <span class="hidden sm:inline">Refresh</span>
        </button>

        <button
          id="delete-competitor-deepdive-btn"
          type="button"
          class="inline-flex h-9 items-center justify-center gap-1.5 rounded-xl border border-rose-500/30 bg-rose-500/10 px-3.5 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-500/20 shadow-2xs transition-all cursor-pointer"
          title="Delete Competitor"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          <span>Delete</span>
        </button>

        <button
          id="open-deepdive-paste-modal"
          type="button"
          class="inline-flex h-9 items-center justify-center gap-1.5 rounded-xl bg-primary px-4 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
          </svg>
          <span>Paste DevTools Payload</span>
        </button>
      </div>
    </div>

    <!-- ═══ Status Notification Banner ═══ -->
    <div id="deepdive-status-banner" class="hidden rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-2xs animate-in fade-in duration-200">
      <div class="flex items-center gap-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <span id="deepdive-status-text" class="font-medium">Competitor data updated successfully.</span>
      </div>
      <button id="dismiss-deepdive-status" class="text-emerald-500 hover:text-emerald-400 cursor-pointer p-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- ═══ Profile Hero Card ═══ -->
    <div class="rounded-2xl border border-border/80 bg-card/60 backdrop-blur-sm p-5 sm:p-6 shadow-xs relative overflow-hidden" id="profile-header-card">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5">
        
        <!-- Left: Avatar & Meta -->
        <div class="flex items-start gap-4">
          <div class="relative">
            <img
              id="competitor-avatar"
              src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&h=200&q=80"
              alt="Avatar"
              class="h-16 w-16 rounded-2xl object-cover border border-border/80 shadow-2xs flex-shrink-0 bg-muted"
            />
          </div>

          <div class="space-y-1.5 min-w-0">
            <div class="flex flex-wrap items-center gap-2.5">
              <h1 class="text-lg sm:text-xl font-bold tracking-tight text-foreground" id="competitor-fullname">Loading…</h1>
              <span id="competitor-type-badge" class="rounded-full bg-purple-500/10 px-2.5 py-0.5 text-[11px] font-bold text-purple-600 dark:text-purple-400 border border-purple-500/20">🎯 Competitor</span>
              <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-[11px] font-semibold text-primary border border-primary/20" id="competitor-niche-badge">General</span>
              <div id="competitor-tags-container" class="flex flex-wrap items-center gap-1"></div>
            </div>

            <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
              <span id="competitor-handle" class="font-medium text-foreground">@username</span>
              <span>•</span>
              <a
                id="competitor-pinterest-link"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-medium text-primary hover:underline"
              >
                <span>View on Pinterest</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
              <span id="competitor-website-container" class="hidden flex items-center gap-2">
                <span>•</span>
                <a
                  id="competitor-website-link"
                  href="#"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-medium text-foreground hover:text-primary hover:underline"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  <span id="competitor-website-text">website.com</span>
                </a>
                <span id="competitor-verified-badge" class="hidden rounded-full bg-emerald-500/10 px-2 py-0.2 text-[10px] font-bold text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">✓ Verified Domain</span>
              </span>
              <span>•</span>
              <span id="competitor-last-pin-str" class="text-[11px] text-muted-foreground">Last Pin: N/A</span>
            </div>

            <p class="text-xs text-muted-foreground pt-0.5 max-w-2xl" id="competitor-notes">No internal notes set for this competitor.</p>
          </div>
        </div>

        <!-- Right: Strategy Age Metric Badge -->
        <div class="flex items-center gap-3 bg-muted/40 rounded-2xl p-3.5 sm:p-4 border border-border/80 self-start lg:self-auto shadow-2xs">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <div>
            <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Strategy Age (Oldest Board)</span>
            <div class="text-base font-extrabold text-foreground font-mono tabular-nums" id="strategy-age-val">0 Days</div>
            <span class="text-[10px] text-muted-foreground" id="oldest-board-date-str">Oldest board date</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ Analytics Engine Filter & Controls Bar (Default: 7D) ═══ -->
    <div class="rounded-2xl border border-border/80 bg-card p-3.5 sm:px-5 sm:py-3 shadow-xs flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      
      <!-- Quick Time Range Filter Segmented Buttons (Default 7D) -->
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs font-bold text-muted-foreground mr-1 flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Time Range:</span>
        </span>
        <div class="flex items-center bg-muted/60 p-0.5 rounded-xl border border-border/60">
          <button data-range="7D" class="time-range-btn rounded-lg px-2.5 py-1 text-xs font-bold bg-background text-foreground shadow-2xs transition-all cursor-pointer">7D</button>
          <button data-range="30D" class="time-range-btn rounded-lg px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all cursor-pointer">30D</button>
          <button data-range="90D" class="time-range-btn rounded-lg px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all cursor-pointer">90D</button>
          <button data-range="YTD" class="time-range-btn rounded-lg px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all cursor-pointer">YTD</button>
          <button data-range="ALL" class="time-range-btn rounded-lg px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all cursor-pointer">ALL</button>
        </div>
      </div>

      <!-- Month Picker & MoM Comparison Toggle -->
      <div class="flex items-center gap-2.5 flex-wrap">
        <div class="flex items-center gap-1.5">
          <label for="snapshot-month-select" class="text-xs font-bold text-muted-foreground">Month:</label>
          <select id="snapshot-month-select" class="h-8 rounded-xl border border-border/80 bg-background px-3 text-xs font-medium text-foreground focus:border-primary focus:outline-none transition-colors shadow-2xs cursor-pointer">
            <option value="all">All Months</option>
          </select>
        </div>

        <button
          id="toggle-comparison-mode-btn"
          type="button"
          class="inline-flex h-8 items-center gap-1.5 rounded-xl border border-border/80 bg-muted/40 hover:bg-muted px-3 text-xs font-semibold text-foreground shadow-2xs transition-all cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          <span>Compare Months</span>
        </button>
      </div>
    </div>

    <!-- ═══ Month-over-Month Comparison Panel (Toggleable) ═══ -->
    <div id="mom-comparison-panel" class="hidden rounded-2xl border border-primary/30 bg-primary/5 p-5 shadow-xs space-y-4 animate-in fade-in duration-200">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-primary/20 pb-3.5">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-foreground">Month-over-Month Comparison Engine</h3>
            <p class="text-[11px] text-muted-foreground">Select two distinct months to compute exact growth deltas and percentage shifts.</p>
          </div>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
          <div class="flex items-center gap-1.5">
            <label for="mom-month-a" class="text-xs font-semibold text-muted-foreground">Base (A):</label>
            <select id="mom-month-a" class="h-8 rounded-xl border border-border bg-background px-2.5 text-xs font-medium text-foreground focus:border-primary focus:outline-none"></select>
          </div>
          <span class="text-xs font-bold text-muted-foreground">vs</span>
          <div class="flex items-center gap-1.5">
            <label for="mom-month-b" class="text-xs font-semibold text-muted-foreground">Target (B):</label>
            <select id="mom-month-b" class="h-8 rounded-xl border border-border bg-background px-2.5 text-xs font-medium text-foreground focus:border-primary focus:outline-none"></select>
          </div>
        </div>
      </div>

      <!-- MoM Results Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5" id="mom-comparison-grid"></div>
    </div>

    <!-- ═══ PERFORMANCE TREND (Dynamic Scaling, Rich Curves & Min/Max/Latest Stats) ═══ -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Performance Trend Visual Card (2 Cols) -->
      <div class="lg:col-span-2 rounded-2xl border border-border/80 bg-card p-5 sm:p-6 shadow-xs flex flex-col justify-between space-y-4">
        
        <!-- Header: PERFORMANCE TREND + Metric Pills -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <h3 class="text-xs sm:text-sm font-extrabold tracking-wider uppercase text-foreground">PERFORMANCE TREND</h3>
          </div>

          <!-- Dynamic Metric Switcher Pills -->
          <div class="flex items-center gap-1 bg-muted/60 p-0.5 rounded-xl border border-border/60 overflow-x-auto self-start sm:self-auto" id="chart-metric-pills">
            <button data-chart-mode="reach" class="chart-mode-btn px-3 py-1 rounded-lg text-xs font-bold bg-primary text-primary-foreground shadow-2xs transition-all whitespace-nowrap cursor-pointer">Monthly Reach</button>
            <button data-chart-mode="views" class="chart-mode-btn px-3 py-1 rounded-lg text-xs font-medium text-muted-foreground hover:text-foreground transition-all whitespace-nowrap cursor-pointer">Profile Views</button>
            <button data-chart-mode="followers" class="chart-mode-btn px-3 py-1 rounded-lg text-xs font-medium text-muted-foreground hover:text-foreground transition-all whitespace-nowrap cursor-pointer">Followers</button>
            <button data-chart-mode="pins" class="chart-mode-btn px-3 py-1 rounded-lg text-xs font-medium text-muted-foreground hover:text-foreground transition-all whitespace-nowrap cursor-pointer">Total Pins</button>
            <button data-chart-mode="dual" class="chart-mode-btn px-3 py-1 rounded-lg text-xs font-medium text-muted-foreground hover:text-foreground transition-all whitespace-nowrap cursor-pointer">Dual View</button>
          </div>
        </div>

        <!-- Sub-header Meta Bar: Accurate Min/Max & Latest -->
        <div class="flex items-center justify-between text-xs border-b border-border/60 pb-2">
          <div class="flex items-center gap-2 font-mono text-[11px] text-muted-foreground" id="chart-min-max-stats">
            <span>Min: <strong class="text-foreground font-bold" id="chart-stat-min">—</strong></span>
            <span>•</span>
            <span>Max: <strong class="text-foreground font-bold" id="chart-stat-max">—</strong></span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="inline-flex items-center gap-1 rounded-xl bg-muted px-2.5 py-1 text-xs font-mono font-bold text-foreground border border-border/60 shadow-2xs">
              <span class="text-muted-foreground font-sans text-[11px]">Latest:</span>
              <span id="chart-stat-latest">—</span>
            </span>
          </div>
        </div>

        <!-- SVG Line Chart Canvas with Stable Interactive Tooltip Overlay -->
        <div class="relative w-full overflow-hidden" id="chart-container">
          <svg id="growth-chart-svg" class="w-full h-56" viewBox="0 0 800 220" preserveAspectRatio="none"></svg>
          <div id="chart-tooltip-box" class="hidden absolute pointer-events-none z-30 rounded-xl border border-border/80 bg-card/95 backdrop-blur-md px-3 py-2 text-xs shadow-2xl transition-all duration-75 font-sans"></div>
        </div>
      </div>

      <!-- Pinning Velocity Metric Card (1 Col) -->
      <div class="rounded-2xl border border-border/80 bg-card p-5 sm:p-6 shadow-xs flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Pinning Velocity</span>
            <span class="rounded-full bg-amber-500/10 px-2.5 py-0.5 text-[10px] font-bold text-amber-600 dark:text-amber-400 border border-amber-500/20">⚡ Output Speed</span>
          </div>
          <div class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight font-mono tabular-nums" id="pinning-velocity-val">0.0 Pins/Day</div>
          <p class="text-xs text-muted-foreground mt-1" id="pinning-velocity-sub">Average daily pin creation rate based on snapshot deltas.</p>
        </div>

        <div class="border-t border-border/70 pt-4 space-y-2.5">
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted-foreground">Pins Added (Selected Range):</span>
            <span class="font-bold text-foreground font-mono tabular-nums" id="velocity-pins-added">+0</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted-foreground">Time Horizon Evaluated:</span>
            <span class="font-bold text-foreground" id="velocity-days-span">0 days</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-muted-foreground">Pacing Estimate:</span>
            <span class="font-bold text-primary font-mono tabular-nums" id="velocity-monthly-rate">~0 pins/mo</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ 4 Primary Metric Stat Cards ═══ -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Card 1: Reach -->
      <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-emerald-500/30 transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Monthly Reach</span>
          <span id="delta-reach-badge" class="rounded-full px-2 py-0.5 text-[10px] font-bold">0%</span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 mt-2 font-mono tabular-nums" id="current-reach">0</div>
          <div class="mt-2 text-[11px] text-muted-foreground flex items-center gap-1.5" id="delta-reach-sub">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span>vs previous snapshot</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Views -->
      <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-sky-500/30 transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Profile Views</span>
          <span id="delta-views-badge" class="rounded-full px-2 py-0.5 text-[10px] font-bold">0%</span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 mt-2 font-mono tabular-nums" id="current-views">0</div>
          <div class="mt-2 text-[11px] text-muted-foreground flex items-center gap-1.5" id="delta-views-sub">
            <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
            <span>vs previous snapshot</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Followers -->
      <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-purple-500/30 transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Followers</span>
          <span id="delta-followers-badge" class="rounded-full px-2 py-0.5 text-[10px] font-bold">0%</span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 mt-2 font-mono tabular-nums" id="current-followers">0</div>
          <div class="mt-2 text-[11px] text-muted-foreground flex items-center gap-1.5" id="delta-followers-sub">
            <span class="h-1.5 w-1.5 rounded-full bg-purple-500"></span>
            <span>vs previous snapshot</span>
          </div>
        </div>
      </div>

      <!-- Card 4: Total Pins -->
      <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-primary/30 transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Total Pins</span>
          <span id="delta-pins-badge" class="rounded-full px-2 py-0.5 text-[10px] font-bold">0%</span>
        </div>
        <div>
