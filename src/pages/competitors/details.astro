              rows="8"
              required
              placeholder='Paste JSON response from UserResource or BoardsResource network requests…'
              class="w-full rounded-xl border border-border bg-background py-2.5 px-3 font-mono text-[11px] text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary shadow-2xs"
