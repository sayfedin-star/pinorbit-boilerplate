            >
              Cancel
            </button>
            <button
              type="submit"
              class="rounded-xl bg-primary px-5 py-2 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-all cursor-pointer"
            >
              Parse &amp; Ingest Payload
