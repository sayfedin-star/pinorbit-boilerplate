  // ─── Snapshots Log Table & Slice Net Change Renderer ───
  function renderSnapshotsLogTable() {
    const snapshotsTableBody = document.getElementById('snapshots-table-body');
    const snapshotsCountBadge = document.getElementById('snapshots-count-badge');
    const paginationInfo = document.getElementById('snapshots-pagination-info');
    const pageIndicator = document.getElementById('snapshots-page-indicator');
    const prevBtn = document.getElementById('snapshots-prev-page-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('snapshots-next-page-btn') as HTMLButtonElement | null;

    if (!snapshotsTableBody) return;
    if (snapshotsCountBadge) snapshotsCountBadge.textContent = `${snapshotsList.length} ${snapshotsList.length === 1 ? 'Snapshot' : 'Snapshots'}`;

    if (!snapshotsList || snapshotsList.length === 0) {
      snapshotsTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="p-12 text-center text-xs text-muted-foreground bg-muted/10">
            No historical snapshots recorded yet for this competitor.
          </td>
        </tr>
      `;
      if (paginationInfo) paginationInfo.textContent = 'Showing 0 of 0 snapshots';
      if (pageIndicator) pageIndicator.textContent = 'Page 1 of 1';
      if (prevBtn) prevBtn.disabled = true;
      if (nextBtn) nextBtn.disabled = true;
      return;
    }

    const chronoSorted = [...snapshotsList].sort((a, b) => new Date(a.recorded_at).getTime() - new Date(b.recorded_at).getTime());
    const displayList = [...chronoSorted].reverse();

    // Pagination slice
    const totalItems = displayList.length;
    const pageSize = snapshotPageSize === 'all' ? totalItems : snapshotPageSize;
    const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
    if (currentSnapshotPage > totalPages) currentSnapshotPage = totalPages;
    if (currentSnapshotPage < 1) currentSnapshotPage = 1;

    const startIdx = (currentSnapshotPage - 1) * pageSize;
    const endIdx = Math.min(startIdx + pageSize, totalItems);
    const paginatedSlice = displayList.slice(startIdx, endIdx);

    // Compute Net Change ONLY for the currently displayed time horizon/slice (e.g. 7 or 14 days)
    let sumReachDiff = 0;
    let sumViewsDiff = 0;
    let sumFollowersDiff = 0;
    let sumPinsDiff = 0;

    paginatedSlice.forEach((s) => {
      const chronoIdx = chronoSorted.findIndex(item => item.id === s.id);
      const prevSnap = chronoIdx > 0 ? chronoSorted[chronoIdx - 1] : null;
      if (prevSnap) {
        sumReachDiff += (s.profile_reach || 0) - (prevSnap.profile_reach || 0);
        sumViewsDiff += (s.profile_views || 0) - (prevSnap.profile_views || 0);
        sumFollowersDiff += (s.follower_count || 0) - (prevSnap.follower_count || 0);
        sumPinsDiff += (s.pin_count || 0) - (prevSnap.pin_count || 0);
      }
    });

    const padClass = isComfortableDensity ? 'py-3.5' : 'py-2';

    const rowsHtml = paginatedSlice
      .map((s) => {
        const chronoIdx = chronoSorted.findIndex(item => item.id === s.id);
        const prevSnap = chronoIdx > 0 ? chronoSorted[chronoIdx - 1] : null;

        const reachDiff = prevSnap ? (s.profile_reach || 0) - (prevSnap.profile_reach || 0) : 0;
        const viewsDiff = prevSnap ? (s.profile_views || 0) - (prevSnap.profile_views || 0) : 0;
        const followersDiff = prevSnap ? (s.follower_count || 0) - (prevSnap.follower_count || 0) : 0;
        const pinsDiff = prevSnap ? (s.pin_count || 0) - (prevSnap.pin_count || 0) : 0;

        let cellsHtml = `<td class="${padClass} px-5 font-semibold text-foreground whitespace-nowrap">${formatDate(s.recorded_at, true)}</td>`;

        if (snapColVisible.monthly_reach) {
          cellsHtml += `<td class="${padClass} px-4 text-right whitespace-nowrap min-w-[160px]">${renderMetricWithDelta(s.profile_reach, reachDiff)}</td>`;
        }
        if (snapColVisible.profile_views) {
          cellsHtml += `<td class="${padClass} px-4 text-right whitespace-nowrap min-w-[160px]">${renderMetricWithDelta(s.profile_views, viewsDiff)}</td>`;
        }
        if (snapColVisible.followers) {
          cellsHtml += `<td class="${padClass} px-4 text-right whitespace-nowrap min-w-[160px]">${renderMetricWithDelta(s.follower_count, followersDiff)}</td>`;
        }
        if (snapColVisible.total_pins) {
          cellsHtml += `<td class="${padClass} px-4 text-right whitespace-nowrap min-w-[160px]">${renderMetricWithDelta(s.pin_count, pinsDiff)}</td>`;
        }
        if (snapColVisible.actions) {
          cellsHtml += `
            <td class="${padClass} px-5 text-right">
              <button
                data-delete-snapshot-id="${s.id}"
                class="delete-snapshot-btn inline-flex items-center justify-center h-7 w-7 rounded-xl border border-border bg-background hover:border-rose-500/50 hover:bg-rose-500/10 text-muted-foreground hover:text-rose-500 transition-colors cursor-pointer shadow-2xs"
                title="Delete Snapshot Record"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
              </button>
            </td>
          `;
        }

        return `<tr class="hover:bg-muted/40 transition-colors group">${cellsHtml}</tr>`;
      })
      .join('');

    // Summary totals row (Accurately computed for the selected slice)
    function formatTotalDeltaSlot(diff: number) {
      if (diff === 0) return '<div class="flex items-center justify-end w-full"><span class="font-mono text-muted-foreground text-xs">—</span></div>';
      const isPos = diff > 0;
      return `
        <div class="flex items-center justify-end gap-2 w-full text-right">
          <span class="font-bold text-xs font-mono tabular-nums ${isPos ? 'text-emerald-500' : 'text-rose-500'}">
            (${isPos ? '+' : '−'}${fmtSnapMetric(Math.abs(diff))})
          </span>
          <span class="inline-block w-[72px] invisible text-[10px]">—</span>
        </div>
      `;
    }

    let totalsCells = `<th scope="row" class="py-2.5 px-5 text-xs text-foreground text-left">∑ Net Change</th>`;
    if (snapColVisible.monthly_reach) totalsCells += `<td class="py-2.5 px-4 text-right min-w-[160px]">${formatTotalDeltaSlot(sumReachDiff)}</td>`;
    if (snapColVisible.profile_views) totalsCells += `<td class="py-2.5 px-4 text-right min-w-[160px]">${formatTotalDeltaSlot(sumViewsDiff)}</td>`;
    if (snapColVisible.followers)     totalsCells += `<td class="py-2.5 px-4 text-right min-w-[160px]">${formatTotalDeltaSlot(sumFollowersDiff)}</td>`;
    if (snapColVisible.total_pins)    totalsCells += `<td class="py-2.5 px-4 text-right min-w-[160px]">${formatTotalDeltaSlot(sumPinsDiff)}</td>`;
    if (snapColVisible.actions)       totalsCells += `<td class="py-2.5 px-5 text-right"></td>`;

    const totalsRowHtml = `<tr class="bg-muted/30 font-bold border-b border-border/80">${totalsCells}</tr>`;

    snapshotsTableBody.innerHTML = totalsRowHtml + rowsHtml;

    // Pagination info
    if (paginationInfo) paginationInfo.textContent = `Showing ${startIdx + 1}–${endIdx} of ${totalItems} snapshots`;
    if (pageIndicator) pageIndicator.textContent = `Page ${currentSnapshotPage} of ${totalPages}`;
    if (prevBtn) prevBtn.disabled = currentSnapshotPage <= 1;
    if (nextBtn) nextBtn.disabled = currentSnapshotPage >= totalPages;

    // Delete snapshot listeners
    document.querySelectorAll('.delete-snapshot-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const snapId = (e.currentTarget as HTMLElement).getAttribute('data-delete-snapshot-id');
        if (!snapId) return;

        if (confirm('Are you sure you want to delete this snapshot entry from history?')) {
          try {
            await deleteCompetitorSnapshot(snapId);
            showStatus('Snapshot record deleted successfully.');
            await loadDetails();
          } catch (err: any) {
            showStatus(`Failed to delete snapshot: ${err.message}`, true);
          }
        }
      });
    });
  }

  // ─── Density, Number Format & Page Size Controls ───
  const snapDensityToggleBtn = document.getElementById('snap-density-toggle-btn');
  const snapDensityLabel = document.getElementById('snap-density-label');
  const snapNumFormatToggleBtn = document.getElementById('snap-num-format-toggle-btn');
  const snapNumFormatLabel = document.getElementById('snap-num-format-label');
  const snapshotsPageSizeSelect = document.getElementById('snapshots-page-size-select') as HTMLSelectElement | null;
  const snapshotsPrevPageBtn = document.getElementById('snapshots-prev-page-btn');
  const snapshotsNextPageBtn = document.getElementById('snapshots-next-page-btn');

