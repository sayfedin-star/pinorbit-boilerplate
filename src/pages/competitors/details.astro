<script>
  import { parsePinterestPayload } from '../../lib/competitors';
  import type { Competitor, CompetitorBoard, CompetitorSnapshot, CompetitorDeltaStats } from '../../lib/types';
  import { formatNumber } from '../../lib/ui-helpers';

  const escHtml = (s: any) => String(s ?? '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string));

  // ─── Server-only data access ───
  async function apiJSON(url: string, opts: RequestInit = {}) {
    const r = await fetch(url, { headers: { 'Content-Type': 'application/json' }, ...opts });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error((d as any).error || `HTTP ${r.status}`);
    return d as any;
  }
  async function getCompetitorLite(id: string) {
    return apiJSON(`/api/admin/competitors?id=${encodeURIComponent(id)}&lite=1`);
  }
  async function getCompetitorBoardsOnly(id: string) {
    return apiJSON(`/api/admin/competitors?id=${encodeURIComponent(id)}&boards_only=1`);
  }
  async function deleteCompetitor(id: string) {
    await apiJSON('/api/admin/competitors', { method: 'DELETE', body: JSON.stringify({ id }) });
    return true;
  }
  async function deleteCompetitorSnapshot(snapshotId: string) {
    await apiJSON('/api/admin/competitors/snapshot', { method: 'DELETE', body: JSON.stringify({ snapshot_id: snapshotId }) });
    return true;
  }
  async function ingestDevToolsPayload(competitorId: string, payloadText: string) {
    return apiJSON('/api/admin/competitors/ingest', { method: 'POST', body: JSON.stringify({ competitor_id: competitorId, payload: payloadText }) });
  }

  // Get Competitor ID from URL Search Params
  const urlParams = new URLSearchParams(window.location.search);
  const competitorId = urlParams.get('id') || 'comp-1';

  let competitorData: Competitor | null = null;
  let boardsList: CompetitorBoard[] = [];
  let boardsLoaded = false;
  let snapshotsList: CompetitorSnapshot[] = [];
  let deltasData: CompetitorDeltaStats | null = null;

  // Analytics Engine State (Default: 7D)
  let activeTimeRange = '7D';
  let selectedMonth = 'all';
  let isComparisonMode = false;
  let activeChartMode: 'reach' | 'views' | 'followers' | 'pins' | 'dual' = 'reach';

  // Snapshot Table Density & Number Format State
  let isComfortableDensity = localStorage.getItem('cd_table_density') !== 'compact';
  let isCompactNumbers = localStorage.getItem('cd_snap_num_fmt') === 'compact';
  let snapshotPageSize: number | 'all' = (() => {
    const saved = localStorage.getItem('cd_snap_page_size');
    if (saved === 'all') return 'all';
    const num = parseInt(saved || '30', 10);
    return isNaN(num) ? 30 : num;
  })();
  let currentSnapshotPage = 1;

  // Snapshot Columns Visibility State
  interface SnapColDef {
    key: string;
    label: string;
    defaultVisible: boolean;
  }
  const SNAP_COLUMN_DEFS: SnapColDef[] = [
    { key: 'monthly_reach', label: 'Monthly Reach', defaultVisible: true },
    { key: 'profile_views', label: 'Profile Views', defaultVisible: true },
    { key: 'followers',     label: 'Followers',     defaultVisible: true },
    { key: 'total_pins',    label: 'Total Pins',    defaultVisible: true },
    { key: 'actions',       label: 'Actions',       defaultVisible: true },
  ];

  let snapColVisible: Record<string, boolean> = (() => {
    try {
      const saved = localStorage.getItem('cd_snap_cols_v1');
      if (saved) {
        return { monthly_reach: true, profile_views: true, followers: true, total_pins: true, actions: true, ...JSON.parse(saved) };
      }
    } catch {}
    return { monthly_reach: true, profile_views: true, followers: true, total_pins: true, actions: true };
  })();

  // Boards Pagination & Search State
  let boardSearchQuery = '';
  let boardSortKey = 'most_pins';
  let currentBoardPage = 1;
  const boardsPageSize = 10;

  // Number Formatters
  function fmtNumberFull(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtNumberCompact(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(num);
  }

  function fmtSnapMetric(n: number | string | null | undefined): string {
    return isCompactNumbers ? fmtNumberCompact(n) : fmtNumberFull(n);
  }

  function formatDate(isoStr?: string | null, includeTime = false): string {
    if (!isoStr) return 'N/A';
    const date = new Date(isoStr);
    if (isNaN(date.getTime())) return 'N/A';
    if (includeTime) {
      return date.toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  // ─── Pixel-Perfect Primary Number Alignment with Deep Black Text ───
  function renderMetricWithDelta(val: number | null | undefined, diff: number | null | undefined): string {
    const isPos = typeof diff === 'number' && diff > 0;
    const isNeg = typeof diff === 'number' && diff < 0;
    const deltaStr = isPos 
      ? `(+${fmtSnapMetric(Math.abs(diff))})` 
      : isNeg 
      ? `(−${fmtSnapMetric(Math.abs(diff))})` 
      : '';

    return `
      <div class="flex items-center justify-end gap-2 w-full text-right">
        <span class="font-extrabold text-neutral-900 dark:text-neutral-100 font-mono tabular-nums text-xs">${fmtSnapMetric(val || 0)}</span>
        <span class="inline-block w-[72px] text-right font-bold text-[10.5px] font-mono tabular-nums ${
          isPos ? 'text-emerald-500' : isNeg ? 'text-rose-500' : 'invisible'
        }">
          ${deltaStr || '—'}
        </span>
      </div>
    `;
  }

  function renderDeltaBadge(element: HTMLElement, subElement: HTMLElement, change: number, percent: number) {
    if (!element || !subElement) return;
    const sign = change > 0 ? '+' : '';
    element.textContent = `${sign}${percent}%`;

    if (change > 0) {
      element.className = 'rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2 py-0.5 text-[10px] font-bold';
      subElement.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><span>+${formatNumber(change)} vs previous snapshot</span>`;
    } else if (change < 0) {
      element.className = 'rounded-full bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 px-2 py-0.5 text-[10px] font-bold';
      subElement.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span><span>${formatNumber(change)} vs previous snapshot</span>`;
    } else {
      element.className = 'rounded-full bg-muted text-muted-foreground border border-border px-2 py-0.5 text-[10px] font-bold';
      subElement.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-muted-foreground"></span><span>No change vs previous snapshot</span>`;
    }
  }

  function showStatus(msg: string, isError = false) {
    const statusBanner = document.getElementById('deepdive-status-banner');
    const statusText = document.getElementById('deepdive-status-text');
    if (!statusBanner || !statusText) return;
    statusText.textContent = msg;
    statusBanner.classList.remove('hidden');
    if (isError) {
      statusBanner.className = 'rounded-2xl border border-rose-500/30 bg-rose-500/10 p-3.5 text-xs text-rose-600 dark:text-rose-400 flex items-center justify-between shadow-2xs animate-in fade-in duration-200';
    } else {
      statusBanner.className = 'rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 flex items-center justify-between shadow-2xs animate-in fade-in duration-200';
    }
  }

  document.getElementById('dismiss-deepdive-status')?.addEventListener('click', () => {
    document.getElementById('deepdive-status-banner')?.classList.add('hidden');
  });

  // ─── Filtered Snapshots (Defaults to 7D) ───
  function getFilteredSnapshots(): CompetitorSnapshot[] {
    if (!snapshotsList || snapshotsList.length === 0) return [];
    
    const sorted = [...snapshotsList].sort((a, b) => new Date(a.recorded_at).getTime() - new Date(b.recorded_at).getTime());
    const now = Date.now();

    let filtered = sorted;

    if (activeTimeRange === '7D') {
      filtered = sorted.filter(s => now - new Date(s.recorded_at).getTime() <= 7 * 86400000);
    } else if (activeTimeRange === '30D') {
      filtered = sorted.filter(s => now - new Date(s.recorded_at).getTime() <= 30 * 86400000);
    } else if (activeTimeRange === '90D') {
      filtered = sorted.filter(s => now - new Date(s.recorded_at).getTime() <= 90 * 86400000);
    } else if (activeTimeRange === 'YTD') {
      const yearStart = new Date(new Date().getFullYear(), 0, 1).getTime();
      filtered = sorted.filter(s => new Date(s.recorded_at).getTime() >= yearStart);
    }

    if (selectedMonth !== 'all') {
      filtered = filtered.filter(s => {
        const d = new Date(s.recorded_at);
        const mKey = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        return mKey === selectedMonth;
      });
    }

    return filtered.length > 0 ? filtered : sorted;
  }

  // ─── PERFORMANCE TREND (Accurate Min/Max, Smooth Spline & Stable Tooltip Overlay) ───
  function renderVisualGrowthChart(snapshots: CompetitorSnapshot[]) {
    const growthChartSvg = document.getElementById('growth-chart-svg');
    const statMin = document.getElementById('chart-stat-min');
    const statMax = document.getElementById('chart-stat-max');
    const statLatest = document.getElementById('chart-stat-latest');
    const tooltipBox = document.getElementById('chart-tooltip-box');
    if (!growthChartSvg) return;

    if (!snapshots || snapshots.length === 0) {
      growthChartSvg.innerHTML = `
        <text x="400" y="110" text-anchor="middle" fill="currentColor" class="text-xs text-muted-foreground font-sans">
          No historical snapshot data recorded yet.
        </text>
      `;
      if (statMin) statMin.textContent = '—';
      if (statMax) statMax.textContent = '—';
      if (statLatest) statLatest.textContent = '—';
      return;
    }

    const width = 800;
    const height = 220;
    const paddingLeft = 55;
    const paddingRight = 30;
    const paddingTop = 25;
    const paddingBottom = 35;

    const chartWidth = width - paddingLeft - paddingRight;
    const chartHeight = height - paddingTop - paddingBottom;

    // Determine series values & style
    let valuesA: number[] = [];
    let valuesB: number[] = [];
    let labelA = 'Monthly Reach';
    let labelB = 'Profile Views';
    let strokeColorA = '#f43f5e'; // rose-500
    let strokeColorB = '#0ea5e9'; // sky-500
    let isDual = activeChartMode === 'dual';

    if (activeChartMode === 'reach') {
      valuesA = snapshots.map(s => s.profile_reach || 0);
      labelA = 'Monthly Reach';
      strokeColorA = '#f43f5e';
    } else if (activeChartMode === 'views') {
      valuesA = snapshots.map(s => s.profile_views || 0);
      labelA = 'Profile Views';
      strokeColorA = '#0ea5e9';
    } else if (activeChartMode === 'followers') {
      valuesA = snapshots.map(s => s.follower_count || 0);
      labelA = 'Followers';
      strokeColorA = '#a855f7';
    } else if (activeChartMode === 'pins') {
      valuesA = snapshots.map(s => s.pin_count || 0);
      labelA = 'Total Pins';
      strokeColorA = '#10b981';
    } else if (activeChartMode === 'dual') {
      valuesA = snapshots.map(s => s.profile_reach || 0);
      valuesB = snapshots.map(s => s.profile_views || 0);
      labelA = 'Monthly Reach';
      labelB = 'Profile Views';
      strokeColorA = '#f43f5e';
      strokeColorB = '#0ea5e9';
    }

    // Accurate calculation of real Min & Max (without hardcoded 0!)
    const allVals = [...valuesA, ...(valuesB.length > 0 ? valuesB : [])].filter(v => typeof v === 'number');
    if (allVals.length === 0) allVals.push(0);
    const rawMax = Math.max(...allVals);
    const rawMin = Math.min(...allVals);

    let minVal: number;
    let maxVal: number;

    if (rawMax === rawMin) {
      minVal = Math.max(0, Math.floor(rawMin * 0.9));
      maxVal = Math.ceil(rawMax * 1.1) || 10;
    } else {
      const span = rawMax - rawMin;
      const pad = span * 0.15;
      minVal = Math.max(0, Math.floor(rawMin - pad));
      maxVal = Math.ceil(rawMax + pad);
    }

    const valSpan = maxVal - minVal || 1;

    // Update Stats Sub-bar with real values
    if (statMin) statMin.textContent = formatNumber(rawMin);
    if (statMax) statMax.textContent = formatNumber(rawMax);
    if (statLatest) statLatest.textContent = formatNumber(valuesA[valuesA.length - 1] || 0);

    // Map points
    const pointsA = snapshots.map((s, idx) => {
      const x = paddingLeft + (snapshots.length === 1 ? chartWidth / 2 : (idx / (snapshots.length - 1)) * chartWidth);
      const val = valuesA[idx] || 0;
      const y = paddingTop + chartHeight - ((val - minVal) / valSpan) * chartHeight;
      const dateObj = new Date(s.recorded_at);
      const dateLabel = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      return { x, y, val, s, dateLabel };
    });

    const pointsB = isDual ? snapshots.map((s, idx) => {
      const x = paddingLeft + (snapshots.length === 1 ? chartWidth / 2 : (idx / (snapshots.length - 1)) * chartWidth);
      const val = valuesB[idx] || 0;
      const y = paddingTop + chartHeight - ((val - minVal) / valSpan) * chartHeight;
      const dateObj = new Date(s.recorded_at);
      const dateLabel = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      return { x, y, val, s, dateLabel };
    }) : [];

    // Helper: Build smooth curve path
    function buildPath(pts: typeof pointsA): { linePath: string; areaPath: string } {
      if (pts.length === 1) {
        const line = `M ${paddingLeft} ${pts[0].y} L ${width - paddingRight} ${pts[0].y}`;
        const area = `M ${paddingLeft} ${pts[0].y} L ${width - paddingRight} ${pts[0].y} L ${width - paddingRight} ${paddingTop + chartHeight} L ${paddingLeft} ${paddingTop + chartHeight} Z`;
        return { linePath: line, areaPath: area };
      }

      let line = `M ${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
      for (let i = 0; i < pts.length - 1; i++) {
        const p0 = pts[i];
        const p1 = pts[i + 1];
        const mx = (p0.x + p1.x) / 2;
        line += ` C ${mx.toFixed(1)} ${p0.y.toFixed(1)}, ${mx.toFixed(1)} ${p1.y.toFixed(1)}, ${p1.x.toFixed(1)} ${p1.y.toFixed(1)}`;
      }

      const area = `${line} L ${pts[pts.length - 1].x.toFixed(1)} ${(paddingTop + chartHeight).toFixed(1)} L ${pts[0].x.toFixed(1)} ${(paddingTop + chartHeight).toFixed(1)} Z`;
      return { linePath: line, areaPath: area };
    }

    const pathDataA = buildPath(pointsA);
    const pathDataB = isDual ? buildPath(pointsB) : null;

    // Grid lines (subtle & elegant)
    const gridLines = [0, 0.5, 1].map(ratio => {
      const y = paddingTop + chartHeight * (1 - ratio);
      return `
        <line x1="${paddingLeft}" y1="${y.toFixed(1)}" x2="${(width - paddingRight).toFixed(1)}" y2="${y.toFixed(1)}" stroke="currentColor" class="text-border/60" stroke-dasharray="4,4" stroke-opacity="0.5"/>
      `;
    }).join('');

    // Sample X-axis labels
    const maxLabels = 6;
    const step = Math.max(1, Math.ceil(pointsA.length / maxLabels));
    const sampledPoints = pointsA.filter((_, idx) => idx === 0 || idx === pointsA.length - 1 || idx % step === 0);

    const xLabels = sampledPoints.map(p => `
      <text x="${p.x.toFixed(1)}" y="${height - 10}" text-anchor="middle" font-size="9.5" font-weight="500" fill="currentColor" class="text-muted-foreground">${p.dateLabel}</text>
    `).join('');

    // Stable Circular Points (Fixed radius without CSS layout scale-hopping to prevent flicker)
    const circlesA = pointsA.map((p, idx) => `
      <circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4.5" fill="${strokeColorA}" stroke="white" stroke-width="2" class="chart-interactive-dot cursor-pointer" data-point-idx="${idx}" data-series="A"></circle>
    `).join('');

    const circlesB = isDual ? pointsB.map((p, idx) => `
      <circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="4.5" fill="${strokeColorB}" stroke="white" stroke-width="2" class="chart-interactive-dot cursor-pointer" data-point-idx="${idx}" data-series="B"></circle>
    `).join('') : '';

    growthChartSvg.innerHTML = `
      <defs>
        <linearGradient id="chart-area-grad-a" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="${strokeColorA}" stop-opacity="0.18" />
          <stop offset="100%" stop-color="${strokeColorA}" stop-opacity="0.00" />
        </linearGradient>
        ${isDual ? `
        <linearGradient id="chart-area-grad-b" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="${strokeColorB}" stop-opacity="0.14" />
          <stop offset="100%" stop-color="${strokeColorB}" stop-opacity="0.00" />
        </linearGradient>
        ` : ''}
      </defs>
      ${gridLines}
      <path d="${pathDataA.areaPath}" fill="url(#chart-area-grad-a)"/>
      <path d="${pathDataA.linePath}" fill="none" stroke="${strokeColorA}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      ${pathDataB ? `
        <path d="${pathDataB.areaPath}" fill="url(#chart-area-grad-b)"/>
        <path d="${pathDataB.linePath}" fill="none" stroke="${strokeColorB}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4,4"/>
      ` : ''}
      ${circlesA}
      ${circlesB}
      ${xLabels}
    `;

    // ─── Rock-Solid Tooltip Hover Handler (No Reflow/Flicker) ───
    const dots = growthChartSvg.querySelectorAll<SVGCircleElement>('.chart-interactive-dot');
    const container = document.getElementById('chart-container');

    dots.forEach(dot => {
      dot.addEventListener('mouseenter', (e) => {
        if (!tooltipBox || !container) return;
        const idx = parseInt(dot.getAttribute('data-point-idx') || '0', 10);
        const pA = pointsA[idx];
        const pB = isDual ? pointsB[idx] : null;

        if (!pA) return;

        let content = `
          <div class="font-bold text-foreground pb-0.5 border-b border-border/60">${pA.dateLabel}</div>
          <div class="pt-1 space-y-1">
            <div class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full flex-shrink-0" style="background:${strokeColorA}"></span>
              <span class="text-[11px] text-muted-foreground">${labelA}:</span>
              <strong class="text-neutral-900 dark:text-neutral-100 font-mono font-bold ml-auto">${formatNumber(pA.val)}</strong>
            </div>
            ${pB ? `
            <div class="flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full flex-shrink-0" style="background:${strokeColorB}"></span>
              <span class="text-[11px] text-muted-foreground">${labelB}:</span>
              <strong class="text-neutral-900 dark:text-neutral-100 font-mono font-bold ml-auto">${formatNumber(pB.val)}</strong>
            </div>
            ` : ''}
          </div>
        `;

        tooltipBox.innerHTML = content;
        tooltipBox.classList.remove('hidden');

        // Position tooltip accurately
        const containerRect = container.getBoundingClientRect();
        const dotRect = dot.getBoundingClientRect();

        const relX = dotRect.left - containerRect.left + dotRect.width / 2;
        const relY = dotRect.top - containerRect.top;

        const leftPos = Math.max(10, Math.min(relX - 70, containerRect.width - 150));
        const topPos = Math.max(5, relY - 65);

        tooltipBox.style.left = `${leftPos}px`;
        tooltipBox.style.top = `${topPos}px`;
      });

      dot.addEventListener('mouseleave', () => {
        tooltipBox?.classList.add('hidden');
      });
    });
  }

  // ─── Chart Mode Switchers ───
  const chartModeBtns = document.querySelectorAll<HTMLButtonElement>('.chart-mode-btn');
  chartModeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      chartModeBtns.forEach(b => {
        b.className = 'chart-mode-btn px-3 py-1 rounded-lg text-xs font-medium text-muted-foreground hover:text-foreground transition-all whitespace-nowrap cursor-pointer';
      });
      btn.className = 'chart-mode-btn px-3 py-1 rounded-lg text-xs font-bold bg-primary text-primary-foreground shadow-2xs transition-all whitespace-nowrap cursor-pointer';
      activeChartMode = (btn.dataset.chartMode as any) || 'reach';
      const filtered = getFilteredSnapshots();
      renderVisualGrowthChart(filtered);
    });
  });

  // ─── Pinning Velocity Calculator ───
  function calculatePinningVelocity(snapshots: CompetitorSnapshot[]) {
    const pinningVelocityVal = document.getElementById('pinning-velocity-val');
    const pinningVelocitySub = document.getElementById('pinning-velocity-sub');
    const velocityPinsAdded = document.getElementById('velocity-pins-added');
    const velocityDaysSpan = document.getElementById('velocity-days-span');
    const velocityMonthlyRate = document.getElementById('velocity-monthly-rate');

    if (!pinningVelocityVal || !pinningVelocitySub) return;

    if (!snapshots || snapshots.length < 2) {
      pinningVelocityVal.textContent = '0.0 Pins/Day';
      if (velocityPinsAdded) velocityPinsAdded.textContent = '+0';
      if (velocityDaysSpan) velocityDaysSpan.textContent = '1 day';
      if (velocityMonthlyRate) velocityMonthlyRate.textContent = '~0 pins/mo';
      return;
    }

    const earliest = snapshots[0];
    const latest = snapshots[snapshots.length - 1];

    const earliestTime = new Date(earliest.recorded_at).getTime();
    const latestTime = new Date(latest.recorded_at).getTime();

    const rawDiffDays = (latestTime - earliestTime) / (1000 * 60 * 60 * 24);
    const daysSpan = Math.max(1, Math.round(rawDiffDays));
    const pinsAdded = (latest.pin_count || 0) - (earliest.pin_count || 0);

    const pinsPerDay = pinsAdded > 0 ? (pinsAdded / daysSpan).toFixed(1) : '0.0';
    const estimatedMonthly = Math.round((pinsAdded / daysSpan) * 30);

    pinningVelocityVal.textContent = `${pinsPerDay} Pins/Day`;
    pinningVelocitySub.textContent = `Rolling pacing evaluated over ${daysSpan} day(s).`;

    if (velocityPinsAdded) velocityPinsAdded.textContent = `${pinsAdded >= 0 ? '+' : ''}${formatNumber(pinsAdded)}`;
    if (velocityDaysSpan) velocityDaysSpan.textContent = `${daysSpan} days`;
    if (velocityMonthlyRate) velocityMonthlyRate.textContent = `~${formatNumber(estimatedMonthly)} pins/mo`;
  }

  // ─── Month Dropdown Populator ───
  function populateMonthDropdowns() {
    if (!snapshotsList || snapshotsList.length === 0) return;

    const monthsMap = new Map<string, string>();
    snapshotsList.forEach(s => {
      const d = new Date(s.recorded_at);
      if (!isNaN(d.getTime())) {
        const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        const label = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
        monthsMap.set(key, label);
      }
    });

    const monthsArr = Array.from(monthsMap.entries()).sort((a, b) => b[0].localeCompare(a[0]));
    const snapshotMonthSelect = document.getElementById('snapshot-month-select') as HTMLSelectElement | null;
    const momMonthASelect = document.getElementById('mom-month-a') as HTMLSelectElement | null;
    const momMonthBSelect = document.getElementById('mom-month-b') as HTMLSelectElement | null;

    if (snapshotMonthSelect) {
      snapshotMonthSelect.innerHTML = `<option value="all">All Months</option>` +
        monthsArr.map(([key, label]) => `<option value="${key}">${label}</option>`).join('');
    }

    if (momMonthASelect && momMonthBSelect) {
      const optionsHtml = monthsArr.map(([key, label]) => `<option value="${key}">${label}</option>`).join('');
      momMonthASelect.innerHTML = optionsHtml;
      momMonthBSelect.innerHTML = optionsHtml;

      if (monthsArr.length >= 2) {
        momMonthASelect.value = monthsArr[1][0];
        momMonthBSelect.value = monthsArr[0][0];
      }
    }
  }

  // ─── MoM Comparison Engine ───
  function renderMoMComparison() {
    const momComparisonGrid = document.getElementById('mom-comparison-grid');
    const momMonthASelect = document.getElementById('mom-month-a') as HTMLSelectElement | null;
    const momMonthBSelect = document.getElementById('mom-month-b') as HTMLSelectElement | null;
    if (!momComparisonGrid || !snapshotsList || snapshotsList.length === 0) return;

    const monthAKey = momMonthASelect?.value;
    const monthBKey = momMonthBSelect?.value;
    if (!monthAKey || !monthBKey) return;

    const snapshotsA = snapshotsList.filter(s => {
      const d = new Date(s.recorded_at);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` === monthAKey;
    }).sort((a, b) => new Date(b.recorded_at).getTime() - new Date(a.recorded_at).getTime());

    const snapshotsB = snapshotsList.filter(s => {
      const d = new Date(s.recorded_at);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` === monthBKey;
    }).sort((a, b) => new Date(b.recorded_at).getTime() - new Date(a.recorded_at).getTime());

    const snapA = snapshotsA[0] || snapshotsList[0];
    const snapB = snapshotsB[0] || snapshotsList[snapshotsList.length - 1];

    const reachChange = (snapB.profile_reach || 0) - (snapA.profile_reach || 0);
    const reachPct = (snapA.profile_reach || 0) > 0 ? (reachChange / snapA.profile_reach) * 100 : 0;

    const viewsChange = (snapB.profile_views || 0) - (snapA.profile_views || 0);
    const viewsPct = (snapA.profile_views || 0) > 0 ? (viewsChange / snapA.profile_views) * 100 : 0;

    const followersChange = (snapB.follower_count || 0) - (snapA.follower_count || 0);
    const followersPct = (snapA.follower_count || 0) > 0 ? (followersChange / snapA.follower_count) * 100 : 0;

    const pinsChange = (snapB.pin_count || 0) - (snapA.pin_count || 0);
    const pinsPct = (snapA.pin_count || 0) > 0 ? (pinsChange / snapA.pin_count) * 100 : 0;

    const createMetricCard = (title: string, valA: number, valB: number, change: number, pct: number) => {
      const isPos = change > 0;
      const badgeStyle = isPos 
        ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' 
        : change < 0 ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20' : 'bg-muted text-muted-foreground border border-border';

      return `
        <div class="rounded-xl border border-border/80 bg-card p-3.5 shadow-2xs space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">${title}</span>
            <span class="rounded-full px-2 py-0.5 text-[10px] font-bold ${badgeStyle}">${change >= 0 ? '+' : ''}${pct.toFixed(1)}%</span>
          </div>
          <div class="text-xl font-bold text-foreground font-mono tabular-nums">${formatNumber(valB)}</div>
          <div class="flex items-center justify-between text-[11px] text-muted-foreground pt-1.5 border-t border-border/60">
            <span>Base (${monthAKey}): ${formatNumber(valA)}</span>
            <span class="font-bold font-mono tabular-nums ${isPos ? 'text-emerald-500' : change < 0 ? 'text-rose-500' : ''}">${change >= 0 ? '+' : ''}${formatNumber(change)}</span>
          </div>
        </div>
      `;
    };

    momComparisonGrid.innerHTML = `
      ${createMetricCard('Monthly Reach', snapA.profile_reach || 0, snapB.profile_reach || 0, reachChange, reachPct)}
      ${createMetricCard('Profile Views', snapA.profile_views || 0, snapB.profile_views || 0, viewsChange, viewsPct)}
      ${createMetricCard('Followers', snapA.follower_count || 0, snapB.follower_count || 0, followersChange, followersPct)}
      ${createMetricCard('Total Pins', snapA.pin_count || 0, snapB.pin_count || 0, pinsChange, pinsPct)}
    `;
  }

  // ─── Snapshot Table Density, Columns & Number Format ───
