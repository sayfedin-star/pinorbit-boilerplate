  // ─── Fast-Loading Lazy Boards Engine ───
  function attachLoadBoardsBtnHandler() {
    const loadBtn = document.getElementById('load-boards-btn');
    if (!loadBtn) return;
    loadBtn.addEventListener('click', handleLoadBoards);
  }

  async function handleLoadBoards() {
    const boardsTableBody = document.getElementById('boards-table-body');
    const boardsPaginationBar = document.getElementById('boards-pagination-bar');
    if (!boardsTableBody) return;

    boardsTableBody.innerHTML = `
      <tr>
        <td colspan="6" class="p-8 text-center text-xs text-muted-foreground animate-pulse">
          <div class="max-w-md mx-auto space-y-2.5">
            <div class="h-3.5 bg-muted rounded w-3/4 mx-auto animate-pulse"></div>
            <div class="h-3.5 bg-muted rounded w-1/2 mx-auto animate-pulse"></div>
          </div>
          <p class="mt-3 text-xs text-muted-foreground font-medium">Fetching Pinterest board strategy timeline…</p>
        </td>
      </tr>
    `;

    try {
      const res = await getCompetitorBoardsOnly(competitorId);
      boardsList = res.boards || [];
      boardsLoaded = true;
      const boardsCountBadge = document.getElementById('boards-count-badge');
      if (boardsCountBadge) boardsCountBadge.textContent = `${boardsList.length} ${boardsList.length === 1 ? 'Board' : 'Boards'}`;
      if (boardsPaginationBar) boardsPaginationBar.classList.remove('hidden');
      currentBoardPage = 1;
      renderBoardsTable();
    } catch (err: any) {
      boardsTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="p-8 text-center text-xs text-rose-500">
            <span>Failed to load boards: ${err.message || 'Network error'}</span>
            <button id="retry-boards-btn" class="ml-3 font-bold underline hover:text-rose-600 cursor-pointer">Retry</button>
          </td>
        </tr>
      `;
      document.getElementById('retry-boards-btn')?.addEventListener('click', handleLoadBoards);
    }
  }

  function renderBoardsTable() {
    const boardsTableBody = document.getElementById('boards-table-body');
    const boardsCountBadge = document.getElementById('boards-count-badge');
    const boardsPaginationInfo = document.getElementById('boards-pagination-info');
    const boardsPageIndicator = document.getElementById('boards-page-indicator');
    const boardsPrevPageBtn = document.getElementById('boards-prev-page-btn') as HTMLButtonElement | null;
    const boardsNextPageBtn = document.getElementById('boards-next-page-btn') as HTMLButtonElement | null;

    if (!boardsTableBody) return;

    // Filter by search query
    let filtered = boardsList.filter(b => {
      if (!boardSearchQuery) return true;
      const q = boardSearchQuery.toLowerCase();
      const nameMatch = b.name.toLowerCase().includes(q);
      const descMatch = b.description ? b.description.toLowerCase().includes(q) : false;
      return nameMatch || descMatch;
    });

    // Sort boards
    filtered.sort((a, b) => {
      if (boardSortKey === 'most_pins') {
        return (b.pin_count || 0) - (a.pin_count || 0);
      } else if (boardSortKey === 'most_followers') {
        return (b.follower_count || 0) - (a.follower_count || 0);
      } else if (boardSortKey === 'recent_activity') {
        return new Date(b.last_pinned_at || 0).getTime() - new Date(a.last_pinned_at || 0).getTime();
      } else if (boardSortKey === 'creation_date') {
        return new Date(b.board_created_at || 0).getTime() - new Date(a.board_created_at || 0).getTime();
      }
      return 0;
    });

    if (boardsCountBadge) boardsCountBadge.textContent = `${filtered.length} ${filtered.length === 1 ? 'Board' : 'Boards'}`;

    if (filtered.length === 0) {
      boardsTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="p-12 text-center text-xs text-muted-foreground bg-muted/10">
            ${boardsList.length === 0 ? 'No Pinterest boards recorded yet for this competitor. Click <span class="font-semibold text-foreground">Paste DevTools Payload</span> to ingest boards!' : 'No boards match your search query.'}
          </td>
        </tr>
      `;
      if (boardsPaginationInfo) boardsPaginationInfo.textContent = 'Showing 0 of 0 boards';
      if (boardsPageIndicator) boardsPageIndicator.textContent = 'Page 1 of 1';
      if (boardsPrevPageBtn) boardsPrevPageBtn.disabled = true;
      if (boardsNextPageBtn) boardsNextPageBtn.disabled = true;
      return;
    }

    const totalPages = Math.ceil(filtered.length / boardsPageSize);
    if (currentBoardPage > totalPages) currentBoardPage = totalPages;
    if (currentBoardPage < 1) currentBoardPage = 1;

    const startIdx = (currentBoardPage - 1) * boardsPageSize;
    const endIdx = Math.min(startIdx + boardsPageSize, filtered.length);
    const paginatedSlice = filtered.slice(startIdx, endIdx);

    const padClass = isComfortableDensity ? 'py-3.5' : 'py-2';

    boardsTableBody.innerHTML = paginatedSlice
      .map((b) => {
        const rawBoardUrl = b.url ? (b.url.startsWith('http') ? b.url : `https://www.pinterest.com${b.url}`) : `https://www.pinterest.com/${competitorData?.username}/`;
        const boardUrl = /^https?:\/\//i.test(rawBoardUrl) ? rawBoardUrl : '#';
        return `
          <tr class="hover:bg-muted/40 transition-colors group">
            <td class="${padClass} px-5">
              <div class="flex flex-col min-w-0">
                <span class="text-xs font-bold text-neutral-900 dark:text-neutral-100 truncate">${escHtml(b.name)}</span>
                <p class="text-[11px] text-muted-foreground line-clamp-1 max-w-md mt-0.5">${escHtml(b.description || 'No description provided')}</p>
              </div>
            </td>
            <td class="${padClass} px-4 font-semibold text-foreground whitespace-nowrap">
              ${formatDate(b.board_created_at)}
            </td>
            <td class="${padClass} px-4 text-muted-foreground whitespace-nowrap">
              ${formatDate(b.last_pinned_at)}
            </td>
            <td class="${padClass} px-4 text-right font-bold text-neutral-900 dark:text-neutral-100 font-mono tabular-nums">
              ${formatNumber(b.pin_count || 0)}
            </td>
            <td class="${padClass} px-4 text-right font-semibold text-neutral-900 dark:text-neutral-100 font-mono tabular-nums">
              ${formatNumber(b.follower_count || 0)}
            </td>
            <td class="${padClass} px-5 text-right">
              <a
                href="${escHtml(boardUrl)}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-xl border border-border/80 bg-background px-2.5 py-1 text-xs font-semibold text-foreground hover:bg-muted hover:text-primary transition-all shadow-2xs"
              >
                <span>Board</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </td>
          </tr>
        `;
      })
      .join('');

    if (boardsPaginationInfo) boardsPaginationInfo.textContent = `Showing ${startIdx + 1}–${endIdx} of ${filtered.length} boards`;
    if (boardsPageIndicator) boardsPageIndicator.textContent = `Page ${currentBoardPage} of ${totalPages}`;
    if (boardsPrevPageBtn) boardsPrevPageBtn.disabled = currentBoardPage <= 1;
    if (boardsNextPageBtn) boardsNextPageBtn.disabled = currentBoardPage >= totalPages;
  }

  // ─── Filter & Control Event Listeners ───
  const rangeBtns = document.querySelectorAll<HTMLButtonElement>('.time-range-btn');
  rangeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rangeBtns.forEach(b => {
        b.className = 'time-range-btn rounded-lg px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all cursor-pointer';
      });
      btn.className = 'time-range-btn rounded-lg px-2.5 py-1 text-xs font-bold bg-background text-foreground shadow-2xs transition-all cursor-pointer';
      
      activeTimeRange = btn.dataset.range || '7D';
      const filtered = getFilteredSnapshots();
      renderVisualGrowthChart(filtered);
      calculatePinningVelocity(filtered);
    });
  });

  const snapshotMonthSelect = document.getElementById('snapshot-month-select');
  snapshotMonthSelect?.addEventListener('change', () => {
    selectedMonth = (snapshotMonthSelect as HTMLSelectElement).value;
    const filtered = getFilteredSnapshots();
    renderVisualGrowthChart(filtered);
    calculatePinningVelocity(filtered);
  });

  const toggleComparisonBtn = document.getElementById('toggle-comparison-mode-btn');
  const momComparisonPanel = document.getElementById('mom-comparison-panel');
  toggleComparisonBtn?.addEventListener('click', () => {
    isComparisonMode = !isComparisonMode;
    if (isComparisonMode) {
      momComparisonPanel?.classList.remove('hidden');
      toggleComparisonBtn.className = 'inline-flex h-8 items-center gap-1.5 rounded-xl border border-primary/40 bg-primary/10 text-primary px-3 text-xs font-bold transition-all shadow-2xs cursor-pointer';
      renderMoMComparison();
    } else {
      momComparisonPanel?.classList.add('hidden');
      toggleComparisonBtn.className = 'inline-flex h-8 items-center gap-1.5 rounded-xl border border-border/80 bg-muted/40 hover:bg-muted px-3 text-xs font-semibold text-foreground shadow-2xs transition-all cursor-pointer';
    }
  });

  document.getElementById('mom-month-a')?.addEventListener('change', renderMoMComparison);
  document.getElementById('mom-month-b')?.addEventListener('change', renderMoMComparison);

  const boardSearchInput = document.getElementById('board-search-input');
  boardSearchInput?.addEventListener('input', () => {
    boardSearchQuery = (boardSearchInput as HTMLInputElement).value.trim();
    currentBoardPage = 1;
    renderBoardsTable();
  });

  const boardSortSelect = document.getElementById('board-sort-select');
  boardSortSelect?.addEventListener('change', () => {
    boardSortKey = (boardSortSelect as HTMLSelectElement).value;
    currentBoardPage = 1;
    renderBoardsTable();
  });

  document.getElementById('boards-prev-page-btn')?.addEventListener('click', () => {
    if (currentBoardPage > 1) {
      currentBoardPage--;
      renderBoardsTable();
    }
  });

  document.getElementById('boards-next-page-btn')?.addEventListener('click', () => {
    currentBoardPage++;
    renderBoardsTable();
  });

  // ─── Main Details Loader ───
  async function loadDetails() {
    try {
      const details = await getCompetitorLite(competitorId);
      competitorData = details.competitor;
      snapshotsList = details.snapshots || [];
      deltasData = details.deltas;

      const competitorAvatar = document.getElementById('competitor-avatar') as HTMLImageElement | null;
      const competitorFullname = document.getElementById('competitor-fullname');
      const competitorHandle = document.getElementById('competitor-handle');
      const competitorNicheBadge = document.getElementById('competitor-niche-badge');
      const competitorNotes = document.getElementById('competitor-notes');
      const strategyAgeVal = document.getElementById('strategy-age-val');
      const oldestBoardDateStr = document.getElementById('oldest-board-date-str');
      const competitorPinterestLink = document.getElementById('competitor-pinterest-link') as HTMLAnchorElement | null;
      const competitorWebsiteContainer = document.getElementById('competitor-website-container');
      const competitorWebsiteLink = document.getElementById('competitor-website-link') as HTMLAnchorElement | null;
      const competitorWebsiteText = document.getElementById('competitor-website-text');
      const competitorVerifiedBadge = document.getElementById('competitor-verified-badge');
      const competitorLastPinStr = document.getElementById('competitor-last-pin-str');

      const currentReach = document.getElementById('current-reach');
      const currentViews = document.getElementById('current-views');
      const currentFollowers = document.getElementById('current-followers');
      const currentPins = document.getElementById('current-pins');

      const deltaReachBadge = document.getElementById('delta-reach-badge');
      const deltaViewsBadge = document.getElementById('delta-views-badge');
      const deltaFollowersBadge = document.getElementById('delta-followers-badge');
      const deltaPinsBadge = document.getElementById('delta-pins-badge');

      const deltaReachSub = document.getElementById('delta-reach-sub');
      const deltaViewsSub = document.getElementById('delta-views-sub');
      const deltaFollowersSub = document.getElementById('delta-followers-sub');
      const deltaPinsSub = document.getElementById('delta-pins-sub');

      if (!competitorData) {
        if (competitorFullname) competitorFullname.textContent = 'Competitor Not Found';
        return;
      }

      // Populate Header
      if (competitorAvatar) competitorAvatar.src = competitorData.avatar_url || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&h=200&q=80';
      if (competitorFullname) competitorFullname.textContent = competitorData.full_name || competitorData.username;
      if (competitorHandle) competitorHandle.textContent = `@${competitorData.username}`;
      if (competitorNicheBadge) competitorNicheBadge.textContent = competitorData.niche || 'General';
      if (competitorNotes) competitorNotes.textContent = competitorData.notes || 'No internal notes set for this competitor.';

      const typeBadge = document.getElementById('competitor-type-badge');
      const tagsContainer = document.getElementById('competitor-tags-container');

      if (typeBadge) {
        if (competitorData.account_type === 'own') {
          typeBadge.textContent = '👤 My Account';
          typeBadge.className = 'rounded-full bg-blue-500/10 px-2.5 py-0.5 text-[11px] font-bold text-blue-600 dark:text-blue-400 border border-blue-500/20';
        } else {
          typeBadge.textContent = '🎯 Competitor';
          typeBadge.className = 'rounded-full bg-purple-500/10 px-2.5 py-0.5 text-[11px] font-bold text-purple-600 dark:text-purple-400 border border-purple-500/20';
        }
      }

      if (tagsContainer) {
        if (Array.isArray(competitorData.tags) && competitorData.tags.length > 0) {
          tagsContainer.innerHTML = competitorData.tags
            .map((t) => `<span class="rounded-lg bg-muted px-2 py-0.5 text-[10px] font-semibold text-muted-foreground border border-border/50">#${escHtml(t)}</span>`)
            .join('');
        } else {
          tagsContainer.innerHTML = '';
        }
      }

      if (competitorPinterestLink) {
        competitorPinterestLink.href = `https://www.pinterest.com/${encodeURIComponent(competitorData.username)}/`;
      }

      // Website & Domain Verified Status
      if (competitorData.website_url && /^https?:\/\//i.test(competitorData.website_url)) {
        if (competitorWebsiteContainer) competitorWebsiteContainer.classList.remove('hidden');
        if (competitorWebsiteLink) competitorWebsiteLink.href = competitorData.website_url;
        if (competitorWebsiteText) competitorWebsiteText.textContent = competitorData.website_url.replace(/^https?:\/\//, '').replace(/\/$/, '');
        if (competitorVerifiedBadge) {
          if (competitorData.domain_verified) {
            competitorVerifiedBadge.classList.remove('hidden');
          } else {
            competitorVerifiedBadge.classList.add('hidden');
          }
        }
      } else {
        if (competitorWebsiteContainer) competitorWebsiteContainer.classList.add('hidden');
      }

      // Last Pin Timestamp
      if (competitorLastPinStr) {
        competitorLastPinStr.textContent = competitorData.last_pin_at ? `Last Pin: ${formatDate(competitorData.last_pin_at)}` : 'Last Pin: N/A';
      }

      // Strategy Age
      if (strategyAgeVal) strategyAgeVal.textContent = competitorData.strategy_age_days ? `${competitorData.strategy_age_days} Days` : 'Unknown';
      if (oldestBoardDateStr) oldestBoardDateStr.textContent = competitorData.oldest_board_date ? `Oldest board: ${formatDate(competitorData.oldest_board_date)}` : 'No boards recorded yet';

      // Primary Metrics
      if (currentReach) currentReach.textContent = formatNumber(competitorData.profile_reach || 0);
      if (currentViews) currentViews.textContent = formatNumber(competitorData.profile_views || 0);
      if (currentFollowers) currentFollowers.textContent = formatNumber(competitorData.follower_count || 0);
      if (currentPins) currentPins.textContent = formatNumber(competitorData.pin_count || 0);

      if (deltasData) {
        if (deltaReachBadge && deltaReachSub) renderDeltaBadge(deltaReachBadge, deltaReachSub, deltasData.reachChange, deltasData.reachPercent);
        if (deltaViewsBadge && deltaViewsSub) renderDeltaBadge(deltaViewsBadge, deltaViewsSub, deltasData.viewsChange, deltasData.viewsPercent);
        if (deltaFollowersBadge && deltaFollowersSub) renderDeltaBadge(deltaFollowersBadge, deltaFollowersSub, deltasData.followersChange, deltasData.followersPercent);
        if (deltaPinsBadge && deltaPinsSub) renderDeltaBadge(deltaPinsBadge, deltaPinsSub, deltasData.pinsChange, deltasData.pinsPercent);
      }

      populateMonthDropdowns();
      const filteredSnapshots = getFilteredSnapshots();
      renderVisualGrowthChart(filteredSnapshots);
      calculatePinningVelocity(filteredSnapshots);

      if (isComparisonMode) {
        renderMoMComparison();
      }

      renderSnapshotsTableHeader();
      renderSnapshotsLogTable();
    } catch (e: any) {
      console.error('Error loading competitor details:', e);
      showStatus(`Error loading competitor: ${e.message}`, true);
    }
  }

  // Refresh button listener
  document.getElementById('refresh-competitor-btn')?.addEventListener('click', () => {
    const icon = document.getElementById('refresh-competitor-icon');
    icon?.classList.add('animate-spin');
    loadDetails().finally(() => {
      setTimeout(() => icon?.classList.remove('animate-spin'), 400);
    });
  });

  // Delete Competitor listener
  document.getElementById('delete-competitor-deepdive-btn')?.addEventListener('click', async () => {
    if (confirm('Are you sure you want to remove this competitor from tracking? This will delete all snapshots and board history.')) {
      try {
        await deleteCompetitor(competitorId);
        window.location.href = '/competitors';
      } catch (err: any) {
        showStatus(`Failed to delete: ${err.message}`, true);
      }
    }
  });

  // Modal Handlers
  const modal = document.getElementById('deepdive-payload-modal');
  const modalForm = document.getElementById('deepdive-payload-form') as HTMLFormElement | null;
  const modalError = document.getElementById('deepdive-modal-error');
  const modalTextarea = document.getElementById('deepdive-payload-textarea') as HTMLTextAreaElement | null;
  const modalDetectedSpan = document.getElementById('deepdive-detected-type');

  function openModal() {
    if (modalError) modalError.classList.add('hidden');
    if (modalForm) modalForm.reset();
    if (modalDetectedSpan) {
      modalDetectedSpan.textContent = 'Waiting for paste…';
      modalDetectedSpan.className = 'rounded-lg bg-muted px-2.5 py-0.5 text-[11px] font-semibold text-foreground';
    }
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  document.getElementById('open-deepdive-paste-modal')?.addEventListener('click', openModal);
  document.getElementById('close-deepdive-modal')?.addEventListener('click', closeModal);
  document.getElementById('cancel-deepdive-modal')?.addEventListener('click', closeModal);

  if (modalTextarea) {
    modalTextarea.addEventListener('input', () => {
      const text = modalTextarea.value.trim();
      if (!text) {
        if (modalDetectedSpan) {
          modalDetectedSpan.textContent = 'Waiting for paste…';
          modalDetectedSpan.className = 'rounded-lg bg-muted px-2.5 py-0.5 text-[11px] font-semibold text-foreground';
        }
        return;
      }

      const parsed = parsePinterestPayload(text);
      if (parsed.type === 'user_profile') {
        if (modalDetectedSpan) {
          modalDetectedSpan.textContent = '✓ User Profile (UserResource)';
          modalDetectedSpan.className = 'rounded-lg bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 px-2.5 py-0.5 text-[11px] font-bold border border-emerald-500/30';
        }
      } else if (parsed.type === 'user_boards') {
        if (modalDetectedSpan) {
          modalDetectedSpan.textContent = '✓ User Boards (BoardsResource)';
          modalDetectedSpan.className = 'rounded-lg bg-primary/20 text-primary px-2.5 py-0.5 text-[11px] font-bold border border-primary/30';
        }
      } else {
        if (modalDetectedSpan) {
          modalDetectedSpan.textContent = '✕ Unknown Payload';
          modalDetectedSpan.className = 'rounded-lg bg-rose-500/20 text-rose-500 px-2.5 py-0.5 text-[11px] font-bold border border-rose-500/30';
        }
      }
    });
  }

  if (modalForm) {
    modalForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payloadText = modalTextarea?.value.trim() || '';
      try {
        const res = await ingestDevToolsPayload(competitorId, payloadText);
        if (res.success) {
          closeModal();
          showStatus(res.message);
          await loadDetails();
          if (boardsLoaded) await handleLoadBoards();
        } else {
          if (modalError) {
            modalError.textContent = res.message;
            modalError.classList.remove('hidden');
          }
        }
      } catch (err: any) {
        if (modalError) {
          modalError.textContent = err.message || 'Ingestion failed';
          modalError.classList.remove('hidden');
        }
      }
    });
  }

  // ─── Initialization ───
  document.addEventListener('DOMContentLoaded', () => {
    buildSnapColVisibilityMenu();
    setupSnapColVisibilityToggle();
    attachLoadBoardsBtnHandler();
    loadDetails();
  });
</script>
