    if (!colMenu) return;
    colMenu.innerHTML = `
      <div class="flex items-center justify-between pb-1 px-1 border-b border-border/80 text-[11px] font-semibold text-muted-foreground">
        <span>Toggle Columns</span>
        <button id="reset-snap-cols-btn" class="text-primary hover:underline text-[10px] cursor-pointer">Reset</button>
