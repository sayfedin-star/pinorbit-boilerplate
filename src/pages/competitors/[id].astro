---
import Layout from '../../layouts/Layout.astro';
import { getCompetitors } from '../../lib/competitors';

export async function getStaticPaths() {
  const competitors = await getCompetitors();
  const fallbackIds = ['comp-1', 'comp-2', 'comp-3'];
  const fetchedIds = (competitors || []).map((c) => c.id);
  const allIds = Array.from(new Set([...fallbackIds, ...fetchedIds]));

  return allIds.map((id) => ({
    params: { id },
  }));
}
---

<Layout title="Competitor Deep-Dive & Analytics Engine" description="Historical growth trajectory, Month-over-Month comparisons, pinning velocity, and board timeline analytics.">
  <!-- Back Button & Action Controls Header -->
  <div class="mb-4 flex items-center justify-between">
