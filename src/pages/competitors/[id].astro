        </select>
      </div>

      <button
        id="toggle-comparison-mode-btn"
        class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-muted/50 px-3.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all"
