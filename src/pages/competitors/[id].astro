        <tbody id="boards-table-body" class="divide-y divide-border">
          <tr>
            <td colspan="6" class="py-12 text-center text-xs text-muted-foreground animate-pulse">
              Loading board strategy timeline...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Boards Pagination Controls Bar -->
    <div id="boards-pagination-bar" class="flex items-center justify-between border-t border-border px-6 py-3 bg-muted/20 text-xs text-muted-foreground">
      <span id="boards-pagination-info">Showing 0 of 0 boards</span>
      <div class="flex items-center gap-2">
        <button
          id="boards-prev-page-btn"
          disabled
          class="rounded-lg border border-border bg-background px-3 py-1 text-xs font-semibold text-foreground hover:bg-muted disabled:opacity-40 disabled:cursor-not-allowed transition-all"
        >
          Previous
        </button>
        <span id="boards-page-indicator" class="font-medium text-foreground">Page 1 of 1</span>
