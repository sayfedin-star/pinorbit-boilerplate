<script>
  import {
    getCompetitorDetails,
    deleteCompetitor,
    deleteCompetitorSnapshot,
    parsePinterestPayload,
    ingestDevToolsPayload,
  } from '../../lib/competitors';
  import type { Competitor, CompetitorBoard, CompetitorSnapshot, CompetitorDeltaStats } from '../../lib/types';
  import { formatNumber } from '../../lib/ui-helpers';

  const escHtml = (s: any) => String(s ?? '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m] as string));

  // Get Competitor ID from URL pathname
  const pathname = window.location.pathname;
  const pathParts = pathname.split('/');
  const competitorId = pathParts[pathParts.length - 1] || pathParts[pathParts.length - 2];

  const deleteDeepdiveBtn = document.getElementById('delete-competitor-deepdive-btn');
  if (deleteDeepdiveBtn) {
    deleteDeepdiveBtn.addEventListener('click', async () => {
      if (confirm('Are you sure you want to remove this competitor from tracking? This will delete all snapshots and board history.')) {
        try {
          await deleteCompetitor(competitorId);
          window.location.href = '/competitors';
        } catch (err: any) {
          showStatus(`Failed to delete: ${err.message}`, true);
        }
      }
    });
  }

  let competitorData: Competitor | null = null;
  let boardsList: CompetitorBoard[] = [];
  let snapshotsList: CompetitorSnapshot[] = []; // raw snapshots (DESC) — drives history log table
  let chartSnapshotsList: CompetitorSnapshot[] = []; // daily rollup (ASC) — drives growth chart
  let deltasData: CompetitorDeltaStats | null = null;

  // Analytics Engine State
  let activeTimeRange = 'ALL';
  let selectedMonth = 'all';
  let isComparisonMode = false;

  // Boards Pagination & Search State
  let boardSearchQuery = '';
  let boardSortKey = 'most_pins';
  let currentBoardPage = 1;
  const boardsPageSize = 10;

  // DOM Elements - Profile Header
  const competitorAvatar = document.getElementById('competitor-avatar') as HTMLImageElement;
  const competitorFullname = document.getElementById('competitor-fullname') as HTMLElement;
  const competitorHandle = document.getElementById('competitor-handle') as HTMLElement;
  const competitorNicheBadge = document.getElementById('competitor-niche-badge') as HTMLElement;
  const competitorPinterestLink = document.getElementById('competitor-pinterest-link') as HTMLAnchorElement;
  const competitorNotes = document.getElementById('competitor-notes') as HTMLElement;
  const strategyAgeVal = document.getElementById('strategy-age-val') as HTMLElement;
  const oldestBoardDateStr = document.getElementById('oldest-board-date-str') as HTMLElement;

  const competitorWebsiteContainer = document.getElementById('competitor-website-container') as HTMLElement;
  const competitorWebsiteLink = document.getElementById('competitor-website-link') as HTMLAnchorElement;
  const competitorWebsiteText = document.getElementById('competitor-website-text') as HTMLElement;
  const competitorVerifiedBadge = document.getElementById('competitor-verified-badge') as HTMLElement;
  const competitorLastPinStr = document.getElementById('competitor-last-pin-str') as HTMLElement;

  // DOM Elements - Primary Deltas
  const currentReach = document.getElementById('current-reach') as HTMLElement;
  const currentViews = document.getElementById('current-views') as HTMLElement;
  const currentFollowers = document.getElementById('current-followers') as HTMLElement;
  const currentPins = document.getElementById('current-pins') as HTMLElement;

  const deltaReachBadge = document.getElementById('delta-reach-badge') as HTMLElement;
  const deltaViewsBadge = document.getElementById('delta-views-badge') as HTMLElement;
  const deltaFollowersBadge = document.getElementById('delta-followers-badge') as HTMLElement;
  const deltaPinsBadge = document.getElementById('delta-pins-badge') as HTMLElement;

  const deltaReachSub = document.getElementById('delta-reach-sub') as HTMLElement;
  const deltaViewsSub = document.getElementById('delta-views-sub') as HTMLElement;
  const deltaFollowersSub = document.getElementById('delta-followers-sub') as HTMLElement;
  const deltaPinsSub = document.getElementById('delta-pins-sub') as HTMLElement;

  // DOM Elements - Analytics Controls & Velocity
  const rangeBtns = document.querySelectorAll<HTMLButtonElement>('.time-range-btn');
  const snapshotMonthSelect = document.getElementById('snapshot-month-select') as HTMLSelectElement;
  const toggleComparisonBtn = document.getElementById('toggle-comparison-mode-btn') as HTMLButtonElement;
  const momComparisonPanel = document.getElementById('mom-comparison-panel') as HTMLElement;
  const momMonthASelect = document.getElementById('mom-month-a') as HTMLSelectElement;
  const momMonthBSelect = document.getElementById('mom-month-b') as HTMLSelectElement;
  const momComparisonGrid = document.getElementById('mom-comparison-grid') as HTMLElement;

  const pinningVelocityVal = document.getElementById('pinning-velocity-val') as HTMLElement;
  const pinningVelocitySub = document.getElementById('pinning-velocity-sub') as HTMLElement;
  const velocityPinsAdded = document.getElementById('velocity-pins-added') as HTMLElement;
  const velocityDaysSpan = document.getElementById('velocity-days-span') as HTMLElement;
  const velocityMonthlyRate = document.getElementById('velocity-monthly-rate') as HTMLElement;

  // DOM Elements - Chart & Boards table
  const growthChartSvg = document.getElementById('growth-chart-svg') as unknown as SVGElement;
  const boardsTableBody = document.getElementById('boards-table-body') as HTMLElement;
  const boardsCountBadge = document.getElementById('boards-count-badge') as HTMLElement;

  const boardSearchInput = document.getElementById('board-search-input') as HTMLInputElement;
  const boardSortSelect = document.getElementById('board-sort-select') as HTMLSelectElement;
  const boardsPaginationInfo = document.getElementById('boards-pagination-info') as HTMLElement;
  const boardsPrevPageBtn = document.getElementById('boards-prev-page-btn') as HTMLButtonElement;
  const boardsNextPageBtn = document.getElementById('boards-next-page-btn') as HTMLButtonElement;
  const boardsPageIndicator = document.getElementById('boards-page-indicator') as HTMLElement;

  // DOM Elements - Snapshots Log Table
  const snapshotsTableBody = document.getElementById('snapshots-table-body') as HTMLElement;
  const snapshotsCountBadge = document.getElementById('snapshots-count-badge') as HTMLElement;

  // DOM Elements - Status & Modal
  const statusBanner = document.getElementById('deepdive-status-banner') as HTMLElement;
  const statusText = document.getElementById('deepdive-status-text') as HTMLElement;
  const dismissStatusBtn = document.getElementById('dismiss-deepdive-status') as HTMLElement;

  const modal = document.getElementById('deepdive-payload-modal') as HTMLElement;
  const openModalBtn = document.getElementById('open-deepdive-paste-modal') as HTMLElement;
  const closeModalBtn = document.getElementById('close-deepdive-modal') as HTMLElement;
  const cancelModalBtn = document.getElementById('cancel-deepdive-modal') as HTMLElement;
  const modalForm = document.getElementById('deepdive-payload-form') as HTMLFormElement;
  const modalError = document.getElementById('deepdive-modal-error') as HTMLElement;
  const modalTextarea = document.getElementById('deepdive-payload-textarea') as HTMLTextAreaElement;
  const modalDetectedSpan = document.getElementById('deepdive-detected-type') as HTMLElement;

  function formatDate(isoStr?: string | null, includeTime = false): string {
    if (!isoStr) return 'N/A';
    const date = new Date(isoStr);
    if (isNaN(date.getTime())) return 'N/A';
    if (includeTime) {
      return date.toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }
    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function renderDeltaBadge(element: HTMLElement, subElement: HTMLElement, change: number, percent: number) {
    if (!element || !subElement) return;
    const sign = change > 0 ? '+' : '';
    element.textContent = `${sign}${percent}%`;

    if (change > 0) {
      element.className = 'rounded bg-emerald-500/15 text-emerald-500 px-2 py-0.5 text-[11px] font-bold';
      subElement.textContent = `+${formatNumber(change)} vs previous snapshot`;
    } else if (change < 0) {
      element.className = 'rounded bg-rose-500/15 text-rose-500 px-2 py-0.5 text-[11px] font-bold';
      subElement.textContent = `${formatNumber(change)} vs previous snapshot`;
    } else {
      element.className = 'rounded bg-muted text-muted-foreground px-2 py-0.5 text-[11px] font-bold';
      subElement.textContent = `No change vs previous snapshot`;
    }
  }

  function showStatus(msg: string, isError = false) {
    if (!statusBanner || !statusText) return;
    statusText.textContent = msg;
    statusBanner.classList.remove('hidden');
    if (isError) {
      statusBanner.className = 'mb-6 rounded-xl border border-rose-500/30 bg-rose-500/10 p-4 text-xs text-rose-600 flex items-center justify-between shadow-sm';
    } else {
      statusBanner.className = 'mb-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-xs text-emerald-600 flex items-center justify-between shadow-sm';
    }
  }

  if (dismissStatusBtn) {
    dismissStatusBtn.addEventListener('click', () => statusBanner.classList.add('hidden'));
  }

  // --- Core Analytics Logic ---


  function getFilteredSnapshots(): CompetitorSnapshot[] {
    // Chart renders from daily rollup data (chartSnapshotsList).
    // Falls back to raw snapshotsList when chartSnapshotsList is empty
    // (e.g. in mock/unconfigured mode where only snapshotsList is populated).
    const source = chartSnapshotsList.length > 0 ? chartSnapshotsList : snapshotsList;
    if (!source || source.length === 0) return [];

    // Daily rollup is already ASC from the server; sort here is a safety guard
    const sorted = [...source].sort((a, b) => new Date(a.recorded_at).getTime() - new Date(b.recorded_at).getTime());
    const now = Date.now();

    let filtered = sorted;

    if (activeTimeRange === '7D') {
      filtered = sorted.filter(s => now - new Date(s.recorded_at).getTime() <= 7 * 86400000);
    } else if (activeTimeRange === '30D') {
      filtered = sorted.filter(s => now - new Date(s.recorded_at).getTime() <= 30 * 86400000);
    } else if (activeTimeRange === '90D') {
      filtered = sorted.filter(s => now - new Date(s.recorded_at).getTime() <= 90 * 86400000);
    } else if (activeTimeRange === 'YTD') {
      const yearStart = new Date(new Date().getFullYear(), 0, 1).getTime();
      filtered = sorted.filter(s => new Date(s.recorded_at).getTime() >= yearStart);
    }

    if (selectedMonth !== 'all') {
      filtered = filtered.filter(s => {
        const d = new Date(s.recorded_at);
        const mKey = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        return mKey === selectedMonth;
      });
    }

    return filtered.length > 0 ? filtered : sorted;
  }


  function renderVisualGrowthChart(snapshots: CompetitorSnapshot[]) {
    if (!growthChartSvg) return;

    if (!snapshots || snapshots.length === 0) {
      growthChartSvg.innerHTML = `
        <text x="400" y="110" text-anchor="middle" fill="currentColor" class="text-xs text-muted-foreground font-sans">
          No historical snapshot data recorded yet.
        </text>
      `;
      return;
    }

    const width = 800;
    const height = 220;
    const paddingLeft = 60;
    const paddingRight = 30;
    const paddingTop = 20;
    const paddingBottom = 40;

    const chartWidth = width - paddingLeft - paddingRight;
    const chartHeight = height - paddingTop - paddingBottom;

    const reaches = snapshots.map(s => s.profile_reach || 0);
    const views = snapshots.map(s => s.profile_views || 0);

    const maxReach = Math.max(...reaches, ...views, 100);
    const minReach = 0;

    // Check if multiple snapshots exist on the same day to format time string
    const points = snapshots.map((s, idx) => {
      const x = paddingLeft + (snapshots.length === 1 ? chartWidth / 2 : (idx / (snapshots.length - 1)) * chartWidth);
      const reachY = paddingTop + chartHeight - (((s.profile_reach || 0) - minReach) / (maxReach - minReach)) * chartHeight;
      const viewsY = paddingTop + chartHeight - (((s.profile_views || 0) - minReach) / (maxReach - minReach)) * chartHeight;

      const dateObj = new Date(s.recorded_at);
      const hasSameDaySibling = snapshots.some((other, oIdx) => {
        if (oIdx === idx) return false;
        const od = new Date(other.recorded_at);
        return od.toDateString() === dateObj.toDateString();
      });

      const dateLabel = hasSameDaySibling
        ? dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ', ' + dateObj.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })
        : dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

      return { x, reachY, viewsY, s, dateLabel };
    });

    let reachPathStr = '';
    let viewsPathStr = '';

    if (points.length === 1) {
      reachPathStr = `M ${paddingLeft} ${points[0].reachY} L ${width - paddingRight} ${points[0].reachY}`;
      viewsPathStr = `M ${paddingLeft} ${points[0].viewsY} L ${width - paddingRight} ${points[0].viewsY}`;
    } else {
      reachPathStr = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.reachY}`).join(' ');
      viewsPathStr = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.viewsY}`).join(' ');
    }

    const gridLines = [0, 0.33, 0.66, 1].map(ratio => {
      const y = paddingTop + chartHeight * (1 - ratio);
      const val = Math.round(minReach + ratio * (maxReach - minReach));
      return `
        <line x1="${paddingLeft}" y1="${y}" x2="${width - paddingRight}" y2="${y}" stroke="currentColor" class="text-border" stroke-dasharray="3,3" stroke-opacity="0.6"/>
        <text x="${paddingLeft - 8}" y="${y + 4}" text-anchor="end" font-size="9" fill="currentColor" class="text-muted-foreground">${formatNumber(val)}</text>
      `;
    }).join('');

    const xLabels = points.map(p => `
      <text x="${p.x}" y="${height - 12}" text-anchor="middle" font-size="9" fill="currentColor" class="text-muted-foreground">${p.dateLabel}</text>
    `).join('');

    const circles = points.map(p => `
      <circle cx="${p.x}" cy="${p.reachY}" r="4" class="fill-emerald-500 stroke-card stroke-2">
        <title>Date: ${p.dateLabel}&#10;Reach: ${formatNumber(p.s.profile_reach)}</title>
      </circle>
      <circle cx="${p.x}" cy="${p.viewsY}" r="4" class="fill-sky-500 stroke-card stroke-2">
        <title>Date: ${p.dateLabel}&#10;Views: ${formatNumber(p.s.profile_views)}</title>
      </circle>
    `).join('');

    growthChartSvg.innerHTML = `
      ${gridLines}
      <path d="${reachPathStr}" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="${viewsPathStr}" fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4,4"/>
      ${circles}
      ${xLabels}
    `;
  }

  function calculatePinningVelocity(snapshots: CompetitorSnapshot[]) {
    if (!pinningVelocityVal || !pinningVelocitySub) return;

    if (!snapshots || snapshots.length < 2) {
      pinningVelocityVal.textContent = '0.0 Pins/Day';
      if (velocityPinsAdded) velocityPinsAdded.textContent = '+0';
      if (velocityDaysSpan) velocityDaysSpan.textContent = '1 day';
      if (velocityMonthlyRate) velocityMonthlyRate.textContent = '~0 pins/mo';
      return;
    }

    const earliest = snapshots[0];
    const latest = snapshots[snapshots.length - 1];

    const earliestTime = new Date(earliest.recorded_at).getTime();
    const latestTime = new Date(latest.recorded_at).getTime();

    const rawDiffDays = (latestTime - earliestTime) / (1000 * 60 * 60 * 24);
    const daysSpan = Math.max(1, Math.round(rawDiffDays));
    const pinsAdded = (latest.pin_count || 0) - (earliest.pin_count || 0);

    const pinsPerDay = pinsAdded > 0 ? (pinsAdded / daysSpan).toFixed(1) : '0.0';
    const estimatedMonthly = Math.round((pinsAdded / daysSpan) * 30);

    pinningVelocityVal.textContent = `${pinsPerDay} Pins/Day`;
    pinningVelocitySub.textContent = `Rolling pacing evaluated over ${daysSpan} day(s).`;

    if (velocityPinsAdded) velocityPinsAdded.textContent = `${pinsAdded >= 0 ? '+' : ''}${formatNumber(pinsAdded)}`;
    if (velocityDaysSpan) velocityDaysSpan.textContent = `${daysSpan} days`;
    if (velocityMonthlyRate) velocityMonthlyRate.textContent = `~${formatNumber(estimatedMonthly)} pins/mo`;
  }

  function populateMonthDropdowns() {
    if (!snapshotsList || snapshotsList.length === 0) return;

    const monthsMap = new Map<string, string>();
    snapshotsList.forEach(s => {
      const d = new Date(s.recorded_at);
      if (!isNaN(d.getTime())) {
        const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        const label = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
        monthsMap.set(key, label);
      }
    });

    const monthsArr = Array.from(monthsMap.entries()).sort((a, b) => b[0].localeCompare(a[0]));

    if (snapshotMonthSelect) {
      snapshotMonthSelect.innerHTML = `<option value="all">All Months</option>` +
        monthsArr.map(([key, label]) => `<option value="${key}">${label}</option>`).join('');
    }

    if (momMonthASelect && momMonthBSelect) {
      const optionsHtml = monthsArr.map(([key, label]) => `<option value="${key}">${label}</option>`).join('');
      momMonthASelect.innerHTML = optionsHtml;
      momMonthBSelect.innerHTML = optionsHtml;

      if (monthsArr.length >= 2) {
        momMonthASelect.value = monthsArr[1][0];
        momMonthBSelect.value = monthsArr[0][0];
      }
    }
  }

  function renderMoMComparison() {
    if (!momComparisonGrid || !snapshotsList || snapshotsList.length === 0) return;

    const monthAKey = momMonthASelect?.value;
    const monthBKey = momMonthBSelect?.value;

    if (!monthAKey || !monthBKey) return;

    const snapshotsA = snapshotsList.filter(s => {
      const d = new Date(s.recorded_at);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` === monthAKey;
    }).sort((a, b) => new Date(b.recorded_at).getTime() - new Date(a.recorded_at).getTime());

    const snapshotsB = snapshotsList.filter(s => {
      const d = new Date(s.recorded_at);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}` === monthBKey;
    }).sort((a, b) => new Date(b.recorded_at).getTime() - new Date(a.recorded_at).getTime());

    const snapA = snapshotsA[0] || snapshotsList[0];
    const snapB = snapshotsB[0] || snapshotsList[snapshotsList.length - 1];

    const reachChange = (snapB.profile_reach || 0) - (snapA.profile_reach || 0);
    const reachPct = (snapA.profile_reach || 0) > 0 ? (reachChange / snapA.profile_reach) * 100 : 0;

    const viewsChange = (snapB.profile_views || 0) - (snapA.profile_views || 0);
    const viewsPct = (snapA.profile_views || 0) > 0 ? (viewsChange / snapA.profile_views) * 100 : 0;

    const followersChange = (snapB.follower_count || 0) - (snapA.follower_count || 0);
    const followersPct = (snapA.follower_count || 0) > 0 ? (followersChange / snapA.follower_count) * 100 : 0;

    const pinsChange = (snapB.pin_count || 0) - (snapA.pin_count || 0);
    const pinsPct = (snapA.pin_count || 0) > 0 ? (pinsChange / snapA.pin_count) * 100 : 0;

    const createMetricCard = (title: string, valA: number, valB: number, change: number, pct: number) => {
      const isPos = change > 0;
      const badgeStyle = isPos 
        ? 'bg-emerald-500/15 text-emerald-500' 
        : change < 0 ? 'bg-rose-500/15 text-rose-500' : 'bg-muted text-muted-foreground';

      return `
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">${title}</span>
            <span class="rounded px-2 py-0.5 text-[11px] font-bold ${badgeStyle}">${change >= 0 ? '+' : ''}${pct.toFixed(1)}%</span>
          </div>
          <div class="text-xl font-bold text-foreground">${formatNumber(valB)}</div>
          <div class="flex items-center justify-between text-[11px] text-muted-foreground pt-1 border-t border-border/50">
            <span>Base (${monthAKey}): ${formatNumber(valA)}</span>
            <span class="font-semibold ${isPos ? 'text-emerald-500' : change < 0 ? 'text-rose-500' : ''}">${change >= 0 ? '+' : ''}${formatNumber(change)}</span>
          </div>
        </div>
      `;
    };

    momComparisonGrid.innerHTML = `
      ${createMetricCard('Monthly Reach', snapA.profile_reach || 0, snapB.profile_reach || 0, reachChange, reachPct)}
      ${createMetricCard('Profile Views', snapA.profile_views || 0, snapB.profile_views || 0, viewsChange, viewsPct)}
      ${createMetricCard('Followers', snapA.follower_count || 0, snapB.follower_count || 0, followersChange, followersPct)}
      ${createMetricCard('Total Pins', snapA.pin_count || 0, snapB.pin_count || 0, pinsChange, pinsPct)}
    `;
  }

  // --- Boards Pagination, Search & Sorting Engine ---

  function renderBoardsTable() {
    if (!boardsTableBody) return;

    // Filter by search query
    let filtered = boardsList.filter(b => {
      if (!boardSearchQuery) return true;
      const q = boardSearchQuery.toLowerCase();
      const nameMatch = b.name.toLowerCase().includes(q);
      const descMatch = b.description ? b.description.toLowerCase().includes(q) : false;
      return nameMatch || descMatch;
    });

    // Sort boards
    filtered.sort((a, b) => {
      if (boardSortKey === 'most_pins') {
        return (b.pin_count || 0) - (a.pin_count || 0);
      } else if (boardSortKey === 'most_followers') {
        return (b.follower_count || 0) - (a.follower_count || 0);
      } else if (boardSortKey === 'recent_activity') {
        return new Date(b.last_pinned_at || 0).getTime() - new Date(a.last_pinned_at || 0).getTime();
      } else if (boardSortKey === 'creation_date') {
        return new Date(b.board_created_at || 0).getTime() - new Date(a.board_created_at || 0).getTime();
      }
      return 0;
    });

    if (boardsCountBadge) boardsCountBadge.textContent = `${filtered.length} ${filtered.length === 1 ? 'Board' : 'Boards'}`;

    if (filtered.length === 0) {
      boardsTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-12 text-center text-xs text-muted-foreground">
            ${boardsList.length === 0 ? 'No Pinterest boards recorded yet for this competitor. Click <span class="font-semibold text-foreground">Paste DevTools Payload</span> to ingest boards!' : 'No boards match your search query.'}
          </td>
        </tr>
      `;
      if (boardsPaginationInfo) boardsPaginationInfo.textContent = 'Showing 0 of 0 boards';
      if (boardsPageIndicator) boardsPageIndicator.textContent = 'Page 1 of 1';
      if (boardsPrevPageBtn) boardsPrevPageBtn.disabled = true;
      if (boardsNextPageBtn) boardsNextPageBtn.disabled = true;
      return;
    }

    // Pagination math
    const totalPages = Math.ceil(filtered.length / boardsPageSize);
    if (currentBoardPage > totalPages) currentBoardPage = totalPages;
    if (currentBoardPage < 1) currentBoardPage = 1;

    const startIdx = (currentBoardPage - 1) * boardsPageSize;
    const endIdx = Math.min(startIdx + boardsPageSize, filtered.length);
    const paginatedSlice = filtered.slice(startIdx, endIdx);

    // Render table rows
    boardsTableBody.innerHTML = paginatedSlice
      .map((b) => {
        const rawBoardUrl = b.url ? (b.url.startsWith('http') ? b.url : `https://www.pinterest.com${b.url}`) : `https://www.pinterest.com/${competitorData?.username}/`;
        const boardUrl = /^https?:\/\//i.test(rawBoardUrl) ? rawBoardUrl : '#';
        return `
          <tr class="hover:bg-muted/30 transition-colors">
            <td class="py-4 px-6">
              <div class="flex flex-col min-w-0">
                <span class="text-xs font-bold text-foreground truncate">${escHtml(b.name)}</span>
                <p class="text-[11px] text-muted-foreground line-clamp-2 max-w-md">${escHtml(b.description || 'No description')}</p>
              </div>
            </td>
            <td class="py-4 px-4 font-semibold text-foreground">
              ${formatDate(b.board_created_at)}
            </td>
            <td class="py-4 px-4 text-muted-foreground">
              ${formatDate(b.last_pinned_at)}
            </td>
            <td class="py-4 px-4 font-bold text-primary">
              ${formatNumber(b.pin_count || 0)}
            </td>
            <td class="py-4 px-4 font-semibold text-foreground">
              ${formatNumber(b.follower_count || 0)}
            </td>
            <td class="py-4 px-6 text-right">
              <a
                href="${escHtml(boardUrl)}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-lg border border-border px-2.5 py-1.5 text-[11px] font-semibold text-foreground hover:bg-muted hover:text-primary transition-all"
              >
                <span>Board</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </td>
          </tr>
        `;
      })
      .join('');

    // Update Pagination UI
    if (boardsPaginationInfo) boardsPaginationInfo.textContent = `Showing ${startIdx + 1}–${endIdx} of ${filtered.length} boards`;
    if (boardsPageIndicator) boardsPageIndicator.textContent = `Page ${currentBoardPage} of ${totalPages}`;
    if (boardsPrevPageBtn) boardsPrevPageBtn.disabled = currentBoardPage <= 1;
    if (boardsNextPageBtn) boardsNextPageBtn.disabled = currentBoardPage >= totalPages;
  }

  // --- Snapshot History Log Table Renderer ---

  function renderSnapshotsLogTable() {
    if (!snapshotsTableBody) return;
    if (snapshotsCountBadge) snapshotsCountBadge.textContent = `${snapshotsList.length} ${snapshotsList.length === 1 ? 'Snapshot' : 'Snapshots'}`;

    if (!snapshotsList || snapshotsList.length === 0) {
      snapshotsTableBody.innerHTML = `
        <tr>
          <td colspan="6" class="py-12 text-center text-xs text-muted-foreground">
            No historical snapshots recorded yet for this competitor.
          </td>
        </tr>
      `;
      return;
    }

    // Sort chronologically ascending to calculate deltas
    const chronoSorted = [...snapshotsList].sort((a, b) => new Date(a.recorded_at).getTime() - new Date(b.recorded_at).getTime());

    // Build display list descending (newest first)
    const displayList = [...chronoSorted].reverse();

    snapshotsTableBody.innerHTML = displayList
      .map((s) => {
        const chronoIdx = chronoSorted.findIndex(item => item.id === s.id);
        const prevSnap = chronoIdx > 0 ? chronoSorted[chronoIdx - 1] : null;

        const reachDiff = prevSnap ? (s.profile_reach || 0) - (prevSnap.profile_reach || 0) : 0;
        const viewsDiff = prevSnap ? (s.profile_views || 0) - (prevSnap.profile_views || 0) : 0;
        const followersDiff = prevSnap ? (s.follower_count || 0) - (prevSnap.follower_count || 0) : 0;
        const pinsDiff = prevSnap ? (s.pin_count || 0) - (prevSnap.pin_count || 0) : 0;

        const formatDeltaSpan = (diff: number) => {
          if (!prevSnap || diff === 0) return '';
          const isPos = diff > 0;
          return `<span class="ml-1.5 font-semibold text-[10px] ${isPos ? 'text-emerald-500' : 'text-rose-500'}">(${isPos ? '+' : ''}${formatNumber(diff)})</span>`;
        };

        return `
          <tr class="hover:bg-muted/30 transition-colors">
            <td class="py-4 px-6 font-medium text-foreground">
              ${formatDate(s.recorded_at, true)}
            </td>
            <td class="py-4 px-4 font-bold text-foreground">
              ${formatNumber(s.profile_reach || 0)}${formatDeltaSpan(reachDiff)}
            </td>
            <td class="py-4 px-4 font-semibold text-foreground">
              ${formatNumber(s.profile_views || 0)}${formatDeltaSpan(viewsDiff)}
            </td>
            <td class="py-4 px-4 text-foreground font-medium">
              ${formatNumber(s.follower_count || 0)}${formatDeltaSpan(followersDiff)}
            </td>
            <td class="py-4 px-4 font-bold text-primary">
              ${formatNumber(s.pin_count || 0)}${formatDeltaSpan(pinsDiff)}
            </td>
            <td class="py-4 px-6 text-right">
              <button
                data-delete-snapshot-id="${s.id}"
                class="delete-snapshot-btn inline-flex items-center gap-1 rounded-lg border border-rose-500/20 bg-rose-500/10 px-2.5 py-1 text-[11px] font-semibold text-rose-500 hover:bg-rose-500/20 transition-all"
                title="Delete Snapshot Record"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                <span>Delete</span>
              </button>
            </td>
          </tr>
        `;
      })
      .join('');

    // Attach event listeners to delete snapshot buttons
    document.querySelectorAll('.delete-snapshot-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const snapId = (e.currentTarget as HTMLElement).getAttribute('data-delete-snapshot-id');
        if (!snapId) return;

        if (confirm('Are you sure you want to delete this snapshot entry from history?')) {
          try {
            await deleteCompetitorSnapshot(snapId, competitorId);
            showStatus('Snapshot record deleted successfully.');
            await loadDetails();
          } catch (err: any) {
            showStatus(`Failed to delete snapshot: ${err.message}`, true);
          }
        }
      });
    });
  }

  // --- Event Listeners for Filter & Pagination Controls ---

  rangeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rangeBtns.forEach(b => {
        b.className = 'time-range-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-muted text-muted-foreground hover:text-foreground transition-all';
      });
      btn.className = 'time-range-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-primary text-primary-foreground transition-all shadow-xs';
      
      activeTimeRange = btn.dataset.range || 'ALL';
      const filtered = getFilteredSnapshots();
      renderVisualGrowthChart(filtered);
      calculatePinningVelocity(filtered);
    });
  });

  if (snapshotMonthSelect) {
    snapshotMonthSelect.addEventListener('change', () => {
      selectedMonth = snapshotMonthSelect.value;
      const filtered = getFilteredSnapshots();
      renderVisualGrowthChart(filtered);
      calculatePinningVelocity(filtered);
    });
  }

  if (toggleComparisonBtn && momComparisonPanel) {
    toggleComparisonBtn.addEventListener('click', () => {
      isComparisonMode = !isComparisonMode;
      if (isComparisonMode) {
        momComparisonPanel.classList.remove('hidden');
        toggleComparisonBtn.className = 'inline-flex items-center gap-1.5 rounded-xl border border-primary bg-primary text-primary-foreground px-3.5 py-1.5 text-xs font-semibold transition-all shadow-sm';
        renderMoMComparison();
      } else {
        momComparisonPanel.classList.add('hidden');
        toggleComparisonBtn.className = 'inline-flex items-center gap-1.5 rounded-xl border border-border bg-muted/50 px-3.5 py-1.5 text-xs font-semibold text-foreground hover:bg-muted transition-all';
      }
    });
  }

  if (momMonthASelect && momMonthBSelect) {
    momMonthASelect.addEventListener('change', renderMoMComparison);
    momMonthBSelect.addEventListener('change', renderMoMComparison);
  }

  // Boards Search & Sort Listeners
  if (boardSearchInput) {
    boardSearchInput.addEventListener('input', () => {
      boardSearchQuery = boardSearchInput.value.trim();
      currentBoardPage = 1;
      renderBoardsTable();
    });
  }

  if (boardSortSelect) {
    boardSortSelect.addEventListener('change', () => {
      boardSortKey = boardSortSelect.value;
      currentBoardPage = 1;
      renderBoardsTable();
    });
  }

  if (boardsPrevPageBtn) {
    boardsPrevPageBtn.addEventListener('click', () => {
      if (currentBoardPage > 1) {
        currentBoardPage--;
        renderBoardsTable();
      }
    });
  }

  if (boardsNextPageBtn) {
    boardsNextPageBtn.addEventListener('click', () => {
      currentBoardPage++;
      renderBoardsTable();
    });
  }

  // --- Main Data Loader ---

  async function loadDetails() {
    const details = await getCompetitorDetails(competitorId);
    competitorData = details.competitor;
    boardsList = details.boards;
    // Raw snapshots (DESC) — history log table keeps reading snapshotsList
    snapshotsList = details.snapshots || [];
    // Chart data: daily rollup primary; falls back to raw snapshots when daily table is empty
    chartSnapshotsList = (details as any).chartSnapshots || details.snapshots || [];
    deltasData = details.deltas;

    if (!competitorData) {
      if (competitorFullname) competitorFullname.textContent = 'Competitor Not Found';
      return;
    }

    // Populate Header
    if (competitorAvatar) competitorAvatar.src = competitorData.avatar_url || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&h=200&q=80';
    if (competitorFullname) competitorFullname.textContent = competitorData.full_name || competitorData.username;
    if (competitorHandle) competitorHandle.textContent = `@${competitorData.username}`;
    if (competitorNicheBadge) competitorNicheBadge.textContent = competitorData.niche || 'General';
    if (competitorNotes) competitorNotes.textContent = competitorData.notes || 'No internal notes set for this competitor.';

    const typeBadge = document.getElementById('competitor-type-badge') as HTMLElement;
    const tagsContainer = document.getElementById('competitor-tags-container') as HTMLElement;

    if (typeBadge) {
      if (competitorData.account_type === 'own') {
        typeBadge.textContent = '👤 My Account';
        typeBadge.className = 'rounded-full bg-blue-500/10 px-2.5 py-0.5 text-xs font-bold text-blue-500 border border-blue-500/20';
      } else {
        typeBadge.textContent = '🎯 Competitor';
        typeBadge.className = 'rounded-full bg-purple-500/10 px-2.5 py-0.5 text-xs font-bold text-purple-500 border border-purple-500/20';
      }
    }

    if (tagsContainer) {
      if (Array.isArray(competitorData.tags) && competitorData.tags.length > 0) {
        tagsContainer.innerHTML = competitorData.tags
          .map(t => `<span class="rounded bg-muted px-2 py-0.5 text-[10px] font-semibold text-muted-foreground border border-border/50">#${escHtml(t)}</span>`)
          .join('');
      } else {
        tagsContainer.innerHTML = '';
      }
    }

    if (competitorPinterestLink) {
      competitorPinterestLink.href = `https://www.pinterest.com/${encodeURIComponent(competitorData.username)}/`;
    }

    // Website & Domain Verified Status
    if (competitorData.website_url && /^https?:\/\//i.test(competitorData.website_url)) {
      if (competitorWebsiteContainer) competitorWebsiteContainer.classList.remove('hidden');
      if (competitorWebsiteLink) competitorWebsiteLink.href = competitorData.website_url;
      if (competitorWebsiteText) competitorWebsiteText.textContent = competitorData.website_url.replace(/^https?:\/\//, '').replace(/\/$/, '');
      if (competitorVerifiedBadge) {
        if (competitorData.domain_verified) {
          competitorVerifiedBadge.classList.remove('hidden');
        } else {
          competitorVerifiedBadge.classList.add('hidden');
        }
      }
    } else {
      if (competitorWebsiteContainer) competitorWebsiteContainer.classList.add('hidden');
    }

    // Last Pin Timestamp
    if (competitorLastPinStr) {
      competitorLastPinStr.textContent = competitorData.last_pin_at ? `Last Pin: ${formatDate(competitorData.last_pin_at)}` : 'Last Pin: N/A';
    }

    // Strategy Age
    if (strategyAgeVal) strategyAgeVal.textContent = competitorData.strategy_age_days ? `${competitorData.strategy_age_days} Days` : 'Unknown';
    if (oldestBoardDateStr) oldestBoardDateStr.textContent = competitorData.oldest_board_date ? `Oldest board: ${formatDate(competitorData.oldest_board_date)}` : 'No boards recorded yet';

    // Primary Metrics & Deltas (Full Number Formatting)
    if (currentReach) currentReach.textContent = formatNumber(competitorData.profile_reach || 0);
    if (currentViews) currentViews.textContent = formatNumber(competitorData.profile_views || 0);
    if (currentFollowers) currentFollowers.textContent = formatNumber(competitorData.follower_count || 0);
    if (currentPins) currentPins.textContent = formatNumber(competitorData.pin_count || 0);

    if (deltasData) {
      renderDeltaBadge(deltaReachBadge, deltaReachSub, deltasData.reachChange, deltasData.reachPercent);
      renderDeltaBadge(deltaViewsBadge, deltaViewsSub, deltasData.viewsChange, deltasData.viewsPercent);
      renderDeltaBadge(deltaFollowersBadge, deltaFollowersSub, deltasData.followersChange, deltasData.followersPercent);
      renderDeltaBadge(deltaPinsBadge, deltaPinsSub, deltasData.pinsChange, deltasData.pinsPercent);
    }

    // Populate Dropdowns & Render Analytics Engine Cards
    // Chart uses daily rollup data (chartSnapshotsList); filter is applied over it
    populateMonthDropdowns();
    const filteredSnapshots = getFilteredSnapshots();
    renderVisualGrowthChart(filteredSnapshots);
    calculatePinningVelocity(filteredSnapshots);

    if (isComparisonMode) {
      renderMoMComparison();
    }

    // Render Boards Table & Snapshots Log Table
    renderBoardsTable();
    renderSnapshotsLogTable();
  }

  // Modal Handlers
  function openModal() {
    if (modalError) modalError.classList.add('hidden');
    if (modalForm) modalForm.reset();
    if (modalDetectedSpan) {
      modalDetectedSpan.textContent = 'Waiting for paste...';
      modalDetectedSpan.className = 'rounded bg-muted px-2 py-0.5 text-[10px] font-semibold text-foreground';
    }
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  if (openModalBtn) openModalBtn.addEventListener('click', openModal);
  if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
  if (cancelModalBtn) cancelModalBtn.addEventListener('click', closeModal);

  if (modalTextarea) {
    modalTextarea.addEventListener('input', () => {
      const text = modalTextarea.value.trim();
      if (!text) {
        if (modalDetectedSpan) {
          modalDetectedSpan.textContent = 'Waiting for paste...';
          modalDetectedSpan.className = 'rounded bg-muted px-2 py-0.5 text-[10px] font-semibold text-foreground';
        }
        return;
      }

      const parsed = parsePinterestPayload(text);
      if (parsed.type === 'user_profile') {
        if (modalDetectedSpan) {
          modalDetectedSpan.textContent = '✓ User Profile (UserResource)';
          modalDetectedSpan.className = 'rounded bg-emerald-500/20 text-emerald-500 px-2 py-0.5 text-[10px] font-bold';
        }
      } else if (parsed.type === 'user_boards') {
        if (modalDetectedSpan) {
          modalDetectedSpan.textContent = '✓ User Boards (BoardsResource)';
          modalDetectedSpan.className = 'rounded bg-primary/20 text-primary px-2 py-0.5 text-[10px] font-bold';
        }
      } else {
        if (modalDetectedSpan) {
          modalDetectedSpan.textContent = '✕ Unknown Payload';
          modalDetectedSpan.className = 'rounded bg-rose-500/20 text-rose-500 px-2 py-0.5 text-[10px] font-bold';
        }
      }
    });
  }

  if (modalForm) {
    modalForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payloadText = modalTextarea.value.trim();
      const res = await ingestDevToolsPayload(competitorId, payloadText);

      if (res.success) {
        closeModal();
        showStatus(res.message);
        await loadDetails();
      } else {
        if (modalError) {
          modalError.textContent = res.message;
          modalError.classList.remove('hidden');
        }
      }
    });
  }

  loadDetails();
</script>
