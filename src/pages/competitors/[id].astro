  <!-- Month-over-Month Comparison Panel (Toggleable) -->
  <div id="mom-comparison-panel" class="hidden rounded-2xl border border-primary/30 bg-primary/5 p-6 shadow-sm mb-6 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-primary/15 pb-4">
      <div class="flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-foreground">Month-over-Month Comparison Engine</h3>
          <p class="text-xs text-muted-foreground">Select two distinct months to compute exact growth deltas and percentage shifts.</p>
        </div>
      </div>

      <div class="flex items-center gap-3 flex-wrap">
        <div class="flex items-center gap-1.5">
          <label for="mom-month-a" class="text-xs font-semibold text-muted-foreground">Base Month (A):</label>
          <select id="mom-month-a" class="rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium text-foreground focus:border-primary focus:outline-none"></select>
        </div>
        <span class="text-xs font-bold text-muted-foreground">vs</span>
        <div class="flex items-center gap-1.5">
          <label for="mom-month-b" class="text-xs font-semibold text-muted-foreground">Target Month (B):</label>
          <select id="mom-month-b" class="rounded-xl border border-border bg-background px-3 py-1.5 text-xs font-medium text-foreground focus:border-primary focus:outline-none"></select>
        </div>
      </div>
    </div>

    <!-- MoM Results Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="mom-comparison-grid">
      <!-- Populated via Client JS -->
    </div>
  </div>

  <!-- Growth Chart & Pinning Velocity Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <!-- Visual Growth Chart Card (2 Cols) -->
    <div class="lg:col-span-2 rounded-2xl border border-border bg-card p-6 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-foreground">Historical Growth Trajectory</h3>
          <p class="text-xs text-muted-foreground">Line chart of Monthly Reach & Profile Views over time.</p>
        </div>
        <div class="flex items-center gap-4 text-xs font-medium">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-foreground font-semibold">Monthly Reach</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-sky-500"></span>
            <span class="text-foreground font-semibold">Profile Views</span>
          </div>
        </div>
      </div>

      <!-- SVG Line Chart Canvas -->
      <div class="relative w-full overflow-hidden" id="chart-container">
        <svg id="growth-chart-svg" class="w-full h-56" viewBox="0 0 800 220" preserveAspectRatio="none">
          <!-- Rendered via JavaScript -->
        </svg>
      </div>
    </div>

    <!-- Pinning Velocity Metric Card (1 Col) -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm flex flex-col justify-between space-y-4">
      <div>
        <div class="flex items-center justify-between mb-1">
          <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Pinning Velocity</span>
          <span class="rounded-full bg-amber-500/10 px-2.5 py-0.5 text-[11px] font-bold text-amber-600 dark:text-amber-400">⚡ Output Speed</span>
        </div>
        <div class="text-3xl font-extrabold text-foreground tracking-tight" id="pinning-velocity-val">0.0 Pins/Day</div>
        <p class="text-xs text-muted-foreground mt-1" id="pinning-velocity-sub">Average daily pin creation rate based on snapshot deltas.</p>
      </div>

      <div class="border-t border-border pt-4 space-y-3">
        <div class="flex items-center justify-between text-xs">
          <span class="text-muted-foreground">Pins Added (Selected Range):</span>
          <span class="font-bold text-foreground" id="velocity-pins-added">+0</span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-muted-foreground">Time Horizon Evaluated:</span>
          <span class="font-bold text-foreground" id="velocity-days-span">0 days</span>
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-muted-foreground">Pacing Estimate:</span>
          <span class="font-bold text-primary" id="velocity-monthly-rate">~0 pins/mo</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Primary Metric Stat Cards -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="rounded-xl border border-border bg-card p-5 shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Monthly Reach</span>
        <span id="delta-reach-badge" class="rounded px-2 py-0.5 text-[11px] font-bold">0%</span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground" id="current-reach">0</div>
      <p class="text-[11px] text-muted-foreground" id="delta-reach-sub">vs previous snapshot</p>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Profile Views</span>
        <span id="delta-views-badge" class="rounded px-2 py-0.5 text-[11px] font-bold">0%</span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground" id="current-views">0</div>
      <p class="text-[11px] text-muted-foreground" id="delta-views-sub">vs previous snapshot</p>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Followers</span>
        <span id="delta-followers-badge" class="rounded px-2 py-0.5 text-[11px] font-bold">0%</span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground" id="current-followers">0</div>
      <p class="text-[11px] text-muted-foreground" id="delta-followers-sub">vs previous snapshot</p>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Total Pins</span>
        <span id="delta-pins-badge" class="rounded px-2 py-0.5 text-[11px] font-bold">0%</span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground" id="current-pins">0</div>
      <p class="text-[11px] text-muted-foreground" id="delta-pins-sub">vs previous snapshot</p>
    </div>
  </div>

  <!-- Board Strategy History Table & Controls -->
  <div class="rounded-xl border border-border bg-card shadow-sm overflow-hidden mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border px-6 py-4 bg-muted/30">
      <div>
        <h2 class="text-sm font-bold text-foreground">Pinterest Board Strategy & Timeline</h2>
        <p class="text-xs text-muted-foreground">Search, filter, and sort competitor boards with pagination.</p>
      </div>

      <!-- Board Search & Sort Controls -->
      <div class="flex items-center gap-3 flex-wrap">
        <!-- Quick Search -->
        <div class="relative">
          <input
            type="text"
            id="board-search-input"
            placeholder="Search boards..."
            class="h-8 rounded-lg border border-border bg-background pl-8 pr-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
          />
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-2.5 top-2 h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>

        <!-- Sort Select -->
        <select id="board-sort-select" class="h-8 rounded-lg border border-border bg-background px-2.5 text-xs font-medium text-foreground focus:border-primary focus:outline-none">
          <option value="most_pins">Sort by: Most Pins</option>
          <option value="most_followers">Sort by: Most Followers</option>
          <option value="recent_activity">Sort by: Recent Activity</option>
          <option value="creation_date">Sort by: Creation Date</option>
        </select>

        <span class="rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary" id="boards-count-badge">
          0 Boards
        </span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-muted-foreground">
        <thead class="border-b border-border bg-muted/40 text-foreground font-semibold">
          <tr>
            <th scope="col" class="py-3.5 px-6">Board Name & Description</th>
            <th scope="col" class="py-3.5 px-4">Creation Date (`created_at`)</th>
            <th scope="col" class="py-3.5 px-4">Last Activity (`last_pinned_at`)</th>
            <th scope="col" class="py-3.5 px-4">Pin Count</th>
            <th scope="col" class="py-3.5 px-4">Followers</th>
            <th scope="col" class="py-3.5 px-6 text-right">Link</th>
          </tr>
