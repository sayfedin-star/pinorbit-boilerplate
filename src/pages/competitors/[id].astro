          <span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider">Strategy Age (Oldest Board)</span>
          <div class="text-base font-bold text-foreground" id="strategy-age-val">0 Days</div>
          <span class="text-[10px] text-muted-foreground" id="oldest-board-date-str">Oldest board date</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Analytics Engine Filter & Controls Bar -->
  <div class="rounded-2xl border border-border bg-card p-4 shadow-sm mb-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <!-- Quick Time Range Filter Buttons -->
    <div class="flex items-center gap-1.5 flex-wrap">
      <span class="text-xs font-semibold text-muted-foreground mr-2 flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Time Range:</span>
      </span>
      <button data-range="7D" class="time-range-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-muted text-muted-foreground hover:text-foreground transition-all">7D</button>
      <button data-range="30D" class="time-range-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-muted text-muted-foreground hover:text-foreground transition-all">30D</button>
      <button data-range="90D" class="time-range-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-muted text-muted-foreground hover:text-foreground transition-all">90D</button>
      <button data-range="YTD" class="time-range-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-muted text-muted-foreground hover:text-foreground transition-all">YTD</button>
