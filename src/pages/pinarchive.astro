  // ─── Bulk Action Buttons ──────────────────────────────────────────────────
  function setupBulkActionButtons() {
    document.getElementById('clear-account-selection-btn')?.addEventListener('click', () => {
      selectedAccounts.clear();
      document.querySelectorAll<HTMLInputElement>('input[data-acc-select]').forEach(cb => { cb.checked = false; });
      const selectAll = document.getElementById('select-all-accounts-cb') as HTMLInputElement | null;
      if (selectAll) selectAll.checked = false;
      updateSelectedAccountsUI();
    });

    document.getElementById('delete-selected-accounts-btn')?.addEventListener('click', () => {
      if (selectedAccounts.size === 0) return;
      openDeleteAccountsModal(Array.from(selectedAccounts));
    });

    // Bulk Interval Change Listener
    const bulkIntervalSelect = document.getElementById('bulk-interval-select') as HTMLSelectElement | null;
    bulkIntervalSelect?.addEventListener('change', async () => {
      const newDays = parseInt(bulkIntervalSelect.value, 10);
      if (!newDays || selectedAccounts.size === 0) return;
      const count = selectedAccounts.size;
      const confirmed = confirm(`Change scrape interval to ${newDays} day(s) for ${count} selected account(s)?`);
      if (!confirmed) {
        bulkIntervalSelect.value = '';
        return;
      }

      bulkIntervalSelect.disabled = true;
      try {
        const root = document.getElementById('pinarchive-page-root');
        const wsId = root?.getAttribute('data-workspace-id');
        const res = await fetch('/api/pinarchive/accounts-interval', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            workspace_id: wsId,
            account_ids: Array.from(selectedAccounts),
            interval_days: newDays,
          }),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          toast(`Discovery interval set to ${newDays}d for ${count} account(s)!`);
          rawAccounts.forEach(a => {
            if (selectedAccounts.has(a.id)) {
              a.interval_days = newDays;
            }
          });
          filterAndRenderAccounts();
        } else {
          toast(json.error || 'Failed to update interval', 'error');
        }
      } catch (err: any) {
        toast(err.message || 'Network error', 'error');
      } finally {
        bulkIntervalSelect.disabled = false;
        bulkIntervalSelect.value = '';
      }
    });

    document.getElementById('gas-bulk-run-btn')?.addEventListener('click', async () => {
      if (selectedAccounts.size === 0) return;
      const root = document.getElementById('pinarchive-page-root');
      const wsId = root?.getAttribute('data-workspace-id');
      if (!wsId) {
        toast('Workspace identifier not found', 'error');
        return;
      }

      const selectedUsernames = rawAccounts
        .filter(a => selectedAccounts.has(a.id))
        .map(a => a.username)
        .filter(Boolean);

      if (selectedUsernames.length === 0) {
        toast('No valid accounts selected', 'error');
        return;
      }

      const confirmed = confirm(`Run Pin Discovery on Pinterest for ${selectedUsernames.length} selected account(s)?`);
      if (!confirmed) return;

      const btn = document.getElementById('gas-bulk-run-btn') as HTMLButtonElement | null;
      const originalText = btn?.innerHTML || '<span>🧠 Discover Pins</span>';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<span>⏳ Dispatching…</span>`;
      }

      try {
        const res = await fetch('/api/pinarchive/accounts-gas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'run_now',
            workspace_id: wsId,
            usernames: selectedUsernames,
          }),
        });
        const json = await res.json();
        if (res.ok && json.success) {
          const failed = (json.results || []).filter((r: any) => !r.ok);
          if (failed.length > 0) {
            toast(`Discovery queued with warnings: ${failed[0]?.error || 'partial error'}`, 'error');
          } else {
            toast(`🧠 Discovery pipeline dispatched for @${selectedUsernames.join(', @')}!`);
          }
          setTimeout(() => loadOverview(false as any), 2000);
        } else {
          toast(json.error || 'Failed to dispatch discovery pipeline', 'error');
        }
      } catch (err: any) {
        toast(err.message || 'Network error', 'error');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      }
    });

    document.getElementById('refresh-selected-accounts-btn')?.addEventListener('click', async () => {
