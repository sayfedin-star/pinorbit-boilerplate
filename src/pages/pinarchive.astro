    if (colVisible.backfill_cursor) headersHtml += `<th class="py-3 px-4 font-semibold">Cursor</th>`;
    if (colVisible.last_result) headersHtml += `<th class="py-3 px-4 font-semibold">Last Result</th>`;

    headersHtml += `
        <th class="py-3 px-4 font-semibold text-center">Ingest Active</th>
        <th class="py-3 px-4 text-right font-semibold">Actions</th>
      </tr>
    `;

    thead.innerHTML = headersHtml;

    document.getElementById('select-all-accounts-cb')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      const inputs = document.querySelectorAll<HTMLInputElement>('input[data-acc-select]');
      inputs.forEach(cb => {
        cb.checked = checked;
        const id = cb.getAttribute('data-acc-select');
        if (id) {
