---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';

const activeWorkspaceId = Astro.locals.activeWorkspaceId || '';
---

<Layout title="PinArchive Intelligence" description="Historical pin performance, winning recipe clusters, SEO topics, and canonical variations.">
  <div id="pinarchive-page-root" data-workspace-id={activeWorkspaceId}>
  <!-- ═══ Header & Primary Controls ═══ -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-4">
    <div>
      <SectionHeader
        title="PinArchive Intelligence"
        description="Historical pin performance archive, high-velocity winners, SEO topic clusters, and canonical groupings."
      />
      <div id="refresh-meta-line" class="text-xs text-muted-foreground -mt-3 mb-2 flex items-center gap-1.5">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span id="refresh-meta-text">Loading sync schedule...</span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-auto">
      <!-- Link to Dedicated Winning Pins Page -->
      <a
        href="/pinarchive/winning-pins"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-primary text-primary-foreground px-3.5 py-2 text-xs font-bold shadow-xs hover:bg-primary/90 transition-all"
      >
        <span>🏆 Winning Pins →</span>
      </a>

      <!-- Link to Dedicated Topic Clusters Page -->
      <a
        href="/pinarchive/topics"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-primary text-primary-foreground px-3.5 py-2 text-xs font-bold shadow-xs hover:bg-primary/90 transition-all"
      >
        <span>🏷️ Topic Clusters →</span>
      </a>
    </div>
  </div>

  <!-- ═══ KPI Totals Bar (Full Numbers) ═══ -->
  <div class="mb-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Archived Accounts</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-2" id="kpi-accounts-count">
        <div class="h-7 w-12 bg-muted/60 rounded animate-pulse"></div>
      </div>
      <div class="mt-1 text-[11px] text-muted-foreground" id="kpi-accounts-sub">Tracked in archive</div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Archived Pins</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
        </span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-emerald-500 mt-2" id="kpi-archived-pins">
        <div class="h-7 w-16 bg-muted/60 rounded animate-pulse"></div>
      </div>
      <div class="mt-1 text-[11px] text-muted-foreground" id="kpi-archived-sub">With verified metrics</div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Total Saves</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-500/10 text-rose-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-2" id="kpi-total-saves">
        <div class="h-7 w-20 bg-muted/60 rounded animate-pulse"></div>
      </div>
      <div class="mt-1 text-[11px] text-muted-foreground" id="kpi-saves-sub">Cumulative pin saves</div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Total Shares</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-500/10 text-blue-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        </span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-2" id="kpi-total-shares">
        <div class="h-7 w-16 bg-muted/60 rounded animate-pulse"></div>
      </div>
      <div class="mt-1 text-[11px] text-muted-foreground" id="kpi-shares-sub">Social engagement signals</div>
    </div>
  </div>

  <!-- ═══ Ingestion Controls Card ═══ -->
  <section class="mb-8 rounded-xl border border-border bg-card p-5 shadow-sm space-y-4" aria-labelledby="ingest-settings-heading">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-border">
      <div>
        <h2 id="ingest-settings-heading" class="text-sm font-bold text-foreground flex items-center gap-2">
          <span>⚙️ GAS Ingestion Controls</span>
          <span id="settings-role-badge" class="hidden text-[10px] font-semibold px-2 py-0.5 rounded-full bg-muted text-muted-foreground">Admin Only</span>
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">A pin is archived &amp; shown if it matches ANY rule (OR). 0 disables a rule.</p>
      </div>
      <div class="flex items-center gap-3">
        <span id="settings-status-msg" class="text-xs font-semibold"></span>
        <button
          id="save-ingest-settings-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 py-1.5 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
          <span>Save Settings</span>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Ingest Enabled Master Switch -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-ingest-enabled" class="text-xs font-bold text-foreground block">Master Ingest Switch</label>
          <span class="text-[11px] text-muted-foreground">Accept or reject incoming GAS runs.</span>
        </div>
        <div class="mt-2.5 flex items-center justify-between">
          <span id="setting-ingest-label" class="text-xs font-bold text-emerald-500">Active</span>
          <label class="relative inline-flex items-center cursor-pointer">
            <input id="setting-ingest-enabled" type="checkbox" checked class="sr-only peer" />
            <div class="w-8 h-4.5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>
      </div>

      <!-- Paused Account Policy -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-paused-policy" class="text-xs font-bold text-foreground block">Paused Account Policy</label>
          <span class="text-[11px] text-muted-foreground">Behavior when paused account sends data.</span>
        </div>
        <select
          id="setting-paused-policy"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none cursor-pointer"
        >
          <option value="reject">Reject Ingest (Ingest disabled)</option>
          <option value="accept">Allow Ingest Silently</option>
        </select>
      </div>

      <!-- Default Sync Interval -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-default-interval" class="text-xs font-bold text-foreground block">Default Sync Interval</label>
          <span class="text-[11px] text-muted-foreground">Cadence in days for new accounts.</span>
        </div>
        <input
          id="setting-default-interval"
          type="number"
          min="1"
          max="30"
          value="3"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none"
        />
      </div>

      <!-- Max Batch Pins -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-max-batch" class="text-xs font-bold text-foreground block">Max Batch Pins</label>
          <span class="text-[11px] text-muted-foreground">Payload limit per POST /ingest.</span>
        </div>
        <input
          id="setting-max-batch"
          type="number"
          min="10"
          max="5000"
          value="500"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none"
        />
      </div>

      <!-- Rule 1 — Min Saves ≥ -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-min-saves" class="text-xs font-bold text-foreground block">Rule 1 — Min Saves ≥</label>
          <span class="text-[11px] text-muted-foreground">Min saves required (0 = off).</span>
        </div>
        <input
          id="setting-min-saves"
          type="number"
          min="0"
          max="1000000"
          value="0"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none"
        />
      </div>

      <!-- Rule 2 — Min Repins ≥ -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-min-repins" class="text-xs font-bold text-foreground block">Rule 2 — Min Repins ≥</label>
          <span class="text-[11px] text-muted-foreground">Min repins required (0 = off).</span>
        </div>
        <input
          id="setting-min-repins"
          type="number"
          min="0"
          max="1000000"
          value="0"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none"
        />
      </div>

      <!-- Rule 3 — Rising: Age ≤ (days) -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-rising-age" class="text-xs font-bold text-foreground block">Rule 3 — Rising: Age ≤ (days)</label>
          <span class="text-[11px] text-muted-foreground">Max age in days (0 = off).</span>
        </div>
        <input
          id="setting-rising-age"
          type="number"
          min="0"
          max="365"
          value="14"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none"
        />
      </div>

      <!-- Rule 3 — Rising: Min Saves ≥ -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-rising-saves" class="text-xs font-bold text-foreground block">Rule 3 — Rising: Min Saves ≥</label>
          <span class="text-[11px] text-muted-foreground">Min saves for rising pins (0 = off).</span>
        </div>
        <input
          id="setting-rising-saves"
          type="number"
          min="0"
          max="1000000"
          value="34"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none"
        />
      </div>
    </div>
  </section>

  <!-- ═══ View A: Accounts Table with Bulk Action Bar ═══ -->
  <section class="mb-8" aria-labelledby="accounts-section-heading">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <h2 id="accounts-section-heading" class="text-sm font-bold text-foreground flex items-center gap-2">
        <span>👤 Tracked Accounts</span>
        <span class="text-xs font-normal text-muted-foreground" id="accounts-strip-count"></span>
      </h2>

      <!-- Account Selection Action Bar -->
      <div id="accounts-action-bar" class="hidden flex-wrap items-center gap-2 animate-in fade-in duration-150">
        <span id="accounts-selected-label" class="text-xs font-bold text-foreground">0 selected</span>
        
        <button
          id="refresh-selected-accounts-btn"
          type="button"
          class="inline-flex items-center gap-1 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary px-2.5 py-1.5 text-xs font-bold shadow-xs transition-colors cursor-pointer"
          title="Run PinArchive refresh for selected accounts"
        >
          <svg id="refresh-selected-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
          <span id="refresh-selected-btn-text">Refresh Selected</span>
        </button>

        <button
          id="gas-bulk-run-btn"
          type="button"
          class="inline-flex items-center gap-1 rounded-xl border border-border bg-card hover:bg-muted px-2.5 py-1.5 text-xs font-bold text-foreground shadow-xs transition-colors cursor-pointer"
          title="Trigger Pinterest scraping run in GAS"
        >
          <span>▶ Run</span>
        </button>

        <button
          id="gas-bulk-sync-btn"
          type="button"
          class="inline-flex items-center gap-1 rounded-xl border border-border bg-card hover:bg-emerald-500/10 px-2.5 py-1.5 text-xs font-bold text-emerald-600 dark:text-emerald-400 shadow-xs transition-colors cursor-pointer"
          title="Push filtered Sheet pins to DB"
        >
          <span>🔄 Sync</span>
        </button>

        <button
          id="gas-bulk-pause-btn"
          type="button"
          class="inline-flex items-center gap-1 rounded-xl border border-border bg-card hover:bg-muted px-2.5 py-1.5 text-xs font-bold text-foreground shadow-xs transition-colors cursor-pointer"
        >
          <span>⏸ Pause</span>
        </button>

        <button
          id="gas-bulk-resume-btn"
          type="button"
          class="inline-flex items-center gap-1 rounded-xl border border-border bg-card hover:bg-muted px-2.5 py-1.5 text-xs font-bold text-foreground shadow-xs transition-colors cursor-pointer"
        >
          <span>▶ Resume</span>
        </button>

        <div class="flex items-center gap-1 bg-card border border-border rounded-xl px-2 py-1 shadow-xs">
          <label for="gas-bulk-interval-input" class="text-[11px] font-semibold text-muted-foreground">Int:</label>
          <input
            id="gas-bulk-interval-input"
            type="number"
            min="1"
            max="30"
            value="3"
            class="w-10 rounded border border-border bg-background px-1 py-0.5 text-xs font-bold text-foreground text-center focus:outline-none"
          />
          <button
            id="gas-bulk-interval-btn"
            type="button"
            class="rounded bg-primary text-primary-foreground px-2 py-0.5 text-[11px] font-bold hover:bg-primary/90 transition-colors cursor-pointer"
          >
            Apply
          </button>
        </div>

        <button
          id="delete-selected-accounts-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl bg-rose-500 hover:bg-rose-600 text-white px-3 py-1.5 text-xs font-bold shadow-xs transition-colors cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          <span id="delete-accounts-btn-text">Delete Selected</span>
        </button>
        <button
          id="clear-account-selection-btn"
          type="button"
          class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
        >
          Cancel
        </button>
      </div>
    </div>

    <div class="overflow-x-auto rounded-xl border border-border bg-card shadow-xs">
      <table class="w-full text-left text-xs">
        <thead class="bg-muted/40 text-muted-foreground text-[11px] uppercase border-b border-border/80 font-semibold">
          <tr>
            <th class="p-3 w-10 text-center">
              <input
                type="checkbox"
                id="select-all-accounts-cb"
                class="rounded border-border text-rose-500 focus:ring-rose-500 h-3.5 w-3.5 cursor-pointer"
                title="Select all accounts"
              />
            </th>
            <th class="p-3 font-semibold text-foreground">Account</th>
            <th class="p-3 font-semibold">Followers</th>
            <th class="p-3 font-semibold">Pins Total</th>
            <th class="p-3 font-semibold">Interval</th>
            <th class="p-3 font-semibold">Last / Next Run</th>
            <th class="p-3 font-semibold text-center">Accept GAS</th>
            <th class="p-3 text-right font-semibold">Actions</th>
          </tr>
        </thead>
        <tbody id="accounts-table-body" class="divide-y divide-border/60">
          <tr>
            <td colspan="8" class="p-4 text-center text-xs text-muted-foreground animate-pulse">Loading tracked accounts…</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ═══ Delete Accounts Confirmation Modal (Amended) ═══ -->
  <div id="delete-accounts-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4">
    <div class="relative w-full max-w-md rounded-2xl border border-rose-500/40 bg-card p-6 shadow-2xl space-y-4">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-500/10 text-rose-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        <div>
          <h3 class="text-base font-bold text-foreground">Confirm Account Deletion</h3>
          <p class="text-xs text-muted-foreground">Permanent database purge.</p>
        </div>
      </div>

      <div class="rounded-xl bg-rose-500/5 border border-rose-500/20 p-3.5 text-xs text-muted-foreground space-y-2.5">
        <p class="text-rose-500 font-bold">⚠️ Warning: Database Deletion is Permanent</p>
        <p><strong class="text-foreground">Cascade Clean:</strong> DB deletion is permanent; GAS Sheets unaffected — next tick will RE-CREATE the account and re-ingest all pins unless paused in GAS first.</p>
        <label class="flex items-center gap-2 pt-2 border-t border-rose-500/20 text-foreground font-semibold cursor-pointer">
          <input
            type="checkbox"
            id="delete-pause-gas-checkbox"
            checked
            class="rounded border-rose-500/40 text-rose-500 focus:ring-rose-500 h-4 w-4"
          />
          <span>Pause in GAS before delete (recommended)</span>
        </label>
      </div>

      <div class="space-y-2">
        <label for="delete-confirm-input" class="block text-xs font-semibold text-foreground">
          Type <span class="font-mono text-rose-500 font-bold">DELETE</span> to confirm:
        </label>
        <input
          id="delete-confirm-input"
          type="text"
          placeholder="DELETE"
          class="w-full rounded-xl border border-border bg-background p-2.5 text-xs text-foreground focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500 font-mono"
        />
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-border">
        <button
          id="cancel-delete-modal-btn"
          type="button"
          class="rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          id="confirm-delete-modal-btn"
          type="button"
          disabled
          class="rounded-xl bg-rose-500 hover:bg-rose-600 disabled:opacity-50 disabled:pointer-events-none text-white px-4 py-2 text-xs font-bold shadow-sm transition-colors cursor-pointer"
        >
          Delete Accounts
        </button>
      </div>
    </div>
  </div>
  </div>
</Layout>

<script>
  let rawAccounts: any[] = [];
  const selectedAccounts = new Set<string>();

  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function toast(message: string, type: 'success' | 'error' | 'info' = 'success') {
    let root = document.getElementById('toast-root');
    if (!root) {
      root = document.createElement('div');
      root.id = 'toast-root';
      root.setAttribute('aria-live', 'polite');
      root.className = 'fixed bottom-4 right-4 z-[70] flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]';
      document.body.appendChild(root);
    }
    const colors = {
      success: 'border-emerald-500/40 text-emerald-600 dark:text-emerald-400',
      error: 'border-rose-500/40 text-rose-600 dark:text-rose-400',
      info: 'border-primary/40 text-primary',
    };
    const icons = { success: '✓', error: '✕', info: 'ℹ' };
    const el = document.createElement('div');
    el.className = `flex items-start gap-2.5 rounded-xl border bg-card p-3 text-xs font-semibold shadow-lg ${colors[type]}`;
    el.innerHTML = `<span class="flex-shrink-0">${icons[type]}</span><span class="flex-1 text-foreground">${escapeHtml(message)}</span>
      <button class="text-muted-foreground hover:text-foreground cursor-pointer" aria-label="Dismiss">✕</button>`;
    el.querySelector('button')?.addEventListener('click', () => el.remove());
    root.appendChild(el);
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transition = 'opacity .3s';
      setTimeout(() => el.remove(), 300);
    }, 4200);
  }

  // Full numbers formatting (no k/M abbreviations)
  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function timeAgo(isoString?: string | null): string {
    if (!isoString) return 'never';
    try {
      const diffMs = Date.now() - new Date(isoString).getTime();
      const mins = Math.floor(diffMs / 60000);
      if (mins < 60) return `${Math.max(1, mins)}m ago`;
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return `${hrs}h ago`;
      const days = Math.floor(hrs / 24);
      return `${days}d ago`;
    } catch {
      return 'recently';
    }
  }

  async function loadOverview() {
    try {
      const res = await fetch('/api/pinarchive/overview');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load overview');

      const totals = json.totals || {};
      const accounts = json.accounts || [];
      rawAccounts = accounts;

      // Update KPI cards (full numbers via fmtNumber)
      const kpiAccounts = document.getElementById('kpi-accounts-count');
      if (kpiAccounts) kpiAccounts.textContent = fmtNumber(totals.accounts);

      const kpiArchived = document.getElementById('kpi-archived-pins');
      if (kpiArchived) kpiArchived.textContent = fmtNumber(totals.archived_pins);

      const kpiSaves = document.getElementById('kpi-total-saves');
      if (kpiSaves) kpiSaves.textContent = fmtNumber(totals.sum_saves);

      const kpiShares = document.getElementById('kpi-total-shares');
      if (kpiShares) kpiShares.textContent = fmtNumber(totals.sum_shares);

      // Meta refresh line
      const metaText = document.getElementById('refresh-meta-text');
      if (metaText && accounts.length > 0) {
        const firstAcc = accounts[0];
        metaText.textContent = `Last refreshed ${timeAgo(firstAcc.last_run_at)} · next cycle ~${firstAcc.interval_days || 3}d`;
      }

      // Render Accounts Table with Checkboxes
      renderAccountsStrip(accounts);
    } catch (e: any) {
      console.error('Error loading PinArchive overview:', e);
    }
  }

  let canAdminSettings = true;

  async function loadSettings() {
    try {
      const res = await fetch('/api/pinarchive/settings');
      if (res.status === 401 || res.status === 403) {
        canAdminSettings = false;
        disableSettingsForm();
        return;
      }
      const json = await res.json();
      if (!json.success) return;

      const ingestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
      const ingestLabel = document.getElementById('setting-ingest-label');
      const policySel = document.getElementById('setting-paused-policy') as HTMLSelectElement | null;
      const intervalInp = document.getElementById('setting-default-interval') as HTMLInputElement | null;
      const maxBatchInp = document.getElementById('setting-max-batch') as HTMLInputElement | null;
      const minSavesInp = document.getElementById('setting-min-saves') as HTMLInputElement | null;
      const minRepinsInp = document.getElementById('setting-min-repins') as HTMLInputElement | null;
      const risingAgeInp = document.getElementById('setting-rising-age') as HTMLInputElement | null;
      const risingSavesInp = document.getElementById('setting-rising-saves') as HTMLInputElement | null;

      if (ingestCb) {
        ingestCb.checked = Boolean(json.ingest_enabled);
        if (ingestLabel) {
          ingestLabel.textContent = ingestCb.checked ? 'Active' : 'Disabled';
          ingestLabel.className = `text-xs font-bold ${ingestCb.checked ? 'text-emerald-500' : 'text-rose-500'}`;
        }
      }
      if (policySel) policySel.value = json.paused_account_policy || 'reject';
      if (intervalInp) intervalInp.value = String(json.default_interval_days || 3);
      if (maxBatchInp) maxBatchInp.value = String(json.max_batch_pins || 500);
      if (minSavesInp) minSavesInp.value = String(json.pin_filter_min_saves ?? 0);
      if (minRepinsInp) minRepinsInp.value = String(json.pin_filter_min_repins ?? 0);
      if (risingAgeInp) risingAgeInp.value = String(json.pin_filter_rising_age_days ?? 14);
      if (risingSavesInp) risingSavesInp.value = String(json.pin_filter_rising_saves ?? 34);
    } catch (e) {
      console.error('Failed to load settings:', e);
    }
  }

  function disableSettingsForm() {
    const saveBtn = document.getElementById('save-ingest-settings-btn') as HTMLButtonElement | null;
    const roleBadge = document.getElementById('settings-role-badge');
    const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      '#setting-ingest-enabled, #setting-paused-policy, #setting-default-interval, #setting-max-batch, #setting-min-saves, #setting-min-repins, #setting-rising-age, #setting-rising-saves'
    );
    inputs.forEach((el) => {
      el.disabled = true;
    });
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.classList.add('hidden');
    }
    if (roleBadge) roleBadge.classList.remove('hidden');
  }

  async function saveSettings() {
    const ingestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
    const policySel = document.getElementById('setting-paused-policy') as HTMLSelectElement | null;
    const intervalInp = document.getElementById('setting-default-interval') as HTMLInputElement | null;
    const maxBatchInp = document.getElementById('setting-max-batch') as HTMLInputElement | null;
    const minSavesInp = document.getElementById('setting-min-saves') as HTMLInputElement | null;
    const minRepinsInp = document.getElementById('setting-min-repins') as HTMLInputElement | null;
    const risingAgeInp = document.getElementById('setting-rising-age') as HTMLInputElement | null;
    const risingSavesInp = document.getElementById('setting-rising-saves') as HTMLInputElement | null;
    const statusMsg = document.getElementById('settings-status-msg');
    const saveBtn = document.getElementById('save-ingest-settings-btn') as HTMLButtonElement | null;

    if (!ingestCb || !policySel || !intervalInp || !maxBatchInp || !minSavesInp || !minRepinsInp || !risingAgeInp || !risingSavesInp) return;

    if (saveBtn) saveBtn.disabled = true;
    if (statusMsg) {
      statusMsg.textContent = 'Saving...';
      statusMsg.className = 'text-xs font-semibold text-muted-foreground';
    }

    try {
      const res = await fetch('/api/pinarchive/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ingest_enabled: ingestCb.checked,
          paused_account_policy: policySel.value,
          default_interval_days: parseInt(intervalInp.value, 10) || 3,
          max_batch_pins: parseInt(maxBatchInp.value, 10) || 500,
          pin_filter_min_saves: parseInt(minSavesInp.value, 10) || 0,
          pin_filter_min_repins: parseInt(minRepinsInp.value, 10) || 0,
          pin_filter_rising_age_days: Number.isInteger(parseInt(risingAgeInp.value, 10)) ? parseInt(risingAgeInp.value, 10) : 14,
          pin_filter_rising_saves: Number.isInteger(parseInt(risingSavesInp.value, 10)) ? parseInt(risingSavesInp.value, 10) : 34,
        }),
      });

      if (res.status === 403) {
        canAdminSettings = false;
        disableSettingsForm();
        if (statusMsg) {
          statusMsg.textContent = 'Forbidden: Admin access required.';
          statusMsg.className = 'text-xs font-semibold text-rose-500';
        }
        return;
      }

      const json = await res.json();
      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Failed to save settings');
      }

      if (statusMsg) {
        statusMsg.textContent = 'Settings saved!';
        statusMsg.className = 'text-xs font-semibold text-emerald-500';
        setTimeout(() => {
          if (statusMsg) statusMsg.textContent = '';
        }, 3000);
      }
    } catch (e: any) {
      if (statusMsg) {
        statusMsg.textContent = e.message || 'Save failed';
        statusMsg.className = 'text-xs font-semibold text-rose-500';
      }
    } finally {
      if (saveBtn && canAdminSettings) saveBtn.disabled = false;
    }
  }

  function attachAccountIngestToggleListeners() {
    document.querySelectorAll<HTMLInputElement>('[data-acc-ingest-toggle]').forEach((cb) => {
      cb.addEventListener('change', async () => {
        const id = cb.getAttribute('data-acc-ingest-toggle');
        if (!id) return;
        const enabled = cb.checked;
        cb.disabled = true;

        try {
          const res = await fetch('/api/pinarchive/accounts-ingest-toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ account_ids: [id], ingest_enabled: enabled }),
          });

          if (res.status === 403) {
            cb.checked = !enabled;
            alert('Admin access required to toggle account ingestion.');
            return;
          }

          const json = await res.json();
          if (!res.ok || !json.success) {
            cb.checked = !enabled;
            alert(json.error || 'Failed to update account ingest status.');
          }
        } catch {
          cb.checked = !enabled;
        } finally {
          cb.disabled = false;
        }
      });
    });
  }

