  function renderPinsView(pins: any[]) {
    const grid = document.getElementById('winners-grid');
    const byBoardContainer = document.getElementById('by-board-container');
    const badge = document.getElementById('winners-badge-count');

    if (badge) badge.textContent = `${pins.length} shown`;

    if (pins.length === 0) {
      if (grid) {
        grid.classList.remove('hidden');
        grid.innerHTML = `
          <div class="col-span-full py-12 text-center text-xs text-muted-foreground bg-muted/20 rounded-xl border border-dashed border-border">
            No archived pins match the current filter criteria.
          </div>
        `;
      }
      if (byBoardContainer) byBoardContainer.classList.add('hidden');
      return;
    }

    if (activeView === 'grid') {
      if (byBoardContainer) byBoardContainer.classList.add('hidden');
      if (grid) {
        grid.classList.remove('hidden');
        grid.innerHTML = pins.map(renderSinglePinCard).join('');
      }
    } else {
      if (grid) grid.classList.add('hidden');
      if (byBoardContainer) {
        byBoardContainer.classList.remove('hidden');

        // Group pins by board_name
        const boardMap = new Map<string, any[]>();
        for (const p of pins) {
          const bName = p.board_name || 'General Archive';
          const list = boardMap.get(bName) || [];
          list.push(p);
          boardMap.set(bName, list);
        }

        byBoardContainer.innerHTML = Array.from(boardMap.entries())
          .map(([bName, bPins]) => {
            const sumSaves = bPins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
            const avgVel = bPins.reduce((acc, p) => acc + Number(p.velocity || 0), 0) / bPins.length;
            const boardIdSafe = bName.replace(/[^a-zA-Z0-9]/g, '_');

            return `
              <div class="rounded-xl border border-border bg-card shadow-sm overflow-hidden">
                <button
                  type="button"
                  data-toggle-board="${boardIdSafe}"
                  class="w-full flex flex-wrap items-center justify-between p-4 bg-muted/30 hover:bg-muted/50 transition-colors border-b border-border/60 text-left"
                >
                  <div class="flex items-center gap-3">
                    <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary">
                      📁
                    </span>
                    <div>
                      <h3 class="text-sm font-bold text-foreground">${escapeHtml(bName)}</h3>
                      <span class="text-[11px] text-muted-foreground">${bPins.length} pins · ${fmtNumber(sumSaves)} saves · avg ${avgVel.toFixed(1)}/d</span>
                    </div>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div id="board-body-${boardIdSafe}" class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                  ${bPins.map(renderSinglePinCard).join('')}
                </div>
              </div>
            `;
          })
          .join('');

        // Attach collapsible toggles
        document.querySelectorAll('[data-toggle-board]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-toggle-board');
            const body = document.getElementById(`board-body-${id}`);
            if (body) body.classList.toggle('hidden');
          });
        });
      }
    }

    attachCompareListeners();
  }

  function computeTopicROI(pins: any[]) {
    const roiContainer = document.getElementById('topic-roi-list');
    if (!roiContainer) return;

    const topicStats = new Map<string, { count: number; sumSaves: number }>();
    for (const p of pins) {
      const saves = Number(p.saves || 0);
      const annotations = Array.isArray(p.annotations) ? p.annotations : [];
      for (const a of annotations) {
        const name = typeof a === 'string' ? a : a?.name;
        if (!name) continue;
        const entry = topicStats.get(name) || { count: 0, sumSaves: 0 };
        entry.count++;
        entry.sumSaves += saves;
        topicStats.set(name, entry);
      }
    }

    const roiList = Array.from(topicStats.entries())
      .map(([name, stat]) => ({
        name,
        pins: stat.count,
        sumSaves: stat.sumSaves,
        savesPerPin: Math.round(stat.sumSaves / stat.count),
      }))
      .sort((a, b) => b.savesPerPin - a.savesPerPin)
      .slice(0, 10);

    if (roiList.length === 0) {
      roiContainer.innerHTML = '<div class="py-4 text-center text-xs text-muted-foreground">No topic ROI data available.</div>';
      return;
    }

    const maxSavesPerPin = Math.max(...roiList.map((r) => r.savesPerPin), 1);

    roiContainer.innerHTML = roiList
      .map((r) => {
        const pct = Math.round((r.savesPerPin / maxSavesPerPin) * 100);
        return `
          <div class="group p-2 rounded-lg hover:bg-muted/40 transition-colors">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="font-semibold text-foreground truncate max-w-[160px]" title="${escapeHtml(r.name)}">
                ${escapeHtml(r.name)}
              </span>
              <div class="flex items-center gap-1.5 shrink-0">
                <span class="text-[10px] text-muted-foreground">${r.pins}p</span>
                <span class="font-bold text-emerald-500 text-xs">${fmtNumber(r.savesPerPin)}/pin</span>
              </div>
            </div>
            <div class="h-1.5 w-full bg-muted rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500/80 rounded-full group-hover:bg-emerald-500 transition-all duration-300" style="width: ${pct}%"></div>
            </div>
          </div>
        `;
      })
      .join('');
  }

  async function loadPins() {
    const grid = document.getElementById('winners-grid');
    const searchInput = document.getElementById('filter-search-input') as HTMLInputElement | null;
    const boardSelect = document.getElementById('filter-board-select') as HTMLSelectElement | null;
    const stageSelect = document.getElementById('filter-stage-select') as HTMLSelectElement | null;
    const minSavesInput = document.getElementById('filter-min-saves') as HTMLInputElement | null;
    const clusterToggle = document.getElementById('filter-cluster-toggle') as HTMLInputElement | null;

    const q = searchInput?.value.trim() || '';
    const board = boardSelect?.value || '';
    const stage = stageSelect?.value || '';
    const minSaves = minSavesInput?.value.trim() || '';
    const inCluster = clusterToggle?.checked ? '1' : '';

    const params = new URLSearchParams();
    params.set('sort', currentSort);
    params.set('limit', String(currentLimit));
    if (q) params.set('q', q);
    if (board) params.set('board', board);
    if (minSaves) params.set('min_saves', minSaves);
    if (inCluster) params.set('in_cluster', inCluster);

    try {
      const res = await fetch(`/api/pinarchive/pins?${params.toString()}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load pins');

      let pins: any[] = json.pins || [];
      rawPins = pins;

      // Populate boards dropdown if first load
      if (boardSelect && boardSelect.options.length <= 1) {
        const uniqueBoards = Array.from(new Set(pins.map((p) => p.board_name).filter(Boolean))).sort();
        for (const b of uniqueBoards) {
          const opt = document.createElement('option');
          opt.value = b;
          opt.textContent = b;
          boardSelect.appendChild(opt);
        }
      }

      // Filter stage client-side if selected
      if (stage) {
        pins = pins.filter((p) => p.stage === stage);
      }

      renderPinsView(pins);
      computeTopicROI(pins);
      renderCanonicalClusters(pins);
    } catch (e: any) {
      console.error('Error loading PinArchive pins:', e);
      if (grid) {
        grid.innerHTML = `
          <div class="col-span-full py-8 text-center text-xs text-rose-500 bg-rose-500/5 rounded-xl border border-rose-500/20">
            Failed to load winning pins: ${escapeHtml(e.message)}
          </div>
        `;
      }
    }
  }

  function renderCanonicalClusters(pins: any[]) {
    const canonicalContainer = document.getElementById('canonical-container');
    const canonicalBadge = document.getElementById('canonical-badge-count');
    if (!canonicalContainer) return;

    const canonicalGroups = new Map<string, any[]>();
    for (const p of pins) {
      if (p.canonical_pin_id) {
        const list = canonicalGroups.get(p.canonical_pin_id) || [];
        list.push(p);
        canonicalGroups.set(p.canonical_pin_id, list);
      }
    }

    const multiClusters = Array.from(canonicalGroups.entries())
      .filter(([, group]) => group.length > 1)
      .sort((a, b) => b[1].length - a[1].length);

    if (canonicalBadge) canonicalBadge.textContent = `${multiClusters.length} Clusters`;

    if (multiClusters.length === 0) {
      canonicalContainer.innerHTML = `
        <div class="p-8 text-center text-xs text-muted-foreground">
          No multi-pin canonical clusters detected in current sample.
        </div>
      `;
      return;
    }

    canonicalContainer.innerHTML = multiClusters
      .map(([canonicalId, clusterPins]) => {
        const clusterTotalSaves = clusterPins.reduce((acc, p) => acc + Number(p.saves || 0), 0);
        clusterPins.sort((a, b) => Number(b.saves || 0) - Number(a.saves || 0));

        const itemsList = clusterPins
          .map((cp, idx) => {
            const pinSaves = Number(cp.saves || 0);
            const sharePct = clusterTotalSaves > 0 ? Math.round((pinSaves / clusterTotalSaves) * 100) : 0;
            return `
              <li class="flex items-center justify-between text-xs py-2 px-3 rounded-lg hover:bg-muted/40 transition-colors">
                <a href="/pinarchive/details?id=${encodeURIComponent(cp.id || '')}" class="flex items-center gap-2 font-medium text-foreground hover:text-primary truncate max-w-md focus-visible:ring-2 focus-visible:ring-primary rounded">
                  <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-muted text-muted-foreground">#${idx + 1}</span>
                  <span class="truncate">${escapeHtml(cp.title || `Pin ${cp.pin_id}`)}</span>
                </a>
                <div class="flex items-center gap-2 shrink-0 ml-2">
                  <span class="text-[10px] text-muted-foreground font-mono">(${sharePct}%)</span>
                  <span class="font-bold text-rose-500">${fmtNumber(pinSaves)} saves</span>
                </div>
              </li>
            `;
          })
          .join('');

        return `
          <div class="p-5 hover:bg-muted/10 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-md bg-purple-500/10 text-purple-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
                </span>
                <span class="font-bold text-xs text-foreground font-mono">Canonical #${escapeHtml(canonicalId)}</span>
                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-500">
                  ${clusterPins.length} Pin Variations
                </span>
              </div>
              <span class="text-xs font-semibold text-muted-foreground">
                Cluster Saves: <strong class="text-foreground">${fmtNumber(clusterTotalSaves)}</strong>
              </span>
            </div>
            <ul class="space-y-0.5 bg-muted/20 rounded-xl p-2 border border-border/40">
              ${itemsList}
            </ul>
          </div>
        `;
      })
      .join('');
  }

  async function loadTopics() {
    const list = document.getElementById('topics-list');
    const badge = document.getElementById('topics-badge-count');

    try {
      const res = await fetch('/api/pinarchive/topics');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load topics');

      const topics: any[] = json.topics || [];
      if (badge) badge.textContent = `${topics.length}`;

      if (list) {
        if (topics.length === 0) {
          list.innerHTML = `
            <div class="py-8 text-center text-xs text-muted-foreground">
              No SEO topics identified yet.
            </div>
          `;
        } else {
          const maxSaves = Math.max(...topics.map((t) => Number(t.sum_saves) || 1), 1);
          list.innerHTML = topics
            .map((t) => {
              const saves = Number(t.sum_saves || 0);
              const pct = Math.round((saves / maxSaves) * 100);
              return `
                <div class="group p-2 rounded-lg hover:bg-muted/40 transition-colors">
                  <div class="flex items-center justify-between text-xs mb-1">
                    <span class="font-semibold text-foreground truncate max-w-[180px]" title="${escapeHtml(t.name)}">
                      ${escapeHtml(t.name)}
                    </span>
                    <div class="flex items-center gap-2 shrink-0">
                      <span class="text-[10px] text-muted-foreground font-medium">${t.pins} pin${t.pins === 1 ? '' : 's'}</span>
                      <span class="font-bold text-rose-500">${fmtNumber(saves)}</span>
                    </div>
                  </div>
                  <div class="h-1.5 w-full bg-muted rounded-full overflow-hidden">
                    <div class="h-full bg-primary/70 rounded-full group-hover:bg-primary transition-all duration-300" style="width: ${pct}%"></div>
                  </div>
                </div>
              `;
            })
            .join('');
        }
      }
    } catch (e: any) {
      console.error('Error loading PinArchive topics:', e);
    }
  }

  function attachCompareListeners() {
    document.querySelectorAll<HTMLInputElement>('[data-pin-compare]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-pin-compare');
        if (!id) return;
        if (cb.checked) {
          if (selectedForCompare.size >= 2) {
            cb.checked = false;
            alert('You can select a maximum of 2 pins for side-by-side comparison.');
            return;
          }
          selectedForCompare.add(id);
        } else {
          selectedForCompare.delete(id);
        }
        updateCompareBar();
      });
    });
  }

  function updateCompareBar() {
    const bar = document.getElementById('floating-compare-bar');
    const text = document.getElementById('compare-count-text');
    if (!bar || !text) return;

    if (selectedForCompare.size > 0) {
      bar.classList.remove('hidden');
      text.textContent = `${selectedForCompare.size} of 2 Pins Selected`;
    } else {
      bar.classList.add('hidden');
    }
  }

