---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PinArchiveCronCard from '../components/pinarchive/PinArchiveCronCard.astro';

const activeWorkspaceId = Astro.locals.activeWorkspaceId || '';
---

<Layout title="PinArchive Intelligence" description="Historical pin performance, winning recipe clusters, SEO topics, and canonical variations.">
  <div id="pinarchive-page-root" data-workspace-id={activeWorkspaceId}>
  <!-- ═══ Header & Primary Controls ═══ -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
      <div class="flex items-center gap-2">
        <SectionHeader
          title="PinArchive Intelligence"
          description="Historical creator pin archive, high-velocity winners, SEO topic clusters, and real-time synchronization."
        />
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-3 self-start sm:self-auto">
      <!-- Live Sync Status Pill -->
      <div id="refresh-meta-line" class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-card px-3.5 py-1.5 text-xs text-muted-foreground shadow-xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span id="refresh-meta-text" class="font-medium text-foreground">Loading sync schedule...</span>
      </div>

      <!-- Link to Dedicated Winning Pins Page -->
      <a
        href="/pinarchive/winning-pins"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card text-foreground px-3.5 py-2 text-xs font-semibold shadow-xs hover:bg-muted/80 hover:border-primary/40 transition-all"
      >
        <span>🏆 Winning Pins →</span>
      </a>

      <!-- Link to Dedicated Topic Clusters Page -->
      <a
        href="/pinarchive/topics"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card text-foreground px-3.5 py-2 text-xs font-semibold shadow-xs hover:bg-muted/80 hover:border-primary/40 transition-all"
      >
        <span>🏷️ Topic Clusters →</span>
      </a>
    </div>
  </div>

  <!-- ═══ PinArchive Tab Navigation ═══ -->
  <div class="mb-6 flex flex-wrap items-center gap-2 border-b border-border/80 pb-3">
    <button
      id="pa-tab-btn-accounts"
      type="button"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-primary text-primary-foreground shadow-xs transition-all cursor-pointer"
    >
      <span>👤 Tracked Accounts & Ingest</span>
    </button>
    <button
      id="pa-tab-btn-automation"
      type="button"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-all cursor-pointer"
    >
      <span>⚡ Pipeline & Automation</span>
    </button>
  </div>

  <!-- ═══ Tab 1 View: Accounts, KPIs & Ingest Rules ═══ -->
  <div id="pa-tab-view-accounts" class="space-y-6">
  <!-- ═══ KPI Totals Bar (Full Numbers) ═══ -->
  <div class="mb-6 grid grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Card 1: Accounts -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">Archived Accounts</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
      </div>
      <div>
        <div class="text-3xl font-bold tracking-tight text-foreground mt-3" id="kpi-accounts-count">
          <div class="h-8 w-12 bg-muted/60 rounded animate-pulse"></div>
        </div>
        <div class="mt-1 text-[11px] text-muted-foreground flex items-center gap-1.5" id="kpi-accounts-sub">
          <span class="h-1.5 w-1.5 rounded-full bg-primary/60"></span>
          <span>Tracked in workspace</span>
        </div>
      </div>
    </div>

    <!-- Card 2: Archived Pins -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">Archived Pins</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
        </span>
      </div>
      <div>
        <div class="text-3xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400 mt-3" id="kpi-archived-pins">
          <div class="h-8 w-16 bg-muted/60 rounded animate-pulse"></div>
        </div>
        <div class="mt-1 text-[11px] text-muted-foreground flex items-center gap-1.5" id="kpi-archived-sub">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
          <span>With verified metrics</span>
        </div>
      </div>
    </div>

    <!-- Card 3: Total Saves -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">Total Saves</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </span>
      </div>
      <div>
        <div class="text-3xl font-bold tracking-tight text-foreground mt-3" id="kpi-total-saves">
          <div class="h-8 w-20 bg-muted/60 rounded animate-pulse"></div>
        </div>
        <div class="mt-1 text-[11px] text-muted-foreground flex items-center gap-1.5" id="kpi-saves-sub">
          <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
          <span>Cumulative saves</span>
        </div>
      </div>
    </div>

    <!-- Card 4: Total Shares -->
    <div class="rounded-2xl border border-border bg-card p-5 shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">Total Shares</span>
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 group-hover:scale-105 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        </span>
      </div>
      <div>
        <div class="text-3xl font-bold tracking-tight text-foreground mt-3" id="kpi-total-shares">
          <div class="h-8 w-16 bg-muted/60 rounded animate-pulse"></div>
        </div>
        <div class="mt-1 text-[11px] text-muted-foreground flex items-center gap-1.5" id="kpi-shares-sub">
          <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
          <span>Engagement signals</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ Collapsible GAS Ingestion & Filter Controls Card ═══ -->
  <section class="mb-6 rounded-2xl border border-border bg-card shadow-xs overflow-hidden transition-all duration-200" aria-labelledby="ingest-settings-heading">
    <!-- Header Bar with Toggle -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 bg-muted/10 border-b border-border/70">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-muted text-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        </span>
        <h2 id="ingest-settings-heading" class="text-sm font-bold text-foreground">
          PinArchive Ingestion &amp; Archive Rules
        </h2>
        <span id="settings-summary-badge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
          🟢 Ingest Active
        </span>
        <span id="settings-role-badge" class="hidden text-[10px] font-semibold px-2 py-0.5 rounded-full bg-muted text-muted-foreground">
          Admin Only
        </span>
      </div>

      <div class="flex items-center gap-2.5">
        <span id="settings-status-msg" class="text-xs font-semibold"></span>
        <button
          id="reevaluate-candidates-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary px-3 py-1.5 text-xs font-bold shadow-xs transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
          title="Re-evaluate candidate pins against current OR rules"
        >
          <svg id="reevaluate-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
          <span id="reevaluate-btn-text">Re-evaluate Now</span>
        </button>
        <button
          id="save-ingest-settings-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
          <span>Save Settings</span>
        </button>
        <button
          id="toggle-settings-collapse-btn"
          type="button"
          class="inline-flex items-center gap-1 text-xs font-semibold text-muted-foreground hover:text-foreground bg-muted/50 hover:bg-muted px-2.5 py-1.5 rounded-xl transition-colors cursor-pointer"
          title="Toggle settings visibility"
        >
          <span id="settings-collapse-text">Configure</span>
          <svg id="settings-collapse-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
      </div>
    </div>

    <!-- Collapsible Body -->
    <div id="settings-panel-body" class="hidden space-y-4 p-5 bg-card">
      <!-- Tier 1: Gates & Defaults (4-col grid) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
        <!-- Master Ingest Switch -->
        <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <label for="setting-ingest-enabled" class="text-xs font-bold text-foreground">Master Ingest Switch</label>
            <span id="setting-ingest-label" class="text-xs font-bold text-emerald-500">Active</span>
          </div>
          <div class="mt-2 flex items-center justify-between">
            <span class="text-[11px] text-muted-foreground">Accept incoming runs</span>
            <label class="relative inline-flex items-center cursor-pointer">
              <input id="setting-ingest-enabled" type="checkbox" checked class="sr-only peer" />
              <div class="w-8 h-4.5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-500"></div>
            </label>
          </div>
        </div>

        <!-- Paused Account Policy -->
        <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
          <label for="setting-paused-policy" class="text-xs font-bold text-foreground">Paused Account Policy</label>
          <select
            id="setting-paused-policy"
            class="mt-2 w-full rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-medium text-foreground focus:outline-none cursor-pointer"
          >
            <option value="reject">Reject Ingest (Disabled)</option>
            <option value="accept">Allow Ingest Silently</option>
          </select>
        </div>

        <!-- Max Batch Pins -->
        <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
          <label for="setting-max-batch" class="text-xs font-bold text-foreground">Max Batch Pins</label>
          <div class="mt-2 flex items-center gap-1.5">
            <input
              id="setting-max-batch"
              type="number"
              min="10"
              max="5000"
              value="500"
              class="w-full rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-bold text-foreground focus:outline-none"
            />
            <span class="text-xs font-semibold text-muted-foreground">pins</span>
          </div>
        </div>

        <!-- Refresh Max Pins -->
        <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <label for="setting-refresh-max-pins" class="text-xs font-bold text-foreground">Refresh Max Pins</label>
            <span class="text-[10px] text-muted-foreground font-semibold">0 = unlimited</span>
          </div>
          <div class="mt-2 flex items-center gap-1.5">
            <input
              id="setting-refresh-max-pins"
              type="number"
              min="0"
              max="10000"
              value="0"
              class="w-full rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-bold text-foreground focus:outline-none"
            />
            <span class="text-xs font-semibold text-muted-foreground">pins</span>
          </div>
        </div>
      </div>

      <!-- Tier 2: Archive Filter Rules (OR) -->
      <div class="pt-3 border-t border-border/60">
        <div class="flex items-center justify-between mb-2.5">
          <h3 class="text-xs font-bold text-foreground">Archive Filter Rules (OR Semantics)</h3>
          <span class="text-[11px] text-muted-foreground">A pin is archived if ANY rule matches. 0 = disabled.</span>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
          <!-- Rule 1 — Min Saves ≥ -->
          <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="h-5 w-5 rounded-full bg-primary/10 text-primary text-[10px] font-bold inline-flex items-center justify-center shrink-0">1</span>
              <label for="setting-min-saves" class="text-xs font-bold text-foreground truncate">Min Saves ≥</label>
            </div>
            <input
              id="setting-min-saves"
              type="number"
              min="0"
              max="1000000"
              value="0"
              class="w-full rounded-lg border border-border bg-card h-8 px-2.5 py-1 text-xs font-medium text-foreground focus:outline-none"
            />
          </div>

          <!-- Rule 2 — Min Repins ≥ -->
          <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="h-5 w-5 rounded-full bg-primary/10 text-primary text-[10px] font-bold inline-flex items-center justify-center shrink-0">2</span>
              <label for="setting-min-repins" class="text-xs font-bold text-foreground truncate">Min Repins ≥</label>
            </div>
            <input
              id="setting-min-repins"
              type="number"
              min="0"
              max="1000000"
              value="0"
              class="w-full rounded-lg border border-border bg-card h-8 px-2.5 py-1 text-xs font-medium text-foreground focus:outline-none"
            />
          </div>

          <!-- Rule 3 — Rising: Age ≤ (days) -->
          <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="h-5 w-5 rounded-full bg-primary/10 text-primary text-[10px] font-bold inline-flex items-center justify-center shrink-0">3</span>
              <label for="setting-rising-age" class="text-xs font-bold text-foreground truncate">Rising: Age ≤ (d)</label>
            </div>
            <input
              id="setting-rising-age"
              type="number"
              min="0"
              max="365"
              value="14"
              class="w-full rounded-lg border border-border bg-card h-8 px-2.5 py-1 text-xs font-medium text-foreground focus:outline-none"
            />
          </div>

          <!-- Rule 3 — Rising: Min Saves ≥ -->
          <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
            <div class="flex items-center gap-1.5 mb-1.5">
              <span class="h-5 w-5 rounded-full bg-primary/10 text-primary text-[10px] font-bold inline-flex items-center justify-center shrink-0">3</span>
              <label for="setting-rising-saves" class="text-xs font-bold text-foreground truncate">Rising: Saves ≥</label>
            </div>
            <input
              id="setting-rising-saves"
              type="number"
              min="0"
              max="1000000"
              value="34"
              class="w-full rounded-lg border border-border bg-card h-8 px-2.5 py-1 text-xs font-medium text-foreground focus:outline-none"
            />
          </div>
        </div>
      </div>

      <!-- Tier 3: Execution Settings (GH Brain & GAS Thin Writer) -->
      <div class="pt-3 border-t border-border/60">
        <div class="flex items-center justify-between mb-2.5">
          <h3 class="text-xs font-bold text-foreground">GH Brain &amp; Sheet Execution Settings</h3>
          <span class="text-[11px] text-muted-foreground">Governs discovery heuristics, candidate storage, and Google Sheets sync.</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          <!-- Card 1: Discovery Stop Pages -->
          <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
            <label for="setting-discovery-stop-pages" class="text-xs font-bold text-foreground">Discovery Stop</label>
            <div class="mt-2 flex items-center gap-1.5">
              <input
                id="setting-discovery-stop-pages"
                type="number"
                min="1"
                max="10"
                value="3"
                class="w-full rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-bold text-foreground focus:outline-none"
              />
              <span class="text-[11px] font-medium text-muted-foreground">pages</span>
            </div>
            <span class="text-[10px] text-muted-foreground mt-1">Stop after K all-known pages</span>
          </div>

          <!-- Card 1.3: Audit Sweep Enabled -->
          <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <label for="setting-audit-sweep-enabled" class="text-xs font-bold text-foreground">Monthly Sweep</label>
              <span id="setting-audit-sweep-label" class="text-xs font-bold text-emerald-500">Active</span>
            </div>
            <div class="mt-2 flex items-center justify-between">
              <span class="text-[11px] text-muted-foreground">Day-1 02:00 full scan</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input id="setting-audit-sweep-enabled" type="checkbox" checked class="sr-only peer" />
                <div class="w-8 h-4.5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-500"></div>
              </label>
            </div>
            <span class="text-[10px] text-muted-foreground mt-1">Audit sweep enabled</span>
          </div>

          <!-- Card 4.1: Candidates Enabled -->
          <div class="rounded-xl border border-border bg-background p-3 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <label for="setting-candidates-enabled" class="text-xs font-bold text-foreground">Track Candidates</label>
              <span id="setting-candidates-label" class="text-xs font-bold text-emerald-500">Active</span>
            </div>
            <div class="mt-2 flex items-center justify-between">
              <span class="text-[11px] text-muted-foreground">Ingest unarchived pins</span>
              <label class="relative inline-flex items-center cursor-pointer">
                <input id="setting-candidates-enabled" type="checkbox" checked class="sr-only peer" />
                <div class="w-8 h-4.5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-emerald-500"></div>
              </label>
            </div>
            <span class="text-[10px] text-muted-foreground mt-1">Re-evaluate as metrics grow</span>
          </div>

          <!-- Card 5.1: Sheet Write Mode -->
