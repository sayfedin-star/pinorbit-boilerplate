---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
---

<Layout title="PinArchive Intelligence" description="Historical pin performance, winning recipe clusters, SEO topics, and canonical variations.">
  <!-- ═══ Header & Primary Controls ═══ -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-4">
    <div>
      <SectionHeader
        title="PinArchive Intelligence"
        description="Historical pin performance archive, high-velocity winners, SEO topic clusters, and canonical groupings."
      />
      <div id="refresh-meta-line" class="text-xs text-muted-foreground -mt-3 mb-2 flex items-center gap-1.5">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
        <span id="refresh-meta-text">Loading sync schedule...</span>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-auto">
      <!-- View Toggle -->
      <div class="flex items-center bg-card border border-border rounded-xl p-1 shadow-sm">
        <button
          id="view-grid-btn"
          type="button"
          class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-primary text-primary-foreground shadow-xs transition-all"
        >
          Grid View
        </button>
        <button
          id="view-board-btn"
          type="button"
          class="px-2.5 py-1 text-xs font-semibold rounded-lg text-muted-foreground hover:text-foreground transition-all"
        >
          By Board
        </button>
      </div>

      <!-- CSV Export Button -->
      <button
        id="export-csv-btn"
        type="button"
        title="Export current filtered view to CSV"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Export CSV</span>
      </button>

      <!-- Refresh Button -->
      <button
        id="refresh-btn"
        type="button"
        title="Refresh PinArchive data"
        class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all"
      >
        <svg id="refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/>
        </svg>
        <span>Refresh</span>
      </button>
    </div>
  </div>

  <!-- ═══ KPI Totals Bar (Full Numbers) ═══ -->
  <div class="mb-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Archived Accounts</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-2" id="kpi-accounts-count">
        <div class="h-7 w-12 bg-muted/60 rounded animate-pulse"></div>
      </div>
      <div class="mt-1 text-[11px] text-muted-foreground" id="kpi-accounts-sub">Tracked in archive</div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Archived Pins</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
        </span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-emerald-500 mt-2" id="kpi-archived-pins">
        <div class="h-7 w-16 bg-muted/60 rounded animate-pulse"></div>
      </div>
      <div class="mt-1 text-[11px] text-muted-foreground" id="kpi-archived-sub">With verified metrics</div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Total Saves</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-500/10 text-rose-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-2" id="kpi-total-saves">
        <div class="h-7 w-20 bg-muted/60 rounded animate-pulse"></div>
      </div>
      <div class="mt-1 text-[11px] text-muted-foreground" id="kpi-saves-sub">Cumulative pin saves</div>
    </div>

    <div class="rounded-xl border border-border bg-card p-5 shadow-sm hover:shadow-md transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Total Shares</span>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-500/10 text-blue-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        </span>
      </div>
      <div class="text-2xl font-bold tracking-tight text-foreground mt-2" id="kpi-total-shares">
        <div class="h-7 w-16 bg-muted/60 rounded animate-pulse"></div>
      </div>
      <div class="mt-1 text-[11px] text-muted-foreground" id="kpi-shares-sub">Social engagement signals</div>
    </div>
  </div>

  <!-- ═══ Ingestion Controls Card (Unit A4) ═══ -->
  <section class="mb-8 rounded-xl border border-border bg-card p-5 shadow-sm space-y-4" aria-labelledby="ingest-settings-heading">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-border">
      <div>
        <h2 id="ingest-settings-heading" class="text-sm font-bold text-foreground flex items-center gap-2">
          <span>⚙️ GAS Ingestion Controls</span>
          <span id="settings-role-badge" class="hidden text-[10px] font-semibold px-2 py-0.5 rounded-full bg-muted text-muted-foreground">Admin Only</span>
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">Workspace-level gatekeeper limits and paused account ingestion policy.</p>
      </div>
      <div class="flex items-center gap-3">
        <span id="settings-status-msg" class="text-xs font-semibold"></span>
        <button
          id="save-ingest-settings-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 py-1.5 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary/90 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span>Save Settings</span>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Master Ingestion Switch -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold text-foreground block">Master Ingest</span>
          <span class="text-[11px] text-muted-foreground">Enable/pause all GAS ingestion.</span>
        </div>
        <div class="mt-2.5 flex items-center gap-2">
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="setting-ingest-enabled" checked class="sr-only peer" />
            <div class="w-9 h-5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
          <span id="setting-ingest-label" class="text-xs font-bold text-emerald-500">Active</span>
        </div>
      </div>

      <!-- Paused Account Policy -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-paused-policy" class="text-xs font-bold text-foreground block">Paused Policy</label>
          <span class="text-[11px] text-muted-foreground">Behavior for paused accounts.</span>
        </div>
        <select
          id="setting-paused-policy"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none cursor-pointer"
        >
          <option value="reject">Reject (Skip Paused)</option>
          <option value="accept">Accept (Allow Ingest)</option>
        </select>
      </div>

      <!-- Default Interval Days -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-default-interval" class="text-xs font-bold text-foreground block">Default Interval</label>
          <span class="text-[11px] text-muted-foreground">For newly imported accounts (1-30d).</span>
        </div>
        <input
          id="setting-default-interval"
          type="number"
          min="1"
          max="30"
          value="3"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none"
        />
      </div>

      <!-- Max Batch Pins -->
      <div class="rounded-lg border border-border bg-background p-3 flex flex-col justify-between">
        <div>
          <label for="setting-max-batch" class="text-xs font-bold text-foreground block">Max Batch Pins</label>
          <span class="text-[11px] text-muted-foreground">Safety cap per push (1-5000).</span>
        </div>
        <input
          id="setting-max-batch"
          type="number"
          min="1"
          max="5000"
          value="500"
          class="mt-2.5 w-full rounded-lg border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-foreground focus:outline-none"
        />
      </div>
    </div>
  </section>

  <!-- ═══ View A: Accounts Strip with Bulk Delete Action Bar ═══ -->
  <section class="mb-8" aria-labelledby="accounts-section-heading">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <h2 id="accounts-section-heading" class="text-sm font-bold text-foreground flex items-center gap-2">
        <span>👤 Tracked Accounts</span>
        <span class="text-xs font-normal text-muted-foreground" id="accounts-strip-count"></span>
      </h2>

      <!-- Account Selection Action Bar -->
      <div id="accounts-action-bar" class="hidden items-center gap-2 animate-in fade-in duration-150">
        <span id="accounts-selected-label" class="text-xs font-bold text-foreground">0 selected</span>
        <button
          id="delete-selected-accounts-btn"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-xl bg-rose-500 hover:bg-rose-600 text-white px-3 py-1.5 text-xs font-bold shadow-xs transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
          <span id="delete-accounts-btn-text">Delete Selected</span>
        </button>
        <button
          id="clear-account-selection-btn"
          type="button"
          class="rounded-xl border border-border bg-card px-2.5 py-1.5 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors"
        >
          Cancel
        </button>
      </div>
    </div>

    <div class="overflow-x-auto pb-2">
      <div id="accounts-strip" class="flex gap-4 min-w-full">
        <!-- Skeleton cards -->
        <div class="w-72 shrink-0 rounded-xl border border-border bg-card p-4 shadow-sm animate-pulse space-y-3">
          <div class="h-4 w-28 bg-muted rounded"></div>
          <div class="h-3 w-40 bg-muted rounded"></div>
          <div class="h-3 w-20 bg-muted rounded"></div>
        </div>
        <div class="w-72 shrink-0 rounded-xl border border-border bg-card p-4 shadow-sm animate-pulse space-y-3">
          <div class="h-4 w-28 bg-muted rounded"></div>
          <div class="h-3 w-40 bg-muted rounded"></div>
          <div class="h-3 w-20 bg-muted rounded"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Filter & Search Control Toolbar (T3) ═══ -->
  <div class="rounded-xl border border-border bg-card p-4 shadow-sm mb-8 space-y-3">
    <div class="flex flex-wrap items-center gap-3 justify-between">
      <!-- Left Controls -->
      <div class="flex flex-wrap items-center gap-2.5 flex-1 min-w-[280px]">
        <!-- Search -->
        <div class="relative flex-1 min-w-[180px] max-w-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            id="filter-search-input"
            type="text"
            placeholder="Search pin title…"
            class="w-full rounded-xl border border-border bg-background py-1.5 pl-8 pr-7 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
          <kbd class="absolute right-2 top-1/2 -translate-y-1/2 rounded border border-border bg-muted px-1 text-[9px] font-bold text-muted-foreground">/</kbd>
        </div>

        <!-- Board Filter -->
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5">
          <label for="filter-board-select" class="text-xs font-semibold text-muted-foreground">Board:</label>
          <select id="filter-board-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer max-w-[140px] truncate">
            <option value="">All Boards</option>
          </select>
        </div>

        <!-- Stage Filter -->
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5">
          <label for="filter-stage-select" class="text-xs font-semibold text-muted-foreground">Stage:</label>
          <select id="filter-stage-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
            <option value="">All Stages</option>
            <option value="NEW">🟢 NEW (≤14d)</option>
            <option value="GROWING">🚀 GROWING (≥10/d)</option>
            <option value="MATURE">🟣 MATURE (&gt;14d)</option>
            <option value="COOLING">❄️ COOLING (&lt;2/d)</option>
            <option value="DORMANT">⚪ DORMANT (&lt;0.5/d)</option>
          </select>
        </div>

        <!-- Min Saves -->
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5">
          <label for="filter-min-saves" class="text-xs font-semibold text-muted-foreground">Min Saves:</label>
          <input
            id="filter-min-saves"
            type="number"
            placeholder="0"
            min="0"
            class="w-16 bg-transparent text-xs font-medium text-foreground focus:outline-none"
          />
        </div>

        <!-- In-Cluster Toggle -->
        <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-medium text-muted-foreground hover:text-foreground">
          <input id="filter-cluster-toggle" type="checkbox" class="rounded border-border text-primary focus:ring-primary h-4 w-4" />
          <span>In Cluster Only</span>
        </label>
      </div>

      <!-- Right Controls: Sort & Limit -->
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5">
          <label for="pins-sort-select" class="text-xs font-semibold text-muted-foreground">Sort:</label>
          <select id="pins-sort-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
            <option value="saves">Total Saves</option>
            <option value="velocity">Velocity (Saves/Day)</option>
          </select>
        </div>

        <div class="flex items-center gap-1.5 bg-background border border-border rounded-xl px-2.5 py-1.5">
          <label for="pins-limit-select" class="text-xs font-semibold text-muted-foreground">Limit:</label>
          <select id="pins-limit-select" class="bg-transparent text-xs font-medium text-foreground focus:outline-none cursor-pointer">
            <option value="25">25</option>
            <option value="50" selected>50</option>
            <option value="100">100</option>
            <option value="200">200</option>
          </select>
        </div>

        <button id="clear-filters-btn" type="button" class="text-xs font-semibold text-muted-foreground hover:text-primary px-2 py-1">
          Clear
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ 2-Column Section: View B (Winners Grid / Boards) & View C (Topics + Topic ROI) ═══ -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-10">
    <!-- View B: Winners Grid / By Board (8 cols on lg) -->
    <section class="lg:col-span-8" aria-labelledby="winners-section-heading">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 id="winners-section-heading" class="text-base font-bold text-foreground flex items-center gap-2">
            <span>🏆 Winning Pins</span>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-primary/10 text-primary" id="winners-badge-count">0</span>
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">Top performing archived pins ranked by selected metric.</p>
        </div>
      </div>

      <!-- Main Pins Container (Grid View or By Board View) -->
      <div id="winners-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-2 gap-4">
        <!-- Shimmer skeletons -->
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm animate-pulse space-y-3">
          <div class="h-44 bg-muted rounded-lg"></div>
          <div class="h-4 w-3/4 bg-muted rounded"></div>
          <div class="h-3 w-1/2 bg-muted rounded"></div>
        </div>
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm animate-pulse space-y-3">
          <div class="h-44 bg-muted rounded-lg"></div>
          <div class="h-4 w-3/4 bg-muted rounded"></div>
          <div class="h-3 w-1/2 bg-muted rounded"></div>
        </div>
      </div>

      <!-- By Board Container (hidden by default) -->
      <div id="by-board-container" class="hidden space-y-6"></div>
    </section>

    <!-- View C: Topics & Topic ROI (4 cols on lg) -->
    <section class="lg:col-span-4 space-y-6" aria-labelledby="topics-section-heading">
      <!-- 1. Topic ROI Efficiency Ranking (T2) -->
      <div class="rounded-xl border border-border bg-card shadow-sm p-4">
        <div class="mb-3">
          <h2 class="text-sm font-bold text-foreground flex items-center gap-2">
            <span>⚡ Topic ROI Efficiency</span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500">Top 10</span>
          </h2>
          <p class="text-[11px] text-muted-foreground mt-0.5">Average saves generated per pin for keyword clusters.</p>
        </div>

        <div id="topic-roi-list" class="space-y-2.5 max-h-[300px] overflow-y-auto pr-1">
          <!-- Skeletons -->
          <div class="space-y-1 animate-pulse">
            <div class="flex justify-between h-3 bg-muted rounded w-full"></div>
            <div class="h-1.5 bg-muted/60 rounded w-full"></div>
          </div>
          <div class="space-y-1 animate-pulse">
            <div class="flex justify-between h-3 bg-muted rounded w-full"></div>
            <div class="h-1.5 bg-muted/60 rounded w-full"></div>
          </div>
        </div>
      </div>

      <!-- 2. Top Topics Total Volume -->
      <div class="rounded-xl border border-border bg-card shadow-sm p-4">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h2 id="topics-section-heading" class="text-sm font-bold text-foreground flex items-center gap-2">
              <span>🏷️ All Topic Clusters</span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-500" id="topics-badge-count">0</span>
            </h2>
            <p class="text-[11px] text-muted-foreground mt-0.5">Volume & direct links to Pinterest Ideas.</p>
          </div>
        </div>

        <div id="topics-list" class="space-y-2.5 max-h-[420px] overflow-y-auto pr-1">
          <!-- Shimmer skeletons -->
          <div class="space-y-1 animate-pulse">
            <div class="flex justify-between h-3 bg-muted rounded w-full"></div>
            <div class="h-1.5 bg-muted/60 rounded w-full"></div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ═══ View D: Canonical Duplicate Clusters ═══ -->
  <section class="mb-12" aria-labelledby="canonical-section-heading">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 id="canonical-section-heading" class="text-base font-bold text-foreground flex items-center gap-2">
          <span>🧬 Canonical Clusters</span>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-500" id="canonical-badge-count">0 Clusters</span>
        </h2>
        <p class="text-xs text-muted-foreground mt-0.5">Grouped pin variations sharing the same underlying Pinterest canonical ID.</p>
      </div>
    </div>

    <div class="rounded-xl border border-border bg-card shadow-sm overflow-hidden">
      <div id="canonical-container" class="divide-y divide-border">
        <!-- Skeleton -->
        <div class="p-4 animate-pulse space-y-2">
          <div class="h-4 w-48 bg-muted rounded"></div>
          <div class="h-3 w-72 bg-muted rounded"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Delete Accounts Confirmation Modal ═══ -->
  <div id="delete-accounts-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4">
    <div class="relative w-full max-w-md rounded-2xl border border-rose-500/40 bg-card p-6 shadow-2xl space-y-4">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-500/10 text-rose-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        <div>
          <h3 class="text-base font-bold text-foreground">Confirm Account Deletion</h3>
          <p class="text-xs text-muted-foreground">This action removes tracked account data from PinArchive.</p>
        </div>
      </div>

      <div class="rounded-xl bg-rose-500/5 border border-rose-500/20 p-3 text-xs text-muted-foreground space-y-1.5">
        <p><strong class="text-foreground">Cascade Clean:</strong> All archived pins, metrics snapshots, and refresh runs for selected accounts will be permanently deleted from the database.</p>
        <p class="text-emerald-600 dark:text-emerald-400 font-semibold">ℹ️ Google Sheets lake is untouched; data can be re-ingested later.</p>
      </div>

      <div class="space-y-2">
        <label for="delete-confirm-input" class="block text-xs font-semibold text-foreground">
          Type <span class="font-mono text-rose-500 font-bold">DELETE</span> to confirm:
        </label>
        <input
          id="delete-confirm-input"
          type="text"
          placeholder="DELETE"
          class="w-full rounded-xl border border-border bg-background p-2.5 text-xs text-foreground focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500 font-mono"
        />
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-border">
        <button
          id="cancel-delete-modal-btn"
          type="button"
          class="rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors"
        >
          Cancel
        </button>
        <button
          id="confirm-delete-modal-btn"
          type="button"
          disabled
          class="rounded-xl bg-rose-500 hover:bg-rose-600 disabled:opacity-50 disabled:pointer-events-none text-white px-4 py-2 text-xs font-bold shadow-sm transition-colors"
        >
          Delete Accounts
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ Floating Compare Bar (T3) ═══ -->
  <div id="floating-compare-bar" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-card border border-primary/40 rounded-2xl shadow-2xl px-5 py-3 flex items-center gap-4 animate-in fade-in duration-200">
    <div class="flex items-center gap-2">
      <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary/10 text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
      </span>
      <span id="compare-count-text" class="text-xs font-bold text-foreground">2 Pins Selected</span>
    </div>
    <div class="flex items-center gap-2">
      <button id="launch-compare-btn" type="button" class="rounded-xl bg-primary px-3.5 py-1.5 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-all">
        Compare Trajectories
      </button>
      <button id="clear-compare-btn" type="button" class="rounded-xl border border-border bg-background px-2.5 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">
        Clear
      </button>
    </div>
  </div>

  <!-- ═══ Compare Modal Dialog (T3) ═══ -->
  <div id="compare-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4">
    <div class="relative w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-2xl border border-border bg-card p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-border mb-4">
        <div class="flex items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/></svg>
          </span>
          <h3 class="text-base font-bold text-foreground">Pin Trajectory Comparison</h3>
        </div>
        <button id="close-compare-modal" type="button" class="text-muted-foreground hover:text-foreground p-1 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="compare-modal-content" class="space-y-6">
        <!-- Dynamic comparison content injected here -->
      </div>
    </div>
  </div>
</Layout>

<script>
  let rawPins: any[] = [];
  let rawAccounts: any[] = [];
  let currentSort = 'saves';
  let currentLimit = 50;
  let activeView: 'grid' | 'board' = 'grid';
  const selectedForCompare = new Set<string>();
  const selectedAccounts = new Set<string>();

  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Full numbers formatting (no k/M abbreviations)
  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function timeAgo(isoString?: string | null): string {
    if (!isoString) return 'never';
    try {
      const diffMs = Date.now() - new Date(isoString).getTime();
      const mins = Math.floor(diffMs / 60000);
      if (mins < 60) return `${Math.max(1, mins)}m ago`;
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return `${hrs}h ago`;
      const days = Math.floor(hrs / 24);
      return `${days}d ago`;
    } catch {
      return 'recently';
    }
  }

  function renderStageBadge(stage?: string | null): string {
    switch (stage) {
      case 'NEW':
        return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">🟢 NEW</span>';
      case 'GROWING':
        return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">🚀 GROWING</span>';
      case 'MATURE':
        return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">🟣 MATURE</span>';
      case 'COOLING':
        return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">❄️ COOLING</span>';
      default:
        return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-500/10 text-slate-500 border border-slate-500/20">⚪ DORMANT</span>';
    }
  }

  function renderAnomalyBadge(anomaly?: string | null): string {
    if (anomaly === 'SPIKE') {
      return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-500 border border-rose-500/20 animate-pulse">🔥 SPIKE</span>';
    }
    if (anomaly === 'COOLING') {
      return '<span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20">❄️ COOLING</span>';
    }
    return '';
  }

  async function loadOverview() {
    try {
      const res = await fetch('/api/pinarchive/overview');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load overview');

      const totals = json.totals || {};
      const accounts = json.accounts || [];
      rawAccounts = accounts;

      // Update KPI cards (full numbers via fmtNumber)
      const kpiAccounts = document.getElementById('kpi-accounts-count');
      if (kpiAccounts) kpiAccounts.textContent = fmtNumber(totals.accounts);

      const kpiArchived = document.getElementById('kpi-archived-pins');
      if (kpiArchived) kpiArchived.textContent = fmtNumber(totals.archived_pins);

      const kpiSaves = document.getElementById('kpi-total-saves');
      if (kpiSaves) kpiSaves.textContent = fmtNumber(totals.sum_saves);

      const kpiShares = document.getElementById('kpi-total-shares');
      if (kpiShares) kpiShares.textContent = fmtNumber(totals.sum_shares);

      // Meta refresh line
      const metaText = document.getElementById('refresh-meta-text');
      if (metaText && accounts.length > 0) {
        const firstAcc = accounts[0];
        metaText.textContent = `Last refreshed ${timeAgo(firstAcc.last_run_at)} · next cycle ~${firstAcc.interval_days || 3}d`;
      }

      // Render Accounts Strip with Checkboxes
      renderAccountsStrip(accounts);
    } catch (e: any) {
      console.error('Error loading PinArchive overview:', e);
    }
  }

  let canAdminSettings = true;

  async function loadSettings() {
    try {
      const res = await fetch('/api/pinarchive/settings');
      if (res.status === 401 || res.status === 403) {
        canAdminSettings = false;
        disableSettingsForm();
        return;
      }
      const json = await res.json();
      if (!json.success) return;

      const ingestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
      const ingestLabel = document.getElementById('setting-ingest-label');
      const policySel = document.getElementById('setting-paused-policy') as HTMLSelectElement | null;
      const intervalInp = document.getElementById('setting-default-interval') as HTMLInputElement | null;
      const maxBatchInp = document.getElementById('setting-max-batch') as HTMLInputElement | null;

      if (ingestCb) {
        ingestCb.checked = Boolean(json.ingest_enabled);
        if (ingestLabel) {
          ingestLabel.textContent = ingestCb.checked ? 'Active' : 'Disabled';
          ingestLabel.className = `text-xs font-bold ${ingestCb.checked ? 'text-emerald-500' : 'text-rose-500'}`;
        }
      }
      if (policySel) policySel.value = json.paused_account_policy || 'reject';
      if (intervalInp) intervalInp.value = String(json.default_interval_days || 3);
      if (maxBatchInp) maxBatchInp.value = String(json.max_batch_pins || 500);
    } catch (e) {
      console.error('Failed to load settings:', e);
    }
  }

  function disableSettingsForm() {
    const saveBtn = document.getElementById('save-ingest-settings-btn') as HTMLButtonElement | null;
    const roleBadge = document.getElementById('settings-role-badge');
    const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      '#setting-ingest-enabled, #setting-paused-policy, #setting-default-interval, #setting-max-batch'
    );
    inputs.forEach((el) => {
      el.disabled = true;
    });
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.classList.add('hidden');
    }
    if (roleBadge) roleBadge.classList.remove('hidden');
  }

  async function saveSettings() {
    const ingestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
    const policySel = document.getElementById('setting-paused-policy') as HTMLSelectElement | null;
    const intervalInp = document.getElementById('setting-default-interval') as HTMLInputElement | null;
    const maxBatchInp = document.getElementById('setting-max-batch') as HTMLInputElement | null;
    const statusMsg = document.getElementById('settings-status-msg');
    const saveBtn = document.getElementById('save-ingest-settings-btn') as HTMLButtonElement | null;

    if (!ingestCb || !policySel || !intervalInp || !maxBatchInp) return;

    if (saveBtn) saveBtn.disabled = true;
    if (statusMsg) {
      statusMsg.textContent = 'Saving...';
      statusMsg.className = 'text-xs font-semibold text-muted-foreground';
    }

    try {
      const res = await fetch('/api/pinarchive/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ingest_enabled: ingestCb.checked,
          paused_account_policy: policySel.value,
          default_interval_days: parseInt(intervalInp.value, 10) || 3,
          max_batch_pins: parseInt(maxBatchInp.value, 10) || 500,
        }),
      });

      if (res.status === 403) {
        canAdminSettings = false;
        disableSettingsForm();
        if (statusMsg) {
          statusMsg.textContent = 'Forbidden: Admin access required.';
          statusMsg.className = 'text-xs font-semibold text-rose-500';
        }
        return;
      }

      const json = await res.json();
      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Failed to save settings');
      }

      if (statusMsg) {
        statusMsg.textContent = 'Settings saved!';
        statusMsg.className = 'text-xs font-semibold text-emerald-500';
        setTimeout(() => {
          if (statusMsg) statusMsg.textContent = '';
        }, 3000);
      }
    } catch (e: any) {
      if (statusMsg) {
        statusMsg.textContent = e.message || 'Save failed';
        statusMsg.className = 'text-xs font-semibold text-rose-500';
      }
    } finally {
      if (saveBtn && canAdminSettings) saveBtn.disabled = false;
    }
  }

  function attachAccountIngestToggleListeners() {
    document.querySelectorAll<HTMLInputElement>('[data-acc-ingest-toggle]').forEach((cb) => {
      cb.addEventListener('change', async () => {
        const id = cb.getAttribute('data-acc-ingest-toggle');
        if (!id) return;
        const enabled = cb.checked;
        cb.disabled = true;

        try {
          const res = await fetch('/api/pinarchive/accounts-ingest-toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ account_ids: [id], ingest_enabled: enabled }),
          });

          if (res.status === 403) {
            cb.checked = !enabled;
            alert('Admin access required to toggle account ingestion.');
            return;
          }

          const json = await res.json();
          if (!res.ok || !json.success) {
            cb.checked = !enabled;
            alert(json.error || 'Failed to update account ingest status.');
          }
        } catch {
          cb.checked = !enabled;
        } finally {
          cb.disabled = false;
        }
      });
    });
  }

  function renderAccountsStrip(accounts: any[]) {
    const strip = document.getElementById('accounts-strip');
    const stripCount = document.getElementById('accounts-strip-count');
    if (stripCount) stripCount.textContent = `(${accounts.length} total)`;

    if (!strip) return;

    if (accounts.length === 0) {
      strip.innerHTML = `
        <div class="w-full text-center py-6 text-xs text-muted-foreground bg-muted/20 rounded-xl border border-dashed border-border">
          No Pinterest accounts tracked in archive yet.
        </div>
      `;
      return;
    }

    strip.innerHTML = accounts
      .map((acc: any) => {
        const isActive = acc.status === 'active';
        const dotClass = isActive ? 'bg-emerald-500' : acc.status === 'paused' ? 'bg-amber-500' : 'bg-rose-500';
        const isChecked = selectedAccounts.has(acc.id);

        return `
          <div class="w-72 shrink-0 rounded-xl border border-border bg-card p-4 shadow-sm hover:border-primary/40 transition-all flex flex-col justify-between relative">
            <div>
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2 min-w-0">
                  <input
                    type="checkbox"
                    data-acc-select="${escapeHtml(acc.id)}"
                    ${isChecked ? 'checked' : ''}
                    class="rounded border-border text-rose-500 focus:ring-rose-500 h-3.5 w-3.5 cursor-pointer"
                    id="acc-check-${escapeHtml(acc.id)}"
                  />
                  <span class="h-2 w-2 rounded-full ${dotClass} shrink-0" aria-hidden="true"></span>
                  <span class="text-sm font-bold text-foreground truncate" title="@${escapeHtml(acc.username)}">@${escapeHtml(acc.username)}</span>
                </div>
                <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded-full ${isActive ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-muted text-muted-foreground'}">
                  ${escapeHtml(acc.status)}
                </span>
              </div>
              <div class="grid grid-cols-2 gap-2 text-xs mt-3 pt-3 border-t border-border/60">
                <div>
                  <span class="text-[10px] text-muted-foreground uppercase block font-medium">Followers</span>
                  <span class="font-semibold text-foreground">${fmtNumber(acc.follower_count)}</span>
                </div>
                <div>
                  <span class="text-[10px] text-muted-foreground uppercase block font-medium">Pins Total</span>
                  <span class="font-semibold text-foreground">${fmtNumber(acc.pins_count)}</span>
                </div>
              </div>
              <div class="mt-3 pt-2 text-[10px] text-muted-foreground flex items-center justify-between border-t border-border/40">
                <span>Accept GAS Data:</span>
                <label class="relative inline-flex items-center cursor-pointer">
                  <input
                    type="checkbox"
                    data-acc-ingest-toggle="${escapeHtml(acc.id)}"
                    ${acc.ingest_enabled !== false ? 'checked' : ''}
                    class="sr-only peer"
                    id="toggle-ingest-${escapeHtml(acc.id)}"
                  />
                  <div class="w-7 h-4 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-emerald-500"></div>
                </label>
              </div>
            </div>
            <div class="mt-3 pt-2 text-[10px] text-muted-foreground flex items-center justify-between">
              <span>Last run:</span>
              <span class="font-medium">${fmtDate(acc.last_run_at)}</span>
            </div>
          </div>
        `;
      })
      .join('');

    attachAccountSelectionListeners();
    attachAccountIngestToggleListeners();
  }

  function attachAccountSelectionListeners() {
    document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-acc-select');
        if (!id) return;
        if (cb.checked) {
          selectedAccounts.add(id);
        } else {
          selectedAccounts.delete(id);
        }
        updateAccountsActionBar();
      });
    });
  }

  function updateAccountsActionBar() {
    const bar = document.getElementById('accounts-action-bar');
    const label = document.getElementById('accounts-selected-label');
    const btnText = document.getElementById('delete-accounts-btn-text');

    if (!bar) return;

    if (selectedAccounts.size > 0) {
      bar.classList.remove('hidden');
      bar.classList.add('flex');
      if (label) label.textContent = `${selectedAccounts.size} account${selectedAccounts.size === 1 ? '' : 's'} selected`;
      if (btnText) btnText.textContent = `Delete selected (${selectedAccounts.size})`;
    } else {
      bar.classList.add('hidden');
      bar.classList.remove('flex');
    }
  }

  function renderSinglePinCard(p: any): string {
    const saves = Number(p.saves || 0);
    const repins = Number(p.repins || 0);
    const velocity = Number(p.velocity || 0);
    const shares = Number(p.share_count || 0);
    const annotations = Array.isArray(p.annotations) ? p.annotations : [];
    const category = p.seo_category || p.board_name || null;
    const pinUrl = p.link || `https://www.pinterest.com/pin/${p.pin_id}/`;
    const imageUrl = p.image_url || '';
    const pinId = p.id || '';
    const isSelected = selectedForCompare.has(pinId);
    const createdDate = fmtDate(p.created_at_pinterest);

    // Linked annotations for every chip
    const tagsHtml = annotations.slice(0, 4).map((a: any) => {
      const name = typeof a === 'string' ? a : a?.name || '';
      if (!name) return '';
      let targetUrl = '';
      if (typeof a === 'object' && a?.url) {
        targetUrl = `https://www.pinterest.com${a.url.startsWith('/') ? a.url : '/' + a.url}`;
      } else if (typeof a === 'object' && a?.idea_id) {
        targetUrl = `https://www.pinterest.com/ideas/${encodeURIComponent(name)}/${a.idea_id}/`;
      } else {
        targetUrl = `https://www.pinterest.com/search/pins/?q=${encodeURIComponent(name)}`;
      }

      return `
        <a
          href="${escapeHtml(targetUrl)}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[10px] bg-primary/10 hover:bg-primary/20 text-primary px-2 py-0.5 rounded-md font-medium truncate max-w-[130px] transition-colors"
          title="${escapeHtml(name)} (Pinterest Idea)"
        >
          <span class="truncate">${escapeHtml(name)}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      `;
    }).join('');

    const moreTagsCount = annotations.length > 4 ? annotations.length - 4 : 0;

    return `
      <div class="group rounded-xl border border-border bg-card overflow-hidden shadow-sm hover:shadow-md hover:border-primary/40 transition-all flex flex-col justify-between relative">
        <!-- Compare Checkbox -->
