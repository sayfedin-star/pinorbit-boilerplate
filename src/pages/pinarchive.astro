  function attachAccountSelectionListeners() {
    const selectAllCb = document.getElementById('select-all-accounts-cb') as HTMLInputElement | null;
    if (selectAllCb) {
      selectAllCb.checked = rawAccounts.length > 0 && rawAccounts.every((a) => selectedAccounts.has(a.id));
      selectAllCb.addEventListener('change', () => {
        const checked = selectAllCb.checked;
        document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
          cb.checked = checked;
          const id = cb.getAttribute('data-acc-select');
          if (id) {
            if (checked) selectedAccounts.add(id);
            else selectedAccounts.delete(id);
          }
        });
        updateAccountsActionBar();
      });
    }

    document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-acc-select');
        if (!id) return;
        if (cb.checked) {
          selectedAccounts.add(id);
        } else {
          selectedAccounts.delete(id);
        }
        if (selectAllCb) {
          selectAllCb.checked = rawAccounts.length > 0 && rawAccounts.every((a) => selectedAccounts.has(a.id));
        }
        updateAccountsActionBar();
      });
    });
  }

  function attachSingleDeleteListeners() {
    document.querySelectorAll<HTMLButtonElement>('[data-single-delete-acc-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-single-delete-acc-id');
        if (!id) return;
        selectedAccounts.clear();
        selectedAccounts.add(id);
        document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
          cb.checked = cb.getAttribute('data-acc-select') === id;
        });
        updateAccountsActionBar();

        const modal = document.getElementById('delete-accounts-modal');
        const confirmInput = document.getElementById('delete-confirm-input') as HTMLInputElement | null;
        const confirmBtn = document.getElementById('confirm-delete-modal-btn') as HTMLButtonElement | null;
        if (modal && confirmInput && confirmBtn) {
          confirmInput.value = '';
          confirmBtn.disabled = true;
          modal.classList.remove('hidden');
          confirmInput.focus();
        }
      });
    });
  }

  function updateAccountsActionBar() {
    const bar = document.getElementById('accounts-action-bar');
    const label = document.getElementById('accounts-selected-label');
    const btnText = document.getElementById('delete-accounts-btn-text');

    if (!bar) return;

    if (selectedAccounts.size > 0) {
      bar.classList.remove('hidden');
      bar.classList.add('flex');
      if (label) label.textContent = `${selectedAccounts.size} account${selectedAccounts.size === 1 ? '' : 's'} selected`;
      if (btnText) btnText.textContent = `Delete selected (${selectedAccounts.size})`;
    } else {
      bar.classList.add('hidden');
      bar.classList.remove('flex');
    }
  }

  function setupAccountDeleteModal() {
    const deleteBtn = document.getElementById('delete-selected-accounts-btn');
    const cancelSelectionBtn = document.getElementById('clear-account-selection-btn');
    const modal = document.getElementById('delete-accounts-modal');
    const confirmInput = document.getElementById('delete-confirm-input') as HTMLInputElement | null;
    const confirmBtn = document.getElementById('confirm-delete-modal-btn') as HTMLButtonElement | null;
    const cancelModalBtn = document.getElementById('cancel-delete-modal-btn');

    if (cancelSelectionBtn) {
      cancelSelectionBtn.addEventListener('click', () => {
        selectedAccounts.clear();
        updateAccountsActionBar();
        document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
          cb.checked = false;
        });
      });
    }

    if (deleteBtn && modal && confirmInput && confirmBtn) {
      deleteBtn.addEventListener('click', () => {
        if (selectedAccounts.size === 0) return;
        confirmInput.value = '';
        confirmBtn.disabled = true;
        modal.classList.remove('hidden');
        confirmInput.focus();
      });

      confirmInput.addEventListener('input', () => {
        confirmBtn.disabled = confirmInput.value.trim() !== 'DELETE';
      });

      if (cancelModalBtn) {
        cancelModalBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
        });
      }

      confirmBtn.addEventListener('click', async () => {
        if (confirmInput.value.trim() !== 'DELETE' || selectedAccounts.size === 0) return;

        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Deleting...';

        try {
          const res = await fetch('/api/pinarchive/accounts-delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              account_ids: Array.from(selectedAccounts),
            }),
          });

          const json = await res.json();
          if (!res.ok || !json.success) {
            throw new Error(json.error || 'Failed to delete accounts');
          }

          modal.classList.add('hidden');
          selectedAccounts.clear();
          updateAccountsActionBar();

          // Refresh data
          await loadOverview();
        } catch (err: any) {
          alert(`Error deleting accounts: ${err.message}`);
        } finally {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Delete Accounts';
        }
      });
    }
  }

  function getSelectedUsernames(): string[] {
    return rawAccounts
      .filter((a) => selectedAccounts.has(a.id))
      .map((a) => a.username);
  }

  function setupBulkRefresh() {
    const refreshSelectedBtn = document.getElementById('refresh-selected-accounts-btn') as HTMLButtonElement | null;
    const refreshSelectedIcon = document.getElementById('refresh-selected-icon');

    if (refreshSelectedBtn) {
      refreshSelectedBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;

        if (!confirm(`Run archive refresh for ${usernames.length} selected account(s)? This will dispatch background worker refreshes.`)) {
          return;
        }

        refreshSelectedBtn.disabled = true;
        if (refreshSelectedIcon) refreshSelectedIcon.classList.add('animate-spin');
        const root = document.getElementById('pinarchive-page-root');
        const workspaceId = root?.getAttribute('data-workspace-id') || '';

        try {
          const payload = usernames.length === 1
            ? { workspace_id: workspaceId, username: usernames[0] }
            : { workspace_id: workspaceId, usernames };

          const res = await fetch('/api/internal/pinarchive/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (res.status === 202 || res.ok) {
            if (usernames.length === 1) {
              toast(`Refresh queued for @${usernames[0]}`, 'success');
            } else {
              toast(`Queued 1 refresh run for ${usernames.length} accounts`, 'success');
            }
          } else if (res.status === 403) {
            toast('Admin required', 'error');
          } else if (res.status === 503) {
            toast('Refresh not configured on server yet', 'error');
          } else {
            const data = await res.json().catch(() => ({}));
            toast(data.error || 'Failed to dispatch refresh', 'error');
          }
        } catch (e: any) {
          console.error('Failed to dispatch refresh:', e);
          toast(e?.message || 'Network error triggering refresh', 'error');
        } finally {
          if (refreshSelectedIcon) refreshSelectedIcon.classList.remove('animate-spin');
          refreshSelectedBtn.disabled = false;
        }
      });
    }
  }

  function setupBulkGasControls() {
    setupBulkRefresh();

    // Bulk Run Now
    const runBtn = document.getElementById('gas-bulk-run-btn') as HTMLButtonElement | null;
    if (runBtn) {
      runBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;
        runBtn.disabled = true;
        toast(`Triggered pipeline run for ${usernames.length} account(s)...`, 'info');

        try {
          const res = await fetch('/api/pinarchive/accounts-gas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'run_now', usernames }),
          });
          const json = await res.json();
          if (json.success) {
            toast(`Pipeline run queued for ${usernames.join(', ')}.`, 'success');
          } else {
            toast(json.error || 'Failed to dispatch pipeline run', 'error');
          }
        } catch (err: any) {
          toast(err?.message || 'Network error triggering pipeline run', 'error');
        } finally {
          runBtn.disabled = false;
        }
      });
    }

    // Bulk Sync Now
    const syncBtn = document.getElementById('gas-bulk-sync-btn') as HTMLButtonElement | null;
    if (syncBtn) {
      syncBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;
        syncBtn.disabled = true;
        toast(`Re-evaluating candidates for ${usernames.length} account(s)...`, 'info');

        try {
          const res = await fetch('/api/pinarchive/accounts-gas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'sync_now', usernames }),
          });
          const json = await res.json();
          if (json.success) {
            toast(`Candidate re-evaluation complete!`, 'success');
            await loadOverview();
          } else {
            toast(json.error || 'Failed to re-evaluate candidates', 'error');
          }
        } catch (err: any) {
          toast(err?.message || 'Network error triggering candidate re-evaluation', 'error');
        } finally {
          syncBtn.disabled = false;
        }
      });
    }

    // Bulk Pause
    const pauseBtn = document.getElementById('gas-bulk-pause-btn') as HTMLButtonElement | null;
    if (pauseBtn) {
      pauseBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;
        pauseBtn.disabled = true;

        try {
          const res = await fetch('/api/pinarchive/accounts-gas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'pause', usernames }),
          });
          const json = await res.json();
          if (json.success) {
            toast(`Paused ${usernames.length} account(s).`, 'success');
            await loadOverview();
          } else {
            toast(json.error || 'Failed to pause accounts', 'error');
          }
        } catch (err: any) {
          toast(err?.message || 'Network error pausing accounts', 'error');
        } finally {
          pauseBtn.disabled = false;
        }
      });
    }

    // Bulk Resume
    const resumeBtn = document.getElementById('gas-bulk-resume-btn') as HTMLButtonElement | null;
    if (resumeBtn) {
      resumeBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;
        resumeBtn.disabled = true;

        try {
          const res = await fetch('/api/pinarchive/accounts-gas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'resume', usernames }),
          });
          const json = await res.json();
          if (json.success) {
            toast(`Resumed ${usernames.length} account(s).`, 'success');
            await loadOverview();
          } else {
            toast(json.error || 'Failed to resume accounts', 'error');
          }
        } catch (err: any) {
          toast(err?.message || 'Network error resuming accounts', 'error');
        } finally {
          resumeBtn.disabled = false;
        }
      });
    }
  }

  function setupAccountSearch() {
    const searchInput = document.getElementById('account-search-input') as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        accountSearchTerm = searchInput.value.trim();
        filterAndRenderAccounts();
      });
    }
  }

  function setupTabs() {
    const btnAccounts = document.getElementById('pa-tab-btn-accounts');
    const btnAutomation = document.getElementById('pa-tab-btn-automation');
    const viewAccounts = document.getElementById('pa-tab-view-accounts');
    const viewAutomation = document.getElementById('pa-tab-view-automation');

    if (!btnAccounts || !btnAutomation || !viewAccounts || !viewAutomation) return;

    // Clean up any legacy localStorage key that might have trapped users
    try {
      localStorage.removeItem('pa_active_tab');
    } catch (_) {}

    function activateTab(tab: 'accounts' | 'automation', updateUrl = true) {
      if (tab === 'automation') {
        viewAccounts?.classList.add('hidden');
        viewAutomation?.classList.remove('hidden');

        btnAutomation?.classList.remove('text-muted-foreground', 'hover:bg-muted/60');
        btnAutomation?.classList.add('bg-primary', 'text-primary-foreground', 'shadow-xs');

        btnAccounts?.classList.remove('bg-primary', 'text-primary-foreground', 'shadow-xs');
        btnAccounts?.classList.add('text-muted-foreground', 'hover:bg-muted/60');

        if (updateUrl && window.location.hash !== '#automation') {
          history.replaceState(null, '', '#automation');
        }
      } else {
        viewAutomation?.classList.add('hidden');
        viewAccounts?.classList.remove('hidden');

        btnAccounts?.classList.remove('text-muted-foreground', 'hover:bg-muted/60');
        btnAccounts?.classList.add('bg-primary', 'text-primary-foreground', 'shadow-xs');

        btnAutomation?.classList.remove('bg-primary', 'text-primary-foreground', 'shadow-xs');
        btnAutomation?.classList.add('text-muted-foreground', 'hover:bg-muted/60');

        if (updateUrl && window.location.hash) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }
    }

    btnAccounts.addEventListener('click', () => activateTab('accounts', true));
    btnAutomation.addEventListener('click', () => activateTab('automation', true));

    window.addEventListener('hashchange', () => {
      const isAutomation = window.location.hash === '#automation' || window.location.hash === '#pipeline';
      activateTab(isAutomation ? 'automation' : 'accounts', false);
    });

    // Default to 'accounts' unless the URL explicitly contains '#automation' or '#pipeline'
    const isAutomationInitial = window.location.hash === '#automation' || window.location.hash === '#pipeline';
    if (isAutomationInitial) {
      activateTab('automation', false);
    } else {
      activateTab('accounts', false);
    }
  }

  function init() {
    setupTabs();
    setupSettingsCollapse();
    setupAccountSearch();
    buildColVisibilityMenu();
    setupColVisibilityToggle();
    renderTableHeader();
    setupReevaluateButton();
    loadSettings();
    loadOverview();
    setupAccountDeleteModal();
    setupBulkGasControls();

    // Ingest settings save button
    const saveSettingsBtn = document.getElementById('save-ingest-settings-btn');
    if (saveSettingsBtn) {
      saveSettingsBtn.addEventListener('click', saveSettings);
    }

    // Listen for audit timestamp display preference changes
    window.addEventListener('pinorbit_audit_ts_mode_changed', () => {
      filterAndRenderAccounts();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
