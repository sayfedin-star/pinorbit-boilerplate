            <h4 class="text-sm font-bold text-foreground line-clamp-2">${escapeHtml(pinB.title || pinB.pin_id)}</h4>
            <div class="grid grid-cols-3 gap-2 pt-2 text-center text-xs">
              <div class="bg-background/80 rounded-lg p-2"><span class="text-[9px] text-muted-foreground uppercase block font-semibold">Saves</span><strong class="text-blue-500">${fmtNumber(pinB.saves)}</strong></div>
              <div class="bg-background/80 rounded-lg p-2"><span class="text-[9px] text-muted-foreground uppercase block font-semibold">Repins</span><strong class="text-foreground">${fmtNumber(pinB.repins)}</strong></div>
              <div class="bg-background/80 rounded-lg p-2"><span class="text-[9px] text-muted-foreground uppercase block font-semibold">Velocity</span><strong class="text-emerald-500">${Number(pinB.velocity || 0).toFixed(1)}/d</strong></div>
            </div>
          </div>
        </div>

        <!-- Comparison Summary -->
        <div class="text-xs text-muted-foreground">
          ${metricsA.length < 2 && metricsB.length < 2 ? '<div class="py-6 text-center bg-muted/20 rounded-xl border border-dashed border-border">Both pins currently have 1 snapshot. Refresh runs will populate dual trajectory curves.</div>' : '<div class="text-center text-xs font-semibold py-4">Historical growth comparison loaded.</div>'}
        </div>
      `;
    } catch (e: any) {
      content.innerHTML = `<div class="py-8 text-center text-xs text-rose-500">Error comparing pins: ${escapeHtml(e.message)}</div>`;
    }
  }

  function exportCSV() {
    if (!rawPins.length) {
      alert('No pins available to export.');
      return;
    }

    const headers = ['Pin ID', 'Title', 'Board', 'Saves', 'Repins', 'Comments', 'Shares', 'Velocity', 'Stage', 'Anomaly', 'Canonical ID', 'Created Date', 'Link'];
    const rows = rawPins.map((p) => [
      `"${String(p.pin_id || '').replace(/"/g, '""')}"`,
      `"${String(p.title || '').replace(/"/g, '""')}"`,
      `"${String(p.board_name || '').replace(/"/g, '""')}"`,
      Number(p.saves || 0),
      Number(p.repins || 0),
      Number(p.comments || 0),
      Number(p.share_count || 0),
      Number(p.velocity || 0).toFixed(2),
      `"${p.stage || 'DORMANT'}"`,
      `"${p.anomaly || 'NONE'}"`,
      `"${p.canonical_pin_id || ''}"`,
      `"${fmtDate(p.created_at_pinterest)}"`,
      `"${p.link || `https://www.pinterest.com/pin/${p.pin_id}/`}"`,
    ]);

    const csvContent = [headers.join(','), ...rows.map((r) => r.join(','))].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pinarchive_export_${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function setupAccountDeleteModal() {
    const deleteBtn = document.getElementById('delete-selected-accounts-btn');
    const cancelSelectionBtn = document.getElementById('clear-account-selection-btn');
    const modal = document.getElementById('delete-accounts-modal');
    const confirmInput = document.getElementById('delete-confirm-input') as HTMLInputElement | null;
    const confirmBtn = document.getElementById('confirm-delete-modal-btn') as HTMLButtonElement | null;
    const cancelModalBtn = document.getElementById('cancel-delete-modal-btn');

    if (cancelSelectionBtn) {
      cancelSelectionBtn.addEventListener('click', () => {
        selectedAccounts.clear();
        updateAccountsActionBar();
        document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
          cb.checked = false;
        });
      });
    }

    if (deleteBtn && modal && confirmInput && confirmBtn) {
      deleteBtn.addEventListener('click', () => {
        if (selectedAccounts.size === 0) return;
        confirmInput.value = '';
        confirmBtn.disabled = true;
        modal.classList.remove('hidden');
        confirmInput.focus();
      });

      confirmInput.addEventListener('input', () => {
        confirmBtn.disabled = confirmInput.value.trim() !== 'DELETE';
      });

      if (cancelModalBtn) {
        cancelModalBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
        });
      }

      confirmBtn.addEventListener('click', async () => {
        if (confirmInput.value.trim() !== 'DELETE' || selectedAccounts.size === 0) return;

        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Deleting...';

        try {
          const res = await fetch('/api/pinarchive/accounts-delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              account_ids: Array.from(selectedAccounts),
            }),
          });

          const json = await res.json();
          if (!res.ok || !json.success) {
            throw new Error(json.error || 'Failed to delete accounts');
          }

          modal.classList.add('hidden');
          selectedAccounts.clear();
          updateAccountsActionBar();

          // Refresh data
          await Promise.all([loadOverview(), loadPins(), loadTopics()]);
        } catch (err: any) {
          alert(`Error deleting accounts: ${err.message}`);
        } finally {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Delete Accounts';
        }
      });
    }
  }

  function init() {
    loadSettings();
    loadOverview();
    loadPins();
    loadTopics();
    setupAccountDeleteModal();

    // Ingestion Settings Save & Toggle
    const saveSettingsBtn = document.getElementById('save-ingest-settings-btn');
    if (saveSettingsBtn) {
      saveSettingsBtn.addEventListener('click', saveSettings);
    }

    const masterIngestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
    if (masterIngestCb) {
      masterIngestCb.addEventListener('change', () => {
        const label = document.getElementById('setting-ingest-label');
        if (label) {
          label.textContent = masterIngestCb.checked ? 'Active' : 'Disabled';
          label.className = `text-xs font-bold ${masterIngestCb.checked ? 'text-emerald-500' : 'text-rose-500'}`;
        }
      });
    }

    // View toggles
    const gridBtn = document.getElementById('view-grid-btn');
    const boardBtn = document.getElementById('view-board-btn');
    if (gridBtn && boardBtn) {
      gridBtn.addEventListener('click', () => {
        activeView = 'grid';
        gridBtn.className = 'px-2.5 py-1 text-xs font-semibold rounded-lg bg-primary text-primary-foreground shadow-xs transition-all';
        boardBtn.className = 'px-2.5 py-1 text-xs font-semibold rounded-lg text-muted-foreground hover:text-foreground transition-all';
        renderPinsView(rawPins);
      });
      boardBtn.addEventListener('click', () => {
        activeView = 'board';
        boardBtn.className = 'px-2.5 py-1 text-xs font-semibold rounded-lg bg-primary text-primary-foreground shadow-xs transition-all';
        gridBtn.className = 'px-2.5 py-1 text-xs font-semibold rounded-lg text-muted-foreground hover:text-foreground transition-all';
        renderPinsView(rawPins);
      });
    }

    // Filter Listeners
    const searchInput = document.getElementById('filter-search-input') as HTMLInputElement | null;
    const boardSelect = document.getElementById('filter-board-select');
    const stageSelect = document.getElementById('filter-stage-select');
    const minSavesInput = document.getElementById('filter-min-saves');
    const clusterToggle = document.getElementById('filter-cluster-toggle');
    const clearBtn = document.getElementById('clear-filters-btn');

    let debounceTimer: any;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(loadPins, 300);
      });
    }

    if (boardSelect) boardSelect.addEventListener('change', loadPins);
    if (stageSelect) stageSelect.addEventListener('change', loadPins);
    if (minSavesInput) {
      minSavesInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(loadPins, 400);
      });
    }
    if (clusterToggle) clusterToggle.addEventListener('change', loadPins);

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        if (boardSelect) (boardSelect as HTMLSelectElement).value = '';
        if (stageSelect) (stageSelect as HTMLSelectElement).value = '';
        if (minSavesInput) (minSavesInput as HTMLInputElement).value = '';
        if (clusterToggle) (clusterToggle as HTMLInputElement).checked = false;
        loadPins();
      });
    }

    // Keyboard shortcut '/' to search
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && !(document.activeElement instanceof HTMLInputElement || document.activeElement instanceof HTMLTextAreaElement)) {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    // Sort & Limit
    const sortSelect = document.getElementById('pins-sort-select') as HTMLSelectElement | null;
    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value;
        loadPins();
      });
    }

    const limitSelect = document.getElementById('pins-limit-select') as HTMLSelectElement | null;
    if (limitSelect) {
      limitSelect.addEventListener('change', () => {
        currentLimit = parseInt(limitSelect.value, 10) || 50;
        loadPins();
      });
    }

    // CSV Export
    const exportBtn = document.getElementById('export-csv-btn');
    if (exportBtn) exportBtn.addEventListener('click', exportCSV);

    // Compare Controls
    const launchCompareBtn = document.getElementById('launch-compare-btn');
    if (launchCompareBtn) launchCompareBtn.addEventListener('click', openCompareModal);

    const clearCompareBtn = document.getElementById('clear-compare-btn');
    if (clearCompareBtn) {
      clearCompareBtn.addEventListener('click', () => {
        selectedForCompare.clear();
        updateCompareBar();
        document.querySelectorAll<HTMLInputElement>('[data-pin-compare]').forEach((cb) => {
          cb.checked = false;
        });
      });
    }

    const closeCompareModal = document.getElementById('close-compare-modal');
    if (closeCompareModal) {
      closeCompareModal.addEventListener('click', () => {
        document.getElementById('compare-modal')?.classList.add('hidden');
      });
    }

    // Refresh button
    const refreshBtn = document.getElementById('refresh-btn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        const icon = document.getElementById('refresh-icon');
        if (icon) icon.classList.add('animate-spin');
        Promise.all([loadOverview(), loadPins(), loadTopics()]).finally(() => {
          setTimeout(() => {
            if (icon) icon.classList.remove('animate-spin');
          }, 400);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
