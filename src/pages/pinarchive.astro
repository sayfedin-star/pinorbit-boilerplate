              <div class="bg-background/80 rounded-lg p-2"><span class="text-[9px] text-muted-foreground uppercase block font-semibold">Repins</span><strong class="text-foreground">${fmtNumber(pinA.repins)}</strong></div>
              <div class="bg-background/80 rounded-lg p-2"><span class="text-[9px] text-muted-foreground uppercase block font-semibold">Velocity</span><strong class="text-emerald-500">${Number(pinA.velocity || 0).toFixed(1)}/d</strong></div>
            </div>
