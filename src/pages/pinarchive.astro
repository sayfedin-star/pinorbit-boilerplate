        </thead>
        <tbody id="accounts-table-body" class="divide-y divide-border/60">
          <tr>
            <td colspan="8" class="p-8 text-center text-xs text-muted-foreground animate-pulse">Loading tracked accounts…</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ═══ Delete Accounts Confirmation Modal (Amended) ═══ -->
  <div id="delete-accounts-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4">
    <div class="relative w-full max-w-md rounded-2xl border border-rose-500/40 bg-card p-6 shadow-2xl space-y-4">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-500/10 text-rose-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        <div>
          <h3 class="text-base font-bold text-foreground">Confirm Account Deletion</h3>
          <p class="text-xs text-muted-foreground">Permanent database purge.</p>
        </div>
      </div>

      <div class="rounded-xl bg-rose-500/5 border border-rose-500/20 p-3.5 text-xs text-muted-foreground space-y-2.5">
        <p class="text-rose-500 font-bold">⚠️ Warning: Database Deletion is Permanent</p>
        <p><strong class="text-foreground">Cascade Clean:</strong> DB deletion is permanent; GAS Sheets unaffected — next tick will RE-CREATE the account and re-ingest all pins unless paused in GAS first.</p>
        <label class="flex items-center gap-2 pt-2 border-t border-rose-500/20 text-foreground font-semibold cursor-pointer">
          <input
            type="checkbox"
            id="delete-pause-gas-checkbox"
            checked
            class="rounded border-rose-500/40 text-rose-500 focus:ring-rose-500 h-4 w-4"
          />
          <span>Pause in GAS before delete (recommended)</span>
        </label>
      </div>

      <div class="space-y-2">
        <label for="delete-confirm-input" class="block text-xs font-semibold text-foreground">
          Type <span class="font-mono text-rose-500 font-bold">DELETE</span> to confirm:
        </label>
        <input
          id="delete-confirm-input"
          type="text"
          placeholder="DELETE"
          class="w-full rounded-xl border border-border bg-background p-2.5 text-xs text-foreground focus:border-rose-500 focus:outline-none focus:ring-1 focus:ring-rose-500 font-mono"
        />
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-border">
        <button
          id="cancel-delete-modal-btn"
          type="button"
          class="rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          id="confirm-delete-modal-btn"
          type="button"
          disabled
          class="rounded-xl bg-rose-500 hover:bg-rose-600 disabled:opacity-50 disabled:pointer-events-none text-white px-4 py-2 text-xs font-bold shadow-sm transition-colors cursor-pointer"
        >
          Delete Accounts
        </button>
      </div>
    </div>
  </div>
  </div>

  <!-- ═══ Tab 2 View: FastCron Pipeline & Automation ═══ -->
  <div id="pa-tab-view-automation" class="hidden space-y-6">
    <PinArchiveCronCard />
  </div>
  </div>
</Layout>

<script>
  import { fmtAuditTimestamp } from '../lib/format-audit';

  let rawAccounts: any[] = [];
  const selectedAccounts = new Set<string>();

  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function toast(message: string, type: 'success' | 'error' | 'info' = 'success') {
    let root = document.getElementById('toast-root');
    if (!root) {
      root = document.createElement('div');
      root.id = 'toast-root';
      root.setAttribute('aria-live', 'polite');
      root.className = 'fixed bottom-4 right-4 z-[70] flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]';
      document.body.appendChild(root);
    }
    const colors = {
      success: 'border-emerald-500/40 text-emerald-600 dark:text-emerald-400',
      error: 'border-rose-500/40 text-rose-600 dark:text-rose-400',
      info: 'border-primary/40 text-primary',
    };
    const icons = { success: '✓', error: '✕', info: 'ℹ' };
    const el = document.createElement('div');
    el.className = `flex items-start gap-2.5 rounded-xl border bg-card p-3 text-xs font-semibold shadow-lg ${colors[type]}`;
    el.innerHTML = `<span class="flex-shrink-0">${icons[type]}</span><span class="flex-1 text-foreground">${escapeHtml(message)}</span>
      <button class="text-muted-foreground hover:text-foreground cursor-pointer" aria-label="Dismiss">✕</button>`;
    el.querySelector('button')?.addEventListener('click', () => el.remove());
    root.appendChild(el);
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transition = 'opacity .3s';
      setTimeout(() => el.remove(), 300);
    }, 4200);
  }

  // Full numbers formatting (no k/M abbreviations)
  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function fmtDateTime(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleString(undefined, {
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
    } catch {
      return '—';
    }
  }

  function timeAgo(isoString?: string | null): string {
    if (!isoString) return 'never';
    try {
      const diffMs = Date.now() - new Date(isoString).getTime();
      const mins = Math.floor(diffMs / 60000);
      if (mins < 60) return `${Math.max(1, mins)}m ago`;
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return `${hrs}h ago`;
      const days = Math.floor(hrs / 24);
      return `${days}d ago`;
    } catch {
      return 'recently';
    }
  }

  function getAvatarStyle(username: string): { bg: string; initial: string } {
    const palettes = [
      'bg-gradient-to-br from-rose-500 to-pink-600',
      'bg-gradient-to-br from-violet-500 to-indigo-600',
      'bg-gradient-to-br from-emerald-500 to-teal-600',
      'bg-gradient-to-br from-sky-500 to-blue-600',
      'bg-gradient-to-br from-amber-500 to-orange-600',
      'bg-gradient-to-br from-fuchsia-500 to-purple-600',
    ];
    let hash = 0;
    const clean = username.replace(/^@/, '');
    for (let i = 0; i < clean.length; i++) {
      hash = (hash + clean.charCodeAt(i)) % palettes.length;
    }
    const initial = clean.slice(0, 2).toUpperCase() || 'PA';
    return { bg: palettes[hash], initial };
  }

  let accountSearchTerm = '';

  function filterAndRenderAccounts() {
    if (!accountSearchTerm) {
      renderAccountsStrip(rawAccounts);
    } else {
      const term = accountSearchTerm.toLowerCase();
      const filtered = rawAccounts.filter((a: any) =>
        String(a.username || '').toLowerCase().includes(term)
      );
      renderAccountsStrip(filtered);
    }
  }

  async function loadOverview() {
    try {
      const res = await fetch('/api/pinarchive/overview');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load overview');

      const totals = json.totals || {};
      const accounts = json.accounts || [];
      rawAccounts = accounts;

      // Update KPI cards (full numbers via fmtNumber)
      const kpiAccounts = document.getElementById('kpi-accounts-count');
      if (kpiAccounts) kpiAccounts.textContent = fmtNumber(totals.accounts);

      const kpiArchived = document.getElementById('kpi-archived-pins');
      if (kpiArchived) kpiArchived.textContent = fmtNumber(totals.archived_pins);

      const kpiSaves = document.getElementById('kpi-total-saves');
      if (kpiSaves) kpiSaves.textContent = fmtNumber(totals.sum_saves);

      const kpiShares = document.getElementById('kpi-total-shares');
      if (kpiShares) kpiShares.textContent = fmtNumber(totals.sum_shares);

      // Meta refresh line
      const metaText = document.getElementById('refresh-meta-text');
      if (metaText && accounts.length > 0) {
        const firstAcc = accounts[0];
        metaText.textContent = `Last refreshed ${timeAgo(firstAcc.last_run_at)}`;
      }

      // Render Accounts Table with Checkboxes & Search Filter
      filterAndRenderAccounts();
    } catch (e: any) {
      console.error('Error loading PinArchive overview:', e);
    }
  }

  let canAdminSettings = true;

  async function loadSettings() {
    try {
      const res = await fetch('/api/pinarchive/settings');
      if (res.status === 401 || res.status === 403) {
        canAdminSettings = false;
        disableSettingsForm();
        return;
      }
      const json = await res.json();
      if (!json.success) return;

      const ingestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
      const ingestLabel = document.getElementById('setting-ingest-label');
      const policySel = document.getElementById('setting-paused-policy') as HTMLSelectElement | null;
      const maxBatchInp = document.getElementById('setting-max-batch') as HTMLInputElement | null;
      const minSavesInp = document.getElementById('setting-min-saves') as HTMLInputElement | null;
      const minRepinsInp = document.getElementById('setting-min-repins') as HTMLInputElement | null;
      const risingAgeInp = document.getElementById('setting-rising-age') as HTMLInputElement | null;
      const risingSavesInp = document.getElementById('setting-rising-saves') as HTMLInputElement | null;
      const refreshMaxPinsInp = document.getElementById('setting-refresh-max-pins') as HTMLInputElement | null;
      const summaryBadge = document.getElementById('settings-summary-badge');

      if (ingestCb) {
        ingestCb.checked = Boolean(json.ingest_enabled);
        if (ingestLabel) {
          ingestLabel.textContent = ingestCb.checked ? 'Active' : 'Disabled';
          ingestLabel.className = `text-xs font-bold ${ingestCb.checked ? 'text-emerald-500' : 'text-rose-500'}`;
        }
        if (summaryBadge) {
          summaryBadge.textContent = ingestCb.checked ? '🟢 Ingest Active' : '🔴 Ingest Paused';
          summaryBadge.className = `text-[10px] font-bold px-2 py-0.5 rounded-full border ${
            ingestCb.checked
              ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20'
              : 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20'
          }`;
        }
      }
      if (policySel) policySel.value = json.paused_account_policy || 'reject';
      if (maxBatchInp) maxBatchInp.value = String(json.max_batch_pins || 500);
      if (minSavesInp) minSavesInp.value = String(json.pin_filter_min_saves ?? 0);
      if (minRepinsInp) minRepinsInp.value = String(json.pin_filter_min_repins ?? 0);
      if (risingAgeInp) risingAgeInp.value = String(json.pin_filter_rising_age_days ?? 14);
      if (risingSavesInp) risingSavesInp.value = String(json.pin_filter_rising_saves ?? 34);
      if (refreshMaxPinsInp) refreshMaxPinsInp.value = String(json.refresh_max_pins ?? 0);
    } catch (e) {
      console.error('Failed to load settings:', e);
    }
  }

  function setupSettingsCollapse() {
    const toggleBtn = document.getElementById('toggle-settings-collapse-btn');
    const panelBody = document.getElementById('settings-panel-body');
    const collapseIcon = document.getElementById('settings-collapse-icon');
    const collapseText = document.getElementById('settings-collapse-text');
    if (!toggleBtn || !panelBody) return;

    let isExpanded = localStorage.getItem('pa_settings_expanded') === 'true';

    function updateCollapseUI() {
      if (isExpanded) {
        panelBody.classList.remove('hidden');
        if (collapseIcon) collapseIcon.style.transform = 'rotate(180deg)';
        if (collapseText) collapseText.textContent = 'Collapse';
      } else {
        panelBody.classList.add('hidden');
        if (collapseIcon) collapseIcon.style.transform = 'rotate(0deg)';
        if (collapseText) collapseText.textContent = 'Configure';
      }
    }

    updateCollapseUI();

    toggleBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      localStorage.setItem('pa_settings_expanded', String(isExpanded));
      updateCollapseUI();
    });
  }

  function disableSettingsForm() {
    const saveBtn = document.getElementById('save-ingest-settings-btn') as HTMLButtonElement | null;
    const roleBadge = document.getElementById('settings-role-badge');
    const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      '#setting-ingest-enabled, #setting-paused-policy, #setting-max-batch, #setting-refresh-max-pins, #setting-min-saves, #setting-min-repins, #setting-rising-age, #setting-rising-saves'
    );
    inputs.forEach((el) => {
      el.disabled = true;
    });
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.classList.add('hidden');
    }
    if (roleBadge) roleBadge.classList.remove('hidden');
  }

  async function saveSettings() {
    const ingestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
    const policySel = document.getElementById('setting-paused-policy') as HTMLSelectElement | null;
    const maxBatchInp = document.getElementById('setting-max-batch') as HTMLInputElement | null;
    const refreshMaxPinsInp = document.getElementById('setting-refresh-max-pins') as HTMLInputElement | null;
    const minSavesInp = document.getElementById('setting-min-saves') as HTMLInputElement | null;
    const minRepinsInp = document.getElementById('setting-min-repins') as HTMLInputElement | null;
    const risingAgeInp = document.getElementById('setting-rising-age') as HTMLInputElement | null;
    const risingSavesInp = document.getElementById('setting-rising-saves') as HTMLInputElement | null;
    const statusMsg = document.getElementById('settings-status-msg');
    const saveBtn = document.getElementById('save-ingest-settings-btn') as HTMLButtonElement | null;
    const summaryBadge = document.getElementById('settings-summary-badge');

    if (!ingestCb || !policySel || !maxBatchInp || !minSavesInp || !minRepinsInp || !risingAgeInp || !risingSavesInp) return;

    if (saveBtn) saveBtn.disabled = true;
    if (statusMsg) {
      statusMsg.textContent = 'Saving...';
      statusMsg.className = 'text-xs font-semibold text-muted-foreground';
    }

    try {
      const res = await fetch('/api/pinarchive/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ingest_enabled: ingestCb.checked,
          paused_account_policy: policySel.value,
          max_batch_pins: parseInt(maxBatchInp.value, 10) || 500,
          refresh_max_pins: parseInt(refreshMaxPinsInp?.value || '0', 10) || 0,
          pin_filter_min_saves: parseInt(minSavesInp.value, 10) || 0,
          pin_filter_min_repins: parseInt(minRepinsInp.value, 10) || 0,
          pin_filter_rising_age_days: Number.isInteger(parseInt(risingAgeInp.value, 10)) ? parseInt(risingAgeInp.value, 10) : 14,
          pin_filter_rising_saves: Number.isInteger(parseInt(risingSavesInp.value, 10)) ? parseInt(risingSavesInp.value, 10) : 34,
        }),
      });

      if (res.status === 403) {
        canAdminSettings = false;
        disableSettingsForm();
        if (statusMsg) {
          statusMsg.textContent = 'Forbidden: Admin access required.';
          statusMsg.className = 'text-xs font-semibold text-rose-500';
        }
        return;
      }

      const json = await res.json();
      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Failed to save settings');
      }

      if (summaryBadge) {
        summaryBadge.textContent = ingestCb.checked ? '🟢 Ingest Active' : '🔴 Ingest Paused';
        summaryBadge.className = `text-[10px] font-bold px-2 py-0.5 rounded-full border ${
          ingestCb.checked
            ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20'
            : 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20'
        }`;
      }

      if (statusMsg) {
        statusMsg.textContent = 'Settings saved!';
        statusMsg.className = 'text-xs font-semibold text-emerald-500';
        setTimeout(() => {
          if (statusMsg) statusMsg.textContent = '';
        }, 3000);
      }
    } catch (e: any) {
      if (statusMsg) {
        statusMsg.textContent = e.message || 'Save failed';
        statusMsg.className = 'text-xs font-semibold text-rose-500';
      }
    } finally {
      if (saveBtn && canAdminSettings) saveBtn.disabled = false;
    }
  }

  function attachAccountIngestToggleListeners() {
    document.querySelectorAll<HTMLInputElement>('[data-acc-ingest-toggle]').forEach((cb) => {
      cb.addEventListener('change', async () => {
        const id = cb.getAttribute('data-acc-ingest-toggle');
        if (!id) return;
        const enabled = cb.checked;
        cb.disabled = true;

        try {
          const res = await fetch('/api/pinarchive/accounts-ingest-toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ account_ids: [id], ingest_enabled: enabled }),
          });

          if (res.status === 403) {
            cb.checked = !enabled;
            alert('Admin access required to toggle account ingestion.');
            return;
          }

          const json = await res.json();
          if (!res.ok || !json.success) {
            cb.checked = !enabled;
            alert(json.error || 'Failed to update account ingest status.');
          }
        } catch {
          cb.checked = !enabled;
        } finally {
          cb.disabled = false;
        }
      });
    });
  }

  function renderAccountsStrip(accounts: any[]) {
    const tbody = document.getElementById('accounts-table-body');
    const stripCount = document.getElementById('accounts-strip-count');
    if (stripCount) stripCount.textContent = `(${accounts.length} of ${rawAccounts.length} total)`;

    if (!tbody) return;

    if (accounts.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="8" class="p-8 text-center text-xs text-muted-foreground bg-muted/10">
            ${rawAccounts.length === 0 ? 'No Pinterest accounts tracked in archive yet.' : 'No accounts matching search query.'}
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = accounts
      .map((acc: any) => {
        const isActive = acc.status === 'active';
        const isChecked = selectedAccounts.has(acc.id);
        const { bg: avatarBg, initial } = getAvatarStyle(acc.username || '');
        const lastRunStr = acc.last_run_at ? fmtDateTime(acc.last_run_at) : '—';
        const lastRunFull = acc.last_run_at ? new Date(acc.last_run_at).toLocaleString() : 'Never';
        const nextRunStr = acc.next_run_at ? fmtDateTime(acc.next_run_at) : 'Pending';
        const changed = Number(acc.changed_last_refresh ?? 0);
        const total = Number(acc.checked_last_refresh ?? (acc.db_pins_count !== undefined ? acc.db_pins_count : (acc.pins_count ?? 0)));

        return `
          <tr class="hover:bg-muted/40 transition-colors group">
            <td class="py-3 px-4 text-center">
              <input
                type="checkbox"
                data-acc-select="${escapeHtml(acc.id)}"
                ${isChecked ? 'checked' : ''}
                class="rounded border-border text-rose-500 focus:ring-rose-500 h-3.5 w-3.5 cursor-pointer"
                id="acc-check-${escapeHtml(acc.id)}"
              />
            </td>
            <td class="py-3 px-4">
              <div class="flex items-center gap-3">
                <div class="h-8 w-8 rounded-full ${avatarBg} text-white font-bold text-[11px] flex items-center justify-center shrink-0 shadow-xs uppercase tracking-tight">
                  ${initial}
                </div>
                <div class="flex flex-col min-w-0">
                  <div class="flex items-center gap-1.5">
                    <a href="/pinarchive/account/${encodeURIComponent(acc.username)}" class="font-bold text-foreground hover:text-primary transition-colors truncate max-w-[180px]">
                      @${escapeHtml(acc.username)}
                    </a>
                    <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded-full ${
                      isActive
                        ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20'
                        : acc.status === 'paused'
                        ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20'
                        : 'bg-muted text-muted-foreground'
                    }">
                      ${escapeHtml(acc.status)}
                    </span>
                  </div>
                </div>
              </div>
            </td>
            <td class="py-3 px-4 font-medium text-foreground">
              ${fmtNumber(acc.follower_count)}
            </td>
            <td class="py-3 px-4 font-semibold text-foreground">
              <span class="inline-flex items-center gap-1 font-bold" title="GAS sheet count: ${fmtNumber(acc.pins_count)}">
                ${fmtNumber(acc.db_pins_count !== undefined ? acc.db_pins_count : acc.pins_count)}
              </span>
            </td>
            <td class="py-3 px-4 font-medium" title="Last refresh: ${changed} of ${total} checked">
              <span class="font-bold ${changed>0?'text-emerald-500':'text-muted-foreground'}">${changed}/${total}</span>
            </td>
            <td class="py-3 px-4">
              ${acc.last_run_at ? fmtAuditTimestamp(acc.last_run_at).html : '<span class="text-muted-foreground/60 text-xs">Never</span>'}
              <div class="flex items-center gap-1.5 mt-1 text-[10px]">
                <span class="${changed>0?'text-emerald-500 font-bold':'text-muted-foreground'}">+${changed} today</span>
                ${acc.next_run_at ? `<span class="opacity-40">•</span><span class="text-muted-foreground/80">Next: ${escapeHtml(fmtAuditTimestamp(acc.next_run_at).line1)}</span>` : ''}
              </div>
            </td>
            <td class="py-3 px-4 text-center">
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  data-acc-ingest-toggle="${escapeHtml(acc.id)}"
                  ${acc.ingest_enabled !== false ? 'checked' : ''}
                  class="sr-only peer"
                  id="toggle-ingest-${escapeHtml(acc.id)}"
                />
                <div class="w-7 h-4 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-emerald-500"></div>
              </label>
            </td>
            <td class="py-3 px-4 text-right">
              <div class="inline-flex items-center justify-end gap-1.5">
                <a
                  href="/pinarchive/account/${encodeURIComponent(acc.username)}"
                  class="inline-flex items-center gap-1 rounded-lg border border-border bg-card hover:bg-muted/80 text-foreground px-2.5 py-1 text-xs font-semibold shadow-xs hover:border-primary/40 transition-all"
                >
                  <span>View Details</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
                <button
                  type="button"
                  data-single-delete-acc-id="${escapeHtml(acc.id)}"
                  data-single-delete-acc-user="${escapeHtml(acc.username)}"
                  class="inline-flex items-center justify-center h-7 w-7 rounded-lg border border-border hover:border-rose-500/50 hover:bg-rose-500/10 text-muted-foreground hover:text-rose-500 transition-colors cursor-pointer"
                  title="Delete account"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                </button>
              </div>
            </td>
          </tr>
        `;
      })
      .join('');

    attachAccountSelectionListeners();
    attachAccountIngestToggleListeners();
    attachSingleDeleteListeners();
  }

  function attachAccountSelectionListeners() {
    const selectAllCb = document.getElementById('select-all-accounts-cb') as HTMLInputElement | null;
    if (selectAllCb) {
      selectAllCb.checked = rawAccounts.length > 0 && rawAccounts.every((a) => selectedAccounts.has(a.id));
      selectAllCb.addEventListener('change', () => {
        const checked = selectAllCb.checked;
        document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
          cb.checked = checked;
          const id = cb.getAttribute('data-acc-select');
          if (id) {
            if (checked) selectedAccounts.add(id);
            else selectedAccounts.delete(id);
          }
        });
        updateAccountsActionBar();
      });
    }

    document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-acc-select');
        if (!id) return;
        if (cb.checked) {
          selectedAccounts.add(id);
        } else {
          selectedAccounts.delete(id);
        }
        if (selectAllCb) {
          selectAllCb.checked = rawAccounts.length > 0 && rawAccounts.every((a) => selectedAccounts.has(a.id));
        }
        updateAccountsActionBar();
      });
    });
  }

  function attachSingleDeleteListeners() {
    document.querySelectorAll<HTMLButtonElement>('[data-single-delete-acc-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-single-delete-acc-id');
        if (!id) return;
        selectedAccounts.clear();
        selectedAccounts.add(id);
        document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
          cb.checked = cb.getAttribute('data-acc-select') === id;
        });
        updateAccountsActionBar();

        const modal = document.getElementById('delete-accounts-modal');
        const confirmInput = document.getElementById('delete-confirm-input') as HTMLInputElement | null;
        const confirmBtn = document.getElementById('confirm-delete-modal-btn') as HTMLButtonElement | null;
        if (modal && confirmInput && confirmBtn) {
          confirmInput.value = '';
          confirmBtn.disabled = true;
          modal.classList.remove('hidden');
          confirmInput.focus();
        }
      });
    });
  }

  function updateAccountsActionBar() {
    const bar = document.getElementById('accounts-action-bar');
    const label = document.getElementById('accounts-selected-label');
    const btnText = document.getElementById('delete-accounts-btn-text');

    if (!bar) return;

    if (selectedAccounts.size > 0) {
      bar.classList.remove('hidden');
      bar.classList.add('flex');
      if (label) label.textContent = `${selectedAccounts.size} account${selectedAccounts.size === 1 ? '' : 's'} selected`;
      if (btnText) btnText.textContent = `Delete selected (${selectedAccounts.size})`;
    } else {
      bar.classList.add('hidden');
      bar.classList.remove('flex');
    }
  }

  function setupAccountDeleteModal() {
    const deleteBtn = document.getElementById('delete-selected-accounts-btn');
    const cancelSelectionBtn = document.getElementById('clear-account-selection-btn');
    const modal = document.getElementById('delete-accounts-modal');
    const confirmInput = document.getElementById('delete-confirm-input') as HTMLInputElement | null;
    const confirmBtn = document.getElementById('confirm-delete-modal-btn') as HTMLButtonElement | null;
    const cancelModalBtn = document.getElementById('cancel-delete-modal-btn');
    const pauseGasCheckbox = document.getElementById('delete-pause-gas-checkbox') as HTMLInputElement | null;

    if (cancelSelectionBtn) {
      cancelSelectionBtn.addEventListener('click', () => {
        selectedAccounts.clear();
        updateAccountsActionBar();
        document.querySelectorAll<HTMLInputElement>('[data-acc-select]').forEach((cb) => {
          cb.checked = false;
        });
      });
    }

    if (deleteBtn && modal && confirmInput && confirmBtn) {
      deleteBtn.addEventListener('click', () => {
        if (selectedAccounts.size === 0) return;
        confirmInput.value = '';
        confirmBtn.disabled = true;
        modal.classList.remove('hidden');
        confirmInput.focus();
      });

      confirmInput.addEventListener('input', () => {
        confirmBtn.disabled = confirmInput.value.trim() !== 'DELETE';
      });

      if (cancelModalBtn) {
        cancelModalBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
        });
      }

      confirmBtn.addEventListener('click', async () => {
        if (confirmInput.value.trim() !== 'DELETE' || selectedAccounts.size === 0) return;

        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Deleting...';

        try {
          const usernames = getSelectedUsernames();
          if (pauseGasCheckbox && pauseGasCheckbox.checked && usernames.length > 0) {
            try {
              await fetch('/api/pinarchive/accounts-gas', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'pause', usernames }),
              });
            } catch (gasErr) {
              console.warn('Could not pause accounts in GAS prior to deletion:', gasErr);
            }
          }

          const res = await fetch('/api/pinarchive/accounts-delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              account_ids: Array.from(selectedAccounts),
            }),
          });

          const json = await res.json();
          if (!res.ok || !json.success) {
            throw new Error(json.error || 'Failed to delete accounts');
          }

          modal.classList.add('hidden');
          selectedAccounts.clear();
          updateAccountsActionBar();

          // Refresh data
          await loadOverview();
        } catch (err: any) {
          alert(`Error deleting accounts: ${err.message}`);
        } finally {
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Delete Accounts';
        }
      });
    }
  }

  function getSelectedUsernames(): string[] {
    return rawAccounts
      .filter((a) => selectedAccounts.has(a.id))
      .map((a) => a.username);
  }

  function setupBulkRefresh() {
    const refreshSelectedBtn = document.getElementById('refresh-selected-accounts-btn') as HTMLButtonElement | null;
    const refreshSelectedIcon = document.getElementById('refresh-selected-icon');

    if (refreshSelectedBtn) {
      refreshSelectedBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;

        if (!confirm(`Run archive refresh for ${usernames.length} selected account(s)? This will dispatch background worker refreshes.`)) {
          return;
        }

        refreshSelectedBtn.disabled = true;
        if (refreshSelectedIcon) refreshSelectedIcon.classList.add('animate-spin');
        const root = document.getElementById('pinarchive-page-root');
        const workspaceId = root?.getAttribute('data-workspace-id') || '';

        try {
          const payload = usernames.length === 1
            ? { workspace_id: workspaceId, username: usernames[0] }
            : { workspace_id: workspaceId, usernames };

          const res = await fetch('/api/internal/pinarchive/refresh', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (res.status === 202 || res.ok) {
            if (usernames.length === 1) {
              toast(`Refresh queued for @${usernames[0]}`, 'success');
            } else {
              toast(`Queued 1 refresh run for ${usernames.length} accounts`, 'success');
            }
          } else if (res.status === 403) {
            toast('Admin required', 'error');
          } else if (res.status === 503) {
            toast('Refresh not configured on server yet', 'error');
          } else {
            const data = await res.json().catch(() => ({}));
            toast(data.error || 'Failed to dispatch refresh', 'error');
          }
        } catch (e: any) {
          console.error('Failed to dispatch refresh:', e);
          toast(e?.message || 'Network error triggering refresh', 'error');
        } finally {
          if (refreshSelectedIcon) refreshSelectedIcon.classList.remove('animate-spin');
          refreshSelectedBtn.disabled = false;
        }
      });
    }
  }

  function setupBulkGasControls() {
    setupBulkRefresh();

    // Bulk Run Now
    const runBtn = document.getElementById('gas-bulk-run-btn') as HTMLButtonElement | null;
    if (runBtn) {
      runBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;
        runBtn.disabled = true;
        toast(`Triggered GAS run for ${usernames.length} account(s)...`, 'info');

        try {
          const res = await fetch('/api/pinarchive/accounts-gas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'run_now', usernames }),
          });
          const json = await res.json();
          if (json.success) {
            toast(`GAS run queued for ${usernames.join(', ')}.`, 'success');
          } else {
            toast(json.error || 'Failed to dispatch GAS run', 'error');
          }
        } catch (err: any) {
          toast(err?.message || 'Network error triggering GAS run', 'error');
        } finally {
          runBtn.disabled = false;
        }
      });
    }

    // Bulk Sync Now
    const syncBtn = document.getElementById('gas-bulk-sync-btn') as HTMLButtonElement | null;
    if (syncBtn) {
      syncBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;
        syncBtn.disabled = true;
        toast(`Syncing ${usernames.length} account(s) from Sheet → DB...`, 'info');

        try {
          const res = await fetch('/api/pinarchive/accounts-gas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'sync_now', usernames }),
          });
          const json = await res.json();
          if (json.success) {
            toast(`Sync complete for ${usernames.length} account(s)!`, 'success');
            await loadOverview();
          } else {
            toast(json.error || 'Failed to dispatch GAS sync', 'error');
          }
        } catch (err: any) {
          toast(err?.message || 'Network error triggering GAS sync', 'error');
        } finally {
          syncBtn.disabled = false;
        }
      });
    }

    // Bulk Pause
    const pauseBtn = document.getElementById('gas-bulk-pause-btn') as HTMLButtonElement | null;
    if (pauseBtn) {
      pauseBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;
        pauseBtn.disabled = true;

        try {
          const res = await fetch('/api/pinarchive/accounts-gas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'pause', usernames }),
          });
          const json = await res.json();
          if (json.success) {
            toast(`Paused ${usernames.length} account(s).`, 'success');
            await loadOverview();
          } else {
            toast(json.error || 'Failed to pause accounts', 'error');
          }
        } catch (err: any) {
          toast(err?.message || 'Network error pausing accounts', 'error');
        } finally {
          pauseBtn.disabled = false;
        }
      });
    }

    // Bulk Resume
    const resumeBtn = document.getElementById('gas-bulk-resume-btn') as HTMLButtonElement | null;
    if (resumeBtn) {
      resumeBtn.addEventListener('click', async () => {
        const usernames = getSelectedUsernames();
        if (usernames.length === 0) return;
        resumeBtn.disabled = true;

        try {
          const res = await fetch('/api/pinarchive/accounts-gas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'resume', usernames }),
          });
          const json = await res.json();
          if (json.success) {
            toast(`Resumed ${usernames.length} account(s).`, 'success');
            await loadOverview();
          } else {
            toast(json.error || 'Failed to resume accounts', 'error');
          }
        } catch (err: any) {
          toast(err?.message || 'Network error resuming accounts', 'error');
        } finally {
          resumeBtn.disabled = false;
        }
      });
    }
  }

  function setupAccountSearch() {
    const searchInput = document.getElementById('account-search-input') as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        accountSearchTerm = searchInput.value.trim();
        filterAndRenderAccounts();
      });
    }
  }

  function setupTabs() {
    const btnAccounts = document.getElementById('pa-tab-btn-accounts');
    const btnAutomation = document.getElementById('pa-tab-btn-automation');
    const viewAccounts = document.getElementById('pa-tab-view-accounts');
    const viewAutomation = document.getElementById('pa-tab-view-automation');

    if (!btnAccounts || !btnAutomation || !viewAccounts || !viewAutomation) return;

    // Clean up any legacy localStorage key that might have trapped users
    try {
      localStorage.removeItem('pa_active_tab');
    } catch (_) {}

    function activateTab(tab: 'accounts' | 'automation', updateUrl = true) {
      if (tab === 'automation') {
        viewAccounts?.classList.add('hidden');
        viewAutomation?.classList.remove('hidden');

        btnAutomation?.classList.remove('text-muted-foreground', 'hover:bg-muted/60');
        btnAutomation?.classList.add('bg-primary', 'text-primary-foreground', 'shadow-xs');

        btnAccounts?.classList.remove('bg-primary', 'text-primary-foreground', 'shadow-xs');
        btnAccounts?.classList.add('text-muted-foreground', 'hover:bg-muted/60');

        if (updateUrl && window.location.hash !== '#automation') {
          history.replaceState(null, '', '#automation');
        }
      } else {
        viewAutomation?.classList.add('hidden');
        viewAccounts?.classList.remove('hidden');

        btnAccounts?.classList.remove('text-muted-foreground', 'hover:bg-muted/60');
        btnAccounts?.classList.add('bg-primary', 'text-primary-foreground', 'shadow-xs');

        btnAutomation?.classList.remove('bg-primary', 'text-primary-foreground', 'shadow-xs');
        btnAutomation?.classList.add('text-muted-foreground', 'hover:bg-muted/60');

        if (updateUrl && window.location.hash) {
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }
    }

    btnAccounts.addEventListener('click', () => activateTab('accounts', true));
    btnAutomation.addEventListener('click', () => activateTab('automation', true));

    window.addEventListener('hashchange', () => {
      const isAutomation = window.location.hash === '#automation' || window.location.hash === '#pipeline';
      activateTab(isAutomation ? 'automation' : 'accounts', false);
    });

    // Default to 'accounts' unless the URL explicitly contains '#automation' or '#pipeline'
    const isAutomationInitial = window.location.hash === '#automation' || window.location.hash === '#pipeline';
    if (isAutomationInitial) {
      activateTab('automation', false);
    } else {
      activateTab('accounts', false);
    }
  }

  function init() {
    setupTabs();
    setupSettingsCollapse();
    setupAccountSearch();
    loadSettings();
    loadOverview();
    setupAccountDeleteModal();
    setupBulkGasControls();

    // Ingest settings save button
    const saveSettingsBtn = document.getElementById('save-ingest-settings-btn');
    if (saveSettingsBtn) {
      saveSettingsBtn.addEventListener('click', saveSettings);
    }

    // Listen for audit timestamp display preference changes
    window.addEventListener('pinorbit_audit_ts_mode_changed', () => {
      filterAndRenderAccounts();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
