<script>
  import { fmtAuditTimestamp } from '../lib/format-audit';

  let rawAccounts: any[] = [];
  const selectedAccounts = new Set<string>();

  function escapeHtml(str?: string | null): string {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function toast(message: string, type: 'success' | 'error' | 'info' = 'success') {
    let root = document.getElementById('toast-root');
    if (!root) {
      root = document.createElement('div');
      root.id = 'toast-root';
      root.setAttribute('aria-live', 'polite');
      root.className = 'fixed bottom-4 right-4 z-[70] flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]';
      document.body.appendChild(root);
    }
    const colors = {
      success: 'border-emerald-500/40 text-emerald-600 dark:text-emerald-400',
      error: 'border-rose-500/40 text-rose-600 dark:text-rose-400',
      info: 'border-primary/40 text-primary',
    };
    const icons = { success: '✓', error: '✕', info: 'ℹ' };
    const el = document.createElement('div');
    el.className = `flex items-start gap-2.5 rounded-xl border bg-card p-3 text-xs font-semibold shadow-lg ${colors[type]}`;
    el.innerHTML = `<span class="flex-shrink-0">${icons[type]}</span><span class="flex-1 text-foreground">${escapeHtml(message)}</span>
      <button class="text-muted-foreground hover:text-foreground cursor-pointer" aria-label="Dismiss">✕</button>`;
    el.querySelector('button')?.addEventListener('click', () => el.remove());
    root.appendChild(el);
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transition = 'opacity .3s';
      setTimeout(() => el.remove(), 300);
    }, 4200);
  }

  // Full numbers formatting (no k/M abbreviations)
  function fmtNumber(n: number | string | null | undefined): string {
    const num = Number(n) || 0;
    return num.toLocaleString('en-US');
  }

  function fmtDate(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    } catch {
      return '—';
    }
  }

  function fmtDateTime(isoString?: string | null): string {
    if (!isoString) return '—';
    try {
      const d = new Date(isoString);
      if (isNaN(d.getTime())) return '—';
      return d.toLocaleString(undefined, {
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
    } catch {
      return '—';
    }
  }

  function timeAgo(isoString?: string | null): string {
    if (!isoString) return 'never';
    try {
      const diffMs = Date.now() - new Date(isoString).getTime();
      const mins = Math.floor(diffMs / 60000);
      if (mins < 60) return `${Math.max(1, mins)}m ago`;
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return `${hrs}h ago`;
      const days = Math.floor(hrs / 24);
      return `${days}d ago`;
    } catch {
      return 'recently';
    }
  }

  function getAvatarStyle(username: string): { bg: string; initial: string } {
    const palettes = [
      'bg-gradient-to-br from-rose-500 to-pink-600',
      'bg-gradient-to-br from-violet-500 to-indigo-600',
      'bg-gradient-to-br from-emerald-500 to-teal-600',
      'bg-gradient-to-br from-sky-500 to-blue-600',
      'bg-gradient-to-br from-amber-500 to-orange-600',
      'bg-gradient-to-br from-fuchsia-500 to-purple-600',
    ];
    let hash = 0;
    const clean = username.replace(/^@/, '');
    for (let i = 0; i < clean.length; i++) {
      hash = (hash + clean.charCodeAt(i)) % palettes.length;
    }
    const initial = clean.slice(0, 2).toUpperCase() || 'PA';
    return { bg: palettes[hash], initial };
  }

  let accountSearchTerm = '';

  function filterAndRenderAccounts() {
    if (!accountSearchTerm) {
      renderAccountsStrip(rawAccounts);
    } else {
      const term = accountSearchTerm.toLowerCase();
      const filtered = rawAccounts.filter((a: any) =>
        String(a.username || '').toLowerCase().includes(term)
      );
      renderAccountsStrip(filtered);
    }
  }

  async function loadOverview() {
    try {
      const res = await fetch('/api/pinarchive/overview');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      if (!json.success) throw new Error(json.error || 'Failed to load overview');

      const totals = json.totals || {};
      const accounts = json.accounts || [];
      rawAccounts = accounts;

      // Update KPI cards (full numbers via fmtNumber)
      const kpiAccounts = document.getElementById('kpi-accounts-count');
      if (kpiAccounts) kpiAccounts.textContent = fmtNumber(totals.accounts);

      const kpiArchived = document.getElementById('kpi-archived-pins');
      if (kpiArchived) kpiArchived.textContent = fmtNumber(totals.archived_pins);

      const kpiSaves = document.getElementById('kpi-total-saves');
      if (kpiSaves) kpiSaves.textContent = fmtNumber(totals.sum_saves);

      const kpiShares = document.getElementById('kpi-total-shares');
      if (kpiShares) kpiShares.textContent = fmtNumber(totals.sum_shares);

      // Meta refresh line
      const metaText = document.getElementById('refresh-meta-text');
      if (metaText && accounts.length > 0) {
        const firstAcc = accounts[0];
        metaText.textContent = `Last refreshed ${timeAgo(firstAcc.last_run_at)}`;
      }

      // Render Accounts Table with Checkboxes & Search Filter
      filterAndRenderAccounts();
    } catch (e: any) {
      console.error('Error loading PinArchive overview:', e);
    }
  }

  interface ColDef {
    key: string;
    label: string;
    defaultVisible: boolean;
  }

  const COLUMN_DEFS: ColDef[] = [
    { key: 'interval_days', label: 'Interval (Days)', defaultVisible: false },
    { key: 'backfill_status', label: 'Backfill Status', defaultVisible: false },
    { key: 'backfill_cursor', label: 'Backfill Cursor', defaultVisible: false },
    { key: 'last_result', label: 'Last Result', defaultVisible: false },
    { key: 'archived_count', label: 'Archived Pins', defaultVisible: true },
  ];

  let colVisible: Record<string, boolean> = (() => {
    try {
      const saved = localStorage.getItem('po_pa_cols');
      if (saved) return JSON.parse(saved);
    } catch {}
    return {
      interval_days: false,
      backfill_status: false,
      backfill_cursor: false,
      last_result: false,
      archived_count: true,
    };
  })();

  function buildColVisibilityMenu() {
    const colMenu = document.getElementById('pa-col-visibility-menu');
    if (!colMenu) return;
    colMenu.innerHTML = COLUMN_DEFS.map(
      (c) => `
      <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-muted/60 transition-colors text-xs font-medium text-foreground">
        <input type="checkbox" class="rounded accent-primary" data-pa-col-key="${c.key}" ${colVisible[c.key] ? 'checked' : ''} />
        <span>${c.label}</span>
      </label>`
    ).join('');

    colMenu.querySelectorAll<HTMLInputElement>('input[data-pa-col-key]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const key = cb.dataset.paColKey!;
        colVisible[key] = cb.checked;
        localStorage.setItem('po_pa_cols', JSON.stringify(colVisible));
        renderTableHeader();
        filterAndRenderAccounts();
      });
    });
  }

  function setupColVisibilityToggle() {
    const btn = document.getElementById('pa-col-visibility-btn');
    const colMenu = document.getElementById('pa-col-visibility-menu');
    const wrapper = document.getElementById('pa-col-visibility-wrapper');
    if (!btn || !colMenu) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      colMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (wrapper && !wrapper.contains(e.target as Node)) {
        colMenu.classList.add('hidden');
      }
    });
  }

  function renderTableHeader() {
    const thead = document.querySelector('#accounts-table-body')?.parentElement?.querySelector('thead');
    if (!thead) return;

    let optHeaders = '';
    if (colVisible.interval_days) optHeaders += `<th class="py-3 px-4 font-semibold">Interval</th>`;
    if (colVisible.backfill_status) optHeaders += `<th class="py-3 px-4 font-semibold">Backfill</th>`;
    if (colVisible.backfill_cursor) optHeaders += `<th class="py-3 px-4 font-semibold">Cursor</th>`;
    if (colVisible.last_result) optHeaders += `<th class="py-3 px-4 font-semibold">Last Result</th>`;
    if (colVisible.archived_count) optHeaders += `<th class="py-3 px-4 font-semibold">Archived Pins</th>`;

    thead.innerHTML = `
      <tr>
        <th class="py-3 px-4 w-10 text-center">
          <input
            type="checkbox"
            id="select-all-accounts-cb"
            class="rounded border-border text-rose-500 focus:ring-rose-500 h-3.5 w-3.5 cursor-pointer"
            title="Select all accounts"
          />
        </th>
        <th class="py-3 px-4 font-semibold text-foreground">Creator Account</th>
        <th class="py-3 px-4 font-semibold">Followers</th>
        <th class="py-3 px-4 font-semibold">Pins Total</th>
        ${optHeaders}
        <th class="py-3 px-4 font-semibold">Δ Changed</th>
        <th class="py-3 px-4 font-semibold">Last / Next Run</th>
        <th class="py-3 px-4 font-semibold text-center">Ingest Active</th>
        <th class="py-3 px-4 text-right font-semibold">Actions</th>
      </tr>
    `;
    attachAccountSelectionListeners();
  }

  let canAdminSettings = true;

  function updateCostEstimate() {
    const transparencyEl = document.getElementById('transparency-cost-estimate');
    if (!transparencyEl) return;
    const accCount = rawAccounts.length;
    const stopPagesInp = document.getElementById('setting-discovery-stop-pages') as HTMLInputElement | null;
    const stopPages = parseInt(stopPagesInp?.value || '3', 10) || 3;
    const pagesPerDay = accCount * stopPages;
    const candidatesPerDay = pagesPerDay * 50;
    transparencyEl.textContent = `≈ ${fmtNumber(pagesPerDay)} pages/day, ≈ ${fmtNumber(candidatesPerDay)} pins/day (${accCount} accounts × ${stopPages} pages)`;
  }

  async function loadSettings() {
    try {
      const res = await fetch('/api/pinarchive/settings');
      if (res.status === 401 || res.status === 403) {
        canAdminSettings = false;
        disableSettingsForm();
        return;
      }
      const json = await res.json();
      if (!json.success) return;

      const ingestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
      const ingestLabel = document.getElementById('setting-ingest-label');
      const policySel = document.getElementById('setting-paused-policy') as HTMLSelectElement | null;
      const maxBatchInp = document.getElementById('setting-max-batch') as HTMLInputElement | null;
      const minSavesInp = document.getElementById('setting-min-saves') as HTMLInputElement | null;
      const minRepinsInp = document.getElementById('setting-min-repins') as HTMLInputElement | null;
      const risingAgeInp = document.getElementById('setting-rising-age') as HTMLInputElement | null;
      const risingSavesInp = document.getElementById('setting-rising-saves') as HTMLInputElement | null;
      const refreshMaxPinsInp = document.getElementById('setting-refresh-max-pins') as HTMLInputElement | null;
      const discoveryStopInp = document.getElementById('setting-discovery-stop-pages') as HTMLInputElement | null;
      const auditSweepCb = document.getElementById('setting-audit-sweep-enabled') as HTMLInputElement | null;
      const auditSweepLabel = document.getElementById('setting-audit-sweep-label');
      const candidatesCb = document.getElementById('setting-candidates-enabled') as HTMLInputElement | null;
      const candidatesLabel = document.getElementById('setting-candidates-label');
      const sheetWriteModeSel = document.getElementById('setting-sheet-write-mode') as HTMLSelectElement | null;
      const dailySheetSyncCb = document.getElementById('setting-daily-sheet-sync') as HTMLInputElement | null;
      const dailySheetSyncLabel = document.getElementById('setting-daily-sheet-sync-label');
      const summaryBadge = document.getElementById('settings-summary-badge');

      if (ingestCb) {
        ingestCb.checked = Boolean(json.ingest_enabled);
        if (ingestLabel) {
          ingestLabel.textContent = ingestCb.checked ? 'Active' : 'Disabled';
          ingestLabel.className = `text-xs font-bold ${ingestCb.checked ? 'text-emerald-500' : 'text-rose-500'}`;
        }
        if (summaryBadge) {
          summaryBadge.textContent = ingestCb.checked ? '🟢 Ingest Active' : '🔴 Ingest Paused';
          summaryBadge.className = `text-[10px] font-bold px-2 py-0.5 rounded-full border ${
            ingestCb.checked
              ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20'
              : 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20'
          }`;
        }
      }
      if (policySel) policySel.value = json.paused_account_policy || 'reject';
      if (maxBatchInp) maxBatchInp.value = String(json.max_batch_pins || 500);
      if (minSavesInp) minSavesInp.value = String(json.pin_filter_min_saves ?? 0);
      if (minRepinsInp) minRepinsInp.value = String(json.pin_filter_min_repins ?? 0);
      if (risingAgeInp) risingAgeInp.value = String(json.pin_filter_rising_age_days ?? 14);
      if (risingSavesInp) risingSavesInp.value = String(json.pin_filter_rising_saves ?? 34);
      if (refreshMaxPinsInp) refreshMaxPinsInp.value = String(json.refresh_max_pins ?? 0);
      if (discoveryStopInp) discoveryStopInp.value = String(json.discovery_stop_pages ?? 3);
      if (auditSweepCb) {
        auditSweepCb.checked = json.audit_sweep_enabled !== false;
        if (auditSweepLabel) {
          auditSweepLabel.textContent = auditSweepCb.checked ? 'Active' : 'Off';
          auditSweepLabel.className = `text-xs font-bold ${auditSweepCb.checked ? 'text-emerald-500' : 'text-muted-foreground'}`;
        }
      }
      if (candidatesCb) {
        candidatesCb.checked = json.candidates_enabled !== false;
        if (candidatesLabel) {
          candidatesLabel.textContent = candidatesCb.checked ? 'Active' : 'Off';
          candidatesLabel.className = `text-xs font-bold ${candidatesCb.checked ? 'text-emerald-500' : 'text-muted-foreground'}`;
        }
      }
      if (sheetWriteModeSel) sheetWriteModeSel.value = json.sheet_write_mode || 'append_only';
      if (dailySheetSyncCb) {
        dailySheetSyncCb.checked = Boolean(json.daily_sheet_sync_enabled);
        if (dailySheetSyncLabel) {
          dailySheetSyncLabel.textContent = dailySheetSyncCb.checked ? 'Active' : 'Off';
          dailySheetSyncLabel.className = `text-xs font-bold ${dailySheetSyncCb.checked ? 'text-emerald-500' : 'text-muted-foreground'}`;
        }
      }

      updateCostEstimate();
    } catch (e) {
      console.error('Failed to load settings:', e);
    }
  }

  function setupSettingsCollapse() {
    const toggleBtn = document.getElementById('toggle-settings-collapse-btn');
    const panelBody = document.getElementById('settings-panel-body');
    const collapseIcon = document.getElementById('settings-collapse-icon');
    const collapseText = document.getElementById('settings-collapse-text');
    if (!toggleBtn || !panelBody) return;

    let isExpanded = localStorage.getItem('pa_settings_expanded') === 'true';

    function updateCollapseUI() {
      if (isExpanded) {
        panelBody.classList.remove('hidden');
        if (collapseIcon) collapseIcon.style.transform = 'rotate(180deg)';
        if (collapseText) collapseText.textContent = 'Collapse';
      } else {
        panelBody.classList.add('hidden');
        if (collapseIcon) collapseIcon.style.transform = 'rotate(0deg)';
        if (collapseText) collapseText.textContent = 'Configure';
      }
    }

    updateCollapseUI();

    toggleBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      localStorage.setItem('pa_settings_expanded', String(isExpanded));
      updateCollapseUI();
    });
  }

  function disableSettingsForm() {
    const saveBtn = document.getElementById('save-ingest-settings-btn') as HTMLButtonElement | null;
    const reevaluateBtn = document.getElementById('reevaluate-candidates-btn') as HTMLButtonElement | null;
    const roleBadge = document.getElementById('settings-role-badge');
    const inputs = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      '#setting-ingest-enabled, #setting-paused-policy, #setting-max-batch, #setting-refresh-max-pins, #setting-min-saves, #setting-min-repins, #setting-rising-age, #setting-rising-saves, #setting-discovery-stop-pages, #setting-audit-sweep-enabled, #setting-candidates-enabled, #setting-sheet-write-mode, #setting-daily-sheet-sync'
    );
    inputs.forEach((el) => {
      el.disabled = true;
    });
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.classList.add('hidden');
    }
    if (reevaluateBtn) {
      reevaluateBtn.disabled = true;
      reevaluateBtn.classList.add('hidden');
    }
    if (roleBadge) roleBadge.classList.remove('hidden');
  }

  async function saveSettings() {
    const ingestCb = document.getElementById('setting-ingest-enabled') as HTMLInputElement | null;
    const policySel = document.getElementById('setting-paused-policy') as HTMLSelectElement | null;
    const maxBatchInp = document.getElementById('setting-max-batch') as HTMLInputElement | null;
    const refreshMaxPinsInp = document.getElementById('setting-refresh-max-pins') as HTMLInputElement | null;
    const minSavesInp = document.getElementById('setting-min-saves') as HTMLInputElement | null;
    const minRepinsInp = document.getElementById('setting-min-repins') as HTMLInputElement | null;
    const risingAgeInp = document.getElementById('setting-rising-age') as HTMLInputElement | null;
    const risingSavesInp = document.getElementById('setting-rising-saves') as HTMLInputElement | null;
    const discoveryStopInp = document.getElementById('setting-discovery-stop-pages') as HTMLInputElement | null;
    const auditSweepCb = document.getElementById('setting-audit-sweep-enabled') as HTMLInputElement | null;
    const candidatesCb = document.getElementById('setting-candidates-enabled') as HTMLInputElement | null;
    const sheetWriteModeSel = document.getElementById('setting-sheet-write-mode') as HTMLSelectElement | null;
    const dailySheetSyncCb = document.getElementById('setting-daily-sheet-sync') as HTMLInputElement | null;
    const statusMsg = document.getElementById('settings-status-msg');
    const saveBtn = document.getElementById('save-ingest-settings-btn') as HTMLButtonElement | null;
    const summaryBadge = document.getElementById('settings-summary-badge');

    if (!ingestCb || !policySel || !maxBatchInp || !minSavesInp || !minRepinsInp || !risingAgeInp || !risingSavesInp) return;

    if (saveBtn) saveBtn.disabled = true;
    if (statusMsg) {
      statusMsg.textContent = 'Saving...';
      statusMsg.className = 'text-xs font-semibold text-muted-foreground';
    }

    try {
      const res = await fetch('/api/pinarchive/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ingest_enabled: ingestCb.checked,
          paused_account_policy: policySel.value,
          max_batch_pins: parseInt(maxBatchInp.value, 10) || 500,
          refresh_max_pins: parseInt(refreshMaxPinsInp?.value || '0', 10) || 0,
          pin_filter_min_saves: parseInt(minSavesInp.value, 10) || 0,
          pin_filter_min_repins: parseInt(minRepinsInp.value, 10) || 0,
          pin_filter_rising_age_days: Number.isInteger(parseInt(risingAgeInp.value, 10)) ? parseInt(risingAgeInp.value, 10) : 14,
          pin_filter_rising_saves: Number.isInteger(parseInt(risingSavesInp.value, 10)) ? parseInt(risingSavesInp.value, 10) : 34,
          discovery_stop_pages: parseInt(discoveryStopInp?.value || '3', 10) || 3,
          audit_sweep_enabled: auditSweepCb ? auditSweepCb.checked : true,
          candidates_enabled: candidatesCb ? candidatesCb.checked : true,
          sheet_write_mode: sheetWriteModeSel?.value || 'append_only',
          daily_sheet_sync_enabled: dailySheetSyncCb ? dailySheetSyncCb.checked : false,
        }),
      });

      if (res.status === 403) {
        canAdminSettings = false;
        disableSettingsForm();
        if (statusMsg) {
          statusMsg.textContent = 'Forbidden: Admin access required.';
          statusMsg.className = 'text-xs font-semibold text-rose-500';
        }
        return;
      }

      const json = await res.json();
      if (!res.ok || !json.success) {
        throw new Error(json.error || 'Failed to save settings');
      }

      if (summaryBadge) {
        summaryBadge.textContent = ingestCb.checked ? '🟢 Ingest Active' : '🔴 Ingest Paused';
        summaryBadge.className = `text-[10px] font-bold px-2 py-0.5 rounded-full border ${
          ingestCb.checked
            ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20'
            : 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20'
        }`;
      }

      updateCostEstimate();

      if (statusMsg) {
        statusMsg.textContent = 'Settings saved!';
        statusMsg.className = 'text-xs font-semibold text-emerald-500';
        setTimeout(() => {
          if (statusMsg) statusMsg.textContent = '';
        }, 3000);
      }
    } catch (e: any) {
      if (statusMsg) {
        statusMsg.textContent = e.message || 'Save failed';
        statusMsg.className = 'text-xs font-semibold text-rose-500';
      }
    } finally {
      if (saveBtn && canAdminSettings) saveBtn.disabled = false;
    }
  }

  function setupReevaluateButton() {
    const btn = document.getElementById('reevaluate-candidates-btn') as HTMLButtonElement | null;
    const icon = document.getElementById('reevaluate-icon');
    const text = document.getElementById('reevaluate-btn-text');
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const root = document.getElementById('pinarchive-page-root');
      const workspaceId = root?.getAttribute('data-workspace-id') || '';
      if (!workspaceId) {
        toast('Workspace identifier missing', 'error');
        return;
      }

      btn.disabled = true;
      if (icon) icon.classList.add('animate-spin');
      if (text) text.textContent = 'Re-evaluating...';

      try {
        const res = await fetch('/api/internal/pinarchive/reevaluate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ workspace_id: workspaceId }),
        });

        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          toast(`Candidate Re-evaluation: ${json.promoted} promoted out of ${json.checked} candidates checked`, 'success');
          await loadOverview();
        } else if (res.status === 401 || res.status === 403) {
          toast('Admin access required for candidate re-evaluation', 'error');
        } else {
          toast(json.error || 'Promotion evaluation failed', 'error');
        }
      } catch (err: any) {
        console.error('Candidate promotion error:', err);
        toast(err?.message || 'Network error triggering re-evaluation', 'error');
      } finally {
        if (icon) icon.classList.remove('animate-spin');
        if (text) text.textContent = 'Re-evaluate Now';
        btn.disabled = false;
      }
    });
  }

  function attachAccountIngestToggleListeners() {
    document.querySelectorAll<HTMLInputElement>('[data-acc-ingest-toggle]').forEach((cb) => {
      cb.addEventListener('change', async () => {
        const id = cb.getAttribute('data-acc-ingest-toggle');
        if (!id) return;
        const enabled = cb.checked;
        cb.disabled = true;

        try {
          const res = await fetch('/api/pinarchive/accounts-ingest-toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ account_ids: [id], ingest_enabled: enabled }),
          });

          if (res.status === 403) {
            cb.checked = !enabled;
            alert('Admin access required to toggle account ingestion.');
            return;
          }

          const json = await res.json();
          if (!res.ok || !json.success) {
            cb.checked = !enabled;
            alert(json.error || 'Failed to update account ingest status.');
          }
        } catch {
          cb.checked = !enabled;
        } finally {
          cb.disabled = false;
        }
      });
    });
  }

