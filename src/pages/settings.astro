        <label class="cursor-pointer flex items-center justify-between rounded-xl border border-border bg-muted/20 p-4 transition-all hover:bg-muted/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:checked]:ring-1 has-[:checked]:ring-primary">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
            <div>
              <span class="text-xs font-bold text-foreground block">Dark Theme</span>
              <span class="text-[10px] text-muted-foreground">Deep slate dark</span>
            </div>
          </div>
          <input type="radio" name="theme-preference" value="dark" class="text-primary focus:ring-primary h-4 w-4" />
        </label>

        <label class="cursor-pointer flex items-center justify-between rounded-xl border border-border bg-muted/20 p-4 transition-all hover:bg-muted/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:checked]:ring-1 has-[:checked]:ring-primary">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
            <div>
              <span class="text-xs font-bold text-foreground block">System Default</span>
              <span class="text-[10px] text-muted-foreground">Sync with OS mode</span>
            </div>
          </div>
          <input type="radio" name="theme-preference" value="system" class="text-primary focus:ring-primary h-4 w-4" />
        </label>
      </div>
    </div>

    <!-- Card 5: Danger Zone (Placeholder) -->
    <div class="rounded-2xl border border-rose-500/20 bg-rose-500/[0.03] p-6 shadow-sm space-y-3">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <h3 class="text-sm font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider">Danger Zone</h3>
      </div>
      <p class="text-xs text-muted-foreground">
        Workspace session revocation, multi-device signout, and emergency token invalidation.
      </p>
      <div class="rounded-xl border border-dashed border-rose-500/30 bg-rose-500/5 p-3.5 text-center">
        <span class="text-xs font-semibold text-rose-600/80 dark:text-rose-400/80">
          Session revocation — coming soon
        </span>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Sync radio preferences with localStorage theme
  const savedTheme = localStorage.getItem('theme') || 'system';
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="theme-preference"]');
  radios.forEach(r => {
    if (r.value === savedTheme) {
      r.checked = true;
    }
    r.addEventListener('change', () => {
      if (r.checked) {
        if (r.value === 'system') {
          localStorage.removeItem('theme');
          const isSysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', isSysDark);
        } else {
          localStorage.setItem('theme', r.value);
          document.documentElement.classList.toggle('dark', r.value === 'dark');
        }
      }
    });
  });

  // Generalized Retention & Lifecycle Form Logic
  const form = document.getElementById('retention-settings-form') as HTMLFormElement | null;
  const saveBtn = document.getElementById('btn-save-retention') as HTMLButtonElement | null;
  const statusMsg = document.getElementById('retention-status-msg');
  const defaultBadge = document.getElementById('retention-default-badge');
  const safetyNote = document.getElementById('retention-safety-note');

  const controls = () => Array.from(form ? form.querySelectorAll<HTMLInputElement>('input[name]') : []);
  const val = (el: HTMLInputElement) => el.type === 'checkbox' ? String(el.checked) : el.value;
  let initial = new Map(controls().map(el => [el.name, val(el)]));
  const isDirty = () => controls().some(el => val(el) !== initial.get(el.name));
  const refreshSave = () => { if (saveBtn) saveBtn.disabled = !isDirty(); };

  const gates: Array<[string, string]> = [
    ['auto-prune-enabled', 'p1-gated'],
    ['p2-prune-enabled', 'p2-gated'],
    ['p3-prune-enabled', 'p3-gated'],
  ];

  function applyGates() {
    for (const [toggleId, sectionId] of gates) {
      const on = (document.getElementById(toggleId) as HTMLInputElement | null)?.checked ?? false;
      const sec = document.getElementById(sectionId);
      sec?.classList.toggle('opacity-50', !on);
      sec?.classList.toggle('pointer-events-none', !on);
    }
    const master = (document.getElementById('auto-prune-enabled') as HTMLInputElement | null)?.checked ?? false;
    const p2 = (document.getElementById('p2-prune-enabled') as HTMLInputElement | null)?.checked ?? false;
    const p3 = (document.getElementById('p3-prune-enabled') as HTMLInputElement | null)?.checked ?? false;
    if (safetyNote) {
      safetyNote.textContent = (master || p2 || p3)
        ? '⚠️ Pruning ENABLED for: ' + [master && 'P1', p2 && 'P2', p3 && 'P3'].filter(Boolean).join(', ') + '. Deletions will run per thresholds.'
        : '✅ All pruning DISABLED. Nothing is auto-deleted. Recovery sweep stays active.';
    }
  }

  form?.addEventListener('input', () => { refreshSave(); applyGates(); });
  form?.addEventListener('change', () => { refreshSave(); applyGates(); });
  applyGates(); refreshSave();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !saveBtn) return;
    const payload: Record<string, any> = { workspace_id: form.getAttribute('data-workspace-id') };
    for (const el of controls()) {
      payload[el.name] = el.type === 'checkbox' ? el.checked
        : el.type === 'number' ? (el.value === '' ? null : Number(el.value))
        : el.value;
    }
    saveBtn.disabled = true;
    const orig = saveBtn.textContent; saveBtn.textContent = 'Saving...';
    statusMsg?.classList.add('hidden');
    try {
      const res = await fetch('/api/settings/retention', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save settings');
      // re-sync initial snapshot from saved row
      for (const el of controls()) {
        const savedVal = data[el.name];
        if (savedVal === undefined) continue;
        if (el.type === 'checkbox') el.checked = Boolean(savedVal);
        else el.value = savedVal === null ? '' : String(savedVal);
      }
      initial = new Map(controls().map(el => [el.name, val(el)]));
      defaultBadge?.classList.add('hidden');
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
        statusMsg.textContent = 'Retention & recovery settings saved successfully.';
        statusMsg.classList.remove('hidden');
        setTimeout(() => statusMsg?.classList.add('hidden'), 4000);
      }
    } catch (err: any) {
      if (statusMsg) {
        statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-rose-500/10 text-rose-500 border border-rose-500/20';
        statusMsg.textContent = err.message || 'Error updating retention settings';
        statusMsg.classList.remove('hidden');
      }
      saveBtn.disabled = false;
    } finally {
      saveBtn.textContent = orig;
      refreshSave();
      applyGates();
    }
  });

  // Manual Cleanup "Run Now" Handlers (P1, P2, P3)
  const runNowButtons = document.querySelectorAll<HTMLButtonElement>('button[id^="run-now-"]');
  runNowButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const section = btn.getAttribute('data-section');
      if (!section) return;

      const workspaceId = form?.getAttribute('data-workspace-id');
      if (!workspaceId) return;

      let confirmMsg = '';
      if (section === 'p1') {
        const postedDaysInput = document.getElementById('retention-posted-days') as HTMLInputElement | null;
        const postedDays = postedDaysInput?.value || '30';
        confirmMsg = `Run P1 cleanup NOW (one-time, bypasses the toggle)?\nPosted > ${postedDays}d, Terminal, Logs, Sessions will be DELETED.\nContinue?`;
      } else if (section === 'p2') {
        confirmMsg = `Run P2 cleanup NOW (one-time, bypasses the toggle)?\nOld competitor snapshots and job logs will be DELETED.\nContinue?`;
      } else if (section === 'p3') {
        confirmMsg = `Run P3 cleanup NOW (one-time, bypasses the toggle)?\nAnalytics ingestion runs (>90d) and top pins snapshots (>180d) will be DELETED.\nContinue?`;
      }

      if (!confirm(confirmMsg)) return;

      const originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Running…';

      try {
        const res = await fetch('/api/settings/run-cleanup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ workspace_id: workspaceId, section }),
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Cleanup run failed');

        // Update the last-run paragraph for the section
        const lastRunElem = document.getElementById(`last-run-${section}`);
        if (lastRunElem) {
          const nowStr = new Date().toLocaleString();
          if (section === 'p1') {
            const pins = data.deleted_pins_count ?? 0;
            const terminal = data.deleted_terminal_pins_count ?? 0;
            const logs = data.deleted_delivery_logs ?? 0;
            const sessions = data.deleted_import_sessions ?? 0;
            lastRunElem.textContent = `Last run: ${nowStr} · manual · deleted ${pins} posted pins, ${terminal} terminal pins, ${logs} logs, ${sessions} sessions`;
          } else if (section === 'p2') {
            const p2 = data.p2;
            const snaps = p2?.snapshots ?? 0;
            const jobs = p2?.jobs ?? 0;
            lastRunElem.textContent = `Last run: ${nowStr} · manual · deleted ${snaps} snapshots, ${jobs} jobs`;
          } else if (section === 'p3') {
            const runs = data.deleted_ingestion_runs ?? 0;
            const snaps = data.deleted_snapshots_count ?? 0;
            lastRunElem.textContent = `Last run: ${nowStr} · manual · deleted ${runs} ingestion runs, ${snaps} snapshots`;
          }
        }

        if (statusMsg) {
          statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20';
          statusMsg.textContent = `Section ${section.toUpperCase()} cleanup executed successfully.`;
          statusMsg.classList.remove('hidden');
          setTimeout(() => {
            statusMsg?.classList.add('hidden');
          }, 4000);
        }
      } catch (err: any) {
        if (statusMsg) {
          statusMsg.className = 'rounded-xl p-3 text-xs font-semibold bg-rose-500/10 text-rose-500 border border-rose-500/20';
          statusMsg.textContent = err.message || `Failed to run ${section.toUpperCase()} cleanup`;
          statusMsg.classList.remove('hidden');
        }
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  });
</script>
