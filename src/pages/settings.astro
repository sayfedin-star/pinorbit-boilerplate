    <!-- Card 4: Preferences -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-4">
      <div>
        <h3 class="text-sm font-bold text-foreground uppercase tracking-wider">Appearance & Theme Preferences</h3>
        <p class="text-xs text-muted-foreground mt-0.5">Select your default dashboard color mode.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2" id="theme-settings-group">
        <label class="cursor-pointer flex items-center justify-between rounded-xl border border-border bg-muted/20 p-4 transition-all hover:bg-muted/40 has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:checked]:ring-1 has-[:checked]:ring-primary">
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <div>
              <span class="text-xs font-bold text-foreground block">Light Theme</span>
              <span class="text-[10px] text-muted-foreground">Crisp high-contrast</span>
            </div>
          </div>
          <input type="radio" name="theme-preference" value="light" class="text-primary focus:ring-primary h-4 w-4" />
