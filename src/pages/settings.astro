---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import SectionTabs from '../components/ui/SectionTabs.astro';
import { getActiveWorkspaceId, getWorkspaces } from '../lib/workspaces';

const settingsTabs = [
  { label: 'Workspace', href: '/settings' },
  { label: 'Audit Trail', href: '/settings/audit' },
];

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/settings');
}

const supabase = Astro.locals.supabase;
const activeWorkspaceId = getActiveWorkspaceId(Astro.cookies);
const allWorkspaces = await getWorkspaces(Astro.cookies, Astro.request, Astro.response?.headers);
const currentWorkspace = allWorkspaces.find(w => w.id === activeWorkspaceId) || allWorkspaces[0];

// Fetch memberships for this workspace
let members: Array<{ id: string; user_id: string; role: string; created_at: string; email?: string }> = [];
let currentRole = 'member';

if (supabase && currentWorkspace) {
  try {
    const { data: memberData } = await supabase
      .from('workspace_memberships')
      .select('id, user_id, role, created_at')
      .eq('workspace_id', currentWorkspace.id);

    if (memberData && memberData.length > 0) {
      members = memberData.map((m: any) => ({
        ...m,
        email: m.user_id === user.id ? user.email : `User (${m.user_id.slice(0, 8)}...)`,
      }));

      const myMem = memberData.find((m: any) => m.user_id === user.id);
      if (myMem) {
        currentRole = myMem.role;
      }
    }
  } catch (err) {
    console.warn('Error fetching workspace memberships:', err);
    members = [];
    currentRole = 'member';
  }
}

// Fetch retention settings for current workspace
let retentionSettings: any = {
  auto_prune_enabled: false,
  retention_posted_days: 30,
  retention_terminal_days: 90,
  retention_logs_days: 14,
  import_sessions_days: 30,
  processing_timeout_minutes: 45,
  p2_prune_enabled: false,
  competitor_snapshots_days: 90,
  competitor_jobs_days: 30,
  p3_prune_enabled: false,
  ingestion_runs_days: 30,
  top_pins_raw_days: 180,
  top_pins_downsample_enabled: false,
  analytics_daily_keep_days: null,
  is_default: true,
  last_cleanup_at: null,
  last_cleanup_result: null,
};

if (supabase && currentWorkspace) {
  try {
    const { data: retData } = await supabase
      .from('workspace_retention_settings')
      .select('*')
      .eq('workspace_id', currentWorkspace.id)
      .maybeSingle();

    if (retData) {
      retentionSettings = {
        ...retData,
        auto_prune_enabled: Boolean(retData.auto_prune_enabled ?? false),
        retention_posted_days: retData.retention_posted_days ?? 30,
        retention_terminal_days: retData.retention_terminal_days ?? 90,
        retention_logs_days: retData.retention_logs_days ?? 14,
        import_sessions_days: retData.import_sessions_days ?? 30,
        processing_timeout_minutes: retData.processing_timeout_minutes ?? 45,
        p2_prune_enabled: Boolean(retData.p2_prune_enabled ?? false),
        competitor_snapshots_days: retData.competitor_snapshots_days ?? 90,
        competitor_jobs_days: retData.competitor_jobs_days ?? 30,
        p3_prune_enabled: Boolean(retData.p3_prune_enabled ?? false),
        ingestion_runs_days: retData.ingestion_runs_days ?? 30,
        top_pins_raw_days: retData.top_pins_raw_days ?? 180,
        top_pins_downsample_enabled: Boolean(retData.top_pins_downsample_enabled ?? false),
        analytics_daily_keep_days: retData.analytics_daily_keep_days ?? null,
        is_default: false,
        last_cleanup_at: retData.last_cleanup_at ?? null,
        last_cleanup_result: retData.last_cleanup_result ?? null,
      };
    }
  } catch (err) {
    console.warn('Error fetching retention settings:', err);
  }
}

function formatLastRunP1(result: any) {
  const p1 = result?.sections?.p1;
  if (!result || !p1) return 'No cleanup runs recorded yet.';
  const d = new Date(result.at).toLocaleString();
  const trigger = result.trigger || 'api';
  const pins = p1.pins ?? 0;
  const terminal = p1.terminal ?? 0;
  const logs = p1.logs ?? 0;
  const sessions = p1.sessions ?? 0;
  return `Last run: ${d} · ${trigger} · deleted ${pins} posted pins, ${terminal} terminal pins, ${logs} logs, ${sessions} sessions`;
}

function formatLastRunP2(result: any) {
  const p2 = result?.sections?.p2;
  if (!result || !p2) return 'No cleanup runs recorded yet.';
  const d = new Date(result.at).toLocaleString();
  const trigger = result.trigger || 'api';
  const snapshots = p2.snapshots ?? 0;
  const jobs = p2.jobs ?? 0;
  return `Last run: ${d} · ${trigger} · deleted ${snapshots} snapshots, ${jobs} jobs`;
}

function formatLastRunP3(result: any) {
  const p3 = result?.sections?.p3;
  if (!result || !p3) return 'No cleanup runs recorded yet.';
  const d = new Date(result.at).toLocaleString();
  const trigger = result.trigger || 'api';
  const runs = p3.runs ?? 0;
  const snapshots = p3.snapshots ?? 0;
  return `Last run: ${d} · ${trigger} · deleted ${runs} ingestion runs, ${snapshots} snapshots`;
}
---

<Layout title="Workspace Settings" description="Manage workspace details, team memberships, quick links, and system preferences.">
  <div class="space-y-8 max-w-5xl">
    <SectionHeader
      title="Workspace Settings"
      description="Configure workspace profile, member roles, security quick-links, and UI preferences."
    />

    <SectionTabs tabs={settingsTabs} activeHref="/settings" />

    <!-- Card 1: Workspace Profile & Team Members -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/60 pb-5">
        <div>
          <div class="flex items-center gap-2.5">
            <h3 class="text-base font-bold text-foreground">{currentWorkspace?.name || 'Workspace'}</h3>
            <span class="rounded-full bg-primary/10 border border-primary/20 px-2.5 py-0.5 text-xs font-bold text-primary uppercase tracking-wider">
              {currentRole}
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-1">
            Workspace ID: <span class="font-mono text-foreground font-semibold">{currentWorkspace?.id || '—'}</span>
          </p>
        </div>
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <span>Created:</span>
          <span class="font-mono text-foreground">{currentWorkspace?.created_at ? new Date(currentWorkspace.created_at).toLocaleDateString() : '—'}</span>
        </div>
      </div>

      <!-- Members List -->
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Workspace Members</h4>
          <span class="text-xs font-semibold text-muted-foreground">{members.length} {members.length === 1 ? 'member' : 'members'}</span>
        </div>

        <div class="overflow-x-auto rounded-xl border border-border bg-muted/20">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-border/60 bg-muted/40 text-[10px] uppercase font-bold text-muted-foreground tracking-wider">
              <tr>
                <th class="py-2.5 px-4">Member</th>
                <th class="py-2.5 px-4 text-center">Role</th>
                <th class="py-2.5 px-4 text-right">Joined</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/40 font-medium">
              {members.map((m) => (
                <tr class="hover:bg-muted/30 transition-colors">
                  <td class="py-3 px-4 flex items-center gap-2.5">
                    <div class="h-7 w-7 rounded-full bg-primary/15 border border-primary/30 flex items-center justify-center font-bold text-primary text-xs shrink-0">
                      {m.email ? m.email.slice(0, 2).toUpperCase() : 'U'}
                    </div>
                    <div class="min-w-0">
                      <span class="font-semibold text-foreground block truncate">{m.email}</span>
                      <span class="text-[10px] font-mono text-muted-foreground truncate block">{m.user_id}</span>
                    </div>
                  </td>
                  <td class="py-3 px-4 text-center">
                    <span class={`inline-flex items-center rounded-md px-2 py-0.5 text-[10px] font-bold uppercase ${
                      m.role === 'owner' 
                        ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20' 
                        : m.role === 'admin'
                        ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20'
                        : 'bg-muted text-muted-foreground border border-border'
                    }`}>
                      {m.role}
                    </span>
                  </td>
                  <td class="py-3 px-4 text-right font-mono text-muted-foreground text-[11px]">
                    {m.created_at ? new Date(m.created_at).toLocaleDateString() : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Card 2: Retention & Lifecycle Control -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6" id="retention-settings-card">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/60 pb-5">
        <div class="flex items-start gap-3">
          <div class="h-10 w-10 rounded-xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center text-lg shrink-0 mt-0.5 shadow-sm">
            🗄️
          </div>
          <div>
            <div class="flex items-center gap-2.5">
              <h3 class="text-base font-bold text-foreground">Retention & Lifecycle Control</h3>
              <span id="retention-default-badge" class={`rounded-full bg-amber-500/10 border border-amber-500/20 px-2.5 py-0.5 text-xs font-semibold text-amber-600 dark:text-amber-400 ${retentionSettings.is_default ? '' : 'hidden'}`}>
                Using safe defaults (30 / 45)
              </span>
            </div>
            <p class="text-xs text-muted-foreground mt-1">
              Per-workspace automated cleanup, recovery timeouts, and data pruning controls (all automation defaults to disabled).
            </p>
          </div>
        </div>
      </div>

      <form id="retention-settings-form" class="space-y-6" data-workspace-id={currentWorkspace?.id}>
        <!-- Always-Active Recovery Sweep (Outside Gated Wrappers) -->
        <div class="rounded-xl border border-border/70 bg-muted/10 p-4 space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold uppercase tracking-wider text-foreground flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
              Self-Healing & Recovery Sweep
            </h4>
            <span class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20">Always Active</span>
          </div>
          <div class="space-y-2">
            <label for="processing-timeout-minutes" class="block text-xs font-bold uppercase tracking-wider text-foreground">
              Processing orphan timeout (minutes)
            </label>
            <input
              type="number"
              id="processing-timeout-minutes"
              name="processing_timeout_minutes"
              min="5"
              max="240"
              value={retentionSettings.processing_timeout_minutes}
              class="w-full max-w-md rounded-xl border border-border bg-background px-4 py-2.5 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
              required
            />
            <p class="text-[11px] text-muted-foreground">
              Recovery sweep — always active (non-destructive). Processing pins older than this are safely re-queued.
            </p>
          </div>
        </div>

        <!-- Section 1: P1 Scheduling & Pin Lifecycle Control -->
        <div class="rounded-xl border border-border bg-card p-4 space-y-4">
          <div class="flex items-center justify-between border-b border-border/60 pb-3">
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">Project 1: Scheduling & Pin Retention</h4>
              <p class="text-[11px] text-muted-foreground mt-0.5">Control automatic purge of completed pins, terminal errors, logs, and imports.</p>
            </div>
            <div class="flex items-center gap-3">
              {(currentRole === 'admin' || currentRole === 'owner') && (
                <button
                  type="button"
                  id="run-now-p1"
                  data-section="p1"
                  class="rounded-lg border border-primary/30 bg-primary/10 px-3 py-1.5 text-[11px] font-bold text-primary hover:bg-primary/20 transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
                >
                  ▶ Run Now
                </button>
              )}
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  id="auto-prune-enabled"
                  name="auto_prune_enabled"
                  checked={retentionSettings.auto_prune_enabled}
                  class="sr-only peer"
                />
                <div class="w-9 h-5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-border after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                <span class="ml-2 text-xs font-semibold text-foreground">Enable P1 Pruning</span>
              </label>
            </div>
          </div>

          <div id="p1-gated" class={`grid grid-cols-1 sm:grid-cols-2 gap-4 transition-opacity ${retentionSettings.auto_prune_enabled ? '' : 'opacity-50 pointer-events-none'}`}>
            <div class="space-y-1.5">
              <label for="retention-posted-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Posted pins retention (days)
              </label>
              <input
                type="number"
                id="retention-posted-days"
                name="retention_posted_days"
                min="1"
                max="365"
                value={retentionSettings.retention_posted_days}
                class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                required
              />
              <p class="text-[10px] text-muted-foreground">Posted pins older than this are purged.</p>
            </div>

            <div class="space-y-1.5">
              <label for="retention-terminal-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Terminal pins retention (days)
              </label>
              <input
                type="number"
                id="retention-terminal-days"
                name="retention_terminal_days"
                min="1"
                max="365"
                value={retentionSettings.retention_terminal_days}
                class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                required
              />
              <p class="text-[10px] text-muted-foreground">Failed/cancelled pins older than this are purged.</p>
            </div>

            <div class="space-y-1.5">
              <label for="retention-logs-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Delivery logs retention (days)
              </label>
              <input
                type="number"
                id="retention-logs-days"
                name="retention_logs_days"
                min="1"
                max="180"
                value={retentionSettings.retention_logs_days}
                class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                required
              />
              <p class="text-[10px] text-muted-foreground">Delivery and dispatch log history threshold.</p>
            </div>

            <div class="space-y-1.5">
              <label for="import-sessions-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Import sessions retention (days)
              </label>
              <input
                type="number"
                id="import-sessions-days"
                name="import_sessions_days"
                min="1"
                max="365"
                value={retentionSettings.import_sessions_days}
                class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                required
              />
              <p class="text-[10px] text-muted-foreground">Historical CSV/bulk import session records.</p>
            </div>
          </div>

          <p id="last-run-p1" class="text-[10px] text-muted-foreground pt-1">
            {formatLastRunP1(retentionSettings.last_cleanup_result)}
          </p>
        </div>

        <!-- Section 2: P2 Competitor Intelligence Lifecycle Control -->
        <div class="rounded-xl border border-border bg-card p-4 space-y-4">
          <div class="flex items-center justify-between border-b border-border/60 pb-3">
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">Project 2: Competitor Intelligence Retention</h4>
              <p class="text-[11px] text-muted-foreground mt-0.5">Control automatic purge of competitor crawl snapshots and ingestion job logs.</p>
            </div>
            <div class="flex items-center gap-3">
              {(currentRole === 'admin' || currentRole === 'owner') && (
                <button
                  type="button"
                  id="run-now-p2"
                  data-section="p2"
                  class="rounded-lg border border-primary/30 bg-primary/10 px-3 py-1.5 text-[11px] font-bold text-primary hover:bg-primary/20 transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
                >
                  ▶ Run Now
                </button>
              )}
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  id="p2-prune-enabled"
                  name="p2_prune_enabled"
                  checked={retentionSettings.p2_prune_enabled}
                  class="sr-only peer"
                />
                <div class="w-9 h-5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-border after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                <span class="ml-2 text-xs font-semibold text-foreground">Enable P2 Pruning</span>
              </label>
            </div>
          </div>

          <div id="p2-gated" class={`grid grid-cols-1 sm:grid-cols-2 gap-4 transition-opacity ${retentionSettings.p2_prune_enabled ? '' : 'opacity-50 pointer-events-none'}`}>
            <div class="space-y-1.5">
              <label for="competitor-snapshots-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Competitor snapshots retention (days)
              </label>
              <input
                type="number"
                id="competitor-snapshots-days"
                name="competitor_snapshots_days"
                min="1"
                max="365"
                value={retentionSettings.competitor_snapshots_days}
                class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                required
              />
              <p class="text-[10px] text-muted-foreground">Historical competitor profile snapshots.</p>
            </div>

            <div class="space-y-1.5">
              <label for="competitor-jobs-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Competitor ingestion jobs retention (days)
              </label>
              <input
                type="number"
                id="competitor-jobs-days"
                name="competitor_jobs_days"
                min="1"
                max="180"
                value={retentionSettings.competitor_jobs_days}
                class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                required
              />
              <p class="text-[10px] text-muted-foreground">Competitor sync & crawl job execution logs.</p>
            </div>
          </div>

          <p id="last-run-p2" class="text-[10px] text-muted-foreground pt-1">
            {formatLastRunP2(retentionSettings.last_cleanup_result)}
          </p>
        </div>

        <!-- Section 3: P3 Analytics Pipeline Lifecycle Control -->
        <div class="rounded-xl border border-border bg-card p-4 space-y-4">
          <div class="flex items-center justify-between border-b border-border/60 pb-3">
            <div>
              <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">Project 3: Analytics Pipeline Retention</h4>
              <p class="text-[11px] text-muted-foreground mt-0.5">Control automatic purge of raw top pins snapshots and ETL ingestion run records.</p>
            </div>
            <div class="flex items-center gap-3">
              {(currentRole === 'admin' || currentRole === 'owner') && (
                <button
                  type="button"
                  id="run-now-p3"
                  data-section="p3"
                  class="rounded-lg border border-primary/30 bg-primary/10 px-3 py-1.5 text-[11px] font-bold text-primary hover:bg-primary/20 transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
                >
                  ▶ Run Now
                </button>
              )}
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  id="p3-prune-enabled"
                  name="p3_prune_enabled"
                  checked={retentionSettings.p3_prune_enabled}
                  class="sr-only peer"
                />
                <div class="w-9 h-5 bg-muted peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-border after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                <span class="ml-2 text-xs font-semibold text-foreground">Enable P3 Pruning</span>
              </label>
            </div>
          </div>

          <div id="p3-gated" class={`grid grid-cols-1 sm:grid-cols-2 gap-4 transition-opacity ${retentionSettings.p3_prune_enabled ? '' : 'opacity-50 pointer-events-none'}`}>
            <div class="space-y-1.5">
              <label for="ingestion-runs-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Ingestion runs retention (days)
              </label>
              <input
                type="number"
                id="ingestion-runs-days"
                name="ingestion_runs_days"
                min="1"
                max="365"
                value={retentionSettings.ingestion_runs_days}
                class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                required
              />
              <p class="text-[10px] text-muted-foreground">ETL sync run logs and payload status records.</p>
            </div>

            <div class="space-y-1.5">
              <label for="top-pins-raw-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Top pins raw snapshots retention (days)
              </label>
              <input
                type="number"
                id="top-pins-raw-days"
                name="top_pins_raw_days"
                min="1"
                max="730"
                value={retentionSettings.top_pins_raw_days}
                class="w-full rounded-xl border border-border bg-background px-3.5 py-2 text-xs font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                required
              />
              <p class="text-[10px] text-muted-foreground">Raw window snapshot retention (default 180d).</p>
            </div>

            <div class="space-y-1.5">
              <label for="analytics-daily-keep-days" class="block text-[11px] font-bold uppercase tracking-wider text-foreground">
                Daily analytics keep limit (days)
              </label>
              <input
                type="number"
                id="analytics-daily-keep-days"
                name="analytics_daily_keep_days"
                min="1"
                max="730"
                value={retentionSettings.analytics_daily_keep_days ?? ''}
                placeholder="Indefinite (leave blank)"
