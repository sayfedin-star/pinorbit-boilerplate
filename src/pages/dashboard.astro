---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import KPIStatCard from '../components/ui/KPIStatCard.astro';
---

<Layout title="Dashboard" description="Command Center — Centralized intelligence and operational monitoring across PinOrbit modules.">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <SectionHeader
      title="Command Center"
      description="Centralized operational monitoring and intelligence across all PinOrbit modules."
    />

    <!-- Quick Actions Row -->
    <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-auto">
      <a
        href="/imports"
        class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 py-2 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        <span>+ Import Pins</span>
      </a>

      <a
        href="/analytics"
        class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
        <span>+ Add Connection</span>
      </a>

      <a
        href="/competitors"
        class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        <span>Track Competitor</span>
      </a>

      <a
        href="/pinarchive/winning-pins"
        class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-3 py-2 text-xs font-semibold text-foreground shadow-sm hover:bg-muted transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span>Winning Pins</span>
      </a>
    </div>
  </div>

  <!-- 4 Clickable Primary Module KPI Cards -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    <!-- Module 1: Scheduling -->
    <div id="module-card-scheduling">
      <a href="/scheduling" class="group block h-full">
        <div class="relative h-full overflow-hidden rounded-2xl border border-border bg-card p-5 shadow-sm transition-all duration-200 hover:border-primary/50 hover:shadow-md">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground group-hover:text-primary transition-colors">Scheduling</span>
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            </div>
          </div>
          <div class="mt-3">
            <div id="metric-scheduling-val" class="text-2xl font-bold tracking-tight text-foreground">---</div>
            <p id="metric-scheduling-sub" class="mt-1 text-xs text-muted-foreground">Loading queue & status...</p>
          </div>
          <!-- Mini capacity bar -->
          <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-[11px] text-muted-foreground">
            <span id="metric-scheduling-badge" class="font-medium text-foreground">Webhooks: Loading...</span>
            <span class="text-primary font-semibold flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
              Overview &rarr;
            </span>
          </div>
        </div>
      </a>
    </div>

    <!-- Module 2: Analytics -->
    <div id="module-card-analytics">
      <a href="/analytics" class="group block h-full">
        <div class="relative h-full overflow-hidden rounded-2xl border border-border bg-card p-5 shadow-sm transition-all duration-200 hover:border-primary/50 hover:shadow-md">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground group-hover:text-primary transition-colors">Analytics (30D)</span>
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-500/10 text-blue-500 border border-blue-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
          </div>
          <div class="mt-3">
            <div id="metric-analytics-val" class="text-2xl font-bold tracking-tight text-foreground">---</div>
            <p id="metric-analytics-sub" class="mt-1 text-xs text-muted-foreground">Loading impressions...</p>
          </div>
          <!-- Sparkline container -->
          <div class="mt-3 pt-2 border-t border-border/60 flex items-center justify-between">
            <div id="analytics-sparkline" class="h-6 w-24">
              <svg class="h-full w-full overflow-visible" viewBox="0 0 100 25">
                <path d="M0,20 Q25,5 50,15 T100,5" fill="none" stroke="currentColor" stroke-width="2.5" class="text-blue-500" stroke-linecap="round"/>
              </svg>
            </div>
            <span class="text-primary text-[11px] font-semibold flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
              Pinner &rarr;
            </span>
          </div>
        </div>
      </a>
    </div>

    <!-- Module 3: Competitor -->
    <div id="module-card-competitors">
      <a href="/competitors" class="group block h-full">
        <div class="relative h-full overflow-hidden rounded-2xl border border-border bg-card p-5 shadow-sm transition-all duration-200 hover:border-primary/50 hover:shadow-md">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground group-hover:text-primary transition-colors">Competitor</span>
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-purple-500/10 text-purple-500 border border-purple-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
          </div>
          <div class="mt-3">
            <div id="metric-competitors-val" class="text-2xl font-bold tracking-tight text-foreground">---</div>
            <p id="metric-competitors-sub" class="mt-1 text-xs text-muted-foreground">Loading tracked profiles...</p>
          </div>
          <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-[11px] text-muted-foreground">
            <span id="metric-competitors-badge" class="font-medium text-foreground">Intelligence active</span>
            <span class="text-primary font-semibold flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
              View &rarr;
            </span>
          </div>
        </div>
      </a>
    </div>

    <!-- Module 4: PinArchive -->
    <div id="module-card-pinarchive">
      <a href="/pinarchive" class="group block h-full">
        <div class="relative h-full overflow-hidden rounded-2xl border border-border bg-card p-5 shadow-sm transition-all duration-200 hover:border-primary/50 hover:shadow-md">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground group-hover:text-primary transition-colors">PinArchive</span>
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
            </div>
          </div>
          <div class="mt-3">
            <div id="metric-pinarchive-val" class="text-2xl font-bold tracking-tight text-foreground">---</div>
            <p id="metric-pinarchive-sub" class="mt-1 text-xs text-muted-foreground">Loading archived pins...</p>
          </div>
          <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-[11px] text-muted-foreground">
            <span id="metric-pinarchive-badge" class="font-medium text-foreground">Recipe clusters</span>
            <span class="text-primary font-semibold flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
              Archive &rarr;
            </span>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- Content Grid: Recent Queue & Cross-Module Shortcuts & Live Stream -->
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
    <!-- Left 2 columns: Active Queue & Quick Modules Overview -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Recent Pins Queue -->
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <h3 class="text-base font-bold text-foreground">Active Publishing Queue</h3>
            <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-bold text-primary">Live</span>
          </div>
          <div class="flex items-center gap-3">
            <a href="/scheduling" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
              Scheduling Console &rarr;
            </a>
          </div>
        </div>

        <div id="command-pins-container">
          <div class="overflow-hidden rounded-2xl border border-border bg-card p-8 text-center text-xs text-muted-foreground animate-pulse">
            Loading recent publishing queue...
          </div>
        </div>
      </div>

      <!-- Cross-Module Deep-Dive Panels -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Panel 1: Multi-Webhook Capacity Health -->
        <div class="rounded-2xl border border-border bg-card p-5 space-y-3 shadow-sm">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">Make.com Webhooks</h4>
            <a href="/scheduling/accounts" class="text-[11px] font-semibold text-primary hover:underline">Manage</a>
          </div>
          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="rounded-xl border border-border bg-background p-2.5">
              <span class="text-[10px] text-muted-foreground font-medium block">Total</span>
              <span id="sub-wb-total" class="text-base font-bold text-foreground mt-0.5 block">---</span>
            </div>
            <div class="rounded-xl border border-border bg-background p-2.5">
              <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium block">Active</span>
              <span id="sub-wb-active" class="text-base font-bold text-emerald-500 mt-0.5 block">---</span>
            </div>
            <div class="rounded-xl border border-border bg-background p-2.5">
              <span class="text-[10px] text-amber-600 dark:text-amber-400 font-medium block">Alert</span>
              <span id="sub-wb-exhausted" class="text-base font-bold text-amber-500 mt-0.5 block">---</span>
            </div>
          </div>
        </div>

        <!-- Panel 2: Pinner Analytics 30D Highlights -->
        <div class="rounded-2xl border border-border bg-card p-5 space-y-3 shadow-sm">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">Pinner Engagement</h4>
            <a href="/analytics" class="text-[11px] font-semibold text-primary hover:underline">Details</a>
          </div>
          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="rounded-xl border border-border bg-background p-2.5">
              <span class="text-[10px] text-muted-foreground font-medium block">Clicks</span>
              <span id="sub-an-clicks" class="text-base font-bold text-foreground mt-0.5 block">---</span>
            </div>
            <div class="rounded-xl border border-border bg-background p-2.5">
              <span class="text-[10px] text-blue-600 dark:text-blue-400 font-medium block">Outbound</span>
              <span id="sub-an-outbound" class="text-base font-bold text-blue-500 mt-0.5 block">---</span>
            </div>
            <div class="rounded-xl border border-border bg-background p-2.5">
              <span class="text-[10px] text-purple-600 dark:text-purple-400 font-medium block">Saves</span>
              <span id="sub-an-saves" class="text-base font-bold text-purple-500 mt-0.5 block">---</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right 1 column: Recent Execution Logs Stream -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-foreground">Recent Activity Stream</h3>
        <a href="/scheduling/logs" class="text-xs font-medium text-primary hover:underline flex items-center gap-1">
          View all &rarr;
        </a>
      </div>

      <div id="command-logs-container">
        <div class="overflow-hidden rounded-2xl border border-border bg-card p-6 text-center text-xs text-muted-foreground animate-pulse">
          Loading operational stream...
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { requireAuth } from '../lib/auth';
  import { getDashboardKPIs, getPins, getLogs } from '../lib/supabase';
  import { renderStatusBadge, formatDate, formatTime, renderEmptyStateHTML, escapeHtml } from '../lib/ui-helpers';
  import { getActiveWorkspaceId } from '../lib/workspaces';

  async function init() {
    const isAuth = await requireAuth();
    if (!isAuth) return;
    await loadCommandCenter();
  }

  async function loadCommandCenter() {
    const activeWsId = getActiveWorkspaceId();
    const numFmt = new Intl.NumberFormat('en-US');

    // Rule R3 & GATE G4: Fault-isolated loading via Promise.allSettled
    const [p1Result, analyticsResult, compResult, paResult] = await Promise.allSettled([
      // P1: Scheduling & Auth DB
      Promise.all([
        getDashboardKPIs(activeWsId),
        getPins('all', undefined, activeWsId),
        getLogs(5, activeWsId),
      ]),
      // P3: Analytics DB (30D window)
      fetch(`/api/analytics/connections?window_days=30&workspace_id=${encodeURIComponent(activeWsId)}`).then(async (r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      }),
      // P2: Competitors DB
      fetch(`/api/admin/competitors?workspace_id=${encodeURIComponent(activeWsId)}`).then(async (r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      }),
      // PinArchive DB
      fetch(`/api/pinarchive/overview?workspace_id=${encodeURIComponent(activeWsId)}`).then(async (r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      }),
    ]);

    // 1. Render Module: Scheduling
    const schedVal = document.getElementById('metric-scheduling-val');
    const schedSub = document.getElementById('metric-scheduling-sub');
    const schedBadge = document.getElementById('metric-scheduling-badge');
    const subWbTotal = document.getElementById('sub-wb-total');
    const subWbActive = document.getElementById('sub-wb-active');
    const subWbExhausted = document.getElementById('sub-wb-exhausted');
    const pinsContainer = document.getElementById('command-pins-container');
    const logsContainer = document.getElementById('command-logs-container');

    if (p1Result.status === 'fulfilled') {
      const [kpis, recentPins, latestLogs] = p1Result.value;
      if (schedVal) schedVal.textContent = `${numFmt.format(kpis.pendingPins)} queued`;
      if (schedSub) schedSub.textContent = `${kpis.activeAccounts} accounts active • ${kpis.failedPins} failed`;
      if (schedBadge) schedBadge.textContent = `${kpis.activeWebhooks} / ${kpis.totalWebhooks} webhooks operational`;
      if (subWbTotal) subWbTotal.textContent = String(kpis.totalWebhooks ?? 0);
      if (subWbActive) subWbActive.textContent = String(kpis.activeWebhooks ?? 0);
      if (subWbExhausted) subWbExhausted.textContent = String(kpis.exhaustedWebhooks ?? 0);

      // Render Pins Queue
      if (pinsContainer) {
        if (!recentPins || recentPins.length === 0) {
          pinsContainer.innerHTML = renderEmptyStateHTML(
            'No Pins Found',
            'Pins uploaded via CSV or Google Sheets will appear in the active queue.',
            'inbox'
          );
        } else {
          const topPins = recentPins.slice(0, 5);
          const pinsHtml = topPins
            .map((pin) => `
              <div class="flex items-center justify-between p-3.5 transition-colors hover:bg-muted/40">
                <div class="flex items-center gap-3 min-w-0">
                  <img
                    src="${escapeHtml(pin.image_url)}"
                    alt="${escapeHtml(pin.title)}"
                    class="h-11 w-11 rounded-xl object-cover border border-border bg-muted flex-shrink-0"
                    onerror="this.src='https://images.unsplash.com/photo-1495521821757-a1efb6729352?auto=format&fit=crop&w=150&q=80'"
                  />
                  <div class="min-w-0 flex-1">
                    <p class="text-xs font-semibold text-foreground truncate">${escapeHtml(pin.title)}</p>
                    <div class="flex items-center gap-2 text-[11px] text-muted-foreground mt-0.5">
                      <span>${escapeHtml(pin.account_name || 'Account')}</span>
                      <span>•</span>
                      <span class="truncate">${escapeHtml(pin.board_name || 'No Board')}</span>
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-2.5 flex-shrink-0 ml-3">
                  ${renderStatusBadge(pin.status)}
                  <span class="text-[11px] text-muted-foreground hidden sm:inline">
                    ${formatDate(pin.created_at)}
                  </span>
                </div>
              </div>
            `)
            .join('');

          pinsContainer.innerHTML = `
            <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
              <div class="divide-y divide-border">
                ${pinsHtml}
              </div>
            </div>
          `;
        }
      }

      // Render Logs Activity Stream
      if (logsContainer) {
        if (!latestLogs || latestLogs.length === 0) {
          logsContainer.innerHTML = renderEmptyStateHTML(
            'No Recent Activity',
            'Activity events will stream here as pins publish.',
            'alert-circle'
          );
        } else {
          const logsHtml = latestLogs
            .map((log) => `
              <div class="rounded-xl border border-border bg-background p-3 text-xs space-y-1.5 shadow-sm">
                <div class="flex items-center justify-between">
                  ${renderStatusBadge(log.status, undefined, 'sm')}
                  <span class="text-[10px] text-muted-foreground font-mono">
                    ${formatTime(log.created_at)}
                  </span>
                </div>
                <p class="font-semibold text-foreground truncate">${escapeHtml(log.pin_title || 'System Operation')}</p>
                ${
                  log.message
                    ? `<p class="text-muted-foreground line-clamp-2 leading-relaxed text-[11px]">${escapeHtml(log.message)}</p>`
                    : ''
                }
              </div>
            `)
            .join('');

          logsContainer.innerHTML = `
            <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm p-4 space-y-3">
              ${logsHtml}
            </div>
          `;
        }
      }
    } else {
      // Degraded card state for Scheduling
      if (schedVal) schedVal.textContent = 'Degraded';
      if (schedSub) schedSub.textContent = 'Scheduling service unreachable';
      if (schedBadge) schedBadge.innerHTML = '<span class="text-rose-500 font-bold">Failed to load P1</span>';
    }

    // 2. Render Module: Analytics
    const anVal = document.getElementById('metric-analytics-val');
    const anSub = document.getElementById('metric-analytics-sub');
    const subAnClicks = document.getElementById('sub-an-clicks');
    const subAnOutbound = document.getElementById('sub-an-outbound');
    const subAnSaves = document.getElementById('sub-an-saves');

    if (analyticsResult.status === 'fulfilled' && analyticsResult.value.success) {
      const connections = analyticsResult.value.data || [];
      let totalImpr = 0, totalEng = 0, totalClicks = 0, totalOutbound = 0, totalSaves = 0;

      for (const conn of connections) {
        const s = conn.stats || {};
        totalImpr += Number(s.impressions || 0);
        totalEng += Number(s.engagements || 0);
        totalClicks += Number(s.pin_clicks || 0);
        totalOutbound += Number(s.outbound_clicks || 0);
        totalSaves += Number(s.saves || 0);
      }

      if (anVal) anVal.textContent = numFmt.format(totalImpr);
      if (anSub) anSub.textContent = `${numFmt.format(totalEng)} engagements • ${connections.length} connections`;
      if (subAnClicks) subAnClicks.textContent = numFmt.format(totalClicks);
      if (subAnOutbound) subAnOutbound.textContent = numFmt.format(totalOutbound);
      if (subAnSaves) subAnSaves.textContent = numFmt.format(totalSaves);
    } else {
      if (anVal) anVal.textContent = 'Degraded';
      if (anSub) anSub.textContent = 'Analytics pipeline unreachable';
      if (subAnClicks) subAnClicks.textContent = '—';
      if (subAnOutbound) subAnOutbound.textContent = '—';
      if (subAnSaves) subAnSaves.textContent = '—';
    }

    // 3. Render Module: Competitors
    const compVal = document.getElementById('metric-competitors-val');
    const compSub = document.getElementById('metric-competitors-sub');
    const compBadge = document.getElementById('metric-competitors-badge');

    if (compResult.status === 'fulfilled' && compResult.value.success) {
      const comps = compResult.value.competitors || [];
      const ownCount = comps.filter((c: any) => c.account_type === 'own').length;
      const compCount = comps.length - ownCount;

      if (compVal) compVal.textContent = `${comps.length} Profiles`;
      if (compSub) compSub.textContent = `${ownCount} own • ${compCount} competitor accounts`;
      if (compBadge) compBadge.textContent = `${comps.length} tracked profiles active`;
    } else {
      if (compVal) compVal.textContent = 'Degraded';
      if (compSub) compSub.textContent = 'Competitor engine unreachable';
    }

    // 4. Render Module: PinArchive
    const paVal = document.getElementById('metric-pinarchive-val');
    const paSub = document.getElementById('metric-pinarchive-sub');
    const paBadge = document.getElementById('metric-pinarchive-badge');

    if (paResult.status === 'fulfilled' && paResult.value.success) {
      const totals = paResult.value.totals || {};
      const pinsCount = totals.archived_pins ?? totals.total_pins ?? 0;
      const saves = totals.sum_saves ?? 0;
      const shares = totals.sum_shares ?? 0;

      if (paVal) paVal.textContent = `${numFmt.format(pinsCount)} Pins`;
      if (paSub) paSub.textContent = `${numFmt.format(saves)} saves • ${numFmt.format(shares)} shares`;
      if (paBadge) paBadge.textContent = `${totals.accounts || 0} creator archives`;
    } else {
      if (paVal) paVal.textContent = 'Degraded';
      if (paSub) paSub.textContent = 'PinArchive unreachable';
    }
  }

  init();
</script>
