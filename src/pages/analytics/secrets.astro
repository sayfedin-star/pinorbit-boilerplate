---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import SectionTabs from '../../components/ui/SectionTabs.astro';

export const prerender = false;

const analyticsTabs = [
  { label: 'Pinner Analytics', href: '/analytics' },
  { label: 'Ingest Secrets', href: '/analytics/secrets' },
];
---

<Layout title="Ingest Secrets — Pinterest Analytics" description="Manage global and workspace-scoped webhook ingestion secrets for Make.com scenarios.">
  <div class="max-w-4xl mx-auto space-y-6 pb-12">
    <!-- Page Header -->
    <div class="space-y-2">
      <SectionHeader
        title="Ingest Webhook Secrets"
        description="Secure authentication keys required by Make.com scenarios to dispatch data to PinOrbit ingestion pipelines."
      />
    </div>

    <SectionTabs tabs={analyticsTabs} activeHref="/analytics/secrets" />

    <!-- Active Secret Card -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <h3 class="text-base font-bold text-foreground">Active Ingest Secret</h3>
            <span id="secret-source-badge" class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-bold text-primary">
              Loading...
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-1">
            Pass this token in the <code class="font-mono text-[11px] font-bold text-foreground bg-muted/60 px-1 py-0.5 rounded">x-ingest-secret</code> header for all Make.com scenarios. On regeneration, previous secret remains valid for 300s grace period. After Regenerate → Sync both pipelines.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="open-regenerate-modal-btn"
            class="inline-flex items-center gap-2 rounded-xl bg-destructive/10 border border-destructive/20 px-3.5 py-2 text-xs font-bold text-destructive hover:bg-destructive/20 transition-all shadow-sm"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
              <path d="M16 21h5v-5"/>
            </svg>
            <span>🔄 Regenerate</span>
          </button>
        </div>
      </div>

      <!-- Secret Display Box -->
      <div class="flex items-center gap-3">
        <div class="relative flex-1">
          <input
            type="text"
            id="secret-display-input"
            readonly
            value="Loading secret..."
            class="w-full rounded-xl border border-border bg-muted/30 px-4 py-3 font-mono text-xs font-bold text-foreground focus:outline-none focus:ring-1 focus:ring-primary select-all"
          />
        </div>
        <button
          type="button"
          id="copy-secret-btn"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-card px-4 py-3 text-xs font-bold text-foreground hover:bg-muted transition-all shadow-sm active:scale-95"
        >
          <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span id="copy-btn-text">📋 Copy</span>
        </button>
        <button
          type="button"
          id="reveal-secret-btn"
          class="inline-flex items-center gap-1.5 rounded-xl border border-primary/30 bg-primary/10 px-4 py-3 text-xs font-bold text-primary hover:bg-primary/20 transition-all shadow-sm active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span>Reveal</span>
        </button>
      </div>

      <!-- Revealed secret transient box -->
      <div id="revealed-secret-box" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-emerald-700 dark:text-emerald-300">🔓 Revealed Secret (click outside to dismiss)</span>
          <button type="button" id="dismiss-reveal-btn" class="text-xs font-bold text-emerald-700 dark:text-emerald-300 hover:underline">✕ Dismiss</button>
        </div>
        <div class="flex items-center gap-2">
          <input
            type="text"
            id="revealed-secret-input"
            readonly
            value=""
            class="flex-1 rounded-lg border border-emerald-500/30 bg-white/50 dark:bg-black/20 px-3 py-2 font-mono text-xs font-bold text-emerald-800 dark:text-emerald-200 focus:outline-none select-all"
          />
          <button
            type="button"
            id="copy-revealed-btn"
            class="inline-flex items-center gap-1 rounded-lg border border-emerald-500/30 bg-emerald-500/20 px-3 py-2 text-xs font-bold text-emerald-700 dark:text-emerald-300 hover:bg-emerald-500/30 transition-all"
          >
            📋 Copy
          </button>
        </div>
      </div>

      <!-- Status alerts -->
      <div id="secrets-page-status" class="hidden rounded-xl p-3 text-xs font-semibold"></div>
    </div>

    <!-- Advanced Workspace Overrides Accordion -->
    <div class="rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
      <button
        type="button"
        id="toggle-advanced-btn"
        class="w-full flex items-center justify-between p-6 text-left hover:bg-muted/10 transition-colors"
      >
        <div>
          <h4 class="text-sm font-bold text-foreground">Advanced: Workspace Override Management</h4>
          <p class="text-xs text-muted-foreground mt-0.5">Generate a dedicated secret for this workspace or fall back to the global default.</p>
        </div>
        <svg id="advanced-chevron" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </button>

      <div id="advanced-section" class="hidden px-6 pb-6 pt-2 border-t border-border/60 space-y-4">
        <div class="text-xs text-muted-foreground">
          By default, all workspaces share the global ingest secret unless an override is created for tenant isolation.
        </div>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <button
            type="button"
            id="generate-override-btn"
            class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-bold text-foreground hover:bg-muted transition-all shadow-sm"
          >
            🔑 Generate Workspace Override
          </button>
          <button
            type="button"
            id="remove-override-btn"
            class="hidden rounded-xl border border-destructive/30 bg-destructive/10 px-4 py-2 text-xs font-bold text-destructive hover:bg-destructive/20 transition-all shadow-sm"
          >
            🗑️ Remove Workspace Override
          </button>
        </div>
      </div>
    </div>

    <!-- Verbatim Make.com Integration Instructions Card (F3) -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-8">
      <div class="flex items-center gap-3 border-b border-border pb-4">
        <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary font-bold">
          ⚡
        </div>
        <div>
          <h3 class="text-sm font-bold text-foreground">Make.com Scenario Configuration Instructions</h3>
          <p class="text-xs text-muted-foreground">Copy-paste ready values and expressions for Make.com webhook headers and modules.</p>
        </div>
      </div>

      <!-- SECTION 0: API ENDPOINT URLs (NEW, top of card) -->
      <div class="space-y-4 rounded-xl border border-border/80 bg-muted/20 p-5">
        <div class="flex items-center gap-2 border-b border-border/60 pb-3">
          <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold text-xs">0</span>
          <h4 class="text-xs font-bold text-foreground uppercase tracking-wider">API ENDPOINT URLs (Make.com HTTP module URL field)</h4>
        </div>

        <div class="space-y-4">
          <!-- Ingest Endpoint -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-bold text-foreground font-mono">INGEST ENDPOINT (use as URL in EVERY HTTP module, both scenarios):</label>
              <button
                type="button"
                class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                data-copy-target="ingest-endpoint-url"
              >
                📋 Copy
              </button>
            </div>
            <input
              id="ingest-endpoint-url"
              type="text"
              readonly
              value="https://pinorbit-v2.o-i.workers.dev/api/internal/pinterest/ingest"
              class="w-full rounded-xl border border-border bg-card px-3 py-2.5 font-mono text-xs text-foreground focus:outline-none select-all"
            />
            <p class="text-[10px] text-muted-foreground">
              Paste into the Make HTTP module URL field. Must begin with https://.
            </p>
          </div>

          <!-- Daily Dispatch Endpoint -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-bold text-foreground font-mono">DAILY DISPATCH (FastCron job URL — set automatically by Sync Schedule; shown for reference only):</label>
              <button
                type="button"
                class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                data-copy-target="daily-dispatch-url"
              >
                📋 Copy
              </button>
            </div>
            <input
              id="daily-dispatch-url"
              type="text"
              readonly
              value="https://pinorbit-v2.o-i.workers.dev/api/internal/pinterest/daily-dispatch"
              class="w-full rounded-xl border border-border bg-card px-3 py-2.5 font-mono text-xs text-foreground focus:outline-none select-all"
            />
            <p class="text-[10px] text-muted-foreground">
              Jobs authenticate with the same x-ingest-secret shown above. After Regenerate → Sync both pipelines.
            </p>
          </div>
        </div>
      </div>

      <!-- SECTION 1: REQUIRED HTTP HEADERS (keep as-is) -->
      <div class="space-y-3 rounded-xl border border-border/80 bg-muted/20 p-4">
        <h4 class="text-xs font-bold text-foreground uppercase tracking-wider">Required HTTP Headers (Both Scenarios)</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs font-mono">
          <div class="p-3 rounded-lg bg-card border border-border flex items-center justify-between">
            <div>
              <span class="text-muted-foreground block text-[10px] uppercase font-bold">Header Name:</span>
              <span class="text-foreground font-bold font-mono">x-ingest-secret</span>
            </div>
            <button
              type="button"
              class="copy-field-btn rounded-lg border border-border bg-muted/40 px-2 py-1 text-[11px] font-semibold hover:bg-muted transition-all"
              data-copy-text="x-ingest-secret"
            >
              📋 Copy
            </button>
          </div>
          <div class="p-3 rounded-lg bg-card border border-border flex items-center justify-between">
            <div class="overflow-hidden mr-2">
              <span class="text-muted-foreground block text-[10px] uppercase font-bold">Header Value:</span>
              <span id="instruction-secret-val" class="text-foreground font-bold font-mono truncate block">Loading...</span>
            </div>
            <button
              type="button"
              id="copy-header-val-btn"
              class="copy-field-btn shrink-0 rounded-lg border border-border bg-muted/40 px-2 py-1 text-[11px] font-semibold hover:bg-muted transition-all"
              data-copy-target="instruction-secret-val"
            >
              📋 Copy
            </button>
          </div>
        </div>
      </div>

      <!-- SECTION 2: ARCHITECTURE NOTE (NEW warning card) -->
      <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-xs text-amber-700 dark:text-amber-300">
        <div class="flex items-start gap-3">
          <span class="font-bold text-base">⚠️</span>
          <div class="space-y-1">
            <strong class="font-bold uppercase tracking-wider text-[11px]">Architecture Note:</strong>
            <p class="leading-relaxed">
              FastCron → Astro daily-dispatch computes start_date/end_date server-side.
              Make webhooks now RECEIVE concrete start_date, end_date, sort_modes and
              num_of_pins. Map them RAW. Do NOT compute dates inside Make. Do NOT use
              Iterator or Repeater. Router is used ONLY for conditional branching by
              sort mode.
            </p>
          </div>
        </div>
      </div>

      <!-- SECTION 3: SCENARIO A: USER ACCOUNT ANALYTICS -->
      <div class="space-y-4 rounded-xl border border-border/80 bg-muted/20 p-5">
        <div class="flex items-center justify-between border-b border-border/60 pb-3">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold text-xs">A</span>
            <h4 class="text-xs font-bold text-foreground uppercase tracking-wider">SCENARIO A: USER ACCOUNT ANALYTICS</h4>
          </div>
          <span class="rounded-full bg-blue-500/10 px-2.5 py-0.5 text-[10px] font-mono font-bold text-blue-600 dark:text-blue-400">
            /v5/user_account/analytics (GET)
          </span>
        </div>

        <div class="space-y-3">
          <h5 class="text-[11px] font-bold text-foreground uppercase">Pinterest module Query String (RAW mappings only):</h5>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
            <div class="p-3 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground block text-[10px] uppercase font-bold">Parameter:</span>
                <span class="text-foreground font-bold font-mono">start_date = 24.start_date</span>
              </div>
              <button
                type="button"
                class="copy-field-btn rounded-lg border border-border bg-muted/40 px-2 py-1 text-[11px] font-semibold hover:bg-muted transition-all"
                data-copy-text="24.start_date"
              >
                📋 Copy
              </button>
            </div>
            <div class="p-3 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground block text-[10px] uppercase font-bold">Parameter:</span>
                <span class="text-foreground font-bold font-mono">end_date = 24.end_date</span>
              </div>
              <button
                type="button"
                class="copy-field-btn rounded-lg border border-border bg-muted/40 px-2 py-1 text-[11px] font-semibold hover:bg-muted transition-all"
                data-copy-text="24.end_date"
              >
                📋 Copy
              </button>
            </div>
          </div>
        </div>

        <!-- HTTP Module Config -->
        <div class="space-y-2 pt-2 border-t border-border/40">
          <h5 class="text-[11px] font-bold text-foreground uppercase">HTTP module configuration:</h5>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs font-mono">
            <div class="p-2.5 rounded-lg bg-card border border-border">
              <span class="text-muted-foreground block text-[10px] uppercase font-bold">URL:</span>
              <span class="text-foreground font-bold font-mono text-[11px] truncate block">https://pinorbit-v2.o-i.workers.dev/api/internal/pinterest/ingest</span>
            </div>
            <div class="p-2.5 rounded-lg bg-card border border-border">
              <span class="text-muted-foreground block text-[10px] uppercase font-bold">Method:</span>
              <span class="text-foreground font-bold font-mono text-[11px]">POST</span>
            </div>
            <div class="p-2.5 rounded-lg bg-card border border-border">
              <span class="text-muted-foreground block text-[10px] uppercase font-bold">Header:</span>
              <span class="text-foreground font-bold font-mono text-[11px]">x-ingest-secret : &lt;secret&gt;</span>
            </div>
          </div>

          <div class="space-y-1.5 pt-2">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-bold text-foreground font-mono">Body envelope (verbatim):</label>
              <button
                type="button"
                class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                data-copy-target="scenario-a-envelope"
              >
                📋 Copy
              </button>
            </div>
            <textarea
              id="scenario-a-envelope"
              readonly
              rows="12"
              class="w-full rounded-xl border border-border bg-card p-3 font-mono text-xs text-foreground focus:outline-none select-all resize-none"
            >{`{
  "success": true,
  "request_id": "{{uuid}}",
  "connection_id": "{{24.connection_id}}",
  "channel": "account_analytics",
  "request_context": { "job_type": "{{24.job_type}}",
    "start_date": "{{24.start_date}}", "end_date": "{{24.end_date}}" },
  "account_analytics": {{2.body}},
  "top_pins_analytics": null,
  "error_details": null
}`}</textarea>
          </div>
        </div>
      </div>

      <!-- SECTION 4: SCENARIO B: TOP 50 PINS (ROUTER DESIGN) -->
      <div class="space-y-5 rounded-xl border border-border/80 bg-muted/20 p-5">
        <div class="flex items-center justify-between border-b border-border/60 pb-3">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 font-bold text-xs">B</span>
            <h4 class="text-xs font-bold text-foreground uppercase tracking-wider">SCENARIO B: TOP 50 PINS (ROUTER DESIGN)</h4>
          </div>
          <span class="rounded-full bg-purple-500/10 px-2.5 py-0.5 text-[10px] font-mono font-bold text-purple-600 dark:text-purple-400">
            Router Conditional Branching
          </span>
        </div>

        <!-- Flow line -->
        <div class="p-3 rounded-lg bg-card border border-border text-xs font-mono">
          <span class="text-muted-foreground block text-[10px] uppercase font-bold">Flow Line:</span>
          <span class="text-foreground font-bold">Webhook (24) → Router → 5 routes → [Pinterest → HTTP] each.</span>
        </div>

        <!-- 5 Router Filters -->
        <div class="space-y-2">
          <h5 class="text-[11px] font-bold text-foreground uppercase">Router filters (verbatim, NO [] suffix):</h5>
          <div class="space-y-1.5 font-mono text-xs">
            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground text-[10px] uppercase font-bold mr-2">Route 1:</span>
                <span class="text-foreground font-bold">24.sort_modes</span>
                <span class="text-muted-foreground mx-1.5">Array operators: Contains</span>
                <span class="text-primary font-bold">IMPRESSION</span>
              </div>
              <button
                type="button"
                class="copy-field-btn rounded-md border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-semibold hover:bg-muted transition-all"
                data-copy-text="24.sort_modes"
              >
                📋 Copy
              </button>
            </div>

            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground text-[10px] uppercase font-bold mr-2">Route 2:</span>
                <span class="text-foreground font-bold">24.sort_modes</span>
                <span class="text-muted-foreground mx-1.5">Array operators: Contains</span>
                <span class="text-primary font-bold">OUTBOUND_CLICK</span>
              </div>
              <button
                type="button"
                class="copy-field-btn rounded-md border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-semibold hover:bg-muted transition-all"
                data-copy-text="24.sort_modes"
              >
                📋 Copy
              </button>
            </div>

            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground text-[10px] uppercase font-bold mr-2">Route 3:</span>
                <span class="text-foreground font-bold">24.sort_modes</span>
                <span class="text-muted-foreground mx-1.5">Array operators: Contains</span>
                <span class="text-primary font-bold">SAVE</span>
              </div>
              <button
                type="button"
                class="copy-field-btn rounded-md border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-semibold hover:bg-muted transition-all"
                data-copy-text="24.sort_modes"
              >
                📋 Copy
              </button>
            </div>

            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground text-[10px] uppercase font-bold mr-2">Route 4:</span>
                <span class="text-foreground font-bold">24.sort_modes</span>
                <span class="text-muted-foreground mx-1.5">Array operators: Contains</span>
                <span class="text-primary font-bold">ENGAGEMENT</span>
              </div>
              <button
                type="button"
                class="copy-field-btn rounded-md border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-semibold hover:bg-muted transition-all"
                data-copy-text="24.sort_modes"
              >
                📋 Copy
              </button>
            </div>

            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground text-[10px] uppercase font-bold mr-2">Route 5:</span>
                <span class="text-foreground font-bold">24.sort_modes</span>
                <span class="text-muted-foreground mx-1.5">Array operators: Contains</span>
                <span class="text-primary font-bold">PIN_CLICK</span>
              </div>
              <button
                type="button"
                class="copy-field-btn rounded-md border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-semibold hover:bg-muted transition-all"
                data-copy-text="24.sort_modes"
              >
                📋 Copy
              </button>
            </div>
          </div>
        </div>

        <!-- Per-Route Pinterest Module Parameters -->
        <div class="space-y-2 pt-2 border-t border-border/40">
          <h5 class="text-[11px] font-bold text-foreground uppercase">Per-route Pinterest module Query String (RAW mappings only):</h5>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground block text-[10px] uppercase font-bold">Parameter:</span>
                <span class="text-foreground font-bold">start_date = 24.start_date</span>
              </div>
              <button type="button" class="copy-field-btn rounded-md border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-semibold hover:bg-muted" data-copy-text="24.start_date">📋 Copy</button>
            </div>

            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground block text-[10px] uppercase font-bold">Parameter:</span>
                <span class="text-foreground font-bold">end_date = 24.end_date</span>
              </div>
              <button type="button" class="copy-field-btn rounded-md border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-semibold hover:bg-muted" data-copy-text="24.end_date">📋 Copy</button>
            </div>

            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground block text-[10px] uppercase font-bold">Parameter:</span>
                <span class="text-foreground font-bold">sort_by = &lt;HARDCODED literal of route&gt;</span>
              </div>
              <span class="text-[10px] text-muted-foreground">e.g. ENGAGEMENT</span>
            </div>

            <div class="p-2.5 rounded-lg bg-card border border-border flex items-center justify-between">
              <div>
                <span class="text-muted-foreground block text-[10px] uppercase font-bold">Parameter:</span>
                <span class="text-foreground font-bold">num_of_pins = 24.num_of_pins</span>
              </div>
              <button type="button" class="copy-field-btn rounded-md border border-border bg-muted/40 px-2 py-0.5 text-[10px] font-semibold hover:bg-muted" data-copy-text="24.num_of_pins">📋 Copy</button>
            </div>
          </div>
        </div>

        <!-- Per-Route HTTP Module -->
        <div class="space-y-2 pt-2 border-t border-border/40">
          <h5 class="text-[11px] font-bold text-foreground uppercase">Per-route HTTP module (same URL/header; envelope with top_pins):</h5>
          <div class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-bold text-foreground font-mono">Body envelope (verbatim):</label>
              <button
                type="button"
                class="copy-field-btn rounded-lg border border-border bg-card px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-muted transition-all"
                data-copy-target="scenario-b-envelope"
              >
                📋 Copy
              </button>
            </div>
            <textarea
              id="scenario-b-envelope"
              readonly
              rows="12"
              class="w-full rounded-xl border border-border bg-card p-3 font-mono text-xs text-foreground focus:outline-none select-all resize-none"
            >{`{
  "success": true,
  "request_id": "{{uuid}}",
  "connection_id": "{{24.connection_id}}",
  "channel": "top_pins",
  "request_context": { "job_type": "{{24.job_type}}",
    "start_date": "{{24.start_date}}", "end_date": "{{24.end_date}}" },
  "account_analytics": null,
  "top_pins_analytics": {{<this route's Pinterest module id>.body}},
  "error_details": null
}`}</textarea>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Double Confirmation Hard Gate Modal for Secret Regeneration (Mandatory B5) -->
  <div id="regenerate-confirm-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-background/80 backdrop-blur-sm p-4">
    <div class="w-full max-w-md rounded-2xl border border-destructive/30 bg-card p-6 shadow-2xl space-y-4">
      <div class="flex items-center gap-3 text-destructive">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-destructive/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-foreground">Rotate Ingest Secret?</h3>
          <span class="text-xs text-destructive font-semibold">Immediate Invalidation (No Grace Period)</span>
        </div>
      </div>

      <!-- Warning Gate 1 -->
      <div class="rounded-xl bg-destructive/10 p-3 text-xs text-destructive space-y-1.5">
        <p class="font-bold">⚠️ Warning: Make.com scenarios will reject requests until you paste the new value into the x-ingest-secret header (both scenarios).</p>
      </div>

      <!-- Impact Notice -->
      <p class="text-xs text-muted-foreground">
        Rotating this secret immediately invalidates the current secret. Active Make.com scenario webhooks will fail until updated.
      </p>

      <!-- Confirmation Input Gate 2 -->
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold text-foreground">
          Type <span class="font-mono font-bold text-destructive">REGENERATE</span> to confirm rotation:
        </label>
        <input
          type="text"
          id="confirm-type-input"
          placeholder="REGENERATE"
          class="w-full rounded-xl border border-destructive/40 bg-card px-3 py-2 text-xs text-foreground font-mono focus:border-destructive focus:outline-none"
        />
      </div>

      <!-- Modal Actions -->
      <div class="flex items-center justify-end gap-2 pt-2">
        <button
          type="button"
          id="cancel-regenerate-modal-btn"
          class="rounded-xl border border-border bg-card px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all"
        >
          Cancel
        </button>
        <button
          type="button"
          id="execute-regenerate-btn"
          disabled
          class="rounded-xl bg-destructive px-4 py-2 text-xs font-bold text-destructive-foreground hover:bg-destructive/90 transition-all disabled:opacity-40 disabled:cursor-not-allowed"
        >
          Confirm Rotation
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Inlined full safeFetchJson for zero-dependency browser reliability
  async function safeFetchJson(input, init) {
    var res = await fetch(input, init);
    if (res.status === 401 || res.status === 403) {
      if (typeof window !== 'undefined') {
        window.location.href = '/login';
      }
      throw new Error('HTTP ' + res.status + ': Unauthorized or forbidden. Redirecting to login.');
    }
    if (res.status === 404) {
      throw new Error('HTTP 404: Endpoint unavailable - redeploy required');
    }
    var contentType = res.headers.get('content-type') || '';
    if (!contentType.includes('application/json')) {
      throw new Error('HTTP ' + res.status + ': Server returned non-JSON response (' + (contentType || 'empty') + ')');
    }
    var data = await res.json();
    if (!res.ok) {
      var errorMsg = (data && (data.error || data.message)) || res.statusText || 'Request failed';
      throw new Error('HTTP ' + res.status + ': ' + errorMsg);
    }
    return data;
  }

  var currentSecret = '';
  var currentSource = '';
  var hasOverride = false;

  async function fetchSecrets() {
    try {
      var json = await safeFetchJson('/api/analytics/secrets');
      if (json.success) {
        currentSecret = json.masked || '********';
        currentSource = json.source || 'global';
        hasOverride = Boolean(json.hasOverride);

        var input = document.getElementById('secret-display-input');
        if (input) input.value = currentSecret;

        var instructionVal = document.getElementById('instruction-secret-val');
        if (instructionVal) instructionVal.textContent = currentSecret;

        var badge = document.getElementById('secret-source-badge');
        if (badge) {
          if (currentSource === 'workspace') {
            badge.className = 'rounded-full bg-purple-500/10 px-2.5 py-0.5 text-xs font-bold text-purple-600 dark:text-purple-400';
            badge.textContent = 'Workspace Override';
          } else if (currentSource === 'global') {
            badge.className = 'rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-bold text-emerald-600 dark:text-emerald-400';
            badge.textContent = 'Global Secret';
          } else {
            badge.className = 'rounded-full bg-blue-500/10 px-2.5 py-0.5 text-xs font-bold text-blue-600 dark:text-blue-400';
            badge.textContent = 'Environment Fallback';
          }
        }

        var removeBtn = document.getElementById('remove-override-btn');
        if (removeBtn) {
          if (hasOverride) removeBtn.classList.remove('hidden');
          else removeBtn.classList.add('hidden');
        }
      } else {
        showStatus('Failed to load secret: ' + json.error, 'error');
      }
    } catch (e) {
      showStatus(e.message || 'Error loading secrets', 'error');
    }
  }

  function showStatus(msg, type) {
    if (type === undefined) type = 'success';
    var el = document.getElementById('secrets-page-status');
    if (!el) return;
    el.classList.remove('hidden');
    if (type === 'success') {
      el.className = 'rounded-xl bg-emerald-500/10 p-3 text-xs font-semibold text-emerald-600 dark:text-emerald-400';
    } else {
      el.className = 'rounded-xl bg-destructive/10 p-3 text-xs font-semibold text-destructive';
    }
    el.textContent = msg;
  }

  // Copy Secret Button
  var copyBtn = document.getElementById('copy-secret-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async function () {
      if (!currentSecret) return;
      try {
        await navigator.clipboard.writeText(currentSecret);
        var textSpan = document.getElementById('copy-btn-text');
        if (textSpan) textSpan.textContent = '✅ Copied!';
        setTimeout(function () {
          if (textSpan) textSpan.textContent = '📋 Copy';
        }, 2000);
      } catch (err) {
        showStatus('Failed to copy to clipboard', 'error');
      }
    });
  }

  // Generic Field Copy Buttons Listener
  document.querySelectorAll('.copy-field-btn').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var button = btn;
      var textToCopy = button.getAttribute('data-copy-text');
      var targetId = button.getAttribute('data-copy-target');

      if (!textToCopy && targetId) {
        var targetEl = document.getElementById(targetId);
        if (targetEl) {
          if ('value' in targetEl) {
            textToCopy = targetEl.value;
          } else {
            textToCopy = targetEl.textContent || '';
          }
        }
      }

      if (textToCopy) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          var originalText = button.textContent;
          button.textContent = '✅ Copied!';
          setTimeout(function () {
            button.textContent = originalText;
          }, 2000);
        } catch (e) {
          console.error('Clipboard copy failed:', e);
        }
      }
    });
  });

  // Advanced Accordion Toggle
  var toggleAdvancedBtn = document.getElementById('toggle-advanced-btn');
  var advancedSection = document.getElementById('advanced-section');
  var advancedChevron = document.getElementById('advanced-chevron');
  if (toggleAdvancedBtn && advancedSection) {
    toggleAdvancedBtn.addEventListener('click', function () {
      var isHidden = advancedSection.classList.contains('hidden');
      if (isHidden) {
        advancedSection.classList.remove('hidden');
        if (advancedChevron) advancedChevron.classList.add('rotate-180');
      } else {
        advancedSection.classList.add('hidden');
        if (advancedChevron) advancedChevron.classList.remove('rotate-180');
      }
    });
  }

  // Double Confirmation Gate for Regeneration
  var modal = document.getElementById('regenerate-confirm-modal');
  var openModalBtn = document.getElementById('open-regenerate-modal-btn');
  var closeModalBtn = document.getElementById('cancel-regenerate-modal-btn');
  var confirmInput = document.getElementById('confirm-type-input');
  var executeBtn = document.getElementById('execute-regenerate-btn');

  function openRegenerateModal() {
    if (confirmInput) confirmInput.value = '';
    if (executeBtn) executeBtn.disabled = true;
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeRegenerateModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  if (openModalBtn) openModalBtn.addEventListener('click', openRegenerateModal);
  if (closeModalBtn) closeModalBtn.addEventListener('click', closeRegenerateModal);

  // Gate 2 Input Listener: Enables execute button only when REGENERATE is typed
  if (confirmInput && executeBtn) {
    confirmInput.addEventListener('input', function (e) {
      var val = e.target.value.trim().toUpperCase();
      executeBtn.disabled = (val !== 'REGENERATE');
    });
  }

  // Execute Rotation Handler
  if (executeBtn) {
    executeBtn.addEventListener('click', async function () {
      if (confirmInput && confirmInput.value.trim().toUpperCase() !== 'REGENERATE') return;
      executeBtn.textContent = 'Rotating...';
      executeBtn.disabled = true;

      try {
        var scope = hasOverride ? 'workspace' : 'global';
        var json = await safeFetchJson('/api/analytics/secrets/regenerate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ scope: scope }),
        });
        if (json.success) {
          closeRegenerateModal();
          showStatus(json.message || 'Secret successfully rotated.', 'success');
          await fetchSecrets();
        } else {
          showStatus('Rotation failed: ' + (json.error || 'Unknown error'), 'error');
        }
      } catch (err) {
        showStatus(err.message || 'Rotation error', 'error');
      } finally {
        executeBtn.textContent = 'Confirm Rotation';
      }
    });
  }

  // Generate Workspace Override
  var genOverrideBtn = document.getElementById('generate-override-btn');
  if (genOverrideBtn) {
    genOverrideBtn.addEventListener('click', async function () {
      if (!confirm('Generate a workspace-specific override secret? This will isolate this workspace from the global secret.')) {
        return;
      }
      try {
        var json = await safeFetchJson('/api/analytics/secrets/regenerate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ scope: 'workspace' }),
        });
        if (json.success) {
          showStatus('Workspace override secret generated.', 'success');
          await fetchSecrets();
        } else {
          showStatus('Error: ' + json.error, 'error');
        }
      } catch (err) {
        showStatus(err.message || 'Override error', 'error');
      }
    });
  }

  // Remove Workspace Override
  var removeOverrideBtn = document.getElementById('remove-override-btn');
  if (removeOverrideBtn) {
    removeOverrideBtn.addEventListener('click', async function () {
      if (!confirm('Remove workspace override and revert back to global secret?')) {
        return;
      }
      try {
        var json = await safeFetchJson('/api/analytics/secrets/remove-override', {
          method: 'POST',
        });
        if (json.success) {
          showStatus(json.message, 'success');
          await fetchSecrets();
        } else {
          showStatus('Error: ' + json.error, 'error');
        }
      } catch (err) {
        showStatus(err.message || 'Remove override error', 'error');
      }
    });
  }

  // Reveal Secret Button (admin-only)
  var revealBtn = document.getElementById('reveal-secret-btn');
  if (revealBtn) {
    revealBtn.addEventListener('click', async function () {
      try {
        var res = await fetch('/api/secrets/reveal', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ workspace_id: window.activeWorkspaceId })
        });
        var data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to reveal secret');
        }
        var revealedBox = document.getElementById('revealed-secret-box');
        var revealedInput = document.getElementById('revealed-secret-input');
        if (revealedBox && revealedInput) {
          revealedInput.value = data.secret;
          revealedBox.classList.remove('hidden');
        }
      } catch (e) {
        showStatus(e.message || 'Failed to reveal secret', 'error');
      }
    });
  }

  // Dismiss revealed secret box
  var dismissBtn = document.getElementById('dismiss-reveal-btn');
  if (dismissBtn) {
    dismissBtn.addEventListener('click', function () {
      var revealedBox = document.getElementById('revealed-secret-box');
      if (revealedBox) revealedBox.classList.add('hidden');
    });
  }

  // Copy revealed secret
  var copyRevealedBtn = document.getElementById('copy-revealed-btn');
  if (copyRevealedBtn) {
    copyRevealedBtn.addEventListener('click', async function () {
      var revealedInput = document.getElementById('revealed-secret-input');
      if (!revealedInput) return;
      try {
        await navigator.clipboard.writeText(revealedInput.value);
        copyRevealedBtn.textContent = '✓ Copied';
        setTimeout(function () { copyRevealedBtn.textContent = '📋 Copy'; }, 1500);
      } catch (e) {
        showStatus('Failed to copy', 'error');
      }
    });
  }

  // Initial Load
  fetchSecrets();
</script>
