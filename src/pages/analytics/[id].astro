  <!-- PANEL 3: PIN INTELLIGENCE (V26.1 + V36 PRO UX) -->
  <section id="panel-intel" role="tabpanel" aria-labelledby="tab-intel" hidden class="space-y-6">
    <div class="rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
      <!-- Section Header -->
      <div class="flex flex-col gap-4 border-b border-border p-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 id="intel-title" class="text-base font-bold text-foreground">{accountName} — Pin Intelligence</h2>
          <p class="text-xs text-muted-foreground">Aggregated lifetime pin performance strictly scoped per ranking sort mode (Zero duplication)</p>
        </div>

        <!-- Sort Mode Tabs -->
        <div class="flex flex-wrap items-center gap-1.5 rounded-xl border border-border bg-muted/40 p-1" id="intel-sort-tabs">
          <button data-intel-sort="IMPRESSION" class="mode-tab active rounded-lg bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground shadow-sm transition-all">Impressions</button>
          <button data-intel-sort="OUTBOUND_CLICK" class="mode-tab rounded-lg px-3 py-1 text-xs font-semibold text-muted-foreground transition-all hover:text-foreground">Outbound Clicks</button>
