              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-intel-col="total_outbound_clicks">Outbound Clicks <span class="sort-icon font-bold"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-intel-col="total_pin_clicks">Pin Clicks <span class="sort-icon font-bold"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-intel-col="total_saves">Saves <span class="sort-icon font-bold"></span></th>
              <th class="py-3 px-4 text-right cursor-pointer hover:text-primary transition-colors select-none" data-intel-col="last_seen">Last Seen <span class="sort-icon font-bold"></span></th>
              <th class="py-3 px-4 text-center select-none" data-intel-col="trend">Trend</th>
            </tr>
          </thead>
          <tbody id="intel-leaderboard-tbody" class="divide-y divide-border [&>tr:nth-child(even)]:bg-muted/5">
            <tr>
              <td colspan="11" class="py-12 text-center text-muted-foreground">
                Loading pin intelligence leaderboard...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      <div id="intel-pagination" class="flex flex-wrap items-center justify-between gap-3 p-4 border-t border-border bg-muted/10 text-xs">
        <div class="text-muted-foreground flex items-center gap-3">
          <span>Showing <span id="intel-range" class="font-medium text-foreground">0-0</span> of <span id="intel-total" class="font-medium text-foreground">0</span> pins</span>
          <label class="text-xs font-semibold text-muted-foreground flex items-center gap-1.5">
            Show:
            <select id="intel-ps" class="rounded-lg border border-border bg-card px-2 py-0.5 text-xs text-foreground focus:outline-none focus:border-primary">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </label>
        </div>
        <div class="flex gap-1" id="intel-page-buttons"></div>
      </div>
    </div>

    <!-- Sliding Pin Timeline Drawer (Pro UX V38) -->
    <div id="intel-drawer-backdrop" class="fixed inset-0 z-40 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"></div>
    <div
      id="intel-timeline-drawer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="drawer-pin-title"
      class="fixed top-0 right-0 z-50 h-full w-full md:max-w-3xl bg-card border-l border-border shadow-2xl transform translate-x-full transition-transform duration-300 overflow-y-auto flex flex-col"
    >
      <!-- Drawer Header -->
      <div class="p-4 sm:p-5 border-b border-border flex items-start justify-between gap-4 sticky top-0 bg-card z-20 shadow-sm">
        <div class="flex items-center gap-3 min-w-0">
          <img id="drawer-pin-image" src="" alt="" class="w-12 h-12 rounded-xl object-cover border border-border shrink-0 hidden" />
          <div class="min-w-0 space-y-1">
            <h3 id="drawer-pin-title" class="text-sm font-bold text-foreground truncate">Pin Timeline</h3>
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <div class="inline-flex items-center gap-1 font-mono text-muted-foreground bg-muted/50 px-2 py-0.5 rounded border border-border/60">
                <span>ID: <span id="drawer-pin-id"></span></span>
                <button
                  type="button"
                  id="drawer-copy-id-btn"
                  title="Copy Pin ID"
                  class="text-muted-foreground hover:text-foreground transition-colors p-0.5"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                </button>
              </div>
              <a id="drawer-pin-link" href="#" target="_blank" rel="noopener noreferrer" class="text-xs text-primary hover:underline font-semibold inline-flex items-center gap-0.5">
                <span>Pinterest</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <!-- Drawer Range Presets -->
          <div id="drawer-range-presets" class="flex items-center rounded-xl border border-border bg-muted/40 p-0.5 text-xs">
            <button type="button" data-drawer-days="30" class="drawer-preset-btn rounded-lg px-2 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">30D</button>
            <button type="button" data-drawer-days="90" class="drawer-preset-btn active rounded-lg bg-primary px-2 py-0.5 text-xs font-semibold text-primary-foreground shadow-sm transition-all">90D</button>
            <button type="button" data-drawer-days="180" class="drawer-preset-btn rounded-lg px-2 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">180D</button>
          </div>

          <!-- Close Button -->
          <button
            type="button"
            id="intel-drawer-close"
            aria-label="Close drawer"
            class="p-1.5 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
      </div>

      <!-- Drawer Body -->
      <div id="drawer-main-content" class="p-4 sm:p-5 space-y-6 flex-1">
        <!-- Section Header for Stat Cards with Window Scope Notice -->
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Performance Overview</h4>
          <span id="drawer-window-notice" class="text-[11px] font-medium text-muted-foreground">Leaderboard Totals (30D)</span>
        </div>

        <!-- R1: 8 KPI Stat Cards Grid (Two rows of four) -->
        <div id="drawer-stat-cards-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <!-- Rendered dynamically by pin-intelligence.ts -->
        </div>

        <!-- F2: Performance Trend Sparkline Card -->
        <div class="rounded-xl border border-border bg-card p-4 shadow-sm space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/50 pb-2.5">
            <div>
              <div class="flex items-center gap-1.5">
                <h4 id="drawer-chart-title" class="text-xs font-bold text-foreground uppercase tracking-wider">Performance Trend</h4>
                <span id="drawer-chart-subtitle" class="text-[11px] text-muted-foreground"></span>
              </div>
            </div>

            <!-- Metric Switcher Chips -->
            <div id="drawer-metric-chips" class="flex flex-wrap items-center gap-1">
              <!-- Rendered by pin-intelligence.ts -->
            </div>
          </div>

          <!-- Sparkline Chart Container with Edge Badges and Tooltip -->
          <div class="relative w-full">
            <div class="flex items-center justify-between text-[10px] font-mono text-muted-foreground mb-1">
              <span id="drawer-chart-min-label"></span>
              <span id="drawer-chart-latest-badge" class="font-bold text-foreground bg-muted px-2 py-0.5 rounded-full"></span>
            </div>

            <!-- SVG Container -->
            <div id="drawer-sparkline-container" class="relative w-full h-28 bg-muted/10 rounded-lg p-2 flex items-center justify-center">
              <!-- Rendered by pin-intelligence.ts -->
            </div>

            <!-- Absolutely Positioned Rich Tooltip -->
            <div
              id="drawer-chart-tooltip"
              class="hidden absolute z-30 pointer-events-none rounded-lg border border-border bg-popover/95 px-2.5 py-1 text-[11px] font-semibold text-popover-foreground shadow-lg backdrop-blur-sm transform -translate-x-1/2 -translate-y-full mb-2 whitespace-nowrap transition-all duration-75"
            ></div>
          </div>
        </div>

        <!-- F3 & F4: Timeline History Table (Sticky Header Opaque Fix) -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <h4 class="text-xs font-bold text-foreground">Timeline History</h4>
              <span class="text-[11px] text-muted-foreground">Chronological snapshots</span>
            </div>

            <!-- Timeline CSV Export Button -->
            <button
              type="button"
              id="drawer-export-csv-btn"
              class="rounded-lg border border-border bg-card px-2.5 py-1 text-xs font-semibold text-foreground hover:bg-muted transition-all shadow-sm flex items-center gap-1.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Export History CSV</span>
            </button>
          </div>

          <!-- F3: Single Scroll Container with Sticky Opaque th -->
          <div class="relative max-h-[420px] overflow-y-auto rounded-xl border border-border bg-card">
            <table class="w-full text-xs">
              <thead>
                <tr>
                  <th class="sticky top-0 z-10 bg-card px-3 py-2 text-left font-bold text-muted-foreground shadow-[inset_0_-1px_0_theme(colors.border)]">DATE</th>
                  <th class="sticky top-0 z-10 bg-card px-3 py-2 text-center font-bold text-muted-foreground shadow-[inset_0_-1px_0_theme(colors.border)]">RANK</th>
                  <th class="sticky top-0 z-10 bg-card px-3 py-2 text-right font-bold text-muted-foreground shadow-[inset_0_-1px_0_theme(colors.border)]">IMPRESSIONS</th>
                  <th class="sticky top-0 z-10 bg-card px-3 py-2 text-right font-bold text-muted-foreground shadow-[inset_0_-1px_0_theme(colors.border)]">ENGAGEMENTS</th>
                  <th class="sticky top-0 z-10 bg-card px-3 py-2 text-right font-bold text-muted-foreground shadow-[inset_0_-1px_0_theme(colors.border)]">OUTBOUND CLICKS</th>
                  <th class="sticky top-0 z-10 bg-card px-3 py-2 text-right font-bold text-muted-foreground shadow-[inset_0_-1px_0_theme(colors.border)]">PIN CLICKS</th>
                  <th class="sticky top-0 z-10 bg-card px-3 py-2 text-right font-bold text-muted-foreground shadow-[inset_0_-1px_0_theme(colors.border)]">SAVES</th>
                </tr>
              </thead>
              <tbody id="drawer-history-tbody" class="divide-y divide-border/50">
                <!-- Rendered by pin-intelligence.ts -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Drawer Loading Skeleton / Error / Empty States -->
      <div id="drawer-state-container" class="hidden p-8 flex-1 flex flex-col items-center justify-center text-center"></div>
    </div>
  </section>

  <!-- PANEL 4: DATA PURGE (V27) -->
  <section id="panel-purge" role="tabpanel" aria-labelledby="tab-purge" hidden class="space-y-6">
    <!-- Warning Banner (Documenting D1-D5 Data Purge Lifecycle) -->
    <div class="rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4 text-xs text-amber-600 dark:text-amber-400 flex items-start gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div class="space-y-1">
        <h3 class="font-bold text-sm">Permanent Data Deletion & Audit Trail</h3>
        <p class="text-[11px] leading-relaxed">
          Deletes are permanent and removed from the database. Ingestion run history is kept for audit.
        </p>
        <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px]">
          <div class="rounded-lg bg-background/60 p-2 border border-amber-500/20" title="D3 (daily_workspace_metrics): Recalculated atomically from remaining active connections">
            <strong class="font-bold text-foreground">D3 Workspace Rollups:</strong> <code class="font-mono bg-muted px-1 py-0.5 rounded text-[10px]">daily_workspace_metrics</code> are atomically recalculated & rebuilt across all remaining connection data for the purged range.
          </div>
          <div class="rounded-lg bg-background/60 p-2 border border-amber-500/20" title="D5 (url_performance_history): Purged when Top Pins target is selected">
            <strong class="font-bold text-foreground">D5 URL Performance:</strong> <code class="font-mono bg-muted px-1 py-0.5 rounded text-[10px]">url_performance_history</code> records for the selected period are permanently deleted alongside Top Pins snapshots.
          </div>
        </div>
      </div>
    </div>

    <!-- Status Message Banner -->
    <div id="purge-status-msg" class="hidden"></div>

    <!-- Main Purge Configuration Card -->
    <div class="rounded-2xl border border-border bg-card p-6 shadow-sm space-y-6">
      <header>
        <h3 class="text-sm font-bold text-foreground">Purge Analytics Data for {accountName}</h3>
        <p class="text-xs text-muted-foreground mt-0.5">Select purge targets and date range to preview and delete records.</p>
      </header>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Group 1: Targets -->
        <div class="space-y-3 rounded-xl border border-border bg-muted/10 p-4">
          <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground block">1. Purge Targets</span>
          <div class="space-y-2">
            <label class="flex items-center gap-2.5 text-xs font-medium cursor-pointer">
              <input type="checkbox" id="purge-target-daily" checked class="rounded border-border text-primary focus:ring-primary h-4 w-4" />
              <span>Daily Account Metrics & Summaries (<code class="font-mono text-[11px]">account_analytics_daily</code>)</span>
            </label>
            <label class="flex items-center gap-2.5 text-xs font-medium cursor-pointer">
              <input type="checkbox" id="purge-target-top-pins" checked class="rounded border-border text-primary focus:ring-primary h-4 w-4" />
              <span>Ranked Top Pins & URL History (<code class="font-mono text-[11px]">top_pins_snapshots</code>)</span>
            </label>
          </div>
        </div>

        <!-- Group 2: Range -->
        <div class="space-y-3 rounded-xl border border-border bg-muted/10 p-4">
          <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground block">2. Date Scope (Max 90 Days)</span>
          <div class="flex items-center gap-4 text-xs font-medium">
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="radio" name="purge-mode" id="purge-mode-single" class="text-primary focus:ring-primary" />
              <span>Single Day</span>
            </label>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="radio" name="purge-mode" id="purge-mode-range" checked class="text-primary focus:ring-primary" />
              <span>Date Range</span>
            </label>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1">
            <div>
              <label for="purge-from" class="text-[11px] font-semibold text-muted-foreground block mb-1">From Date</label>
              <input type="date" id="purge-from" class="w-full rounded-xl border border-border bg-background px-3 py-1.5 text-xs focus:border-primary focus:outline-none" />
            </div>
            <div id="purge-to-container">
              <label for="purge-to" class="text-[11px] font-semibold text-muted-foreground block mb-1">To Date</label>
              <input type="date" id="purge-to" class="w-full rounded-xl border border-border bg-background px-3 py-1.5 text-xs focus:border-primary focus:outline-none" />
            </div>
          </div>
        </div>
      </div>

      <!-- Group 3: Actions -->
      <div class="pt-2">
        <button id="purge-preview-btn" class="rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground hover:bg-primary/90 shadow-sm transition-all">
          Preview Purge
        </button>
      </div>

      <!-- Preview Results Breakdown Card -->
      <div id="purge-preview-card" class="hidden rounded-xl border border-border bg-muted/20 p-5 space-y-4">
        <div class="flex items-center justify-between">
          <h4 class="text-xs font-bold uppercase tracking-wider text-foreground">Purge Impact Preview</h4>
          <span id="purge-preview-total" class="rounded-md bg-amber-500/10 px-2 py-0.5 text-xs font-bold text-amber-600 dark:text-amber-400"></span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead class="border-b border-border text-[11px] uppercase tracking-wider text-muted-foreground">
              <tr>
                <th class="py-2 px-3">Affected Database Table</th>
                <th class="py-2 px-3 text-right">Records to Delete</th>
              </tr>
            </thead>
            <tbody id="purge-preview-tbody" class="divide-y divide-border"></tbody>
          </table>
        </div>

        <div id="purge-preview-rollups" class="text-xs text-muted-foreground border-t border-border/50 pt-2.5"></div>
      </div>

      <!-- Danger Confirmation Section (Unlocked after Preview) -->
      <div id="purge-confirm-section" class="hidden border-t border-destructive/20 pt-5 space-y-3">
        <div class="flex items-center gap-2 text-destructive text-xs font-bold">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          <span>Confirm Permanent Deletion</span>
        </div>
        <p class="text-xs text-muted-foreground">
          To proceed, type the connection display name <strong class="text-foreground font-mono">"{accountName}"</strong> below.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="text"
            id="purge-confirm-name"
            placeholder={`Type "${accountName}" to confirm`}
            class="flex-1 rounded-xl border border-destructive/40 bg-background px-3 py-2 text-xs focus:border-destructive focus:outline-none"
          />
          <button
            id="purge-delete-btn"
            disabled
            class="rounded-xl bg-destructive px-5 py-2 text-xs font-bold text-destructive-foreground hover:bg-destructive/90 disabled:opacity-50 transition-all shrink-0"
          >
            Delete Permanently
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script src="../../scripts/tabs.ts"></script>
<script src="../../scripts/analytics-tables.ts"></script>
<script src="../../scripts/pipeline-controls.ts"></script>
<script src="../../scripts/pin-intelligence.ts"></script>
<script src="../../scripts/purge-controls.ts"></script>

