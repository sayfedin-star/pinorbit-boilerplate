                <label class="flex items-center gap-2 p-1 hover:bg-muted/40 rounded cursor-pointer">
                  <input type="checkbox" data-col="appearances" checked class="rounded border-border" /> <span>Appearances</span>
                </label>
                <label class="flex items-center gap-2 p-1 hover:bg-muted/40 rounded cursor-pointer">
