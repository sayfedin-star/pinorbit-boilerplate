          <div class="flex items-center gap-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Window:</span>
            <div class="inline-flex rounded-xl border border-border bg-muted/30 p-0.5" id="intel-range-presets">
              <button data-intel-days="30" class="preset-btn active rounded-lg bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-foreground shadow-sm transition-all">30D</button>
              <button data-intel-days="90" class="preset-btn rounded-lg px-2.5 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">90D</button>
              <button data-intel-days="180" class="preset-btn rounded-lg px-2.5 py-0.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all">180D</button>
            </div>
          </div>

          <!-- Actions: Search, Column Visibility, CSV Export -->
          <div class="flex flex-wrap items-center gap-2">
            <input
              type="text"
              id="intel-search"
              placeholder="Search pin ID or title..."
              class="rounded-xl border border-border bg-background px-3 py-1.5 text-xs focus:border-primary focus:outline-none w-48"
