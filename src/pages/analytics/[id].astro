          <fieldset class="space-y-1 text-xs sm:col-span-2">
            <legend class="font-semibold text-muted-foreground mb-1.5">Sort Modes</legend>
            <div class="flex flex-wrap gap-1.5" id="sort-modes-container">
              {['IMPRESSION','OUTBOUND_CLICK','SAVE','ENGAGEMENT','PIN_CLICK'].map(m => (
                <button type="button" data-mode={m} aria-pressed="true"
                  class="rounded-lg border border-primary/40 bg-primary/10 px-2.5 py-1 text-[10px] font-bold text-primary">{m}</button>
