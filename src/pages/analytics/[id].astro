                </label>
                <label class="flex items-center gap-2 p-1 hover:bg-muted/40 rounded cursor-pointer">
                  <input type="checkbox" data-col="total_pin_clicks" checked class="rounded border-border" /> <span>Pin Clicks</span>
                </label>
                <label class="flex items-center gap-2 p-1 hover:bg-muted/40 rounded cursor-pointer">
                  <input type="checkbox" data-col="total_saves" checked class="rounded border-border" /> <span>Saves</span>
