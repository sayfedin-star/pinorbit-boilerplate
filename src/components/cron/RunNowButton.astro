---
export interface Props {
  endpoint: string;
  method?: 'POST' | 'GET';
  payload?: Record<string, any>;
  forcePayload?: Record<string, any>;
  label?: string;
  forceLabel?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'primary' | 'secondary' | 'amber' | 'emerald' | 'subtle' | 'blue';
  disabled?: boolean;
  class?: string;
  buttonId?: string;
  onSuccessEvent?: string;
  scope?: string;
  isMaster?: boolean;
  currentWsName?: string;
}

const {
  endpoint,
  method = 'POST',
  payload = {},
  forcePayload = {},
  label = 'Run Now',
  forceLabel = 'Force Run',
  size = 'md',
  variant = 'primary',
  disabled = false,
  class: className = '',
  buttonId = `run-now-btn-${Math.random().toString(36).slice(2, 9)}`,
  onSuccessEvent = 'cron:run-completed',
  scope = 'default',
  isMaster = false,
  currentWsName = 'Hymum',
} = Astro.props;

const sizeClasses = {
  sm: 'px-2.5 py-1 text-xs gap-1.5',
  md: 'px-3.5 py-2 text-sm gap-2',
  lg: 'px-5 py-2.5 text-base gap-2.5',
}[size];

const splitChevronClasses = {
  sm: 'px-1.5 py-1 text-xs',
  md: 'px-2 py-2 text-sm',
  lg: 'px-2.5 py-2.5 text-base',
}[size];

const variantClasses = {
  primary: 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm border border-emerald-500/30',
  emerald: 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm border border-emerald-500/30',
  secondary: 'bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700 shadow-sm',
  amber: 'bg-amber-600 hover:bg-amber-500 text-white shadow-sm border border-amber-500/30',
  blue: 'bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white shadow-sm border border-blue-500/30',
  subtle: 'bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800',
}[variant];
---

<div class="relative inline-flex items-stretch group/runnow">
  <button
    id={buttonId}
    type="button"
    disabled={disabled}
    data-endpoint={endpoint}
    data-method={method}
    data-payload={JSON.stringify(payload)}
    data-force-payload={JSON.stringify(forcePayload)}
    data-label={label}
    data-force-label={forceLabel}
    data-success-event={onSuccessEvent}
    data-scope={scope}
    data-is-master={isMaster ? 'true' : 'false'}
    class={`relative select-none overflow-hidden font-medium ${isMaster ? 'rounded-l-lg' : 'rounded-lg'} inline-flex items-center justify-center transition-all duration-150 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer ${sizeClasses} ${variantClasses} ${className}`}
    title="Click to Run Now. Hold for 800ms to Force Run (bypasses active windows, rate caps & disabled flags)."
  >
    <!-- Circular Progress SVG Ring (Charges on Long Press) -->
    <svg
      class="runnow-progress-ring absolute inset-0 w-full h-full pointer-events-none opacity-0 transition-opacity duration-150"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
    >
      <rect
        class="runnow-progress-bar"
        x="0"
        y="0"
        width="100"
        height="100"
        fill="rgba(234, 179, 8, 0.25)"
        style="transform-origin: left; transform: scaleX(0); transition: transform 800ms linear;"
      />
    </svg>

    <!-- Normal State Icon & Label -->
    <span class="runnow-content inline-flex items-center gap-1.5 z-10 pointer-events-none">
      <svg class="runnow-normal-icon w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="runnow-label">{label}</span>
    </span>

    <!-- Charging State Indicator -->
    <span class="runnow-charging-text hidden items-center gap-1.5 text-amber-300 font-bold z-10 pointer-events-none animate-pulse">
      <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span>Hold for Force...</span>
    </span>

    <!-- Running Spinner State -->
    <span class="runnow-running-text hidden items-center gap-1.5 z-10 pointer-events-none">
      <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Executing...</span>
    </span>
  </button>

  {isMaster && (
    <div class="relative inline-flex items-center">
      <button
        id={`${buttonId}-dropdown-btn`}
        type="button"
        disabled={disabled}
        aria-haspopup="true"
        aria-expanded="false"
        class={`rounded-r-lg border-l border-white/20 inline-flex items-center justify-center transition-all duration-150 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer ${splitChevronClasses} ${variantClasses}`}
        title="Select execution scope (All Workspaces vs Current Only)"
      >
        <svg class="w-3.5 h-3.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <!-- Scope Selector Menu Dropdown -->
      <div
        id={`${buttonId}-dropdown-menu`}
        class="hidden absolute right-0 top-full mt-1.5 z-50 w-72 rounded-2xl border border-border bg-card p-2 shadow-xl ring-1 ring-black/10 transition-all duration-150"
      >
        <div class="px-2 py-1.5 mb-1 border-b border-border/80">
          <p class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">Select Execution Scope</p>
        </div>
        <div class="space-y-1">
          <button
            type="button"
            data-run-scope="all"
            data-target-btn={buttonId}
            class="runnow-scope-option w-full text-left flex items-start gap-2.5 p-2 rounded-xl hover:bg-muted/80 transition-colors cursor-pointer group"
          >
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500 border border-amber-500/20 mt-0.5 text-xs">
              👑
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold text-foreground group-hover:text-primary">Run All Workspaces</span>
                <span class="text-[9px] font-extrabold px-1.5 py-0.2 rounded-md bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30">
                  Global
                </span>
              </div>
              <p class="text-[10px] text-muted-foreground leading-tight mt-0.5">
                Parallel matrix execution across all 4 active workspaces
              </p>
            </div>
          </button>

          <button
            type="button"
            data-run-scope="current"
            data-target-btn={buttonId}
            class="runnow-scope-option w-full text-left flex items-start gap-2.5 p-2 rounded-xl hover:bg-muted/80 transition-colors cursor-pointer group"
          >
            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-blue-500/10 text-blue-500 border border-blue-500/20 mt-0.5 text-xs">
              🎯
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold text-foreground group-hover:text-primary">Run Current Only</span>
                <span class="text-[9px] font-extrabold px-1.5 py-0.2 rounded-md bg-blue-500/15 text-blue-600 dark:text-blue-400 border border-blue-500/30">
                  {currentWsName}
                </span>
              </div>
              <p class="text-[10px] text-muted-foreground leading-tight mt-0.5">
                Target only profiles and accounts in this workspace
              </p>
            </div>
          </button>
        </div>
      </div>
    </div>
  )}
</div>

<script>
  function setupRunNowButtons() {
    // 1. Setup Dropdown Menus for Master Workspace buttons
    document.querySelectorAll<HTMLButtonElement>('[id$="-dropdown-btn"]').forEach((dropdownBtn) => {
      if (dropdownBtn.dataset.initialized) return;
      dropdownBtn.dataset.initialized = 'true';

      const menu = dropdownBtn.nextElementSibling as HTMLElement | null;
      if (!menu) return;

      dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = menu.classList.contains('hidden');
        document.querySelectorAll('[id$="-dropdown-menu"]').forEach(m => m.classList.add('hidden'));
        if (isHidden) {
          menu.classList.remove('hidden');
        }
      });
    });

    // Close menus on outside click
    document.addEventListener('click', () => {
      document.querySelectorAll('[id$="-dropdown-menu"]').forEach(m => m.classList.add('hidden'));
    });

    // 2. Setup Scope Selection items
    document.querySelectorAll<HTMLButtonElement>('.runnow-scope-option').forEach((optionBtn) => {
      if (optionBtn.dataset.initialized) return;
      optionBtn.dataset.initialized = 'true';

      optionBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetBtnId = optionBtn.dataset.targetBtn;
        const scope = optionBtn.dataset.runScope;
        const mainBtn = targetBtnId ? document.getElementById(targetBtnId) as HTMLButtonElement | null : null;
        if (!mainBtn) return;

        document.querySelectorAll('[id$="-dropdown-menu"]').forEach(m => m.classList.add('hidden'));
        (mainBtn as any)._triggerScopeRun?.(scope);
      });
    });

    // 3. Setup Main RunNow buttons
    document.querySelectorAll<HTMLButtonElement>('button[data-endpoint]').forEach((btn) => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';

      let pressTimer: number | null = null;
      let isLongPress = false;
      const PRESS_DURATION = 800; // ms

      const ring = btn.querySelector('.runnow-progress-ring') as HTMLElement;
      const bar = btn.querySelector('.runnow-progress-bar') as HTMLElement;
      const normalContent = btn.querySelector('.runnow-content') as HTMLElement;
      const chargingText = btn.querySelector('.runnow-charging-text') as HTMLElement;
      const runningText = btn.querySelector('.runnow-running-text') as HTMLElement;

      function startPress(e: Event) {
        if (btn.disabled) return;
        isLongPress = false;

        if (ring && bar) {
          ring.style.opacity = '1';
          bar.style.transition = `transform ${PRESS_DURATION}ms linear`;
          bar.style.transform = 'scaleX(1)';
        }

        if (chargingText && normalContent) {
          pressTimer = window.setTimeout(() => {
            isLongPress = true;
            normalContent.classList.add('hidden');
            chargingText.classList.remove('hidden');
            chargingText.classList.add('inline-flex');
            
            // Trigger Force Run immediately on reaching 800ms
            cancelPress();
            triggerExecution(true);
          }, PRESS_DURATION);
        }
      }

      function cancelPress() {
        if (pressTimer) {
          clearTimeout(pressTimer);
          pressTimer = null;
        }
        if (ring && bar) {
          ring.style.opacity = '0';
          bar.style.transition = 'none';
          bar.style.transform = 'scaleX(0)';
        }
        if (chargingText && normalContent) {
          chargingText.classList.add('hidden');
          chargingText.classList.remove('inline-flex');
          normalContent.classList.remove('hidden');
        }
      }

      function handleClick(e: MouseEvent) {
        if (isLongPress) {
          isLongPress = false;
          return;
        }
        cancelPress();
        triggerExecution(false);
      }

      async function triggerExecution(force: boolean, customScope?: string) {
        const endpoint = btn.dataset.endpoint;
        const method = btn.dataset.method || 'POST';
        const rawPayload = btn.dataset.payload ? JSON.parse(btn.dataset.payload) : {};
        const successEvent = btn.dataset.successEvent || 'cron:run-completed';

        const payload = {
          ...rawPayload,
          force: force ? true : undefined,
          scope: customScope || rawPayload.scope || (btn.dataset.isMaster === 'true' ? 'all' : undefined),
        };

        // Set Loading State
        btn.disabled = true;
        normalContent?.classList.add('hidden');
        chargingText?.classList.add('hidden');
        runningText?.classList.remove('hidden');
        runningText?.classList.add('inline-flex');

        try {
          const fetchOpts: RequestInit = {
            method,
            headers: { 'Content-Type': 'application/json' },
          };
          if (method !== 'GET' && method !== 'HEAD') {
            fetchOpts.body = JSON.stringify(payload);
          }

          const res = await fetch(endpoint!, fetchOpts);
          const data = await res.json().catch(() => ({}));

          if (res.ok && (data.success !== false)) {
            window.dispatchEvent(
              new CustomEvent(successEvent, {
                detail: { success: true, force, data, scope: payload.scope || btn.dataset.scope },
              })
            );
          } else {
            const msg = data.error || data.message || `Request failed with HTTP ${res.status}`;
            alert(`Execution failed: ${msg}`);
          }
        } catch (err: any) {
          alert(`Network error: ${err.message || 'Failed to dispatch request'}`);
        } finally {
          btn.disabled = false;
          runningText?.classList.add('hidden');
          runningText?.classList.remove('inline-flex');
          normalContent?.classList.remove('hidden');
        }
      }

      // Expose scope trigger for dropdown selection
      (btn as any)._triggerScopeRun = (customScope: string) => {
        triggerExecution(false, customScope);
      };

      // Pointer & Mouse Events
      btn.addEventListener('pointerdown', startPress);
      btn.addEventListener('pointerup', cancelPress);
      btn.addEventListener('pointerleave', cancelPress);
      btn.addEventListener('pointercancel', cancelPress);
      btn.addEventListener('click', handleClick);
    });
  }

  // Init on DOM ready and Astro page swaps
  setupRunNowButtons();
  document.addEventListener('astro:page-load', setupRunNowButtons);
</script>
