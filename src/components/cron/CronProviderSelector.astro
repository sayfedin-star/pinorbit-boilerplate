---
import type { WorkspaceTokenSummary } from '../../server/lib/token-resolver';

export interface Props {
  currentProvider?: string;
  workspaceId: string;
  project?: 'scheduling' | 'analytics' | 'competitors' | 'pinarchive';
  tokens?: WorkspaceTokenSummary[];
  selectedTokenId?: string | null;
  class?: string;
  pipeline?: string;
}

const {
  currentProvider = 'fastcron',
  workspaceId,
  project = 'scheduling',
  tokens = [],
  selectedTokenId = null,
  class: className = '',
} = Astro.props;

const isFastCron = !currentProvider || currentProvider.toLowerCase() === 'fastcron';
const isCronJobOrg = currentProvider?.toLowerCase() === 'cronjoborg' || currentProvider?.toLowerCase() === 'cron-job.org';
---

<div class={`bg-zinc-900/90 border border-zinc-800 rounded-xl p-4 sm:p-5 space-y-4 ${className}`} data-provider-container data-workspace-id={workspaceId}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h3 class="text-sm font-semibold text-zinc-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Cron Engine Provider (Workspace Global)
      </h3>
      <p class="text-xs text-zinc-400 mt-0.5">Select your automated scheduling infrastructure for all projects.</p>
    </div>

    <!-- Provider Tabs Selector -->
    <div class="inline-flex p-1 bg-zinc-950/80 border border-zinc-800/80 rounded-lg text-xs font-medium" id="global-provider-tabs">
      <button
        type="button"
        data-provider="fastcron"
        class={`px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 cursor-pointer ${
          isFastCron
            ? 'bg-indigo-600 text-white shadow-sm font-semibold'
            : 'text-zinc-400 hover:text-zinc-200'
        }`}
      >
        <span class={`w-2 h-2 rounded-full ${isFastCron ? 'bg-emerald-400 animate-pulse' : 'bg-zinc-500'}`}></span>
        FastCron
      </button>
      <button
        type="button"
        data-provider="cronjoborg"
        class={`px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 cursor-pointer ${
          isCronJobOrg
            ? 'bg-indigo-600 text-white shadow-sm font-semibold'
            : 'text-zinc-400 hover:text-zinc-200'
        }`}
      >
        <span class={`w-2 h-2 rounded-full ${isCronJobOrg ? 'bg-emerald-400 animate-pulse' : 'bg-zinc-500'}`}></span>
        cron-job.org
      </button>
    </div>
  </div>

  <!-- Token Selection & Info Row -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2 border-t border-zinc-800/60">
    <div class="space-y-1.5">
      <label class="text-xs font-medium text-zinc-300 flex items-center justify-between">
        <span>Active Provider API Key / Token</span>
        <a
          id="cron-docs-link"
          href={isCronJobOrg ? 'https://docs.cron-job.org/rest-api.html' : 'https://www.fastcron.com/help'}
          target="_blank"
          rel="noopener noreferrer"
          class="text-indigo-400 hover:text-indigo-300 text-[11px] underline flex items-center gap-0.5"
        >
          <span>Docs & API</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </label>

      <div class="flex items-center gap-2">
        <select
          id="cron-token-select"
          class="bg-zinc-950 border border-zinc-700 text-zinc-200 text-xs rounded-lg px-3 py-2 w-full focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500"
        >
          {tokens.length === 0 ? (
            <option value="">Server Default (Environment Variable)</option>
          ) : (
            tokens.map((t) => (
              <option value={t.id || ''} selected={t.id === selectedTokenId || (!selectedTokenId && t.is_default)}>
                {t.name} ({t.masked_token}) {t.is_default ? '★ Default' : ''}
              </option>
            ))
          )}
        </select>

        <button
          type="button"
          id="add-token-modal-btn"
          class="shrink-0 px-2.5 py-2 text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 rounded-lg transition-colors flex items-center gap-1 cursor-pointer"
          title="Add New Token to Workspace Vault"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>New</span>
        </button>
      </div>
    </div>

    <!-- Provider Status & Features Notice -->
    <div class="flex flex-col justify-center bg-zinc-950/60 border border-zinc-800/80 rounded-lg p-3 text-xs text-zinc-400">
      <div class="flex items-center justify-between font-medium text-zinc-300">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Platform-Controlled Scheduling
        </span>
        <span class="text-zinc-500 text-[11px]">Zero GitHub Manual Runs</span>
      </div>
      <p class="mt-1 text-[11px] text-zinc-400">
        Schedules execute Worker dispatch webhooks automatically with encrypted AES-GCM token authorization.
      </p>
    </div>
  </div>
  
  <div id="provider-change-toast" class="hidden rounded-lg p-2.5 text-xs font-semibold"></div>

  <!-- Modal for Adding Provider API Key / Token -->
  <div
    id="add-provider-key-modal"
    class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-xs flex items-center justify-center p-4 transition-all duration-200"
    aria-modal="true"
    role="dialog"
  >
    <div class="bg-zinc-900 border border-zinc-750 rounded-2xl w-full max-w-md shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
      <!-- Modal Header -->
      <div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between bg-zinc-950/50">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-zinc-100">Set Provider API Key</h3>
            <p class="text-[11px] text-zinc-400">Encrypted with AES-GCM at rest</p>
          </div>
        </div>
        <button
          type="button"
          id="close-key-modal-btn"
          class="text-zinc-400 hover:text-zinc-200 p-1.5 rounded-lg hover:bg-zinc-800 transition-colors cursor-pointer"
          title="Close"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-5 space-y-4">
        <div>
          <label for="provider-api-key-input" class="block text-xs font-medium text-zinc-300 mb-1.5">
            Provider API Key or Token
          </label>
          <div class="relative">
            <input
              type="password"
              id="provider-api-key-input"
              placeholder="••••••••••••••••"
              class="w-full bg-zinc-950 border border-zinc-700 text-zinc-100 text-xs rounded-lg px-3 py-2.5 font-mono focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 pr-10"
              autocomplete="new-password"
            />
            <button
              type="button"
              id="toggle-key-visibility-btn"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-200 text-xs p-1"
              title="Show / Hide Key"
            >
              👁
            </button>
          </div>
          <p class="text-[11px] text-zinc-400 mt-1.5">
            Must be at least 8 characters. Stored securely in workspace vault.
          </p>
          <p id="key-validation-error" class="hidden text-[11px] text-rose-400 font-medium mt-1">
            API key must be at least 8 characters.
          </p>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-zinc-800/80">
          <button
            type="button"
            id="cancel-key-modal-btn"
            class="px-3 py-1.5 text-xs text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800 border border-zinc-700 rounded-lg transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="button"
            id="save-key-modal-btn"
            disabled
            class="px-3.5 py-1.5 text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1.5"
          >
            <span id="save-key-btn-label">Save API Key</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initCronProviderSelector() {
    const container = document.querySelector('[data-provider-container]') as HTMLElement | null;
    if (!container || container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    const workspaceId = container.dataset.workspaceId;
    const docsLink = document.getElementById('cron-docs-link') as HTMLAnchorElement | null;
    const toast = document.getElementById('provider-change-toast');
    const buttons = container.querySelectorAll<HTMLButtonElement>('[data-provider]');

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.className = `rounded-lg p-2.5 text-xs font-semibold ${
        isError
          ? 'bg-rose-500/10 text-rose-500 border border-rose-500/20'
          : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20'
      }`;
      toast.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast?.classList.add('hidden'), 4000);
    }

    function updateButtonUI(activeProvider: string) {
      const p = activeProvider.toLowerCase();
      const isCronJobOrg = p === 'cronjoborg' || p === 'cron-job.org';
      
      buttons.forEach((btn) => {
        const bType = btn.getAttribute('data-provider');
        const isActive = (bType === 'fastcron' && !isCronJobOrg) || (bType === 'cronjoborg' && isCronJobOrg);
        
        btn.className = `px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 cursor-pointer ${
          isActive
            ? 'bg-indigo-600 text-white shadow-sm font-semibold'
            : 'text-zinc-400 hover:text-zinc-200'
        }`;
        
        const dot = btn.querySelector('span');
        if (dot) {
          dot.className = `w-2 h-2 rounded-full ${isActive ? 'bg-emerald-400 animate-pulse' : 'bg-zinc-500'}`;
        }
      });

      if (docsLink) {
        if (isCronJobOrg) {
          docsLink.href = 'https://docs.cron-job.org/rest-api.html';
        } else {
          docsLink.href = 'https://www.fastcron.com/help';
        }
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetProvider = btn.getAttribute('data-provider');
        if (!targetProvider) return;

        try {
          btn.disabled = true;
          const res = await fetch('/api/workspace/cron-provider', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              workspace_id: workspaceId,
              provider: targetProvider,
            }),
          });

          const data = await res.json();
          if (!res.ok || data.success === false) {
            throw new Error(data.error || 'Failed to update cron provider');
          }

          updateButtonUI(targetProvider);
          const name = targetProvider === 'cronjoborg' ? 'cron-job.org' : 'FastCron';
          if (data.warnings && data.warnings.length > 0) {
            showToast(`Cron provider switched to ${name}, but downstream sync had warnings: ${data.warnings.join(', ')}`);
          } else {
            showToast(`Cron provider switched to ${name} for this workspace.`);
          }

          window.dispatchEvent(
            new CustomEvent('cron:provider-changed', {
              detail: { provider: targetProvider, workspaceId },
            })
          );
        } catch (err: any) {
          showToast(err.message || 'Failed to update provider', true);
        } finally {
          btn.disabled = false;
        }
      });
    });

    // ─── Modal Management for Provider API Key ───
    const modal = document.getElementById('add-provider-key-modal');
    const addTokenBtn = document.getElementById('add-token-modal-btn');
    const closeBtn = document.getElementById('close-key-modal-btn');
    const cancelBtn = document.getElementById('cancel-key-modal-btn');
    const saveBtn = document.getElementById('save-key-modal-btn') as HTMLButtonElement | null;
    const saveBtnLabel = document.getElementById('save-key-btn-label');
    const keyInput = document.getElementById('provider-api-key-input') as HTMLInputElement | null;
    const errorEl = document.getElementById('key-validation-error');
    const toggleVisBtn = document.getElementById('toggle-key-visibility-btn');

    function openModal() {
      if (!modal) return;
      if (keyInput) {
        keyInput.value = '';
        keyInput.type = 'password';
      }
      if (saveBtn) saveBtn.disabled = true;
      if (errorEl) errorEl.classList.add('hidden');
      modal.classList.remove('hidden');
      setTimeout(() => keyInput?.focus(), 50);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      if (keyInput) keyInput.value = '';
      if (saveBtn) saveBtn.disabled = true;
      if (errorEl) errorEl.classList.add('hidden');
    }

    keyInput?.addEventListener('input', () => {
      const val = keyInput.value.trim();
      if (saveBtn) saveBtn.disabled = val.length < 8;
      if (val.length >= 8 && errorEl) {
        errorEl.classList.add('hidden');
      }
    });

    addTokenBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    cancelBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    toggleVisBtn?.addEventListener('click', () => {
      if (!keyInput) return;
      keyInput.type = keyInput.type === 'password' ? 'text' : 'password';
    });

    saveBtn?.addEventListener('click', async () => {
      const tokenVal = keyInput?.value?.trim() || '';
      if (tokenVal.length < 8) {
        if (errorEl) errorEl.classList.remove('hidden');
        if (saveBtn) saveBtn.disabled = true;
        keyInput?.focus();
        return;
      }

      if (errorEl) errorEl.classList.add('hidden');

      const current = (container.querySelector('[data-provider].bg-indigo-600') as HTMLElement)?.dataset.provider || 'fastcron';

      try {
        if (saveBtn) saveBtn.disabled = true;
        if (saveBtnLabel) saveBtnLabel.textContent = 'Saving...';

        const res = await fetch('/api/workspace/cron-provider', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            workspace_id: workspaceId,
            provider: current,
            api_key: tokenVal,
          }),
        });

        const data = await res.json();
        if (!res.ok || data.success === false) {
          throw new Error(data.error || 'Failed to save API key');
        }

        closeModal();
        if (data.warnings && data.warnings.length > 0) {
          showToast(`Provider API key updated with downstream warnings: ${data.warnings.join(', ')}`, true);
        } else {
          showToast('Workspace provider API key updated and encrypted successfully.');
        }

        window.dispatchEvent(
          new CustomEvent('cron:provider-changed', {
            detail: { provider: current, workspaceId },
          })
        );
      } catch (err: any) {
        showToast(err.message || 'Failed to save API key', true);
      } finally {
        if (saveBtn) {
          saveBtn.disabled = (keyInput?.value?.trim().length || 0) < 8;
        }
        if (saveBtnLabel) saveBtnLabel.textContent = 'Save API Key';
      }
    });
  }

  initCronProviderSelector();
  document.addEventListener('astro:page-load', initCronProviderSelector);
</script>

