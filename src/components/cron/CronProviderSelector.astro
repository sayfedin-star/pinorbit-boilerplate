---
import type { WorkspaceTokenSummary } from '../../server/lib/token-resolver';

export interface Props {
  currentProvider?: string;
  workspaceId: string;
  project: 'scheduling' | 'analytics' | 'competitors' | 'pinarchive';
  tokens?: WorkspaceTokenSummary[];
  selectedTokenId?: string | null;
  class?: string;
}

const {
  currentProvider = 'fastcron',
  workspaceId,
  project,
  tokens = [],
  selectedTokenId = null,
  class: className = '',
} = Astro.props;

const isFastCron = !currentProvider || currentProvider.toLowerCase() === 'fastcron';
const isCronJobOrg = currentProvider?.toLowerCase() === 'cronjoborg' || currentProvider?.toLowerCase() === 'cron-job.org';
---

<div class={`bg-zinc-900/90 border border-zinc-800 rounded-xl p-4 space-y-4 ${className}`} data-provider-container>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h3 class="text-sm font-semibold text-zinc-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Cron Engine Provider
      </h3>
      <p class="text-xs text-zinc-400 mt-0.5">Select your automated scheduling infrastructure.</p>
    </div>

    <!-- Provider Tabs Selector -->
    <div class="inline-flex p-1 bg-zinc-950/80 border border-zinc-800/80 rounded-lg text-xs font-medium">
      <button
        type="button"
        data-provider="fastcron"
        class={`px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 ${
          isFastCron
            ? 'bg-indigo-600 text-white shadow-sm font-semibold'
            : 'text-zinc-400 hover:text-zinc-200'
        }`}
      >
        <span class={`w-2 h-2 rounded-full ${isFastCron ? 'bg-emerald-400 animate-pulse' : 'bg-zinc-500'}`}></span>
        FastCron
      </button>
      <button
        type="button"
        data-provider="cronjoborg"
        class={`px-3 py-1.5 rounded-md transition-all flex items-center gap-1.5 ${
          isCronJobOrg
            ? 'bg-indigo-600 text-white shadow-sm font-semibold'
            : 'text-zinc-400 hover:text-zinc-200'
        }`}
      >
        <span class={`w-2 h-2 rounded-full ${isCronJobOrg ? 'bg-emerald-400 animate-pulse' : 'bg-zinc-500'}`}></span>
        cron-job.org
      </button>
    </div>
  </div>

  <!-- Token Selection & Info Row -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2 border-t border-zinc-800/60">
    <div class="space-y-1.5">
      <label class="text-xs font-medium text-zinc-300 flex items-center justify-between">
        <span>Active Provider API Key / Token</span>
        <a
          href={isCronJobOrg ? 'https://docs.cron-job.org/rest-api.html' : 'https://www.fastcron.com/help'}
          target="_blank"
          rel="noopener noreferrer"
          class="text-indigo-400 hover:text-indigo-300 text-[11px] underline flex items-center gap-0.5"
        >
          <span>Docs & API</span>
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </label>

      <div class="flex items-center gap-2">
        <select
          id="cron-token-select"
          class="bg-zinc-950 border border-zinc-700 text-zinc-200 text-xs rounded-lg px-3 py-2 w-full focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500"
        >
          {tokens.length === 0 ? (
            <option value="">Server Default (Environment Variable)</option>
          ) : (
            tokens.map((t) => (
              <option value={t.id || ''} selected={t.id === selectedTokenId || (!selectedTokenId && t.is_default)}>
                {t.name} ({t.masked_token}) {t.is_default ? '★ Default' : ''}
              </option>
            ))
          )}
        </select>

        <button
          type="button"
          id="add-token-modal-btn"
          class="shrink-0 px-2.5 py-2 text-xs bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 rounded-lg transition-colors flex items-center gap-1"
          title="Add New Token to Workspace Vault"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>New</span>
        </button>
      </div>
    </div>

    <!-- Provider Status & Features Notice -->
    <div class="flex flex-col justify-center bg-zinc-950/60 border border-zinc-800/80 rounded-lg p-3 text-xs text-zinc-400">
      <div class="flex items-center justify-between font-medium text-zinc-300">
        <span class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Platform-Controlled Scheduling
        </span>
        <span class="text-zinc-500 text-[11px]">Zero GitHub Manual Runs</span>
      </div>
      <p class="mt-1 text-[11px] text-zinc-400">
        Schedules execute Worker dispatch webhooks automatically with encrypted AES-GCM token authorization.
      </p>
    </div>
  </div>
</div>
