---
import { getWorkspaces, getActiveWorkspaceId } from '../lib/workspaces';

const workspaces = await getWorkspaces(Astro.cookies, Astro.request, Astro.response?.headers);
const activeWorkspaceId = getActiveWorkspaceId(Astro.cookies);
const currentWorkspace = workspaces.find((w) => w.id === activeWorkspaceId) || workspaces[0];
---

<div class="relative inline-block text-left" id="workspace-switcher-root">
  <!-- Trigger Button & Controls -->
  <div class="flex items-center gap-2">
    <div class="relative">
      <select
        id="workspace-select"
        class="h-9 cursor-pointer appearance-none rounded-xl border border-border/80 bg-card py-1.5 pl-9 pr-8 text-xs font-semibold text-foreground shadow-sm transition-all hover:bg-muted/60 hover:border-border focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
        aria-label="Select active workspace"
        data-active-id={activeWorkspaceId}
      >
        {workspaces.map((ws) => (
          <option value={ws.id} selected={ws.id === currentWorkspace?.id}>
            {ws.is_master ? `👑 ${ws.name} (Master)` : ws.name}
          </option>
        ))}
      </select>

      <!-- Folder/Niche Icon -->
      <div class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-primary">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L8.6 3.3A2 2 0 0 0 6.9 2.5H4a2 2 0 0 0-2 2v13.5a2 2 0 0 2 2z"/>
        </svg>
      </div>

      <!-- Chevron Down Icon -->
      <div class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </div>
    </div>

    <!-- Create Workspace Button -->
    <button
      id="open-create-workspace-modal"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-xl border border-border/80 bg-card text-muted-foreground shadow-sm transition-all hover:bg-primary/10 hover:text-primary hover:border-primary/30"
      title="Create New Workspace / Niche Cluster"
      aria-label="Create new workspace"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
    </button>

    <!-- Manage Workspaces Button -->
    <button
      id="open-manage-workspace-modal"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-xl border border-border/80 bg-card text-muted-foreground shadow-sm transition-all hover:bg-primary/10 hover:text-primary hover:border-primary/30"
      title="Manage Workspaces (Rename & Delete)"
      aria-label="Manage workspaces"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
    </button>
  </div>

  <!-- MODAL 1: Create Workspace Modal -->
  <div
    id="create-workspace-modal"
    class="fixed inset-0 z-50 hidden min-h-screen overflow-y-auto bg-black/60 backdrop-blur-sm p-4 sm:p-6 flex items-center justify-center"
    aria-modal="true"
    role="dialog"
  >
    <div id="create-workspace-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-5 z-10 my-auto">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              <line x1="12" y1="11" x2="12" y2="17"/>
              <line x1="9" y1="14" x2="15" y2="14"/>
            </svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-foreground">Create New Workspace</h3>
            <p class="text-[11px] text-muted-foreground">Isolate Pinterest accounts by niche cluster</p>
          </div>
        </div>
        <button
          id="close-create-workspace-modal"
          type="button"
          class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="create-ws-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3.5 text-xs text-rose-500 font-medium"></div>

      <form id="create-workspace-form" class="space-y-4">
        <div class="space-y-1.5">
          <label for="ws-name" class="block text-xs font-semibold text-foreground">Workspace Name *</label>
          <input
            id="ws-name"
            type="text"
            required
            placeholder="e.g. Food & Drinks, Home Decor, Fitness"
            class="w-full rounded-xl border border-border bg-background/60 py-2.5 px-3.5 text-xs text-foreground placeholder:text-muted-foreground/60 transition-all focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          />
        </div>

        <div class="flex items-center justify-end gap-3 border-t border-border pt-4">
          <button
            id="cancel-create-ws-btn"
            type="button"
            class="rounded-xl border border-border px-4 py-2.5 text-xs font-semibold text-foreground hover:bg-muted transition-all"
          >
            Cancel
          </button>
          <button
            id="submit-create-ws-btn"
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-md hover:bg-primary/90 transition-all disabled:opacity-50"
          >
            <span>Create & Switch</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 2: Manage Workspaces Modal -->
  <div
    id="manage-workspace-modal"
    class="fixed inset-0 z-50 hidden min-h-screen overflow-y-auto bg-black/60 backdrop-blur-sm p-4 sm:p-6 flex items-center justify-center"
    aria-modal="true"
    role="dialog"
  >
    <div id="manage-workspace-backdrop" class="fixed inset-0"></div>
    <div class="relative w-full max-w-xl rounded-2xl border border-border bg-card p-6 shadow-2xl space-y-4 z-10 my-auto max-h-[85vh] flex flex-col">
      <div class="flex items-center justify-between border-b border-border pb-4 flex-shrink-0">
        <div class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-foreground">Manage Workspaces</h3>
            <p class="text-[11px] text-muted-foreground">Rename workspaces or prune empty niche clusters</p>
          </div>
        </div>
        <button
          id="close-manage-workspace-modal"
          type="button"
          class="rounded-lg p-1 text-muted-foreground hover:bg-muted hover:text-foreground transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div id="manage-ws-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 p-3.5 text-xs text-rose-500 font-medium flex-shrink-0"></div>
      <div id="manage-ws-success" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-3.5 text-xs text-emerald-600 dark:text-emerald-400 font-medium flex-shrink-0"></div>

      <!-- Workspaces Management List -->
      <div id="manage-workspaces-list" class="flex-1 overflow-y-auto space-y-3 pr-1">
        <div class="p-8 text-center text-xs text-muted-foreground animate-pulse">
          Loading member workspaces...
        </div>
      </div>

      <div class="flex items-center justify-end border-t border-border pt-3.5 flex-shrink-0">
        <button
          id="done-manage-ws-btn"
          type="button"
          class="rounded-xl border border-border px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-all"
        >
          Done
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { getWorkspaces, getActiveWorkspaceId, DEFAULT_WORKSPACE_ID } from '../lib/workspaces';
  import { setActiveWorkspaceId, createWorkspace, renameWorkspace, deleteWorkspace } from '../lib/workspaces-client';
  import type { Workspace } from '../lib/types';

  function escapeHtml(unsafe: string): string {
    return unsafe
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  const select = document.getElementById('workspace-select') as HTMLSelectElement | null;
  
  // Create Modal elements
  const openCreateModalBtn = document.getElementById('open-create-workspace-modal');
  const closeCreateModalBtn = document.getElementById('close-create-workspace-modal');
  const cancelCreateModalBtn = document.getElementById('cancel-create-ws-btn');
  const createModal = document.getElementById('create-workspace-modal');
  const createBackdrop = document.getElementById('create-workspace-backdrop');
  const createForm = document.getElementById('create-workspace-form') as HTMLFormElement | null;
  const createErrorDiv = document.getElementById('create-ws-error');
  const createSubmitBtn = document.getElementById('submit-create-ws-btn') as HTMLButtonElement | null;

  // Manage Modal elements
  const openManageModalBtn = document.getElementById('open-manage-workspace-modal');
  const closeManageModalBtn = document.getElementById('close-manage-workspace-modal');
  const doneManageModalBtn = document.getElementById('done-manage-ws-btn');
  const manageModal = document.getElementById('manage-workspace-modal');
  const manageBackdrop = document.getElementById('manage-workspace-backdrop');
  const manageList = document.getElementById('manage-workspaces-list');
  const manageErrorDiv = document.getElementById('manage-ws-error');
  const manageSuccessDiv = document.getElementById('manage-ws-success');

  let cachedWorkspaces: Workspace[] = [];

  // Client-side hydration to ensure newly created/member workspaces are visible
  async function hydrateWorkspaceSwitcher() {
    try {
      cachedWorkspaces = await getWorkspaces();
      const activeId = getActiveWorkspaceId();

      if (select && cachedWorkspaces && cachedWorkspaces.length > 0) {
        select.innerHTML = cachedWorkspaces
          .map(
            (ws) =>
              `<option value="${ws.id}" ${ws.id === activeId ? 'selected' : ''}>${ws.is_master ? `👑 ${escapeHtml(ws.name)} (Master)` : escapeHtml(ws.name)}</option>`
          )
          .join('');
        select.value = activeId;
      }
    } catch (err) {
      console.warn('Could not hydrate workspace switcher client-side:', err);
    }
  }

  // Run hydration on page load
  if (typeof window !== 'undefined') {
    hydrateWorkspaceSwitcher();
  }

  // Switch Workspace Handler
  select?.addEventListener('change', (e) => {
    const target = e.target as HTMLSelectElement;
    const selectedWsId = target.value;
    if (selectedWsId) {
      setActiveWorkspaceId(selectedWsId);
      window.location.reload();
    }
  });

  // Create Modal Open/Close Controls
  function openCreateModal() {
    createModal?.classList.remove('hidden');
    createModal?.classList.add('flex');
    createErrorDiv?.classList.add('hidden');
    const nameInput = document.getElementById('ws-name') as HTMLInputElement | null;
    if (nameInput) {
      nameInput.value = '';
      nameInput.focus();
    }
  }

  function closeCreateModal() {
    createModal?.classList.add('hidden');
    createModal?.classList.remove('flex');
  }

  openCreateModalBtn?.addEventListener('click', openCreateModal);
  closeCreateModalBtn?.addEventListener('click', closeCreateModal);
  cancelCreateModalBtn?.addEventListener('click', closeCreateModal);
  createBackdrop?.addEventListener('click', closeCreateModal);

  // Create Form Submit Handler
  createForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nameInput = document.getElementById('ws-name') as HTMLInputElement | null;
    const name = nameInput?.value || '';

    if (!name.trim()) return;

    try {
      if (createSubmitBtn) {
        createSubmitBtn.disabled = true;
        createSubmitBtn.textContent = 'Creating...';
      }
      createErrorDiv?.classList.add('hidden');

      const created = await createWorkspace({ name });
      setActiveWorkspaceId(created.id);
      window.location.reload();
    } catch (err: any) {
      if (createErrorDiv) {
        createErrorDiv.textContent = err.message || 'Failed to create workspace';
        createErrorDiv.classList.remove('hidden');
      }
    } finally {
      if (createSubmitBtn) {
        createSubmitBtn.disabled = false;
        createSubmitBtn.textContent = 'Create & Switch';
      }
    }
  });

  // Manage Modal Open/Close Controls
  async function openManageModal() {
    manageModal?.classList.remove('hidden');
    manageModal?.classList.add('flex');
    hideManageFeedback();
    await renderManageList();
  }

  function closeManageModal() {
    manageModal?.classList.add('hidden');
    manageModal?.classList.remove('flex');
  }

  function hideManageFeedback() {
    manageErrorDiv?.classList.add('hidden');
    manageSuccessDiv?.classList.add('hidden');
  }

  function showManageError(msg: string) {
    if (manageErrorDiv) {
      manageErrorDiv.textContent = msg;
      manageErrorDiv.classList.remove('hidden');
    }
  }

  function showManageSuccess(msg: string) {
    if (manageSuccessDiv) {
      manageSuccessDiv.textContent = msg;
      manageSuccessDiv.classList.remove('hidden');
      setTimeout(() => manageSuccessDiv?.classList.add('hidden'), 4000);
    }
  }

  async function renderManageList() {
    if (!manageList) return;
    manageList.innerHTML = '<div class="p-8 text-center text-xs text-muted-foreground animate-pulse">Loading workspaces...</div>';

    cachedWorkspaces = await getWorkspaces();
    const activeId = getActiveWorkspaceId();

    if (!cachedWorkspaces || cachedWorkspaces.length === 0) {
      manageList.innerHTML = '<div class="p-6 text-center text-xs text-muted-foreground">No workspaces found.</div>';
      return;
    }

    manageList.innerHTML = cachedWorkspaces
      .map((ws) => {
        const isDefault = ws.id === DEFAULT_WORKSPACE_ID;
        const isActive = ws.id === activeId;

        return `
          <div class="rounded-xl border border-border/80 bg-background p-4 space-y-3 shadow-sm hover:border-border transition-all" id="ws-card-${ws.id}">
            <!-- Main Row -->
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="font-bold text-sm text-foreground truncate">${escapeHtml(ws.name)}</span>
                ${
                  ws.is_master
                    ? `<span class="inline-flex items-center gap-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 px-2 py-0.5 text-[10px] font-bold">👑 MASTER</span>`
                    : ''
                }
                ${
                  isDefault
                    ? `<span class="inline-flex items-center rounded-full bg-primary/10 text-primary border border-primary/20 px-2 py-0.5 text-[10px] font-bold">DEFAULT</span>`
                    : ws.slug ? `<span class="inline-flex items-center rounded-md bg-muted px-2 py-0.5 text-[10px] font-mono text-muted-foreground">slug: ${escapeHtml(ws.slug)}</span>` : ''
                }
                ${
                  isActive
                    ? `<span class="inline-flex items-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2 py-0.5 text-[10px] font-bold">ACTIVE</span>`
                    : ''
                }
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-2 flex-shrink-0">
                <button
                  data-ws-action="toggle-master"
                  data-id="${ws.id}"
                  data-is-master="${ws.is_master ? 'false' : 'true'}"
                  class="rounded-lg border ${ws.is_master ? 'border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400 hover:bg-amber-500 hover:text-white' : 'border-border text-foreground hover:bg-muted'} px-2.5 py-1 text-xs font-medium transition-all"
                  title="${ws.is_master ? 'Remove Master status' : 'Set as Master Workspace (Global Orchestrator for all workspaces)'}"
                >${ws.is_master ? 'Unset Master' : 'Set Master 👑'}</button>
                ${
                  !isDefault
                    ? `<button
                        data-ws-action="toggle-rename"
                        data-id="${ws.id}"
                        class="rounded-lg border border-border px-2.5 py-1 text-xs text-foreground hover:bg-muted font-medium transition-all"
                      >Rename</button>
                      <button
                        data-ws-action="delete"
                        data-id="${ws.id}"
                        class="rounded-lg border border-rose-500/30 bg-rose-500/10 text-rose-600 dark:text-rose-400 hover:bg-rose-600 hover:text-white px-2.5 py-1 text-xs font-medium transition-all"
                      >Delete</button>`
                    : `<span class="text-[11px] text-muted-foreground italic px-1">Protected</span>`
                }
              </div>
            </div>

            <!-- In-Card Rename Form (Hidden by default) -->
            <div id="rename-form-${ws.id}" class="hidden border-t border-border pt-3 space-y-2">
              <div class="flex items-center gap-2">
                <input
                  id="rename-input-${ws.id}"
                  type="text"
                  value="${escapeHtml(ws.name)}"
                  class="flex-1 rounded-lg border border-border bg-card py-1.5 px-3 text-xs text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
                />
                <button
                  data-ws-action="save-rename"
                  data-id="${ws.id}"
                  class="rounded-lg bg-primary px-3 py-1.5 text-xs font-semibold text-primary-foreground shadow hover:bg-primary/90 transition-all"
                >Save</button>
                <button
                  data-ws-action="cancel-rename"
                  data-id="${ws.id}"
                  class="rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted transition-all"
                >Cancel</button>
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    bindManageActions();
  }

  function bindManageActions() {
    // Toggle Rename Form
    document.querySelectorAll('[data-ws-action="toggle-rename"]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        hideManageFeedback();
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const formDiv = document.getElementById(`rename-form-${id}`);
        const input = document.getElementById(`rename-input-${id}`) as HTMLInputElement | null;
        formDiv?.classList.toggle('hidden');
        if (input && !formDiv?.classList.contains('hidden')) {
          input.focus();
          input.select();
        }
      });
    });

    // Cancel Rename Form
    document.querySelectorAll('[data-ws-action="cancel-rename"]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        document.getElementById(`rename-form-${id}`)?.classList.add('hidden');
      });
    });

    // Save Rename Action
    document.querySelectorAll('[data-ws-action="save-rename"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        hideManageFeedback();
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const input = document.getElementById(`rename-input-${id}`) as HTMLInputElement | null;
        const newName = input?.value.trim() || '';

        if (!newName) {
          showManageError('Workspace name cannot be empty');
          return;
        }

        try {
          (e.currentTarget as HTMLButtonElement).disabled = true;
          await renameWorkspace(id, newName);
          showManageSuccess(`Workspace renamed to "${newName}".`);
          await hydrateWorkspaceSwitcher();
          await renderManageList();
        } catch (err: any) {
          showManageError(err.message || 'Failed to rename workspace');
        }
      });
    });

    // Delete Action
    document.querySelectorAll('[data-ws-action="delete"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        hideManageFeedback();
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';

        if (!confirm('Are you sure you want to delete this workspace? Only empty workspaces can be deleted.')) {
          return;
        }

        try {
          await deleteWorkspace(id);
          showManageSuccess('Workspace deleted successfully.');
          await hydrateWorkspaceSwitcher();
          window.location.reload();
        } catch (err: any) {
          showManageError(err.message || 'Failed to delete workspace');
        }
      });
    });

    // Toggle Master Workspace Action
    document.querySelectorAll('[data-ws-action="toggle-master"]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        hideManageFeedback();
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id') || '';
        const shouldBeMaster = (e.currentTarget as HTMLElement).getAttribute('data-is-master') === 'true';

        try {
          (e.currentTarget as HTMLButtonElement).disabled = true;
          const res = await fetch('/api/workspaces/set-master', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ workspace_id: id, is_master: shouldBeMaster }),
          });
          const json = await res.json();
          if (!res.ok || !json.success) {
            throw new Error(json.error || 'Failed to update Master Workspace status');
          }
          showManageSuccess(shouldBeMaster ? '👑 Workspace set as Master Workspace (Global Orchestrator).' : 'Master Workspace status removed.');
          await hydrateWorkspaceSwitcher();
          await renderManageList();
        } catch (err: any) {
          showManageError(err.message || 'Failed to update Master Workspace status');
        }
      });
    });
  }

  openManageModalBtn?.addEventListener('click', openManageModal);
  closeManageModalBtn?.addEventListener('click', closeManageModal);
  doneManageModalBtn?.addEventListener('click', closeManageModal);
  manageBackdrop?.addEventListener('click', closeManageModal);
</script>
