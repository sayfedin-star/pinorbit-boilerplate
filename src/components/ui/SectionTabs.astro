---
// src/components/ui/SectionTabs.astro
interface TabItem {
  label: string;
  href: string;
}

interface Props {
  tabs: TabItem[];
  activeHref?: string;
}

const { tabs, activeHref } = Astro.props;
const currentPath = activeHref || Astro.url.pathname;

function isTabActive(tabHref: string): boolean {
  if (currentPath === tabHref) return true;
  // Handle alias matches (e.g. /accounts matching /scheduling/accounts or vice-versa)
  if (
    (tabHref === '/scheduling/accounts' && currentPath === '/accounts') ||
    (tabHref === '/scheduling/logs' && currentPath === '/logs') ||
    (tabHref === '/settings/audit' && currentPath === '/audit') ||
    (tabHref === '/analytics' && currentPath === '/analytics/connections')
  ) {
    return true;
  }
  return false;
}
---

<nav aria-label="Section navigation" class="mb-6 flex space-x-1 border-b border-border/80 overflow-x-auto select-none">
  {tabs.map((tab) => {
    const active = isTabActive(tab.href);
    return (
      <a
        href={tab.href}
        aria-current={active ? 'page' : undefined}
        class={`inline-flex items-center gap-2 whitespace-nowrap px-4 py-2.5 text-xs font-semibold transition-all border-b-2 -mb-px focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-t-lg ${
          active
            ? 'border-primary text-primary font-bold dark:border-rose-400 dark:text-rose-400 bg-primary/5'
            : 'border-transparent text-muted-foreground hover:text-foreground hover:border-border/80'
        }`}
      >
        <span>{tab.label}</span>
      </a>
    );
  })}
</nav>
