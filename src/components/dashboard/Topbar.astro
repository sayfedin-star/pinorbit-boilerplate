---
import { isSupabaseConfigured } from '../../lib/supabase';
import WorkspaceSwitcher from '../WorkspaceSwitcher.astro';

interface Props {
  title?: string;
}

const { title = 'Dashboard' } = Astro.props;
const pathname = Astro.url.pathname;
const user = Astro.locals.user;
const userEmail = user?.email || 'admin@pinorbit.internal';
const userInitials = userEmail
  ? userEmail.replace(/@.*/, '').slice(0, 2).toUpperCase()
  : 'AD';

// Compute Breadcrumbs: Section ▸ Page
let section = 'Dashboard';
let page = 'Command Center';

if (pathname === '/' || pathname === '/dashboard') {
  section = 'Dashboard';
  page = 'Command Center';
} else if (pathname === '/scheduling') {
  section = 'Scheduling';
  page = 'Overview';
} else if (pathname.startsWith('/scheduling/accounts') || pathname.startsWith('/accounts')) {
  section = 'Scheduling';
  page = pathname.includes('/pins') ? 'Account Pins' : 'Accounts';
} else if (pathname.startsWith('/scheduling/logs') || pathname.startsWith('/logs')) {
  section = 'Scheduling';
  page = 'Logs';
} else if (pathname.startsWith('/boards')) {
  section = 'Scheduling';
  page = 'Boards';
} else if (pathname.startsWith('/pins')) {
  section = 'Scheduling';
  page = 'Pins';
} else if (pathname.startsWith('/imports')) {
  section = 'Scheduling';
  page = 'Imports';
} else if (pathname.startsWith('/schedules')) {
  section = 'Scheduling';
  page = 'Schedules';
} else if (pathname.startsWith('/competitors')) {
  section = 'Competitors';
  page = pathname.includes('/details') || pathname.split('/').length > 2 ? 'Deep-Dive' : 'Overview';
} else if (pathname.startsWith('/pinarchive')) {
  section = 'PinArchive';
  page = pathname.includes('/winning-pins')
    ? 'Winning Pins'
    : pathname.includes('/topics')
    ? 'Topic Clusters'
    : pathname.includes('/account')
    ? 'Creator Archive'
    : 'Intelligence';
} else if (pathname.startsWith('/analytics/secrets')) {
  section = 'Analytics';
  page = 'Ingest Secrets';
} else if (pathname.startsWith('/analytics/')) {
  section = 'Analytics';
  // On /analytics/[id], title is "${accountName} — Analytics"
  page = title ? title.replace(/— Analytics.*$/, '').replace(/\|.*$/, '').trim() : 'Connection';
} else if (pathname === '/analytics' || pathname === '/analytics/connections') {
  section = 'Analytics';
  page = 'Pinner Analytics';
} else if (pathname.startsWith('/settings/audit') || pathname.startsWith('/audit')) {
  section = 'Settings';
  page = 'Audit Trail';
} else if (pathname.startsWith('/settings')) {
  section = 'Settings';
  page = 'Workspace';
} else {
  section = 'App';
  page = title || 'Overview';
}

const statusTooltip = isSupabaseConfigured
  ? 'Connected to Supabase with Auth & RLS Protection'
  : 'Using Fallback Mock Data';
---

<header class="sticky top-0 z-20 flex h-16 w-full items-center justify-between border-b border-border bg-card/80 px-4 backdrop-blur-md sm:px-6 lg:px-8 select-none">
  <!-- Left Cluster: Mobile Hamburger | Desktop Collapse Toggle | WorkspaceSwitcher | Breadcrumbs -->
  <div class="flex items-center gap-3 min-w-0">
    <!-- Mobile Hamburger Button -->
    <button
      id="open-mobile-sidebar"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary lg:hidden shrink-0"
      aria-label="Open sidebar drawer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="4" y1="6" x2="20" y2="6"/>
        <line x1="4" y1="18" x2="20" y2="18"/>
      </svg>
    </button>

    <!-- Desktop Collapse Toggle Button (Model C) -->
    <button
      id="topbar-sidebar-toggle"
      type="button"
      class="hidden lg:flex h-9 w-9 items-center justify-center rounded-xl border border-border/80 bg-card text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all shrink-0"
      title="Toggle Sidebar Collapse (Model C)"
      aria-label="Toggle sidebar collapse"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"/>
        <path d="M9 3v18"/>
      </svg>
    </button>

    <!-- Workspace Switcher -->
    <div class="shrink-0">
      <WorkspaceSwitcher />
    </div>

    <!-- Breadcrumbs (Section ▸ Page) -->
    <nav aria-label="Breadcrumbs" class="hidden sm:flex items-center gap-1.5 text-xs font-semibold text-muted-foreground min-w-0 pl-1">
      <span class="hover:text-foreground transition-colors shrink-0">{section}</span>
      <svg class="h-3 w-3 text-muted-foreground/40 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
      <span class="text-foreground font-bold truncate max-w-[200px] md:max-w-[320px]">{page}</span>
    </nav>

    <!-- Hidden Heading for Screen Readers & A11y Hierarchy -->
    <h2 class="sr-only">{title}</h2>
  </div>

  <!-- Right Cluster: Status Dot | Theme Toggle | User Menu -->
  <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
    <!-- Live Status Dot with Verbatim Tooltip -->
    <div
      class="flex items-center justify-center p-2 rounded-lg hover:bg-muted/40 cursor-help transition-colors"
      title={statusTooltip}
      aria-label={statusTooltip}
      tabindex="0"
    >
      <span class="relative flex h-2 w-2">
        <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${isSupabaseConfigured ? 'bg-emerald-400' : 'bg-amber-400'}`}></span>
        <span class={`relative inline-flex rounded-full h-2 w-2 ${isSupabaseConfigured ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
      </span>
    </div>

    <!-- Dark Mode Toggle Button -->
    <button
      id="theme-toggle"
      type="button"
      class="flex h-9 w-9 items-center justify-center rounded-lg border border-border text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-colors"
      aria-label="Toggle theme"
    >
      <!-- Sun Icon (shows in Dark) -->
      <svg id="theme-toggle-light-icon" class="hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
      </svg>
      <!-- Moon Icon (shows in Light) -->
      <svg id="theme-toggle-dark-icon" class="hidden h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      </svg>
    </button>

    <!-- User Menu Dropdown (Replaces standalone Sign Out) -->
    <div class="relative" id="user-menu-root">
      <button
        id="user-menu-btn"
        type="button"
        aria-expanded="false"
        aria-haspopup="true"
        aria-label="User account menu"
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 border border-primary/20 text-primary font-bold text-xs hover:bg-primary/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary transition-all shadow-sm"
      >
        {userInitials}
      </button>

      <!-- Dropdown Menu Card -->
      <div
        id="user-menu-dropdown"
        class="hidden absolute right-0 mt-2 w-56 rounded-xl border border-border bg-card p-1.5 shadow-2xl transition-all duration-150 z-50"
        role="menu"
        aria-orientation="vertical"
        aria-labelledby="user-menu-btn"
      >
        <div class="px-3 py-2 border-b border-border/60 mb-1">
          <span class="text-[10px] uppercase font-bold text-muted-foreground block tracking-wider">Signed in as</span>
          <span class="text-xs font-semibold text-foreground truncate block mt-0.5" title={userEmail}>{userEmail}</span>
        </div>

        <div class="space-y-0.5" role="none">
          <a
            href="/settings"
            role="menuitem"
            class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-semibold text-foreground hover:bg-muted focus-visible:bg-muted focus-visible:outline-none transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
            <span>Workspace Settings</span>
          </a>

          <button
            type="button"
            id="logout-btn"
            role="menuitem"
            class="w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-semibold text-rose-600 dark:text-rose-400 hover:bg-rose-500/10 focus-visible:bg-rose-500/10 focus-visible:outline-none transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Sign Out</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { signOut } from '../../lib/auth';

  // Dark mode toggle script
  const themeToggle = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-toggle-light-icon');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      lightIcon?.classList.remove('hidden');
      darkIcon?.classList.add('hidden');
    } else {
      darkIcon?.classList.remove('hidden');
      lightIcon?.classList.add('hidden');
    }
  }

  updateIcons();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcons();
  });

  // Mobile sidebar drawer script
  const openBtn = document.getElementById('open-mobile-sidebar');
  const closeBtn = document.getElementById('close-mobile-sidebar');
  const sidebar = document.getElementById('mobile-sidebar');
  const backdrop = document.getElementById('mobile-sidebar-backdrop');

  function openDrawer() {
    sidebar?.classList.remove('-translate-x-full');
    backdrop?.classList.remove('hidden');
  }

  function closeDrawer() {
    sidebar?.classList.add('-translate-x-full');
    backdrop?.classList.add('hidden');
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  // User Menu Dropdown script (A11y, outside click & Esc key)
  const userMenuBtn = document.getElementById('user-menu-btn');
  const userMenuDropdown = document.getElementById('user-menu-dropdown');

  function toggleUserMenu() {
    if (!userMenuDropdown) return;
    const isHidden = userMenuDropdown.classList.contains('hidden');
    if (isHidden) {
      userMenuDropdown.classList.remove('hidden');
      userMenuBtn?.setAttribute('aria-expanded', 'true');
    } else {
      userMenuDropdown.classList.add('hidden');
      userMenuBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  function closeUserMenu() {
    userMenuDropdown?.classList.add('hidden');
    userMenuBtn?.setAttribute('aria-expanded', 'false');
  }

  userMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleUserMenu();
  });

  document.addEventListener('click', (e) => {
    if (!userMenuDropdown?.contains(e.target as Node) && e.target !== userMenuBtn) {
      closeUserMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (userMenuDropdown && !userMenuDropdown.classList.contains('hidden')) {
        closeUserMenu();
        userMenuBtn?.focus();
      }
      if (sidebar && !sidebar.classList.contains('-translate-x-full')) {
        closeDrawer();
      }
    }
  });

  // Logout listener
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    await signOut();
  });
</script>
